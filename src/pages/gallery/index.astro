---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { galleryMedia, koaMarketingGallery, koaMarketingMedia } from '../../data/media';

const categories = ['Venue','Ceremony','Reception','Mobile Bar','Enhancements','Hospitality','Stay'];
const featuredImage = koaMarketingMedia.pavilionSunsetWide;
const primaryGalleryImages = koaMarketingGallery.filter((image) => image.src !== featuredImage.src);
const grouped = categories.map((category) => ({
  category,
  images: primaryGalleryImages.filter((image) => image.category === category),
}));
const styledImages = koaMarketingGallery.map(({ category, ...image }) => image);
const allGalleryImages = [...styledImages, ...galleryMedia];
---
<BaseLayout
  title="Big Island Wedding Venue Gallery | Koa’s Events"
  description="Explore Koa’s Events through real property photography, event moments and professionally styled visual inspiration showing how the Mountain View venue can transform."
  canonical="https://www.koasevents.com/gallery/"
>
  <Header overlay={false} />
  <main>
    <section class="overflow-hidden pb-20 pt-10 lg:pb-28">
      <div class="container-shell">
        <div class="grid gap-10 lg:grid-cols-[.76fr_1.24fr] lg:items-end">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">The Koa’s lookbook</p>
            <h1 class="display mt-5 text-6xl leading-[.93] sm:text-7xl lg:text-[6.3rem]">One property. So many ways to make it yours.</h1>
            <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/66">Koa’s begins as a flexible tropical setting. This lookbook combines real property and event photography with professionally staged and enhanced visual inspiration to show how dramatically the venue can change with different florals, décor, lighting, rentals and color palettes.</p>
            <p class="mt-5 max-w-xl text-xs leading-6 text-[var(--koa-ink)]/48">Styling varies by event. Some clients use Koa’s rentals; others work with planners, florists, rental companies and specialty vendors. Package pages define what Koa’s includes.</p>
          </div>
          <button type="button" class="gallery-trigger group relative min-h-[28rem] overflow-hidden rounded-[1.6rem] sm:min-h-[34rem]" data-gallery-index="0" data-gallery-src={koaMarketingMedia.pavilionSunsetWide.src}>
            <ResponsiveImage {...koaMarketingMedia.pavilionSunsetWide} width={1400} height={1050} sizes="(min-width:1024px) 55vw,100vw" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]" priority />
            <span class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></span>
            <span class="absolute bottom-5 left-5 rounded-full bg-[rgba(251,248,241,.92)] px-4 py-2 text-[.62rem] font-black uppercase tracking-[.14em] text-[var(--koa-forest)]">Featured · Venue at sunset</span>
          </button>
        </div>
      </div>
    </section>

    <section class="bg-[var(--koa-ink)] py-16 text-white sm:py-20 lg:py-28">
      <div class="container-shell">
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
          <div><p class="eyebrow text-[var(--koa-amber-light)]">Styled possibilities</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The venue is the canvas. The event becomes the art.</h2></div>
          <p class="max-w-xl text-sm leading-7 text-white/58 lg:justify-self-end">Move from bright tropical ceremony to romantic white florals, rust-and-navy reception styling, blush details, dramatic lighting or a completely different design direction. Open any image to see it larger.</p>
        </div>

        <div class="mt-12 space-y-14 sm:mt-16 sm:space-y-16">
          {grouped.map((group) => (
            <section data-gallery-section={group.category}>
              <div class="mb-5 flex items-end justify-between gap-4 border-b border-white/12 pb-4 sm:mb-6">
                <div><p class="eyebrow text-[var(--koa-amber-light)]">{group.category}</p><h3 class="display mt-2 text-[2.1rem] leading-none sm:text-4xl">{group.images.length} photos</h3></div>
                <span class="pb-1 text-[.62rem] font-bold uppercase tracking-[.14em] text-white/38 sm:hidden">Swipe →</span>
              </div>
              <div data-gallery-category-grid={group.category} class="-mx-2 flex snap-x snap-mandatory gap-4 overflow-x-auto px-2 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:grid sm:auto-rows-[14rem] sm:grid-cols-2 sm:gap-3 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-12 lg:auto-rows-[11rem]">
                {group.images.map((image, categoryIndex) => {
                  const globalIndex = koaMarketingGallery.indexOf(image);
                  const editorialClass =
                    categoryIndex === 0 ? 'sm:col-span-2 lg:col-span-8 lg:row-span-3' :
                    categoryIndex === 1 ? 'lg:col-span-4 lg:row-span-2' :
                    categoryIndex === 2 ? 'lg:col-span-4 lg:row-span-2' :
                    categoryIndex % 6 === 3 ? 'lg:col-span-5 lg:row-span-2' :
                    categoryIndex % 6 === 4 ? 'lg:col-span-7 lg:row-span-2' :
                    categoryIndex % 6 === 5 ? 'lg:col-span-4 lg:row-span-2' :
                    'lg:col-span-4 lg:row-span-2';
                  return (
                    <button type="button" class:list={['gallery-trigger group relative aspect-[4/5] w-[82vw] max-w-[22rem] shrink-0 snap-start overflow-hidden rounded-[1.35rem] bg-white/5 shadow-[0_16px_36px_rgba(0,0,0,.2)] sm:aspect-auto sm:w-auto sm:max-w-none sm:shrink sm:min-h-[18rem] sm:rounded-[1.2rem] sm:shadow-none', editorialClass]} data-gallery-index={globalIndex} data-gallery-src={image.src} data-gallery-category={group.category}>
                      <ResponsiveImage {...image} width={1200} height={900} sizes="(min-width:1024px) 38vw, (min-width:640px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" />
                      <span class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></span>
                      <span class="absolute bottom-4 left-4 max-w-[calc(100%-2rem)] text-left text-[.72rem] font-semibold leading-5 text-white/92 sm:max-w-[80%] sm:text-xs">{image.alt}</span>
                      <span class="absolute bottom-4 right-4 hidden size-9 place-items-center rounded-full border border-white/30 bg-black/20 text-lg text-white backdrop-blur sm:grid">+</span>
                    </button>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section data-managed-gallery class="hidden bg-[var(--koa-ivory)] py-20 lg:py-28">
      <div class="container-shell">
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
          <div><p class="eyebrow text-[var(--koa-clay)]">Recently added</p><h2 class="display mt-4 text-5xl leading-[1] sm:text-6xl">More ways Koa’s has been transformed.</h2></div>
          <p class="max-w-xl text-sm leading-7 text-[var(--koa-ink)]/58 lg:justify-self-end">New gallery photographs added by the Koa’s team appear here automatically.</p>
        </div>
        <div data-managed-gallery-grid class="mt-10 -mx-2 flex snap-x snap-mandatory gap-4 overflow-x-auto px-2 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:mt-12 sm:grid sm:grid-cols-2 sm:gap-3 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3"></div>
      </div>
    </section>

    <section class="koa-grain bg-[var(--koa-sand)] py-16 lg:py-20">
      <div class="container-shell">
        <details class="group overflow-hidden rounded-[1.6rem] border border-[var(--koa-line)] bg-white/78 shadow-[var(--shadow-soft)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 sm:p-8 lg:p-10">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Real event archive</p>
              <h2 class="display mt-3 text-4xl leading-[1] sm:text-5xl">Older Wix gallery · {galleryMedia.length} photographs</h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--koa-ink)]/58">The current Koa’s photography collection above is the primary gallery. Open this archive only if you want to browse photographs migrated from the previous website.</p>
            </div>
            <span class="grid size-12 shrink-0 place-items-center rounded-full border border-[var(--koa-line)] bg-[var(--koa-sand)] text-2xl transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="border-t border-[var(--koa-line)] p-5 sm:p-8 lg:p-10">
            <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Historical archive</p>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--koa-ink)]/58">These images remain available for documentary context, but they are intentionally separated from the current 25-photo marketing gallery.</p>
              </div>
              <a href="/inquire/" class="inline-flex rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Check availability</a>
            </div>
            <div class="grid auto-rows-[15rem] gap-3 sm:grid-cols-2 md:auto-rows-[17rem] lg:grid-cols-3">
              {galleryMedia.map((image, index) => (
                <button type="button" class:list={['gallery-trigger group relative overflow-hidden rounded-[1.1rem] bg-[var(--koa-sand)]', index % 7 === 0 ? 'sm:row-span-2' : '']} data-gallery-index={styledImages.length + index} data-gallery-src={image.src}>
                  <ResponsiveImage {...image} width={1000} height={800} sizes="(min-width:1024px) 32vw, 50vw" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" />
                  <span class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 transition group-hover:opacity-100"></span>
                </button>
              ))}
            </div>
          </div>
        </details>
      </div>
    </section>

    <section class="bg-[var(--koa-forest)] py-24 text-white lg:py-32">
      <div class="container-shell grid items-center gap-12 lg:grid-cols-[1.15fr_.85fr] lg:gap-20">
        <div class="relative min-h-[32rem] overflow-hidden rounded-[2rem]">
          <ResponsiveImage {...koaMarketingMedia.pavilionDayLush} width={1300} height={1000} sizes="(min-width:1024px) 55vw,100vw" class="absolute inset-0 h-full w-full object-cover" />
        </div>
        <div>
          <p class="eyebrow text-[var(--koa-amber-light)]">See the blank canvas</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A tour shows you what photographs cannot.</h2>
          <p class="mt-7 text-base leading-7 text-white/66">Tell us your date and event type. We can move the conversation toward the right package, the options you actually need, and a private tour of the property.</p>
          <a href="/inquire/?service=venue" class="mt-8 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Start an inquiry</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <dialog id="gallery-lightbox" class="m-auto h-[92svh] w-[94vw] max-w-7xl overflow-hidden rounded-[1.3rem] border border-white/15 bg-[rgba(6,23,18,.96)] p-0 text-white backdrop:bg-black/80">
    <div class="relative flex h-full items-center justify-center p-4 sm:p-8">
      <button type="button" data-close class="absolute right-4 top-4 z-20 grid size-11 place-items-center rounded-full border border-white/25 bg-black/25 text-xl backdrop-blur" aria-label="Close gallery">×</button>
      <button type="button" data-prev class="absolute left-4 z-20 grid size-11 place-items-center rounded-full border border-white/25 bg-black/25 text-xl backdrop-blur" aria-label="Previous image">←</button>
      <img data-lightbox-image src="" alt="" class="max-h-full max-w-full rounded-lg object-contain" />
      <button type="button" data-next class="absolute right-4 z-20 grid size-11 place-items-center rounded-full border border-white/25 bg-black/25 text-xl backdrop-blur" aria-label="Next image">→</button>
    </div>
  </dialog>

  <script is:inline define:vars={{ lightboxImages: allGalleryImages.map((item) => ({ src: item.src, alt: item.alt })) }}>
    const dialog = document.getElementById('gallery-lightbox');
    const image = dialog?.querySelector('[data-lightbox-image]');
    let current = 0;
    function show(index) {
      if (!dialog || !image) return;
      current = (index + lightboxImages.length) % lightboxImages.length;
      image.src = lightboxImages[current].src;
      image.alt = lightboxImages[current].alt;
      if (!dialog.open) dialog.showModal();
    }
    document.querySelectorAll('[data-gallery-index]').forEach((button) => button.addEventListener('click', () => show(Number(button.dataset.galleryIndex))));
    dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog?.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    dialog?.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    document.addEventListener('keydown', (event) => {
      if (!dialog?.open) return;
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
      if (event.key === 'Escape') dialog.close();
    });

    fetch('/api/gallery')
      .then((response) => response.json())
      .then(({ uploads = [], hiddenCurated = [], curatedEdits = {} }) => {
        const hidden = new Set(hiddenCurated);

        document.querySelectorAll('[data-gallery-src]').forEach((button) => {
          const src = button.dataset.gallerySrc;
          if (!src) return;

          if (hidden.has(src)) {
            button.classList.add('hidden');
            return;
          }

          const edit = curatedEdits[src] || {};
          const img = button.querySelector('img');
          if (img) {
            const x = Number.isFinite(Number(edit.focalX)) ? Number(edit.focalX) : 50;
            const y = Number.isFinite(Number(edit.focalY)) ? Number(edit.focalY) : 50;
            img.style.objectPosition = x + '% ' + y + '%';
          }

          const targetCategory = edit.category || button.dataset.galleryCategory;
          const targetGrid = targetCategory ? document.querySelector('[data-gallery-category-grid="' + CSS.escape(targetCategory) + '"]') : null;
          if (targetGrid && button.parentElement !== targetGrid) targetGrid.append(button);
        });

        uploads.forEach((item) => {
          const index = lightboxImages.length;
          lightboxImages.push({ src: item.src, alt: item.alt });

          const targetGrid = document.querySelector('[data-gallery-category-grid="' + CSS.escape(item.category || 'Venue') + '"]');
          if (!targetGrid) return;

          const button = document.createElement('button');
          button.type = 'button';
          button.dataset.galleryIndex = String(index);
          button.dataset.gallerySrc = item.src;
          button.dataset.galleryCategory = item.category || 'Venue';
          button.className = 'gallery-trigger group relative aspect-[4/5] w-[82vw] max-w-[22rem] shrink-0 snap-start overflow-hidden rounded-[1.35rem] bg-white/5 shadow-[0_16px_36px_rgba(0,0,0,.2)] sm:aspect-auto sm:w-auto sm:max-w-none sm:shrink sm:min-h-[18rem] sm:rounded-[1.2rem] sm:shadow-none lg:col-span-4 lg:row-span-2';

          const img = document.createElement('img');
          img.src = item.src;
          img.alt = item.alt;
          img.loading = 'lazy';
          img.decoding = 'async';
          img.className = 'absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]';
          img.style.objectPosition = (item.focalX ?? 50) + '% ' + (item.focalY ?? 50) + '%';

          const shade = document.createElement('span');
          shade.className = 'absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent';

          const label = document.createElement('span');
          label.className = 'absolute bottom-4 left-4 max-w-[80%] text-left text-xs font-semibold leading-5 text-white/90';
          label.textContent = item.alt;

          button.append(img, shade, label);
          button.addEventListener('click', () => show(index));
          targetGrid.append(button);
        });

        document.querySelectorAll('[data-gallery-section]').forEach((section) => {
          const grid = section.querySelector('[data-gallery-category-grid]');
          const count = grid ? [...grid.children].filter((child) => !child.classList.contains('hidden')).length : 0;
          const heading = section.querySelector('h3');
          if (heading) heading.textContent = count + (count === 1 ? ' photo' : ' photos');
          section.classList.toggle('hidden', count === 0);
        });
      })
      .catch(() => {});
  </script>
</BaseLayout>
