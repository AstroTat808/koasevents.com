---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { media } from '../../data/media';
const useCases=['Team retreats','Client appreciation','Holiday gatherings','Leadership off-sites','Networking events','Company celebrations','Workshops + trainings','Brand / community gatherings'];
const ops=['Run-of-show timing','Guest arrival + parking','AV / sound needs','Food + beverage flow','Vendor coordination','Insurance requirements','Bar + zero-proof options','Billing contact + proposal scope'];
---
<BaseLayout title="Corporate Events on Hawaiʻi Island | Koa’s Events" description="Plan team retreats, client events, company celebrations and mobile bar service with Koa’s Events on Hawaiʻi Island." canonical="https://www.koasevents.com/corporate-events/">
<main>
<section class="relative min-h-[80svh] overflow-hidden bg-[var(--koa-ink)] text-white md:min-h-[82svh]"><ResponsiveImage {...media.hospitality} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[80svh] items-end pb-14 pt-32 md:min-h-[82svh] md:pt-40 lg:pb-24"><div class="max-w-4xl"><p class="eyebrow text-white/65">Corporate + organization events</p><h1 class="display mt-5 text-6xl leading-[.9] sm:text-7xl lg:text-[6.3rem]">Built for the agenda. Memorable beyond it.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/78 sm:text-lg">A private venue and island-wide beverage service for teams, clients and organizations that want hospitality without losing operational clarity.</p><a href="/inquire/?service=both" class="mt-9 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Request a proposal</a></div></div></section>

<section class="py-24 lg:py-36"><div class="container-shell grid gap-14 lg:grid-cols-[.82fr_1.18fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">Hospitality with an operations brain</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A good corporate event feels easy to attend because the hard work happened before anyone arrived.</h2><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">We collect the practical requirements early—timing, guest flow, vendors, sound, beverage service and billing—then shape the experience around the objective of the event.</p></div><div class="relative h-[24rem] overflow-hidden rounded-[1.6rem] sm:h-[30rem] lg:h-[38rem] lg:rounded-[2rem]"><ResponsiveImage {...media.tableSettings} width={1200} height={1200} sizes="(min-width:1024px) 50vw,100vw" class="absolute inset-0 h-full w-full object-cover"/></div></div></section>

<section class="bg-[var(--koa-ink)] py-24 text-white lg:py-32"><div class="container-shell"><div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]"><div><p class="eyebrow text-[var(--koa-amber-light)]">Use cases</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">From off-sites to client nights.</h2></div><div class="grid gap-px overflow-hidden rounded-[1.3rem] bg-white/10 sm:grid-cols-2">{useCases.map((x,i)=><div class="bg-[var(--koa-ink)] p-6"><p class="eyebrow text-white/32">0{i+1}</p><p class="display mt-3 text-2xl">{x}</p></div>)}</div></div></div></section>

<section class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">Proposal-ready details</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">We qualify the logistics before we quote the experience.</h2></div><div class="grid border-t border-[var(--koa-line)]">{ops.map((x,i)=><div class="grid gap-3 border-b border-[var(--koa-line)] py-5 sm:grid-cols-[3rem_1fr]"><span class="eyebrow text-[var(--koa-clay)]">0{i+1}</span><p class="text-sm font-semibold text-[var(--koa-ink)]/68">{x}</p></div>)}</div></div></section>

<section class="py-20 lg:py-32"><div class="container-shell grid gap-4 lg:grid-cols-3"><article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7"><p class="eyebrow text-[var(--koa-clay)]">Venue</p><h2 class="display mt-10 text-4xl">A private place to meet differently.</h2><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/64">Retreats, workshops, appreciation events and company celebrations in Mountain View.</p></article><article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7"><p class="eyebrow text-[var(--koa-clay)]">Mobile Bar</p><h2 class="display mt-10 text-4xl">Hospitality at your location.</h2><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/64">Dry-bar service and zero-proof planning for off-site corporate events around Hawaiʻi Island.</p></article><article class="rounded-[1.5rem] bg-[var(--koa-forest)] p-7 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Combined</p><h2 class="display mt-10 text-4xl">One event plan, fewer loose ends.</h2><p class="mt-4 text-sm leading-6 text-white/62">Venue and beverage service scoped together through one inquiry.</p></article></div></section>

<section class="bg-[var(--koa-forest)] py-20 text-white"><div class="container-shell flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"><div class="max-w-3xl"><p class="eyebrow text-[var(--koa-amber-light)]">Start with the objective</p><h2 class="display mt-4 text-5xl leading-[1] sm:text-6xl">Tell us what the event needs to accomplish.</h2></div><a href="/inquire/?service=both" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Request a proposal</a></div></section>
</main><Footer/></BaseLayout>