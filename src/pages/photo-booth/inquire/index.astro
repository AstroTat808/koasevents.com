---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { photoBoothPackages, photoBoothEnhancements } from '../../../data/photoBooth';

const selectedPackage = Astro.url.searchParams.get('package') || '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || import.meta.env.TURNSTILE_SITEKEY || import.meta.env.TURNSTILE_SITE_KEY || '';
---

<BaseLayout
  title="Request Mirror X Photo Booth Rental | Koa’s Events"
  description="Check availability for Koa’s interactive Mirror X photo booth rental at your wedding, celebration or corporate event on Hawaiʻi Island."
  canonical="https://koasevents.com/photo-booth/inquire/"
  noindex={true}
>
  <Header overlay={false} />
  <main class="py-16 lg:py-24">
    <div class="container-shell grid gap-12 lg:grid-cols-[.78fr_1.22fr] lg:gap-20">
      <aside>
        <p class="eyebrow text-[var(--koa-clay)]">Mirror X · Request a rental</p>
        <h1 class="display mt-5 text-5xl leading-[.96] text-[var(--koa-text-strong)] sm:text-6xl">A little more magic for your event.</h1>
        <p class="mt-7 text-base leading-8 text-[var(--koa-ink)]/67">Let us know your event date, location and preferred package. We’ll check Mirror X availability and confirm the details for a personal quote.</p>
        <a class="link-arrow mt-6 text-[var(--koa-forest)]" href="/photo-booth/#packages">← Compare Mirror X packages</a>
        <div class="mt-11 rounded-[1.4rem] border border-[var(--koa-line)] bg-[var(--koa-sand)] p-7">
          <p class="eyebrow text-[var(--koa-clay)]">Before you book</p>
          <p class="mt-4 text-sm leading-7 text-[var(--koa-ink)]/65">A request does not reserve the date. We’ll confirm travel and venue access, the print package, any custom upgrades and the final price before booking.</p>
          <p class="mt-4 text-sm leading-7 text-[var(--koa-ink)]/65">Already holding a Koa’s Signature Wedding package? Tell us—we’ll check whether your Mirror X service is included to avoid duplicate charges.</p>
        </div>
      </aside>

      <form name="koa-event-inquiry" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" data-mirror-inquiry class="min-w-0 rounded-[1.6rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5 shadow-[var(--shadow-soft)] sm:p-9">
        <input type="hidden" name="form-name" value="koa-event-inquiry" />
        <input type="hidden" name="service" value="photo-booth" />
        <input type="hidden" name="subject" value="Mirror X Photo Booth Rental Request" />
        <p class="hidden"><label>Do not fill this in: <input name="bot-field" /></label></p>
        <div class="grid gap-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold">First name
              <input name="firstName" autocomplete="given-name" required class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">Last name
              <input name="lastName" autocomplete="family-name" required class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">Email
              <input type="email" name="email" autocomplete="email" required class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">Phone
              <input type="tel" name="phone" autocomplete="tel" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]" />
            </label>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold">Event date
              <input type="date" name="eventDate" required class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">Guest count
              <input type="number" min="1" max="1000" name="guestCount" required class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]" />
            </label>
          </div>
          <label class="grid gap-2 text-sm font-semibold">Event type
            <select name="eventType" required class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]">
              <option value="">Choose one</option>
              <option>Wedding</option><option>Birthday</option><option>Graduation</option><option>Corporate event</option><option>Anniversary</option><option>Fundraiser</option><option>Other private event</option>
            </select>
          </label>
          <label class="grid gap-2 text-sm font-semibold">Event venue / location
            <input name="photoBoothEventLocation" required placeholder="Venue name, town or address (or Koa’s Events)" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]" />
          </label>
          <label class="grid gap-2 text-sm font-semibold">Preferred rental package
            <select name="photoBoothPackage" required class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]">
              <option value="">Select a package</option>
              {photoBoothPackages.map((pkg) => (
                <option value={pkg.id} selected={selectedPackage === pkg.id}>{pkg.name} · {pkg.hours} hours · from {'$' + pkg.price.toLocaleString('en-US')}</option>
              ))}
              <option value="custom">Custom package / help me choose</option>
            </select>
          </label>
          <fieldset>
            <legend class="text-sm font-semibold">Interested in add-ons? (optional)</legend>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              {photoBoothEnhancements.map((extra) => (
                <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/50 p-4 text-sm">
                  <input type="checkbox" name="photoBoothExtra" value={extra.name} class="mt-1" />
                  <span><strong>{extra.name}</strong><span class="mt-1 block text-xs text-[var(--koa-clay)]">{extra.price}</span></span>
                </label>
              ))}
            </div>
          </fieldset>
          <label class="grid gap-2 text-sm font-semibold">Additional details
            <textarea name="priorities" rows="4" placeholder="Preferred booth time, event theme, indoor/outdoor setting, or other Koa’s services already booked" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 outline-none focus:border-[var(--koa-forest)]"></textarea>
          </label>
          {turnstileSiteKey && (
            <div class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/40 p-4">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="event_inquiry" data-theme="light" data-size="flexible"></div>
            </div>
          )}
          <p class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert" data-form-error></p>
          <button type="submit" class="mt-2 min-h-12 rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white disabled:opacity-60">Request Mirror X availability</button>
          <p class="text-center text-xs leading-6 text-[var(--koa-ink)]/55">This is an inquiry only. A booking is confirmed separately after availability, agreement and payment are arranged.</p>
        </div>
      </form>
    </div>
  </main>
  <Footer />
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline define:vars={{ turnstileSiteKey }}>
    const form = document.querySelector('[data-mirror-inquiry]');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset.submitting === '1') return;
      const error = form.querySelector('[data-form-error]');
      const submitButton = form.querySelector('button[type="submit"]');
      const data = new FormData(form);
      const token = String(data.get('cf-turnstile-response') || '');
      if (turnstileSiteKey && !token) {
        error.textContent = 'Please complete the security check.';
        error.classList.remove('hidden');
        return;
      }
      form.dataset.submitting = '1';
      if (submitButton) submitButton.disabled = true;
      error.classList.add('hidden');
      try {
        const response = await fetch('/api/crm/inquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Koa-Inquiry-Capture': '1' },
          keepalive: true,
          body: JSON.stringify({
            formName: 'koa-event-inquiry',
            honeypot: data.get('bot-field'),
            turnstileToken: token,
            packageId: '',
            customer: {
              name: [data.get('firstName'), data.get('lastName')].filter(Boolean).join(' '),
              email: data.get('email'),
              phone: data.get('phone'),
              eventDate: data.get('eventDate'),
              notes: data.get('priorities'),
            },
            inquiry: {
              service: 'photo-booth',
              eventType: data.get('eventType'),
              guestCount: data.get('guestCount'),
              photoBoothRequested: true,
              photoBoothPackage: data.get('photoBoothPackage'),
              photoBoothEventLocation: data.get('photoBoothEventLocation'),
              eventLocation: data.get('photoBoothEventLocation'),
              photoBoothExtras: data.getAll('photoBoothExtra'),
              priorities: data.get('priorities'),
              source: 'mirror-x-landing-page',
            },
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload?.ok !== true) throw new Error(payload?.error || 'Could not verify inquiry. Please try again.');
        if (turnstileSiteKey && !payload?.turnstileProof) throw new Error('Security verification could not be completed. Please try again.');
        if (payload?.turnstileProof) {
          const proof = document.createElement('input');
          proof.type = 'hidden';
          proof.name = 'koa-turnstile-proof';
          proof.value = payload.turnstileProof;
          form.appendChild(proof);
        }
        form.querySelector('[name="cf-turnstile-response"]')?.remove();
        if (payload?.notificationConfigured || payload?.deduplicated) {
          window.location.assign('/thank-you/');
          return;
        }
        form.submit();
      } catch (e) {
        form.dataset.submitting = '0';
        if (submitButton) submitButton.disabled = false;
        if (error) {
          error.textContent = e instanceof Error ? e.message : 'Could not send your inquiry. Please try again.';
          error.classList.remove('hidden');
        }
        if (window.turnstile?.reset) window.turnstile.reset();
      }
    });
  </script>
</BaseLayout>
