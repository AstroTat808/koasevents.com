---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { catalogCategories, catalogItems, catalogPricingNote, catalogBundles, bundleSavingsTiers } from '../../data/catalog';
import { businessRules } from '../../data/businessRules';
import PackageCapacityComparison from '../../components/PackageCapacityComparison.astro';

const browseCategoryOrder = ['all', 'furniture', 'decor', 'tabletop', 'production', 'bar', 'services'] as const;
const browseCatalogCategories = browseCategoryOrder
  .map((id) => catalogCategories.find((category) => category.id === id))
  .filter((category): category is NonNullable<typeof category> => Boolean(category));

const browsePriority = [
  'ceremony-chair', 'reception-chair', 'round-table', 'cocktail-table',
  'table-settings', 'lighting', 'arch-barrels', 'audio', 'dance-floor',
  'microphones', 'photo-booth', 'vintage-phone', 'glassware', 'linens',
  'dishes-place-settings', 'centerpieces', 'florals', 'lawn-games',
  'champagne-toast', 'big-island-bar', 'maui-bar', 'oahu-bar',
] as const;
const browsePriorityMap = new Map(browsePriority.map((id, index) => [id, index]));

const browseCatalogItems = catalogItems
  .filter((item) => item.category !== 'packages')
  .sort((a, b) => {
    const aPriority = browsePriorityMap.get(a.id as (typeof browsePriority)[number]) ?? 999;
    const bPriority = browsePriorityMap.get(b.id as (typeof browsePriority)[number]) ?? 999;
    if (aPriority !== bPriority) return aPriority - bPriority;
    const aCategory = browseCategoryOrder.indexOf(a.category as (typeof browseCategoryOrder)[number]);
    const bCategory = browseCategoryOrder.indexOf(b.category as (typeof browseCategoryOrder)[number]);
    if (aCategory !== bCategory) return aCategory - bCategory;
    return a.name.localeCompare(b.name);
  });

const catalogClientData = catalogItems.map((item) => ({
  id: item.id,
  name: item.name,
  bundleEligible: Boolean(item.bundleEligible),
  includedWith: item.includedWith || [],
  priceLabel: item.priceLabel,
  priceType: item.priceType,
  quantityMode: item.quantityMode || null,
  quantityLabel: item.quantityLabel || item.name,
  estimatedUnitPrice: item.estimatedUnitPrice || null,
  estimatedUnitLabel: item.estimatedUnitLabel || '',
  specs: item.specs || [],
}));
const bundleClientData = catalogBundles;
const tierClientData = bundleSavingsTiers;
const packageRuleById = {
  gardenia: businessRules.venueWeddingPackages.find((pkg) => pkg.name === 'Gardenia'),
  orchid: businessRules.venueWeddingPackages.find((pkg) => pkg.name === 'Orchid'),
  hibiscus: businessRules.venueWeddingPackages.find((pkg) => pkg.name === 'Hibiscus'),
  'signature-wedding': businessRules.venueWeddingPackages.find((pkg) => pkg.name === 'Plumeria'),
};
const packagePlanningData = Object.fromEntries(
  Object.entries(packageRuleById).map(([id, pkg]) => [id, pkg ? {
    name: pkg.publicName,
    price: pkg.price,
    access: pkg.access,
    includedInventory: pkg.includedInventory,
    includedFurnitureCoverage: pkg.includedFurnitureCoverage,
    baseConfiguration: pkg.baseConfiguration,
    includes: [...pkg.includes],
    planningInventory: pkg.planningInventory || null,
  } : null])
);

const badgeClass = {
  flagship: 'bg-[var(--koa-amber-light)] text-[var(--koa-ink)]',
  featured: 'bg-white/14 text-white ring-1 ring-white/18',
  favorite: 'bg-[var(--koa-sand)] text-[var(--koa-forest)]',
  popular: 'bg-[var(--koa-forest)] text-white',
  deal: 'bg-[var(--koa-clay)] text-white',
  included: 'bg-[var(--koa-sand)] text-[var(--koa-forest)]',
};
---
<BaseLayout
  title="Event Rentals & Price Catalog | Koa’s Events Hawaiʻi Island"
  description="Browse Koa’s Events wedding packages, Mobile Bar pricing, event rentals and enhancements in a searchable native catalog—no flipbook required."
  canonical="https://www.koasevents.com/catalog/"
>
  <Header overlay={false} />
  <main>
    <section class="overflow-hidden pb-20 pt-12 lg:pb-28 lg:pt-20">
      <div class="container-shell grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:items-end lg:gap-24">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Rental + enhancement catalog</p>
          <h1 class="display mt-5 text-6xl leading-[.93] sm:text-7xl">Build your event without the PDF.</h1>
          <p class="mt-7 max-w-2xl text-base leading-7 text-[var(--koa-ink)]/68">Choose your wedding starting point, then browse furniture, tabletop pieces, décor, production, Mobile Bar options and services. Add the extras you’re considering to a quote request and we’ll price the final scope around your date, quantities and event plan.</p>
          <a href="#start-building" class="mt-7 inline-flex min-h-11 items-center rounded-full bg-[var(--koa-forest)] px-6 py-3 text-xs font-black uppercase tracking-[.12em] text-white">Start building your quote ↓</a>
        </div>
        <div class="rounded-[1.6rem] bg-[var(--koa-forest)] p-7 text-white shadow-[var(--shadow-soft)] sm:p-9">
          <p class="eyebrow text-[var(--koa-amber-light)]">How this page works</p>
          <div class="mt-6 grid gap-5">
            <div class="grid grid-cols-[2.4rem_1fr] gap-4">
              <span class="display text-3xl text-[var(--koa-amber-light)]">01</span>
              <div><p class="text-lg font-bold leading-6">Choose your starting point</p><p class="mt-1 text-sm leading-6 text-white/58">Select the wedding package—or choose à la carte—once at the top.</p></div>
            </div>
            <div class="grid grid-cols-[2.4rem_1fr] gap-4 border-t border-white/10 pt-5">
              <span class="display text-3xl text-[var(--koa-amber-light)]">02</span>
              <div><p class="text-lg font-bold leading-6">Add only what you need</p><p class="mt-1 text-sm leading-6 text-white/58">Browse rentals, décor, production, bar enhancements and services without repurchasing the base package.</p></div>
            </div>
            <div class="grid grid-cols-[2.4rem_1fr] gap-4 border-t border-white/10 pt-5">
              <span class="display text-3xl text-[var(--koa-amber-light)]">03</span>
              <div><p class="text-lg font-bold leading-6">Request the final quote</p><p class="mt-1 text-sm leading-6 text-white/58">We confirm availability, included items, quantities and any eligible bundle savings.</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <section id="start-building" class="koa-grain scroll-mt-24 bg-[var(--koa-sand)] pb-8 pt-16 lg:pb-10 lg:pt-20">
      <div class="container-shell">
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Start here</p>
            <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Guests first. Then choose your starting point.</h2>
          </div>
          <div class="max-w-xl lg:justify-self-end">
            <label class="grid gap-2 text-sm font-semibold">
              Total guest count
              <input data-builder-guests type="number" min="1" max="100" value="50" class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-lg" />
            </label>
            <p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/58">We use this to suggest quantities for guest-based rentals. For 60-inch rounds, the comfortable planning default is 8 guests per table; 10 is the maximum and leaves much less room.</p>
          </div>
        </div>

        <div class="mt-10 grid items-stretch gap-4 md:grid-cols-2 xl:grid-cols-5" data-starting-points>
          {catalogItems.filter((item) => item.category === 'packages').map((item) => (
            <button type="button" data-starting-point={item.id} aria-pressed="false" class="relative flex h-full flex-col items-start justify-start rounded-[1.4rem] border border-[var(--koa-line)] bg-white p-6 text-left align-top transition hover:-translate-y-1 hover:border-[var(--koa-forest)]">
              <span data-selected-indicator class="absolute right-5 top-5 hidden rounded-full bg-[var(--koa-forest)] px-3 py-1.5 text-[.55rem] font-black uppercase tracking-[.11em] text-white">Selected</span>
              <span class="eyebrow pr-20 text-[var(--koa-clay)]">Base wedding package</span>
              <span class="display mt-3 flex min-h-[3.25rem] items-start text-3xl">{item.name.replace(' Wedding Collection','').replace('Koa’s Signature Wedding Experience','Signature')}</span>
              <span class="mt-3 block text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">{item.priceLabel}</span>
              <span class="mt-4 block text-sm leading-6 text-[var(--koa-ink)]/58">{item.description}</span>
              {packageRuleById[item.id] && (
                <>
                  <PackageCapacityComparison furnitureCoverage={packageRuleById[item.id]?.includedFurnitureCoverage || 'See package details'} compact />
                  <span class="mt-4 block text-xs leading-5 text-[var(--koa-ink)]/55">
                    <strong class="text-[var(--koa-forest)]">Included furniture / inventory:</strong> {packageRuleById[item.id]?.includedInventory}
                  </span>
                </>
              )}
            </button>
          ))}
          <button type="button" data-starting-point="ala-carte" aria-pressed="false" class="relative flex h-full flex-col items-start justify-start rounded-[1.4rem] border border-[var(--koa-line)] bg-white p-6 text-left align-top transition hover:-translate-y-1 hover:border-[var(--koa-forest)]">
            <span data-selected-indicator class="absolute right-5 top-5 hidden rounded-full bg-[var(--koa-forest)] px-3 py-1.5 text-[.55rem] font-black uppercase tracking-[.11em] text-white">Selected</span>
            <span class="eyebrow pr-20 text-[var(--koa-clay)]">Build from scratch</span>
            <span class="display mt-3 flex min-h-[3.25rem] items-start text-3xl">À la carte</span>
            <span class="mt-3 block text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">Custom quote</span>
            <span class="mt-4 block text-sm leading-6 text-[var(--koa-ink)]/58">Skip a base wedding package and build the event from the bundles and individual rental catalog below.</span>
          </button>
        </div>

        <div class="mt-4 hidden rounded-[1.2rem] bg-[var(--koa-forest)] p-5 text-white" data-starting-summary>
          <p class="eyebrow text-[var(--koa-amber-light)]">Your starting point</p>
          <p class="mt-2 text-sm" data-starting-summary-text></p>
        </div>

        <div class="mt-4 hidden rounded-[1.2rem] border border-[var(--koa-clay)]/30 bg-white p-5 shadow-[var(--shadow-soft)]" data-guest-adjustment>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Guest-count check</p>
              <h3 class="display mt-2 text-3xl">What your package covers—and what you may need to add.</h3>
            </div>
            <span class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.11em] text-[var(--koa-forest)]" data-guest-adjustment-count></span>
          </div>
          <p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/68" data-guest-adjustment-copy></p>
          <div class="mt-5 hidden grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-guest-adjustment-items></div>
        </div>
      </div>
    </section>

    <section class="sticky top-0 z-30 border-y border-[var(--koa-line)] bg-[rgba(251,248,241,.94)] py-4 backdrop-blur">
      <div class="container-shell flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex gap-2 overflow-x-auto pb-1 lg:pb-0" data-catalog-filters>
          {browseCatalogCategories.map((category, index) => (
            <button
              type="button"
              data-category={category.id}
              class:list={['min-h-11 whitespace-nowrap rounded-full border px-4 py-3 text-[.68rem] font-black uppercase tracking-[.11em] transition', index === 0 ? 'border-[var(--koa-forest)] bg-[var(--koa-forest)] text-white' : 'border-[var(--koa-line)] bg-white text-[var(--koa-forest)] hover:border-[var(--koa-forest)]']}
            >{category.label}</button>
          ))}
        </div>
        <label class="relative block min-w-0 lg:w-80">
          <span class="sr-only">Search catalog</span>
          <input data-catalog-search type="search" placeholder="Search chairs, bar, lighting…" class="w-full rounded-full border border-[var(--koa-line)] bg-white px-5 py-3 text-sm outline-none focus:border-[var(--koa-forest)]" />
        </label>
      </div>
    </section>

    <section class="py-16 lg:py-24">
      <div class="container-shell grid gap-10 xl:grid-cols-[1fr_22rem] xl:items-start">
        <div>
          <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Rentals + enhancements</p>
              <h2 class="display mt-3 text-4xl sm:text-5xl">Start with the things most events need.</h2>
            </div>
            <p class="text-xs leading-5 text-[var(--koa-ink)]/48" data-catalog-count>{browseCatalogItems.length} items</p>
          </div>

          <div class="grid gap-4 md:grid-cols-2" data-catalog-grid>
            {browseCatalogItems.map((item, index) => (
              <article
                data-catalog-item
                data-id={item.id}
                data-category={item.category}
                data-bundle-eligible={item.bundleEligible ? 'true' : 'false'}
                data-included-with={(item.includedWith || []).join('|')}
                data-search={[item.name, item.description, ...(item.keywords || [])].join(' ').toLowerCase()}
                data-mobile-extra={index >= 8 ? 'true' : 'false'}
                class:list={['card-lift min-h-[19rem] flex-col rounded-[1.4rem] border border-[var(--koa-line)] bg-white p-6', index >= 8 ? 'hidden md:flex' : 'flex']}
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">{browseCatalogCategories.find((category) => category.id === item.category)?.label}</span>
                  <span class="text-right text-[.66rem] font-black uppercase tracking-[.11em] text-[var(--koa-clay)]">{item.priceLabel}</span>
                </div>
                {item.badges?.length && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {item.badges.map((badge) => (
                      <span class:list={['rounded-full px-3 py-1.5 text-[.55rem] font-black uppercase tracking-[.1em]', badgeClass[badge.kind]]}>{badge.label}</span>
                    ))}
                  </div>
                )}
                <div data-package-inclusion class="mt-5 hidden rounded-xl border border-[var(--koa-forest)]/20 bg-[var(--koa-sand)] px-4 py-3">
                  <p class="text-[.58rem] font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">Included in your package</p>
                  <p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/62" data-package-inclusion-detail></p>
                </div>
                <h3 class:list={['display text-3xl leading-[1.03]', item.badges?.length ? 'mt-5' : 'mt-7']}>{item.name}</h3>
                <p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/62">{item.description}</p>
                {item.note && <p class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/42">{item.note}</p>}
                {item.bundleEligible && (
                  <p class="mt-3 text-[.58rem] font-black uppercase tracking-[.11em] text-[var(--koa-clay)]">Eligible for Koa’s Bundle Savings</p>
                )}

                {(item.includedWith?.length || item.availableQuantity || item.colors?.length || item.dimensions || item.options?.length || item.specs?.length) && (
                  <div class="mt-5 grid gap-2 border-t border-[var(--koa-line)] pt-4">
                    {item.includedWith?.length && (
                      <div class="flex flex-wrap items-start gap-x-3 gap-y-1 text-xs leading-5">
                        <span class="font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Included with</span>
                        <span class="text-[var(--koa-ink)]/58">{item.includedWith.join(' · ')}</span>
                      </div>
                    )}
                    {item.availableQuantity && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Available quantity</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.availableQuantity}</span>
                      </div>
                    )}
                    {item.dimensions && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Dimensions</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.dimensions}</span>
                      </div>
                    )}
                    {item.colors?.length && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Colors / finishes</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.colors.join(' · ')}</span>
                      </div>
                    )}
                    {item.options?.length && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Options</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.options.join(' · ')}</span>
                      </div>
                    )}
                    {item.specs?.map((spec) => (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">{spec.label}</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{spec.value}</span>
                      </div>
                    ))}
                  </div>
                )}

                {item.quantityMode && (
                  <label class="mt-6 grid gap-2 border-t border-[var(--koa-line)] pt-4 text-xs font-semibold text-[var(--koa-ink)]/72">
                    Quantity
                    <input data-item-quantity type="number" min="0" value="1" class="min-h-11 w-28 rounded-lg border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-3 py-2.5 text-sm text-[var(--koa-ink)]" />
                  </label>
                )}
                <button type="button" data-add-to-quote class="mt-auto pt-7 text-left link-arrow text-[var(--koa-forest)]">Add to quote +</button>
              </article>
            ))}
          </div>
          <button type="button" data-mobile-catalog-toggle class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-full border border-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)] md:hidden">
            Show all rentals + enhancements
          </button>

          <div data-catalog-empty class="hidden rounded-[1.4rem] border border-dashed border-[var(--koa-line)] bg-[var(--koa-sand)] p-10 text-center">
            <p class="display text-3xl">No matching catalog items.</p>
            <p class="mt-3 text-sm text-[var(--koa-ink)]/58">Try a broader search or switch back to All.</p>
          </div>
        </div>

        <aside class="xl:sticky xl:top-28">
          <div class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-amber-light)]">Your quote</p>
            <h2 class="display mt-4 text-3xl">One base. Then the extras.</h2>
            <p class="mt-3 text-sm leading-6 text-white/58">Your starting point stays separate from the rentals and enhancements you add below.</p>
            <div class="mt-6 rounded-xl border border-white/12 bg-white/[.04] p-4" data-quote-starting-point>
              <p class="text-[.58rem] font-black uppercase tracking-[.12em] text-[var(--koa-amber-light)]">Starting point</p>
              <p class="mt-2 text-sm font-semibold text-white" data-quote-starting-point-label>Choose a package or à la carte above.</p>
            </div>
            <div class="mt-6">
              <p class="text-[.58rem] font-black uppercase tracking-[.12em] text-white/45">Add-ons</p>
              <div class="mt-3 grid gap-2" data-quote-list>
                <p class="rounded-xl border border-white/10 p-4 text-sm text-white/42" data-quote-empty>No add-ons selected yet.</p>
              </div>
            </div>
            <div class="mt-5 hidden rounded-xl border border-white/12 bg-white/[.04] p-4" data-furniture-estimate>
              <p class="text-[.58rem] font-black uppercase tracking-[.12em] text-[var(--koa-amber-light)]">Estimated guest-count furniture</p>
              <p class="display mt-2 text-3xl" data-furniture-estimate-total>$0</p>
              <p class="mt-2 text-xs leading-5 text-white/58">Planning estimate for automatically required chairs and 60-inch round tables only. Final style, availability, setup and proposal pricing are confirmed by Koa’s.</p>
            </div>
            <div class="mt-5 hidden rounded-xl border border-[var(--koa-amber)]/35 bg-[var(--koa-amber)]/10 p-4" data-savings-panel>
              <p class="eyebrow text-[var(--koa-amber-light)]">Koa’s Bundle Savings</p>
              <p class="display mt-2 text-3xl" data-savings-headline></p>
              <p class="mt-2 text-xs leading-5 text-white/58" data-savings-detail></p>
            </div>
            <a href="#quote-request" data-quote-jump class="mt-6 inline-flex w-full justify-center rounded-full bg-white px-5 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Request this quote</a>
            <a href="/wedding-inquiry/" data-continue-inquiry class="mt-3 inline-flex w-full justify-center rounded-full border border-white/20 px-5 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Continue to wedding inquiry</a>
          </div>
          <p class="mt-5 max-w-2xl text-sm leading-6 text-[var(--koa-ink)]/58 xl:max-w-none">{catalogPricingNote}</p>
        </aside>
      </div>
    </section>

    <section id="bundle-savings" data-bundle-section class="scroll-mt-24 bg-[var(--koa-forest)] pb-20 pt-10 text-white lg:pb-24 lg:pt-12">
      <div class="container-shell">
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
          <div>
            <p class="eyebrow text-[var(--koa-amber-light)]">Koa’s Bundle Savings</p>
            <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Curated combinations that work better together.</h2>
          </div>
          <p class="max-w-xl text-sm leading-7 text-white/62 lg:justify-self-end">Once you know which add-ons fit your event, these combinations can simplify the shortlist. Bundle savings apply only to eligible paid add-ons; anything already included in your selected package is not charged or discounted again.</p>
        </div>

        <div class="mt-12 grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
          {catalogBundles.map((bundle) => (
            <article data-bundle-card={bundle.id} class="card-lift flex min-h-[21rem] flex-col rounded-[1.4rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-6 text-[var(--koa-ink)] shadow-[0_18px_50px_rgba(5,24,18,.18)]">
              <div class="flex flex-wrap items-center gap-2">
                <span class="eyebrow text-[var(--koa-clay)]">{bundle.eyebrow}</span>
                {bundle.badge && <span class="rounded-full bg-[var(--koa-forest)] px-3 py-1.5 text-[.55rem] font-black uppercase tracking-[.1em] text-white">{bundle.badge}</span>}
              </div>
              <h3 class="display mt-6 text-4xl">{bundle.name}</h3>
              <p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/66">{bundle.description}</p>
              <p class="mt-4 hidden rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs leading-5 text-[var(--koa-ink)]/62" data-bundle-package-status></p>
              <div class="mt-5 flex flex-wrap gap-2">
                {bundle.itemIds.map((id) => {
                  const item = catalogItems.find((entry) => entry.id === id);
                  return item ? <span class="rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.62rem] font-bold text-[var(--koa-forest)]">{item.name}</span> : null;
                })}
              </div>
              <div class="mt-auto flex flex-col gap-4 pt-7 sm:flex-row sm:items-end sm:justify-between sm:gap-5">
                <p data-bundle-savings-label class="text-xs font-black uppercase tracking-[.13em] text-[var(--koa-clay)]">Up to {bundle.savingsPercent}% bundle savings</p>
                <button type="button" data-add-bundle={bundle.id} class="min-h-11 w-full rounded-full bg-[var(--koa-forest)] px-4 py-3 text-xs font-black uppercase tracking-[.12em] text-white transition hover:-translate-y-0.5 sm:w-auto">Add bundle +</button>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 grid gap-px overflow-hidden rounded-[1.2rem] bg-white/10 sm:grid-cols-3">
          {bundleSavingsTiers.map((tier) => (
            <div class="bg-[var(--koa-forest)] p-5">
              <p class="eyebrow text-white/38">{tier.minimumItems}+ eligible add-ons</p>
              <p class="display mt-2 text-3xl">{tier.savingsPercent}% savings</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    <section id="quote-request" class="koa-grain bg-[var(--koa-sand)] py-20 lg:py-28">
      <div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Custom quote</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Turn your shortlist into a real event proposal.</h2>
          <p class="mt-6 text-base leading-7 text-[var(--koa-ink)]/64">This request is intentionally short. Once we know the event date, guest count and the items you’re considering, we can confirm the quantities and combinations that make sense.</p>
        </div>

        <form name="koa-catalog-quote-request" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7 shadow-[var(--shadow-soft)]">
          <input type="hidden" name="form-name" value="koa-catalog-quote-request" />
          <input type="hidden" name="subject" data-remove-prefix value="New Koa’s Catalog Quote (%{submissionId})" />
          <input type="hidden" name="selectedCatalogItems" value="" data-selected-items />
          <input type="hidden" name="estimatedBundleSavings" value="" data-estimated-savings />
          <input type="hidden" name="matchedCatalogBundle" value="" data-matched-bundle />
          <input type="hidden" name="startingPoint" value="" data-starting-point-input />
          <input type="hidden" name="automaticRentalBreakdown" value="" data-auto-rental-breakdown />
          <input type="hidden" name="manualAddOns" value="" data-manual-add-ons />
          <input type="hidden" name="estimatedGuestFurnitureTotal" value="" data-estimated-furniture-total />
          <input type="hidden" name="catalogSelectionState" value="" data-catalog-selection-state />
          <p class="hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold">Name<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="name" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Email<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="email" name="email" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Event date<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="date" name="eventDate" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Estimated guests<input data-quote-guests class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="number" min="1" max="100" name="guestCount" required /></label>
            <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Event type<select class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="eventType" required><option value="">Choose one</option><option>Wedding</option><option>Private event</option><option>Corporate event</option><option>Mobile Bar only</option><option>Other</option></select></label>
            <div class="sm:col-span-2 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4">
              <p class="text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">Selected add-ons</p>
              <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58" data-selected-preview>Choose rentals or enhancements above and they’ll appear here.</p>
              <p class="mt-3 hidden text-xs font-bold leading-5 text-[var(--koa-clay)]" data-selected-savings></p>
            </div>
            <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Notes or quantities<textarea class="min-h-28 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="notes" placeholder="Tell us quantities, colors, setup ideas or anything else that helps us quote accurately."></textarea></label>
            <button class="sm:col-span-2 rounded-full bg-[var(--koa-forest)] px-6 py-4 text-xs font-black uppercase tracking-[.13em] text-white" type="submit">Request custom quote</button>
          </div>
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline define:vars={{ catalogClientData, bundleClientData, tierClientData, packagePlanningData }}>
    const filterButtons = [...document.querySelectorAll('[data-catalog-filters] [data-category]')];
    const cards = [...document.querySelectorAll('[data-catalog-item]')];
    const bundleButtons = [...document.querySelectorAll('[data-add-bundle]')];
    const bundleCards = [...document.querySelectorAll('[data-bundle-card]')];
    const search = document.querySelector('[data-catalog-search]');
    const count = document.querySelector('[data-catalog-count]');
    const empty = document.querySelector('[data-catalog-empty]');
    const quoteList = document.querySelector('[data-quote-list]');
    const quoteEmpty = document.querySelector('[data-quote-empty]');
    const quoteStartingPointLabel = document.querySelector('[data-quote-starting-point-label]');
    const selectedInput = document.querySelector('[data-selected-items]');
    const selectedPreview = document.querySelector('[data-selected-preview]');
    const selectedSavings = document.querySelector('[data-selected-savings]');
    const estimatedSavingsInput = document.querySelector('[data-estimated-savings]');
    const matchedBundleInput = document.querySelector('[data-matched-bundle]');
    const savingsPanel = document.querySelector('[data-savings-panel]');
    const savingsHeadline = document.querySelector('[data-savings-headline]');
    const savingsDetail = document.querySelector('[data-savings-detail]');
    const furnitureEstimate = document.querySelector('[data-furniture-estimate]');
    const furnitureEstimateTotal = document.querySelector('[data-furniture-estimate-total]');
    const autoRentalBreakdownInput = document.querySelector('[data-auto-rental-breakdown]');
    const manualAddOnsInput = document.querySelector('[data-manual-add-ons]');
    const estimatedFurnitureTotalInput = document.querySelector('[data-estimated-furniture-total]');
    const catalogSelectionStateInput = document.querySelector('[data-catalog-selection-state]');
    const continueInquiry = document.querySelector('[data-continue-inquiry]');
    const itemById = new Map(catalogClientData.map((item) => [item.id, item]));
    const guestInput = document.querySelector('[data-builder-guests]');
    const quoteGuestInput = document.querySelector('[data-quote-guests]');
    const startingButtons = [...document.querySelectorAll('[data-starting-point]')];
    const startingSummary = document.querySelector('[data-starting-summary]');
    const startingSummaryText = document.querySelector('[data-starting-summary-text]');
    const startingPointInput = document.querySelector('[data-starting-point-input]');
    const guestAdjustment = document.querySelector('[data-guest-adjustment]');
    const guestAdjustmentCount = document.querySelector('[data-guest-adjustment-count]');
    const guestAdjustmentCopy = document.querySelector('[data-guest-adjustment-copy]');
    const guestAdjustmentItems = document.querySelector('[data-guest-adjustment-items]');
    const mobileCatalogToggle = document.querySelector('[data-mobile-catalog-toggle]');

    let activeCategory = 'all';
    let startingPoint = '';
    let mobileCatalogExpanded = false;
    const selected = new Map();
    const autoSelected = new Set();

    function guestCount() {
      return Math.max(1, Math.min(100, Number(guestInput?.value || quoteGuestInput?.value || 1)));
    }

    function selectedPackagePlan() {
      return startingPoint ? packagePlanningData[startingPoint] || null : null;
    }

    function includedQuantityForItem(item) {
      const plan = selectedPackagePlan()?.planningInventory;
      if (!plan || !item) return 0;
      if (item.id === 'ceremony-chair') return Number(plan.includedCeremonyChairs ?? plan.includedChairCount ?? 0);
      if (item.id === 'reception-chair') return Number(plan.includedReceptionChairs ?? plan.includedChairCount ?? 0);
      if (item.id === 'round-table') return Number(plan.includedRoundTables ?? 0);
      if (item.id === 'rectangle-table') return Number(plan.includedRectangleTables ?? 0);
      if (item.id === 'cocktail-table') return Number(plan.includedCocktailTables ?? 0);
      return 0;
    }

    function recommendedTotalForItem(item) {
      const guests = guestCount();
      if (item?.quantityMode === 'guest-count') return guests;
      if (item?.quantityMode === 'round-tables') return Math.ceil(guests / 8);
      return 1;
    }

    function suggestedQuantity(item) {
      const recommendedTotal = recommendedTotalForItem(item);
      const included = isIncludedBySelectedPackage(item) ? includedQuantityForItem(item) : 0;
      return Math.max(0, recommendedTotal - included);
    }

    function autoRequiredItemIds() {
      if (!selectedPackagePlan() || startingPoint === 'ala-carte') return [];
      const ids = ['ceremony-chair', 'reception-chair'];
      if (startingPoint === 'gardenia' || startingPoint === 'hibiscus' || startingPoint === 'signature-wedding') {
        ids.push('round-table');
      }
      return ids;
    }

    function syncAutoRequiredRentals() {
      const requiredIds = new Set(autoRequiredItemIds());

      [...autoSelected].forEach((id) => {
        if (!requiredIds.has(id)) {
          autoSelected.delete(id);
          selected.delete(id);
          setItemButtonState(id, false);
        }
      });

      requiredIds.forEach((id) => {
        const item = itemById.get(id);
        if (!item) return;
        const quantity = suggestedQuantity(item);

        if (quantity > 0) {
          selected.set(id, { name: item.name, quantity, auto: true });
          autoSelected.add(id);
          setItemButtonState(id, true);
        } else if (autoSelected.has(id)) {
          autoSelected.delete(id);
          selected.delete(id);
          setItemButtonState(id, false);
        }
      });
    }

    function syncSuggestedQuantities() {
      cards.forEach((card) => {
        const id = card.dataset.id;
        const item = id ? itemById.get(id) : null;
        const input = card.querySelector('[data-item-quantity]');
        if (!item || !input || item.quantityMode === 'manual') return;
        input.value = String(suggestedQuantity(item));
        if (selected.has(id) && !autoSelected.has(id)) {
          selected.set(id, { name: item.name, quantity: Math.max(1, Number(input.value) || 1) });
        }
      });
      if (quoteGuestInput) quoteGuestInput.value = String(guestCount());
      syncAutoRequiredRentals();
      syncQuote();
    }

    function chooseStartingPoint(id) {
      startingPoint = id;
      [...autoSelected].forEach((autoId) => {
        selected.delete(autoId);
        setItemButtonState(autoId, false);
      });
      autoSelected.clear();
      if (startingPointInput) startingPointInput.value = id;
      startingButtons.forEach((button) => {
        const on = button.dataset.startingPoint === id;
        button.setAttribute('aria-pressed', String(on));
        button.classList.toggle('border-[var(--koa-forest)]', on);
        button.classList.toggle('shadow-[0_14px_40px_rgba(23,61,48,.16)]', on);
        button.querySelector('[data-selected-indicator]')?.classList.toggle('hidden', !on);
      });

      const packageItem = itemById.get(id);

      startingSummary?.classList.remove('hidden');
      if (startingSummaryText) {
        startingSummaryText.textContent = id === 'ala-carte'
          ? 'À la carte selected. Build with bundles and individual rentals below.'
          : (packageItem?.name || id) + ' selected. Included items are recognized automatically, and guest-count furniture add-ons are preselected when your entered attendance exceeds the package allowance.';
      }
      if (quoteStartingPointLabel) {
        quoteStartingPointLabel.textContent = id === 'ala-carte'
          ? 'À la carte'
          : (packageItem?.name || 'Choose a package or à la carte above.');
      }
      refreshPackageInclusions();
      refreshBundleAvailability();
      renderGuestAdjustment();
      syncSuggestedQuantities();

      window.setTimeout(() => {
        document.querySelector('[data-catalog-filters]')?.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      }, 180);
    }

    function cardFor(id) {
      return cards.find((card) => card.dataset.id === id);
    }

    function setItemButtonState(id, isSelected) {
      const button = cardFor(id)?.querySelector('[data-add-to-quote]');
      if (!button) return;
      const item = itemById.get(id);
      const included = item ? isIncludedBySelectedPackage(item) : false;
      button.textContent = isSelected ? 'Added ✓' : included ? 'Add extra +' : 'Add to quote +';
      button.classList.toggle('text-[var(--koa-clay)]', isSelected);
    }

    function applyFilters() {
      const term = (search?.value || '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
        const searchMatch = !term || (card.dataset.search || '').includes(term);
        const isMobileExtra = card.dataset.mobileExtra === 'true';
        const matches = categoryMatch && searchMatch;
        const revealForMobile = mobileCatalogExpanded || activeCategory !== 'all' || Boolean(term) || !isMobileExtra;
        const showOnMobile = matches && revealForMobile;

        if (isMobileExtra) {
          card.classList.toggle('md:flex', matches);
          card.classList.toggle('hidden', !showOnMobile);
        } else {
          card.classList.toggle('hidden', !matches);
        }
        if (showOnMobile) visible += 1;
      });

      if (count) {
        const totalMatching = cards.filter((card) => {
          const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
          const searchMatch = !term || (card.dataset.search || '').includes(term);
          return categoryMatch && searchMatch;
        }).length;
        const mobileCollapsed = window.matchMedia('(max-width: 767px)').matches && !mobileCatalogExpanded && activeCategory === 'all' && !term;
        count.textContent = mobileCollapsed
          ? visible + ' shown · ' + totalMatching + ' total'
          : totalMatching + (totalMatching === 1 ? ' item' : ' items');
      }
      if (mobileCatalogToggle) {
        const shouldShowToggle = activeCategory === 'all' && !term && !mobileCatalogExpanded && cards.some((card) => card.dataset.mobileExtra === 'true');
        mobileCatalogToggle.classList.toggle('hidden', !shouldShowToggle);
      }
      empty?.classList.toggle('hidden', visible !== 0);
    }

    function selectedPackageIds() {
      return ['signature-wedding', 'hibiscus', 'orchid', 'gardenia'].includes(startingPoint)
        ? [startingPoint]
        : [];
    }

    function isIncludedBySelectedPackage(item) {
      const packages = selectedPackageIds();
      if (!packages.length || !item?.includedWith?.length) return false;

      const selectedPackageNames = packages.map((id) =>
        id === 'signature-wedding'
          ? 'Signature'
          : id.charAt(0).toUpperCase() + id.slice(1)
      );

      return selectedPackageNames.some((name) =>
        item.includedWith.includes(name) ||
        item.includedWith.includes(name + ' Wedding Experience')
      );
    }

    function selectedPackageDisplayName() {
      if (!startingPoint || startingPoint === 'ala-carte') return '';
      return itemById.get(startingPoint)?.name || '';
    }

    function renderGuestAdjustment() {
      const plan = selectedPackagePlan();
      const guests = guestCount();

      if (!plan || startingPoint === 'ala-carte') {
        guestAdjustment?.classList.add('hidden');
        return;
      }

      guestAdjustment?.classList.remove('hidden');
      if (guestAdjustmentCount) guestAdjustmentCount.textContent = guests + (guests === 1 ? ' guest' : ' guests');

      const inventory = plan.planningInventory || {};
      const additions = [];
      const generalChairCount = Number(inventory.includedChairCount ?? 0);
      const ceremonyChairCount = Number(inventory.includedCeremonyChairs ?? 0);
      const receptionChairCount = Number(inventory.includedReceptionChairs ?? 0);
      const roundTables = Number(inventory.includedRoundTables ?? 0);

      if (ceremonyChairCount || receptionChairCount) {
        const extraCeremony = Math.max(0, guests - ceremonyChairCount);
        const extraReception = Math.max(0, guests - receptionChairCount);
        if (extraCeremony > 0) additions.push({ label: 'Additional ceremony chairs', value: extraCeremony });
        if (extraReception > 0) additions.push({ label: 'Additional reception chairs', value: extraReception });
      } else if (generalChairCount) {
        const extraChairs = Math.max(0, guests - generalChairCount);
        if (extraChairs > 0) additions.push({ label: 'Additional chairs', value: extraChairs });
      }

      if (roundTables) {
        const recommendedTables = Math.ceil(guests / 8);
        const extraTables = Math.max(0, recommendedTables - roundTables);
        if (extraTables > 0) additions.push({ label: 'Additional 60-inch rounds', value: extraTables });
      }

      if (guestAdjustmentCopy) {
        const base = plan.name + ' includes ' + plan.includedInventory + '. ';
        if (startingPoint === 'orchid') {
          const extraChairs = Math.max(0, guests - Number(inventory.includedChairCount ?? 0));
          guestAdjustmentCopy.textContent = base + (
            extraChairs > 0
              ? 'For ' + guests + ' guests, ' + extraChairs + ' additional ceremony chairs and ' + extraChairs + ' additional reception chairs are preselected below. Because Orchid includes 2 tables of your choice, the number of additional tables depends on the table style you select and will be confirmed in the quote.'
              : 'Your entered guest count is within the included chair quantity. Table capacity still depends on which 2 table styles you select.'
          );
        } else if (additions.length) {
          guestAdjustmentCopy.textContent = base + 'Your guest count exceeds part of the included furniture inventory, so the additional chair and table quantities below are automatically preselected in your quote.';
        } else {
          guestAdjustmentCopy.textContent = base + 'Your entered guest count fits within the published included furniture quantities using the 8-guests-per-round planning default.';
        }
      }

      if (guestAdjustmentItems) {
        guestAdjustmentItems.innerHTML = '';
        guestAdjustmentItems.classList.toggle('hidden', additions.length === 0);
        additions.forEach((entry) => {
          const box = document.createElement('div');
          box.className = 'rounded-xl bg-[var(--koa-sand)] p-4';
          const label = document.createElement('p');
          label.className = 'text-[.58rem] font-black uppercase tracking-[.11em] text-[var(--koa-clay)]';
          label.textContent = entry.label;
          const value = document.createElement('p');
          value.className = 'display mt-1 text-3xl text-[var(--koa-forest)]';
          value.textContent = String(entry.value);
          box.append(label, value);
          const itemId = entry.label.includes('60-inch') ? 'round-table' : entry.label.includes('ceremony') ? 'ceremony-chair' : 'reception-chair';
          const item = itemById.get(itemId);
          const estimated = Number(item?.estimatedUnitPrice || 0) * Number(entry.value || 0);
          if (estimated > 0) {
            const price = document.createElement('p');
            price.className = 'mt-2 text-xs font-bold text-[var(--koa-forest)]/70';
            price.textContent = currency(estimated) + ' estimated';
            box.appendChild(price);
          }
          guestAdjustmentItems.appendChild(box);
        });
      }
    }

    function knownIncludedQuantity(item) {
      if (!item) return '';
      const plan = selectedPackagePlan()?.planningInventory;
      if (!plan) return '';
      if (item.id === 'ceremony-chair') {
        const qty = Number(plan.includedCeremonyChairs ?? plan.includedChairCount ?? 0);
        return qty ? qty + ' chair' + (qty === 1 ? '' : 's') : '';
      }
      if (item.id === 'reception-chair') {
        const qty = Number(plan.includedReceptionChairs ?? plan.includedChairCount ?? 0);
        return qty ? qty + ' chair' + (qty === 1 ? '' : 's') : '';
      }
      if (item.id === 'round-table') {
        const qty = Number(plan.includedRoundTables ?? 0);
        return qty ? qty + ' 60-inch round table' + (qty === 1 ? '' : 's') : '';
      }
      if (item.id === 'rectangle-table') {
        const qty = Number(plan.includedRectangleTables ?? 0);
        return qty ? qty + ' six-foot rectangle table' + (qty === 1 ? '' : 's') : '';
      }
      if (item.id === 'cocktail-table') {
        const qty = Number(plan.includedCocktailTables ?? 0);
        return qty ? qty + ' cocktail table' + (qty === 1 ? '' : 's') : '';
      }
      return '';
    }

    function refreshPackageInclusions() {
      cards.forEach((card) => {
        const id = card.dataset.id;
        const item = id ? itemById.get(id) : null;
        const panel = card.querySelector('[data-package-inclusion]');
        const detail = card.querySelector('[data-package-inclusion-detail]');
        const included = item ? isIncludedBySelectedPackage(item) : false;
        panel?.classList.toggle('hidden', !included);
        if (included && detail) {
          const quantity = knownIncludedQuantity(item);
          const pkg = selectedPackageDisplayName();
          detail.textContent = quantity
            ? quantity + ' included with ' + pkg + '. Add more only if your event needs additional inventory.'
            : 'Included with ' + pkg + '. Add more only if your event needs additional inventory.';
        }
        if (id) setItemButtonState(id, selected.has(id));
      });
    }

    function refreshBundleAvailability() {
      bundleCards.forEach((card) => {
        const bundle = bundleClientData.find((entry) => entry.id === card.dataset.bundleCard);
        if (!bundle) return;
        const includedIds = bundle.itemIds.filter((id) => {
          const item = itemById.get(id);
          return item ? isIncludedBySelectedPackage(item) : false;
        });
        const paidIds = bundle.itemIds.filter((id) => !includedIds.includes(id));
        const status = card.querySelector('[data-bundle-package-status]');
        const button = card.querySelector('[data-add-bundle]');
        const savingsLabel = card.querySelector('[data-bundle-savings-label]');
        if (!status || !button || !savingsLabel) return;

        if (!startingPoint || startingPoint === 'ala-carte' || includedIds.length === 0) {
          status.classList.add('hidden');
          savingsLabel.textContent = 'Up to ' + bundle.savingsPercent + '% bundle savings';
          button.disabled = false;
          button.textContent = 'Add bundle +';
          button.classList.remove('opacity-45');
          return;
        }

        status.classList.remove('hidden');
        if (paidIds.length === 0) {
          status.textContent = 'Everything in this bundle is already included with your selected package.';
          savingsLabel.textContent = 'Already included with your package';
          button.disabled = true;
          button.textContent = 'Already included';
          button.classList.add('opacity-45');
          return;
        }

        const includedNames = includedIds.map((id) => itemById.get(id)?.name).filter(Boolean).join(', ');
        button.disabled = false;
        button.classList.remove('opacity-45');

        if (paidIds.length === 1) {
          status.textContent = includedNames + ' already included. Only one paid item remains, so it will be quoted individually rather than presented as a bundle discount.';
          savingsLabel.textContent = 'Remaining item quoted individually';
          button.textContent = 'Add remaining item +';
        } else {
          status.textContent = includedNames + ' already included. Adding this bundle will add only the remaining paid items.';
          savingsLabel.textContent = 'Up to ' + bundle.savingsPercent + '% savings on remaining eligible items';
          button.textContent = 'Add remaining items +';
        }
      });
    }

    function calculateSavings() {
      const selectedIds = [...selected.keys()];

      const eligiblePaid = selectedIds.filter((id) => {
        const item = itemById.get(id);
        return item?.bundleEligible && !isIncludedBySelectedPackage(item);
      });

      let tier = null;
      for (const candidate of tierClientData) {
        if (eligiblePaid.length >= candidate.minimumItems) tier = candidate;
      }

      let bestBundle = null;
      for (const bundle of bundleClientData) {
        const paidBundleItems = bundle.itemIds.filter((id) => {
          const item = itemById.get(id);
          return item && !isIncludedBySelectedPackage(item);
        });

        const complete =
          paidBundleItems.length > 1 &&
          paidBundleItems.every((id) => selectedIds.includes(id));

        if (
          complete &&
          (!bestBundle || bundle.savingsPercent > bestBundle.savingsPercent)
        ) {
          bestBundle = bundle;
        }
      }

      const tierPercent = tier?.savingsPercent || 0;
      const bundlePercent = bestBundle?.savingsPercent || 0;
      const percent = Math.max(tierPercent, bundlePercent);

      return { eligiblePaid, tier, bestBundle, percent };
    }

    function renderSavings() {
      const savings = calculateSavings();
      const hasSavings = savings.percent > 0;

      savingsPanel?.classList.toggle('hidden', !hasSavings);
      selectedSavings?.classList.toggle('hidden', !hasSavings);

      if (!hasSavings) {
        if (estimatedSavingsInput) estimatedSavingsInput.value = '';
        if (matchedBundleInput) matchedBundleInput.value = '';
        if (selectedSavings) selectedSavings.textContent = '';
        return;
      }

      const curatedWins =
        savings.bestBundle &&
        savings.bestBundle.savingsPercent >= (savings.tier?.savingsPercent || 0);

      const headline = curatedWins
        ? savings.bestBundle.name
        : savings.percent + '% estimated bundle savings';

      const detail = curatedWins
        ? 'You completed the ' +
          savings.bestBundle.name +
          ', qualifying for up to ' +
          savings.percent +
          '% savings on eligible paid add-ons.'
        : savings.eligiblePaid.length +
          ' eligible paid add-ons qualify for up to ' +
          savings.percent +
          '% Koa’s Bundle Savings.';

      if (savingsHeadline) savingsHeadline.textContent = headline;
      if (savingsDetail) savingsDetail.textContent = detail;
      if (selectedSavings) selectedSavings.textContent = detail;
      if (estimatedSavingsInput) {
        estimatedSavingsInput.value = String(savings.percent) + '% estimated';
      }
      if (matchedBundleInput) {
        matchedBundleInput.value = curatedWins ? savings.bestBundle.name : '';
      }
    }

    function currency(value) {
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(value || 0);
    }

    function autoRentalReason(id, quantity) {
      const item = itemById.get(id);
      const included = includedQuantityForItem(item);
      const recommended = recommendedTotalForItem(item);
      const packageName = selectedPackageDisplayName() || 'your selected package';
      if (id === 'round-table') {
        return packageName + ' includes ' + included + ' 60-inch round table' + (included === 1 ? '' : 's') + '. At ' + guestCount() + ' guests, the planning default is ' + recommended + ' total rounds at 8 guests per table, so ' + quantity + ' additional table' + (quantity === 1 ? '' : 's') + ' are preselected.';
      }
      return packageName + ' includes ' + included + ' ' + (id === 'ceremony-chair' ? 'ceremony' : 'reception') + ' chair' + (included === 1 ? '' : 's') + '. Your guest count is ' + guestCount() + ', so ' + quantity + ' additional chair' + (quantity === 1 ? '' : 's') + ' are preselected.';
    }

    function estimatedLineTotal(id, entry) {
      const item = itemById.get(id);
      const unit = Number(item?.estimatedUnitPrice || 0);
      return entry.auto && unit ? unit * Number(entry.quantity || 0) : 0;
    }

    function persistSelectionState() {
      const selectedState = [...selected.entries()].map(([id, entry]) => ({
        id,
        ...entry,
        reason: entry.auto ? autoRentalReason(id, entry.quantity) : '',
        estimatedLineTotal: estimatedLineTotal(id, entry),
      }));
      const estimatedFurnitureTotal = selectedState.reduce((sum, entry) => sum + Number(entry.estimatedLineTotal || 0), 0);
      const state = {
        version: 1,
        startingPoint,
        guestCount: guestCount(),
        selected: selectedState,
        estimatedFurnitureTotal,
        updatedAt: new Date().toISOString(),
      };
      try {
        localStorage.setItem('koaQuoteStateV1', JSON.stringify(state));
      } catch {}
      if (catalogSelectionStateInput) catalogSelectionStateInput.value = JSON.stringify(state);
      if (continueInquiry) {
        const params = new URLSearchParams();
        if (startingPoint && startingPoint !== 'ala-carte') {
          params.set('package', startingPoint === 'signature-wedding' ? 'signature' : startingPoint);
        }
        params.set('guests', String(guestCount()));
        continueInquiry.href = '/wedding-inquiry/?' + params.toString();
      }
    }

    function restoreSelectionState() {
      const params = new URLSearchParams(window.location.search);
      let saved = null;
      try {
        saved = JSON.parse(localStorage.getItem('koaQuoteStateV1') || 'null');
      } catch {}

      const requestedPackage = params.get('package');
      const requestedGuests = Number(params.get('guests') || 0);
      const normalizedPackage = requestedPackage === 'signature' || requestedPackage === 'plumeria'
        ? 'signature-wedding'
        : requestedPackage;

      if (requestedGuests > 0 && guestInput) guestInput.value = String(Math.min(100, Math.max(1, requestedGuests)));
      else if (saved?.guestCount && guestInput) guestInput.value = String(Math.min(100, Math.max(1, Number(saved.guestCount))));

      const start = normalizedPackage || saved?.startingPoint || '';
      if (start && [...startingButtons].some((button) => button.dataset.startingPoint === start)) {
        chooseStartingPoint(start);
      }

      if (saved?.selected?.length) {
        saved.selected.forEach((entry) => {
          const item = itemById.get(entry.id);
          if (!item || entry.auto) return;
          selected.set(entry.id, { name: item.name, quantity: Math.max(1, Number(entry.quantity || 1)), auto: false });
          const card = cardFor(entry.id);
          const quantityInput = card?.querySelector('[data-item-quantity]');
          if (quantityInput) quantityInput.value = String(Math.max(1, Number(entry.quantity || 1)));
          setItemButtonState(entry.id, true);
        });
      }
    }

    function syncQuote() {
      const entries = [...selected.entries()];

      quoteList
        ?.querySelectorAll('[data-selected-row]')
        .forEach((row) => row.remove());

      quoteEmpty?.classList.toggle('hidden', entries.length > 0);

      entries.forEach(([id, entry]) => {
        const row = document.createElement('div');
        row.dataset.selectedRow = 'true';
        row.className =
          'flex items-center justify-between gap-3 rounded-xl border border-white/10 px-4 py-3 text-sm';

        const label = document.createElement('span');
        label.className = 'min-w-0';
        const title = document.createElement('span');
        title.className = 'block';
        title.textContent = entry.quantity && entry.quantity !== 1 ? entry.name + ' × ' + entry.quantity : entry.name;
        label.appendChild(title);
        if (entry.auto) {
          const auto = document.createElement('span');
          auto.className = 'mt-1 block text-[.55rem] font-black uppercase tracking-[.1em] text-[var(--koa-amber-light)]';
          auto.textContent = 'Guest-count add-on';
          label.appendChild(auto);

          const reason = document.createElement('span');
          reason.className = 'mt-2 block text-xs leading-5 text-white/55';
          reason.textContent = autoRentalReason(id, entry.quantity);
          label.appendChild(reason);

          const estimate = estimatedLineTotal(id, entry);
          if (estimate > 0) {
            const price = document.createElement('span');
            price.className = 'mt-2 block text-xs font-bold text-white/80';
            price.textContent = currency(estimate) + ' estimated (' + currency(itemById.get(id)?.estimatedUnitPrice) + ' × ' + entry.quantity + ')';
            label.appendChild(price);
          }
        }

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'text-white/45 hover:text-white';
        remove.setAttribute('aria-label', 'Remove ' + entry.name);
        remove.textContent = '×';

        remove.addEventListener('click', () => {
          selected.delete(id);
          autoSelected.delete(id);
          setItemButtonState(id, false);
          syncQuote();
        });

        row.append(label, remove);
        quoteList?.appendChild(row);
      });

      const names = entries.map(([, entry]) => entry.quantity && entry.quantity !== 1 ? entry.name + ' × ' + entry.quantity : entry.name);
      const joined = names.join(' | ');
      const autoEntries = entries.filter(([, entry]) => entry.auto);
      const manualEntries = entries.filter(([, entry]) => !entry.auto);
      const autoBreakdown = autoEntries.map(([id, entry]) => {
        const estimate = estimatedLineTotal(id, entry);
        return (entry.quantity + ' × ' + entry.name) + ' — ' + autoRentalReason(id, entry.quantity) + (estimate ? ' Estimated: ' + currency(estimate) + '.' : '');
      }).join(' | ');
      const manualBreakdown = manualEntries.map(([, entry]) => entry.quantity + ' × ' + entry.name).join(' | ');
      const furnitureTotal = autoEntries.reduce((sum, [id, entry]) => sum + estimatedLineTotal(id, entry), 0);

      if (selectedInput) selectedInput.value = joined;
      if (autoRentalBreakdownInput) autoRentalBreakdownInput.value = autoBreakdown;
      if (manualAddOnsInput) manualAddOnsInput.value = manualBreakdown;
      if (estimatedFurnitureTotalInput) estimatedFurnitureTotalInput.value = furnitureTotal ? currency(furnitureTotal) + ' planning estimate' : '$0';
      if (selectedPreview) {
        selectedPreview.textContent =
          joined || 'Choose rentals or enhancements above and they’ll appear here.';
      }
      furnitureEstimate?.classList.toggle('hidden', furnitureTotal <= 0);
      if (furnitureEstimateTotal) furnitureEstimateTotal.textContent = currency(furnitureTotal);

      renderSavings();
      persistSelectionState();
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.category || 'all';

        filterButtons.forEach((item) => {
          const on = item === button;
          item.classList.toggle('bg-[var(--koa-forest)]', on);
          item.classList.toggle('text-white', on);
          item.classList.toggle('border-[var(--koa-forest)]', on);
          item.classList.toggle('bg-white', !on);
          item.classList.toggle('text-[var(--koa-forest)]', !on);
        });

        applyFilters();
      });
    });

    search?.addEventListener('input', applyFilters);

    mobileCatalogToggle?.addEventListener('click', () => {
      mobileCatalogExpanded = true;
      applyFilters();
    });

    cards.forEach((card) => {
      const button = card.querySelector('[data-add-to-quote]');
      button?.addEventListener('click', () => {
        const id = card.dataset.id;
        const item = id ? itemById.get(id) : null;
        if (!id || !item) return;

        if (selected.has(id)) {
          selected.delete(id);
          autoSelected.delete(id);
          setItemButtonState(id, false);
        } else {
          const quantityInput = card.querySelector('[data-item-quantity]');
          const quantity = quantityInput ? Math.max(1, Number(quantityInput.value || 1)) : 1;
          selected.set(id, { name: item.name, quantity, auto: false });
          setItemButtonState(id, true);
        }

        syncQuote();
      });
    });

    bundleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const bundle = bundleClientData.find(
          (item) => item.id === button.dataset.addBundle
        );
        if (!bundle) return;

        bundle.itemIds.forEach((id) => {
          const item = itemById.get(id);
          if (!item || isIncludedBySelectedPackage(item)) return;
          selected.set(id, { name: item.name, quantity: Math.max(1, suggestedQuantity(item)), auto: false });
          const card = cardFor(id);
          const quantityInput = card?.querySelector('[data-item-quantity]');
          if (quantityInput && item.quantityMode !== 'manual') quantityInput.value = String(suggestedQuantity(item));
          setItemButtonState(id, true);
        });

        syncQuote();

        const originalText = button.textContent;
        button.textContent = 'Bundle added ✓';
        button.disabled = true;

        window.setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1400);

        quoteList?.scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        });
      });
    });

    startingButtons.forEach((button) => button.addEventListener('click', () => chooseStartingPoint(button.dataset.startingPoint || '')));
    guestInput?.addEventListener('input', () => {
      renderGuestAdjustment();
      syncSuggestedQuantities();
    });
    quoteGuestInput?.addEventListener('input', () => {
      if (guestInput) guestInput.value = quoteGuestInput.value;
      renderGuestAdjustment();
      syncSuggestedQuantities();
    });
    cards.forEach((card) => {
      card.querySelector('[data-item-quantity]')?.addEventListener('input', (event) => {
        const id = card.dataset.id;
        const item = id ? itemById.get(id) : null;
        if (!id || !item || !selected.has(id)) return;
        autoSelected.delete(id);
        selected.set(id, { name: item.name, quantity: Math.max(1, Number(event.target.value || 1)), auto: false });
        syncQuote();
      });
    });

    restoreSelectionState();
    if (quoteGuestInput) quoteGuestInput.value = String(guestCount());
    applyFilters();
    refreshPackageInclusions();
    refreshBundleAvailability();
    renderGuestAdjustment();
    syncSuggestedQuantities();
  </script>
</BaseLayout>
