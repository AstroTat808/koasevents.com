---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { catalogCategories, catalogItems, catalogPricingNote, catalogBundles, bundleSavingsTiers } from '../../data/catalog';

const browseCategoryOrder = ['all', 'furniture', 'decor', 'tabletop', 'production', 'bar', 'services'] as const;
const browseCatalogCategories = browseCategoryOrder
  .map((id) => catalogCategories.find((category) => category.id === id))
  .filter((category): category is NonNullable<typeof category> => Boolean(category));

const browsePriority = [
  'ceremony-chair',
  'reception-chair',
  'round-table',
  'cocktail-table',
  'table-settings',
  'lighting',
  'arch-barrels',
  'audio',
  'dance-floor',
  'microphones',
  'photo-booth',
  'vintage-phone',
  'glassware',
  'linens',
  'dishes-place-settings',
  'centerpieces',
  'florals',
  'lawn-games',
  'champagne-toast',
  'big-island-bar',
  'maui-bar',
  'oahu-bar',
] as const;
const browsePriorityMap = new Map(browsePriority.map((id, index) => [id, index]));

const browseCatalogItems = catalogItems
  .filter((item) => item.category !== 'packages')
  .sort((a, b) => {
    const aPriority = browsePriorityMap.get(a.id as (typeof browsePriority)[number]) ?? 999;
    const bPriority = browsePriorityMap.get(b.id as (typeof browsePriority)[number]) ?? 999;
    if (aPriority !== bPriority) return aPriority - bPriority;

    const aCategory = browseCategoryOrder.indexOf(a.category as (typeof browseCategoryOrder)[number]);
    const bCategory = browseCategoryOrder.indexOf(b.category as (typeof browseCategoryOrder)[number]);
    if (aCategory !== bCategory) return aCategory - bCategory;

    return a.name.localeCompare(b.name);
  });

const catalogClientData = catalogItems.map((item) => ({
  id: item.id,
  name: item.name,
  bundleEligible: Boolean(item.bundleEligible),
  includedWith: item.includedWith || [],
  priceLabel: item.priceLabel,
  quantityMode: item.quantityMode || null,
  quantityLabel: item.quantityLabel || item.name,
}));
const bundleClientData = catalogBundles;
const tierClientData = bundleSavingsTiers;

const badgeClass = {
  flagship: 'bg-[var(--koa-amber-light)] text-[var(--koa-ink)]',
  featured: 'bg-white/14 text-white ring-1 ring-white/18',
  favorite: 'bg-[var(--koa-sand)] text-[var(--koa-forest)]',
  popular: 'bg-[var(--koa-forest)] text-white',
  deal: 'bg-[var(--koa-clay)] text-white',
  included: 'bg-[var(--koa-sand)] text-[var(--koa-forest)]',
};
---
<BaseLayout
  title="Event Rentals & Price Catalog | Koa’s Events Hawaiʻi Island"
  description="Browse Koa’s Events wedding packages, Mobile Bar pricing, event rentals and enhancements in a searchable native catalog—no flipbook required."
  canonical="https://www.koasevents.com/catalog/"
>
  <Header overlay={false} />
  <main>
    <section class="overflow-hidden pb-20 pt-12 lg:pb-28 lg:pt-20">
      <div class="container-shell grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:items-end lg:gap-24">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Rental + enhancement catalog</p>
          <h1 class="display mt-5 text-6xl leading-[.93] sm:text-7xl">Build your event without the PDF.</h1>
          <p class="mt-7 max-w-2xl text-base leading-7 text-[var(--koa-ink)]/68">Choose your wedding starting point, then browse furniture, tabletop pieces, décor, production, Mobile Bar options and services. Add the extras you’re considering to a quote request and we’ll price the final scope around your date, quantities and event plan.</p>
        </div>
        <div class="rounded-[1.6rem] bg-[var(--koa-forest)] p-7 text-white shadow-[var(--shadow-soft)] sm:p-9">
          <p class="eyebrow text-[var(--koa-amber-light)]">How this page works</p>
          <div class="mt-6 grid gap-5">
            <div class="grid grid-cols-[2.4rem_1fr] gap-4">
              <span class="display text-3xl text-[var(--koa-amber-light)]">01</span>
              <div><h2 class="font-bold">Choose your starting point</h2><p class="mt-1 text-sm leading-6 text-white/58">Select the wedding package—or choose à la carte—once at the top.</p></div>
            </div>
            <div class="grid grid-cols-[2.4rem_1fr] gap-4 border-t border-white/10 pt-5">
              <span class="display text-3xl text-[var(--koa-amber-light)]">02</span>
              <div><h2 class="font-bold">Add only what you need</h2><p class="mt-1 text-sm leading-6 text-white/58">Browse rentals, décor, production, bar enhancements and services without repurchasing the base package.</p></div>
            </div>
            <div class="grid grid-cols-[2.4rem_1fr] gap-4 border-t border-white/10 pt-5">
              <span class="display text-3xl text-[var(--koa-amber-light)]">03</span>
              <div><h2 class="font-bold">Request the final quote</h2><p class="mt-1 text-sm leading-6 text-white/58">We confirm availability, included items, quantities and any eligible bundle savings.</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <section class="koa-grain bg-[var(--koa-sand)] py-20 lg:py-24">
      <div class="container-shell">
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Start here</p>
            <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Guests first. Then choose your starting point.</h2>
          </div>
          <div class="max-w-xl lg:justify-self-end">
            <label class="grid gap-2 text-sm font-semibold">
              Total guest count
              <input data-builder-guests type="number" min="1" max="100" value="50" class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-lg" />
            </label>
            <p class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/52">We use this to suggest quantities for guest-based rentals. For 60-inch rounds, the comfortable planning default is 8 guests per table; 10 is the maximum and leaves much less room.</p>
          </div>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-5" data-starting-points>
          {catalogItems.filter((item) => item.category === 'packages').map((item) => (
            <button type="button" data-starting-point={item.id} class="rounded-[1.4rem] border border-[var(--koa-line)] bg-white p-6 text-left transition hover:-translate-y-1 hover:border-[var(--koa-forest)]">
              <span class="eyebrow text-[var(--koa-clay)]">Base wedding package</span>
              <span class="display mt-3 block text-3xl">{item.name.replace(' Wedding Collection','').replace('Koa’s Signature Wedding Experience','Signature')}</span>
              <span class="mt-3 block text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">{item.priceLabel}</span>
              <span class="mt-4 block text-sm leading-6 text-[var(--koa-ink)]/58">{item.description}</span>
            </button>
          ))}
          <button type="button" data-starting-point="ala-carte" class="rounded-[1.4rem] border border-[var(--koa-line)] bg-white p-6 text-left transition hover:-translate-y-1 hover:border-[var(--koa-forest)]">
            <span class="eyebrow text-[var(--koa-clay)]">Build from scratch</span>
            <span class="display mt-3 block text-3xl">À la carte</span>
            <span class="mt-3 block text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">Custom quote</span>
            <span class="mt-4 block text-sm leading-6 text-[var(--koa-ink)]/58">Skip a base wedding package and build the event from the bundles and individual rental catalog below.</span>
          </button>
        </div>

        <div class="mt-6 hidden rounded-[1.2rem] bg-[var(--koa-forest)] p-5 text-white" data-starting-summary>
          <p class="eyebrow text-[var(--koa-amber-light)]">Your starting point</p>
          <p class="mt-2 text-sm" data-starting-summary-text></p>
        </div>
      </div>
    </section>

    <section class="sticky top-0 z-30 border-y border-[var(--koa-line)] bg-[rgba(251,248,241,.94)] py-4 backdrop-blur">
      <div class="container-shell flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex gap-2 overflow-x-auto pb-1 lg:pb-0" data-catalog-filters>
          {browseCatalogCategories.map((category, index) => (
            <button
              type="button"
              data-category={category.id}
              class:list={['whitespace-nowrap rounded-full border px-4 py-2.5 text-[.68rem] font-black uppercase tracking-[.11em] transition', index === 0 ? 'border-[var(--koa-forest)] bg-[var(--koa-forest)] text-white' : 'border-[var(--koa-line)] bg-white text-[var(--koa-forest)] hover:border-[var(--koa-forest)]']}
            >{category.label}</button>
          ))}
        </div>
        <label class="relative block min-w-0 lg:w-80">
          <span class="sr-only">Search catalog</span>
          <input data-catalog-search type="search" placeholder="Search chairs, bar, lighting…" class="w-full rounded-full border border-[var(--koa-line)] bg-white px-5 py-3 text-sm outline-none focus:border-[var(--koa-forest)]" />
        </label>
      </div>
    </section>

    <section class="py-16 lg:py-24">
      <div class="container-shell grid gap-10 xl:grid-cols-[1fr_22rem] xl:items-start">
        <div>
          <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Rentals + enhancements</p>
              <h2 class="display mt-3 text-4xl sm:text-5xl">Start with the things most events need.</h2>
            </div>
            <p class="text-xs leading-5 text-[var(--koa-ink)]/48" data-catalog-count>{browseCatalogItems.length} items</p>
          </div>

          <div class="grid gap-4 md:grid-cols-2" data-catalog-grid>
            {browseCatalogItems.map((item) => (
              <article
                data-catalog-item
                data-id={item.id}
                data-category={item.category}
                data-bundle-eligible={item.bundleEligible ? 'true' : 'false'}
                data-included-with={(item.includedWith || []).join('|')}
                data-search={[item.name, item.description, ...(item.keywords || [])].join(' ').toLowerCase()}
                class="card-lift flex min-h-[19rem] flex-col rounded-[1.4rem] border border-[var(--koa-line)] bg-white p-6"
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">{browseCatalogCategories.find((category) => category.id === item.category)?.label}</span>
                  <span class="text-right text-[.66rem] font-black uppercase tracking-[.11em] text-[var(--koa-clay)]">{item.priceLabel}</span>
                </div>
                {item.badges?.length && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {item.badges.map((badge) => (
                      <span class:list={['rounded-full px-3 py-1.5 text-[.55rem] font-black uppercase tracking-[.1em]', badgeClass[badge.kind]]}>{badge.label}</span>
                    ))}
                  </div>
                )}
                <h3 class:list={['display text-3xl leading-[1.03]', item.badges?.length ? 'mt-5' : 'mt-7']}>{item.name}</h3>
                <p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/62">{item.description}</p>
                {item.note && <p class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/42">{item.note}</p>}
                {item.bundleEligible && (
                  <p class="mt-3 text-[.58rem] font-black uppercase tracking-[.11em] text-[var(--koa-clay)]">Eligible for Koa’s Bundle Savings</p>
                )}

                {(item.includedWith?.length || item.availableQuantity || item.colors?.length || item.dimensions || item.options?.length || item.specs?.length) && (
                  <div class="mt-5 grid gap-2 border-t border-[var(--koa-line)] pt-4">
                    {item.includedWith?.length && (
                      <div class="flex flex-wrap items-start gap-x-3 gap-y-1 text-xs leading-5">
                        <span class="font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Included with</span>
                        <span class="text-[var(--koa-ink)]/58">{item.includedWith.join(' · ')}</span>
                      </div>
                    )}
                    {item.availableQuantity && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Available quantity</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.availableQuantity}</span>
                      </div>
                    )}
                    {item.dimensions && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Dimensions</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.dimensions}</span>
                      </div>
                    )}
                    {item.colors?.length && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Colors / finishes</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.colors.join(' · ')}</span>
                      </div>
                    )}
                    {item.options?.length && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Options</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.options.join(' · ')}</span>
                      </div>
                    )}
                    {item.specs?.map((spec) => (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">{spec.label}</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{spec.value}</span>
                      </div>
                    ))}
                  </div>
                )}

                {item.quantityMode && (
                  <label class="mt-6 grid gap-2 border-t border-[var(--koa-line)] pt-4 text-xs font-semibold text-[var(--koa-ink)]/72">
                    Quantity
                    <input data-item-quantity type="number" min="0" value="1" class="w-28 rounded-lg border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-3 py-2 text-sm text-[var(--koa-ink)]" />
                  </label>
                )}
                <button type="button" data-add-to-quote class="mt-auto pt-7 text-left link-arrow text-[var(--koa-forest)]">Add to quote +</button>
              </article>
            ))}
          </div>

          <div data-catalog-empty class="hidden rounded-[1.4rem] border border-dashed border-[var(--koa-line)] bg-[var(--koa-sand)] p-10 text-center">
            <p class="display text-3xl">No matching catalog items.</p>
            <p class="mt-3 text-sm text-[var(--koa-ink)]/58">Try a broader search or switch back to All.</p>
          </div>
        </div>

        <aside class="xl:sticky xl:top-28">
          <div class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-amber-light)]">Your quote</p>
            <h2 class="display mt-4 text-3xl">One base. Then the extras.</h2>
            <p class="mt-3 text-sm leading-6 text-white/58">Your starting point stays separate from the rentals and enhancements you add below.</p>
            <div class="mt-6 rounded-xl border border-white/12 bg-white/[.04] p-4" data-quote-starting-point>
              <p class="text-[.58rem] font-black uppercase tracking-[.12em] text-[var(--koa-amber-light)]">Starting point</p>
              <p class="mt-2 text-sm font-semibold text-white" data-quote-starting-point-label>Choose a package or à la carte above.</p>
            </div>
            <div class="mt-6">
              <p class="text-[.58rem] font-black uppercase tracking-[.12em] text-white/45">Add-ons</p>
              <div class="mt-3 grid gap-2" data-quote-list>
                <p class="rounded-xl border border-white/10 p-4 text-sm text-white/42" data-quote-empty>No add-ons selected yet.</p>
              </div>
            </div>
            <div class="mt-5 hidden rounded-xl border border-[var(--koa-amber)]/35 bg-[var(--koa-amber)]/10 p-4" data-savings-panel>
              <p class="eyebrow text-[var(--koa-amber-light)]">Koa’s Bundle Savings</p>
              <p class="display mt-2 text-3xl" data-savings-headline></p>
              <p class="mt-2 text-xs leading-5 text-white/58" data-savings-detail></p>
            </div>
            <a href="#quote-request" data-quote-jump class="mt-6 inline-flex w-full justify-center rounded-full bg-white px-5 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Request this quote</a>
          </div>
          <p class="mt-5 text-sm leading-6 text-[var(--koa-ink)]/58">{catalogPricingNote}</p>
        </aside>
      </div>
    </section>

    <section class="bg-[var(--koa-forest)] py-20 text-white lg:py-28">
      <div class="container-shell">
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
          <div>
            <p class="eyebrow text-[var(--koa-amber-light)]">Koa’s Bundle Savings</p>
            <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Curated combinations that work better together.</h2>
          </div>
          <p class="max-w-xl text-sm leading-7 text-white/62 lg:justify-self-end">Once you know which add-ons fit your event, these combinations can simplify the shortlist. Bundle savings apply only to eligible paid add-ons; anything already included in your selected package is not charged or discounted again.</p>
        </div>

        <div class="mt-12 grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
          {catalogBundles.map((bundle) => (
            <article class="flex min-h-[21rem] flex-col rounded-[1.4rem] border border-white/12 bg-white/[.05] p-6">
              <div class="flex flex-wrap items-center gap-2">
                <span class="eyebrow text-[var(--koa-amber-light)]">{bundle.eyebrow}</span>
                {bundle.badge && <span class="rounded-full bg-white/10 px-3 py-1.5 text-[.55rem] font-black uppercase tracking-[.1em] text-white">{bundle.badge}</span>}
              </div>
              <h3 class="display mt-6 text-4xl">{bundle.name}</h3>
              <p class="mt-4 text-sm leading-6 text-white/62">{bundle.description}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {bundle.itemIds.map((id) => {
                  const item = catalogItems.find((entry) => entry.id === id);
                  return item ? <span class="rounded-full border border-white/12 px-3 py-2 text-[.62rem] font-bold text-white/70">{item.name}</span> : null;
                })}
              </div>
              <div class="mt-auto flex items-end justify-between gap-5 pt-7">
                <p class="text-xs font-black uppercase tracking-[.13em] text-[var(--koa-amber-light)]">Up to {bundle.savingsPercent}% bundle savings</p>
                <button type="button" data-add-bundle={bundle.id} class="text-xs font-black uppercase tracking-[.12em] text-white">Add bundle +</button>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 grid gap-px overflow-hidden rounded-[1.2rem] bg-white/10 sm:grid-cols-3">
          {bundleSavingsTiers.map((tier) => (
            <div class="bg-[var(--koa-forest)] p-5">
              <p class="eyebrow text-white/38">{tier.minimumItems}+ eligible add-ons</p>
              <p class="display mt-2 text-3xl">{tier.savingsPercent}% savings</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    <section id="quote-request" class="koa-grain bg-[var(--koa-sand)] py-20 lg:py-28">
      <div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Custom quote</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Turn your shortlist into a real event proposal.</h2>
          <p class="mt-6 text-base leading-7 text-[var(--koa-ink)]/64">This request is intentionally short. Once we know the event date, guest count and the items you’re considering, we can confirm the quantities and combinations that make sense.</p>
        </div>

        <form name="koa-catalog-quote-request" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7 shadow-[var(--shadow-soft)]">
          <input type="hidden" name="form-name" value="koa-catalog-quote-request" />
          <input type="hidden" name="subject" data-remove-prefix value="New Koa’s Catalog Quote (%{submissionId})" />
          <input type="hidden" name="selectedCatalogItems" value="" data-selected-items />
          <input type="hidden" name="estimatedBundleSavings" value="" data-estimated-savings />
          <input type="hidden" name="matchedCatalogBundle" value="" data-matched-bundle />
          <input type="hidden" name="startingPoint" value="" data-starting-point-input />
          <p class="hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold">Name<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="name" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Email<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="email" name="email" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Event date<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="date" name="eventDate" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Estimated guests<input data-quote-guests class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="number" min="1" max="100" name="guestCount" required /></label>
            <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Event type<select class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="eventType" required><option value="">Choose one</option><option>Wedding</option><option>Private event</option><option>Corporate event</option><option>Mobile Bar only</option><option>Other</option></select></label>
            <div class="sm:col-span-2 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4">
              <p class="text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">Selected add-ons</p>
              <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58" data-selected-preview>Choose rentals or enhancements above and they’ll appear here.</p>
              <p class="mt-3 hidden text-xs font-bold leading-5 text-[var(--koa-clay)]" data-selected-savings></p>
            </div>
            <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Notes or quantities<textarea class="min-h-28 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="notes" placeholder="Tell us quantities, colors, setup ideas or anything else that helps us quote accurately."></textarea></label>
            <button class="sm:col-span-2 rounded-full bg-[var(--koa-forest)] px-6 py-4 text-xs font-black uppercase tracking-[.13em] text-white" type="submit">Request custom quote</button>
          </div>
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline define:vars={{ catalogClientData, bundleClientData, tierClientData }}>
    const filterButtons = [...document.querySelectorAll('[data-catalog-filters] [data-category]')];
    const cards = [...document.querySelectorAll('[data-catalog-item]')];
    const bundleButtons = [...document.querySelectorAll('[data-add-bundle]')];
    const search = document.querySelector('[data-catalog-search]');
    const count = document.querySelector('[data-catalog-count]');
    const empty = document.querySelector('[data-catalog-empty]');
    const quoteList = document.querySelector('[data-quote-list]');
    const quoteEmpty = document.querySelector('[data-quote-empty]');
    const quoteStartingPointLabel = document.querySelector('[data-quote-starting-point-label]');
    const selectedInput = document.querySelector('[data-selected-items]');
    const selectedPreview = document.querySelector('[data-selected-preview]');
    const selectedSavings = document.querySelector('[data-selected-savings]');
    const estimatedSavingsInput = document.querySelector('[data-estimated-savings]');
    const matchedBundleInput = document.querySelector('[data-matched-bundle]');
    const savingsPanel = document.querySelector('[data-savings-panel]');
    const savingsHeadline = document.querySelector('[data-savings-headline]');
    const savingsDetail = document.querySelector('[data-savings-detail]');
    const itemById = new Map(catalogClientData.map((item) => [item.id, item]));
    const guestInput = document.querySelector('[data-builder-guests]');
    const quoteGuestInput = document.querySelector('[data-quote-guests]');
    const startingButtons = [...document.querySelectorAll('[data-starting-point]')];
    const startingSummary = document.querySelector('[data-starting-summary]');
    const startingSummaryText = document.querySelector('[data-starting-summary-text]');
    const startingPointInput = document.querySelector('[data-starting-point-input]');

    let activeCategory = 'all';
    let startingPoint = '';
    const selected = new Map();

    function guestCount() {
      return Math.max(1, Math.min(100, Number(guestInput?.value || quoteGuestInput?.value || 1)));
    }

    function suggestedQuantity(item) {
      const guests = guestCount();
      if (item?.quantityMode === 'guest-count') return guests;
      if (item?.quantityMode === 'round-tables') return Math.ceil(guests / 8);
      return 1;
    }

    function syncSuggestedQuantities() {
      cards.forEach((card) => {
        const id = card.dataset.id;
        const item = id ? itemById.get(id) : null;
        const input = card.querySelector('[data-item-quantity]');
        if (!item || !input || item.quantityMode === 'manual') return;
        input.value = String(suggestedQuantity(item));
        if (selected.has(id)) {
          selected.set(id, { name: item.name, quantity: Number(input.value) || 1 });
        }
      });
      if (quoteGuestInput) quoteGuestInput.value = String(guestCount());
      syncQuote();
    }

    function chooseStartingPoint(id) {
      startingPoint = id;
      if (startingPointInput) startingPointInput.value = id;
      startingButtons.forEach((button) => {
        const on = button.dataset.startingPoint === id;
        button.classList.toggle('bg-[var(--koa-forest)]', on);
        button.classList.toggle('text-white', on);
        button.classList.toggle('border-[var(--koa-forest)]', on);
      });

      const packageItem = itemById.get(id);

      startingSummary?.classList.remove('hidden');
      if (startingSummaryText) {
        startingSummaryText.textContent = id === 'ala-carte'
          ? 'À la carte selected. Build with bundles and individual rentals below.'
          : (packageItem?.name || id) + ' selected. Included items will be recognized before bundle savings are calculated.';
      }
      if (quoteStartingPointLabel) {
        quoteStartingPointLabel.textContent = id === 'ala-carte'
          ? 'À la carte'
          : (packageItem?.name || 'Choose a package or à la carte above.');
      }
      cards.forEach((card) => {
        const cardId = card.dataset.id;
        if (cardId) setItemButtonState(cardId, selected.has(cardId));
      });
      syncQuote();
    }

    function cardFor(id) {
      return cards.find((card) => card.dataset.id === id);
    }

    function setItemButtonState(id, isSelected) {
      const button = cardFor(id)?.querySelector('[data-add-to-quote]');
      if (!button) return;
      const item = itemById.get(id);
      const included = item ? isIncludedBySelectedPackage(item) : false;
      button.textContent = isSelected ? 'Added ✓' : included ? 'Add extra +' : 'Add to quote +';
      button.classList.toggle('text-[var(--koa-clay)]', isSelected);
    }

    function applyFilters() {
      const term = (search?.value || '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
        const searchMatch = !term || (card.dataset.search || '').includes(term);
        const show = categoryMatch && searchMatch;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      if (count) count.textContent = visible + (visible === 1 ? ' item' : ' items');
      empty?.classList.toggle('hidden', visible !== 0);
    }

    function selectedPackageIds() {
      return ['signature-wedding', 'hibiscus', 'orchid', 'gardenia'].includes(startingPoint)
        ? [startingPoint]
        : [];
    }

    function isIncludedBySelectedPackage(item) {
      const packages = selectedPackageIds();
      if (!packages.length || !item?.includedWith?.length) return false;

      const selectedPackageNames = packages.map((id) =>
        id === 'signature-wedding'
          ? 'Signature'
          : id.charAt(0).toUpperCase() + id.slice(1)
      );

      return selectedPackageNames.some((name) =>
        item.includedWith.includes(name) ||
        item.includedWith.includes(name + ' Wedding Experience')
      );
    }

    function calculateSavings() {
      const selectedIds = [...selected.keys()];

      const eligiblePaid = selectedIds.filter((id) => {
        const item = itemById.get(id);
        return item?.bundleEligible && !isIncludedBySelectedPackage(item);
      });

      let tier = null;
      for (const candidate of tierClientData) {
        if (eligiblePaid.length >= candidate.minimumItems) tier = candidate;
      }

      let bestBundle = null;
      for (const bundle of bundleClientData) {
        const paidBundleItems = bundle.itemIds.filter((id) => {
          const item = itemById.get(id);
          return item && !isIncludedBySelectedPackage(item);
        });

        const complete =
          paidBundleItems.length > 1 &&
          paidBundleItems.every((id) => selectedIds.includes(id));

        if (
          complete &&
          (!bestBundle || bundle.savingsPercent > bestBundle.savingsPercent)
        ) {
          bestBundle = bundle;
        }
      }

      const tierPercent = tier?.savingsPercent || 0;
      const bundlePercent = bestBundle?.savingsPercent || 0;
      const percent = Math.max(tierPercent, bundlePercent);

      return { eligiblePaid, tier, bestBundle, percent };
    }

    function renderSavings() {
      const savings = calculateSavings();
      const hasSavings = savings.percent > 0;

      savingsPanel?.classList.toggle('hidden', !hasSavings);
      selectedSavings?.classList.toggle('hidden', !hasSavings);

      if (!hasSavings) {
        if (estimatedSavingsInput) estimatedSavingsInput.value = '';
        if (matchedBundleInput) matchedBundleInput.value = '';
        if (selectedSavings) selectedSavings.textContent = '';
        return;
      }

      const curatedWins =
        savings.bestBundle &&
        savings.bestBundle.savingsPercent >= (savings.tier?.savingsPercent || 0);

      const headline = curatedWins
        ? savings.bestBundle.name
        : savings.percent + '% estimated bundle savings';

      const detail = curatedWins
        ? 'You completed the ' +
          savings.bestBundle.name +
          ', qualifying for up to ' +
          savings.percent +
          '% savings on eligible paid add-ons.'
        : savings.eligiblePaid.length +
          ' eligible paid add-ons qualify for up to ' +
          savings.percent +
          '% Koa’s Bundle Savings.';

      if (savingsHeadline) savingsHeadline.textContent = headline;
      if (savingsDetail) savingsDetail.textContent = detail;
      if (selectedSavings) selectedSavings.textContent = detail;
      if (estimatedSavingsInput) {
        estimatedSavingsInput.value = String(savings.percent) + '% estimated';
      }
      if (matchedBundleInput) {
        matchedBundleInput.value = curatedWins ? savings.bestBundle.name : '';
      }
    }

    function syncQuote() {
      const entries = [...selected.entries()];

      quoteList
        ?.querySelectorAll('[data-selected-row]')
        .forEach((row) => row.remove());

      quoteEmpty?.classList.toggle('hidden', entries.length > 0);

      entries.forEach(([id, entry]) => {
        const row = document.createElement('div');
        row.dataset.selectedRow = 'true';
        row.className =
          'flex items-center justify-between gap-3 rounded-xl border border-white/10 px-4 py-3 text-sm';

        const label = document.createElement('span');
        label.textContent = entry.quantity && entry.quantity !== 1 ? entry.name + ' × ' + entry.quantity : entry.name;

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'text-white/45 hover:text-white';
        remove.setAttribute('aria-label', 'Remove ' + entry.name);
        remove.textContent = '×';

        remove.addEventListener('click', () => {
          selected.delete(id);
          setItemButtonState(id, false);
          syncQuote();
        });

        row.append(label, remove);
        quoteList?.appendChild(row);
      });

      const names = entries.map(([, entry]) => entry.quantity && entry.quantity !== 1 ? entry.name + ' × ' + entry.quantity : entry.name);
      const joined = names.join(' | ');

      if (selectedInput) selectedInput.value = joined;
      if (selectedPreview) {
        selectedPreview.textContent =
          joined || 'Choose rentals or enhancements above and they’ll appear here.';
      }

      renderSavings();
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.category || 'all';

        filterButtons.forEach((item) => {
          const on = item === button;
          item.classList.toggle('bg-[var(--koa-forest)]', on);
          item.classList.toggle('text-white', on);
          item.classList.toggle('border-[var(--koa-forest)]', on);
          item.classList.toggle('bg-white', !on);
          item.classList.toggle('text-[var(--koa-forest)]', !on);
        });

        applyFilters();
      });
    });

    search?.addEventListener('input', applyFilters);

    cards.forEach((card) => {
      const button = card.querySelector('[data-add-to-quote]');
      button?.addEventListener('click', () => {
        const id = card.dataset.id;
        const item = id ? itemById.get(id) : null;
        if (!id || !item) return;

        if (selected.has(id)) {
          selected.delete(id);
          setItemButtonState(id, false);
        } else {
          const quantityInput = card.querySelector('[data-item-quantity]');
          const quantity = quantityInput ? Math.max(1, Number(quantityInput.value || 1)) : 1;
          selected.set(id, { name: item.name, quantity });
          setItemButtonState(id, true);
        }

        syncQuote();
      });
    });

    bundleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const bundle = bundleClientData.find(
          (item) => item.id === button.dataset.addBundle
        );
        if (!bundle) return;

        bundle.itemIds.forEach((id) => {
          const item = itemById.get(id);
          if (!item || isIncludedBySelectedPackage(item)) return;
          selected.set(id, { name: item.name, quantity: suggestedQuantity(item) });
          const card = cardFor(id);
          const quantityInput = card?.querySelector('[data-item-quantity]');
          if (quantityInput && item.quantityMode !== 'manual') quantityInput.value = String(suggestedQuantity(item));
          setItemButtonState(id, true);
        });

        syncQuote();

        const originalText = button.textContent;
        button.textContent = 'Bundle added ✓';
        button.disabled = true;

        window.setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1400);

        quoteList?.scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        });
      });
    });

    startingButtons.forEach((button) => button.addEventListener('click', () => chooseStartingPoint(button.dataset.startingPoint || '')));
    guestInput?.addEventListener('input', syncSuggestedQuantities);
    quoteGuestInput?.addEventListener('input', () => {
      if (guestInput) guestInput.value = quoteGuestInput.value;
      syncSuggestedQuantities();
    });
    cards.forEach((card) => {
      card.querySelector('[data-item-quantity]')?.addEventListener('input', (event) => {
        const id = card.dataset.id;
        const item = id ? itemById.get(id) : null;
        if (!id || !item || !selected.has(id)) return;
        selected.set(id, { name: item.name, quantity: Math.max(1, Number(event.target.value || 1)) });
        syncQuote();
      });
    });

    if (quoteGuestInput) quoteGuestInput.value = String(guestCount());
    applyFilters();
    syncSuggestedQuantities();
  </script>
</BaseLayout>
