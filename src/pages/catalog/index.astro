---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { catalogCategories, catalogItems, catalogPricingNote } from '../../data/catalog';

const featured = catalogItems.filter((item) => item.featured);

const badgeClass = {
  flagship: 'bg-[var(--koa-amber-light)] text-[var(--koa-ink)]',
  featured: 'bg-white/14 text-white ring-1 ring-white/18',
  favorite: 'bg-[var(--koa-sand)] text-[var(--koa-forest)]',
  popular: 'bg-[var(--koa-forest)] text-white',
  deal: 'bg-[var(--koa-clay)] text-white',
  included: 'bg-[var(--koa-sand)] text-[var(--koa-forest)]',
};
---
<BaseLayout
  title="Event Rentals & Price Catalog | Koa’s Events Hawaiʻi Island"
  description="Browse Koa’s Events wedding packages, Mobile Bar pricing, event rentals and enhancements in a searchable native catalog—no flipbook required."
  canonical="https://www.koasevents.com/catalog/"
>
  <Header overlay={false} />
  <main>
    <section class="overflow-hidden pb-20 pt-12 lg:pb-28 lg:pt-20">
      <div class="container-shell grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:items-end lg:gap-24">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Rental + enhancement catalog</p>
          <h1 class="display mt-5 text-6xl leading-[.93] sm:text-7xl">Build the event without flipping through a PDF.</h1>
          <p class="mt-7 max-w-2xl text-base leading-7 text-[var(--koa-ink)]/68">Search Koa’s packages, furniture, tabletop pieces, décor, production, Mobile Bar options and services. Add anything you’re considering to a quote request and we’ll price the final scope around your date, quantities and event plan.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {featured.map((item) => (
            <a href={item.id === 'signature-wedding' ? '/signature-wedding/' : '/mobile-bar/'} class="rounded-[1.4rem] bg-[var(--koa-forest)] p-7 text-white shadow-[var(--shadow-soft)]">
              <div class="flex flex-wrap gap-2">
                {(item.badges || [{ kind: 'featured', label: 'Featured' }]).map((badge) => (
                  <span class:list={['rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.11em]', badgeClass[badge.kind]]}>{badge.label}</span>
                ))}
              </div>
              <h2 class="display mt-5 text-4xl">{item.name}</h2>
              <p class="mt-3 text-sm leading-6 text-white/62">{item.description}</p>
              <p class="mt-6 text-xs font-black uppercase tracking-[.13em]">{item.priceLabel}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sticky top-0 z-30 border-y border-[var(--koa-line)] bg-[rgba(251,248,241,.94)] py-4 backdrop-blur">
      <div class="container-shell flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex gap-2 overflow-x-auto pb-1 lg:pb-0" data-catalog-filters>
          {catalogCategories.map((category, index) => (
            <button
              type="button"
              data-category={category.id}
              class:list={['whitespace-nowrap rounded-full border px-4 py-2.5 text-[.68rem] font-black uppercase tracking-[.11em] transition', index === 0 ? 'border-[var(--koa-forest)] bg-[var(--koa-forest)] text-white' : 'border-[var(--koa-line)] bg-white text-[var(--koa-forest)] hover:border-[var(--koa-forest)]']}
            >{category.label}</button>
          ))}
        </div>
        <label class="relative block min-w-0 lg:w-80">
          <span class="sr-only">Search catalog</span>
          <input data-catalog-search type="search" placeholder="Search chairs, bar, lighting…" class="w-full rounded-full border border-[var(--koa-line)] bg-white px-5 py-3 text-sm outline-none focus:border-[var(--koa-forest)]" />
        </label>
      </div>
    </section>

    <section class="py-16 lg:py-24">
      <div class="container-shell grid gap-10 xl:grid-cols-[1fr_22rem] xl:items-start">
        <div>
          <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Browse the collection</p>
              <h2 class="display mt-3 text-4xl sm:text-5xl">Pricing you can actually scan.</h2>
            </div>
            <p class="text-xs leading-5 text-[var(--koa-ink)]/48" data-catalog-count>{catalogItems.length} items</p>
          </div>

          <div class="grid gap-4 md:grid-cols-2" data-catalog-grid>
            {catalogItems.map((item) => (
              <article
                data-catalog-item
                data-id={item.id}
                data-category={item.category}
                data-search={[item.name, item.description, ...(item.keywords || [])].join(' ').toLowerCase()}
                class="card-lift flex min-h-[19rem] flex-col rounded-[1.4rem] border border-[var(--koa-line)] bg-white p-6"
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">{catalogCategories.find((category) => category.id === item.category)?.label}</span>
                  <span class="text-right text-[.66rem] font-black uppercase tracking-[.11em] text-[var(--koa-clay)]">{item.priceLabel}</span>
                </div>
                {item.badges?.length && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {item.badges.map((badge) => (
                      <span class:list={['rounded-full px-3 py-1.5 text-[.55rem] font-black uppercase tracking-[.1em]', badgeClass[badge.kind]]}>{badge.label}</span>
                    ))}
                  </div>
                )}
                <h3 class:list={['display text-3xl leading-[1.03]', item.badges?.length ? 'mt-5' : 'mt-7']}>{item.name}</h3>
                <p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/62">{item.description}</p>
                {item.note && <p class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/42">{item.note}</p>}

                {(item.includedWith?.length || item.availableQuantity || item.colors?.length || item.dimensions || item.options?.length || item.specs?.length) && (
                  <div class="mt-5 grid gap-2 border-t border-[var(--koa-line)] pt-4">
                    {item.includedWith?.length && (
                      <div class="flex flex-wrap items-start gap-x-3 gap-y-1 text-xs leading-5">
                        <span class="font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Included with</span>
                        <span class="text-[var(--koa-ink)]/58">{item.includedWith.join(' · ')}</span>
                      </div>
                    )}
                    {item.availableQuantity && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Available quantity</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.availableQuantity}</span>
                      </div>
                    )}
                    {item.dimensions && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Dimensions</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.dimensions}</span>
                      </div>
                    )}
                    {item.colors?.length && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Colors / finishes</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.colors.join(' · ')}</span>
                      </div>
                    )}
                    {item.options?.length && (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">Options</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{item.options.join(' · ')}</span>
                      </div>
                    )}
                    {item.specs?.map((spec) => (
                      <div class="flex flex-wrap items-start justify-between gap-2 text-xs leading-5">
                        <span class="font-semibold text-[var(--koa-ink)]/72">{spec.label}</span>
                        <span class="text-right text-[var(--koa-ink)]/48">{spec.value}</span>
                      </div>
                    ))}
                  </div>
                )}

                <button type="button" data-add-to-quote class="mt-auto pt-7 text-left link-arrow text-[var(--koa-forest)]">Add to quote +</button>
              </article>
            ))}
          </div>

          <div data-catalog-empty class="hidden rounded-[1.4rem] border border-dashed border-[var(--koa-line)] bg-[var(--koa-sand)] p-10 text-center">
            <p class="display text-3xl">No matching catalog items.</p>
            <p class="mt-3 text-sm text-[var(--koa-ink)]/58">Try a broader search or switch back to All.</p>
          </div>
        </div>

        <aside class="xl:sticky xl:top-28">
          <div class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-amber-light)]">Your quote list</p>
            <h2 class="display mt-4 text-3xl">Save what you like.</h2>
            <p class="mt-3 text-sm leading-6 text-white/58">Choose the pieces you’re considering. We’ll confirm availability, quantity and final pricing rather than making you decode a flipbook.</p>
            <div class="mt-6 grid gap-2" data-quote-list>
              <p class="rounded-xl border border-white/10 p-4 text-sm text-white/42" data-quote-empty>No items selected yet.</p>
            </div>
            <a href="#quote-request" data-quote-jump class="mt-6 inline-flex w-full justify-center rounded-full bg-white px-5 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Request this quote</a>
          </div>
          <p class="mt-5 text-xs leading-5 text-[var(--koa-ink)]/48">{catalogPricingNote}</p>
        </aside>
      </div>
    </section>

    <section id="quote-request" class="koa-grain bg-[var(--koa-sand)] py-20 lg:py-28">
      <div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Custom quote</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Turn your shortlist into a real event proposal.</h2>
          <p class="mt-6 text-base leading-7 text-[var(--koa-ink)]/64">This request is intentionally short. Once we know the event date, guest count and the items you’re considering, we can confirm the quantities and combinations that make sense.</p>
        </div>

        <form name="koa-catalog-quote-request" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7 shadow-[var(--shadow-soft)]">
          <input type="hidden" name="form-name" value="koa-catalog-quote-request" />
          <input type="hidden" name="selectedCatalogItems" value="" data-selected-items />
          <p class="hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold">Name<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="name" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Email<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="email" name="email" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Event date<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="date" name="eventDate" required /></label>
            <label class="grid gap-2 text-sm font-semibold">Estimated guests<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="number" min="1" name="guestCount" required /></label>
            <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Event type<select class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="eventType" required><option value="">Choose one</option><option>Wedding</option><option>Private event</option><option>Corporate event</option><option>Mobile Bar only</option><option>Other</option></select></label>
            <div class="sm:col-span-2 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4">
              <p class="text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">Selected items</p>
              <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58" data-selected-preview>Choose items above and they’ll appear here.</p>
            </div>
            <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Notes or quantities<textarea class="min-h-28 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="notes" placeholder="Tell us quantities, colors, setup ideas or anything else that helps us quote accurately."></textarea></label>
            <button class="sm:col-span-2 rounded-full bg-[var(--koa-forest)] px-6 py-4 text-xs font-black uppercase tracking-[.13em] text-white" type="submit">Request custom quote</button>
          </div>
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    const filterButtons = [...document.querySelectorAll('[data-catalog-filters] [data-category]')];
    const cards = [...document.querySelectorAll('[data-catalog-item]')];
    const search = document.querySelector('[data-catalog-search]');
    const count = document.querySelector('[data-catalog-count]');
    const empty = document.querySelector('[data-catalog-empty]');
    const quoteList = document.querySelector('[data-quote-list]');
    const quoteEmpty = document.querySelector('[data-quote-empty]');
    const selectedInput = document.querySelector('[data-selected-items]');
    const selectedPreview = document.querySelector('[data-selected-preview]');
    let activeCategory = 'all';
    const selected = new Map();

    function applyFilters() {
      const term = (search?.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
        const searchMatch = !term || (card.dataset.search || '').includes(term);
        const show = categoryMatch && searchMatch;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      if (count) count.textContent = visible + (visible === 1 ? ' item' : ' items');
      empty?.classList.toggle('hidden', visible !== 0);
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.category || 'all';
        filterButtons.forEach((item) => {
          const on = item === button;
          item.classList.toggle('bg-[var(--koa-forest)]', on);
          item.classList.toggle('text-white', on);
          item.classList.toggle('border-[var(--koa-forest)]', on);
          item.classList.toggle('bg-white', !on);
          item.classList.toggle('text-[var(--koa-forest)]', !on);
        });
        applyFilters();
      });
    });
    search?.addEventListener('input', applyFilters);

    function syncQuote() {
      const names = [...selected.values()];
      quoteList?.querySelectorAll('[data-selected-row]').forEach((row) => row.remove());
      quoteEmpty?.classList.toggle('hidden', names.length > 0);
      names.forEach((name) => {
        const row = document.createElement('div');
        row.dataset.selectedRow = 'true';
        row.className = 'flex items-center justify-between gap-3 rounded-xl border border-white/10 px-4 py-3 text-sm';
        row.innerHTML = '<span></span><button type="button" class="text-white/45 hover:text-white" aria-label="Remove item">×</button>';
        row.querySelector('span').textContent = name;
        row.querySelector('button').addEventListener('click', () => {
          const id = [...selected.entries()].find(([, value]) => value === name)?.[0];
          if (id) {
            selected.delete(id);
            document.querySelector('[data-catalog-item][data-id="' + CSS.escape(id) + '"] [data-add-to-quote]')?.classList.remove('text-[var(--koa-clay)]');
            document.querySelector('[data-catalog-item][data-id="' + CSS.escape(id) + '"] [data-add-to-quote]').textContent = 'Add to quote +';
          }
          syncQuote();
        });
        quoteList?.appendChild(row);
      });
      const joined = names.join(' | ');
      if (selectedInput) selectedInput.value = joined;
      if (selectedPreview) selectedPreview.textContent = joined || 'Choose items above and they’ll appear here.';
    }

    cards.forEach((card) => {
      const button = card.querySelector('[data-add-to-quote]');
      button?.addEventListener('click', () => {
        const id = card.dataset.id;
        const name = card.querySelector('h3')?.textContent?.trim();
        if (!id || !name) return;
        if (selected.has(id)) {
          selected.delete(id);
          button.textContent = 'Add to quote +';
          button.classList.remove('text-[var(--koa-clay)]');
        } else {
          selected.set(id, name);
          button.textContent = 'Added ✓';
          button.classList.add('text-[var(--koa-clay)]');
        }
        syncQuote();
      });
    });
  </script>
</BaseLayout>
