---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Vendor Event Brief | Koa’s Events" description="Review and acknowledge event-specific vendor instructions." canonical="https://koasevents.com/vendor-brief/">
<main class="min-h-screen bg-[var(--koa-sand)] py-10"><div class="container-shell max-w-4xl">
<section data-loading class="rounded-[1.5rem] bg-white p-8"><h1 class="display text-5xl">Loading Event Brief…</h1></section>
<section data-error class="hidden rounded-[1.5rem] bg-white p-8"><h1 class="display text-5xl">Event Brief unavailable</h1><p data-error-copy class="mt-3 text-sm"></p></section>
<div data-app class="hidden grid gap-6">
<header class="rounded-[1.8rem] bg-[var(--koa-forest)] p-8 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Koa’s Events · Vendor Operations</p><h1 data-title class="display mt-3 text-5xl">Event Brief</h1><p data-meta class="mt-3 text-sm text-white/65"></p></header>
<section class="grid gap-4 md:grid-cols-2">
<article class="rounded-[1.4rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Arrival + access</p><div data-access class="mt-3 grid gap-2 text-sm"></div></article>
<article class="rounded-[1.4rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Event timing</p><div data-timing class="mt-3 grid gap-2 text-sm"></div></article>
</section>
<section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Your setup + removal responsibilities</p><div data-setup class="mt-4 grid gap-3"></div></section>
<section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Required acknowledgment</p><form data-form class="mt-4 grid gap-3"><div data-rules class="grid gap-2"></div><label class="grid gap-2 text-sm font-semibold">Your name<input name="name" class="field" required></label><label class="grid gap-2 text-sm font-semibold">Optional note for Koa’s<textarea name="note" rows="3" class="field"></textarea></label><button class="w-fit rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Acknowledge Event Brief</button><p data-message class="text-sm text-[var(--koa-ink)]/55"></p></form></section>
</div></div></main>
<style>.field{min-height:2.8rem;width:100%;border:1px solid var(--koa-line);border-radius:.7rem;background:white;padding:.7rem .8rem;font-size:.82rem}</style>
<script>
const token=new URLSearchParams(location.search).get('token')||'',app=document.querySelector('[data-app]'),form=document.querySelector('[data-form]');let data=null;
function add(box,label,value){if(!value)return;const p=document.createElement('p');p.innerHTML='<strong>'+label+':</strong> '+String(value);box.appendChild(p)}
function render(){document.querySelector('[data-title]').textContent=(data.vendor.company||data.vendor.contact||'Vendor')+' Event Brief';document.querySelector('[data-meta]').textContent=[data.event.eventDate,data.vendor.role].filter(Boolean).join(' · ');
const access=document.querySelector('[data-access]');add(access,'Arrival',data.vendor.arrivalTime||'Not yet assigned');add(access,'Load-in zone',data.vendor.loadInZone);add(access,'Parking / access',data.vendor.parkingInstructions);add(access,'Power / water',data.vendor.powerWaterNeeds);add(access,'Departure',data.vendor.departureTime);add(access,'Emergency contact',data.vendor.emergencyContact);add(access,'Koa’s note',data.vendor.briefNote);
const timing=document.querySelector('[data-timing]');add(timing,'Guest arrival',data.event.guestArrival);add(timing,'Event start',data.event.eventStart);add(timing,'Event end',data.event.eventEnd);add(timing,'Teardown complete',data.event.teardownEnd);add(timing,'Venue / area',data.event.venueArea);
const setup=document.querySelector('[data-setup]');setup.innerHTML='';data.setupItems.forEach(item=>{const roles=[];if(item.responsibleVendorId===data.vendor.id)roles.push('Responsible');if(item.deliveryVendorId===data.vendor.id)roles.push('Deliver');if(item.setupVendorId===data.vendor.id)roles.push('Set up');if(item.removalVendorId===data.vendor.id)roles.push('Remove');const a=document.createElement('article');a.className='rounded-xl border border-[var(--koa-line)] p-4';a.innerHTML='<strong>'+item.label+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/50">'+[item.type,item.location,roles.join(' / ')].filter(Boolean).join(' · ')+'</p><p class="mt-2 text-sm">'+(item.notes||'')+'</p>';setup.appendChild(a)});if(!data.setupItems.length)setup.textContent='No setup items are currently assigned to your company.';
const rules=document.querySelector('[data-rules]');rules.innerHTML='';data.rules.forEach(r=>{const l=document.createElement('label');l.className='flex gap-3 rounded-xl border border-[var(--koa-line)] p-3 text-sm';l.innerHTML='<input type="checkbox" name="ack" value="'+r.id+'" class="mt-1"> <span>'+r.label+'</span>';rules.appendChild(l)});
if(data.vendor.acknowledgedAt){form.querySelector('[data-message]').textContent='Acknowledged by '+data.vendor.acknowledgedName+' on '+new Date(data.vendor.acknowledgedAt).toLocaleString()+'.';}}
form.onsubmit=async e=>{e.preventDefault();const msg=form.querySelector('[data-message]'),fd=new FormData(form),acks=fd.getAll('ack');msg.textContent='Saving acknowledgment…';const r=await fetch('/api/vendor-brief/'+encodeURIComponent(token),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:fd.get('name'),note:fd.get('note'),acknowledgements:acks})});const d=await r.json().catch(()=>({}));msg.textContent=r.ok?'Event Brief acknowledged. Thank you.':(d.error||'Unable to save acknowledgment.');if(r.ok)form.querySelector('button').disabled=true}
async function load(){if(!token){document.querySelector('[data-loading]').classList.add('hidden');document.querySelector('[data-error]').classList.remove('hidden');document.querySelector('[data-error-copy]').textContent='This link is missing its secure Event Brief token.';return}const r=await fetch('/api/vendor-brief/'+encodeURIComponent(token),{cache:'no-store'});const d=await r.json().catch(()=>({}));document.querySelector('[data-loading]').classList.add('hidden');if(!r.ok){document.querySelector('[data-error]').classList.remove('hidden');document.querySelector('[data-error-copy]').textContent=d.error||'Unable to load Event Brief.';return}data=d;app.classList.remove('hidden');render()}load();
</script>
</BaseLayout>