---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const requestedPackage=Astro.url.searchParams.get('package') || '';
const requestedGuests=Astro.url.searchParams.get('guests') || '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || import.meta.env.TURNSTILE_SITEKEY || import.meta.env.TURNSTILE_SITE_KEY || '';
---
<BaseLayout title="Big Island Wedding Venue Availability | Koa’s Events" description="Tell Koa’s Events about your Hawaiʻi Island wedding date, guest count, budget and vision." canonical="https://koasevents.com/wedding-inquiry/">
<Header overlay={false}/>
<main><section class="py-16 lg:py-24"><div class="container-shell grid gap-14 lg:grid-cols-[.75fr_1.25fr] lg:gap-20">
<aside><p class="eyebrow text-[var(--koa-clay)]">Wedding availability</p><h1 class="display mt-5 text-6xl leading-[.94] sm:text-7xl">Start with the wedding, not the equipment list.</h1><p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">We only need enough information to understand your date, guest count, budget and the kind of experience you are planning. Detailed rentals, décor and production choices can come later.</p><div class="mt-10 rounded-[1.5rem] bg-[var(--koa-forest)] p-7 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Signature Wedding</p><p class="display mt-4 text-4xl">Starting at $20,000</p><p class="mt-4 text-sm leading-6 text-white/64">Interested in a more supported wedding weekend? Select the Signature Experience in the form and we’ll qualify the fit from there.</p></div></aside>
<form name="koa-wedding-inquiry" method="POST" action="/wedding-inquiry-thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="min-w-0 overflow-hidden rounded-[1.8rem] border border-[var(--koa-line)] bg-white p-4 shadow-[var(--shadow-soft)] sm:p-9" data-wedding-inquiry-form>
<input type="hidden" name="form-name" value="koa-wedding-inquiry"/>
          <input type="hidden" name="subject" data-remove-prefix value="New Koa’s Wedding Inquiry" />
          <input type="hidden" name="selectedCatalogItems" value="" data-selected-catalog-items />
          <input type="hidden" name="automaticRentalBreakdown" value="" data-auto-rental-breakdown />
          <input type="hidden" name="manualAddOns" value="" data-manual-add-ons />
          <input type="hidden" name="estimatedGuestFurnitureTotal" value="" data-estimated-furniture-total />
          <input type="hidden" name="catalogSelectionState" value="" data-catalog-selection-state />
          <input type="hidden" name="savedQuoteId" value="" data-saved-quote-id />
          <p class="hidden"><label>Don’t fill this out: <input name="bot-field"/></label></p>
<div class="grid gap-6">
<div class="hidden rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] p-5" data-carried-plan>
  <p class="eyebrow text-[var(--koa-clay)]">Carried from your quote builder</p>
  <p class="mt-2 text-sm font-bold text-[var(--koa-forest)]" data-carried-plan-title></p>
  <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/62" data-carried-plan-copy></p>
  <a href="/catalog/#start-building" data-edit-plan class="link-arrow mt-4">Edit package or rentals →</a>
</div>
<div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-2 text-sm font-semibold">First name<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="firstName" required autocomplete="given-name"/></label><label class="grid gap-2 text-sm font-semibold">Last name<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="lastName" required autocomplete="family-name"/></label><label class="grid gap-2 text-sm font-semibold">Email<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="email" name="email" required autocomplete="email"/></label><label class="grid gap-2 text-sm font-semibold">Phone<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="tel" name="phone" required autocomplete="tel"/></label></div>
<div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-2 text-sm font-semibold">Wedding date<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="date" name="weddingDate" required/></label><label class="grid gap-2 text-sm font-semibold">Alternate date<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="date" name="alternateDate"/></label><label class="grid gap-2 text-sm font-semibold">Estimated guest count<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="number" min="1" max="100" name="guestCount" value={requestedGuests} required/></label><label class="grid gap-2 text-sm font-semibold">Wedding budget<select class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="budget" required><option value="">Choose one</option><option>Under $10,000</option><option>$10,000–$19,999</option><option>$20,000–$29,999</option><option>$30,000–$49,999</option><option>$50,000+</option></select></label></div>
<label class="grid gap-2 text-sm font-semibold">Where are you planning from?<select class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="planningFrom" required><option value="">Choose one</option><option>Hawaiʻi Island resident</option><option>Elsewhere in Hawaiʻi</option><option>Destination wedding — U.S. mainland</option><option>Destination wedding — international</option></select></label>
<label class="grid gap-2 text-sm font-semibold">Which starting point interests you?<select class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="packageInterest"><option value="">Not sure yet</option><option value="signature" selected={requestedPackage==='signature'}>Koa’s Signature Wedding Experience — from $20,000</option><option value="hibiscus" selected={requestedPackage==='hibiscus'}>Hibiscus — from $15,000</option><option value="orchid" selected={requestedPackage==='orchid'}>Orchid — from $10,000</option><option value="gardenia" selected={requestedPackage==='gardenia'}>Gardenia — from $5,000</option></select></label>
<label class="grid gap-2 text-sm font-semibold">Tell us what you envision for your wedding<textarea class="min-h-40 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="vision" placeholder="What do you want the weekend to feel like? What matters most to you?" required></textarea></label>
{turnstileSiteKey && (
  <div class="rounded-2xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 p-4">
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="wedding_inquiry" data-theme="light" data-size="flexible"></div>
  </div>
)}
<p class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" role="alert" data-submit-error></p>
<button class="rounded-full bg-[var(--koa-forest)] px-6 py-4 text-xs font-black uppercase tracking-[.13em] text-white disabled:cursor-not-allowed disabled:opacity-60" type="submit">Submit + continue to discovery call</button>
<p class="text-center text-sm leading-6 text-[var(--koa-ink)]/56">Submitting an inquiry does not reserve a date. Your date is secured only after the applicable agreement and deposit are completed.</p>
</div></form></div></section></main><Footer/>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline define:vars={{ requestedPackage, requestedGuests, turnstileSiteKey }}>
  const form = document.querySelector('[data-wedding-inquiry-form]');
  const packageField = form?.querySelector('[name="packageInterest"]');
  const guestField = form?.querySelector('[name="guestCount"]');
  const carriedPlan = document.querySelector('[data-carried-plan]');
  const carriedPlanTitle = document.querySelector('[data-carried-plan-title]');
  const carriedPlanCopy = document.querySelector('[data-carried-plan-copy]');
  const selectedItemsInput = form?.querySelector('[data-selected-catalog-items]');
  const autoBreakdownInput = form?.querySelector('[data-auto-rental-breakdown]');
  const manualAddOnsInput = form?.querySelector('[data-manual-add-ons]');
  const estimateInput = form?.querySelector('[data-estimated-furniture-total]');
  const stateInput = form?.querySelector('[data-catalog-selection-state]');
  const savedQuoteIdInput = form?.querySelector('[data-saved-quote-id]');
  const editPlanLink = document.querySelector('[data-edit-plan]');
  const quoteId = (new URLSearchParams(window.location.search).get('quote') || '').trim().toUpperCase();

  function normalizedInquiryPackage(id) {
    if (id === 'signature-wedding' || id === 'plumeria') return 'signature';
    return id || '';
  }

  let saved = null;
  try { saved = JSON.parse(localStorage.getItem('koaQuoteStateV1') || 'null'); } catch {}

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (form.dataset.crmCaptured === '1' || form.dataset.submitting === '1') return;

    const submitButton = form.querySelector('button[type="submit"]');
    const errorBox = form.querySelector('[data-submit-error]');
    const data = new FormData(form);
    const turnstileToken = String(data.get('cf-turnstile-response') || '');

    if (turnstileSiteKey && !turnstileToken) {
      if (errorBox) {
        errorBox.textContent = 'Complete the security check before sending your wedding inquiry.';
        errorBox.classList.remove('hidden');
      }
      return;
    }

    const packageValue = String(data.get('packageInterest') || '');
    const packageId = packageValue === 'signature' ? 'signature-wedding' : packageValue;
    try {
      sessionStorage.setItem('koaWeddingContact', JSON.stringify({
        name: [data.get('firstName'), data.get('lastName')].filter(Boolean).join(' '),
        email: String(data.get('email') || ''),
        phone: String(data.get('phone') || ''),
        weddingDate: String(data.get('weddingDate') || ''),
        guestCount: String(data.get('guestCount') || ''),
        packageInterest: String(data.get('packageInterest') || ''),
      }));
    } catch {}

    form.dataset.submitting = '1';
    if (submitButton) submitButton.disabled = true;
    if (errorBox) errorBox.classList.add('hidden');

    try {
      const response = await fetch('/api/crm/inquiries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Koa-Inquiry-Capture': '1' },
        body: JSON.stringify({
          formName: 'koa-wedding-inquiry',
          quoteId,
          packageId,
          honeypot: data.get('bot-field'),
          turnstileToken,
          customer: {
            name: [data.get('firstName'), data.get('lastName')].filter(Boolean).join(' '),
            email: data.get('email'),
            phone: data.get('phone'),
            eventDate: data.get('weddingDate'),
            notes: data.get('vision'),
          },
          inquiry: {
            service: 'venue',
            eventType: 'Wedding',
            guestCount: data.get('guestCount'),
            budget: data.get('budget'),
            venuePackage: packageId,
            alternativeDate: data.get('alternateDate'),
            planningFrom: data.get('planningFrom'),
            priorities: data.get('vision'),
            selectedCatalogItems: data.get('selectedCatalogItems'),
            automaticRentalBreakdown: data.get('automaticRentalBreakdown'),
            manualAddOns: data.get('manualAddOns'),
            catalogSelectionState: data.get('catalogSelectionState'),
          },
        }),
        keepalive: true,
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload?.ok !== true) {
        throw new Error(payload?.error || 'We could not verify this submission. Please try again.');
      }
      if (turnstileSiteKey && !payload?.turnstileProof) {
        throw new Error('Security verification could not be completed. Please try again.');
      }

      if (payload?.turnstileProof) {
        let proofInput = form.querySelector('[name="koa-turnstile-proof"]');
        if (!proofInput) {
          proofInput = document.createElement('input');
          proofInput.type = 'hidden';
          proofInput.name = 'koa-turnstile-proof';
          form.appendChild(proofInput);
        }
        proofInput.value = payload.turnstileProof;
      }

      form.dataset.crmCaptured = '1';
      form.querySelector('[name="cf-turnstile-response"]')?.remove();
      try {
        if (payload?.id) sessionStorage.setItem('koaWeddingRecordId', String(payload.id));
      } catch {}

      if (payload?.notificationConfigured || payload?.deduplicated) {
        window.location.assign('/wedding-inquiry-thank-you/');
        return;
      }

      form.querySelector('[name="catalogSelectionState"]')?.setAttribute('disabled', 'disabled');
      form.querySelector('[name="automaticRentalBreakdown"]')?.setAttribute('disabled', 'disabled');
      ['selectedCatalogItems', 'manualAddOns', 'estimatedGuestFurnitureTotal', 'savedQuoteId'].forEach((name) => {
        const field = form.querySelector('[name="' + name + '"]');
        if (field) form.appendChild(field);
      });
      if (packageField?.selectedOptions?.[0]) {
        packageField.selectedOptions[0].value = packageField.selectedOptions[0].textContent?.trim() || packageField.value;
      }
      form.submit();
    } catch (error) {
      form.dataset.submitting = '0';
      if (submitButton) submitButton.disabled = false;
      if (errorBox) {
        errorBox.textContent = error instanceof Error ? error.message : 'We could not send your wedding inquiry. Please try again.';
        errorBox.classList.remove('hidden');
      }
      if (window.turnstile?.reset) window.turnstile.reset();
    }
  });

  function money(value) {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(Number(value || 0));
  }

  function applySavedPlan(state) {
    if (!state) return;
    saved = state;
    const packageValue = normalizedInquiryPackage(requestedPackage) || normalizedInquiryPackage(state.startingPoint);
    if (packageField && packageValue) packageField.value = packageValue;
    if (guestField && !requestedGuests && state.guestCount) guestField.value = String(state.guestCount);

    const auto = (state.selected || []).filter((entry) => entry.auto);
    const manual = (state.selected || []).filter((entry) => !entry.auto);
    const all = [...auto, ...manual];
    const allText = all.map((entry) => entry.quantity + ' × ' + entry.name).join('\n');
    const autoText = auto.map((entry) => entry.quantity + ' × ' + entry.name + (entry.reason ? ' — ' + entry.reason : '') + (entry.estimatedLineTotal ? ' Estimated: USD ' + Number(entry.estimatedLineTotal).toFixed(0) + '.' : '')).join(' | ');
    const manualText = manual.map((entry) => entry.quantity + ' × ' + entry.name).join('\n');

    if (selectedItemsInput) selectedItemsInput.value = allText;
    if (autoBreakdownInput) autoBreakdownInput.value = autoText;
    if (manualAddOnsInput) manualAddOnsInput.value = manualText;
    if (estimateInput) estimateInput.value = state.estimatedFurnitureTotal ? money(state.estimatedFurnitureTotal) : '';
    if (stateInput) stateInput.value = JSON.stringify(state);
    if (savedQuoteIdInput) savedQuoteIdInput.value = quoteId;
    if (editPlanLink && quoteId) editPlanLink.href = '/catalog/?quote=' + encodeURIComponent(quoteId);

    carriedPlan?.classList.remove('hidden');
    if (carriedPlanTitle) carriedPlanTitle.textContent = (packageField?.selectedOptions?.[0]?.textContent || 'Saved wedding plan') + ' · ' + (guestField?.value || state.guestCount) + ' guests';
    if (carriedPlanCopy) {
      const knownTotal = Number(state.estimatedStartingTotal || 0);
      const customCount = Number(state.customQuoteCount || 0);
      const addOnCount = manual.length;
      carriedPlanCopy.textContent =
        (quoteId ? 'Saved quote ' + quoteId + '. ' : '') +
        (knownTotal ? 'Known-price estimate ' + money(knownTotal) + '. ' : '') +
        addOnCount + (addOnCount === 1 ? ' selected add-on. ' : ' selected add-ons. ') +
        (customCount ? customCount + (customCount === 1 ? ' item still needs custom pricing.' : ' items still need custom pricing.') : 'No selected items are waiting on custom pricing.');
    }
  }

  async function restoreSavedPlan() {
    if (quoteId) {
      try {
        const response = await fetch('/api/quotes/' + encodeURIComponent(quoteId), { cache: 'no-store', headers: { Accept: 'application/json' } });
        if (response.ok) {
          const payload = await response.json();
          if (payload?.state) {
            try { localStorage.setItem('koaQuoteStateV1', JSON.stringify(payload.state)); } catch {}
            applySavedPlan(payload.state);
            return;
          }
        }
      } catch {}
    }
    if (saved) applySavedPlan(saved);
  }

  restoreSavedPlan();
</script>
</BaseLayout>