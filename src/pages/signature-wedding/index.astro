---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import PackageCapacityComparison from '../../components/PackageCapacityComparison.astro';
import { businessRules } from '../../data/businessRules';
import { media, koaMarketingMedia } from '../../data/media';

const signaturePackage = businessRules.venueWeddingPackages.find((p) => p.name === 'Plumeria')!;
const experience = [
  { label:'Your private estate', title:'A weekend with room to settle in.', text:'Weekend cottage access, the private Mountain View property and getting-ready space create more breathing room around the wedding instead of compressing everything into a few hours.', image:koaMarketingMedia.pavilionSunsetWide, details:['Weekend cottage access: Friday 3:00 PM–Sunday 11:00 AM','Private Mountain View property','Bridal and Groom Suite Cottage'] },
  { label:'Your ceremony', title:'A ceremony setting shaped around the moment.', text:'Ceremony seating, florals, the arch and audio support give the ceremony a finished foundation while still leaving room for your personal choices.', image:koaMarketingMedia.ceremonyLiveGuestView, details:['50 ceremony chairs','Deluxe floral arrangements','Arch and whiskey barrels','Audio equipment and Sonos surround sound'] },
  { label:'Your reception', title:'The room becomes the celebration.', text:'Reception furniture, table settings, glassware and lighting create the visual framework so the evening feels intentional from dinner through dancing.', image:koaMarketingMedia.receptionRustBlue, details:['50 reception chairs','10 round tables','2 six-foot rectangle tables','10 cocktail tables','Deluxe table settings','Glassware and ice-machine access','Deluxe lighting package'] },
  { label:'Your bar experience', title:'Hospitality that is part of the design.', text:'Koa’s Mobile Bar is integrated under the dry-bar model. You purchase the alcohol; Koa’s provides the professional service, planning and package supplies.', image:koaMarketingMedia.mobileBarHero, details:['Koa’s Mobile Bar service','Bartender labor under standard package assumptions','Optional gratuity','No default tip jar'] },
  { label:'Your celebration', title:'The memorable extras already have a place.', text:'The package layers in guest-facing details that keep the celebration lively without asking you to source every individual piece.', image:koaMarketingMedia.firstDancePavilion, details:['Photo booth','Wedding cake','Lawn games','Guest phone and card box','Raw drone footage'] },
  { label:'Your planning team', title:'We handle the moving pieces so you can experience your wedding.', text:'Coordination, parking support and vendor communication are built around reducing the number of operational details that reach you on the wedding day.', image:koaMarketingMedia.pavilionNightLightingCollage, details:['Day-of coordination','Vendor coordinator','Parking attendant','Planning support'] },
];
const schema={'@context':'https://schema.org','@type':'Service',name:"The Koa's Signature Wedding Experience",description:'A premium private wedding weekend experience at Koa’s Events in Mountain View, Hawaiʻi.',provider:{'@type':'LocalBusiness',name:"Koa's Events"},areaServed:'Hawaiʻi Island',offers:{'@type':'Offer',price:'20000',priceCurrency:'USD',description:'Starting price'}};
---
<BaseLayout title="Luxury Big Island Wedding Venue & Weekend Experience | Koa's Events" description="Discover the Koa’s Signature Wedding Experience: a private rainforest wedding venue on Hawaiʻi Island with a premium weekend experience starting at $20,000." canonical="https://www.koasevents.com/signature-wedding/">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="relative min-h-[86svh] overflow-hidden bg-[var(--koa-ink)] text-white md:min-h-[94svh]"><ResponsiveImage {...koaMarketingMedia.pavilionStairsRomantic} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[86svh] items-end pb-14 pt-32 md:min-h-[94svh] md:pt-40 lg:pb-24"><div class="max-w-5xl"><p class="eyebrow text-white/65">The Koa’s Signature Wedding Experience</p><h1 class="display mt-6 max-w-5xl text-6xl leading-[.9] sm:text-7xl lg:text-[7rem]">A private rainforest wedding on Hawaiʻi Island.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">A premium wedding weekend designed for couples who want a beautiful celebration without personally managing every moving piece.</p><div class="mt-9 flex flex-wrap items-center gap-4"><a href="/wedding-inquiry/?package=signature" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Check wedding availability</a><span class="text-xs font-black uppercase tracking-[.14em] text-white/60">Starting at $20,000</span></div></div></div></section>
<section class="border-b border-[var(--koa-line)] bg-[var(--koa-sand)] py-5"><div class="container-shell flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-[.68rem] font-black uppercase tracking-[.15em] text-[var(--koa-ink)]/62"><span>Private Mountain View property</span><span>Weekend experience</span><span>Up to {businessRules.venue.maximumOccupancy.value} guests</span><span>Koa’s Mobile Bar</span><span>Planning + coordination</span></div></section>
<section class="py-24 lg:py-36"><div class="container-shell grid gap-14 lg:grid-cols-[.75fr_1.25fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">The flagship experience</p><h2 class="display mt-5 text-5xl leading-[.98] sm:text-6xl">More than a venue rental. Less for you to assemble.</h2></div><div><p class="text-lg leading-8 text-[var(--koa-ink)]/70">The Signature Wedding Experience is the Plumeria collection elevated into the way we believe a Koa’s wedding should feel: a private setting, an intentional ceremony and reception, and a polished bar experience. The property remains a flexible canvas; your final design can look completely different depending on your palette, florist, planner, rental selections and personal style.</p><p class="mt-5 text-base leading-7 text-[var(--koa-ink)]/64">Guest-facing details and a team carrying the operational pieces behind the scenes let you spend more of the weekend actually experiencing it.</p><PackageCapacityComparison furnitureCoverage={signaturePackage.includedFurnitureCoverage} /><p class="mt-5 text-sm leading-7 text-[var(--koa-ink)]/56">{signaturePackage.baseConfiguration} Included furniture and inventory: {signaturePackage.includedInventory}.</p></div></div></section>
{experience.map((section,index)=>(<section class:list={['py-16 sm:py-20 lg:py-32', index%2===0 ? 'bg-[var(--koa-sand)]' : 'bg-[var(--koa-ivory)]']}><div class:list={['container-shell grid items-center gap-14 lg:grid-cols-2 lg:gap-24', index%2===1 && 'lg:[&>*:first-child]:order-2']}><div class="relative h-[22rem] overflow-hidden rounded-[1.5rem] sm:h-[28rem] lg:h-[36rem] lg:rounded-[2rem]"><ResponsiveImage {...section.image} width={1200} height={1200} sizes="(min-width:1024px) 50vw,100vw" class="absolute inset-0 h-full w-full object-cover"/></div><div><p class="eyebrow text-[var(--koa-clay)]">0{index+1} · {section.label}</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">{section.title}</h2><p class="mt-6 text-base leading-7 text-[var(--koa-ink)]/68">{section.text}</p><ul class="mt-7 grid gap-3 border-t border-[var(--koa-line)] pt-6">{section.details.map(item=><li class="flex gap-3 text-sm leading-6 text-[var(--koa-ink)]/66"><span class="text-[var(--koa-clay)]">—</span><span>{item}</span></li>)}</ul></div></div></section>))}
<section class="bg-[var(--koa-forest)] py-24 text-white lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-amber-light)]">What the price means</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Starting at $20,000.</h2></div><div><p class="text-base leading-7 text-white/68">The starting price reflects the current published Signature/Plumeria package scope. Your final proposal confirms guest count, added rentals, vendor-provided items, custom design choices, travel or staffing outside standard assumptions, and any upgrades. Photography throughout this page shows examples of how Koa’s can be transformed; pictured styling is not automatically included unless it appears in the package scope.</p><a href="/wedding-inquiry/?package=signature" class="mt-8 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Start your wedding inquiry</a></div></div></section>
<section class="py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.78fr_1.22fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">Other ways to celebrate at Koa’s</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A shorter or more venue-led celebration may be the better fit.</h2><p class="mt-6 text-sm leading-7 text-[var(--koa-ink)]/60">Gardenia, Orchid and Hibiscus remain available for couples who need a different level of access and support.</p><a href="/venue/packages/" class="link-arrow mt-8">See all wedding collections →</a></div><div class="grid gap-3">{businessRules.venueWeddingPackages.filter((p)=>p.name!=='Plumeria').map((p,i)=><a href={'/wedding-inquiry/?package='+p.name.toLowerCase()} class="grid gap-4 rounded-[1.2rem] border border-[var(--koa-line)] bg-white p-5 sm:grid-cols-[1fr_auto] sm:items-center"><div><p class="eyebrow text-[var(--koa-clay)]">0{i+1} · {p.position}</p><h3 class="display mt-2 text-3xl">{p.publicName}</h3><PackageCapacityComparison furnitureCoverage={p.includedFurnitureCoverage} compact /></div><p class="text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">From {'$'+p.price.toLocaleString()}</p></a>)}</div></div></section>
</main><Footer/></BaseLayout>