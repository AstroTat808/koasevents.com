---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<BaseLayout noindex title="Your Koa’s Wedding Journey Starts Here" description="Next steps after submitting a wedding inquiry to Koa’s Events." canonical="https://www.koasevents.com/wedding-inquiry-thank-you/">
<Header overlay={false}/>
<main>
<section class="py-20 lg:py-28"><div class="container-shell max-w-5xl text-center"><p class="eyebrow text-[var(--koa-clay)]">Wedding inquiry received</p><h1 class="display mx-auto mt-5 max-w-4xl text-6xl leading-[.94] sm:text-7xl">Your Koa’s wedding journey starts here.</h1><p class="mx-auto mt-7 max-w-2xl text-base leading-7 text-[var(--koa-ink)]/68">Your wedding details are in. The next step is a short discovery conversation so we can confirm fit, availability and the right starting point.</p></div></section>
<section class="bg-[var(--koa-sand)] py-20"><div class="container-shell grid gap-4 lg:grid-cols-3">
<article class="rounded-[1.5rem] bg-[var(--koa-forest)] p-7 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Step 1</p><h2 class="display mt-8 text-4xl">Request your discovery call.</h2><p class="mt-4 text-sm leading-6 text-white/64">Tell us the best days and times to reach you. We’ll use those preferences to arrange the conversation.</p><a href="#schedule" class="link-arrow mt-7 text-white">Choose preferences →</a></article>
<article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7"><p class="eyebrow text-[var(--koa-clay)]">Step 2</p><h2 class="display mt-8 text-4xl">Explore the Signature Experience.</h2><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/64">See how the private property, ceremony, reception, bar and planning support fit together.</p><a href="/signature-wedding/" class="link-arrow mt-7">Explore Signature →</a></article>
<article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7"><p class="eyebrow text-[var(--koa-clay)]">Step 3</p><h2 class="display mt-8 text-4xl">Get a feel for the property.</h2><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/64">Use the gallery now; a dedicated property film can be added here once the finished video is ready.</p><a href="/gallery/" class="link-arrow mt-7">View gallery →</a></article>
</div></section>
<section id="schedule" class="py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.75fr_1.25fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">Discovery call</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Give us a few windows that work for you.</h2><p class="mt-6 text-sm leading-7 text-[var(--koa-ink)]/62">Your contact details carry forward from the inquiry, so this step is focused on scheduling. You can still edit them below if anything changed.</p></div>
<form name="koa-discovery-call-request" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7 shadow-[var(--shadow-soft)]" data-discovery-form><input type="hidden" name="form-name" value="koa-discovery-call-request"/>
          <input type="hidden" name="subject" data-remove-prefix value="New Koa’s Discovery Call Request" /><p class="hidden"><label>Don’t fill this out: <input name="bot-field"/></label></p>
          <div class="mb-5 hidden rounded-xl border border-[var(--koa-forest)]/15 bg-[var(--koa-sand)] p-4" data-carried-contact><p class="eyebrow text-[var(--koa-clay)]">Carried forward</p><p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/62">We filled in the contact details from your wedding inquiry.</p></div>
          <div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-2 text-sm font-semibold">Name<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="name" required autocomplete="name"/></label><label class="grid gap-2 text-sm font-semibold">Email<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="email" type="email" required autocomplete="email"/></label><label class="grid gap-2 text-sm font-semibold">Best day<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="date" name="preferredDate" required/></label><label class="grid gap-2 text-sm font-semibold">Best time window<select class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="preferredTime" required><option value="">Choose one</option><option>Morning</option><option>Midday</option><option>Afternoon</option><option>Evening</option></select></label><label class="grid gap-2 text-sm font-semibold sm:col-span-2">Alternate day/time<textarea class="min-h-24 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="alternateWindow" placeholder="Give us another window that works for you."></textarea></label>
          {turnstileSiteKey && (
            <div class="sm:col-span-2 rounded-2xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 p-4">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="discovery_call" data-theme="light" data-size="flexible"></div>
            </div>
          )}
          <p class="hidden sm:col-span-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" role="alert" data-submit-error></p>
          <button class="sm:col-span-2 rounded-full bg-[var(--koa-forest)] px-6 py-4 text-xs font-black uppercase tracking-[.13em] text-white disabled:cursor-not-allowed disabled:opacity-60" type="submit">Request discovery call</button></div></form></div></section>
</main><Footer/>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline define:vars={{ turnstileSiteKey }}>
  const discoveryForm = document.querySelector('[data-discovery-form]');
  const carriedContact = document.querySelector('[data-carried-contact]');
  let carried = null;

  try {
    carried = JSON.parse(sessionStorage.getItem('koaWeddingContact') || 'null');
    if (carried && discoveryForm) {
      if (carried.name) discoveryForm.elements.name.value = carried.name;
      if (carried.email) discoveryForm.elements.email.value = carried.email;
      carriedContact?.classList.remove('hidden');
    }
  } catch {}

  discoveryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (discoveryForm.dataset.submitting === '1') return;

    const submitButton = discoveryForm.querySelector('button[type="submit"]');
    const errorBox = discoveryForm.querySelector('[data-submit-error]');
    const data = new FormData(discoveryForm);
    const turnstileToken = String(data.get('cf-turnstile-response') || '');

    if (turnstileSiteKey && !turnstileToken) {
      if (errorBox) {
        errorBox.textContent = 'Complete the security check before requesting your discovery call.';
        errorBox.classList.remove('hidden');
      }
      return;
    }

    discoveryForm.dataset.submitting = '1';
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
    }
    if (errorBox) errorBox.classList.add('hidden');

    let sourceRecordId = '';
    try { sourceRecordId = sessionStorage.getItem('koaWeddingRecordId') || ''; } catch {}

    try {
      const response = await fetch('/api/crm/inquiries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Koa-Inquiry-Capture': '1' },
        body: JSON.stringify({
          formName: 'koa-discovery-call-request',
          honeypot: data.get('bot-field'),
          turnstileToken,
          customer: {
            name: data.get('name'),
            email: data.get('email'),
            phone: carried?.phone || '',
            eventDate: data.get('preferredDate'),
            notes: data.get('alternateWindow'),
          },
          inquiry: {
            service: 'discovery-call',
            eventType: 'Discovery Call',
            preferredDate: data.get('preferredDate'),
            preferredTime: data.get('preferredTime'),
            alternateWindow: data.get('alternateWindow'),
            sourceRecordId,
          },
        }),
        keepalive: true,
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload?.ok !== true) {
        throw new Error(payload?.error || 'We could not save your discovery-call request. Please try again.');
      }

      discoveryForm.querySelector('[name="cf-turnstile-response"]')?.remove();

      if (payload?.notificationConfigured) {
        window.location.assign('/thank-you/');
        return;
      }

      discoveryForm.submit();
    } catch (error) {
      discoveryForm.dataset.submitting = '0';
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Request discovery call';
      }
      if (errorBox) {
        errorBox.textContent = error instanceof Error ? error.message : 'We could not save your discovery-call request. Please try again.';
        errorBox.classList.remove('hidden');
      }
      if (window.turnstile?.reset) window.turnstile.reset();
    }
  });
</script>
</BaseLayout>