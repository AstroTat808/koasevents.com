---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { businessRules } from '../../data/businessRules';
import { media, koaMarketingMedia } from '../../data/media';
const packages=businessRules.venueWeddingPackages;
---
<BaseLayout title="Big Island Wedding Venue in Mountain View | Koa’s Events" description="Plan a Hawaiʻi Island wedding for up to 100 guests at Koa’s Events, book Koa’s Mobile Bar at another venue, or combine both." canonical="https://www.koasevents.com/weddings/">
<main>
<section class="relative min-h-[84svh] overflow-hidden bg-[var(--koa-ink)] text-white md:min-h-[90svh]"><ResponsiveImage {...koaMarketingMedia.ceremonyLiveCenteredWide} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[84svh] items-end pb-14 pt-32 md:min-h-[90svh] md:pt-40 lg:pb-24"><div class="max-w-4xl"><p class="eyebrow text-white/65">A private rainforest wedding venue on Hawaiʻi Island</p><h1 class="display mt-5 text-6xl leading-[.9] sm:text-7xl lg:text-[6.8rem]">A wedding that feels like the two of you.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/78 sm:text-lg">Choose the Koa’s venue, bring our Mobile Bar to another location, or combine both into one more connected wedding experience.</p><div class="mt-9 flex flex-wrap gap-3"><a href="/signature-wedding/" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Explore Signature Wedding</a><a href="/wedding-inquiry/" class="link-arrow px-2 py-3.5 text-white">Check your date →</a></div></div></div></section>

<section class="py-24 lg:py-36"><div class="container-shell grid gap-14 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">A slower kind of luxury</p><h2 class="display mt-5 text-5xl leading-[.98] sm:text-6xl">Privacy, warm hospitality, and room to actually experience the day.</h2><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">The strongest weddings at Koa’s are not built around one prescribed look. The pavilion and grounds are a blank canvas that can take on very different themes, palettes and design directions. Some couples use pieces from Koa’s rental catalog, others bring nearly everything through their planner, florist and rental team, and many mix both approaches. What matters is how the day unfolds—where people gather, how the weather is handled, where the bar lives, when the music starts, and how much of the planning you want us to help carry.</p><a href="/venue/packages/" class="link-arrow mt-8">Compare wedding collections →</a></div><div class="relative h-[29rem] sm:h-[34rem] lg:h-[40rem]"><div class="absolute left-0 top-0 h-[24rem] w-[70%] overflow-hidden rounded-[1.6rem] sm:h-[28rem] lg:h-[33rem] lg:w-[68%] lg:rounded-[2rem]"><ResponsiveImage {...koaMarketingMedia.ceremonyGardenAisleSunlit} width={1000} height={1300} sizes="(min-width:1024px) 35vw, 70vw" class="h-full w-full object-cover"/></div><div class="absolute bottom-0 right-0 h-[17rem] w-[54%] overflow-hidden rounded-[1.25rem] border-[7px] border-[var(--koa-ivory)] sm:h-[21rem] lg:h-[25rem] lg:w-[52%] lg:border-[10px]"><ResponsiveImage {...koaMarketingMedia.ceremonyVowsCloseup} width={750} height={950} sizes="(min-width:1024px) 26vw, 55vw" class="h-full w-full object-cover"/></div></div></div></section>

<section class="bg-[var(--koa-forest)] py-24 text-white lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.75fr_1.25fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-amber-light)]">The flagship wedding</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The Koa’s Signature Wedding Experience.</h2><p class="mt-4 text-xs font-black uppercase tracking-[.14em] text-white/52">Starting at $20,000</p><p class="mt-7 text-base leading-7 text-white/66">Our most complete wedding experience brings the private property, ceremony foundation, reception design, Mobile Bar and coordination support into one connected weekend plan.</p><a href="/signature-wedding/" class="mt-8 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Explore the Signature Experience</a></div><div class="relative h-[23rem] overflow-hidden rounded-[1.6rem] sm:h-[28rem] lg:h-[34rem] lg:rounded-[2rem]"><ResponsiveImage {...koaMarketingMedia.firstDancePavilion} width={1200} height={1100} sizes="(min-width:1024px) 52vw,100vw" class="absolute inset-0 h-full w-full object-cover"/></div></div></section>
<section class="bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell"><p class="eyebrow text-[var(--koa-clay)]">Three wedding paths</p><h2 class="display mt-5 max-w-4xl text-5xl leading-[1] sm:text-6xl">Start with where you need Koa’s most.</h2><div class="mt-12 grid gap-4 lg:grid-cols-3">
{[
['Venue','Get married at Koa’s','Use the Mountain View estate as the setting and build from the wedding collection that best fits your access and service needs.','/inquire/?service=venue',koaMarketingMedia.pavilionWelcomeFront],
['Mobile Bar','Bring Koa’s to your venue','Already found the location? Bring our dry-bar service and hospitality to your reception anywhere on Hawaiʻi Island.','/inquire/?service=mobile-bar',koaMarketingMedia.mobileBarCouplePortrait],
['Venue + Bar','Keep the plan connected','Use the property and beverage service together so timing, layout and hospitality work from the same event plan.','/inquire/?service=both',koaMarketingMedia.pavilionSunsetEvent]
].map(([label,title,copy,href,image])=><a href={href} class="group overflow-hidden rounded-[1.5rem] bg-[var(--koa-ivory)]"><div class="relative h-56 overflow-hidden sm:h-64 lg:h-72"><ResponsiveImage {...image} width={900} height={650} sizes="(min-width:1024px) 33vw, 100vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]"/></div><div class="p-7"><p class="eyebrow text-[var(--koa-clay)]">{label}</p><h3 class="display mt-3 text-4xl">{title}</h3><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/64">{copy}</p><span class="link-arrow mt-6">Start here →</span></div></a>)}
</div></div></section>

<section class="bg-[var(--koa-forest)] py-24 text-white lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-amber-light)]">Other ways to celebrate at Koa’s</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Shorter and more venue-led wedding collections remain available.</h2><a href="/venue/packages/" class="link-arrow mt-8 text-white">Full package details →</a></div><div class="grid border-t border-white/15">{packages.filter((p)=>p.name!=='Plumeria').map((p,i)=><div class="grid gap-4 border-b border-white/15 py-6 sm:grid-cols-[3rem_1fr_auto] sm:items-start"><span class="eyebrow text-[var(--koa-amber-light)]">0{i+1}</span><div><p class="text-[.62rem] font-bold uppercase tracking-[.14em] text-white/42">{p.position}</p><h3 class="display mt-1 text-3xl">{p.name}</h3><p class="mt-2 text-sm leading-6 text-white/60">{p.baseConfiguration}</p></div><p class="text-xs font-black uppercase tracking-[.12em] text-white/62">From {'$'+p.price.toLocaleString()}</p></div>)}</div></div></section>

<section class="py-24 lg:py-32"><div class="container-shell"><div class="grid gap-8 lg:grid-cols-[.78fr_1.22fr]"><div><p class="eyebrow text-[var(--koa-clay)]">The day in motion</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Think about the experience, not just the inventory.</h2></div><div class="grid gap-4 sm:grid-cols-2">{[
['01','Arrive','Getting-ready time, vendor access and an unhurried start.'],
['02','Gather','Guest arrival, ceremony flow and a setting that feels private.'],
['03','Celebrate','Food, bar service, music and reception design working together.'],
['04','Stay present','A clear end-of-night plan so you are not managing the logistics yourself.']
].map(([n,t,c])=><div class="rounded-[1.3rem] border border-[var(--koa-line)] bg-white p-6"><p class="eyebrow text-[var(--koa-clay)]">{n}</p><h3 class="display mt-4 text-3xl">{t}</h3><p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/62">{c}</p></div>)}</div></div></div></section>

<section class="koa-grain bg-[var(--koa-sand)] py-24"><div class="container-shell flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"><div class="max-w-3xl"><p class="eyebrow text-[var(--koa-clay)]">See the mood</p><h2 class="display mt-4 text-5xl leading-[1] sm:text-6xl">See how one property can become many completely different weddings.</h2></div><a href="/gallery/" class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Explore the gallery</a></div></section>
</main><Footer/></BaseLayout>