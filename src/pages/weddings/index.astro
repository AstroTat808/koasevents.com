---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { businessRules } from '../../data/businessRules';

const hero='https://static.wixstatic.com/media/02b2df_dbe1e4c043e0401590406df45a251117~mv2.jpg/v1/fill/w_1600,h_1067,al_c,q_88/02b2df_dbe1e4c043e0401590406df45a251117~mv2.jpg';
const packages=businessRules.venueWeddingPackages;
const paths=[
 {title:'Get married at Koa’s',text:'A private Mountain View setting for celebrations up to 100 guests, with an open-air pavilion and flexible wedding collections.',href:'/inquire/?service=venue'},
 {title:'Bring Koa’s Mobile Bar',text:'Already have your venue? Bring Koa’s hospitality to your reception anywhere on Hawaiʻi Island.',href:'/inquire/?service=mobile-bar'},
 {title:'Choose both',text:'Use the venue and bar together so more of the guest experience works as one coordinated plan.',href:'/inquire/?service=both'}
];
---
<BaseLayout title="Big Island Weddings | Koa’s Events" description="Plan a Hawaiʻi Island wedding for up to 100 guests at Koa’s Events, book Koa’s Mobile Bar at another venue, or combine both." canonical="https://www.koasevents.com/weddings/">
<main>
<section class="relative min-h-[84svh] overflow-hidden bg-[var(--koa-ink)] text-white"><img src={hero} alt="Wedding setting at Koa's Events on Hawaiʻi Island" class="absolute inset-0 h-full w-full object-cover opacity-70" fetchpriority="high"/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[84svh] items-end pb-16 pt-40 lg:pb-20"><div class="max-w-4xl"><p class="eyebrow text-white/60">Weddings · Hawaiʻi Island</p><h1 class="display mt-5 text-6xl leading-[.92] sm:text-7xl lg:text-[6.5rem]">A wedding that feels like the two of you.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">Host up to {businessRules.venue.maximumOccupancy.value} guests at Koa’s, bring our Mobile Bar to another location, or combine both into one more connected guest experience.</p><a href="/inquire/" class="mt-9 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Check your date</a></div></div></section>

<section class="py-24 lg:py-32"><div class="container-shell"><p class="eyebrow text-[var(--koa-clay)]">Start with the right path</p><h2 class="display mt-5 max-w-3xl text-5xl leading-[1] sm:text-6xl">One wedding. Three ways to work with Koa’s.</h2><div class="mt-12 grid gap-5 lg:grid-cols-3">{paths.map((p,i)=><a href={p.href} class="card-lift flex min-h-[23rem] flex-col rounded-[1.6rem] border border-[var(--koa-line)] bg-white p-7"><span class="eyebrow text-[var(--koa-clay)]">0{i+1}</span><h3 class="display mt-16 text-4xl">{p.title}</h3><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/66">{p.text}</p><span class="link-arrow mt-auto pt-7">Start here →</span></a>)}</div></div></section>

<section class="bg-[var(--koa-forest)] py-24 text-white lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><div><p class="eyebrow text-white/48">Wedding collections</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A clear starting point without making your wedding feel packaged.</h2><a href="/venue/packages/" class="link-arrow mt-8 text-white">Compare full package details →</a></div><div class="grid border-t border-white/16">{packages.map((p,i)=><div class="grid gap-4 border-b border-white/16 py-6 sm:grid-cols-[3rem_1fr_auto] sm:items-start"><span class="eyebrow text-[var(--koa-amber-light)]">0{i+1}</span><div><p class="text-[.65rem] font-bold uppercase tracking-[.13em] text-white/45">{p.position}</p><h3 class="display mt-1 text-3xl">{p.name}</h3><p class="mt-2 text-sm leading-6 text-white/62">{p.baseConfiguration}</p></div><p class="text-xs font-black uppercase tracking-[.12em] text-white/62">From {'$'+p.price.toLocaleString()}</p></div>)}</div></div></section>

<section class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">What we solve early</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The questions that shape the entire day.</h2></div><div class="grid gap-4 sm:grid-cols-2">{['Date + access window','Guest experience + layout','Rain and weather planning','Food + beverage flow','Vendor timing + insurance','Music + end-of-night timing'].map(x=><div class="rounded-2xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5 text-sm font-semibold">{x}</div>)}</div></div></section>
<section class="bg-[var(--koa-ink)] py-20 text-white"><div class="container-shell flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"><div class="max-w-3xl"><p class="eyebrow text-white/45">Your date comes first</p><h2 class="display mt-4 text-5xl leading-[1] sm:text-6xl">Tell us where you are in the planning process.</h2></div><a href="/inquire/" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Start wedding inquiry</a></div></section>
</main><Footer/></BaseLayout>
