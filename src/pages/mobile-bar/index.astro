---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { businessRules } from '../../data/businessRules';
import { media } from '../../data/media';
const packages=businessRules.mobileBar.packages;
const schema={'@context':'https://schema.org','@type':'LocalBusiness',name:"Koa's Mobile Bar",url:'https://www.koasevents.com/mobile-bar/',telephone:businessRules.contact.phone,email:businessRules.contact.email,areaServed:{'@type':'AdministrativeArea',name:'Hawaiʻi Island'}};
---
<BaseLayout title="Koa’s Mobile Bar | Big Island Wedding & Event Bartending" description="Bring Koa’s Mobile Bar to your Hawaiʻi Island wedding, private event or corporate gathering. Dry-bar packages include bartender labor under standard assumptions." canonical="https://www.koasevents.com/mobile-bar/">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="relative min-h-[88svh] overflow-hidden bg-[var(--koa-ink)] text-white"><ResponsiveImage {...media.mobileBar} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[88svh] items-end pb-16 pt-40 lg:pb-24"><div class="max-w-4xl"><p class="eyebrow text-white/65">Koa’s Mobile Bar · Hawaiʻi Island</p><h1 class="display mt-5 text-6xl leading-[.9] sm:text-7xl lg:text-[6.8rem]">A bar as considered as the rest of your event.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/78 sm:text-lg">Professional dry-bar service, planning and hospitality for weddings, private events and corporate gatherings across the Big Island.</p><a href="/inquire/?service=mobile-bar" class="mt-9 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Get a bar quote</a></div></div></section>

<section class="bg-[var(--koa-ink)] py-16 text-white"><div class="container-shell grid gap-px overflow-hidden rounded-[1.3rem] border border-white/10 bg-white/10 sm:grid-cols-4">
{[['Labor','Included'],['Gratuity','Optional'],['Tip jar','Not by default'],['Service area','Hawaiʻi Island']].map(([k,v])=><div class="bg-[var(--koa-ink)] p-6"><p class="eyebrow text-[var(--koa-amber-light)]">{k}</p><p class="display mt-2 text-3xl">{v}</p></div>)}
</div></section>

<section class="py-24 lg:py-36"><div class="container-shell grid gap-14 lg:grid-cols-[.82fr_1.18fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">The dry-bar model</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">You buy the alcohol. We make the service feel effortless.</h2><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">{businessRules.mobileBar.model.value}</p><p class="mt-5 text-sm leading-6 text-[var(--koa-ink)]/56">Staffing scales with guest count, menu complexity, event duration and service demand so the quote reflects the actual event—not a vague percentage fee.</p></div><div class="relative min-h-[40rem]"><div class="absolute right-0 top-0 h-[33rem] w-[78%] overflow-hidden rounded-[2rem]"><ResponsiveImage {...media.bartenderDetail} width={1100} height={1350} sizes="(min-width:1024px) 48vw, 85vw" class="h-full w-full object-cover"/></div><div class="absolute bottom-0 left-0 rounded-[1.3rem] bg-[var(--koa-clay)] p-7 text-white shadow-xl"><p class="eyebrow text-white/58">Service philosophy</p><p class="display mt-3 max-w-xs text-3xl">Good drinks. Better flow. Less for the host to manage.</p></div></div></div></section>

<section id="packages" class="bg-[var(--koa-forest)] py-24 text-white lg:py-32"><div class="container-shell"><div class="grid gap-8 lg:grid-cols-[.76fr_1.24fr] lg:items-end"><div><p class="eyebrow text-[var(--koa-amber-light)]">Package starting points</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Choose the beverage experience first. We’ll scale the operation around it.</h2></div><p class="max-w-xl text-sm leading-7 text-white/60 lg:justify-self-end">Current starting prices assume the standard service framework. Larger or more complex events receive a custom staffing and logistics quote.</p></div><div class="mt-14 grid gap-4 lg:grid-cols-3">{packages.map((item,index)=><article class="flex min-h-[29rem] flex-col rounded-[1.5rem] border border-white/12 bg-white/[.05] p-7"><p class="eyebrow text-[var(--koa-amber-light)]">0{index+1}</p><h3 class="display mt-10 text-5xl">{item.name}</h3><p class="mt-2 text-xs font-black uppercase tracking-[.13em] text-white/48">Starting at {'$'+item.price.toLocaleString()}</p><ul class="mt-8 grid gap-3 text-sm leading-6 text-white/70">{item.includes.map(x=><li class="flex gap-3"><span class="text-[var(--koa-amber-light)]">—</span><span>{x}</span></li>)}</ul><a href={'/inquire/?service=mobile-bar&package='+item.name.toLowerCase().replace(' ','-')} class="link-arrow mt-auto pt-8 text-white">Ask about {item.name} →</a></article>)}</div></div></section>

<section class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">From inquiry to last call</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The experience is designed before the bar is built.</h2></div><div class="grid border-t border-[var(--koa-line)]">{[
['01','Scope','Date, location, guest count, service duration and beverage style.'],
['02','Plan','Signature drinks, purchasing guidance, staffing, ice, mixers and logistics.'],
['03','Set','Bar placement, tools, supplies and guest-flow considerations.'],
['04','Serve','Professional service with optional gratuity and no default tip jar.']
].map(([n,t,c])=><div class="grid gap-3 border-b border-[var(--koa-line)] py-6 sm:grid-cols-[3rem_8rem_1fr]"><span class="eyebrow text-[var(--koa-clay)]">{n}</span><h3 class="display text-2xl">{t}</h3><p class="text-sm leading-6 text-[var(--koa-ink)]/64">{c}</p></div>)}</div></div></section>

<section class="py-24"><div class="container-shell flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"><div class="max-w-3xl"><p class="eyebrow text-[var(--koa-clay)]">Before you quote</p><h2 class="display mt-4 text-5xl leading-[1] sm:text-6xl">Get the practical answers first.</h2></div><div class="flex gap-4"><a href="/mobile-bar/faq/" class="rounded-full border border-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em]">Mobile Bar FAQ</a><a href="/inquire/?service=mobile-bar" class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Get a quote</a></div></div></section>
</main><Footer/></BaseLayout>