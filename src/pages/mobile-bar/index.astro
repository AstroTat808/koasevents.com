---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { businessRules } from '../../data/businessRules';

const hero = 'https://static.wixstatic.com/media/02b2df_9f60cf7d8a484f3ebca38106e3ebc6e8~mv2.jpg/v1/fill/w_1400,h_934,al_c,q_88/02b2df_9f60cf7d8a484f3ebca38106e3ebc6e8~mv2.jpg';
const packages = businessRules.mobileBar.packages;

const steps = [
  { number: '01', title: 'Choose your service style', text: 'Start with beer and wine, add signature drinks, or build toward a fuller mixed-cocktail menu.' },
  { number: '02', title: 'You purchase the alcohol', text: 'Koa’s operates as a dry bar. We help turn your guest count, timeline and menu into a practical purchasing plan.' },
  { number: '03', title: 'We run the service', text: 'Bartender labor for the standard package assumptions is included. Setup, flow, tools, ice, mixers and garnishes are handled according to your selected package and quote.' },
];

const policy = [
  ['Bartender labor', 'Included within standard package assumptions'],
  ['Gratuity', 'Optional'],
  ['Tip jar', 'No tip jar by default; available only if the client requests one'],
  ['Custom staffing', 'Quoted when guest count, menu complexity, service time or logistics require more staffing'],
  ['Base guest framework', 'Built around up to 100 guests; larger events receive a custom service/staffing quote'],
  ['Service time', businessRules.mobileBar.baseFramework.serviceDuration.value],
  ['Travel', businessRules.mobileBar.baseFramework.travel.value],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: "Koa's Mobile Bar",
  url: 'https://www.koasevents.com/mobile-bar/',
  telephone: businessRules.contact.phone,
  email: businessRules.contact.email,
  areaServed: { '@type': 'AdministrativeArea', name: 'Hawaiʻi Island' },
};
---
<BaseLayout title="Koa’s Mobile Bar | Big Island Wedding & Event Bartending" description="Bring Koa’s Mobile Bar to your Hawaiʻi Island wedding, private event or corporate gathering. Dry-bar packages include bartender labor under standard assumptions, with optional gratuity and custom staffing when needed." canonical="https://www.koasevents.com/mobile-bar/">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="relative min-h-[82svh] overflow-hidden bg-[var(--koa-ink)] text-white"><img src={hero} alt="Koa's Mobile Bar at an event on Hawaiʻi Island" class="absolute inset-0 h-full w-full object-cover opacity-68" fetchpriority="high"/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[82svh] items-end pb-16 pt-40 lg:pb-20"><div class="max-w-4xl"><p class="eyebrow text-white/62">Koa’s Mobile Bar · Hawaiʻi Island</p><h1 class="display mt-5 max-w-4xl text-6xl leading-[.92] sm:text-7xl lg:text-[6.6rem]">A polished bar experience, wherever you gather.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">Professional dry-bar service with bartender labor included under standard package assumptions, optional gratuity and staffing that scales to the event.</p><div class="mt-9 flex flex-wrap gap-3"><a href="/inquire/?service=mobile-bar" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Get a bar quote</a><a href="#packages" class="rounded-full border border-white/55 px-6 py-3.5 text-xs font-black uppercase tracking-[.12em]">Compare packages</a></div></div></div></section>

<section class="border-b border-[var(--koa-line)] bg-[var(--koa-sand)] py-5"><div class="container-shell flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-[.69rem] font-black uppercase tracking-[.15em] text-[var(--koa-ink)]/64"><span>Dry bar for hire</span><span>Bartender labor included</span><span>Optional gratuity</span><span>No default tip jar</span><span>Big Island service</span></div></section>

<section class="py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.76fr_1.24fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">How the dry-bar model works</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">You provide the alcohol. We make the bar work.</h2><p class="mt-6 text-sm leading-6 text-[var(--koa-ink)]/62">{businessRules.mobileBar.model.value}</p></div><div class="grid border-t border-[var(--koa-line)]">{steps.map((step)=><div class="grid gap-4 border-b border-[var(--koa-line)] py-7 sm:grid-cols-[3rem_1fr]"><span class="eyebrow text-[var(--koa-clay)]">{step.number}</span><div><h3 class="display text-3xl">{step.title}</h3><p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/68">{step.text}</p></div></div>)}</div></div></section>

<section id="packages" class="bg-[var(--koa-forest)] py-24 text-white lg:py-32"><div class="container-shell"><div class="grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:items-end"><div><p class="eyebrow text-white/48">Packages</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Start simple. Add only what makes the experience better.</h2></div><p class="max-w-xl text-sm leading-6 text-white/62 lg:justify-self-end">Starting prices reflect the current published beverage scope. Final quotes account for location, event duration, guest count, menu complexity, add-ons and any staffing above standard assumptions.</p></div><div class="mt-14 grid gap-5 lg:grid-cols-3">{packages.map((item,index)=><article class="flex min-h-[27rem] flex-col rounded-[1.6rem] border border-white/16 bg-white/[.055] p-7"><span class="eyebrow text-[var(--koa-amber-light)]">0{index+1}</span><h3 class="display mt-9 text-4xl">{item.name}</h3><p class="mt-2 text-xs font-black uppercase tracking-[.13em] text-white/55">Starting at {'$'+item.price.toLocaleString()}</p><ul class="mt-7 grid gap-3 text-sm leading-6 text-white/72">{item.includes.map((included)=><li class="flex gap-3"><span class="text-[var(--koa-amber-light)]">—</span><span>{included}</span></li>)}</ul><a href={'/inquire/?service=mobile-bar&package='+item.name.toLowerCase().replace(' ','-')} class="link-arrow mt-auto pt-8 text-white">Ask about {item.name} →</a></article>)}</div></div></section>

<section class="py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.76fr_1.24fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">The policy is now simple</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Labor is labor. Gratuity is gratuity.</h2><p class="mt-6 max-w-md text-sm leading-6 text-[var(--koa-ink)]/60">We removed the old percentage-based bartender-fee model from the redesign so quotes are easier to understand.</p></div><div class="grid border-t border-[var(--koa-line)]">{policy.map(([label,value])=><div class="grid gap-2 border-b border-[var(--koa-line)] py-5 sm:grid-cols-[9rem_1fr]"><span class="text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">{label}</span><span class="text-sm leading-6 text-[var(--koa-ink)]/68">{value}</span></div>)}</div></div></section>

<section class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"><div class="max-w-3xl"><p class="eyebrow text-[var(--koa-clay)]">Questions before you quote?</p><h2 class="display mt-4 text-5xl leading-[1] sm:text-6xl">Read the Mobile Bar FAQ first.</h2></div><div class="flex gap-4"><a href="/mobile-bar/faq/" class="rounded-full border border-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">Mobile Bar FAQ</a><a href="/inquire/?service=mobile-bar" class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Get a quote</a></div></div></section>
</main><Footer/></BaseLayout>
