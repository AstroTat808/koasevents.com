---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { businessRules } from '../../data/businessRules';
import { media, koaMarketingMedia } from '../../data/media';
const packages=businessRules.mobileBar.packages;
const mobileBarMoments = [
  { image: koaMarketingMedia.mobileBarGuestService, label: 'Guest service' },
  { image: koaMarketingMedia.signatureCocktailPour, label: 'Signature pours' },
  { image: koaMarketingMedia.mobileBarDetail, label: 'Styled bar details' },
];
const mobileBarSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Koa’s Mobile Bar',
  serviceType: 'Dry-bar mobile bartending service',
  url: 'https://www.koasevents.com/mobile-bar/',
  areaServed: { '@type': 'AdministrativeArea', name: 'Hawaiʻi Island' },
  provider: { '@type': 'LocalBusiness', name: 'Koa’s Events', url: 'https://www.koasevents.com/' },
  offers: packages.map((item) => ({
    '@type': 'Offer',
    name: item.name + ' Mobile Bar Package',
    price: item.price,
    priceCurrency: 'USD',
    description: item.includes.join(', '),
    url: 'https://koasmobilebar.com/#packages',
  })),
};
---
<BaseLayout title="Big Island Mobile Bar & Wedding Bartenders | Koa’s Events" description="Koa’s Mobile Bar dry-bar packages start at $1,500 for up to 100 guests. Bartender labor is $65/hour; Oahu, Maui and Big Island packages scale from beer and wine through full mixed-cocktail service." canonical="https://koasevents.com/mobile-bar/">
<script type="application/ld+json" set:html={JSON.stringify(mobileBarSchema)} />
<main>
<section class="relative min-h-[84svh] overflow-hidden bg-[var(--koa-ink)] text-white md:min-h-[88svh]"><ResponsiveImage {...koaMarketingMedia.mobileBarGuestService} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[84svh] items-end pb-14 pt-32 md:min-h-[88svh] md:pt-40 lg:pb-24"><div class="max-w-4xl"><p class="eyebrow text-white/65">Koa’s Mobile Bar · Hawaiʻi Island</p><h1 class="display mt-5 text-6xl leading-[.9] sm:text-7xl lg:text-[6.8rem]">A bar as considered as the rest of your event.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/78 sm:text-lg">Professional Big Island mobile bar and wedding bartender service for weddings, private events and corporate gatherings across Hawaiʻi Island.</p><a href="/inquire/?service=mobile-bar" class="mt-9 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Get a bar quote</a></div></div></section>

<section class="bg-[var(--koa-ink)] py-16 text-white"><div class="container-shell grid gap-px overflow-hidden rounded-[1.3rem] border border-white/10 bg-white/10 sm:grid-cols-4">
{[['Package','From $1,500'],['Bartender labor','$65 / hr'],['Guests','100 included'],['Gratuity','10% / 25%']].map(([k,v])=><div class="bg-[var(--koa-ink)] p-6"><p class="eyebrow text-[var(--koa-amber-light)]">{k}</p><p class="display mt-2 text-3xl">{v}</p></div>)}
</div></section>

<section class="py-20 lg:py-28">
  <div class="container-shell grid gap-10 lg:grid-cols-[.76fr_1.24fr] lg:items-start lg:gap-24">
    <div>
      <p class="eyebrow text-[var(--koa-clay)]">Big Island mobile bar service</p>
      <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Wedding bartenders and dry-bar service that travel to your venue.</h2>
    </div>
    <div>
      <p class="text-base leading-7 text-[var(--koa-ink)]/68">Koa’s Mobile Bar serves weddings and events throughout Hawaiʻi Island. Under the dry-bar model, you purchase the alcohol and Koa’s handles the professional bar service, planning, setup and package supplies so the beverage experience can fit the venue you already chose.</p>
      <p class="mt-5 text-sm leading-7 text-[var(--koa-ink)]/58">Travel, staffing and logistics are confirmed in the quote based on the event location, guest count, service duration and menu complexity.</p>
      <div class="mt-7 flex flex-wrap gap-5"><a href="https://koasmobilebar.com/" class="link-arrow text-[var(--koa-forest)]">Visit the dedicated Koa’s Mobile Bar site →</a><a href="/mobile-bar/faq/" class="link-arrow text-[var(--koa-forest)]">Read the Mobile Bar FAQ →</a><a href="/weddings/" class="link-arrow text-[var(--koa-forest)]">Planning a wedding at Koa’s? →</a></div>
    </div>
  </div>
</section>

<section class="py-24 lg:py-36"><div class="container-shell grid gap-14 lg:grid-cols-[.82fr_1.18fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">The dry-bar model</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">You buy the alcohol. We make the service feel effortless.</h2><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">{businessRules.mobileBar.model.value}</p><p class="mt-5 text-sm leading-6 text-[var(--koa-ink)]/56">Bartender labor is $65 per hour per bartender. Staffing scales with guest count, menu complexity, event duration and service demand, and gratuity is 10% with a tip jar or 25% with no tip jar.</p></div><div class="relative h-[29rem] sm:h-[34rem] lg:h-[40rem]"><div class="absolute right-0 top-0 h-[24rem] w-[82%] overflow-hidden rounded-[1.6rem] sm:h-[28rem] lg:h-[33rem] lg:w-[78%] lg:rounded-[2rem]"><ResponsiveImage {...koaMarketingMedia.signatureCocktailPour} width={1100} height={1350} sizes="(min-width:1024px) 48vw, 85vw" class="h-full w-full object-cover"/></div><div class="absolute bottom-0 left-0 rounded-[1.3rem] bg-[var(--koa-clay)] p-7 text-white shadow-xl"><p class="eyebrow text-white/58">Service philosophy</p><p class="display mt-3 max-w-xs text-3xl">Good drinks. Better flow. Less for the host to manage.</p></div></div></div></section>

<section class="bg-[var(--koa-sand)] py-24 lg:py-32">
  <div class="container-shell">
    <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
      <div>
        <p class="eyebrow text-[var(--koa-clay)]">See it in service</p>
        <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The bar is part of the guest experience.</h2>
      </div>
      <p class="max-w-xl text-sm leading-7 text-[var(--koa-ink)]/62 lg:justify-self-end">From the first order to the final toast, the setup should feel intentional, approachable and visually connected to the celebration around it.</p>
    </div>
    <div class="mt-12 grid gap-4 lg:grid-cols-3">
      {mobileBarMoments.map((item)=><figure class="group overflow-hidden rounded-[1.5rem] bg-[var(--koa-ivory)]">
        <div class="relative h-[26rem] overflow-hidden sm:h-[30rem]"><ResponsiveImage {...item.image} width={900} height={1200} sizes="(min-width:1024px) 33vw,100vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]"/></div>
        <figcaption class="px-6 py-5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">{item.label}</figcaption>
      </figure>)}
    </div>
  </div>
</section>

<section id="packages" class="bg-[var(--koa-forest)] py-24 text-white lg:py-32"><div class="container-shell">
  <div class="grid gap-8 lg:grid-cols-[.76fr_1.24fr] lg:items-end"><div><p class="eyebrow text-[var(--koa-amber-light)]">Package starting points</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Three menu depths. One premium service foundation.</h2></div><p class="max-w-xl text-sm leading-7 text-white/60 lg:justify-self-end">All three packages include up to 100 guests, four hours of service, setup + cleanup, up to 150 lbs of ice, five mixers, water station, supplies, planning support and 20 miles of travel each way. Bartender labor is separate at $65/hour per bartender.</p></div>
  <div class="mt-14 grid gap-4 lg:grid-cols-3">{packages.map((item,index)=><article class={"flex flex-col rounded-[1.5rem] border p-7 lg:min-h-[31rem] "+(item.name==='Big Island'?'border-[var(--koa-amber-light)]/45 bg-white/[.09] shadow-2xl':'border-white/12 bg-white/[.05]')}><div class="flex items-center justify-between gap-3"><p class="eyebrow text-[var(--koa-amber-light)]">0{index+1}</p>{item.name==='Maui'&&<span class="rounded-full border border-white/15 px-3 py-1 text-[.55rem] font-black uppercase tracking-[.11em] text-white/70">Recommended start</span>}{item.name==='Big Island'&&<span class="rounded-full bg-[var(--koa-amber-light)] px-3 py-1 text-[.55rem] font-black uppercase tracking-[.11em] text-[var(--koa-ink)]">Premium full bar</span>}</div><h3 class="display mt-10 text-5xl">{item.name}</h3><p class="mt-2 text-xs font-black uppercase tracking-[.13em] text-white/48">Starting at {'$'+item.price.toLocaleString()}</p><ul class="mt-8 grid gap-3 text-sm leading-6 text-white/72">{item.includes.map(x=><li class="flex gap-3"><span class="text-[var(--koa-amber-light)]">—</span><span>{x}</span></li>)}</ul><a href={'/inquire/?service=mobile-bar&package='+item.name.toLowerCase().replace(' ','-')} class="link-arrow mt-auto pt-8 text-white">Ask about {item.name} →</a></article>)}</div>
  <div class="mt-10 grid overflow-hidden rounded-[1.4rem] border border-white/12 bg-white/10 sm:grid-cols-2 xl:grid-cols-4">
    <div class="bg-[var(--koa-forest)] p-6"><p class="eyebrow text-[var(--koa-amber-light)]">Additional guests</p><p class="mt-3 text-sm leading-6 text-white/72">Oahu $10 · Maui $12 · Big Island $15 per guest above 100.</p></div>
    <div class="bg-[var(--koa-forest)] p-6"><p class="eyebrow text-[var(--koa-amber-light)]">Extra service time</p><p class="mt-3 text-sm leading-6 text-white/72">$200 per additional hour plus bartender labor.</p></div>
    <div class="bg-[var(--koa-forest)] p-6"><p class="eyebrow text-[var(--koa-amber-light)]">Travel</p><p class="mt-3 text-sm leading-6 text-white/72">20 miles each way included · $2 per excess round-trip mile · +$150 beyond 60 miles one-way.</p></div>
    <div class="bg-[var(--koa-forest)] p-6"><p class="eyebrow text-[var(--koa-amber-light)]">Gratuity</p><p class="mt-3 text-sm leading-6 text-white/72">10% with a tip jar · 25% with no tip jar.</p></div>
  </div>
  <a href="https://koasmobilebar.com/#compare-packages" class="link-arrow mt-8 text-white">Compare packages and build an instant estimate →</a>
</div></section>

<section class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">From inquiry to last call</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The experience is designed before the bar is built.</h2></div><div class="grid border-t border-[var(--koa-line)]">{[
['01','Scope','Date, location, guest count, service duration and beverage style.'],
['02','Plan','Signature drinks, purchasing guidance, staffing, ice, mixers and logistics.'],
['03','Set','Bar placement, tools, supplies and guest-flow considerations.'],
['04','Serve','Professional service with 10% gratuity + tip jar or 25% no-tip-jar service.']
].map(([n,t,c])=><div class="grid gap-3 border-b border-[var(--koa-line)] py-6 sm:grid-cols-[3rem_8rem_1fr]"><span class="eyebrow text-[var(--koa-clay)]">{n}</span><h3 class="display text-2xl">{t}</h3><p class="text-sm leading-6 text-[var(--koa-ink)]/64">{c}</p></div>)}</div></div></section>

<section class="py-24"><div class="container-shell flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"><div class="max-w-3xl"><p class="eyebrow text-[var(--koa-clay)]">Before you quote</p><h2 class="display mt-4 text-5xl leading-[1] sm:text-6xl">Get the practical answers first.</h2></div><div class="flex flex-wrap items-center gap-5"><a href="/mobile-bar/faq/" class="link-arrow text-[var(--koa-forest)]">Mobile Bar FAQ →</a><a href="/inquire/?service=mobile-bar" class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Get a quote</a></div></div></section>
</main><Footer/></BaseLayout>