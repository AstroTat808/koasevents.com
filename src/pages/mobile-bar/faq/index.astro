---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { businessRules } from '../../../data/businessRules';

const faqs = [
  ['What exactly is Koa’s Mobile Bar?', 'A professionally staffed dry-bar service for weddings and events across Hawaiʻi Island. Koa’s provides bar service, planning, setup and the supplies included in the selected package; the client purchases the alcohol.'],
  ['What do the packages cost?', 'Oahu starts at $1,500, Maui starts at $2,000 and Big Island starts at $2,500. Each package includes up to 100 guests and four hours of service before labor, travel beyond the included radius, gratuity and selected add-ons.'],
  ['Do you provide the alcohol?', 'No. Under the dry-bar model, the client purchases the alcohol. Koa’s helps plan what and how much to buy based on the guest count, event length and selected drink menu.'],
  ['Is bartender labor included?', businessRules.mobileBar.bartenderLabor.value],
  ['How does gratuity work?', businessRules.mobileBar.gratuity.value],
  ['Will there be a tip jar?', businessRules.mobileBar.tipJar.value],
  ['How do you decide staffing?', 'Most events use one or two bartenders. The final staffing count depends on guest count, drink-menu complexity, service duration, venue logistics and expected service demand.'],
  ['How many guests are included?', 'Up to 100 guests are included. Above 100 guests, the published surcharge is $10 per guest with Oahu, $12 with Maui and $15 with Big Island.'],
  ['What types of bar service do you offer?', 'Oahu covers beer, champagne and wine. Maui adds two signature drinks. Big Island adds full mixed-cocktail service plus enhanced garnish presentation, one zero-proof signature companion and custom cocktail naming + menu curation.'],
  ['Why is the Big Island package $500 more than Maui?', 'Big Island is the premium full-bar tier: it keeps the two signature drinks, adds mixed-cocktail service, enhanced garnish presentation, a zero-proof signature companion and custom cocktail naming + menu curation.'],
  ['Do you handle setup and breakdown?', 'Yes. Setup and cleanup are included around the four-hour service window.'],
  ['Do you provide ice, mixers and bar tools?', 'Yes. The published service foundation includes essential bar tools, up to 150 lbs of ice, a choice of five mixers, service supplies, biodegradable cups, fresh garnishes and a water station.'],
  ['How long is service?', 'Four hours are included. Additional service time is $200 per hour plus bartender labor at $65 per hour per bartender.'],
  ['How does travel pricing work?', 'Travel within 20 miles each way is included. Excess round-trip mileage is $2.00 per mile, and events more than 60 miles one-way add a $150 long-distance logistics fee.'],
  ['Can you work with our venue or planner?', 'Yes. Koa’s can coordinate timing, layout, service rules and logistics with your venue, planner or coordinator.'],
  ['Can you serve mocktails and non-drinkers?', 'Yes. Zero-proof service can include mocktails, sparkling water and other non-alcoholic options. The Big Island package includes one zero-proof signature companion.'],
  ['How do we get pricing?', 'Use the instant estimate at KoaSMobileBar.com or send the event date, location, guest count and preferred package. The proposal confirms staffing, travel, gratuity and any selected enhancements.'],
];
const schema={'@context':'https://schema.org','@type':'FAQPage','mainEntity':faqs.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))};
---
<BaseLayout title="Big Island Mobile Bar FAQ | Koa’s Events" description="Current Koa’s Mobile Bar pricing and policies: $1,500 / $2,000 / $2,500 packages, $65/hour bartender labor, guest surcharges, gratuity options and Hawaiʻi Island travel." canonical="https://www.koasevents.com/mobile-bar/faq/">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<Header overlay={false}/>
<main><section class="py-20 lg:py-28"><div class="container-shell grid gap-12 lg:grid-cols-[.75fr_1.25fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">Mobile Bar FAQ</p><h1 class="display mt-5 text-6xl leading-[.95] sm:text-7xl">Clear answers before the first pour.</h1><p class="mt-7 text-sm leading-6 text-[var(--koa-ink)]/62">Current pricing is synchronized with KoaSMobileBar.com: packages start at $1,500 / $2,000 / $2,500, bartender labor is $65/hour per bartender, and gratuity is 10% with a tip jar or 25% with no tip jar.</p><a href="/inquire/?service=mobile-bar" class="mt-8 inline-flex rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Get a bar quote</a></div><div class="grid gap-3">{faqs.map(([q,a])=><details class="group rounded-2xl border border-[var(--koa-line)] bg-white p-5"><summary class="cursor-pointer list-none pr-8 text-base font-bold">{q}</summary><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/68">{a}</p></details>)}</div></div></section></main><Footer/>
</BaseLayout>
