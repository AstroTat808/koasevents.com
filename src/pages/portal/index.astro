---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout noindex title="Koa’s Client Portal" description="Your Koa’s Events proposal, agreement, payments, planning, documents, appointments and messages." canonical="https://koasevents.com/portal/">
<Header overlay={false}/>
<main class="min-h-[72vh] bg-[var(--koa-sand)] py-10">
<div class="container-shell max-w-6xl">
<section data-loading class="rounded-[1.6rem] bg-white p-8 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Koa’s Events</p><h1 class="display mt-3 text-5xl">Loading your client portal…</h1></section>
<section data-error class="hidden rounded-[1.6rem] bg-white p-8 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Client portal</p><h1 class="display mt-3 text-5xl">This portal link is unavailable.</h1><p data-error-copy class="mt-4 text-sm text-[var(--koa-ink)]/60"></p></section>
<div data-app class="hidden grid gap-5">
<header class="rounded-[1.8rem] bg-[var(--koa-forest)] p-7 text-white shadow-[var(--shadow-soft)] sm:p-9"><p class="eyebrow text-[var(--koa-amber-light)]">Your Koa’s Client Portal</p><h1 data-title class="display mt-3 text-5xl"></h1><p data-meta class="mt-3 text-sm text-white/65"></p></header>
<nav class="flex flex-wrap gap-2 rounded-[1.3rem] bg-white p-3 shadow-[var(--shadow-soft)]">
<button data-tab="dashboard" class="rounded-full px-4 py-2 text-[.62rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">dashboard</button><button data-tab="proposal" class="rounded-full px-4 py-2 text-[.62rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">proposal</button><button data-tab="contract" class="rounded-full px-4 py-2 text-[.62rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">contract</button><button data-tab="payments" class="rounded-full px-4 py-2 text-[.62rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">payments</button><button data-tab="planning" class="rounded-full px-4 py-2 text-[.62rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">planning</button><button data-tab="documents" class="rounded-full px-4 py-2 text-[.62rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">documents</button><button data-tab="appointments" class="rounded-full px-4 py-2 text-[.62rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">appointments</button><button data-tab="messages" class="rounded-full px-4 py-2 text-[.62rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">messages</button>
</nav>
<section data-panel="dashboard" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"></section>
<section data-panel="proposal" class="hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"></section>
<section data-panel="contract" class="hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"></section>
<section data-panel="payments" class="hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"></section>
<section data-panel="planning" class="hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"></section>
<section data-panel="documents" class="hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"></section>
<section data-panel="appointments" class="hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"></section>
<section data-panel="messages" class="hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"></section>
</div></div></main><Footer/>
<script>
const token=new URLSearchParams(location.search).get('token')||'',loading=document.querySelector('[data-loading]'),error=document.querySelector('[data-error]'),app=document.querySelector('[data-app]');let project=null;
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(Number(n)||0);
const date=v=>v?new Intl.DateTimeFormat('en-US',{dateStyle:'medium'}).format(new Date(v.length===10?v+'T12:00:00':v)):'—';
function card(label,value,copy=''){return '<article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">'+esc(label)+'</p><p class="display mt-2 text-3xl text-[var(--koa-forest)]">'+esc(value)+'</p>'+(copy?'<p class="mt-2 text-xs text-[var(--koa-ink)]/50">'+esc(copy)+'</p>':'')+'</article>'}
function tab(name){document.querySelectorAll('[data-panel]').forEach(x=>x.classList.toggle('hidden',x.dataset.panel!==name));document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('bg-[var(--koa-forest)]',x.dataset.tab===name)||x.classList.toggle('text-white',x.dataset.tab===name));}
async function post(body){const r=await fetch('/api/client-portal/'+encodeURIComponent(token),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||'Unable to save.');return j;}
function render(){
document.querySelector('[data-title]').textContent=project.customerName||'Your event';document.querySelector('[data-meta]').textContent=[date(project.eventDate),project.packageId,String(project.stage||'').replaceAll('_',' ')].filter(Boolean).join(' · ');
document.querySelector('[data-panel="dashboard"]').innerHTML=card('Proposal',project.proposal.status,money(project.proposal.total))+card('Contract',project.contract?.status||'Not started',project.contract?.signwell?.status||'')+card('Payments',project.payments.filter(x=>x.status==='paid').length+' / '+project.payments.length+' paid')+card('Planning',project.planningAvailable?'Open':'Unlocks when booked');
document.querySelector('[data-panel="proposal"]').innerHTML='<p class="eyebrow text-[var(--koa-clay)]">Proposal</p><h2 class="display mt-2 text-4xl">'+money(project.proposal.total)+'</h2><p class="mt-3 text-sm text-[var(--koa-ink)]/60">Status: '+esc(project.proposal.status)+'</p><a class="mt-5 inline-flex rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white" href="'+project.proposal.url+'">Open proposal</a>';
const sw=project.contract?.signwell||{};let contractAction='';if(project.contract?.status==='signed')contractAction='<a href="/api/client-portal/contract/'+encodeURIComponent(token)+'" target="_blank" class="mt-5 inline-flex rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Open signed agreement</a>';else if(sw.clientSigningUrl)contractAction='<a href="'+esc(sw.clientSigningUrl)+'" target="_blank" class="mt-5 inline-flex rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Sign agreement in SignWell</a>';else contractAction='<a href="'+(project.contract?.url||'#')+'" class="mt-5 inline-flex rounded-full bg-[var(--koa-ink)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Open agreement</a>';
document.querySelector('[data-panel="contract"]').innerHTML='<p class="eyebrow text-[var(--koa-clay)]">Contract</p><h2 class="display mt-2 text-4xl">'+esc(project.contract?.title||'Booking agreement')+'</h2><p class="mt-3 text-sm text-[var(--koa-ink)]/60">Agreement: '+esc(project.contract?.status||'pending')+' · SignWell: '+esc(sw.status||'not sent')+'</p>'+contractAction;
document.querySelector('[data-panel="payments"]').innerHTML='<p class="eyebrow text-[var(--koa-clay)]">Payments</p><h2 class="display mt-2 text-4xl">QuickBooks milestones</h2><div class="mt-5 grid gap-3">'+project.payments.map(x=>'<div class="rounded-xl border border-[var(--koa-line)] p-4"><div class="flex justify-between gap-4"><strong>'+esc(x.label)+'</strong><span>'+money(x.amount)+'</span></div><p class="mt-1 text-xs text-[var(--koa-ink)]/50">'+(x.dueDate?'Due '+date(x.dueDate):'Due date pending')+' · '+esc(x.status)+(x.docNumber?' · Invoice #'+esc(x.docNumber):'')+'</p></div>').join('')+'</div>';
document.querySelector('[data-panel="planning"]').innerHTML='<p class="eyebrow text-[var(--koa-clay)]">Planning</p><h2 class="display mt-2 text-4xl">'+(project.planningAvailable?'Your planning workspace is open.':'Planning opens after booking is complete.')+'</h2>'+(project.planningAvailable?'<a href="'+project.planningUrl+'" class="mt-5 inline-flex rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Open planning tools</a>':'');
document.querySelector('[data-panel="documents"]').innerHTML='<p class="eyebrow text-[var(--koa-clay)]">Documents</p><h2 class="display mt-2 text-4xl">Your files</h2><div class="mt-5 grid gap-2">'+(project.documents.length?project.documents.map(d=>'<div class="rounded-xl border border-[var(--koa-line)] p-4"><strong>'+esc(d.label||d.name)+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/48">'+esc(d.category)+' · '+date(d.uploadedAt)+'</p></div>').join(''):'<p class="text-sm text-[var(--koa-ink)]/50">No client documents uploaded yet.</p>')+'</div>';
document.querySelector('[data-panel="appointments"]').innerHTML='<p class="eyebrow text-[var(--koa-clay)]">Appointments</p><h2 class="display mt-2 text-4xl">Tours, calls + walkthroughs</h2><div class="mt-5 grid gap-2">'+(project.appointments.length?project.appointments.map(a=>'<div class="rounded-xl border border-[var(--koa-line)] p-4"><strong>'+esc(a.title)+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/48">'+date(a.startsAt)+' · '+esc(a.status)+'</p></div>').join(''):'')+'</div><form data-appointment-form class="mt-6 grid gap-3 sm:grid-cols-2"><input name="title" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="Planning call / venue tour / walkthrough"><input name="startsAt" type="datetime-local" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><textarea name="notes" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 sm:col-span-2" placeholder="Anything Koa’s should know"></textarea><button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Request appointment</button><span data-appointment-msg class="text-sm text-[var(--koa-ink)]/50"></span></form>';
document.querySelector('[data-panel="messages"]').innerHTML='<p class="eyebrow text-[var(--koa-clay)]">Messages</p><h2 class="display mt-2 text-4xl">Project conversation</h2><div class="mt-5 grid max-h-[420px] gap-2 overflow-y-auto">'+(project.messages.length?project.messages.map(m=>'<div class="rounded-xl '+(m.sender==='client'?'bg-[var(--koa-sand)]':'border border-[var(--koa-line)]')+' p-4"><p class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">'+esc(m.senderName||m.sender)+'</p><p class="mt-2 text-sm leading-6">'+esc(m.message)+'</p><p class="mt-2 text-xs text-[var(--koa-ink)]/40">'+date(m.createdAt)+'</p></div>').join(''):'<p class="text-sm text-[var(--koa-ink)]/50">No messages yet.</p>')+'</div><form data-message-form class="mt-5 flex gap-2"><input name="message" required class="min-w-0 flex-1 rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="Send Koa’s a message"><button class="rounded-xl bg-[var(--koa-ink)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Send</button></form>';
document.querySelector('[data-appointment-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,m=f.querySelector('[data-appointment-msg]');try{m.textContent='Sending…';await post({action:'request-appointment',title:f.title.value,startsAt:f.startsAt.value,notes:f.notes.value});m.textContent='Request sent.';await load();tab('appointments');}catch(err){m.textContent=err.message;}});
document.querySelector('[data-message-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'send-message',message:f.message.value});await load();tab('messages');});
}
async function load(){if(!token){loading.classList.add('hidden');error.classList.remove('hidden');document.querySelector('[data-error-copy]').textContent='This link is missing its secure project token.';return;}const r=await fetch('/api/client-portal/'+encodeURIComponent(token),{cache:'no-store'});const j=await r.json().catch(()=>({}));loading.classList.add('hidden');if(!r.ok){error.classList.remove('hidden');document.querySelector('[data-error-copy]').textContent=j.error||'Unable to load portal.';return;}project=j.project;app.classList.remove('hidden');render();}
document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>tab(b.dataset.tab)));load();tab('dashboard');
</script>
</BaseLayout>