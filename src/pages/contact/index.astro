---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { businessRules } from '../../data/businessRules';

const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(businessRules.contact.venueAddress);
const mapEmbedUrl = 'https://www.google.com/maps?q=' + encodeURIComponent(businessRules.contact.venueAddress) + '&output=embed';
---

<BaseLayout
  title="Contact Koa’s Events | Big Island Venue in Mountain View, Hawaiʻi"
  description="Contact Koa’s Events, a private Mountain View event and wedding venue serving Hilo, East Hawaiʻi and the Big Island. Get directions, request a venue tour, or start an event inquiry."
  canonical="https://koasevents.com/contact/"
  breadcrumbTitle="Contact"
>
  <Header overlay={false} />
  <main>
    <section class="koa-grain bg-[var(--koa-sand)] py-20 lg:py-28">
      <div class="container-shell grid gap-12 lg:grid-cols-[.86fr_1.14fr] lg:items-start lg:gap-20">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Contact + directions</p>
          <h1 class="display mt-5 text-6xl leading-[.94] sm:text-7xl">Visit Koa’s Events in Mountain View, Hawaiʻi.</h1>
          <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">Koa’s Events is a private wedding and event venue in Mountain View on Hawaiʻi Island, serving couples and hosts planning celebrations in Hilo, East Hawaiʻi and across the Big Island. Reach us directly, get driving directions, or start an inquiry to request a venue tour.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/inquire/?service=venue" class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Request a venue tour</a>
            <a href="/wedding-inquiry/" class="rounded-full border border-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">Wedding inquiry</a>
          </div>
          <div class="mt-10 rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Planning a tour</p>
            <h2 class="display mt-4 text-3xl text-[var(--koa-ink)]">Start with your date, guest count, and event type.</h2>
            <p class="mt-4 text-sm leading-7 text-[var(--koa-ink)]/64">Venue tours are coordinated through the inquiry process so we can review your event details first and make the visit useful. Tell us whether you are planning a wedding, private event, corporate gathering, or a venue-plus-Mobile-Bar experience and indicate that you would like a tour.</p>
            <a href="/inquire/?service=venue" class="link-arrow mt-5 text-[var(--koa-forest)]">Request a tour through the venue inquiry →</a>
          </div>
        </div>

        <div class="grid gap-4">
          <article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-7 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Venue address</p>
            <address class="mt-4 not-italic">
              <p class="display text-3xl text-[var(--koa-ink)]">Koa’s Events</p>
              <p class="mt-3 text-base leading-7 text-[var(--koa-ink)]/70">{businessRules.contact.venueAddress}</p>
            </address>
            <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.12em] text-white">Get driving directions →</a>
          </article>

          <div class="overflow-hidden rounded-[1.5rem] border border-[var(--koa-line)] bg-white shadow-[var(--shadow-soft)]">
            <iframe
              src={mapEmbedUrl}
              title="Map showing Koa’s Events at 11-3330 Hibiscus St, Mountain View, Hawaii"
              class="h-[24rem] w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7">
              <p class="eyebrow text-[var(--koa-clay)]">Call</p>
              <a class="display mt-4 block text-3xl text-[var(--koa-forest)] hover:underline" href={`tel:${businessRules.contact.phone}`}>{businessRules.contact.phoneDisplay}</a>
              <p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/60">Venue, event, and Mobile Bar questions.</p>
            </article>

            <article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7">
              <p class="eyebrow text-[var(--koa-clay)]">Email</p>
              <a class="mt-4 block break-all text-base font-bold text-[var(--koa-forest)] hover:underline" href={`mailto:${businessRules.contact.email}`}>{businessRules.contact.email}</a>
              <p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/60">For planning questions, vendors, and general correspondence.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-28">
      <div class="container-shell grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">East Hawaiʻi location</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A Mountain View venue for Hilo-area and Big Island celebrations.</h2>
        </div>
        <div class="max-w-2xl">
          <p class="text-base leading-7 text-[var(--koa-ink)]/68">The venue is located in Mountain View, Hawaiʻi, within the East Hawaiʻi side of the island. That makes Koa’s relevant for couples and hosts comparing wedding and event venues around Hilo, Mountain View, Volcano and the broader Big Island while still offering a private, rainforest-forward setting of its own.</p>
          <p class="mt-5 text-sm leading-7 text-[var(--koa-ink)]/58">Koa’s Mobile Bar also serves events around Hawaiʻi Island, so clients can inquire about the venue, Mobile Bar service, or both through the same planning process.</p>
          <div class="mt-7 flex flex-wrap gap-5">
            <a href="/east-hawaii-wedding-venue/" class="link-arrow text-[var(--koa-forest)]">Explore the East Hawaiʻi venue guide →</a>
            <a href="/venue/" class="link-arrow text-[var(--koa-forest)]">Explore the venue →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
