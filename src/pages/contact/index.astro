---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { businessRules } from '../../data/businessRules';

const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(businessRules.contact.venueAddress);
---

<BaseLayout
  title="Contact Koa’s Events | Mountain View, Hawaiʻi"
  description="Contact Koa’s Events in Mountain View, Hawaiʻi. Find the venue address, driving directions, phone number, email, and event inquiry links."
  canonical="https://koasevents.com/contact/"
  breadcrumbTitle="Contact"
>
  <Header overlay={false} />
  <main>
    <section class="koa-grain bg-[var(--koa-sand)] py-20 lg:py-28">
      <div class="container-shell grid gap-12 lg:grid-cols-[.86fr_1.14fr] lg:items-start lg:gap-20">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Contact + directions</p>
          <h1 class="display mt-5 text-6xl leading-[.94] sm:text-7xl">Find Koa’s in Mountain View.</h1>
          <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">Questions about the venue, a wedding, a private event, or Koa’s Mobile Bar? Reach us directly or start an event inquiry so we can respond with the details that fit your plans.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/inquire/" class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Start an inquiry</a>
            <a href="/wedding-inquiry/" class="rounded-full border border-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">Wedding inquiry</a>
          </div>
        </div>

        <div class="grid gap-4">
          <article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-7 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Venue address</p>
            <address class="mt-4 not-italic">
              <p class="display text-3xl text-[var(--koa-ink)]">Koa’s Events</p>
              <p class="mt-3 text-base leading-7 text-[var(--koa-ink)]/70">{businessRules.contact.venueAddress}</p>
            </address>
            <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.12em] text-white">Get driving directions →</a>
          </article>

          <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7">
              <p class="eyebrow text-[var(--koa-clay)]">Call</p>
              <a class="display mt-4 block text-3xl text-[var(--koa-forest)] hover:underline" href={`tel:${businessRules.contact.phone}`}>{businessRules.contact.phoneDisplay}</a>
              <p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/60">Venue, event, and Mobile Bar questions.</p>
            </article>

            <article class="rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-7">
              <p class="eyebrow text-[var(--koa-clay)]">Email</p>
              <a class="mt-4 block break-all text-base font-bold text-[var(--koa-forest)] hover:underline" href={`mailto:${businessRules.contact.email}`}>{businessRules.contact.email}</a>
              <p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/60">For planning questions, vendors, and general correspondence.</p>
            </article>
          </div>

          <article class="rounded-[1.5rem] bg-[var(--koa-forest)] p-7 text-white">
            <p class="eyebrow text-[var(--koa-amber-light)]">Planning a visit?</p>
            <p class="display mt-4 text-3xl">Start with your event details.</p>
            <p class="mt-3 max-w-xl text-sm leading-6 text-white/68">Submitting the inquiry first gives us your date, guest count, and service needs so the next conversation can be useful.</p>
            <a href="/inquire/?service=venue" class="mt-6 inline-flex font-bold text-white hover:text-[var(--koa-amber-light)]">Check venue availability →</a>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
