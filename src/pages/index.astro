---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { businessRules } from '../data/businessRules';

const hero = 'https://static.wixstatic.com/media/02b2df_dbe1e4c043e0401590406df45a251117~mv2.jpg/v1/fill/w_1600,h_1067,al_c,q_88/02b2df_dbe1e4c043e0401590406df45a251117~mv2.jpg';
const portrait = 'https://static.wixstatic.com/media/02b2df_aba14915428b45348a220f7ab88f3d2a~mv2.jpg/v1/fill/w_900,h_1200,al_c,q_88/02b2df_aba14915428b45348a220f7ab88f3d2a~mv2.jpg';
const wide = 'https://static.wixstatic.com/media/02b2df_ef974bce03ba4e3d8e142a172d0acec0~mv2.jpg/v1/fill/w_1400,h_933,al_c,q_88/02b2df_ef974bce03ba4e3d8e142a172d0acec0~mv2.jpg';

const serviceCards = [
  { number: '01', title: 'Host at Koa’s', copy: 'A private Mountain View venue for weddings, celebrations, retreats and corporate gatherings.', href: '/venue/' },
  { number: '02', title: 'Bring Koa’s to you', copy: 'Professional dry-bar service across Hawaiʻi Island, with planning, setup and bartender labor built into the package framework.', href: '/mobile-bar/' },
  { number: '03', title: 'Use both', copy: 'Combine venue and bar service so the guest experience runs from one connected plan.', href: '/inquire/?service=both' },
];

const celebrations = [
  { title: 'Weddings', text: 'Venue, Mobile Bar or both—built around the way you want the day to feel.', href: '/weddings/' },
  { title: 'Private Events', text: 'Birthdays, showers, graduations, retreats and milestones without wedding-package baggage.', href: '/private-events/' },
  { title: 'Corporate', text: 'Retreats, client events and team gatherings with practical production thinking.', href: '/corporate-events/' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name: "Koa's Events",
  url: 'https://www.koasevents.com/',
  email: businessRules.contact.email,
  telephone: businessRules.contact.phone,
  maximumAttendeeCapacity: businessRules.venue.maximumOccupancy.value,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '11-3334 Hibiscus St',
    addressLocality: 'Mountain View',
    addressRegion: 'HI',
    postalCode: '96771',
    addressCountry: 'US',
  },
};
---
<BaseLayout
  title="Koa’s Events | Big Island Event Venue & Mobile Bar"
  description="Host a wedding or event for up to 100 guests at Koa’s Events in Mountain View, Hawaiʻi, or bring Koa’s Mobile Bar anywhere on the Big Island."
  canonical="https://www.koasevents.com/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main>
    <section class="relative min-h-[94svh] overflow-hidden bg-[var(--koa-ink)] text-white">
      <img src={hero} alt="Koa's Events venue in Mountain View, Hawaiʻi" class="absolute inset-0 h-full w-full object-cover opacity-90" fetchpriority="high" />
      <div class="hero-shade absolute inset-0"></div>
      <Header />
      <div class="container-shell relative z-10 flex min-h-[94svh] items-end pb-16 pt-40 lg:pb-20">
        <div class="max-w-4xl">
          <p class="eyebrow mb-6 text-white/70">Private venue · Mobile bar · Hawaiʻi Island</p>
          <h1 class="display max-w-4xl text-6xl leading-[.92] sm:text-7xl lg:text-[6.7rem]">Big Island celebrations, beautifully hosted.</h1>
          <p class="mt-7 max-w-2xl text-base leading-7 text-white/82 sm:text-lg">Gather at our private Mountain View venue for up to {businessRules.venue.maximumOccupancy.value} guests, bring Koa’s Mobile Bar to your location, or combine both into one more connected event experience.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/inquire/" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[0.12em] text-[var(--koa-ink)] transition hover:bg-[var(--koa-sand)]">Check your date</a>
            <a href="/venue/" class="rounded-full border border-white/55 px-6 py-3.5 text-xs font-black uppercase tracking-[0.12em] text-white transition hover:bg-white/10">Explore the venue</a>
          </div>
        </div>
      </div>
      <div class="hero-detail-card absolute bottom-6 right-6 z-10 hidden max-w-sm rounded-[1.2rem] px-7 py-6 md:block">
        <p class="eyebrow text-[var(--koa-clay)]">Mountain View, Hawaiʻi</p>
        <p class="mt-2 max-w-xs text-sm leading-6 text-[var(--koa-ink)]/68">Four tropical acres · 1,500 sq. ft. pavilion · Up to {businessRules.venue.maximumOccupancy.value} guests.</p>
      </div>
    </section>

    <section class="border-b border-[var(--koa-line)] bg-[var(--koa-sand)] py-5">
      <div class="container-shell flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-[0.69rem] font-black uppercase tracking-[0.15em] text-[var(--koa-ink)]/65">
        <span>Up to {businessRules.venue.maximumOccupancy.value} guests</span><span>Weddings</span><span>Private celebrations</span><span>Corporate gatherings</span><span>Island-wide mobile bar</span>
      </div>
    </section>

    <section class="py-24 lg:py-32">
      <div class="container-shell grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:gap-20">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">One brand. Two ways to gather.</p>
          <h2 class="display mt-5 text-5xl leading-[1.02] sm:text-6xl">A calmer way to host something meaningful.</h2>
        </div>
        <div class="grid border-t border-[var(--koa-line)]">
          {serviceCards.map((service) => (
            <a href={service.href} class="group grid gap-4 border-b border-[var(--koa-line)] py-7 sm:grid-cols-[3rem_1fr_auto] sm:items-start">
              <span class="text-xs font-black tracking-[0.15em] text-[var(--koa-clay)]">{service.number}</span>
              <div><h3 class="display text-3xl">{service.title}</h3><p class="mt-2 max-w-xl text-sm leading-6 text-[var(--koa-ink)]/68">{service.copy}</p></div>
              <span class="mt-1 text-xl transition group-hover:translate-x-1" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[var(--koa-forest)] py-24 text-white lg:py-32">
      <div class="container-shell grid items-center gap-12 lg:grid-cols-[1.1fr_.9fr] lg:gap-20">
        <div class="relative min-h-[38rem] overflow-hidden rounded-[2rem] shadow-2xl"><img src={wide} alt="Celebration setting at Koa's Events" loading="lazy" class="absolute inset-0 h-full w-full object-cover" /></div>
        <div>
          <p class="eyebrow text-white/55">The venue</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Private, lush, and designed to flex.</h2>
          <p class="mt-7 text-base leading-7 text-white/78">Koa’s Events is set on four tropical acres in Mountain View with an open-air pavilion, guest-preparation spaces and room to shape the day around your priorities rather than a ballroom formula.</p>
          <div class="mt-9 grid grid-cols-3 gap-px overflow-hidden rounded-2xl bg-white/15">
            <div class="bg-white/5 p-5"><strong class="display block text-3xl">4</strong><span class="mt-1 block text-[.66rem] uppercase tracking-[.12em] text-white/55">tropical acres</span></div>
            <div class="bg-white/5 p-5"><strong class="display block text-3xl">1,500</strong><span class="mt-1 block text-[.66rem] uppercase tracking-[.12em] text-white/55">sq. ft. pavilion</span></div>
            <div class="bg-white/5 p-5"><strong class="display block text-3xl">{businessRules.venue.maximumOccupancy.value}</strong><span class="mt-1 block text-[.66rem] uppercase tracking-[.12em] text-white/55">guest maximum</span></div>
          </div>
          <div class="mt-9 flex flex-wrap gap-5"><a href="/venue/" class="link-arrow text-white">Explore the venue →</a><a href="/venue/packages/" class="link-arrow text-white">Wedding packages →</a></div>
        </div>
      </div>
    </section>

    <section id="celebrations" class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32">
      <div class="container-shell">
        <div class="max-w-3xl"><p class="eyebrow text-[var(--koa-clay)]">Celebrations</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Built around the reason you’re gathering.</h2></div>
        <div class="mt-14 grid gap-5 lg:grid-cols-3">
          {celebrations.map((item, index) => (
            <a href={item.href} class="card-lift flex min-h-[22rem] flex-col rounded-[1.6rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-7">
              <span class="eyebrow text-[var(--koa-clay)]">0{index + 1}</span><h3 class="display mt-16 text-4xl">{item.title}</h3><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/68">{item.text}</p><span class="link-arrow mt-auto pt-7">Explore →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 lg:py-32">
      <div class="container-shell grid items-center gap-14 lg:grid-cols-2 lg:gap-24">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Koa’s Mobile Bar</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The Koa’s experience, wherever the party is.</h2>
          <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/70">{businessRules.mobileBar.model.value}</p>
          <div class="mt-8 grid gap-3 text-sm text-[var(--koa-ink)]/68">
            <p><strong class="text-[var(--koa-ink)]">Bartender labor:</strong> included within standard package assumptions.</p>
            <p><strong class="text-[var(--koa-ink)]">Gratuity:</strong> optional.</p>
            <p><strong class="text-[var(--koa-ink)]">Tip jar:</strong> not used by default.</p>
            <p><strong class="text-[var(--koa-ink)]">Larger/complex events:</strong> custom staffing quoted to protect service quality.</p>
          </div>
          <div class="mt-9 flex flex-wrap gap-5"><a href="/mobile-bar/" class="link-arrow">Explore Mobile Bar →</a><a href="/mobile-bar/faq/" class="link-arrow">Read the FAQ →</a></div>
        </div>
        <div class="relative min-h-[38rem] overflow-hidden rounded-[2rem] bg-[var(--koa-ink)]"><img src={portrait} alt="Koa's event hospitality" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-90" /><div class="absolute inset-x-5 bottom-5 rounded-2xl border border-white/20 bg-black/30 p-5 text-white backdrop-blur"><p class="eyebrow text-white/55">Across Hawaiʻi Island</p><p class="display mt-2 text-3xl">Bar service that looks intentional and works hard.</p></div></div>
      </div>
    </section>

    <section class="bg-[var(--koa-ink)] py-24 text-white lg:py-32">
      <div class="container-shell grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:gap-24">
        <p class="eyebrow text-white/45">What couples remember</p>
        <blockquote class="display text-4xl leading-[1.13] sm:text-5xl">“Our wedding was absolutely magical at this venue. The staff’s attention to detail and beautiful setting made our day unforgettable.”<footer class="mt-7 font-sans text-sm font-bold uppercase tracking-[.12em] text-white/55">Cristina & Remo</footer></blockquote>
      </div>
    </section>

    <section id="gallery" class="py-24 lg:py-32">
      <div class="container-shell">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow text-[var(--koa-clay)]">A sense of place</p><h2 class="display mt-4 text-5xl sm:text-6xl">Made for memories.</h2></div><a href="/inquire/" class="link-arrow text-[var(--koa-forest)]">Check availability →</a></div>
        <div class="mt-10 grid auto-rows-[18rem] gap-4 md:grid-cols-12">
          <img src={hero} alt="Koa's Events outdoor venue" loading="lazy" class="h-full w-full rounded-[1.5rem] object-cover md:col-span-7 md:row-span-2" />
          <img src={portrait} alt="Event detail at Koa's Events" loading="lazy" class="h-full w-full rounded-[1.5rem] object-cover md:col-span-5" />
          <img src={wide} alt="Koa's Events celebration" loading="lazy" class="h-full w-full rounded-[1.5rem] object-cover md:col-span-5" />
        </div>
      </div>
    </section>

    <section class="bg-[var(--koa-sand)] py-24 lg:py-32">
      <div class="container-shell grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-end lg:gap-20">
        <div><p class="eyebrow text-[var(--koa-clay)]">Start planning</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-7xl">Tell us what you’re gathering for.</h2><p class="mt-6 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">One inquiry now routes you to Venue, Mobile Bar, or both and collects the event details we need to give you a useful next step.</p></div>
        <div class="rounded-[1.6rem] bg-[var(--koa-forest)] p-7 text-white sm:p-9"><p class="eyebrow text-white/50">Koa’s Events</p><p class="display mt-5 text-4xl">Your date is the first decision.</p><a href="/inquire/" class="mt-7 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Check availability</a><div class="mt-8 border-t border-white/15 pt-6 text-sm leading-6 text-white/65">Venue in Mountain View · Mobile bar throughout Hawaiʻi Island · 844-808-KOAS</div></div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
