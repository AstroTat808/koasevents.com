---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const hero = 'https://static.wixstatic.com/media/02b2df_dbe1e4c043e0401590406df45a251117~mv2.jpg/v1/fill/w_980%2Ch_735%2Cal_c%2Cq_85%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/02b2df_dbe1e4c043e0401590406df45a251117~mv2.jpg';
const portrait = 'https://static.wixstatic.com/media/02b2df_aba14915428b45348a220f7ab88f3d2a~mv2.jpg/v1/fill/w_433%2Ch_582%2Cal_c%2Cq_80%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/02b2df_aba14915428b45348a220f7ab88f3d2a~mv2.jpg';
const wide = 'https://static.wixstatic.com/media/02b2df_ef974bce03ba4e3d8e142a172d0acec0~mv2.jpg/v1/fill/w_1024%2Ch_683%2Cal_c%2Cq_85%2Cenc_avif%2Cquality_auto/02b2df_ef974bce03ba4e3d8e142a172d0acec0~mv2.jpg';

const serviceCards = [
  {
    number: '01',
    title: 'Host at Koa’s',
    copy: 'A private, nature-forward venue in Mountain View for intimate weddings, celebrations, retreats and gatherings.',
    href: '#venue',
  },
  {
    number: '02',
    title: 'Bring Koa’s to you',
    copy: 'Polished mobile bar service for weddings and events across Hawaiʻi Island—with planning support built in.',
    href: '#mobile-bar',
  },
  {
    number: '03',
    title: 'Build it your way',
    copy: 'Combine venue, bar, rentals and production support into an event experience shaped around your priorities.',
    href: '#start-planning',
  },
];

const celebrations = [
  { title: 'Weddings', text: 'Intimate, destination and micro-weddings that feel personal—not processed.' },
  { title: 'Private Events', text: 'Birthdays, showers, graduations, retreats and milestone gatherings with room to make them your own.' },
  { title: 'Corporate', text: 'Team gatherings, client events and retreats supported by practical production know-how.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name: "Koa's Events",
  url: 'https://www.koasevents.com/',
  email: 'aloha@koasevents.com',
  telephone: '+1-844-808-5627',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '11-3334 Hibiscus St',
    addressLocality: 'Mountain View',
    addressRegion: 'HI',
    postalCode: '96771',
    addressCountry: 'US',
  },
};
---
<BaseLayout
  title="Koa’s Events | Big Island Event Venue & Mobile Bar"
  description="Host an intimate celebration at Koa’s Events in Mountain View, Hawaiʻi, or bring Koa’s Mobile Bar to your event anywhere on the Big Island."
  canonical="https://www.koasevents.com/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main>
    <section class="relative min-h-[92svh] overflow-hidden bg-[var(--koa-ink)] text-white">
      <img src={hero} alt="Koa's Events venue in Mountain View, Hawaiʻi" class="absolute inset-0 h-full w-full object-cover opacity-70" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(12,25,20,.84)_0%,rgba(12,25,20,.48)_52%,rgba(12,25,20,.12)_100%)]"></div>
      <Header />
      <div class="container-shell relative z-10 flex min-h-[92svh] items-end pb-16 pt-40 lg:pb-20">
        <div class="max-w-4xl">
          <p class="eyebrow mb-6 text-white/72">Private rainforest venue · Mobile bar · Hawaiʻi Island</p>
          <h1 class="display max-w-4xl text-6xl leading-[.92] sm:text-7xl lg:text-[6.7rem]">Big Island celebrations, beautifully hosted.</h1>
          <p class="mt-7 max-w-2xl text-base leading-7 text-white/82 sm:text-lg">
            Gather at our intimate Mountain View venue or bring the Koa’s experience to you with polished mobile bar service across Hawaiʻi Island.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#start-planning" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[0.12em] text-[var(--koa-ink)] transition hover:bg-[var(--koa-sand)]">Check your date</a>
            <a href="#venue" class="rounded-full border border-white/55 px-6 py-3.5 text-xs font-black uppercase tracking-[0.12em] text-white transition hover:bg-white/10">Explore the venue</a>
          </div>
        </div>
      </div>
      <div class="absolute bottom-0 right-0 z-10 hidden border-l border-t border-white/20 bg-[rgba(16,34,27,.58)] px-8 py-6 backdrop-blur md:block">
        <p class="eyebrow text-white/50">Mountain View, Hawaiʻi</p>
        <p class="mt-2 max-w-xs text-sm leading-6 text-white/80">Four lush acres, an open-air pavilion, and an intentionally intimate point of view.</p>
      </div>
    </section>

    <section class="border-b border-[var(--koa-line)] bg-[var(--koa-sand)] py-5">
      <div class="container-shell flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-[0.69rem] font-black uppercase tracking-[0.15em] text-[var(--koa-ink)]/65">
        <span>Nature-forward venue</span><span>Weddings</span><span>Private celebrations</span><span>Corporate gatherings</span><span>Island-wide mobile bar</span>
      </div>
    </section>

    <section class="py-24 lg:py-32">
      <div class="container-shell grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:gap-20">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">One brand. Two ways to gather.</p>
          <h2 class="display mt-5 text-5xl leading-[1.02] sm:text-6xl">A calmer way to host something meaningful.</h2>
        </div>
        <div class="grid border-t border-[var(--koa-line)]">
          {serviceCards.map((service) => (
            <a href={service.href} class="group grid gap-4 border-b border-[var(--koa-line)] py-7 sm:grid-cols-[3rem_1fr_auto] sm:items-start">
              <span class="text-xs font-black tracking-[0.15em] text-[var(--koa-clay)]">{service.number}</span>
              <div>
                <h3 class="display text-3xl">{service.title}</h3>
                <p class="mt-2 max-w-xl text-sm leading-6 text-[var(--koa-ink)]/68">{service.copy}</p>
              </div>
              <span class="mt-1 text-xl transition group-hover:translate-x-1" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="venue" class="bg-[var(--koa-forest)] py-24 text-white lg:py-32">
      <div class="container-shell grid items-center gap-12 lg:grid-cols-[1.1fr_.9fr] lg:gap-20">
        <div class="relative min-h-[38rem] overflow-hidden rounded-[2rem] shadow-2xl">
          <img src={wide} alt="Celebration setting at Koa's Events" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        </div>
        <div>
          <p class="eyebrow text-white/55">The venue</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Private, lush, and intentionally intimate.</h2>
          <p class="mt-7 text-base leading-7 text-white/78">Koa’s Events is set on four tropical acres in Mountain View, with an open-air pavilion and the flexibility to shape a wedding, private celebration or retreat around the people who matter most.</p>
          <div class="mt-9 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-white/15">
            <div class="bg-white/5 p-5"><strong class="display block text-3xl">4</strong><span class="mt-1 block text-xs uppercase tracking-[.12em] text-white/55">tropical acres</span></div>
            <div class="bg-white/5 p-5"><strong class="display block text-3xl">1,500</strong><span class="mt-1 block text-xs uppercase tracking-[.12em] text-white/55">sq. ft. pavilion</span></div>
          </div>
          <a href="#celebrations" class="link-arrow mt-9 text-white">See ways to celebrate <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section id="celebrations" class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32">
      <div class="container-shell">
        <div class="max-w-3xl">
          <p class="eyebrow text-[var(--koa-clay)]">Celebrations</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Built around the reason you’re gathering.</h2>
        </div>
        <div class="mt-14 grid gap-5 lg:grid-cols-3">
          {celebrations.map((item, index) => (
            <article class="min-h-[22rem] rounded-[1.6rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-7 shadow-[var(--shadow-soft)]">
              <span class="eyebrow text-[var(--koa-clay)]">0{index + 1}</span>
              <h3 class="display mt-20 text-4xl">{item.title}</h3>
              <p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/68">{item.text}</p>
              <a href="#start-planning" class="link-arrow mt-7">Start here <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="mobile-bar" class="py-24 lg:py-32">
      <div class="container-shell grid items-center gap-14 lg:grid-cols-2 lg:gap-24">
        <div class="order-2 lg:order-1">
          <p class="eyebrow text-[var(--koa-clay)]">Koa’s Mobile Bar</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The Koa’s experience, wherever the party is.</h2>
          <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/70">A dry-bar service designed for weddings and events across the Big Island. You provide the alcohol; Koa’s provides professional bartending, bar setup, service planning, tools and the details that keep the bar running smoothly.</p>
          <div class="mt-8 flex flex-wrap gap-2 text-xs font-bold uppercase tracking-[.08em] text-[var(--koa-forest)]">
            <span class="rounded-full border border-[var(--koa-line)] px-4 py-2">Beer + wine</span>
            <span class="rounded-full border border-[var(--koa-line)] px-4 py-2">Signature cocktails</span>
            <span class="rounded-full border border-[var(--koa-line)] px-4 py-2">Full bar</span>
            <span class="rounded-full border border-[var(--koa-line)] px-4 py-2">Zero-proof</span>
          </div>
          <a href="#start-planning" class="link-arrow mt-9">Plan your bar <span aria-hidden="true">→</span></a>
        </div>
        <div class="relative order-1 min-h-[38rem] overflow-hidden rounded-[2rem] bg-[var(--koa-ink)] lg:order-2">
          <img src={portrait} alt="Koa's event hospitality" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-90" />
          <div class="absolute inset-x-5 bottom-5 rounded-2xl border border-white/20 bg-black/30 p-5 text-white backdrop-blur">
            <p class="eyebrow text-white/55">Across Hawaiʻi Island</p>
            <p class="display mt-2 text-3xl">Bar service that looks intentional and works hard.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[var(--koa-ink)] py-24 text-white lg:py-32">
      <div class="container-shell grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:gap-24">
        <p class="eyebrow text-white/45">What couples remember</p>
        <blockquote class="display text-4xl leading-[1.13] sm:text-5xl">“Our wedding was absolutely magical at this venue. The staff’s attention to detail and beautiful setting made our day unforgettable.”<footer class="mt-7 font-sans text-sm font-bold uppercase tracking-[.12em] text-white/55">Cristina & Remo</footer></blockquote>
      </div>
    </section>

    <section id="gallery" class="py-24 lg:py-32">
      <div class="container-shell">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div><p class="eyebrow text-[var(--koa-clay)]">A sense of place</p><h2 class="display mt-4 text-5xl sm:text-6xl">Made for memories.</h2></div>
          <p class="max-w-md text-sm leading-6 text-[var(--koa-ink)]/60">This first build is temporarily using select photography from the Wix site. Original assets will be migrated and optimized before launch.</p>
        </div>
        <div class="mt-10 grid auto-rows-[18rem] gap-4 md:grid-cols-12">
          <img src={hero} alt="Koa's Events outdoor venue" loading="lazy" class="h-full w-full rounded-[1.5rem] object-cover md:col-span-7 md:row-span-2" />
          <img src={portrait} alt="Event detail at Koa's Events" loading="lazy" class="h-full w-full rounded-[1.5rem] object-cover md:col-span-5" />
          <img src={wide} alt="Koa's Events celebration" loading="lazy" class="h-full w-full rounded-[1.5rem] object-cover md:col-span-5" />
        </div>
      </div>
    </section>

    <section id="start-planning" class="bg-[var(--koa-sand)] py-24 lg:py-32">
      <div class="container-shell grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-end lg:gap-20">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Start planning</p>
          <h2 class="display mt-5 text-5xl leading-[1] sm:text-7xl">Tell us what you’re gathering for.</h2>
          <p class="mt-6 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">The full inquiry flow is the next build. For this homepage preview, reach us directly and we’ll keep the production Wix form untouched.</p>
        </div>
        <div class="rounded-[1.6rem] bg-[var(--koa-forest)] p-7 text-white sm:p-9">
          <p class="eyebrow text-white/50">Koa’s Events</p>
          <a href="mailto:aloha@koasevents.com" class="display mt-5 block text-3xl hover:underline sm:text-4xl">aloha@koasevents.com</a>
          <a href="tel:+18448085627" class="mt-3 block text-lg text-white/80 hover:text-white">844-808-KOAS</a>
          <div class="mt-8 border-t border-white/15 pt-6 text-sm leading-6 text-white/65">Venue in Mountain View, Hawaiʻi · Mobile bar service throughout the Big Island.</div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
