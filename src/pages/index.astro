---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { businessRules } from '../data/businessRules';
import { media, koaMarketingMedia } from '../data/media';

const homepageLookbook = [koaMarketingMedia.pavilionSunsetWide, koaMarketingMedia.ceremonySetupTropical, koaMarketingMedia.receptionRustBlue, koaMarketingMedia.audioGuestbook, koaMarketingMedia.mirrorPhotoBooth];

const celebrations = [
  { title: 'Weddings', copy: 'A private Hawaiʻi Island setting with room to make the day feel personal.', href: '/weddings/', image: koaMarketingMedia.ceremonyLiveSunset },
  { title: 'Private Events', copy: 'Milestones, showers, reunions and gatherings with a more intimate sense of place.', href: '/private-events/', image: koaMarketingMedia.tropicalDinnerTable },
  { title: 'Corporate', copy: 'Retreats, client events and team gatherings with hospitality and operational clarity.', href: '/corporate-events/', image: koaMarketingMedia.pavilionDaywide },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name: "Koa's Events",
  url: 'https://www.koasevents.com/',
  email: businessRules.contact.email,
  telephone: businessRules.contact.phone,
  maximumAttendeeCapacity: businessRules.venue.maximumOccupancy.value,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '11-3334 Hibiscus St',
    addressLocality: 'Mountain View',
    addressRegion: 'HI',
    postalCode: '96771',
    addressCountry: 'US',
  },
};
---
<BaseLayout title="Koa’s Events | Big Island Event Venue & Mobile Bar" description="Host a wedding or event for up to 100 guests at Koa’s Events in Mountain View, Hawaiʻi, or bring Koa’s Mobile Bar anywhere on the Big Island." canonical="https://www.koasevents.com/">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
  <section class="relative min-h-[90svh] overflow-hidden bg-[var(--koa-ink)] text-white md:min-h-[96svh]">
    <ResponsiveImage {...koaMarketingMedia.pavilionSunsetWide} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority />
    <div class="hero-shade absolute inset-0"></div>
    <Header />
    <div class="container-shell relative z-10 flex min-h-[90svh] items-end pb-14 pt-32 md:min-h-[96svh] md:pt-40 lg:pb-24">
      <div class="max-w-5xl">
        <p class="eyebrow text-white/65">A private rainforest wedding venue on Hawaiʻi Island</p>
        <h1 class="display mt-6 max-w-5xl text-6xl leading-[.9] sm:text-7xl lg:text-[7.2rem]">Big Island celebrations, beautifully hosted.</h1>
        <p class="mt-7 max-w-2xl text-base leading-7 text-white/78 sm:text-lg">Gather at our private Mountain View venue for up to {businessRules.venue.maximumOccupancy.value} guests, bring Koa’s Mobile Bar to your location, or combine both into one seamless event experience.</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/signature-wedding/" class="rounded-full bg-[var(--koa-ivory)] px-6 py-3.5 text-xs font-black uppercase tracking-[.13em] text-[var(--koa-ink)]">Explore Signature Wedding</a><a href="/wedding-inquiry/" class="link-arrow px-2 py-3.5 text-white">Check your date →</a>
        </div>
      </div>
    </div>
    <div class="hero-detail-card absolute bottom-6 right-6 z-10 hidden max-w-sm rounded-[1.2rem] px-7 py-6 md:block">
      <p class="eyebrow text-[var(--koa-clay)]">Mountain View, Hawaiʻi</p>
      <p class="mt-2 max-w-xs text-sm leading-6 text-[var(--koa-ink)]/68">Four tropical acres · 1,500 sq. ft. pavilion · Up to {businessRules.venue.maximumOccupancy.value} guests.</p>
    </div>
  </section>

  <section class="bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.78fr_1.22fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">The flagship experience</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A wedding weekend designed around what you want to feel—not what you need to rent.</h2><p class="mt-6 text-sm leading-7 text-[var(--koa-ink)]/62">The Koa’s Signature Wedding Experience brings together the private property, ceremony and reception foundation, Mobile Bar, guest-facing details and coordination support.</p><p class="mt-4 text-xs font-black uppercase tracking-[.14em] text-[var(--koa-forest)]">Starting at $20,000</p><a href="/signature-wedding/" class="mt-8 inline-flex rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Explore Signature Wedding</a></div><div class="relative h-[24rem] overflow-hidden rounded-[1.6rem] sm:h-[30rem] lg:h-[36rem] lg:rounded-[2rem]"><ResponsiveImage {...koaMarketingMedia.pavilionStairsRomantic} width={1200} height={1100} sizes="(min-width:1024px) 52vw,100vw" class="absolute inset-0 h-full w-full object-cover"/></div></div></section>
<section class="relative overflow-hidden py-24 lg:py-36">
    <div class="container-shell grid gap-14 lg:grid-cols-[.92fr_1.08fr] lg:items-center lg:gap-24">
      <div class="relative h-[29rem] sm:h-[34rem] lg:h-[38rem]">
        <div class="absolute left-0 top-0 h-[24rem] w-[74%] overflow-hidden rounded-[1.5rem] sm:h-[28rem] lg:h-[32rem] lg:w-[72%] lg:rounded-[1.8rem]">
          <ResponsiveImage {...koaMarketingMedia.pavilionDayLush} width={1100} height={1350} sizes="(min-width:1024px) 38vw, 75vw" class="h-full w-full object-cover" />
        </div>
        <div class="absolute bottom-0 right-0 h-[17rem] w-[54%] overflow-hidden rounded-[1.25rem] border-[7px] border-[var(--koa-ivory)] shadow-2xl sm:h-[21rem] lg:h-[24rem] lg:w-[52%] lg:border-[10px]">
          <ResponsiveImage {...koaMarketingMedia.tropicalDinnerTable} width={700} height={900} sizes="(min-width:1024px) 24vw, 50vw" class="h-full w-full object-cover" />
        </div>
        <div class="absolute bottom-10 left-8 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-[.65rem] font-black uppercase tracking-[.16em] text-white shadow-xl">Gather beautifully.</div>
      </div>
      <div>
        <p class="eyebrow text-[var(--koa-clay)]">The Koa’s way</p>
        <h2 class="display mt-5 text-5xl leading-[.98] sm:text-6xl">Warm hospitality, island character, and fewer moving pieces for you.</h2>
        <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">Koa’s is built around a simple idea: the most memorable events feel personal, not processed. The venue is intentionally flexible—a blank canvas that can move from tropical and organic to romantic whites, saturated color, black-tie polish or an entirely different design direction. Many celebrations are transformed by planners, florists, rental partners and creative teams; your proposal defines exactly what Koa’s provides.</p>
        <div class="mt-9 grid gap-5 border-t border-[var(--koa-line)] pt-7 sm:grid-cols-3">
          <div><strong class="display block text-4xl">4</strong><span class="mt-1 block text-[.62rem] font-bold uppercase tracking-[.14em] text-[var(--koa-clay)]">tropical acres</span></div>
          <div><strong class="display block text-4xl">100</strong><span class="mt-1 block text-[.62rem] font-bold uppercase tracking-[.14em] text-[var(--koa-clay)]">guest maximum</span></div>
          <div><strong class="display block text-4xl">2</strong><span class="mt-1 block text-[.62rem] font-bold uppercase tracking-[.14em] text-[var(--koa-clay)]">ways to gather</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="koa-grain bg-[var(--koa-ivory)] py-24 lg:py-32">
    <div class="container-shell grid gap-12 lg:grid-cols-[.78fr_1.22fr] lg:items-center lg:gap-24">
      <div>
        <p class="eyebrow text-[var(--koa-clay)]">Make it unmistakably yours</p>
        <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A blank canvas, styled your way.</h2>
        <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">Koa’s gives you the setting, privacy and flexibility to build the atmosphere that fits your event. Bring your planner, florist and design team, choose from Koa’s rental catalog where it helps, or combine both approaches.</p>
        <p class="mt-5 max-w-xl text-sm leading-7 text-[var(--koa-ink)]/58">One celebration may lean tropical and organic; another may be candlelit, modern, romantic or bold. The property is designed to support different palettes, themes and priorities rather than forcing every event into one house style.</p>
        <a href="/gallery/" class="link-arrow mt-8 text-[var(--koa-forest)]">See styled inspiration →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="relative min-h-[25rem] overflow-hidden rounded-[1.6rem] sm:row-span-2 sm:min-h-[34rem]"><ResponsiveImage {...koaMarketingMedia.ceremonySetupTropical} width={1000} height={1200} sizes="(min-width:1024px) 34vw, 100vw" class="absolute inset-0 h-full w-full object-cover"/></div>
        <div class="relative min-h-[16rem] overflow-hidden rounded-[1.4rem]"><ResponsiveImage {...koaMarketingMedia.receptionRustBlue} width={700} height={520} sizes="(min-width:1024px) 22vw, 50vw" class="absolute inset-0 h-full w-full object-cover"/></div>
        <div class="relative min-h-[16rem] overflow-hidden rounded-[1.4rem]"><ResponsiveImage {...koaMarketingMedia.sweetheartRustBlue} width={700} height={520} sizes="(min-width:1024px) 22vw, 50vw" class="absolute inset-0 h-full w-full object-cover"/></div>
      </div>
    </div>
    <div class="container-shell mt-8"><p class="max-w-4xl text-[.7rem] leading-5 text-[var(--koa-ink)]/48">Styling shown varies by event and may include client- or vendor-provided décor, florals, furnishings and table settings, as well as optional Koa’s rentals. Package pages define what is included with each booking.</p></div>
  </section>

  <section class="bg-[var(--koa-forest)] py-24 text-white lg:py-32">
    <div class="container-shell">
      <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
        <div><p class="eyebrow text-[var(--koa-amber-light)]">Choose the experience</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Host here. Bring us there. Or make it one connected plan.</h2></div>
        <p class="max-w-xl text-sm leading-7 text-white/62 lg:justify-self-end">You do not have to fit your event into one rigid format. Start with the setting, the bar, or both—and let the design, color palette, florals and guest experience become your own.</p>
      </div>
      <div class="mt-14 grid gap-4 lg:grid-cols-3">
        <a href="/venue/" class="group relative min-h-[25rem] overflow-hidden rounded-[1.6rem] border border-white/10 md:min-h-[29rem] lg:min-h-[32rem]">
          <ResponsiveImage {...koaMarketingMedia.pavilionWelcomeFront} width={900} height={1200} sizes="(min-width:1024px) 33vw, 100vw" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" />
          <div class="absolute inset-0 bg-gradient-to-t from-[rgba(6,23,18,.92)] via-[rgba(6,23,18,.12)] to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-7"><p class="eyebrow text-[var(--koa-amber-light)]">01 · The venue</p><h3 class="display mt-3 text-4xl">Host at Koa’s</h3><p class="mt-3 text-sm leading-6 text-white/68">A private Mountain View property for weddings, celebrations and gatherings.</p></div>
        </a>
        <a href="/mobile-bar/" class="group relative min-h-[32rem] overflow-hidden rounded-[1.6rem] border border-white/10">
          <ResponsiveImage {...koaMarketingMedia.mobileBarHero} width={900} height={1200} sizes="(min-width:1024px) 33vw, 100vw" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" />
          <div class="absolute inset-0 bg-gradient-to-t from-[rgba(6,23,18,.92)] via-[rgba(6,23,18,.12)] to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-7"><p class="eyebrow text-[var(--koa-amber-light)]">02 · Mobile Bar</p><h3 class="display mt-3 text-4xl">Bring Koa’s to you</h3><p class="mt-3 text-sm leading-6 text-white/68">Professional dry-bar service across Hawaiʻi Island.</p></div>
        </a>
        <a href="/inquire/?service=both" class="group relative min-h-[32rem] overflow-hidden rounded-[1.6rem] border border-white/10">
          <ResponsiveImage {...koaMarketingMedia.pavilionSunsetEvent} width={900} height={1200} sizes="(min-width:1024px) 33vw, 100vw" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" />
          <div class="absolute inset-0 bg-gradient-to-t from-[rgba(6,23,18,.92)] via-[rgba(6,23,18,.12)] to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-7"><p class="eyebrow text-[var(--koa-amber-light)]">03 · Combined</p><h3 class="display mt-3 text-4xl">Keep it connected</h3><p class="mt-3 text-sm leading-6 text-white/68">One inquiry, one shared plan, fewer loose ends.</p></div>
        </a>
      </div>
    </div>
  </section>

  <section class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32">
    <div class="container-shell">
      <div class="max-w-3xl"><p class="eyebrow text-[var(--koa-clay)]">Reasons to gather</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">One setting. Completely different possibilities.</h2></div>
      <div class="mt-14 grid gap-4 lg:grid-cols-3">
        {celebrations.map((item, index) => (
          <a href={item.href} class="group overflow-hidden rounded-[1.5rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)]">
            <div class="relative h-56 overflow-hidden sm:h-64 lg:h-72"><ResponsiveImage {...item.image} width={900} height={650} sizes="(min-width:1024px) 33vw, 100vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" /><span class="absolute left-5 top-5 rounded-full bg-[rgba(251,248,241,.9)] px-3 py-2 text-[.6rem] font-black uppercase tracking-[.14em] text-[var(--koa-forest)]">0{index+1}</span></div>
            <div class="p-7"><h3 class="display text-4xl">{item.title}</h3><p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/64">{item.copy}</p><span class="link-arrow mt-6">Explore →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="overflow-hidden py-24 lg:py-36">
    <div class="container-shell grid gap-14 lg:grid-cols-[.82fr_1.18fr] lg:items-center lg:gap-24">
      <div>
        <p class="eyebrow text-[var(--koa-clay)]">Koa’s Mobile Bar</p>
        <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Island hospitality, poured with intention.</h2>
        <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">{businessRules.mobileBar.model.value}</p>
        <div class="mt-8 grid gap-4 border-y border-[var(--koa-line)] py-6 text-sm text-[var(--koa-ink)]/66 sm:grid-cols-2">
          <p><strong class="text-[var(--koa-ink)]">Bartender labor</strong><br/>Included under standard package assumptions.</p>
          <p><strong class="text-[var(--koa-ink)]">Gratuity</strong><br/>Optional; no default tip jar.</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-5"><a href="/mobile-bar/" class="link-arrow">Explore Mobile Bar →</a><a href="/mobile-bar/faq/" class="link-arrow">Read the FAQ →</a></div>
      </div>
      <div class="relative h-[30rem] sm:h-[36rem] lg:h-[42rem]">
        <div class="absolute right-0 top-0 h-[25rem] w-[82%] overflow-hidden rounded-[1.6rem] sm:h-[30rem] lg:h-[35rem] lg:w-[78%] lg:rounded-[2rem]"><ResponsiveImage {...koaMarketingMedia.mobileBarDetail} width={1100} height={1400} sizes="(min-width:1024px) 48vw, 85vw" class="h-full w-full object-cover" /></div>
        <div class="absolute bottom-0 left-0 w-[58%] rounded-[1.4rem] bg-[var(--koa-forest)] p-7 text-white shadow-2xl"><p class="eyebrow text-[var(--koa-amber-light)]">Across Hawaiʻi Island</p><p class="display mt-3 text-3xl">Good drinks bring great people together.</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--koa-ink)] py-24 text-white lg:py-32">
    <div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:items-start lg:gap-24">
      <div><p class="eyebrow text-[var(--koa-amber-light)]">What couples remember</p><div class="luxury-rule mt-5"></div></div>
      <blockquote class="display text-4xl leading-[1.12] sm:text-5xl lg:text-6xl">“Our wedding was absolutely magical at this venue. The staff’s attention to detail and beautiful setting made our day unforgettable.”<footer class="mt-8 font-sans text-xs font-black uppercase tracking-[.15em] text-white/48">Cristina & Remo</footer></blockquote>
    </div>
  </section>

  <section id="gallery" class="py-24 lg:py-32">
    <div class="container-shell">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"><div><p class="eyebrow text-[var(--koa-clay)]">The lookbook</p><h2 class="display mt-4 text-5xl sm:text-6xl">A sense of place.</h2></div><a href="/gallery/" class="link-arrow text-[var(--koa-forest)]">Open the full gallery →</a></div>
      <div class="mt-10 grid auto-rows-[13rem] gap-3 sm:auto-rows-[15rem] md:auto-rows-[17rem] md:grid-cols-12">
        {homepageLookbook.map((image,index)=><a href="/gallery/" class:list={['group relative overflow-hidden rounded-[1.3rem]', index===0 ? 'md:col-span-7 md:row-span-2' : index===1 ? 'md:col-span-5' : index===2 ? 'md:col-span-5' : 'md:col-span-6']}><ResponsiveImage {...image} width={1200} height={900} sizes="(min-width:1024px) 55vw, 100vw" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" /></a>)}
      </div>
    </div>
  </section>

  <section class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32">
    <div class="container-shell grid gap-12 lg:grid-cols-[1.1fr_.9fr] lg:items-end lg:gap-20">
      <div><p class="eyebrow text-[var(--koa-clay)]">Start planning</p><h2 class="display mt-5 text-5xl leading-[.98] sm:text-7xl">Tell us what you’re gathering for.</h2><p class="mt-6 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">One inquiry routes you to Venue, Mobile Bar, or both and gives us enough detail to make the next conversation useful.</p></div>
      <div class="rounded-[1.6rem] bg-[var(--koa-forest)] p-8 text-white shadow-xl"><p class="eyebrow text-[var(--koa-amber-light)]">Your date is the first decision</p><p class="display mt-5 text-4xl">Let’s see whether Koa’s is the right fit.</p><a href="/inquire/" class="mt-7 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Check availability</a></div>
    </div>
  </section>
</main>
<Footer />
</BaseLayout>