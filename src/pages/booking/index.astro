---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout noindex title="Koa’s Events Booking Agreement" description="Review and sign your Koa’s Events booking agreement." canonical="https://www.koasevents.com/booking/">
  <Header overlay={false} />
  <main class="min-h-[70vh] bg-[var(--koa-sand)] py-12 lg:py-20">
    <div class="container-shell max-w-5xl">
      <div data-loading class="rounded-[1.6rem] bg-white p-8 shadow-[var(--shadow-soft)]">
        <p class="eyebrow text-[var(--koa-clay)]">Koa’s Events</p>
        <h1 class="display mt-4 text-5xl">Loading your booking agreement…</h1>
      </div>

      <div data-error class="hidden rounded-[1.6rem] bg-white p-8 shadow-[var(--shadow-soft)]">
        <p class="eyebrow text-[var(--koa-clay)]">Booking</p>
        <h1 class="display mt-4 text-5xl">This booking link is not available.</h1>
        <p data-error-copy class="mt-5 text-sm leading-6 text-[var(--koa-ink)]/62"></p>
      </div>

      <article data-booking class="hidden overflow-hidden rounded-[1.8rem] bg-white shadow-[var(--shadow-soft)]">
        <header class="bg-[var(--koa-forest)] p-7 text-white sm:p-10">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-amber-light)]">Accepted proposal → booking</p>
              <h1 class="display mt-4 text-5xl sm:text-6xl">Complete your booking.</h1>
              <p data-client-name class="mt-4 text-base text-white/72"></p>
            </div>
            <div class="rounded-2xl border border-white/14 bg-white/[.06] px-5 py-4">
              <p class="text-[.58rem] font-black uppercase tracking-[.12em] text-white/45">Booking status</p>
              <p data-status class="mt-2 text-sm font-black uppercase tracking-[.1em] text-[var(--koa-amber-light)]"></p>
              <p data-event-date class="mt-2 text-xs text-white/55"></p>
            </div>
          </div>
        </header>

        <div class="grid gap-8 p-7 sm:p-10">
          <section class="grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl bg-[var(--koa-sand)] p-5">
              <p class="eyebrow text-[var(--koa-clay)]">Proposal</p>
              <p data-proposal-id class="mt-3 font-mono text-sm font-bold text-[var(--koa-forest)]"></p>
            </div>
            <div class="rounded-2xl bg-[var(--koa-sand)] p-5">
              <p class="eyebrow text-[var(--koa-clay)]">Final proposal total</p>
              <p data-total class="display mt-2 text-3xl text-[var(--koa-forest)]"></p>
            </div>
            <div class="rounded-2xl bg-[var(--koa-sand)] p-5">
              <p class="eyebrow text-[var(--koa-clay)]">Agreement</p>
              <p data-contract-status class="mt-3 text-sm font-bold text-[var(--koa-forest)]"></p>
            </div>
          </section>

          <section>
            <p class="eyebrow text-[var(--koa-clay)]">Booking agreement</p>
            <h2 data-contract-title class="display mt-3 text-4xl"></h2>
            <div data-contract-sections class="mt-6 grid gap-4"></div>
          </section>

          <section data-sign-section class="rounded-[1.4rem] border border-[var(--koa-forest)]/20 bg-[var(--koa-ivory)] p-6">
            <p class="eyebrow text-[var(--koa-clay)]">Electronic signature</p>
            <h2 class="display mt-3 text-4xl">Sign securely with SignWell.</h2>
            <p class="mt-4 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/62">Koa’s uses SignWell for the formal agreement signature and audit trail. Your completed agreement is automatically stored with your Koa’s client record.</p>
            <form data-sign-form class="mt-6">
              <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Open SignWell agreement</button>
              <p data-sign-message class="mt-3 text-sm text-[var(--koa-ink)]/58"></p>
            </form>
          </section>

          <section data-signed-section class="hidden rounded-[1.4rem] bg-[var(--koa-forest)] p-6 text-white">
            <p class="eyebrow text-[var(--koa-amber-light)]">Agreement signatures</p>
            <h2 class="display mt-3 text-4xl">Your signature is recorded.</h2>
            <p data-signature-copy class="mt-3 text-sm leading-6 text-white/70"></p>
            <div class="mt-4 rounded-xl border border-white/12 bg-white/[.06] p-4">
              <p class="text-[.58rem] font-black uppercase tracking-[.11em] text-[var(--koa-amber-light)]">Koa’s countersignature</p>
              <p data-koa-signature-copy class="mt-2 text-sm leading-6 text-white/68"></p>
            </div>
          </section>

          <section>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Payment schedule</p>
                <h2 class="display mt-3 text-4xl">Booking payments</h2>
              </div>
              <p class="max-w-md text-xs leading-5 text-[var(--koa-ink)]/48">Your event becomes booked when the signed agreement and QuickBooks reservation-deposit invoice are complete. Later QuickBooks invoice milestones remain visible here.</p>
            </div>
            <div data-payments class="mt-6 grid gap-3"></div>
            <div data-payment-note class="mt-4 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-sm leading-6 text-[var(--koa-ink)]/62"></div>
          </section>

          <section data-booked class="hidden rounded-[1.4rem] bg-[var(--koa-ink)] p-6 text-white">
            <p class="eyebrow text-[var(--koa-amber-light)]">Booked</p>
            <h2 class="display mt-3 text-4xl">Your event is reserved.</h2>
            <p class="mt-3 text-sm leading-6 text-white/70">Koa’s has the signed agreement and reservation deposit on file. Continue using this page to review QuickBooks payment milestones, and use your Planning Portal for guest count, vendors, questionnaire answers, insurance and floor plans.</p>
            <a data-planning-link class="mt-5 inline-flex rounded-full bg-white px-5 py-3 text-[.62rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Open planning portal</a>
          </section>
        </div>
      </article>
    </div>
  </main>
  <Footer />

  <script>
    const loading=document.querySelector('[data-loading]');
    const error=document.querySelector('[data-error]');
    const errorCopy=document.querySelector('[data-error-copy]');
    const bookingEl=document.querySelector('[data-booking]');
    const signSection=document.querySelector('[data-sign-section]');
    const signedSection=document.querySelector('[data-signed-section]');
    const bookedSection=document.querySelector('[data-booked]');
    const signForm=document.querySelector('[data-sign-form]');
    const signMessage=document.querySelector('[data-sign-message]');
    const token=new URLSearchParams(window.location.search).get('token')||'';

    function money(value){return new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(Number(value||0));}
    function dateLabel(value){if(!value)return 'Date to be confirmed'; return new Intl.DateTimeFormat('en-US',{dateStyle:'long'}).format(new Date(value.length===10?value+'T12:00:00':value));}
    function text(selector,value){const el=document.querySelector(selector);if(el)el.textContent=value;}

    function render(data){
      loading?.classList.add('hidden'); bookingEl?.classList.remove('hidden');
      text('[data-client-name]',data.customerName?'Prepared for '+data.customerName:'Your booking agreement');
      text('[data-status]',String(data.status||'booking').replaceAll('_',' '));
      text('[data-event-date]',data.eventDate?'Event: '+dateLabel(data.eventDate):'Event date TBD');
      text('[data-proposal-id]',data.proposalId||'');
      text('[data-total]',money(data.proposalTotal));
      text('[data-contract-title]',data.contract?.title||'Koa’s Events Venue & Services Agreement');
      text('[data-contract-status]',data.contract?.status==='signed'?'Signed':'Awaiting SignWell signature');

      const sections=document.querySelector('[data-contract-sections]'); sections.innerHTML='';
      (data.contract?.sections||[]).forEach((section)=>{
        const box=document.createElement('div'); box.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5';
        const h=document.createElement('h3'); h.className='font-bold text-[var(--koa-forest)]'; h.textContent=section.heading;
        const p=document.createElement('p'); p.className='mt-2 text-sm leading-6 text-[var(--koa-ink)]/65'; p.textContent=section.body;
        box.append(h,p); sections.appendChild(box);
      });

      const signed=data.contract?.status==='signed';
      signSection?.classList.toggle('hidden',signed);
      signedSection?.classList.toggle('hidden',!signed);
      if(signed){
        const sig=data.contract.signature||{};
        const koaSig=data.contract.koaSignature||{};
        text('[data-signature-copy]',(sig.name?'Signed by '+sig.name:'Signed')+(sig.signedAt?' on '+new Date(sig.signedAt).toLocaleString():'')+'.');
        text('[data-koa-signature-copy]',koaSig.name
          ? 'Countersigned by '+koaSig.name+(koaSig.signedAt?' on '+new Date(koaSig.signedAt).toLocaleString():'')+'.'
          : 'Awaiting Koa’s authorized countersignature.');
      }

      const payments=document.querySelector('[data-payments]'); payments.innerHTML='';
      (data.payments||[]).forEach((item)=>{
        const row=document.createElement('div');
        row.className='grid gap-3 rounded-xl border border-[var(--koa-line)] bg-white p-4 sm:grid-cols-[1fr_auto] sm:items-center';
        const left=document.createElement('div');
        const title=document.createElement('strong'); title.textContent=item.label;
        const meta=document.createElement('p'); meta.className='mt-1 text-xs text-[var(--koa-ink)]/50';
        meta.textContent=(item.dueDate?'Due '+dateLabel(item.dueDate):'Due date confirmed by Koa’s')+' · '+money(item.amount);
        left.append(title,meta);

        if(item.invoiceId){
          const invoice=document.createElement('p'); invoice.className='mt-2 text-xs text-[var(--koa-ink)]/55';
          invoice.textContent='QuickBooks invoice'+(item.docNumber?' #'+item.docNumber:'')+' · '+(item.status==='paid'?'paid':money(item.balance)+' remaining');
          left.appendChild(invoice);
        }

        const right=document.createElement('div');
        const badge=document.createElement('span');
        badge.className='rounded-full '+(item.status==='paid'?'bg-[var(--koa-sand)] text-[var(--koa-forest)]':'border border-[var(--koa-line)] text-[var(--koa-clay)]')+' px-3 py-2 text-[.58rem] font-black uppercase tracking-[.1em]';
        badge.textContent=item.status==='paid'?'Paid':item.status==='open'?'Invoice issued':'Invoice not issued';
        right.appendChild(badge);
        row.append(left,right); payments.appendChild(row);
      });

      const note=document.querySelector('[data-payment-note]');
      if(note) note.textContent='Koa’s issues estimates, invoices and payment requests through QuickBooks Online. Use the payment instructions in the QuickBooks invoice email you receive; the Koa’s website does not collect payment information.';

      bookedSection?.classList.toggle('hidden',data.status!=='booked');
      const planningLink=document.querySelector('[data-planning-link]');
      if(planningLink) planningLink.href='/portal/?token='+encodeURIComponent(token);
    }

    async function load(){
      if(!token){loading?.classList.add('hidden');error?.classList.remove('hidden');if(errorCopy)errorCopy.textContent='The booking link is missing its secure token.';return;}
      const response=await fetch('/api/bookings/'+encodeURIComponent(token),{cache:'no-store'});
      const data=await response.json().catch(()=>({}));
      if(!response.ok){loading?.classList.add('hidden');error?.classList.remove('hidden');if(errorCopy)errorCopy.textContent=data.error||'This booking could not be loaded.';return;}
      render(data.booking);
    }

    signForm?.addEventListener('submit',async(event)=>{
      event.preventDefault(); if(signMessage)signMessage.textContent='Opening secure SignWell signing…';
      const response=await fetch('/api/bookings/'+encodeURIComponent(token),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'sign'})});
      const result=await response.json().catch(()=>({}));
      if(!response.ok){if(signMessage)signMessage.textContent=result.error||'The SignWell agreement could not be opened.';return;}
      if(result.signingUrl){window.location.href=result.signingUrl;return;}
      if(signMessage)signMessage.textContent='SignWell has emailed the agreement to you. Check your inbox to continue.';
    });

    load();
  </script>
</BaseLayout>
