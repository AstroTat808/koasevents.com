---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Insurance Compliance | Koa’s Events" description="Vendor insurance compliance across upcoming Koa’s events." canonical="https://koasevents.com/admin/insurance/">
<main class="min-h-screen bg-[var(--koa-sand)] py-10"><div class="container-shell max-w-7xl">
<div data-unauthorized class="hidden rounded-[1.5rem] bg-white p-8">Authorized Koa’s staff access required.</div>
<div data-app class="hidden grid gap-6">
<header class="rounded-[1.8rem] bg-[var(--koa-forest)] p-8 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Vendor Operations</p><h1 class="display mt-3 text-5xl">Insurance Compliance</h1><p class="mt-3 max-w-3xl text-sm text-white/65">One dashboard for missing, pending, approved, rejected, expiring, and expired vendor certificates—plus every upcoming event affected by a gap.</p></header>
<section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">
  <button data-filter="all" class="kpi"><span>Total</span><strong data-total>0</strong></button>
  <button data-filter="missing" class="kpi"><span>Missing</span><strong data-missing>0</strong></button>
  <button data-filter="pending" class="kpi"><span>Pending</span><strong data-pending>0</strong></button>
  <button data-filter="approved" class="kpi"><span>Approved</span><strong data-approved>0</strong></button>
  <button data-filter="rejected" class="kpi"><span>Rejected</span><strong data-rejected>0</strong></button>
  <button data-filter="expiring_soon" class="kpi"><span>Expiring ≤30d</span><strong data-expiring>0</strong></button>
  <button data-filter="expired" class="kpi"><span>Expired</span><strong data-expired>0</strong></button>
</section>
<section class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]"><div class="flex flex-wrap gap-3"><input data-search class="field flex-1" placeholder="Search vendor, category, client, or event date…"><button data-filter-affected class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.08em]">Affected events only</button></div></section>
<section data-rows class="grid gap-4"></section>
</div></div></main>
<style>.field{min-height:2.8rem;border:1px solid var(--koa-line);border-radius:.7rem;background:white;padding:.7rem .8rem;font-size:.82rem}.kpi{border-radius:1rem;background:white;padding:1rem;text-align:left;box-shadow:var(--shadow-soft)}.kpi span{display:block;font-size:.58rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:var(--koa-clay)}.kpi strong{display:block;margin-top:.35rem;font-family:var(--font-display);font-size:2rem;color:var(--koa-forest)}</style>
<script>
import { getAdminSession } from '../../../lib/admin-session';
let data={summary:{},rows:[]},filter='all',affectedOnly=false;
const rowsEl=document.querySelector('[data-rows]');
function label(s){return String(s||'').replaceAll('_',' ').replace(/\b\w/g,m=>m.toUpperCase())}
function render(){const q=String(document.querySelector('[data-search]').value||'').toLowerCase();let rows=data.rows.filter(r=>filter==='all'||r.status===filter);if(affectedOnly)rows=rows.filter(r=>r.affectedUpcomingEvents.length);rows=rows.filter(r=>[r.name,r.category,r.status,...r.upcomingEvents.flatMap(e=>[e.customerName,e.eventDate,e.packageId])].join(' ').toLowerCase().includes(q));rowsEl.innerHTML='';rows.forEach(r=>{const card=document.createElement('article');card.className='rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]';card.innerHTML='<div class="flex flex-wrap items-start justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">'+label(r.status)+'</p><h2 class="display mt-2 text-3xl">'+r.name+'</h2><p class="mt-1 text-xs text-[var(--koa-ink)]/50">'+r.category+(r.expiresAt?' · expires '+r.expiresAt:'')+'</p></div><a href="/admin/vendors/" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-xs">Open Vendor CRM</a></div><div data-events class="mt-4 grid gap-2"></div>';const box=card.querySelector('[data-events]');if(!r.upcomingEvents.length)box.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No upcoming Koa’s events currently use this vendor.</p>';r.upcomingEvents.forEach(e=>{const row=document.createElement('a');row.href='/admin/events/?record='+encodeURIComponent(e.recordId);row.className='rounded-xl border p-3 '+(e.covered?'border-emerald-200 bg-emerald-50':'border-red-200 bg-red-50');row.innerHTML='<strong class="text-sm">'+e.customerName+'</strong><span class="ml-2 text-xs">'+e.eventDate+'</span><span class="mt-1 block text-xs">'+(e.covered?'Covered':'Needs attention · '+label(e.issue))+'</span>';box.appendChild(row)});rowsEl.appendChild(card)});if(!rows.length)rowsEl.innerHTML='<p class="rounded-xl bg-white p-5 text-sm text-[var(--koa-ink)]/50">No vendors match this view.</p>'}
async function load(){const u=await getAdminSession();if(!u){document.querySelector('[data-unauthorized]').classList.remove('hidden');return}document.querySelector('[data-app]').classList.remove('hidden');const r=await fetch('/api/admin/vendor-insurance-compliance',{cache:'no-store'});data=await r.json();document.querySelector('[data-total]').textContent=data.summary.total||0;document.querySelector('[data-missing]').textContent=data.summary.missing||0;document.querySelector('[data-pending]').textContent=data.summary.pending||0;document.querySelector('[data-approved]').textContent=data.summary.approved||0;document.querySelector('[data-rejected]').textContent=data.summary.rejected||0;document.querySelector('[data-expiring]').textContent=data.summary.expiringSoon||0;document.querySelector('[data-expired]').textContent=data.summary.expired||0;render()}
document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;render()});document.querySelector('[data-filter-affected]').onclick=()=>{affectedOnly=!affectedOnly;document.querySelector('[data-filter-affected]').textContent=affectedOnly?'Showing affected only':'Affected events only';render()};document.querySelector('[data-search]').oninput=render;load();
</script>
</BaseLayout>