---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { galleryMedia, koaMarketingGallery } from '../../../data/media';
import { mediaUsageBySrc } from '../../../data/mediaUsage';

const curated = [
  ...koaMarketingGallery.map((item) => ({ src: item.src, alt: item.alt, category: item.category })),
  ...galleryMedia.map((item) => ({ src: item.src, alt: item.alt, category: 'Legacy Archive' })),
];
const categories = ['Venue','Ceremony','Reception','Mobile Bar','Enhancements','Hospitality','Stay'];
const allCategories = [...categories, 'Legacy Archive'];
const mediaUsage = mediaUsageBySrc;
---
<BaseLayout noindex title="Gallery Admin | Koa’s Events" description="Manage Koa’s Events gallery." canonical="https://www.koasevents.com/admin/gallery/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-10 sm:py-12">
    <div class="container-shell">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin</p>
          <h1 class="display mt-3 text-5xl">Gallery workspace</h1>
          <p class="mt-4 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">
            Drag cards by their handle to change public order, edit crop framing with mobile and desktop previews, and select multiple photos for bulk category, visibility, or removal actions.
          </p>
        </div>
        
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">
        Sign in with an administrator account at <a class="underline" href="/admin/">Koa’s Admin</a>.
      </div>

      <div data-admin-ui class="hidden">
        <form data-upload-form class="grid gap-4 rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] md:grid-cols-2 sm:p-7">
          <label class="grid gap-2 text-sm font-semibold md:col-span-2">
            Photo
            <input name="file" type="file" accept="image/*" required class="rounded-xl border border-[var(--koa-line)] p-3" />
          </label>
          <label class="grid gap-2 text-sm font-semibold">
            Category
            <select name="category" class="rounded-xl border border-[var(--koa-line)] px-4 py-3">
              {categories.map((category) => <option>{category}</option>)}
            </select>
          </label>
          <label class="grid gap-2 text-sm font-semibold">
            Alt text
            <input name="alt" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
          </label>
          <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white md:col-span-2">
            Optimize & upload photo
          </button>
          <p data-upload-message class="text-sm text-[var(--koa-ink)]/58 md:col-span-2"></p>
        </form>

        <section class="mt-7 rounded-[1.4rem] border border-[var(--koa-line)] bg-white/85 p-4 shadow-sm sm:p-5" data-impact-filter-panel>
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Placement importance</p>
              <h2 class="display mt-2 text-2xl">Filter photos by website impact</h2>
              <p class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/50">High Impact surfaces heroes and major sales sections first. Unused shows photos that are not reused outside the Gallery.</p>
            </div>
            <button type="button" data-impact-filter-value="all" class="rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-[.65rem] font-black uppercase tracking-[.08em] text-white">All <span data-impact-count="all"></span></button>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" data-impact-filter-value="high" class="rounded-full border border-[var(--koa-clay)]/35 bg-[var(--koa-clay)] px-4 py-2.5 text-[.65rem] font-black uppercase tracking-[.08em] text-white">High Impact <span data-impact-count="high"></span></button>
            <button type="button" data-impact-filter-value="standard" class="rounded-full border border-[var(--koa-forest)]/25 bg-[var(--koa-forest)]/8 px-4 py-2.5 text-[.65rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Standard <span data-impact-count="standard"></span></button>
            <button type="button" data-impact-filter-value="low" class="rounded-full border border-[var(--koa-line)] bg-white px-4 py-2.5 text-[.65rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/60">Lower Impact <span data-impact-count="low"></span></button>
            <button type="button" data-impact-filter-value="unused" class="rounded-full border border-dashed border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-2.5 text-[.65rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/60">Unused <span data-impact-count="unused"></span></button>
          </div>
        </section>

        <section class="sticky top-3 z-30 mt-7 hidden rounded-[1.3rem] border border-[var(--koa-line)] bg-white/95 p-4 shadow-[var(--shadow-soft)] backdrop-blur" data-bulk-bar>
          <div class="flex flex-wrap items-center gap-3">
            <strong class="mr-auto text-sm" data-selected-count>0 photos selected</strong>
            <select data-bulk-category class="rounded-xl border border-[var(--koa-line)] bg-white px-3 py-2.5 text-sm font-semibold">
              {categories.map((category) => <option>{category}</option>)}
            </select>
            <button type="button" data-bulk-move class="rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-[.68rem] font-black uppercase tracking-[.1em] text-white">Move</button>
            <button type="button" data-bulk-hide class="rounded-full border border-[var(--koa-line)] px-4 py-2.5 text-[.68rem] font-black uppercase tracking-[.1em]">Hide</button>
            <button type="button" data-bulk-show class="rounded-full border border-[var(--koa-line)] px-4 py-2.5 text-[.68rem] font-black uppercase tracking-[.1em]">Show</button>
            <button type="button" data-bulk-delete class="rounded-full border border-red-200 px-4 py-2.5 text-[.68rem] font-black uppercase tracking-[.1em] text-red-700">Remove</button>
            <button type="button" data-clear-selection class="px-2 py-2 text-[.68rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Clear</button>
          </div>
        </section>

        <section class="mt-10 space-y-10" data-category-boards></section>
      </div>
    </div>
  </main>

  <dialog data-vendor-dialog class="m-auto w-[94vw] max-w-3xl overflow-hidden rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-0 backdrop:bg-black/60">
    <div class="border-b border-[var(--koa-line)] p-5 sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div><p class="eyebrow text-[var(--koa-clay)]">Vendor attribution</p><h2 data-vendor-title class="display mt-2 text-3xl">Assign vendors to photo</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Select every vendor whose work appears in this image. The photo will automatically appear on each selected vendor profile.</p></div>
        <button type="button" data-vendor-close class="grid size-10 place-items-center rounded-full border border-[var(--koa-line)] text-xl">×</button>
      </div>
    </div>
    <div class="p-5 sm:p-6">
      <input data-vendor-search class="w-full rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm" placeholder="Search photographer, florist, DJ, Mobile Bar…">
      <div data-vendor-options class="mt-4 grid max-h-[48vh] gap-2 overflow-auto sm:grid-cols-2"></div>
      <div class="mt-5 flex items-center gap-3"><p data-vendor-message class="mr-auto text-xs text-[var(--koa-ink)]/50"></p><button type="button" data-vendor-cancel class="rounded-full border border-[var(--koa-line)] px-5 py-2.5 text-xs font-black uppercase tracking-[.1em]">Cancel</button><button type="button" data-vendor-save class="rounded-full bg-[var(--koa-forest)] px-5 py-2.5 text-xs font-black uppercase tracking-[.1em] text-white">Save vendors</button></div>
    </div>
  </dialog>

  <dialog data-crop-dialog class="m-auto w-[94vw] max-w-5xl overflow-hidden rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-0 backdrop:bg-black/60">
    <div class="border-b border-[var(--koa-line)] p-5 sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Crop editor</p>
          <h2 class="display mt-2 text-3xl" data-crop-title>Reposition photo</h2>
          <p data-crop-mode-copy class="mt-2 text-sm text-[var(--koa-ink)]/55">Drag inside the preview. Nothing changes publicly until you press Save crop.</p>
        </div>
        <button type="button" data-crop-close class="grid size-10 shrink-0 place-items-center rounded-full border border-[var(--koa-line)] text-xl">×</button>
      </div>
    </div>

    <div class="p-5 sm:p-6">
      <div class="mb-5 flex flex-wrap gap-2">
        <button type="button" data-preview-mode="desktop" class="rounded-full bg-[var(--koa-forest)] px-4 py-2 text-xs font-black uppercase tracking-[.1em] text-white">Desktop</button>
        <button type="button" data-preview-mode="mobile" class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.1em]">Mobile</button>
      </div>

      <div class="mx-auto overflow-hidden rounded-[1.3rem] bg-[var(--koa-ink)]/5 transition-all" data-preview-shell style="max-width:760px">
        <div class="relative h-[430px] cursor-grab touch-none overflow-hidden active:cursor-grabbing" data-crop-frame>
          <img data-crop-image src="" alt="" draggable="false" class="pointer-events-none h-full w-full select-none object-cover" />
          <div data-crop-crosshair class="pointer-events-none absolute size-8 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-black/25 shadow-[0_2px_10px_rgba(0,0,0,.4)]"></div>
          <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-black/65 px-3 py-1.5 text-[.6rem] font-black uppercase tracking-[.12em] text-white">Drag focal point</span>
        </div>
      </div>

      <section data-placement-override-section class="mt-6 rounded-[1rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">High-impact placement overrides</p>
            <h3 class="display mt-2 text-2xl">Fix one hero without changing the rest</h3>
            <p class="mt-2 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/50">Choose a high-impact placement to give it its own focal point. Global crop changes will continue to control every placement without an override.</p>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2" data-placement-override-options></div>
      </section>

      <section class="mt-6 border-t border-[var(--koa-line)] pt-5" data-usage-preview-section>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Used across the website</p>
            <h3 class="display mt-2 text-2xl">Live placement previews</h3>
          </div>
          <p class="text-xs font-semibold text-[var(--koa-ink)]/45" data-usage-preview-count></p>
        </div>
        <p class="mt-2 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/50">These previews use the focal point you are adjusting now. Open a placement to inspect its full page before saving.</p>
        <div class="mt-4 grid max-h-[20rem] gap-3 overflow-auto pr-1 sm:grid-cols-2 lg:grid-cols-3" data-usage-previews></div>
      </section>

      <div data-crop-impact hidden class="mt-5 rounded-[1rem] border border-[var(--koa-clay)]/35 bg-[var(--koa-sand)] px-4 py-3">
        <div class="flex items-start gap-3">
          <span aria-hidden="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-[var(--koa-clay)] text-sm font-black text-white">!</span>
          <div>
            <strong data-crop-impact-title class="block text-sm text-[var(--koa-ink)]">This crop affects multiple website placements</strong>
            <p data-crop-impact-copy class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/58"></p>
          </div>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <p class="mr-auto text-sm font-semibold text-[var(--koa-ink)]/55" data-crop-position>50% × 50%</p>
        <button type="button" data-crop-use-global hidden class="rounded-full border border-[var(--koa-clay)]/35 bg-[var(--koa-sand)] px-5 py-2.5 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Remove override</button>
        <button type="button" data-crop-reset class="rounded-full border border-[var(--koa-line)] px-5 py-2.5 text-xs font-black uppercase tracking-[.1em]">Center</button>
        <button type="button" data-crop-cancel class="rounded-full border border-[var(--koa-line)] px-5 py-2.5 text-xs font-black uppercase tracking-[.1em]">Cancel</button>
        <button type="button" data-crop-save class="rounded-full bg-[var(--koa-forest)] px-5 py-2.5 text-xs font-black uppercase tracking-[.1em] text-white">Save crop</button>
      </div>
    </div>
  </dialog>

  <script id="curated-data" type="application/json" set:html={JSON.stringify(curated)}></script>
  <script id="categories-data" type="application/json" set:html={JSON.stringify(categories)}></script>
  <script id="all-categories-data" type="application/json" set:html={JSON.stringify(allCategories)}></script>
  <script id="media-usage-data" type="application/json" set:html={JSON.stringify(mediaUsage)}></script>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const curated = JSON.parse(document.getElementById('curated-data')?.textContent || '[]');
    const categories = JSON.parse(document.getElementById('categories-data')?.textContent || '[]');
    const allCategories = JSON.parse(document.getElementById('all-categories-data')?.textContent || '[]');
    const mediaUsage = JSON.parse(document.getElementById('media-usage-data')?.textContent || '{}');

    const ui = document.querySelector('[data-admin-ui]');
    const unauthorized = document.querySelector('[data-unauthorized]');
    const uploadForm = document.querySelector('[data-upload-form]');
    const uploadMessage = document.querySelector('[data-upload-message]');
    const boards = document.querySelector('[data-category-boards]');
    const bulkBar = document.querySelector('[data-bulk-bar]');
    const selectedCount = document.querySelector('[data-selected-count]');
    const cropDialog = document.querySelector('[data-crop-dialog]');
    const cropFrame = document.querySelector('[data-crop-frame]');
    const cropImage = document.querySelector('[data-crop-image]');
    const cropCrosshair = document.querySelector('[data-crop-crosshair]');
    const cropPosition = document.querySelector('[data-crop-position]');
    const cropTitle = document.querySelector('[data-crop-title]');
    const cropModeCopy = document.querySelector('[data-crop-mode-copy]');
    const placementOverrideSection = document.querySelector('[data-placement-override-section]');
    const placementOverrideOptions = document.querySelector('[data-placement-override-options]');
    const cropUseGlobalButton = document.querySelector('[data-crop-use-global]');
    const previewShell = document.querySelector('[data-preview-shell]');
    const usagePreviews = document.querySelector('[data-usage-previews]');
    const usagePreviewCount = document.querySelector('[data-usage-preview-count]');
    const cropImpact = document.querySelector('[data-crop-impact]');
    const cropImpactTitle = document.querySelector('[data-crop-impact-title]');
    const cropImpactCopy = document.querySelector('[data-crop-impact-copy]');
    const cropSaveButton = document.querySelector('[data-crop-save]');
    const vendorDialog = document.querySelector('[data-vendor-dialog]');
    const vendorOptions = document.querySelector('[data-vendor-options]');
    const vendorSearch = document.querySelector('[data-vendor-search]');
    const vendorMessage = document.querySelector('[data-vendor-message]');

    // Gallery workspace runtime state. Explicit declarations are required because Astro's
    // client script is an ES module (strict mode); assigning undeclared variables stops
    // execution before the photo boards render.
    let state = {
      uploads: [],
      hiddenUploads: [],
      hiddenCurated: [],
      curatedEdits: {},
      categoryOrder: {},
      placementCrops: {},
    };
    let selected = new Set();
    let impactFilter = 'all';
    let cropSession = null;
    let vendorSession = null;
    let vendors = [];
    const orderUndoTimers = new Map();
    function hasAdminAccess(user) {
      return Boolean(user?.capabilities?.includes('gallery.view') || user?.permissions?.includes('gallery.view'));
    }

    async function optimizedFile(file) {
      const bitmap = await createImageBitmap(file);
      const max = 2200;
      const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', 0.86));
      return new File([blob], file.name.replace(/\.[^.]+$/, '') + '.webp', { type:'image/webp' });
    }

    async function post(payload) {
      const response = await fetch('/api/gallery', {
        method: 'POST',
        headers: { 'Content-Type':'application/json' },
        body: JSON.stringify(payload),
      });
      if (!response.ok) {
        const detail = await response.json().catch(() => ({}));
        throw new Error(detail.error || 'Gallery update failed');
      }
      return response.json();
    }

    function itemKey(item) {
      return item.kind === 'upload' ? 'upload:' + item.id : 'curated:' + item.src;
    }

    function allItems() {
      const uploaded = state.uploads.map((item) => ({
        ...item,
        kind:'upload',
        hidden: state.hiddenUploads.includes(item.id),
      }));
      const builtIn = curated.map((item) => {
        const edit = state.curatedEdits?.[item.src] || {};
        return {
          ...item,
          kind:'curated',
          category: edit.category || item.category || 'Venue',
          focalX: edit.focalX ?? 50,
          focalY: edit.focalY ?? 50,
          hidden: state.hiddenCurated.includes(item.src),
          vendorIds: Array.isArray(edit.vendorIds) ? edit.vendorIds : [],
        };
      });
      return [...builtIn, ...uploaded];
    }

    function orderedItems(category) {
      const items = allItems().filter((item) => item.category === category);
      const byKey = new Map(items.map((item) => [itemKey(item), item]));
      const saved = Array.isArray(state.categoryOrder?.[category]) ? state.categoryOrder[category] : [];
      const ordered = saved.map((key) => byKey.get(key)).filter(Boolean);
      const included = new Set(ordered.map(itemKey));
      return [...ordered, ...items.filter((item) => !included.has(itemKey(item)))];
    }

    function updateBulkBar() {
      const count = selected.size;
      bulkBar?.classList.toggle('hidden', count === 0);
      if (selectedCount) selectedCount.textContent = count + (count === 1 ? ' photo selected' : ' photos selected');
    }

    function selectPayload() {
      const lookup = new Map(allItems().map((item) => [itemKey(item), item]));
      return [...selected].map((key) => lookup.get(key)).filter(Boolean).map((item) =>
        item.kind === 'upload'
          ? { kind:'upload', id:item.id }
          : { kind:'curated', src:item.src }
      );
    }

    function vendorLabel(vendor) {
      return [vendor.name, vendor.category].filter(Boolean).join(' · ');
    }

    function renderVendorOptions() {
      if (!vendorSession) return;
      const query = String(vendorSearch?.value || '').trim().toLowerCase();
      vendorOptions.innerHTML = '';
      vendors.filter((vendor) => vendor.status !== 'paused').filter((vendor) => vendorLabel(vendor).toLowerCase().includes(query)).forEach((vendor) => {
        const label = document.createElement('label');
        label.className = 'flex cursor-pointer items-start gap-3 rounded-xl border border-[var(--koa-line)] p-3 hover:bg-[var(--koa-ivory)]';
        const check = document.createElement('input');
        check.type = 'checkbox';
        check.value = vendor.id;
        check.checked = vendorSession.vendorIds.has(vendor.id);
        check.className = 'mt-1 size-4 accent-[var(--koa-forest)]';
        check.addEventListener('change', () => check.checked ? vendorSession.vendorIds.add(vendor.id) : vendorSession.vendorIds.delete(vendor.id));
        const copy = document.createElement('span');
        copy.innerHTML = '<strong class="block text-sm">' + vendor.name + '</strong><span class="mt-1 block text-xs text-[var(--koa-ink)]/50">' + vendor.category + ' · ' + String(vendor.tier || 'community').replaceAll('_',' ') + '</span>';
        label.append(check, copy);
        vendorOptions.append(label);
      });
      if (!vendorOptions.children.length) vendorOptions.textContent = 'No vendors match this search.';
    }

    function openVendorEditor(item) {
      vendorSession = { item, vendorIds: new Set(Array.isArray(item.vendorIds) ? item.vendorIds : []) };
      document.querySelector('[data-vendor-title]').textContent = item.alt || 'Assign vendors to photo';
      if (vendorSearch) vendorSearch.value = '';
      if (vendorMessage) vendorMessage.textContent = '';
      renderVendorOptions();
      vendorDialog?.showModal();
    }

    function usageForItem(item) {
      const mapped = Array.isArray(mediaUsage?.[item.src]) ? mediaUsage[item.src] : [];
      if (mapped.length) return mapped;
      return item.kind === 'upload'
        ? [{
            href:'/gallery/',
            page:'Gallery',
            section:item.category || 'Uploaded photos',
            aspectRatio:'4 / 5',
            aspectLabel:'Mobile gallery card',
          }]
        : [];
    }

    function externalUsagesForItem(item) {
      return usageForItem(item).filter((usage) => usage.href !== '/gallery/');
    }

    function placementCropFor(item, usage) {
      const placementId = String(usage?.placementId || '');
      if (!placementId) return null;
      return state.placementCrops?.[item.src]?.[placementId] || null;
    }

    function effectiveCropForUsage(item, usage) {
      if (cropSession?.mode === 'placement' && cropSession?.usage?.placementId === usage?.placementId) {
        return { x: cropSession.x, y: cropSession.y, override:true };
      }

      const saved = placementCropFor(item, usage);
      if (saved) return { x:Number(saved.focalX ?? 50), y:Number(saved.focalY ?? 50), override:true };

      if (cropSession?.mode === 'global' && cropSession?.item?.src === item.src) {
        return { x:cropSession.x, y:cropSession.y, override:false };
      }

      return { x:Number(item.focalX ?? 50), y:Number(item.focalY ?? 50), override:false };
    }

    function renderPlacementOverrideOptions(item) {
      if (!placementOverrideOptions || !placementOverrideSection) return;
      placementOverrideOptions.innerHTML = '';
      const highImpactUsages = externalUsagesForItem(item).filter((usage) => usage.impact === 'high' && usage.placementId);
      placementOverrideSection.hidden = highImpactUsages.length === 0;
      if (!highImpactUsages.length) return;

      highImpactUsages.forEach((usage) => {
        const saved = placementCropFor(item, usage);
        const selected = cropSession?.mode === 'placement' && cropSession?.usage?.placementId === usage.placementId;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'rounded-xl border px-3 py-2 text-left transition ' +
          (selected
            ? 'border-[var(--koa-clay)] bg-[var(--koa-clay)] text-white shadow-sm'
            : saved
              ? 'border-[var(--koa-clay)]/30 bg-white text-[var(--koa-clay)]'
              : 'border-[var(--koa-line)] bg-white text-[var(--koa-ink)]');
        const name = document.createElement('strong');
        name.className = 'block text-xs';
        name.textContent = usage.page + ' · ' + usage.section;
        const status = document.createElement('span');
        status.className = 'mt-1 block text-[.58rem] font-black uppercase tracking-[.07em] opacity-70';
        status.textContent = selected ? 'Editing this placement' : saved ? 'Override saved' : 'Uses global crop';
        button.append(name, status);
        button.addEventListener('click', () => startPlacementOverride(item, usage));
        placementOverrideOptions.append(button);
      });
    }

    function impactBucketForItem(item) {
      const usages = externalUsagesForItem(item);
      if (!usages.length) return 'unused';
      if (usages.some((usage) => usage.impact === 'high')) return 'high';
      if (usages.some((usage) => usage.impact === 'standard')) return 'standard';
      return 'low';
    }

    function matchesImpactFilter(item) {
      return impactFilter === 'all' || impactBucketForItem(item) === impactFilter;
    }

    function renderImpactFilters() {
      const items = allItems();
      const counts = {
        all: items.length,
        high: items.filter((item) => impactBucketForItem(item) === 'high').length,
        standard: items.filter((item) => impactBucketForItem(item) === 'standard').length,
        low: items.filter((item) => impactBucketForItem(item) === 'low').length,
        unused: items.filter((item) => impactBucketForItem(item) === 'unused').length,
      };

      document.querySelectorAll('[data-impact-count]').forEach((element) => {
        const key = element.dataset.impactCount;
        element.textContent = key && key in counts ? '(' + counts[key] + ')' : '';
      });

      document.querySelectorAll('[data-impact-filter-value]').forEach((button) => {
        const active = button.dataset.impactFilterValue === impactFilter;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('ring-2', active);
        button.classList.toggle('ring-[var(--koa-amber)]', active);
        button.classList.toggle('ring-offset-2', active);
      });
    }

    function impactClass(impact, surface = 'badge') {
      if (surface === 'card') {
        return impact === 'high'
          ? 'border-[var(--koa-clay)]/55 bg-[color-mix(in_srgb,var(--koa-clay)_8%,white)]'
          : impact === 'low'
            ? 'border-[var(--koa-line)] bg-white'
            : 'border-[var(--koa-forest)]/22 bg-[color-mix(in_srgb,var(--koa-forest)_4%,white)]';
      }
      return impact === 'high'
        ? 'border-[var(--koa-clay)]/35 bg-[var(--koa-clay)] text-white'
        : impact === 'low'
          ? 'border-[var(--koa-line)] bg-white text-[var(--koa-ink)]/55'
          : 'border-[var(--koa-forest)]/25 bg-[var(--koa-forest)]/8 text-[var(--koa-forest)]';
    }

    function updateCropImpact(item) {
      if (cropSession?.mode === 'placement' && cropSession.usage) {
        const usage = cropSession.usage;
        if (cropSaveButton) cropSaveButton.textContent = 'Save override';
        if (cropImpact && cropImpactTitle && cropImpactCopy) {
          cropImpactTitle.textContent = 'Only ' + usage.page + ' · ' + usage.section + ' will change';
          cropImpactCopy.textContent = 'This placement gets its own focal point. Every other website placement keeps its current global crop or its own saved override.';
          cropImpact.hidden = false;
        }
        if (cropUseGlobalButton) cropUseGlobalButton.hidden = !placementCropFor(item, usage);
        return;
      }

      const allUsages = externalUsagesForItem(item);
      const usages = allUsages.filter((usage) => !placementCropFor(item, usage));
      const overrideCount = allUsages.length - usages.length;
      const count = usages.length;

      if (cropSaveButton) cropSaveButton.textContent = count > 1 ? 'Save crop to ' + count + ' places' : 'Save crop';
      if (cropUseGlobalButton) cropUseGlobalButton.hidden = true;

      if (!cropImpact || !cropImpactTitle || !cropImpactCopy) return;
      if (count < 2 && overrideCount === 0) {
        cropImpact.hidden = true;
        cropImpactCopy.textContent = '';
        return;
      }

      const highImpact = usages.filter((usage) => usage.impact === 'high');
      const examples = usages.slice(0, 3).map((usage) => usage.page + ' · ' + usage.section);
      const remainder = count - examples.length;
      cropImpactTitle.textContent = highImpact.length
        ? 'High-impact crop change: ' + count + ' website placements'
        : 'This change will affect ' + count + ' website placements';
      cropImpactCopy.textContent =
        (highImpact.length
          ? highImpact.length + (highImpact.length === 1 ? ' high-impact placement is included. ' : ' high-impact placements are included. ')
          : '') +
        (count
          ? 'The same focal point will update ' + examples.join(', ') + (remainder > 0 ? ', and ' + remainder + ' more.' : '.') + ' '
          : '') +
        (overrideCount
          ? overrideCount + (overrideCount === 1 ? ' saved placement override will stay unchanged. ' : ' saved placement overrides will stay unchanged. ')
          : '') +
        'Review the placement previews above before saving.';
      cropImpact.hidden = false;
    }

    function renderUsagePreviews(item) {
      if (!usagePreviews) return;
      usagePreviews.innerHTML = '';
      const usages = usageForItem(item);

      if (usagePreviewCount) {
        usagePreviewCount.textContent = usages.length
          ? usages.length + (usages.length === 1 ? ' placement' : ' placements')
          : 'No mapped placements';
      }

      if (!usages.length) {
        const empty = document.createElement('p');
        empty.className = 'rounded-xl border border-dashed border-[var(--koa-line)] p-4 text-xs leading-5 text-[var(--koa-ink)]/50 sm:col-span-2 lg:col-span-3';
        empty.textContent = 'No public page reuse is mapped for this image yet.';
        usagePreviews.append(empty);
        return;
      }

      usages.forEach((usage) => {
        const link = document.createElement('a');
        link.href = usage.href;
        link.target = '_blank';
        link.rel = 'noreferrer';
        link.className = 'group self-start overflow-hidden rounded-xl border transition hover:-translate-y-0.5 hover:shadow-md ' + impactClass(usage.impact, 'card');

        const frame = document.createElement('div');
        frame.className = 'relative w-full overflow-hidden bg-[var(--koa-sand)]';
        frame.style.aspectRatio = usage.aspectRatio || '4 / 3';

        const image = document.createElement('img');
        image.src = item.src;
        image.alt = '';
        image.draggable = false;
        image.dataset.usagePreviewImage = '';
        image.dataset.placementId = usage.placementId || '';
        image.className = 'h-full w-full object-cover transition duration-200';
        const effectiveCrop = effectiveCropForUsage(item, usage);
        image.style.objectPosition = effectiveCrop.x + '% ' + effectiveCrop.y + '%';

        const ratioLabel = document.createElement('span');
        ratioLabel.className = 'absolute bottom-2 left-2 rounded-full bg-black/65 px-2 py-1 text-[.55rem] font-black uppercase tracking-[.08em] text-white';
        ratioLabel.textContent = String(usage.aspectRatio || '4 / 3').replaceAll(' ', '').replace('/', ':');

        const openLabel = document.createElement('span');
        openLabel.className = 'absolute right-2 top-2 rounded-full bg-black/65 px-2 py-1 text-[.55rem] font-black uppercase tracking-[.08em] text-white opacity-0 transition group-hover:opacity-100';
        openLabel.textContent = 'Open page';

        frame.append(image, ratioLabel, openLabel);

        const copy = document.createElement('div');
        copy.className = 'p-3';
        const page = document.createElement('strong');
        page.className = 'block text-xs';
        page.textContent = usage.page;
        const section = document.createElement('span');
        section.className = 'mt-1 block text-[.68rem] leading-4 text-[var(--koa-ink)]/50';
        section.textContent = usage.section;
        const meta = document.createElement('div');
        meta.className = 'mt-2 flex flex-wrap items-center gap-1.5';
        const impact = document.createElement('span');
        impact.className = 'rounded-full border px-2 py-1 text-[.55rem] font-black uppercase tracking-[.07em] ' + impactClass(usage.impact);
        impact.textContent = usage.impactLabel || 'Standard';
        const shape = document.createElement('span');
        shape.className = 'rounded-full bg-[var(--koa-sand)] px-2 py-1 text-[.55rem] font-bold uppercase tracking-[.07em] text-[var(--koa-clay)]';
        shape.textContent = usage.aspectLabel || String(usage.aspectRatio || '').replaceAll(' ', '').replace('/', ':');
        meta.append(impact, shape);
        if (placementCropFor(item, usage) || (cropSession?.mode === 'placement' && cropSession?.usage?.placementId === usage.placementId)) {
          const override = document.createElement('span');
          override.className = 'rounded-full border border-[var(--koa-clay)]/30 bg-white px-2 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]';
          override.textContent = 'Crop override';
          meta.append(override);
        }
        copy.append(page, section, meta);

        link.append(frame, copy);
        usagePreviews.append(link);
      });
    }

    function openCrop(item) {
      cropSession = {
        mode:'global',
        item,
        usage:null,
        x: Number(item.focalX ?? 50),
        y: Number(item.focalY ?? 50),
        initialX: Number(item.focalX ?? 50),
        initialY: Number(item.focalY ?? 50),
      };
      cropTitle.textContent = item.alt || 'Reposition photo';
      if (cropModeCopy) cropModeCopy.textContent = 'Editing the global crop. Placements with saved overrides will not move.';
      cropImage.src = item.src;
      cropImage.alt = item.alt || '';
      renderPlacementOverrideOptions(item);
      renderUsagePreviews(item);
      updateCropImpact(item);
      setCropPoint(cropSession.x, cropSession.y);
      setPreviewMode('desktop');
      cropDialog?.showModal();
    }

    function startPlacementOverride(item, usage) {
      const saved = placementCropFor(item, usage);
      cropSession = {
        mode:'placement',
        item,
        usage,
        x:Number(saved?.focalX ?? item.focalX ?? 50),
        y:Number(saved?.focalY ?? item.focalY ?? 50),
        initialX:Number(saved?.focalX ?? item.focalX ?? 50),
        initialY:Number(saved?.focalY ?? item.focalY ?? 50),
      };
      cropTitle.textContent = 'Override crop · ' + usage.page + ' · ' + usage.section;
      if (cropModeCopy) cropModeCopy.textContent = 'Editing only this high-impact placement. The global crop and every other placement stay unchanged.';
      renderPlacementOverrideOptions(item);
      renderUsagePreviews(item);
      updateCropImpact(item);
      setCropPoint(cropSession.x, cropSession.y);
    }

    function setCropPoint(x, y) {
      if (!cropSession) return;
      cropSession.x = Math.max(0, Math.min(100, x));
      cropSession.y = Math.max(0, Math.min(100, y));
      cropImage.style.objectPosition = cropSession.x + '% ' + cropSession.y + '%';
      cropCrosshair.style.left = cropSession.x + '%';
      cropCrosshair.style.top = cropSession.y + '%';
      cropPosition.textContent = Math.round(cropSession.x) + '% × ' + Math.round(cropSession.y) + '%';
      usagePreviews?.querySelectorAll('[data-usage-preview-image]').forEach((image) => {
        const placementId = image.dataset.placementId || '';
        const usage = usageForItem(cropSession.item).find((entry) => entry.placementId === placementId);
        if (!usage) {
          image.style.objectPosition = cropSession.x + '% ' + cropSession.y + '%';
          return;
        }
        const effective = effectiveCropForUsage(cropSession.item, usage);
        image.style.objectPosition = effective.x + '% ' + effective.y + '%';
      });
    }

    function setPreviewMode(mode) {
      const mobile = mode === 'mobile';
      previewShell.style.maxWidth = mobile ? '390px' : '760px';
      cropFrame.style.height = mobile ? '520px' : '430px';
      document.querySelectorAll('[data-preview-mode]').forEach((button) => {
        const active = button.dataset.previewMode === mode;
        button.className = active
          ? 'rounded-full bg-[var(--koa-forest)] px-4 py-2 text-xs font-black uppercase tracking-[.1em] text-white'
          : 'rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.1em]';
      });
    }

    function galleryKeys(grid) {
      return [...grid.querySelectorAll('[data-gallery-key]')].map((el) => el.dataset.galleryKey);
    }

    function restoreGalleryOrder(grid, keys) {
      const cards = new Map([...grid.querySelectorAll('[data-gallery-key]')].map((el) => [el.dataset.galleryKey, el]));
      keys.forEach((key) => {
        const card = cards.get(key);
        if (card) grid.append(card);
      });
    }

    function setOrderStatus(status, message, tone = 'idle') {
      if (!status) return;
      status.textContent = message;
      status.className = 'text-xs font-black uppercase tracking-[.08em] ' + (
        tone === 'saving' ? 'text-[var(--koa-clay)]' :
        tone === 'success' ? 'text-[var(--koa-forest)]' :
        tone === 'error' ? 'text-red-700' :
        'text-[var(--koa-ink)]/40'
      );
    }

    function clearOrderUndo(category, undoButton) {
      const timer = orderUndoTimers.get(category);
      if (timer) window.clearTimeout(timer);
      orderUndoTimers.delete(category);
      if (undoButton) {
        undoButton.hidden = true;
        undoButton.disabled = false;
        undoButton.textContent = 'Undo';
        undoButton.onclick = null;
      }
    }

    function armOrderUndo(grid, category, previousKeys, currentKeys, status, undoButton) {
      if (!undoButton) return;
      clearOrderUndo(category, undoButton);

      const expireUndo = () => {
        clearOrderUndo(category, undoButton);
        if (status?.textContent === 'Order saved') setOrderStatus(status, 'Ready to reorder');
      };

      undoButton.hidden = false;
      undoButton.disabled = false;
      undoButton.textContent = 'Undo';
      undoButton.onclick = async () => {
        const timer = orderUndoTimers.get(category);
        if (timer) window.clearTimeout(timer);
        orderUndoTimers.delete(category);

        if (grid.dataset.orderSaving === 'true') return;
        grid.dataset.orderSaving = 'true';
        undoButton.disabled = true;
        undoButton.textContent = 'Undoing…';
        setOrderStatus(status, 'Restoring previous order…', 'saving');
        restoreGalleryOrder(grid, previousKeys);

        try {
          await post({ action:'reorder', category, keys:previousKeys });
          state.categoryOrder[category] = previousKeys;
          clearOrderUndo(category, undoButton);
          setOrderStatus(status, 'Previous order restored', 'success');
          window.setTimeout(() => {
            if (status?.textContent === 'Previous order restored') setOrderStatus(status, 'Ready to reorder');
          }, 2400);
        } catch (error) {
          restoreGalleryOrder(grid, currentKeys);
          setOrderStatus(status, 'Undo failed — saved order kept', 'error');
          undoButton.hidden = false;
          undoButton.disabled = false;
          undoButton.textContent = 'Retry undo';
          const retryTimer = window.setTimeout(expireUndo, 5000);
          orderUndoTimers.set(category, retryTimer);
          console.error('Gallery reorder undo failed', error);
        } finally {
          delete grid.dataset.orderSaving;
        }
      };

      const timer = window.setTimeout(expireUndo, 8000);
      orderUndoTimers.set(category, timer);
    }

    function autoScrollForPointer(clientY) {
      const edge = 88;
      const step = 16;
      if (clientY < edge) window.scrollBy(0, -step);
      else if (clientY > window.innerHeight - edge) window.scrollBy(0, step);
    }

    function createDropPlaceholder(article) {
      const rect = article.getBoundingClientRect();
      const placeholder = document.createElement('div');
      placeholder.dataset.dropPlaceholder = '';
      placeholder.setAttribute('aria-hidden', 'true');
      placeholder.className = 'pointer-events-none rounded-[1.2rem] border-2 border-dashed border-[var(--koa-clay)]/50 bg-[var(--koa-clay)]/5 shadow-inner';
      placeholder.style.minHeight = Math.max(120, rect.height) + 'px';
      placeholder.style.opacity = '0';
      placeholder.style.transform = 'scale(.975)';
      placeholder.style.transition = 'opacity 130ms ease, transform 130ms ease';
      window.requestAnimationFrame(() => {
        placeholder.style.opacity = '1';
        placeholder.style.transform = 'scale(1)';
      });
      return placeholder;
    }

    function pulseDropPlaceholder(placeholder) {
      if (!placeholder?.animate) return;
      placeholder.animate(
        [
          { opacity:.65, transform:'scale(.985)' },
          { opacity:1, transform:'scale(1)' },
        ],
        { duration:140, easing:'ease-out' }
      );
    }

    function moveDropPlaceholder(grid, dragging, placeholder, clientX, clientY) {
      const hit = document.elementFromPoint(clientX, clientY);
      const target = hit?.closest?.('[data-gallery-key]');
      if (!target || target === dragging || target.parentElement !== grid) return false;

      const rect = target.getBoundingClientRect();
      const columns = getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length;
      const before = columns > 1
        ? clientX < rect.left + rect.width / 2
        : clientY < rect.top + rect.height / 2;
      const reference = before ? target : target.nextSibling;

      if (reference === placeholder || (reference == null && placeholder === grid.lastElementChild)) return false;
      grid.insertBefore(placeholder, reference);
      pulseDropPlaceholder(placeholder);
      return true;
    }

    async function saveGalleryOrder(grid, category, originalKeys, status, undoButton) {
      const keys = galleryKeys(grid);
      if (keys.join('|') === originalKeys.join('|')) {
        setOrderStatus(status, 'Order unchanged');
        return;
      }

      grid.dataset.orderSaving = 'true';
      setOrderStatus(status, 'Saving order…', 'saving');
      try {
        await post({ action:'reorder', category, keys });
        state.categoryOrder[category] = keys;
        setOrderStatus(status, 'Order saved', 'success');
        armOrderUndo(grid, category, originalKeys, keys, status, undoButton);
      } catch (error) {
        restoreGalleryOrder(grid, originalKeys);
        clearOrderUndo(category, undoButton);
        setOrderStatus(status, 'Save failed — order restored', 'error');
        console.error('Gallery reorder failed', error);
      } finally {
        delete grid.dataset.orderSaving;
      }
    }

    function makeCard(item) {
      const key = itemKey(item);
      const article = document.createElement('article');
      article.dataset.galleryKey = key;
      article.draggable = false;
      article.className = 'group overflow-hidden rounded-[1.2rem] border border-[var(--koa-line)] bg-white shadow-sm transition ' + (item.hidden ? 'opacity-55' : '');

      const imageWrap = document.createElement('div');
      imageWrap.className = 'relative h-48 overflow-hidden bg-[var(--koa-sand)]';

      const img = document.createElement('img');
      img.src = item.src;
      img.alt = item.alt;
      img.draggable = false;
      img.className = 'h-full w-full object-cover';
      img.style.objectPosition = (item.focalX ?? 50) + '% ' + (item.focalY ?? 50) + '%';

      const dragHandle = document.createElement('button');
      dragHandle.type = 'button';
      dragHandle.className = 'absolute left-3 top-3 cursor-grab touch-none select-none rounded-full bg-black/65 px-3 py-2 text-[.62rem] font-black uppercase tracking-[.1em] text-white active:cursor-grabbing';
      dragHandle.textContent = '↕ Order';
      dragHandle.title = 'Drag this card to reorder';
      dragHandle.setAttribute('aria-label', 'Drag photo to change its gallery order');
      dragHandle.style.touchAction = 'none';

      const checkboxLabel = document.createElement('label');
      checkboxLabel.className = 'absolute right-3 top-3 grid size-9 cursor-pointer place-items-center rounded-full bg-white/95 shadow';
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.checked = selected.has(key);
      checkbox.className = 'size-4 accent-[var(--koa-forest)]';
      checkbox.addEventListener('change', () => {
        checkbox.checked ? selected.add(key) : selected.delete(key);
        updateBulkBar();
      });
      checkboxLabel.append(checkbox);

      const publicUsages = externalUsagesForItem(item);
      const usageDetailsId = 'usage-' + key.replace(/[^a-z0-9_-]+/gi, '-');
      const usageBadge = document.createElement('button');
      usageBadge.type = 'button';
      usageBadge.className = 'absolute bottom-3 right-3 rounded-full border border-white/20 bg-[rgba(6,23,18,.82)] px-3 py-1.5 text-[.58rem] font-black uppercase tracking-[.08em] text-white shadow backdrop-blur transition hover:bg-[rgba(6,23,18,.94)] focus:outline-none focus:ring-2 focus:ring-white';
      usageBadge.textContent = 'Used in ' + publicUsages.length + (publicUsages.length === 1 ? ' place' : ' places');
      usageBadge.setAttribute('aria-expanded', 'false');
      usageBadge.setAttribute('aria-controls', usageDetailsId);
      usageBadge.title = publicUsages.length
        ? 'Show every website placement using this photo'
        : 'This photo is not reused outside the Gallery page';

      if (item.hidden) {
        const hiddenBadge = document.createElement('span');
        hiddenBadge.className = 'absolute bottom-3 left-3 rounded-full bg-black/70 px-3 py-1.5 text-[.6rem] font-black uppercase tracking-[.1em] text-white';
        hiddenBadge.textContent = 'Hidden';
        imageWrap.append(hiddenBadge);
      }

      imageWrap.prepend(img);
      imageWrap.append(dragHandle, checkboxLabel, usageBadge);

      const body = document.createElement('div');
      body.className = 'space-y-3 p-4';

      const usageDetails = document.createElement('div');
      usageDetails.id = usageDetailsId;
      usageDetails.hidden = true;
      usageDetails.className = 'rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-3';

      const usageHeading = document.createElement('div');
      usageHeading.className = 'flex items-center justify-between gap-3';
      const usageTitle = document.createElement('strong');
      usageTitle.className = 'text-[.65rem] uppercase tracking-[.1em] text-[var(--koa-forest)]';
      usageTitle.textContent = 'Website placements';
      const usageCount = document.createElement('span');
      usageCount.className = 'text-[.62rem] font-semibold text-[var(--koa-ink)]/42';
      usageCount.textContent = publicUsages.length + (publicUsages.length === 1 ? ' placement' : ' placements');
      usageHeading.append(usageTitle, usageCount);
      usageDetails.append(usageHeading);

      if (publicUsages.length) {
        const usageList = document.createElement('div');
        usageList.className = 'mt-2 grid gap-1.5';
        publicUsages.forEach((usage) => {
          const usageLink = document.createElement('a');
          usageLink.href = usage.href;
          usageLink.target = '_blank';
          usageLink.rel = 'noreferrer';
          usageLink.className = 'flex items-start justify-between gap-3 rounded-lg border border-transparent px-2 py-2 text-left transition hover:border-[var(--koa-line)] hover:bg-white';
          const usageCopy = document.createElement('span');
          const usagePage = document.createElement('strong');
          usagePage.className = 'block text-xs';
          usagePage.textContent = usage.page;
          const usageSection = document.createElement('span');
          usageSection.className = 'mt-0.5 block text-[.68rem] leading-4 text-[var(--koa-ink)]/50';
          usageSection.textContent = usage.section;
          usageCopy.append(usagePage, usageSection);
          const usageMeta = document.createElement('span');
          usageMeta.className = 'flex shrink-0 flex-col items-end gap-1';
          const usageImpact = document.createElement('span');
          usageImpact.className = 'rounded-full border px-2 py-1 text-[.52rem] font-black uppercase tracking-[.06em] ' + impactClass(usage.impact);
          usageImpact.textContent = usage.impactLabel || 'Standard';
          const usageShape = document.createElement('span');
          usageShape.className = 'rounded-full bg-[var(--koa-sand)] px-2 py-1 text-[.52rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]';
          usageShape.textContent = String(usage.aspectRatio || '').replaceAll(' ', '').replace('/', ':') || 'View';
          usageMeta.append(usageImpact, usageShape);
          usageLink.append(usageCopy, usageMeta);
          usageList.append(usageLink);
        });
        usageDetails.append(usageList);
      } else {
        const usageEmpty = document.createElement('p');
        usageEmpty.className = 'mt-2 text-[.68rem] leading-5 text-[var(--koa-ink)]/48';
        usageEmpty.textContent = 'This photo is only used in the Gallery right now.';
        usageDetails.append(usageEmpty);
      }

      usageBadge.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const opening = usageDetails.hidden;
        usageDetails.hidden = !opening;
        usageBadge.setAttribute('aria-expanded', String(opening));
        usageBadge.textContent = opening
          ? 'Hide usage'
          : 'Used in ' + publicUsages.length + (publicUsages.length === 1 ? ' place' : ' places');
      });

      const alt = document.createElement('p');
      alt.className = 'line-clamp-2 min-h-10 text-xs leading-5 text-[var(--koa-ink)]/58';
      alt.textContent = item.alt;

      const select = document.createElement('select');
      select.className = 'w-full rounded-xl border border-[var(--koa-line)] bg-white px-3 py-2.5 text-sm font-semibold';
      (item.kind === 'curated' ? allCategories : categories).forEach((category) => {
        const option = document.createElement('option');
        option.value = category;
        option.textContent = category;
        option.selected = category === item.category;
        select.append(option);
      });
      select.addEventListener('change', async () => {
        if (item.kind === 'upload') {
          await post({ action:'update-upload', id:item.id, category:select.value, focalX:item.focalX ?? 50, focalY:item.focalY ?? 50 });
        } else {
          await post({ action:'update-curated', src:item.src, category:select.value, focalX:item.focalX ?? 50, focalY:item.focalY ?? 50 });
        }
        await load();
      });

      const actions = document.createElement('div');
      actions.className = 'flex flex-wrap gap-x-4 gap-y-2';

      const crop = document.createElement('button');
      crop.type = 'button';
      crop.className = 'text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]';
      crop.textContent = 'Edit crop';
      crop.addEventListener('click', () => openCrop(item));

      const vendorAssign = document.createElement('button');
      vendorAssign.type = 'button';
      vendorAssign.className = 'text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]';
      vendorAssign.textContent = (item.vendorIds?.length || 0) ? 'Vendors (' + item.vendorIds.length + ')' : 'Assign vendors';
      vendorAssign.addEventListener('click', () => openVendorEditor(item));

      const visibility = document.createElement('button');
      visibility.type = 'button';
      visibility.className = 'text-xs font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/55';
      visibility.textContent = item.hidden ? 'Show' : 'Hide';
      visibility.addEventListener('click', async () => {
        if (item.kind === 'upload') {
          await post({ action:'upload-visibility', id:item.id, hidden:!item.hidden });
        } else {
          await post({ action:'visibility', src:item.src, hidden:!item.hidden });
        }
        await load();
      });

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'text-xs font-black uppercase tracking-[.1em] text-red-700';
      remove.textContent = item.kind === 'upload' ? 'Delete' : 'Remove';
      remove.addEventListener('click', async () => {
        if (!confirm(item.kind === 'upload' ? 'Delete this uploaded photo?' : 'Remove this built-in photo from the public gallery?')) return;
        if (item.kind === 'upload') await post({ action:'delete-upload', id:item.id });
        else await post({ action:'visibility', src:item.src, hidden:true });
        selected.delete(key);
        await load();
      });

      actions.append(crop, vendorAssign, visibility, remove);
      body.append(usageDetails, alt, select, actions);
      article.append(imageWrap, body);

      let dragSession = null;

      dragHandle.addEventListener('pointerdown', (event) => {
        if (event.isPrimary === false) return;
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        const grid = article.parentElement;
        if (!grid || grid.dataset.orderSaving === 'true') return;

        event.preventDefault();
        const section = grid.closest('section');
        const status = section?.querySelector('[data-order-status]');
        const undoButton = section?.querySelector('[data-order-undo]');
        clearOrderUndo(grid.dataset.adminCategory, undoButton);

        const rect = article.getBoundingClientRect();
        const placeholder = createDropPlaceholder(article);
        const originalStyle = article.getAttribute('style');
        grid.insertBefore(placeholder, article);

        dragSession = {
          pointerId: event.pointerId,
          grid,
          category: grid.dataset.adminCategory,
          originalKeys: galleryKeys(grid),
          status,
          undoButton,
          placeholder,
          originalStyle,
          pointerOffsetX: event.clientX - rect.left,
          pointerOffsetY: event.clientY - rect.top,
        };

        dragHandle.setPointerCapture(event.pointerId);
        article.style.position = 'fixed';
        article.style.left = rect.left + 'px';
        article.style.top = rect.top + 'px';
        article.style.width = rect.width + 'px';
        article.style.height = rect.height + 'px';
        article.style.zIndex = '80';
        article.style.margin = '0';
        article.style.pointerEvents = 'none';
        article.style.transition = 'transform 120ms ease, box-shadow 120ms ease, opacity 120ms ease';
        article.classList.add('opacity-70', 'scale-[.95]', 'ring-2', 'ring-[var(--koa-clay)]', 'shadow-2xl');
        setOrderStatus(status, 'Reordering…', 'saving');
      });

      dragHandle.addEventListener('pointermove', (event) => {
        if (!dragSession || event.pointerId !== dragSession.pointerId) return;
        event.preventDefault();
        autoScrollForPointer(event.clientY);
        article.style.left = (event.clientX - dragSession.pointerOffsetX) + 'px';
        article.style.top = (event.clientY - dragSession.pointerOffsetY) + 'px';
        moveDropPlaceholder(dragSession.grid, article, dragSession.placeholder, event.clientX, event.clientY);
      });

      const finishPointerDrag = async (event, cancelled = false) => {
        if (!dragSession || event.pointerId !== dragSession.pointerId) return;
        const session = dragSession;
        dragSession = null;

        session.grid.insertBefore(article, session.placeholder);
        session.placeholder.remove();
        if (session.originalStyle == null) article.removeAttribute('style');
        else article.setAttribute('style', session.originalStyle);
        article.classList.remove('opacity-70', 'scale-[.95]', 'ring-2', 'ring-[var(--koa-clay)]', 'shadow-2xl');
        if (dragHandle.hasPointerCapture(event.pointerId)) dragHandle.releasePointerCapture(event.pointerId);

        if (cancelled) {
          restoreGalleryOrder(session.grid, session.originalKeys);
          setOrderStatus(session.status, 'Reorder cancelled');
          return;
        }

        await saveGalleryOrder(session.grid, session.category, session.originalKeys, session.status, session.undoButton);
      };

      dragHandle.addEventListener('pointerup', (event) => { void finishPointerDrag(event); });
      dragHandle.addEventListener('pointercancel', (event) => { void finishPointerDrag(event, true); });

      return article;
    }

    function renderBoards() {
      boards.innerHTML = '';
      allCategories.forEach((category) => {
        const allCategoryItems = orderedItems(category);
        const items = allCategoryItems.filter(matchesImpactFilter);
        const section = document.createElement('section');
        section.className = 'rounded-[1.5rem] border border-[var(--koa-line)] bg-white/55 p-4 sm:p-5';

        const header = document.createElement('div');
        header.className = 'mb-4 flex flex-wrap items-end justify-between gap-3';
        const copy = document.createElement('div');
        copy.innerHTML = '<p class="eyebrow text-[var(--koa-clay)]">' + category + '</p><h2 class="display mt-2 text-3xl">' + items.length + (items.length === 1 ? ' photo' : ' photos') + (impactFilter === 'all' ? '' : ' shown') + '</h2>' +
          (impactFilter === 'all' ? '' : '<p class="mt-1 text-xs text-[var(--koa-ink)]/45">' + allCategoryItems.length + ' total in this category</p>');
        const meta = document.createElement('div');
        meta.className = 'text-left sm:text-right';
        const note = document.createElement('p');
        note.className = 'text-xs font-semibold text-[var(--koa-ink)]/45';
        note.textContent = category === 'Legacy Archive' ? 'Archive items can be moved into a public category.' : 'Drag by ↕ Order to control public sequence.';
        const orderFeedback = document.createElement('div');
        orderFeedback.className = 'mt-1 flex items-center gap-2 sm:justify-end';
        const orderStatus = document.createElement('p');
        orderStatus.dataset.orderStatus = '';
        orderStatus.setAttribute('role', 'status');
        orderStatus.setAttribute('aria-live', 'polite');
        setOrderStatus(orderStatus, 'Ready to reorder');
        const undoButton = document.createElement('button');
        undoButton.type = 'button';
        undoButton.dataset.orderUndo = '';
        undoButton.hidden = true;
        undoButton.className = 'rounded-full border border-[var(--koa-line)] bg-white px-3 py-1 text-[.64rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)] shadow-sm disabled:cursor-wait disabled:opacity-50';
        undoButton.textContent = 'Undo';
        orderFeedback.append(orderStatus, undoButton);
        meta.append(note, orderFeedback);
        header.append(copy, meta);

        const grid = document.createElement('div');
        grid.dataset.adminCategory = category;
        grid.className = 'grid min-h-24 gap-4 rounded-[1rem] sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4';

        items.forEach((item) => grid.append(makeCard(item)));

        section.append(header, grid);
        if (impactFilter !== 'all' && items.length === 0) section.classList.add('hidden');
        boards.append(section);
      });
    }

    function render() {
      renderImpactFilters();
      renderBoards();
      updateBulkBar();
    }

    async function load() {
      const user = await getAdminSession();
      if (!hasAdminAccess(user)) {
        unauthorized?.classList.remove('hidden');
        return;
      }
      ui?.classList.remove('hidden');
      const [response, vendorResponse] = await Promise.all([fetch('/api/gallery', { cache:'no-store' }), fetch('/api/admin/vendors', { cache:'no-store' })]);
      if (!response.ok) throw new Error('Gallery data failed to load (' + response.status + ')');
      const galleryPayload = await response.json();
      state = {
        uploads: Array.isArray(galleryPayload.uploads) ? galleryPayload.uploads : [],
        hiddenUploads: Array.isArray(galleryPayload.hiddenUploads) ? galleryPayload.hiddenUploads : [],
        hiddenCurated: Array.isArray(galleryPayload.hiddenCurated) ? galleryPayload.hiddenCurated : [],
        curatedEdits: galleryPayload.curatedEdits && typeof galleryPayload.curatedEdits === 'object' ? galleryPayload.curatedEdits : {},
        categoryOrder: galleryPayload.categoryOrder && typeof galleryPayload.categoryOrder === 'object' ? galleryPayload.categoryOrder : {},
        placementCrops: galleryPayload.placementCrops && typeof galleryPayload.placementCrops === 'object' ? galleryPayload.placementCrops : {},
      };
      const vendorPayload = vendorResponse.ok ? await vendorResponse.json() : { vendors: [] };
      vendors = Array.isArray(vendorPayload.vendors) ? vendorPayload.vendors : [];
      const validKeys = new Set(allItems().map(itemKey));
      selected = new Set([...selected].filter((key) => validKeys.has(key)));
      render();
    }

    async function bulk(operation, category) {
      const items = selectPayload();
      if (!items.length) return;
      if (operation === 'delete' && !confirm('Remove the selected photos? Uploaded files will be deleted; built-in photos will be hidden from the public gallery.')) return;
      await post({ action:'bulk-update', operation, category, items });
      selected.clear();
      await load();
    }

    uploadForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(uploadForm);
      const raw = data.get('file');
      if (!(raw instanceof File)) return;
      if (uploadMessage) uploadMessage.textContent = 'Optimizing image…';
      const file = await optimizedFile(raw);
      data.set('file', file);
      if (uploadMessage) uploadMessage.textContent = 'Uploading…';
      const response = await fetch('/api/gallery', { method:'POST', body:data });
      if (uploadMessage) uploadMessage.textContent = response.ok ? 'Uploaded.' : 'Upload failed.';
      if (response.ok) {
        uploadForm.reset();
        await load();
      }
    });

    document.querySelector('[data-bulk-move]')?.addEventListener('click', () => bulk('set-category', document.querySelector('[data-bulk-category]')?.value));
    document.querySelector('[data-bulk-hide]')?.addEventListener('click', () => bulk('hide'));
    document.querySelector('[data-bulk-show]')?.addEventListener('click', () => bulk('show'));
    document.querySelector('[data-bulk-delete]')?.addEventListener('click', () => bulk('delete'));
    document.querySelector('[data-clear-selection]')?.addEventListener('click', () => {
      selected.clear();
      render();
    });

    vendorSearch?.addEventListener('input', renderVendorOptions);
    document.querySelector('[data-vendor-close]')?.addEventListener('click', () => vendorDialog?.close());
    document.querySelector('[data-vendor-cancel]')?.addEventListener('click', () => vendorDialog?.close());
    document.querySelector('[data-vendor-save]')?.addEventListener('click', async () => {
      if (!vendorSession) return;
      if (vendorMessage) vendorMessage.textContent = 'Saving…';
      const item = vendorSession.item;
      await post({
        action:'assign-vendors',
        kind:item.kind,
        id:item.kind === 'upload' ? item.id : undefined,
        src:item.kind === 'curated' ? item.src : undefined,
        vendorIds:[...vendorSession.vendorIds],
      });
      vendorDialog?.close();
      vendorSession = null;
      await load();
    });
    vendorDialog?.addEventListener('close', () => { vendorSession = null; });

    document.querySelectorAll('[data-impact-filter-value]').forEach((button) => button.addEventListener('click', () => {
      impactFilter = button.dataset.impactFilterValue || 'all';
      selected.clear();
      render();
    }));

    document.querySelectorAll('[data-preview-mode]').forEach((button) => button.addEventListener('click', () => setPreviewMode(button.dataset.previewMode)));
    document.querySelector('[data-crop-close]')?.addEventListener('click', () => cropDialog?.close());
    document.querySelector('[data-crop-cancel]')?.addEventListener('click', () => cropDialog?.close());
    document.querySelector('[data-crop-reset]')?.addEventListener('click', () => setCropPoint(50, 50));
    cropSaveButton?.addEventListener('click', async () => {
      if (!cropSession) return;
      const item = cropSession.item;
      const affectedCount = externalUsagesForItem(item).filter((usage) => !placementCropFor(item, usage)).length;
      cropSaveButton.disabled = true;
      cropSaveButton.textContent = cropSession.mode === 'placement'
        ? 'Saving override…'
        : affectedCount > 1 ? 'Saving to ' + affectedCount + ' places…' : 'Saving crop…';
      try {
        if (cropSession.mode === 'placement' && cropSession.usage?.placementId) {
          await post({
            action:'update-placement-crop',
            src:item.src,
            placementId:cropSession.usage.placementId,
            focalX:cropSession.x,
            focalY:cropSession.y,
          });
        } else if (item.kind === 'upload') {
          await post({ action:'update-upload', id:item.id, category:item.category, focalX:cropSession.x, focalY:cropSession.y });
        } else {
          await post({ action:'update-curated', src:item.src, category:item.category, focalX:cropSession.x, focalY:cropSession.y });
        }
        cropDialog?.close();
        cropSession = null;
        await load();
      } finally {
        cropSaveButton.disabled = false;
        cropSaveButton.textContent = 'Save crop';
      }
    });

    cropUseGlobalButton?.addEventListener('click', async () => {
      if (!cropSession || cropSession.mode !== 'placement' || !cropSession.usage?.placementId) return;
      cropUseGlobalButton.disabled = true;
      cropUseGlobalButton.textContent = 'Removing…';
      try {
        await post({
          action:'reset-placement-crop',
          src:cropSession.item.src,
          placementId:cropSession.usage.placementId,
        });
        cropDialog?.close();
        cropSession = null;
        await load();
      } finally {
        cropUseGlobalButton.disabled = false;
        cropUseGlobalButton.textContent = 'Remove override';
      }
    });

    cropFrame?.addEventListener('pointerdown', (event) => {
      if (!cropSession) return;
      cropFrame.setPointerCapture(event.pointerId);
      const rect = cropFrame.getBoundingClientRect();
      setCropPoint(((event.clientX - rect.left) / rect.width) * 100, ((event.clientY - rect.top) / rect.height) * 100);
    });
    cropFrame?.addEventListener('pointermove', (event) => {
      if (!cropSession || !cropFrame.hasPointerCapture(event.pointerId)) return;
      const rect = cropFrame.getBoundingClientRect();
      setCropPoint(((event.clientX - rect.left) / rect.width) * 100, ((event.clientY - rect.top) / rect.height) * 100);
    });
    cropFrame?.addEventListener('pointerup', (event) => {
      if (cropFrame.hasPointerCapture(event.pointerId)) cropFrame.releasePointerCapture(event.pointerId);
    });

    cropDialog?.addEventListener('close', () => {
      cropSession = null;
      if (cropImpact) cropImpact.hidden = true;
      if (cropImpactCopy) cropImpactCopy.textContent = '';
      if (cropSaveButton) {
        cropSaveButton.disabled = false;
        cropSaveButton.textContent = 'Save crop';
      }
      if (cropUseGlobalButton) {
        cropUseGlobalButton.hidden = true;
        cropUseGlobalButton.disabled = false;
        cropUseGlobalButton.textContent = 'Remove override';
      }
      if (cropModeCopy) cropModeCopy.textContent = 'Drag inside the preview. Nothing changes publicly until you press Save crop.';
    });

    load();
  </script>
</BaseLayout>
