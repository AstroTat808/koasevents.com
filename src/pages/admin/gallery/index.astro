---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { galleryMedia, koaMarketingGallery } from '../../../data/media';
const curated = [...koaMarketingGallery, ...galleryMedia].map((item) => ({ src:item.src, alt:item.alt }));
---
<BaseLayout noindex title="Gallery Admin | Koa’s Events" description="Manage Koa’s Events gallery." canonical="https://www.koasevents.com/admin/gallery/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow text-[var(--koa-clay)]">Admin</p><h1 class="display mt-3 text-5xl">Gallery photos</h1></div><a href="/admin/" class="link-arrow">Admin home →</a></div>
      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">Sign in with an administrator account at <a class="underline" href="/admin/">Koa’s Admin</a>.</div>
      <div data-admin-ui class="hidden">
        <form data-upload-form class="grid gap-4 rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)] md:grid-cols-2">
          <label class="grid gap-2 text-sm font-semibold md:col-span-2">Photo<input name="file" type="file" accept="image/*" required class="rounded-xl border border-[var(--koa-line)] p-3" /></label>
          <label class="grid gap-2 text-sm font-semibold">Category<select name="category" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><option>Venue</option><option>Ceremony</option><option>Reception</option><option>Mobile Bar</option><option>Enhancements</option><option>Hospitality</option><option>Stay</option></select></label>
          <label class="grid gap-2 text-sm font-semibold">Alt text<input name="alt" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
          <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white md:col-span-2">Optimize & upload photo</button>
          <p data-upload-message class="text-sm text-[var(--koa-ink)]/58 md:col-span-2"></p>
        </form>

        <section class="mt-10"><h2 class="display text-4xl">Uploaded photos</h2><div data-uploaded-grid class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div></section>
        <section class="mt-14"><h2 class="display text-4xl">Built-in gallery photos</h2><p class="mt-3 text-sm text-[var(--koa-ink)]/58">Hide or restore a built-in photo without deleting the source asset.</p><div data-curated-grid class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div></section>
      </div>
    </div>
  </main>
  <script id="curated-data" type="application/json" set:html={JSON.stringify(curated)}></script>
  <script>
    import { getUser } from '@netlify/identity';
    const curated = JSON.parse(document.getElementById('curated-data')?.textContent || '[]');
    const ui=document.querySelector('[data-admin-ui]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const uploadForm=document.querySelector('[data-upload-form]');
    const uploadMessage=document.querySelector('[data-upload-message]');
    const uploadedGrid=document.querySelector('[data-uploaded-grid]');
    const curatedGrid=document.querySelector('[data-curated-grid]');
    let state={uploads:[],hiddenCurated:[]};

    async function optimizedFile(file) {
      const bitmap=await createImageBitmap(file);
      const max=2200, scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));
      const canvas=document.createElement('canvas');
      canvas.width=Math.round(bitmap.width*scale); canvas.height=Math.round(bitmap.height*scale);
      canvas.getContext('2d').drawImage(bitmap,0,0,canvas.width,canvas.height);
      const blob=await new Promise((resolve)=>canvas.toBlob(resolve,'image/webp',0.86));
      return new File([blob], file.name.replace(/\.[^.]+$/, '')+'.webp', {type:'image/webp'});
    }

    function card(src,alt,buttonText,onClick,muted=false) {
      const article=document.createElement('article'); article.className='overflow-hidden rounded-[1.2rem] border border-[var(--koa-line)] bg-white';
      const img=document.createElement('img'); img.src=src; img.alt=alt; img.className='h-52 w-full object-cover '+(muted?'opacity-35':'');
      const body=document.createElement('div'); body.className='p-4';
      const p=document.createElement('p'); p.className='text-xs leading-5 text-[var(--koa-ink)]/58'; p.textContent=alt;
      const button=document.createElement('button'); button.className='mt-4 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]'; button.textContent=buttonText; button.addEventListener('click',onClick);
      body.append(p,button); article.append(img,body); return article;
    }

    function render() {
      uploadedGrid.innerHTML='';
      state.uploads.forEach((item)=>uploadedGrid.append(card(item.src,item.alt,'Remove',async()=>{
        if(!confirm('Remove this uploaded gallery photo?'))return;
        await fetch('/api/gallery',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'delete-upload',id:item.id})}); await load();
      })));
      curatedGrid.innerHTML='';
      curated.forEach((item)=>{
        const hidden=state.hiddenCurated.includes(item.src);
        curatedGrid.append(card(item.src,item.alt,hidden?'Restore':'Hide',async()=>{
          await fetch('/api/gallery',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'visibility',src:item.src,hidden:!hidden})}); await load();
        },hidden));
      });
    }

    async function load(){
      const user=await getUser();
      if(!user){unauthorized?.classList.remove('hidden');return;}
      ui?.classList.remove('hidden');
      const response=await fetch('/api/gallery');
      state=await response.json(); render();
    }

    uploadForm?.addEventListener('submit',async(event)=>{
      event.preventDefault(); const data=new FormData(uploadForm); const raw=data.get('file');
      if(!(raw instanceof File))return;
      if(uploadMessage)uploadMessage.textContent='Optimizing image…';
      const file=await optimizedFile(raw); data.set('file',file);
      if(uploadMessage)uploadMessage.textContent='Uploading…';
      const response=await fetch('/api/gallery',{method:'POST',body:data});
      if(uploadMessage)uploadMessage.textContent=response.ok?'Uploaded.':'Upload failed.';
      if(response.ok){uploadForm.reset();await load();}
    });
    load();
  </script>
</BaseLayout>
