    document.querySelector('[data-day-close]')?.addEventListener('click',closeDayPanel);
    document.querySelector('[data-day-panel-backdrop]')?.addEventListener('click',closeDayPanel);
    document.querySelector('[data-mobile-day-preview-close]')?.addEventListener('click',closeMobileDayPreview);
    mobileDayPreviewFull?.addEventListener('click',()=>{if(mobileDayPreviewKey)openDayPanel(mobileDayPreviewKey);});
    document.querySelector('[data-preview-close]')?.addEventListener('click',closePreview);
    document.querySelector('[data-office365-sync]')?.addEventListener('click',syncOffice365Now);
    office365SyncVerifyButton?.addEventListener('click',syncOffice365NowAndVerify);
    syncAuditToggle?.addEventListener('click',()=>{
      const opening=syncAudit.classList.contains('hidden');
      syncAudit.classList.toggle('hidden',!opening);
      syncAuditToggle.textContent=opening?'Hide audit':'Show audit';
    });
    syncAuditFilterButtons.forEach((button)=>button.addEventListener('click',()=>{
      syncAuditAction=button.dataset.syncAuditFilter||'all';
      renderSyncAudit();
    }));
    syncHistoryToggle?.addEventListener('click',()=>{
      const opening=syncHistory.classList.contains('hidden');
      syncHistory.classList.toggle('hidden',!opening);
      syncHistoryToggle.textContent=opening?'Hide history':'Show history';
    });
    syncConflicts?.addEventListener('click',(event)=>{
      const button=event.target.closest('[data-resolve-conflict]');
      if(!button)return;
      resolveSyncConflict(button.dataset.recordId,button.dataset.resolveConflict,button);
    });
    document.querySelector('[data-preview-backdrop]')?.addEventListener('click',closePreview);
    previewDay?.addEventListener('click',()=>{if(!previewItem)return;const key=previewItem.date;closePreview();openDayPanel(key);});
    document.querySelectorAll('[data-filter]').forEach((button)=>button.addEventListener('click',()=>{
      const key=button.dataset.filter;
      if(key==='all'){activeFilters.clear();}
      else if(key){activeFilters.has(key)?activeFilters.delete(key):activeFilters.add(key);}
      document.querySelectorAll('[data-filter]').forEach((filterButton)=>{
        const filterKeyValue=filterButton.dataset.filter;
        filterButton.classList.toggle('is-active',filterKeyValue==='all'?activeFilters.size===0:Boolean(filterKeyValue&&activeFilters.has(filterKeyValue)));
      });
      renderActiveView();renderAgenda();
    }));
    calendarMobileQuery.addEventListener?.('change',()=>{
      closeMobileDayPreview();
      renderActiveView();
    });
    document.addEventListener('keydown',(event)=>{if(event.key==='Escape'){closePreview();closeDayPanel();closeMobileDayPreview();}});
    load();
  </script>
</BaseLayout>
