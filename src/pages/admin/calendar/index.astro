        if(!visibleEntries.length&&!run.error)details.appendChild(text('p','rounded-xl bg-white p-3 text-xs text-[var(--koa-ink)]/45','No event-level actions were recorded for this run.'));
        card.appendChild(details);syncAudit.appendChild(card);
