      calendar?.querySelectorAll('.calendar-day.is-selected').forEach((node)=>node.classList.remove('is-selected'));
    }

    function renderMobileDayPreview(key,scroll=true){
      if(!calendarMobileQuery.matches||activeView!=='month'||!key){
        closeMobileDayPreview();
        return;
      }
      mobileDayPreviewKey=key;
      const rows=itemsForDate(key);
      const conflicts=conflictsForDate(key);
      const date=new Date(key+'T12:00:00');
      if(mobileDayPreviewTitle)mobileDayPreviewTitle.textContent=new Intl.DateTimeFormat('en-US',{weekday:'long',month:'short',day:'numeric'}).format(date);
      if(mobileDayPreviewSummary)mobileDayPreviewSummary.textContent=rows.length+' item'+(rows.length===1?'':'s')+(conflicts.length?' · '+conflicts.length+' conflict'+(conflicts.length===1?'':'s'):'');
      if(mobileDayPreviewContent){
        mobileDayPreviewContent.innerHTML='';
        conflicts.slice(0,2).forEach((conflict)=>{
          const warning=document.createElement('div');
          warning.className='mobile-day-preview-conflict';
          warning.textContent=(conflict.title||'Schedule conflict')+(conflict.detail?' · '+conflict.detail:'');
          mobileDayPreviewContent.appendChild(warning);
        });
        rows.slice(0,4).forEach((item)=>mobileDayPreviewContent.appendChild(itemLink(item,true)));
        if(rows.length>4)mobileDayPreviewContent.appendChild(text('p','px-1 text-xs font-semibold text-[var(--koa-ink)]/45','+'+(rows.length-4)+' more item'+(rows.length-4===1?'':'s')+' in full day view'));
        if(!rows.length&&!conflicts.length)mobileDayPreviewContent.appendChild(text('p','rounded-lg bg-[var(--koa-ivory)] p-3 text-sm text-[var(--koa-ink)]/48','Nothing is scheduled for this day.'));
