---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Operations Calendar" description="Master calendar for Koa’s booked events, deadlines, staffing and conflicts." canonical="https://www.koasevents.com/admin/calendar/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-10">
    <div class="container-shell">
      <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Staff Workspace · Operations</p>
          <h1 class="display mt-3 text-5xl">Master Calendar</h1>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-[var(--koa-ink)]/58">Every booked event, QuickBooks payment deadline, insurance/vendor deadline, vendor arrival, run-of-show item and assigned event-day task—plus venue and staffing conflict detection.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/admin/events/" class="rounded-full border border-[var(--koa-line)] bg-white px-4 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Event Ops</a>
          <a href="/staff/" class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Staff home</a>
        </div>
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">Sign in with an authorized staff account at <a class="underline" href="/staff/">Koa’s Staff Workspace</a>.</div>

      <div data-app class="hidden grid gap-6">
        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Booked events</p><p data-total-events class="display mt-2 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Calendar items</p><p data-total-items class="display mt-2 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-ink)] p-5 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Confirmed conflicts</p><p data-total-confirmed class="display mt-2 text-4xl">0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-clay)] p-5 text-white"><p class="eyebrow text-white/70">Potential conflicts</p><p data-total-potential class="display mt-2 text-4xl">0</p></article>
        </section>

        <section class="calendar-shell rounded-[1.75rem] bg-white p-5 shadow-[var(--shadow-soft)] sm:p-7">
          <div class="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
            <div class="flex flex-wrap items-center gap-3">
              <button data-prev type="button" aria-label="Previous month" class="calendar-nav">←</button>
              <div class="min-w-[15rem]">
                <p class="eyebrow text-[var(--koa-clay)]">Calendar month</p>
                <h2 data-month-title class="display mt-1 text-4xl sm:text-5xl"></h2>
              </div>
              <button data-next type="button" aria-label="Next month" class="calendar-nav">→</button>
              <button data-today type="button" class="calendar-today">Today</button>
            </div>
            <div class="flex max-w-3xl flex-wrap gap-2 text-[.58rem] font-black uppercase tracking-[.08em]">
              <span class="legend legend-event">Event</span>
              <span class="legend legend-payment">QBO payment</span>
              <span class="legend legend-deadline">Deadline</span>
              <span class="legend legend-vendor">Vendor</span>
              <span class="legend legend-task">Task / timeline</span>
            </div>
          </div>

          <div class="mt-6 overflow-x-auto rounded-[1.15rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)]">
            <div class="calendar-grid-wrap">
              <div class="calendar-weekdays grid grid-cols-7 text-center text-[.6rem] font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">
                <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
              </div>
              <div data-calendar class="calendar-grid grid grid-cols-7"></div>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--koa-ink)]/45">
            <p>Open any calendar item to jump directly into that event record.</p>
            <p class="font-semibold text-[var(--koa-forest)]/65">Month view · 6-week grid</p>
          </div>
        </section>

        <section class="grid gap-6 xl:grid-cols-[1.1fr_.9fr]">
          <div class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
            <div class="flex items-end justify-between gap-3">
              <div><p class="eyebrow text-[var(--koa-amber-light)]">Conflict watch</p><h2 class="display mt-2 text-4xl">Venue + staffing collisions</h2></div>
              <span data-conflict-count class="rounded-full border border-white/15 px-3 py-2 text-xs font-black uppercase tracking-[.08em] text-white/70">0</span>
            </div>
            <div data-conflicts class="mt-5 grid gap-3"></div>
          </div>

          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <div><p class="eyebrow text-[var(--koa-clay)]">Agenda</p><h2 class="display mt-2 text-4xl">Month at a glance</h2></div>
            <div data-agenda class="mt-5 grid max-h-[760px] gap-3 overflow-y-auto pr-1"></div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <style is:global>
    .legend{border-radius:9999px;padding:.55rem .78rem;border:1px solid var(--koa-line);white-space:nowrap}
    .legend-event{background:var(--koa-forest);color:white;border-color:var(--koa-forest)}
    .legend-payment{background:var(--koa-clay);color:white;border-color:var(--koa-clay)}
    .legend-deadline{background:var(--koa-sand);color:var(--koa-forest)}
    .legend-vendor{background:white;color:var(--koa-clay)}
    .legend-task{background:var(--koa-ink);color:white;border-color:var(--koa-ink)}
    .calendar-nav{display:grid;height:3rem;width:3rem;place-items:center;border-radius:9999px;border:1px solid var(--koa-line);background:white;font-size:1.2rem;color:var(--koa-forest);transition:transform .16s ease,background .16s ease}
    .calendar-nav:hover{background:var(--koa-ivory);transform:translateY(-1px)}
    .calendar-today{border-radius:9999px;background:var(--koa-sand);padding:.72rem 1rem;font-size:.68rem;font-weight:900;text-transform:uppercase;letter-spacing:.09em;color:var(--koa-forest)}
    .calendar-grid-wrap{min-width:68rem}
    .calendar-weekdays{background:color-mix(in srgb,var(--koa-sand) 54%,white)}
    .calendar-weekdays>div{border-right:1px solid var(--koa-line);padding:.8rem .5rem}
    .calendar-weekdays>div:last-child{border-right:0}
    .calendar-grid{border-top:1px solid var(--koa-line)}
    .calendar-day{position:relative;min-height:12.5rem;border-right:1px solid var(--koa-line);border-bottom:1px solid var(--koa-line);padding:.7rem;background:white;transition:background .16s ease}
    .calendar-day:nth-child(7n){border-right:0}
    .calendar-day:nth-last-child(-n+7){border-bottom:0}
    .calendar-day.is-weekend:not(.is-other){background:color-mix(in srgb,var(--koa-ivory) 72%,white)}
    .calendar-day.is-other{background:color-mix(in srgb,var(--koa-sand) 42%,white);color:color-mix(in srgb,var(--koa-ink) 38%,transparent)}
    .calendar-day.is-today{background:color-mix(in srgb,var(--koa-amber-light) 16%,white)}
    .calendar-day.is-today::after{content:"";position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 0 2px var(--koa-forest)}
    .calendar-day.is-today .calendar-date-number{display:grid;height:1.8rem;min-width:1.8rem;place-items:center;border-radius:9999px;background:var(--koa-forest);padding:0 .35rem;color:white}
    .calendar-item{display:block;width:100%;overflow:hidden;border-radius:.55rem;padding:.42rem .5rem;text-align:left;font-size:.67rem;font-weight:700;line-height:1.3;text-overflow:ellipsis;white-space:nowrap;transition:transform .12s ease,filter .12s ease}
    .calendar-item:hover{transform:translateY(-1px);filter:brightness(.98)}
    .calendar-item.event{background:var(--koa-forest);color:white}
    .calendar-item.payment{background:var(--koa-clay);color:white}
    .calendar-item.deadline{background:var(--koa-sand);color:var(--koa-forest)}
    .calendar-item.vendor{border:1px solid var(--koa-line);color:var(--koa-clay);background:white}
    .calendar-item.task,.calendar-item.timeline{background:var(--koa-ink);color:white}
    .calendar-item.is-overdue{outline:2px solid var(--koa-clay);outline-offset:1px}
    @media(min-width:1536px){.calendar-day{min-height:14rem}.calendar-grid-wrap{min-width:76rem}.calendar-item{font-size:.7rem}}
    @media(max-width:800px){.calendar-shell{margin-inline:-.25rem}.calendar-grid-wrap{min-width:62rem}.calendar-day{min-height:10.5rem;padding:.55rem}.calendar-item{font-size:.62rem}}
  </style>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const approvedAdminEmails=new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    const app=document.querySelector('[data-app]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const calendar=document.querySelector('[data-calendar]');
    const agenda=document.querySelector('[data-agenda]');
    const conflictsEl=document.querySelector('[data-conflicts]');
    const monthTitle=document.querySelector('[data-month-title]');
    let cursor=new Date();
    cursor=new Date(cursor.getFullYear(),cursor.getMonth(),1);
    let data={items:[],conflicts:[],totals:{}};

    function hasAdminAccess(user){const email=String(user?.email||'').trim().toLowerCase();const roles=user?.app_metadata?.roles||[];return approvedAdminEmails.has(email)||(Array.isArray(roles)&&roles.some((role)=>['admin','staff','sales','manager'].includes(String(role||'').toLowerCase())));}
    function pad(n){return String(n).padStart(2,'0');}
    function ymd(date){return date.getFullYear()+'-'+pad(date.getMonth()+1)+'-'+pad(date.getDate());}
    function addDays(date,days){const d=new Date(date);d.setDate(d.getDate()+days);return d;}
    function dateLabel(value){return new Intl.DateTimeFormat('en-US',{dateStyle:'medium'}).format(new Date(value+'T12:00:00'));}
    function monthLabel(date){return new Intl.DateTimeFormat('en-US',{month:'long',year:'numeric'}).format(date);}
    function timeLabel(value){if(!value)return '';const [h,m]=value.split(':').map(Number);const d=new Date(2000,0,1,h,m);return new Intl.DateTimeFormat('en-US',{hour:'numeric',minute:'2-digit'}).format(d);}
    function text(tag,cls,value){const el=document.createElement(tag);if(cls)el.className=cls;el.textContent=value;return el;}
    function today(){return ymd(new Date());}
    function rangeForMonth(date){
      const first=new Date(date.getFullYear(),date.getMonth(),1);
      const gridStart=addDays(first,-first.getDay());
      const gridEnd=addDays(gridStart,41);
      return {start:ymd(gridStart),end:ymd(gridEnd),gridStart,gridEnd};
    }
    function typeLabel(type){return ({event:'Event',payment:'QBO payment',deadline:'Deadline',vendor:'Vendor',task:'Task',timeline:'Run of show'})[type]||type;}

    function renderTotals(){
      document.querySelector('[data-total-events]').textContent=String(data.totals?.bookedEvents||0);
      document.querySelector('[data-total-items]').textContent=String(data.totals?.calendarItems||0);
      document.querySelector('[data-total-confirmed]').textContent=String(data.totals?.confirmedConflicts||0);
      document.querySelector('[data-total-potential]').textContent=String(data.totals?.potentialConflicts||0);
      document.querySelector('[data-conflict-count]').textContent=String((data.conflicts||[]).length)+' alerts';
    }

    function renderCalendar(){
      monthTitle.textContent=monthLabel(cursor);calendar.innerHTML='';
      const {gridStart}=rangeForMonth(cursor);
      const itemsByDate=new Map();
      (data.items||[]).forEach((item)=>{const list=itemsByDate.get(item.date)||[];list.push(item);itemsByDate.set(item.date,list);});
      for(let i=0;i<42;i++){
        const date=addDays(gridStart,i);const key=ymd(date);const cell=document.createElement('div');
        cell.className='calendar-day'+(date.getMonth()!==cursor.getMonth()?' is-other':'')+([0,6].includes(date.getDay())?' is-weekend':'')+(key===today()?' is-today':'');
        const head=document.createElement('div');head.className='mb-2 flex items-center justify-between gap-1';
        head.appendChild(text('span','calendar-date-number text-xs font-bold',String(date.getDate())));
        const dayConflicts=(data.conflicts||[]).filter((c)=>c.date===key);
        if(dayConflicts.length)head.appendChild(text('span','rounded-full bg-[var(--koa-clay)] px-2 py-1 text-[.5rem] font-black uppercase tracking-[.07em] text-white',String(dayConflicts.length)+' conflict'));
        cell.appendChild(head);
        const list=document.createElement('div');list.className='grid gap-1';
        (itemsByDate.get(key)||[]).slice(0,5).forEach((item)=>{
          const a=document.createElement('a');a.href='/admin/events/?record='+encodeURIComponent(item.recordId);a.className='calendar-item '+item.type+(key<today() && !['paid','complete','not_applicable'].includes(item.status)?' is-overdue':'');
          a.title=[typeLabel(item.type),item.customerName,item.detail,item.owner?'Owner: '+item.owner:''].filter(Boolean).join(' · ');
          a.textContent=(item.time?timeLabel(item.time)+' ':'')+item.title;
          list.appendChild(a);
        });
        const extra=(itemsByDate.get(key)||[]).length-5;if(extra>0)list.appendChild(text('span','text-[.58rem] font-bold text-[var(--koa-ink)]/45','+'+extra+' more'));
        cell.appendChild(list);calendar.appendChild(cell);
      }
    }

    function renderConflicts(){
      conflictsEl.innerHTML='';
      const rows=data.conflicts||[];
      rows.forEach((conflict)=>{
        const card=document.createElement('article');card.className='rounded-xl border '+(conflict.severity==='confirmed'?'border-[var(--koa-clay)] bg-white/[.09]':'border-white/12 bg-white/[.05]')+' p-4';
        const head=document.createElement('div');head.className='flex flex-wrap items-center justify-between gap-2';
        head.append(text('strong','text-sm text-white',conflict.title),text('span','rounded-full border border-white/15 px-2 py-1 text-[.5rem] font-black uppercase tracking-[.08em] text-white/65',conflict.severity));
        card.append(head,text('p','mt-2 text-xs text-[var(--koa-amber-light)]',dateLabel(conflict.date)),text('p','mt-2 text-sm leading-6 text-white/62',conflict.detail));
        const links=document.createElement('div');links.className='mt-3 flex flex-wrap gap-2';
        (conflict.recordIds||[]).forEach((recordId)=>{const a=document.createElement('a');a.href='/admin/events/?record='+encodeURIComponent(recordId);a.className='rounded-full border border-white/15 px-3 py-2 text-[.55rem] font-black uppercase tracking-[.08em] text-white/75';a.textContent='Open '+recordId;links.appendChild(a);});
        card.appendChild(links);conflictsEl.appendChild(card);
      });
      if(!rows.length)conflictsEl.appendChild(text('p','text-sm text-white/55','No venue or staffing conflicts detected in this calendar range.'));
    }

    function renderAgenda(){
      agenda.innerHTML='';
      const monthStart=ymd(new Date(cursor.getFullYear(),cursor.getMonth(),1));
      const monthEnd=ymd(new Date(cursor.getFullYear(),cursor.getMonth()+1,0));
      const rows=(data.items||[]).filter((item)=>item.date>=monthStart&&item.date<=monthEnd);
      rows.forEach((item)=>{
        const row=document.createElement('a');row.href='/admin/events/?record='+encodeURIComponent(item.recordId);row.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
        const head=document.createElement('div');head.className='flex flex-wrap items-center justify-between gap-2';
        head.append(text('strong','text-sm text-[var(--koa-forest)]',item.title),text('span','text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]',typeLabel(item.type)));
        row.append(head,text('p','mt-2 text-xs text-[var(--koa-ink)]/50',dateLabel(item.date)+(item.time?' · '+timeLabel(item.time):'')+' · '+item.customerName));
        if(item.detail)row.appendChild(text('p','mt-2 text-sm leading-5 text-[var(--koa-ink)]/58',item.detail));
        if(item.owner)row.appendChild(text('p','mt-2 text-xs font-semibold text-[var(--koa-clay)]','Owner: '+item.owner));
        agenda.appendChild(row);
      });
      if(!rows.length)agenda.appendChild(text('p','text-sm text-[var(--koa-ink)]/45','No calendar items in this month.'));
    }

    async function load(){
      const user=await getAdminSession();if(!hasAdminAccess(user)){unauthorized.classList.remove('hidden');return;}
      app.classList.remove('hidden');
      const range=rangeForMonth(cursor);
      const res=await fetch('/api/admin/calendar?start='+encodeURIComponent(range.start)+'&end='+encodeURIComponent(range.end),{cache:'no-store'});
      if(!res.ok)return;
      data=await res.json();renderTotals();renderCalendar();renderConflicts();renderAgenda();
    }

    document.querySelector('[data-prev]')?.addEventListener('click',()=>{cursor=new Date(cursor.getFullYear(),cursor.getMonth()-1,1);load();});
    document.querySelector('[data-next]')?.addEventListener('click',()=>{cursor=new Date(cursor.getFullYear(),cursor.getMonth()+1,1);load();});
    document.querySelector('[data-today]')?.addEventListener('click',()=>{const now=new Date();cursor=new Date(now.getFullYear(),now.getMonth(),1);load();});
    load();
  </script>
</BaseLayout>
