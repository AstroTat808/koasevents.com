      syncAudit.innerHTML='';
      syncAuditFilterButtons.forEach((button)=>button.classList.toggle('is-active',button.dataset.syncAuditFilter===syncAuditAction));

      let renderedRuns=0;
      syncAuditRuns.slice(0,30).forEach((run,index)=>{
        const entries=Array.isArray(run.entries)?run.entries:[];
        const visibleEntries=syncAuditAction==='all'?entries:entries.filter((entry)=>entry.action===syncAuditAction);
        if(syncAuditAction!=='all'&&!visibleEntries.length)return;
        renderedRuns+=1;

        const card=document.createElement('details');
