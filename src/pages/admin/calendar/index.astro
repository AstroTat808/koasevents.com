    function closeDayPanel(){dayPanel.classList.remove('is-open');dayPanel.setAttribute('aria-hidden','true');document.body.style.overflow='';}

    function renderTotals(){
      document.querySelector('[data-total-events]').textContent=String(data.totals?.bookedEvents||0);
      document.querySelector('[data-total-items]').textContent=String(data.totals?.calendarItems||0);
      document.querySelector('[data-total-confirmed]').textContent=String(data.totals?.confirmedConflicts||0);
      document.querySelector('[data-total-potential]').textContent=String(data.totals?.potentialConflicts||0);
      document.querySelector('[data-conflict-count]').textContent=String((data.conflicts||[]).length)+' alerts';
    }

    function renderCalendar(){
      calendar.innerHTML='';
      const {gridStart,start,end}=rangeForMonth(cursor);
      const itemsByDate=new Map();
      filteredItems().forEach((item)=>{const list=itemsByDate.get(item.date)||[];list.push(item);itemsByDate.set(item.date,list);});
      for(let i=0;i<42;i++){
        const date=addDays(gridStart,i);const key=ymd(date);const cell=document.createElement('div');
        cell.dataset.dayKey=key;
        cell.className='calendar-day'+(date.getMonth()!==cursor.getMonth()?' is-other':'')+([0,6].includes(date.getDay())?' is-weekend':'')+(key===today()?' is-today':'')+(key===mobileDayPreviewKey?' is-selected':'');
        const dayItems=itemsByDate.get(key)||[];
        const dayConflicts=(data.conflicts||[]).filter((c)=>c.date===key);
        const head=document.createElement('div');head.className='mb-2 flex items-center justify-between gap-1';
        head.appendChild(text('span','calendar-date-number text-xs font-bold',String(date.getDate())));
        const meta=document.createElement('div');meta.className='flex items-center gap-1';
        if(dayItems.length){
          const count=text('span','calendar-day-count',String(dayItems.length));
          count.setAttribute('aria-label',dayItems.length+' calendar item'+(dayItems.length===1?'':'s'));
          meta.appendChild(count);
        }
        if(dayConflicts.length)meta.appendChild(text('span','calendar-conflict-badge rounded-full bg-[var(--koa-clay)] px-2 py-1 text-[.5rem] font-black uppercase tracking-[.07em] text-white',String(dayConflicts.length)+' conflict'));
        if(meta.childNodes.length)head.appendChild(meta);
        cell.appendChild(head);
        const list=document.createElement('div');list.className='calendar-day-items grid gap-1';
        dayItems.slice(0,5).forEach((item)=>{const a=itemLink(item);a.addEventListener('click',(event)=>event.stopPropagation());list.appendChild(a);});
        const extra=dayItems.length-5;
        if(extra>0){
          const more=text('button','calendar-more text-left text-[.58rem] font-bold text-[var(--koa-ink)]/45','+'+extra+' more');
          more.type='button';
          more.addEventListener('click',(event)=>{event.stopPropagation();calendarMobileQuery.matches?renderMobileDayPreview(key):openDayPanel(key);});
          list.appendChild(more);
        }
        cell.appendChild(list);
        cell.addEventListener('click',()=>calendarMobileQuery.matches?renderMobileDayPreview(key):openDayPanel(key));
        calendar.appendChild(cell);
      }
      if(calendarMobileQuery.matches&&mobileDayPreviewKey){
        if(mobileDayPreviewKey>=start&&mobileDayPreviewKey<=end)renderMobileDayPreview(mobileDayPreviewKey,false);
        else closeMobileDayPreview();
      }
    }

    function renderWeek(){
      weekView.innerHTML='';
      const {gridStart}=rangeForWeek(cursor);
      const wrapper=document.createElement('div');wrapper.className='week-grid';
      for(let i=0;i<7;i++){
        const date=addDays(gridStart,i),key=ymd(date);const col=document.createElement('div');col.className='week-day-column';
        const head=document.createElement('button');head.type='button';head.className='week-day-head w-full text-left'+(key===today()?' bg-[var(--koa-amber-light)]/20':'');
        head.append(text('p','text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]',weekdayLabel(date)),text('p','display mt-1 text-2xl text-[var(--koa-forest)]',String(date.getDate())));
        head.addEventListener('click',()=>openDayPanel(key));col.appendChild(head);
        const body=document.createElement('div');body.className='week-day-body';
        const rows=itemsForDate(key);rows.forEach((item)=>body.appendChild(itemLink(item,true)));
        if(!rows.length){const empty=text('button','rounded-lg border border-dashed border-[var(--koa-line)] p-3 text-left text-xs text-[var(--koa-ink)]/35','No items');empty.type='button';empty.addEventListener('click',()=>openDayPanel(key));body.appendChild(empty);}
        col.appendChild(body);wrapper.appendChild(col);
      }
      weekView.appendChild(wrapper);
    }

    function renderAgendaView(){
      agendaView.innerHTML='';
      const monthStart=ymd(new Date(cursor.getFullYear(),cursor.getMonth(),1));
      const monthEnd=ymd(new Date(cursor.getFullYear(),cursor.getMonth()+1,0));
      const grouped=new Map();
      filteredItems().filter((item)=>item.date>=monthStart&&item.date<=monthEnd).forEach((item)=>{const rows=grouped.get(item.date)||[];rows.push(item);grouped.set(item.date,rows);});
      const keys=[...grouped.keys()].sort();
      keys.forEach((key)=>{
        const group=document.createElement('section');group.className='agenda-group flex flex-col gap-3 sm:flex-row';
        const date=new Date(key+'T12:00:00');const dateBox=document.createElement('button');dateBox.type='button';dateBox.className='agenda-date text-left';dateBox.addEventListener('click',()=>openDayPanel(key));
        dateBox.append(text('span','text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]',weekdayLabel(date)),text('strong','display text-3xl text-[var(--koa-forest)]',String(date.getDate())),text('span','text-xs text-[var(--koa-ink)]/45',new Intl.DateTimeFormat('en-US',{month:'short'}).format(date)));
        const list=document.createElement('div');list.className='grid flex-1 gap-2';
        grouped.get(key).forEach((item)=>list.appendChild(itemLink(item,true)));
        group.append(dateBox,list);agendaView.appendChild(group);
      });
      if(!keys.length)agendaView.appendChild(text('p','rounded-xl bg-[var(--koa-ivory)] p-4 text-sm text-[var(--koa-ink)]/45','No calendar items in this month.'));
