      const icon=text('span','calendar-icon',visual.icon);icon.setAttribute('aria-hidden','true');
      const label=text('span','calendar-item-label',(item.time?timeLabel(item.time)+' ':'')+item.title);
      a.append(icon,label);a.addEventListener('click',(event)=>{event.stopPropagation();openPreview(item);});
      if(!compact)a.dataset.calendarItem='true';
      return a;
    }
    function itemsForDate(key){return filteredItems().filter((item)=>item.date===key);}
    function conflictsForDate(key){return (data.conflicts||[]).filter((item)=>item.date===key);}
