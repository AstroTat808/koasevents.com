    function availabilityFor(email,date){
      return availabilityRows.find((row)=>String(row.email||'').toLowerCase()===String(email||'').toLowerCase()&&row.date===date)||null;
    }
    function availabilityLabel(status){
      return ({available:'Available',tentative:'Tentative',unavailable:'Unavailable',pto:'PTO'})[status]||'Not set';
    }
    function assignmentDate(row){
      return String(row.dueDate||row.eventDate||row.sortDate||'').slice(0,10);
    }
    function datesForStaffView(){
      const range=staffScale==='week'?rangeForWeek(cursor):{gridStart:new Date(cursor.getFullYear(),cursor.getMonth(),1),gridEnd:new Date(cursor.getFullYear(),cursor.getMonth()+1,0)};
      const dates=[];let d=new Date(range.gridStart);
      while(d<=range.gridEnd){dates.push(new Date(d));d=addDays(d,1);}
      return dates;
    }
    async function editAvailability(staff,date){
      if(!staff||!date)return;
      const existing=availabilityFor(staff.email,date);
      const status=prompt('Availability for '+staff.name+' on '+date+'\n\nEnter: available, tentative, unavailable, or pto',existing?.status||'available');
      if(status===null)return;
      const normalized=String(status||'').trim().toLowerCase();
      if(!['available','tentative','unavailable','pto'].includes(normalized)){alert('Use available, tentative, unavailable, or pto.');return;}
      const note=prompt('Optional availability note:',existing?.note||'');
      if(note===null)return;
      const response=await fetch('/api/admin/staff-availability',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:staff.email,date,status:normalized,note})});
      const result=await response.json().catch(()=>({}));
      if(!response.ok){alert(result.error||'Availability could not be updated.');return;}
      const index=availabilityRows.findIndex((row)=>String(row.email||'').toLowerCase()===staff.email.toLowerCase()&&row.date===date);
      if(index>=0)availabilityRows[index]=result.availability;else availabilityRows.push(result.availability);
      renderStaffSchedule();
    }
    async function editAvailabilityInRange(person,dates){
      if(!dates.length)return;
      const first=ymd(dates[0]),last=ymd(dates[dates.length-1]);
      const defaultDate=today()>=first&&today()<=last?today():first;
      const chosen=prompt('Set availability for '+person.name+'\n\nEnter a date from '+first+' through '+last+' (YYYY-MM-DD):',defaultDate);
      if(chosen===null)return;
      const normalized=String(chosen||'').trim();
      if(!/^\d{4}-\d{2}-\d{2}$/.test(normalized)||normalized<first||normalized>last){
        alert('Choose a date between '+first+' and '+last+'.');
        return;
      }
      await editAvailability(person,normalized);
    }

    function renderStaffScheduleMobile(staff,dates){
