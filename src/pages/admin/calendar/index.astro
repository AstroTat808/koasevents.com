    async function load(){
      const user=await getAdminSession();if(!hasAdminAccess(user)){unauthorized.classList.remove('hidden');return;}
      currentSession=user;app.classList.remove('hidden');
      const range=rangeForView();
      const [res,staffRes,availabilityRes]=await Promise.all([
        fetch('/api/admin/calendar?start='+encodeURIComponent(range.start)+'&end='+encodeURIComponent(range.end),{cache:'no-store'}),
        fetch('/api/staff/directory',{cache:'no-store'}),
        fetch('/api/admin/staff-availability?start='+encodeURIComponent(range.start)+'&end='+encodeURIComponent(range.end),{cache:'no-store'})
      ]);
      if(!res.ok)return;
      data=await res.json();
      if(staffRes.ok){const staffData=await staffRes.json();staffDirectory=staffData.staff||[];}
      if(availabilityRes.ok){const availabilityData=await availabilityRes.json();availabilityRows=availabilityData.availability||[];}
      renderTotals();renderActiveView();renderConflicts();renderAgenda();loadOffice365Status();
    }

