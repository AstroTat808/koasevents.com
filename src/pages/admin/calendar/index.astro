        }else{
          const avatar=text('span','flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--koa-forest)] text-xs font-black text-white',String(person.name||'K').charAt(0).toUpperCase());head.appendChild(avatar);
        }
        const copy=document.createElement('div');copy.className='min-w-0 flex-1';
        copy.append(text('strong','block truncate text-sm text-[var(--koa-forest)]',person.name||person.email),text('span','block truncate text-xs text-[var(--koa-ink)]/45',person.jobTitle||person.roleLabel||'Staff'));
        const workload=person.workload||{};
        copy.appendChild(text('span','mt-1 block text-[.56rem] font-bold text-[var(--koa-ink)]/42',Number(workload.totalOpenAssignments||0)+' open · '+Number(workload.upcomingEvents||0)+' upcoming event'+(Number(workload.upcomingEvents||0)===1?'':'s')));
        head.appendChild(copy);card.appendChild(head);

        const dayWrap=document.createElement('div');dayWrap.className='staff-mobile-days';
        const relevantDates=staffScale==='week'
          ? dates
          : dates.filter((date)=>{
              const key=ymd(date);
              const availability=availabilityFor(person.email,key);
              const assignments=(person.assignments||[]).filter((row)=>assignmentDate(row)===key);
              const load=(person.dateLoad||[]).find((row)=>row.date===key);
              return Boolean(availability||assignments.length||load?.heavy);
            });

        relevantDates.forEach((date)=>{
          const key=ymd(date);const availability=availabilityFor(person.email,key);
          const assignments=(person.assignments||[]).filter((row)=>assignmentDate(row)===key);
          const load=(person.dateLoad||[]).find((row)=>row.date===key);
          const availabilityConflict=Boolean(assignments.length&&['unavailable','pto'].includes(String(availability?.status||'')));
          const overload=Boolean(load?.heavy)||availabilityConflict;
          const row=document.createElement('button');row.type='button';row.className='staff-mobile-day'+(key===today()?' is-today':'')+(overload?' has-overload':'');
          const top=document.createElement('div');top.className='flex items-start justify-between gap-2';
          const dateCopy=document.createElement('div');dateCopy.append(text('strong','block text-sm text-[var(--koa-forest)]',new Intl.DateTimeFormat('en-US',{weekday:'short',month:'short',day:'numeric'}).format(date)));
          const availabilityBadge=document.createElement('span');availabilityBadge.className='staff-availability '+(availability?.status||'unset');availabilityBadge.textContent=availabilityLabel(availability?.status);
          top.append(dateCopy,availabilityBadge);row.appendChild(top);
          if(overload){
            const warning=text('span','staff-overload-badge mt-2',availabilityConflict?'Availability conflict':(load?.responsibilityCount||0)+' load');
            row.appendChild(warning);
          }
          if(availability?.note)row.appendChild(text('p','mt-2 text-xs font-semibold text-[var(--koa-ink)]/48',availability.note));
          const list=document.createElement('div');list.className='mt-2 grid gap-1';
          assignments.slice(0,3).forEach((assignment)=>{
            const pill=document.createElement('span');pill.className='staff-schedule-pill '+(assignment.type==='task'?'task':assignment.type==='event'?'event':'project');
            pill.textContent=(assignment.type==='event'?'◆ ':assignment.type==='task'?'☑ ':'• ')+(assignment.responsibilityLabel||assignment.label||assignment.detail||'Assignment');
            list.appendChild(pill);
          });
          if(assignments.length>3)list.appendChild(text('span','text-[.55rem] font-bold text-[var(--koa-ink)]/40','+'+(assignments.length-3)+' more'));
          if(!assignments.length&&!availability)list.appendChild(text('span','text-[.58rem] text-[var(--koa-ink)]/30','No assigned work'));
          row.appendChild(list);
          row.addEventListener('click',()=>editAvailability(person,key));
          dayWrap.appendChild(row);
        });

        if(!relevantDates.length)dayWrap.appendChild(text('p','rounded-lg bg-[var(--koa-ivory)] p-3 text-xs text-[var(--koa-ink)]/45','No assigned work, availability changes, or overload warnings in this range.'));
        card.appendChild(dayWrap);
        const actions=document.createElement('div');actions.className='staff-mobile-card-actions';
        const setAvailability=document.createElement('button');setAvailability.type='button';setAvailability.className='staff-mobile-set-availability';setAvailability.textContent='Set availability';setAvailability.addEventListener('click',()=>void editAvailabilityInRange(person,dates));
        actions.appendChild(setAvailability);card.appendChild(actions);wrap.appendChild(card);
      });
      if(!staff.length)wrap.appendChild(text('p','rounded-lg bg-white p-4 text-sm text-[var(--koa-ink)]/50','No staff match this search.'));
      staffSchedule.replaceChildren(wrap);
    }

