        renderOffice365Verification(result);
        const sync=result.sync||{};
        if(statusEl)statusEl.textContent='Sync complete: '+(sync.created||0)+' created · '+(sync.adopted||0)+' adopted · '+(sync.pushed||0)+' pushed · '+(sync.pulled||0)+' pulled · verification '+(result.verification?.ok?'passed':'needs attention');
        await load();
