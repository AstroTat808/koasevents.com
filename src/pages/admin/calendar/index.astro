          text('strong','text-sm text-[var(--koa-forest)]',startedAt&&!Number.isNaN(startedAt.getTime())?new Intl.DateTimeFormat('en-US',{dateStyle:'medium',timeStyle:'short'}).format(startedAt):'Unknown sync time'),
          text('p','mt-1 text-xs text-[var(--koa-ink)]/45',(run.trigger||'sync')+' · '+(run.triggeredBy||'system')+' · '+(run.status||'unknown'))
        );
        const t=run.totals||{};
        const totalLabel=(t.created||0)+' created · '+(t.adopted||0)+' adopted · '+(t.pushed||0)+' pushed · '+(t.pulled||0)+' pulled · '+(t.conflicted||0)+' conflicted · '+(t.skipped||0)+' skipped';
        const right=document.createElement('div');right.className='flex items-center gap-3';
        right.append(
          text('span','text-xs font-bold text-[var(--koa-clay)]',syncAuditAction==='all'?totalLabel:visibleEntries.length+' '+syncAuditAction),
