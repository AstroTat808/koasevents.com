    async function loadOffice365Status(){
      const statusEl=document.querySelector('[data-office365-status]');
      try{
        const res=await fetch('/api/admin/calendar-office365',{cache:'no-store'});
        const status=await res.json();
        if(!res.ok)throw new Error(status?.error||'Status unavailable');
        renderOffice365Conflicts(status.conflicts||[]);
        renderResolvedConflictHistory(status.resolvedConflicts||[]);
        renderSyncAudit(status.auditRuns||[]);
        if(!status.configured){statusEl.textContent='Office 365 sync needs Microsoft Graph environment variables';return;}
        if(status.lastError){statusEl.textContent='Office 365 sync error: '+status.lastError;return;}
        statusEl.textContent=status.lastSuccessAt?'Office 365 synced '+new Intl.DateTimeFormat('en-US',{dateStyle:'medium',timeStyle:'short'}).format(new Date(status.lastSuccessAt))+(status.conflicts?.length?' · '+status.conflicts.length+' conflict'+(status.conflicts.length===1?'':'s'):''):'Office 365 sync ready';
      }catch{statusEl.textContent='Office 365 sync status unavailable';}
    }

    function renderOffice365Verification(result){
      if(!office365VerifyResult)return;
      const verification=result?.verification||{};
      const summary=verification.summary||{};
      office365VerifyResult.classList.remove('hidden');
      office365VerifyResult.innerHTML='';
      const ok=Boolean(verification.ok);
      const head=document.createElement('div');
      head.className='flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between';
      const left=document.createElement('div');
      left.append(
        text('strong','text-sm '+(ok?'text-emerald-800':'text-red-800'),ok?'Sync verification passed':'Sync verification needs attention'),
        text('p','mt-1 text-xs text-[var(--koa-ink)]/55',
          (summary.booked||0)+' booked · '+(summary.linked||0)+' linked · '+(summary.missing||0)+' missing · '+(summary.duplicates||0)+' duplicate warning'+((summary.duplicates||0)===1?'':'s')+' · '+(summary.mismatches||0)+' mismatch'+((summary.mismatches||0)===1?'':'es')+' · '+(summary.conflicts||0)+' unresolved conflict'+((summary.conflicts||0)===1?'':'s'))
      );
      const stamp=text('span','text-[.65rem] font-semibold text-[var(--koa-ink)]/45',verification.checkedAt?new Date(verification.checkedAt).toLocaleString():'');
      head.append(left,stamp);office365VerifyResult.appendChild(head);

      const issues=Array.isArray(verification.issues)?verification.issues:[];
      if(issues.length){
        const list=document.createElement('div');list.className='mt-3 grid gap-2';
        issues.slice(0,20).forEach((issue)=>{
          const row=document.createElement('div');
          row.className='rounded-lg border '+(issue.severity==='error'?'border-red-200 bg-red-50':'border-amber-200 bg-amber-50')+' p-3 text-xs';
          const fields=Array.isArray(issue.fields)&&issue.fields.length?' · '+issue.fields.join(', '):'';
          row.append(
            text('strong',issue.severity==='error'?'text-red-800':'text-amber-900',(issue.title||issue.recordId||'Calendar item')+' · '+String(issue.type||'issue').replaceAll('_',' ')),
            text('p','mt-1 text-[var(--koa-ink)]/60',(issue.date?dateLabel(issue.date)+' · ':'')+(issue.detail||'')+fields)
          );
          const repairs=Array.isArray(issue.repairs)?issue.repairs:[];
          if(repairs.length){
            const repairWrap=document.createElement('div');repairWrap.className='mt-3 flex flex-wrap gap-2';
            repairs.forEach((repair)=>{
              const button=document.createElement('button');
              button.type='button';
              button.className='rounded-full '+(repair.requiresConfirmation?'bg-red-800':'bg-[var(--koa-forest)]')+' px-3 py-2 text-[.55rem] font-black uppercase tracking-[.08em] text-white';
              button.textContent=repair.label||'Repair';
              button.addEventListener('click',()=>repairOffice365Issue(repair,button));
              repairWrap.appendChild(button);
            });
            row.appendChild(repairWrap);
          }
          list.appendChild(row);
        });
        if(issues.length>20)list.appendChild(text('p','text-xs text-[var(--koa-ink)]/45','Showing 20 of '+issues.length+' verification issues.'));
        office365VerifyResult.appendChild(list);
      }else if(ok){
        office365VerifyResult.appendChild(text('p','mt-3 text-xs text-emerald-800','Every booked Koa event has one linked Office 365 event and the synchronized fields match.'));
      }
    }

    async function repairOffice365Issue(repair,button){
      const requiresConfirmation=Boolean(repair?.requiresConfirmation);
      if(requiresConfirmation){
        const confirmed=window.confirm('Delete this Office 365 duplicate? This action cannot be undone. The linked Koa event will be kept.');
        if(!confirmed)return;
      }
      const original=button.textContent;
      button.disabled=true;button.textContent='Repairing…';
      try{
        const res=await fetch('/api/admin/calendar-office365',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({
            action:'repair_verification',
            repair:{
              type:repair?.type,
              recordId:repair?.recordId,
              eventId:repair?.eventId,
              confirmed:requiresConfirmation,
            },
          }),
        });
        const result=await res.json().catch(()=>({}));
        if(!res.ok||!result.ok)throw new Error(result?.error||'Repair failed');
        renderOffice365Verification({verification:result.verification});
        const statusEl=document.querySelector('[data-office365-status]');
        if(statusEl)statusEl.textContent=result.message||'Office 365 repair completed.';
        await loadOffice365Status();
      }catch(error){
        button.textContent='Repair failed';
        window.setTimeout(()=>{button.textContent=original;button.disabled=false;},1800);
        return;
      }
      button.disabled=false;button.textContent=original;
    }

