    $$('[data-analytics-range]').forEach(b=>{const active=b.dataset.analyticsRange===analyticsRange;b.classList.toggle('bg-[var(--koa-forest)]',active);b.classList.toggle('text-white',active);b.classList.toggle('border',!active);b.classList.toggle('border-[var(--koa-line)]',!active);b.classList.toggle('text-[var(--koa-forest)]',!active);});
