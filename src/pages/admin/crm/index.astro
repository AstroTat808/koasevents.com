  function countTrendSvg(rows){
    if(!rows?.length || !rows.some(r=>Number(r.bogusCaught||0)>0||Number(r.falsePositivesApproved||0)>0)) return '<div class="flex min-h-[240px] items-center justify-center rounded-xl bg-[var(--koa-sand)]/45 p-6 text-sm text-[var(--koa-ink)]/50">No cleanup trend data in this period yet.</div>';
    const width=900,height=260,left=44,right=18,top=18,bottom=48,max=Math.max(1,...rows.flatMap(r=>[Number(r.bogusCaught||0),Number(r.falsePositivesApproved||0)]));
    const x=i=>left+(rows.length===1?(width-left-right)/2:i*(width-left-right)/(rows.length-1)), y=v=>top+(max-Number(v||0))*(height-top-bottom)/max;
    const points=key=>rows.map((r,i)=>x(i)+','+y(r[key])).join(' ');
    const labels=rows.map((r,i)=>{const show=rows.length<=12||i===0||i===rows.length-1||i%Math.ceil(rows.length/8)===0;return show?'<text x="'+x(i)+'" y="'+(height-14)+'" text-anchor="middle" font-size="10" fill="currentColor" opacity=".48">'+esc(r.label)+'</text>':'';}).join('');
    const grid=[0,.25,.5,.75,1].map(f=>{const yy=top+(height-top-bottom)*f,val=Math.round(max*(1-f));return '<line x1="'+left+'" y1="'+yy+'" x2="'+(width-right)+'" y2="'+yy+'" stroke="currentColor" opacity=".08"/><text x="'+(left-8)+'" y="'+(yy+4)+'" text-anchor="end" font-size="10" fill="currentColor" opacity=".42">'+val+'</text>';}).join('');
    const dots=(key,fill)=>rows.map((r,i)=>'<circle class="cursor-pointer" data-count-point="'+i+'" data-count-metric="'+key+'" cx="'+x(i)+'" cy="'+y(r[key])+'" r="5" fill="'+fill+'"><title>'+esc(r.label)+': '+Number(r[key]||0)+'</title></circle>').join('');
    return '<div class="overflow-x-auto"><svg viewBox="0 0 '+width+' '+height+'" role="img" aria-label="Cleanup count trend chart" class="min-w-[720px] w-full text-[var(--koa-ink)]">'+grid+'<polyline fill="none" stroke="var(--koa-forest)" stroke-width="3" points="'+points('bogusCaught')+'"/><polyline fill="none" stroke="var(--koa-clay)" stroke-width="3" points="'+points('falsePositivesApproved')+'"/>'+dots('bogusCaught','var(--koa-forest)')+dots('falsePositivesApproved','var(--koa-clay)')+labels+'</svg></div>';
  }
  function accuracyTrendSvg(rows){
    if(!rows?.length || !rows.some(r=>r.falsePositiveRate!==null||r.autoTrashAccuracy!==null)) return '<div class="flex min-h-[240px] items-center justify-center rounded-xl bg-[var(--koa-sand)]/45 p-6 text-sm text-[var(--koa-ink)]/50">Accuracy needs reviewed or auto-trashed client outcomes before a trend can be calculated.</div>';
    const width=900,height=260,left=48,right=18,top=18,bottom=48;
    const x=i=>left+(rows.length===1?(width-left-right)/2:i*(width-left-right)/(rows.length-1)), y=v=>top+(100-Number(v||0))*(height-top-bottom)/100;
    const line=(key,stroke)=>{let out='',seg=[];const flush=()=>{if(seg.length>1)out+='<polyline fill="none" stroke="'+stroke+'" stroke-width="3" points="'+seg.join(' ')+'"/>';seg=[];};rows.forEach((r,i)=>{if(r[key]===null||r[key]===undefined)flush();else seg.push(x(i)+','+y(r[key]));});flush();return out;};
    const grid=[0,25,50,75,100].map(v=>'<line x1="'+left+'" y1="'+y(v)+'" x2="'+(width-right)+'" y2="'+y(v)+'" stroke="currentColor" opacity=".08"/><text x="'+(left-8)+'" y="'+(y(v)+4)+'" text-anchor="end" font-size="10" fill="currentColor" opacity=".42">'+v+'%</text>').join('');
    const labels=rows.map((r,i)=>{const show=rows.length<=12||i===0||i===rows.length-1||i%Math.ceil(rows.length/8)===0;return show?'<text x="'+x(i)+'" y="'+(height-14)+'" text-anchor="middle" font-size="10" fill="currentColor" opacity=".48">'+esc(r.label)+'</text>':'';}).join('');
    const dots=(key,fill)=>rows.map((r,i)=>r[key]===null||r[key]===undefined?'':'<circle class="cursor-pointer" data-accuracy-point="'+i+'" data-accuracy-metric="'+key+'" cx="'+x(i)+'" cy="'+y(r[key])+'" r="5" fill="'+fill+'"><title>'+esc(r.label)+': '+Number(r[key]).toFixed(1)+'%</title></circle>').join('');
    return '<div class="overflow-x-auto"><svg viewBox="0 0 '+width+' '+height+'" role="img" aria-label="Cleanup accuracy trend chart" class="min-w-[720px] w-full text-[var(--koa-ink)]">'+grid+line('falsePositiveRate','#b45309')+line('autoTrashAccuracy','#047857')+dots('falsePositiveRate','#b45309')+dots('autoTrashAccuracy','#047857')+labels+'</svg></div>';
  }
  function renderAnalytics(){
