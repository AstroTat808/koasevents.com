    const name=p.customer?.name||'this client';
    if(!confirm('Move '+name+' to Trash?\n\nThis removes the related inquiry/lead chain from the active pipeline for 30 days. Proposals, bookings, contracts, invoices, and payment-linked records are automatically protected.'))return;
    const button=$('[data-trash-client]'); const original=button.textContent; button.disabled=true; button.textContent='Moving…';
    try{
      const r=await fetch('/api/admin/quotes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'trash-client-chain',recordId:selectedId})});
      const j=await r.json().catch(()=>({})); if(!r.ok)throw new Error(j.error||'Unable to move client to Trash.');
      selectedId=''; $('[data-detail]').classList.add('hidden'); $('[data-detail-empty]').classList.remove('hidden');
      await load();
    }catch(err){alert(err.message||'Unable to move client to Trash.');}
    finally{button.disabled=false;button.textContent=original;}
  });
  $('[data-project-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'save-project',recordId:selectedId,projectStatus:f.projectStatus.value,owner:f.owner.value,company:f.company.value,address:f.address.value,partnerName:f.partnerName.value,sourceDetail:f.sourceDetail.value,tags:f.tags.value.split(',').map(x=>x.trim()).filter(Boolean)});await load();});
  $('[data-note-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'add-note',recordId:selectedId,body:f.body.value});f.reset();await load();});
  $('[data-task-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'add-task',recordId:selectedId,title:f.title.value,dueDate:f.dueDate.value,assignee:f.assignee.value,priority:f.priority.value});f.reset();await load();});
  $('[data-appointment-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'schedule-appointment',recordId:selectedId,title:f.title.value,startsAt:f.startsAt.value,durationMinutes:f.durationMinutes.value,location:f.location.value});f.reset();await load();});
  $('[data-enroll-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;if(!f.workflowId.value)return;await post({action:'enroll-workflow',recordId:selectedId,workflowId:f.workflowId.value});await load();});
  $('[data-workflow-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;const steps=f.steps.value.split('\n').map((line,i)=>{const [days,...rest]=line.split('|');return{id:'',label:'Step '+(i+1),offsetDays:Number(days)||0,taskTitle:rest.join('|').trim()}}).filter(x=>x.taskTitle);await post({action:'save-workflow',id:f.id.value,name:f.name.value,description:f.description.value,trigger:f.trigger.value,steps,active:f.active.checked});f.reset();f.active.checked=true;await load();});
  $('[data-template-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'save-template',id:f.id.value,type:f.type.value,name:f.name.value,subject:f.subject.value,body:f.body.value,active:f.active.checked});f.reset();f.active.checked=true;await load();});

  (async()=>{const user=await getUser();const ok=admin(user);$('[data-unauthorized]').classList.toggle('hidden',ok);$('[data-admin-ui]').classList.toggle('hidden',!ok);if(ok)await load();})();
</script>
</BaseLayout>
