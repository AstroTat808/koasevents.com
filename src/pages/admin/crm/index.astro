    $$('[data-breakdown]').forEach(b=>{const active=b.dataset.breakdown===analyticsBreakdown;b.classList.toggle('bg-[var(--koa-forest)]',active);b.classList.toggle('text-white',active);b.classList.toggle('border',!active);b.classList.toggle('border-[var(--koa-line)]',!active);b.classList.toggle('text-[var(--koa-forest)]',!active);});
    $$('[data-kpi-drilldown]').forEach(b=>b.onclick=()=>{const key=b.dataset.kpiDrilldown,labels={bogusCaught:'Bogus leads caught',falsePositivesApproved:'False positives approved',autoTrashed:'Automatically trashed clients',restores:'Restored clients',falsePositive:'False-positive cohort',autoTrashRetained:'Auto-trash accuracy cohort'};openAnalyticsDrilldown(labels[key]||'Clients',row.kpiClients?.[key]||[],analyticsRange+'-day reporting window');});
    $$('[data-breakdown-row]').forEach(b=>b.onclick=()=>{const item=breakdown[Number(b.dataset.breakdownRow)];if(item)openAnalyticsDrilldown(item.label,item.clients||[],item.count+' flagged client'+(item.count===1?'':'s')+' · '+analyticsRange+' days');});
    $$('[data-count-point]').forEach(b=>b.addEventListener('click',()=>{const item=trendRows[Number(b.dataset.countPoint)];if(!item)return;const key=b.dataset.countMetric,clients=key==='bogusCaught'?item.clients?.bogusCaught:item.clients?.falsePositivesApproved;openAnalyticsDrilldown(item.label+' · '+(key==='bogusCaught'?'Bogus caught':'False positives approved'),clients||[]);}));
    $$('[data-accuracy-point]').forEach(b=>b.addEventListener('click',()=>{const item=trendRows[Number(b.dataset.accuracyPoint)];if(!item)return;const key=b.dataset.accuracyMetric,clients=key==='falsePositiveRate'?item.clients?.falsePositive:item.clients?.autoTrashRetained;openAnalyticsDrilldown(item.label+' · '+(key==='falsePositiveRate'?'False-positive rate':'Auto-trash accuracy'),clients||[],key==='falsePositiveRate'?'Detected clients later approved legitimate.':'Auto-trashed clients not later restored or approved legitimate.');}));
