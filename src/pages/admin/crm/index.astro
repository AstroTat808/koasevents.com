---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Business CRM" description="Unified client, project, workflow, task, scheduling, communication and template management." canonical="https://koasevents.com/admin/crm/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin</p>
          <h1 class="display mt-3 text-5xl">Business CRM</h1>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-[var(--koa-ink)]/58">A unified client workspace inspired by the strongest HoneyBook and Dubsado patterns: project records, contacts, tasks, appointments, workflows, reusable templates, client links and activity history.</p>
        </div>
        <div class="flex flex-wrap gap-3 text-xs font-black uppercase tracking-[.1em]">
          <a href="/admin/quotes/" class="rounded-full border border-[var(--koa-line)] bg-white px-4 py-2 text-[var(--koa-forest)]">Sales CRM</a>
          <a href="/admin/events/" class="rounded-full border border-[var(--koa-line)] bg-white px-4 py-2 text-[var(--koa-forest)]">Event Ops</a>
          <a href="/admin/" class="rounded-full bg-[var(--koa-ink)] px-4 py-2 text-white">Admin home</a>
        </div>
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">Sign in with an administrator account at <a class="underline" href="/admin/">Koa’s Admin</a>.</div>

      <div data-admin-ui class="hidden grid gap-6">
        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-6">
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Projects</p><p data-stat-projects class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Open tasks</p><p data-stat-tasks class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Appointments</p><p data-stat-appointments class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-forest)] p-5 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Workflows</p><p data-stat-workflows class="display mt-3 text-4xl">0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-ink)] p-5 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Booked value</p><p data-stat-booked-value class="display mt-3 text-4xl">$0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-clay)] p-5 text-white"><p class="eyebrow text-white/70">Templates</p><p data-stat-templates class="display mt-3 text-4xl">0</p></article>
        </section>

        <section class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
          <div class="grid gap-4 lg:grid-cols-[1fr_180px_180px_190px]">
            <label class="grid gap-2 text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Search projects
              <input data-search type="search" placeholder="Client, email, phone, event date, package, tag…" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm font-medium normal-case tracking-normal text-[var(--koa-ink)]" />
            </label>
            <label class="grid gap-2 text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Stage
              <select data-stage-filter class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm font-medium normal-case tracking-normal">
                <option value="all">All stages</option><option value="inquiry">Inquiry</option><option value="lead">Lead</option><option value="proposal">Proposal</option><option value="booked">Booked</option><option value="lost">Lost</option>
              </select>
            </label>
            <label class="grid gap-2 text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Task status
              <select data-task-filter class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm font-medium normal-case tracking-normal">
                <option value="all">All projects</option><option value="due">Has open tasks</option><option value="clear">No open tasks</option>
              </select>
            </label>
            <label class="grid gap-2 text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Review status
              <select data-review-filter class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm font-medium normal-case tracking-normal">
                <option value="all">All clients</option><option value="needs-review">Needs Review</option><option value="approved">Approved legitimate</option><option value="clean">Clean</option>
              </select>
            </label>
          </div>
          <div class="mt-4 flex flex-col gap-3 rounded-xl bg-[var(--koa-sand)] p-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Bogus-client cleanup policy</p>
              <p class="mt-1 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/52">Choose whether high-confidence bogus/test clients are automatically moved to 30-day Trash, held in Needs Review, or only flagged.</p>
            </div>
            <form data-cleanup-settings class="flex flex-wrap items-end gap-2">
              <select name="mode" class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-2.5 text-sm">
                <option value="auto_trash">Auto-trash high confidence</option>
                <option value="review_first">Hold for review first</option>
                <option value="flag_only">Flag only — never auto-trash</option>
              </select>
              <button class="rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-[.6rem] font-black uppercase tracking-[.09em] text-white">Save policy</button>
              <span data-cleanup-policy-meta class="text-[.6rem] font-bold uppercase tracking-[.06em] text-[var(--koa-ink)]/40"></span>
            </form>
          </div>
        </section>

        <section class="grid gap-5 xl:grid-cols-[.78fr_1.22fr]">
          <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
            <div class="flex items-end justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">Projects + contacts</p><h2 class="display mt-2 text-3xl">Client pipeline</h2></div><span data-project-count class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">0 shown</span></div>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              <button type="button" data-select-visible class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Select visible</button>
              <button type="button" data-clear-selection class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Clear</button>
              <button type="button" data-bulk-trash class="hidden rounded-full bg-red-950 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white">Move selected to Trash</button>
              <button type="button" data-toggle-trash class="ml-auto rounded-full bg-[var(--koa-ink)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white">Trash <span data-trash-count>0</span></button>
            </div>
            <div data-project-list class="mt-5 grid max-h-[900px] gap-3 overflow-y-auto pr-1"></div>
            <div data-trash-panel class="mt-5 hidden border-t border-[var(--koa-line)] pt-5">
              <div class="flex items-end justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">30-day recovery</p><h3 class="display mt-2 text-3xl">Trash</h3></div><button type="button" data-close-trash class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Close</button></div>
              <p class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/48">Deleted inquiry and lead records remain here for 30 days. Restore them to the pipeline or permanently delete them.</p>
              <div data-trash-list class="mt-4 grid gap-3"></div>
            </div>
          </div>

          <div data-detail-empty class="rounded-[1.5rem] bg-[var(--koa-ink)] p-8 text-white shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-amber-light)]">Client workspace</p>
            <h2 class="display mt-3 text-4xl">Select a project</h2>
            <p class="mt-3 max-w-xl text-sm leading-6 text-white/60">Open any client to manage notes, tasks, appointments, tags, workflows, project metadata, client-facing links, payments and activity in one place.</p>
          </div>

          <div data-detail class="hidden grid gap-5">
            <section class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div><p data-detail-stage class="eyebrow text-[var(--koa-amber-light)]">Project</p><h2 data-detail-name class="display mt-2 text-4xl"></h2><p data-detail-contact class="mt-2 text-sm text-white/58"></p></div>
                <div class="flex flex-wrap gap-2">
                  <div data-detail-links class="flex flex-wrap gap-2"></div>
                  <button type="button" data-flag-client class="rounded-full border border-amber-200/35 bg-amber-900/25 px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em] text-amber-100">Flag for review</button>
                  <button type="button" data-approve-client class="hidden rounded-full border border-emerald-200/35 bg-emerald-900/35 px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em] text-emerald-100">Approve legitimate</button>
                  <button type="button" data-trash-client class="rounded-full border border-red-300/35 bg-red-950/25 px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em] text-red-100">Move to Trash</button>
                </div>
              </div>
              <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-xl border border-white/10 bg-white/[.05] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-white/45">Event date</p><p data-detail-date class="mt-1 font-semibold"></p></div>
                <div class="rounded-xl border border-white/10 bg-white/[.05] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-white/45">Package</p><p data-detail-package class="mt-1 font-semibold"></p></div>
                <div class="rounded-xl border border-white/10 bg-white/[.05] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-white/45">Proposal</p><p data-detail-proposal class="mt-1 font-semibold"></p></div>
                <div class="rounded-xl border border-white/10 bg-white/[.05] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-white/45">Payments</p><p data-detail-payments class="mt-1 font-semibold"></p></div>
              </div>
            </section>

            <section data-why-flagged class="hidden rounded-[1.5rem] border border-amber-200 bg-amber-50 p-5 shadow-[var(--shadow-soft)]">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div><p class="eyebrow text-amber-800">Cleanup review</p><h3 class="display mt-2 text-3xl text-[var(--koa-ink)]">Why flagged?</h3></div>
                <div class="rounded-full bg-amber-900 px-4 py-2 text-xs font-black uppercase tracking-[.09em] text-white">Risk score <span data-cleanup-score>0</span>/100</div>
              </div>
              <p data-cleanup-summary class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/65"></p>
              <div data-cleanup-signals class="mt-4 grid gap-2"></div>
            </section>

            <section class="grid gap-5 lg:grid-cols-2">
              <form data-project-form class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">Project details</p><h3 class="display mt-2 text-3xl">Contact + organization</h3>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  <label class="grid gap-1 text-xs font-bold">Status<input name="projectStatus" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Planning / VIP / On hold" /></label>
                  <label class="grid gap-1 text-xs font-bold">Owner<input name="owner" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Chris / Shaun" /></label>
                  <label class="grid gap-1 text-xs font-bold">Company<input name="company" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" /></label>
                  <label class="grid gap-1 text-xs font-bold">Partner / co-client<input name="partnerName" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" /></label>
                  <label class="grid gap-1 text-xs font-bold sm:col-span-2">Address<input name="address" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" /></label>
                  <label class="grid gap-1 text-xs font-bold">Source detail<input name="sourceDetail" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Planner referral, Google, venue tour…" /></label>
                  <label class="grid gap-1 text-xs font-bold">Tags<input name="tags" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="wedding, vip, repeat-client" /></label>
                </div>
                <button class="mt-4 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save project</button>
              </form>

              <form data-note-form class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">Internal notes</p><h3 class="display mt-2 text-3xl">Add a note</h3>
                <textarea name="body" rows="5" required class="mt-4 w-full rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm" placeholder="Client preferences, decisions, call notes, risks, special handling…"></textarea>
                <button class="mt-3 rounded-full bg-[var(--koa-ink)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Add note</button>
                <div data-notes class="mt-5 grid gap-3"></div>
              </form>
            </section>

            <section class="grid gap-5 lg:grid-cols-2">
              <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">Tasks</p><h3 class="display mt-2 text-3xl">Next actions</h3>
                <form data-task-form class="mt-4 grid gap-3 sm:grid-cols-2">
                  <input name="title" required class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm sm:col-span-2" placeholder="Task title" />
                  <input name="dueDate" type="date" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" />
                  <input name="assignee" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Assignee" />
                  <select name="priority" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm"><option value="normal">Normal priority</option><option value="high">High priority</option><option value="low">Low priority</option></select>
                  <button class="rounded-xl bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.09em] text-white">Add task</button>
                </form>
                <div data-tasks class="mt-5 grid gap-2"></div>
              </div>

              <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">Scheduling</p><h3 class="display mt-2 text-3xl">Appointments</h3>
                <form data-appointment-form class="mt-4 grid gap-3 sm:grid-cols-2">
                  <input name="title" required class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm sm:col-span-2" placeholder="Venue tour, planning call, final walkthrough…" />
                  <input name="startsAt" type="datetime-local" required class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" />
                  <input name="durationMinutes" type="number" min="15" max="480" value="60" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" />
                  <input name="location" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm sm:col-span-2" placeholder="Koa’s Events / phone / video / offsite" />
                  <button class="rounded-xl bg-[var(--koa-clay)] px-4 py-2.5 text-xs font-black uppercase tracking-[.09em] text-white sm:col-span-2">Schedule appointment</button>
                </form>
                <div data-appointments class="mt-5 grid gap-2"></div>
              </div>
            </section>

            <section class="grid gap-5 lg:grid-cols-2">
              <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <div class="flex items-end justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">Automation</p><h3 class="display mt-2 text-3xl">Enroll workflow</h3></div><a href="#workflow-builder" class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Manage workflows ↓</a></div>
                <div data-workflow-enrollments class="mt-4 grid gap-2"></div>
                <form data-enroll-form class="mt-4 flex gap-2">
                  <select name="workflowId" required class="min-w-0 flex-1 rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm"></select>
                  <button class="rounded-xl bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.09em] text-white">Enroll</button>
                </form>
              </div>

              <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">History</p><h3 class="display mt-2 text-3xl">Activity feed</h3>
                <div data-activity class="mt-4 grid max-h-[420px] gap-2 overflow-y-auto"></div>
              </div>
            </section>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div><p class="eyebrow text-[var(--koa-clay)]">Cleanup governance</p><h2 class="display mt-2 text-4xl">Cleanup audit log</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Automatic flags, manual reviews, approvals, Trash actions, restores, permanent deletions, and policy changes.</p></div>
            <label class="grid gap-1 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Show
              <select data-audit-filter class="rounded-xl border border-[var(--koa-line)] px-3 py-2 text-sm font-medium normal-case tracking-normal">
                <option value="all">All cleanup activity</option><option value="selected">Selected client only</option>
              </select>
            </label>
          </div>
          <div data-cleanup-audit class="mt-5 grid max-h-[560px] gap-2 overflow-y-auto"></div>
        </section>

        <section id="workflow-builder" class="grid gap-5 xl:grid-cols-2">
          <div class="rounded-[1.5rem] bg-[var(--koa-forest)] p-6 text-white shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-amber-light)]">Workflow builder</p><h2 class="display mt-2 text-4xl">Reusable process templates</h2>
            <p class="mt-2 text-sm leading-6 text-white/60">Build repeatable sequences. Enrolling a client creates dated tasks from each workflow step, giving Koa’s the same operational discipline as Dubsado/HoneyBook-style automations while keeping staff control.</p>
            <form data-workflow-form class="mt-5 grid gap-3">
              <input name="id" type="hidden" />
              <input name="name" required class="rounded-xl border border-white/15 bg-white/[.07] px-4 py-3 text-sm text-white placeholder:text-white/35" placeholder="Wedding booking workflow" />
              <textarea name="description" rows="2" class="rounded-xl border border-white/15 bg-white/[.07] px-4 py-3 text-sm text-white placeholder:text-white/35" placeholder="What this workflow does"></textarea>
              <select name="trigger" class="rounded-xl border border-white/15 bg-[var(--koa-ink)] px-4 py-3 text-sm text-white"><option value="manual">Manual</option><option value="new-inquiry">New inquiry</option><option value="proposal-sent">Proposal sent</option><option value="booked">Booked</option></select>
              <textarea name="steps" rows="6" required class="rounded-xl border border-white/15 bg-white/[.07] px-4 py-3 font-mono text-xs text-white placeholder:text-white/35" placeholder="0|Review inquiry and assign owner&#10;1|Send personalized follow-up&#10;3|Call if no reply&#10;7|Close loop or advance proposal"></textarea>
              <label class="flex items-center gap-2 text-sm"><input name="active" type="checkbox" checked /> Active</label>
              <button class="rounded-full bg-white px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Save workflow</button>
            </form>
          </div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Saved workflows</p><h2 class="display mt-2 text-4xl">Automation library</h2>
            <div data-workflows class="mt-5 grid gap-3"></div>
          </div>
        </section>

        <section class="grid gap-5 xl:grid-cols-2">
          <div class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-amber-light)]">Templates</p><h2 class="display mt-2 text-4xl">Reusable client content</h2>
            <form data-template-form class="mt-5 grid gap-3">
              <input name="id" type="hidden" />
              <select name="type" class="rounded-xl border border-white/15 bg-[var(--koa-forest)] px-4 py-3 text-sm text-white"><option value="email">Email</option><option value="form">Form</option><option value="questionnaire">Questionnaire</option><option value="proposal-note">Proposal note</option></select>
              <input name="name" required class="rounded-xl border border-white/15 bg-white/[.07] px-4 py-3 text-sm text-white placeholder:text-white/35" placeholder="Template name" />
              <input name="subject" class="rounded-xl border border-white/15 bg-white/[.07] px-4 py-3 text-sm text-white placeholder:text-white/35" placeholder="Email subject / internal label" />
              <textarea name="body" rows="8" required class="rounded-xl border border-white/15 bg-white/[.07] px-4 py-3 text-sm text-white placeholder:text-white/35" placeholder="Reusable content"></textarea>
              <label class="flex items-center gap-2 text-sm"><input name="active" type="checkbox" checked /> Active</label>
              <button class="rounded-full bg-white px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-ink)]">Save template</button>
            </form>
          </div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Template library</p><h2 class="display mt-2 text-4xl">Messages + forms</h2>
            <div data-templates class="mt-5 grid gap-3"></div>
          </div>
        </section>
      </div>
    </div>
  </main>

<script>
  import { getUser } from '@netlify/identity';
  const approvedAdminEmails = new Set(['chris@sibel.org','koasadmin@koasevents.com']);
  const $=(s)=>document.querySelector(s);
  const $$=(s)=>[...document.querySelectorAll(s)];
  let data={projects:[],tasks:[],appointments:[],notes:[],workflows:[],enrollments:[],templates:[],activity:[],messages:[],trash:[],trashGroups:[],cleanupAudit:[],cleanupSettings:{mode:'auto_trash'}};
  let selectedId='';
  const selectedProjects=new Set();
  let visibleProjectIds=[];

  function admin(user){ const email=String(user?.email||'').toLowerCase(); const roles=user?.app_metadata?.roles||[]; return approvedAdminEmails.has(email)||(Array.isArray(roles)&&roles.includes('admin')); }
  const money=(n)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(Number(n)||0);
  const esc=(s)=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const fmt=(s)=>{ if(!s)return '—'; const d=new Date(s); return Number.isNaN(d.getTime())?s:d.toLocaleString('en-US',{dateStyle:'medium',timeStyle:s.includes('T')?'short':undefined}); };
  async function post(payload){ const r=await fetch('/api/admin/crm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}); const j=await r.json().catch(()=>({})); if(!r.ok) throw new Error(j.error||'Request failed'); return j; }
  async function load(){
    const r=await fetch('/api/admin/crm',{cache:'no-store'}); if(!r.ok) throw new Error('Unable to load CRM');
    data=await r.json(); render();
  }
  function projectText(p){ return [p.customer?.name,p.customer?.email,p.customer?.phone,p.customer?.eventDate,p.packageId,p.stage,p.meta?.tags?.join(' '),p.meta?.company,p.meta?.partnerName].join(' ').toLowerCase(); }
  function openTasks(recordId){ return data.tasks.filter(t=>t.recordId===recordId&&t.status!=='done'); }
  function render(){
    const activeIds=new Set(data.projects.map(p=>p.id));
    $('[data-stat-projects]').textContent=data.projects.length;
    $('[data-stat-tasks]').textContent=data.tasks.filter(t=>activeIds.has(t.recordId)&&t.status!=='done').length;
    $('[data-stat-appointments]').textContent=data.appointments.filter(a=>activeIds.has(a.recordId)&&a.status==='scheduled').length;
    $('[data-stat-workflows]').textContent=data.workflows.filter(w=>w.active).length;
    $('[data-stat-templates]').textContent=data.templates.filter(t=>t.active).length;
    $('[data-stat-booked-value]').textContent=money(data.projects.filter(p=>p.stage==='booked').reduce((s,p)=>s+Number(p.proposal?.total||0),0));
    $('[data-trash-count]').textContent=(data.trashGroups||[]).length || data.trash.length;
    const settings=$('[data-cleanup-settings]'); if(settings) settings.mode.value=data.cleanupSettings?.mode||'auto_trash';
    const meta=$('[data-cleanup-policy-meta]'); if(meta) meta.textContent=data.cleanupSettings?.updatedAt?('Updated '+fmt(data.cleanupSettings.updatedAt)):'';
    renderProjects(); renderTrash(); renderAudit(); renderWorkflows(); renderTemplates(); if(selectedId) renderDetail();
  }
  function updateBulkUi(){
    const n=selectedProjects.size, b=$('[data-bulk-trash]');
    b.classList.toggle('hidden',n===0);
    b.textContent=n?('Move '+n+' selected to Trash'):'Move selected to Trash';
  }
  function renderProjects(){
    const q=String($('[data-search]')?.value||'').trim().toLowerCase();
    const stage=$('[data-stage-filter]')?.value||'all', tf=$('[data-task-filter]')?.value||'all', rf=$('[data-review-filter]')?.value||'all';
    const rows=data.projects.filter(p=>{
      const cleanup=p.cleanup||{disposition:'clean',approvedLegitimate:false};
      const reviewMatch=rf==='all' || (rf==='needs-review'&&(cleanup.disposition==='review'||cleanup.disposition==='auto_trash')) || (rf==='approved'&&cleanup.approvedLegitimate) || (rf==='clean'&&cleanup.disposition==='clean'&&!cleanup.approvedLegitimate);
      return (!q||projectText(p).includes(q))&&(stage==='all'||p.stage===stage)&&(tf==='all'||(tf==='due'?openTasks(p.id).length>0:openTasks(p.id).length===0))&&reviewMatch;
    });
    visibleProjectIds=rows.map(p=>p.id);
    $('[data-project-count]').textContent=rows.length+' shown';
    $('[data-project-list]').innerHTML=rows.length?rows.map(p=>{
      const tasks=openTasks(p.id).length;
      const tags=(p.meta?.tags||[]).slice(0,3).map(t=>'<span class="rounded-full bg-[var(--koa-sand)] px-2 py-1 text-[.58rem] font-black uppercase tracking-[.06em]">'+esc(t)+'</span>').join('');
      const cleanup=p.cleanup||{disposition:'clean',score:0,reasons:[]};
      const cleanupBadge=cleanup.disposition==='review'?'<span title="'+esc((cleanup.reasons||[]).join(' • '))+'" class="rounded-full bg-amber-100 px-2 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-amber-900">Review '+cleanup.score+'</span>':cleanup.disposition==='auto_trash'?'<span title="'+esc((cleanup.reasons||[]).join(' • '))+'" class="rounded-full bg-red-100 px-2 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-red-900">Auto-trash '+cleanup.score+'</span>':'';
      return '<div class="grid grid-cols-[auto_1fr] items-start gap-3 rounded-xl border '+(p.id===selectedId?'border-[var(--koa-clay)] bg-[var(--koa-sand)]':'border-[var(--koa-line)] bg-white')+' p-4 transition hover:border-[var(--koa-clay)]"><label class="mt-1 inline-flex cursor-pointer"><input data-project-check="'+esc(p.id)+'" type="checkbox" '+(selectedProjects.has(p.id)?'checked':'')+' class="h-4 w-4 accent-[var(--koa-forest)]"></label><button data-project="'+esc(p.id)+'" class="min-w-0 text-left"><div class="flex items-start justify-between gap-3"><div><strong class="text-base text-[var(--koa-ink)]">'+esc(p.customer?.name||'Unnamed client')+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/48">'+esc(p.customer?.eventDate||'No date')+' · '+esc(p.packageId||'No package')+'</p></div><div class="flex flex-wrap justify-end gap-1.5">'+cleanupBadge+'<span class="rounded-full bg-[var(--koa-forest)] px-2 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-white">'+esc(p.stage)+'</span></div></div><div class="mt-3 flex flex-wrap gap-1.5">'+tags+'</div><p class="mt-3 text-[.65rem] font-bold text-[var(--koa-clay)]">'+tasks+' open task'+(tasks===1?'':'s')+'</p></button></div>';
    }).join(''):'<p class="rounded-xl bg-[var(--koa-sand)] p-4 text-sm text-[var(--koa-ink)]/55">No projects match these filters.</p>';
    $('[data-project]').forEach(b=>b.addEventListener('click',()=>{selectedId=b.dataset.project;renderProjects();renderDetail();renderAudit();}));
    $$('[data-project-check]').forEach(ch=>ch.addEventListener('change',()=>{ch.checked?selectedProjects.add(ch.dataset.projectCheck):selectedProjects.delete(ch.dataset.projectCheck);updateBulkUi();}));
    updateBulkUi();
  }
  function renderTrash(){
    const groups=[...(data.trashGroups||[])].sort((a,b)=>String(b.deletedAt).localeCompare(String(a.deletedAt)));
    $('[data-trash-list]').innerHTML=groups.length?groups.map(g=>'<div class="rounded-xl border border-[var(--koa-line)] bg-white p-4"><div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><strong>'+esc(g.customerName||'Unnamed client')+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/48">'+esc(g.customerEmail||'No email')+' · '+esc(g.eventDate||'No date')+' · '+g.count+' related record'+(g.count===1?'':'s')+'</p><p class="mt-2 text-[.6rem] font-bold uppercase tracking-[.06em] text-[var(--koa-clay)]">Deleted '+fmt(g.deletedAt)+' · expires '+fmt(g.expiresAt)+'</p></div><div class="flex gap-2"><button data-restore-chain="'+esc(g.rootId)+'" class="rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white">Restore client</button><button data-permadelete-chain="'+esc(g.rootId)+'" class="rounded-full border border-red-300 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-red-800">Delete forever</button></div></div></div>').join(''):'<p class="rounded-xl bg-[var(--koa-sand)] p-4 text-sm text-[var(--koa-ink)]/50">Trash is empty.</p>';
    $$('[data-restore-chain]').forEach(b=>b.addEventListener('click',async()=>{const r=await fetch('/api/admin/quotes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'restore-client-chain',recordId:b.dataset.restoreChain})});const j=await r.json().catch(()=>({}));if(!r.ok){alert(j.error||'Restore failed.');return;}await load();}));
    $$('[data-permadelete-chain]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Permanently delete this entire trashed client chain? This cannot be undone.'))return;const r=await fetch('/api/admin/quotes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'permanent-delete-client-chain',recordId:b.dataset.permadeleteChain})});const j=await r.json().catch(()=>({}));if(!r.ok){alert(j.error||'Permanent delete failed.');return;}await load();}));
  }
  function renderAudit(){
    const mode=$('[data-audit-filter]')?.value||'all';
    const rows=(data.cleanupAudit||[]).filter(a=>mode!=='selected'||(selectedId&&a.recordId===selectedId)).slice(0,250);
    const names=new Map(data.projects.map(p=>[p.id,p.customer?.name||p.id]));
    $('[data-cleanup-audit]').innerHTML=rows.length?rows.map(a=>'<div class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 p-4"><div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">'+esc(String(a.action||'').replaceAll('_',' '))+'</p><strong class="mt-1 block text-sm">'+esc(names.get(a.recordId)||a.recordId||'System setting')+'</strong><p class="mt-1 text-sm leading-5 text-[var(--koa-ink)]/65">'+esc(a.detail||'')+'</p>'+(a.reasons?.length?'<p class="mt-2 text-xs text-[var(--koa-ink)]/48">'+a.reasons.map(esc).join(' • ')+'</p>':'')+'</div><div class="text-right"><p class="text-xs font-bold text-[var(--koa-ink)]/55">'+fmt(a.createdAt)+'</p><p class="mt-1 text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-ink)]/40">'+esc(a.actor||'system')+(a.score?(' · '+a.score+'/100'):'')+'</p></div></div></div>').join(''):'<p class="rounded-xl bg-[var(--koa-sand)] p-4 text-sm text-[var(--koa-ink)]/50">No cleanup audit activity matches this view yet.</p>';
  }

  function renderDetail(){
    const p=data.projects.find(x=>x.id===selectedId); if(!p)return;
    $('[data-detail-empty]').classList.add('hidden'); $('[data-detail]').classList.remove('hidden');
    $('[data-detail-stage]').textContent=(p.meta?.projectStatus||p.stage||'Project').toUpperCase();
    const cleanup=p.cleanup||{disposition:'clean',score:0,reasons:[],signals:[],approvedLegitimate:false,manuallyFlagged:false};
    const approve=$('[data-approve-client]'); if(approve) approve.classList.toggle('hidden',!(cleanup.disposition==='review'||cleanup.disposition==='auto_trash'));
    const flag=$('[data-flag-client]'); if(flag) flag.classList.toggle('hidden',cleanup.disposition==='review'||cleanup.disposition==='auto_trash');
    const why=$('[data-why-flagged]');
