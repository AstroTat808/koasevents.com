  }
  $('[data-search]')?.addEventListener('input',renderProjects); $('[data-stage-filter]')?.addEventListener('change',renderProjects); $('[data-task-filter]')?.addEventListener('change',renderProjects); $('[data-review-filter]')?.addEventListener('change',renderProjects);
  $('[data-cleanup-settings]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;const result=await post({action:'save-cleanup-settings',mode:f.mode.value});data.cleanupSettings=result.settings;await load();});
