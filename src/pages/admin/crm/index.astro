---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Business CRM" description="Unified client, project, workflow, task, scheduling, communication and template management." canonical="https://koasevents.com/admin/crm/">
  <main data-crm-watchdog class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Staff Workspace</p>
          <h1 class="display mt-3 text-5xl">Business CRM</h1>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-[var(--koa-ink)]/58">A unified client workspace inspired by the strongest HoneyBook and Dubsado patterns: project records, contacts, tasks, appointments, workflows, reusable templates, client links and activity history.</p>
        </div>
      </div>

      <div data-crm-status class="rounded-[1.4rem] border border-[var(--koa-line)] bg-white p-6 shadow-[var(--shadow-soft)]">
        <p class="eyebrow text-[var(--koa-clay)]">Business CRM</p>
        <p data-crm-status-message class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">Loading client workspace…</p>
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">Sign in with an authorized staff account at <a class="underline" href="/staff/">Koa’s Staff Workspace</a>.</div>

      <div data-admin-ui class="hidden grid gap-6">
        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-6">
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Projects</p><p data-stat-projects class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Open tasks</p><p data-stat-tasks class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Appointments</p><p data-stat-appointments class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-forest)] p-5 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Workflows</p><p data-stat-workflows class="display mt-3 text-4xl">0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-ink)] p-5 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Booked value</p><p data-stat-booked-value class="display mt-3 text-4xl">$0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-clay)] p-5 text-white"><p class="eyebrow text-white/70">Templates</p><p data-stat-templates class="display mt-3 text-4xl">0</p></article>
        </section>

        <section class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
          <div class="grid gap-4 lg:grid-cols-[1fr_180px_180px_190px]">
            <label class="grid gap-2 text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Search projects
              <input data-search type="search" placeholder="Client, email, phone, event date, package, tag…" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm font-medium normal-case tracking-normal text-[var(--koa-ink)]" />
            </label>
            <label class="grid gap-2 text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Stage
              <select data-stage-filter class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm font-medium normal-case tracking-normal">
                <option value="all">All stages</option><option value="inquiry">Inquiry</option><option value="lead">Lead</option><option value="proposal">Proposal</option><option value="booked">Booked</option><option value="lost">Lost</option>
              </select>
            </label>
            <label class="grid gap-2 text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Task status
              <select data-task-filter class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm font-medium normal-case tracking-normal">
                <option value="all">All projects</option><option value="due">Has open tasks</option><option value="clear">No open tasks</option>
              </select>
            </label>
            <label class="grid gap-2 text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Review status
              <select data-review-filter class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm font-medium normal-case tracking-normal">
                <option value="all">All clients</option><option value="needs-review">Needs Review</option><option value="approved">Approved legitimate</option><option value="clean">Clean</option>
              </select>
            </label>
          </div>
          <div class="mt-4 flex flex-col gap-3 rounded-xl bg-[var(--koa-sand)] p-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Bogus-client cleanup policy</p>
              <p class="mt-1 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/52">Choose whether high-confidence bogus/test clients are automatically moved to 30-day Trash, held in Needs Review, or only flagged.</p>
            </div>
            <form data-cleanup-settings class="flex flex-wrap items-end gap-2">
              <select name="mode" class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-2.5 text-sm">
                <option value="auto_trash">Auto-trash high confidence</option>
                <option value="review_first">Hold for review first</option>
                <option value="flag_only">Flag only — never auto-trash</option>
              </select>
              <button class="rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-[.6rem] font-black uppercase tracking-[.09em] text-white">Save policy</button>
              <span data-cleanup-policy-meta class="text-[.6rem] font-bold uppercase tracking-[.06em] text-[var(--koa-ink)]/40"></span>
            </form>
          </div>
        </section>

        <section class="grid gap-5 xl:grid-cols-[.78fr_1.22fr]">
          <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
            <div class="flex items-end justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">Projects + contacts</p><h2 class="display mt-2 text-3xl">Client pipeline</h2></div><span data-project-count class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">0 shown</span></div>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              <button type="button" data-select-visible class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Select visible</button>
              <button type="button" data-clear-selection class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Clear</button>
              <button type="button" data-approve-visible class="hidden rounded-full bg-emerald-800 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white">Approve visible as legitimate</button>
              <button type="button" data-bulk-trash class="hidden rounded-full bg-red-950 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white">Move selected to Trash</button>
              <button type="button" data-toggle-trash class="ml-auto rounded-full bg-[var(--koa-ink)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white">Trash <span data-trash-count>0</span></button>
            </div>
            <div data-project-list class="mt-5 grid max-h-[900px] gap-3 overflow-y-auto pr-1"></div>
            <div data-trash-panel class="mt-5 hidden border-t border-[var(--koa-line)] pt-5">
              <div class="flex items-end justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">30-day recovery</p><h3 class="display mt-2 text-3xl">Trash</h3></div><button type="button" data-close-trash class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Close</button></div>
              <p class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/48">Deleted inquiry and lead records remain here for 30 days. Restore them to the pipeline or permanently delete them.</p>
              <div data-trash-list class="mt-4 grid gap-3"></div>
            </div>
          </div>

          <div data-detail-empty class="rounded-[1.5rem] bg-[var(--koa-ink)] p-8 text-white shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-amber-light)]">Client workspace</p>
            <h2 class="display mt-3 text-4xl">Select a project</h2>
            <p class="mt-3 max-w-xl text-sm leading-6 text-white/60">Open any client to manage notes, tasks, appointments, tags, workflows, project metadata, client-facing links, payments and activity in one place.</p>
          </div>

          <div data-detail class="hidden grid gap-5">
            <section class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div><p data-detail-stage class="eyebrow text-[var(--koa-amber-light)]">Project</p><h2 data-detail-name class="display mt-2 text-4xl"></h2><p data-detail-contact class="mt-2 text-sm text-white/58"></p></div>
                <div class="flex flex-wrap gap-2">
                  <div data-detail-links class="flex flex-wrap gap-2"></div>
                  <button type="button" data-flag-client class="rounded-full border border-amber-200/35 bg-amber-900/25 px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em] text-amber-100">Flag for review</button>
                  <button type="button" data-approve-client class="hidden rounded-full border border-emerald-200/35 bg-emerald-900/35 px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em] text-emerald-100">Approve legitimate</button>
                  <button type="button" data-trash-client class="rounded-full border border-red-300/35 bg-red-950/25 px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em] text-red-100">Move to Trash</button>
                </div>
              </div>
              <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-xl border border-white/10 bg-white/[.05] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-white/45">Event date</p><p data-detail-date class="mt-1 font-semibold"></p></div>
                <div class="rounded-xl border border-white/10 bg-white/[.05] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-white/45">Package</p><p data-detail-package class="mt-1 font-semibold"></p></div>
                <div class="rounded-xl border border-white/10 bg-white/[.05] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-white/45">Proposal</p><p data-detail-proposal class="mt-1 font-semibold"></p></div>
                <div class="rounded-xl border border-white/10 bg-white/[.05] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-white/45">Payments</p><p data-detail-payments class="mt-1 font-semibold"></p></div>
              </div>
            </section>

            <section data-why-flagged class="hidden rounded-[1.5rem] border border-amber-200 bg-amber-50 p-5 shadow-[var(--shadow-soft)]">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div><p class="eyebrow text-amber-800">Cleanup review</p><h3 class="display mt-2 text-3xl text-[var(--koa-ink)]">Why flagged?</h3></div>
                <div class="rounded-full bg-amber-900 px-4 py-2 text-xs font-black uppercase tracking-[.09em] text-white">Risk score <span data-cleanup-score>0</span>/100</div>
              </div>
              <p data-cleanup-summary class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/65"></p>
              <div data-cleanup-signals class="mt-4 grid gap-2"></div>
            </section>

            <section class="grid gap-5 lg:grid-cols-2">
              <form data-project-form class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">Project details</p><h3 class="display mt-2 text-3xl">Contact + organization</h3>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  <label class="grid gap-1 text-xs font-bold">Status<input name="projectStatus" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Planning / VIP / On hold" /></label>
                  <label class="grid gap-1 text-xs font-bold">Owner<input name="owner" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Chris / Shaun" /></label>
                  <label class="grid gap-1 text-xs font-bold">Company<input name="company" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" /></label>
                  <label class="grid gap-1 text-xs font-bold">Partner / co-client<input name="partnerName" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" /></label>
                  <label class="grid gap-1 text-xs font-bold sm:col-span-2">Address<input name="address" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" /></label>
                  <label class="grid gap-1 text-xs font-bold">Source detail<input name="sourceDetail" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Planner referral, Google, venue tour…" /></label>
                  <label class="grid gap-1 text-xs font-bold">Tags<input name="tags" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="wedding, vip, repeat-client" /></label>
                </div>
                <button class="mt-4 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save project</button>
              </form>

              <form data-note-form class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">Internal notes</p><h3 class="display mt-2 text-3xl">Add a note</h3>
                <textarea name="body" rows="5" required class="mt-4 w-full rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm" placeholder="Client preferences, decisions, call notes, risks, special handling…"></textarea>
                <button class="mt-3 rounded-full bg-[var(--koa-ink)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Add note</button>
                <div data-notes class="mt-5 grid gap-3"></div>
              </form>
            </section>

            <section class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="eyebrow text-[var(--koa-clay)]">Client email</p>
                  <h3 class="display mt-2 text-3xl">Send a branded response</h3>
                  <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/55">Sent through Resend with the correct Koa’s Events or Koa’s Mobile Bar branding. Your staff name and role appear above the shared Koa’s contact details.</p>
                </div>
                <a href="/admin/email-preview/" class="shrink-0 rounded-full border border-[var(--koa-line)] px-4 py-2.5 text-[.6rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Email previews</a>
              </div>
              <form data-client-email-form class="mt-5 grid gap-3">
                <div class="grid gap-3 md:grid-cols-2">
                  <label class="grid gap-1 text-xs font-bold">Recipient<input data-client-email-recipient type="email" disabled class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-3 py-2.5 text-sm" /></label>
                  <label class="grid gap-1 text-xs font-bold">Use saved email template
                    <select data-client-email-template class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm"><option value="">Write from scratch</option></select>
                  </label>
                </div>
                <label class="grid gap-1 text-xs font-bold">Subject<input name="subject" required maxlength="300" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Your Koa’s event details" /></label>
                <label class="grid gap-1 text-xs font-bold">Message<textarea name="body" required rows="7" maxlength="16000" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm leading-6" placeholder="Write the message body. The Aloha greeting, logo, and personalized signature are added automatically."></textarea></label>
                <div class="flex flex-wrap items-center gap-3">
                  <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Send branded email</button>
                  <span data-client-email-status class="text-sm text-[var(--koa-ink)]/55"></span>
                </div>
              </form>
            </section>

            <section class="grid gap-5 lg:grid-cols-2">
              <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">Tasks</p><h3 class="display mt-2 text-3xl">Next actions</h3>
                <form data-task-form class="mt-4 grid gap-3 sm:grid-cols-2">
                  <input name="title" required class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm sm:col-span-2" placeholder="Task title" />
                  <input name="dueDate" type="date" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" />
                  <input name="assignee" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" placeholder="Assignee" />
                  <select name="priority" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm"><option value="normal">Normal priority</option><option value="high">High priority</option><option value="low">Low priority</option></select>
                  <button class="rounded-xl bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.09em] text-white">Add task</button>
                </form>
                <div data-tasks class="mt-5 grid gap-2"></div>
              </div>

              <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">Scheduling</p><h3 class="display mt-2 text-3xl">Appointments</h3>
                <form data-appointment-form class="mt-4 grid gap-3 sm:grid-cols-2">
                  <input name="title" required class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm sm:col-span-2" placeholder="Venue tour, planning call, final walkthrough…" />
                  <input name="startsAt" type="datetime-local" required class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" />
                  <input name="durationMinutes" type="number" min="15" max="480" value="60" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm" />
                  <input name="location" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm sm:col-span-2" placeholder="Koa’s Events / phone / video / offsite" />
                  <button class="rounded-xl bg-[var(--koa-clay)] px-4 py-2.5 text-xs font-black uppercase tracking-[.09em] text-white sm:col-span-2">Schedule appointment</button>
                </form>
                <div data-appointments class="mt-5 grid gap-2"></div>
              </div>
            </section>

            <section class="grid gap-5 lg:grid-cols-2">
              <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <div class="flex items-end justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">Automation</p><h3 class="display mt-2 text-3xl">Enroll workflow</h3></div><a href="#workflow-builder" class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Manage workflows ↓</a></div>
                <div data-workflow-enrollments class="mt-4 grid gap-2"></div>
                <form data-enroll-form class="mt-4 flex gap-2">
                  <select name="workflowId" required class="min-w-0 flex-1 rounded-xl border border-[var(--koa-line)] px-3 py-2.5 text-sm"></select>
                  <button class="rounded-xl bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.09em] text-white">Enroll</button>
                </form>
              </div>

              <div class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
                <p class="eyebrow text-[var(--koa-clay)]">History</p><h3 class="display mt-2 text-3xl">Activity feed</h3>
                <div data-activity class="mt-4 grid max-h-[420px] gap-2 overflow-y-auto"></div>
              </div>
            </section>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div><p class="eyebrow text-[var(--koa-clay)]">Cleanup intelligence</p><h2 class="display mt-2 text-4xl">Cleanup analytics</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Trend, source, domain, form, brand, and security-reason analysis for bogus leads and false positives.</p></div>
            <div class="flex gap-2">
              <button data-analytics-range="7" class="rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white">7 days</button>
              <button data-analytics-range="30" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">30 days</button>
              <button data-analytics-range="90" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">90 days</button>
            </div>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-6">
            <button type="button" data-kpi-drilldown="bogusCaught" class="rounded-xl bg-[var(--koa-sand)] p-4 text-left transition hover:ring-2 hover:ring-[var(--koa-clay)]/30"><p class="text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Bogus leads caught</p><p data-analytics-caught class="display mt-2 text-3xl text-[var(--koa-forest)]">0</p><p class="mt-1 text-[.58rem] font-bold uppercase tracking-[.05em] text-[var(--koa-ink)]/35">Click to inspect</p></button>
            <button type="button" data-kpi-drilldown="falsePositivesApproved" class="rounded-xl bg-[var(--koa-sand)] p-4 text-left transition hover:ring-2 hover:ring-[var(--koa-clay)]/30"><p class="text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">False positives approved</p><p data-analytics-false-positive class="display mt-2 text-3xl text-[var(--koa-forest)]">0</p><p class="mt-1 text-[.58rem] font-bold uppercase tracking-[.05em] text-[var(--koa-ink)]/35">Click to inspect</p></button>
            <button type="button" data-kpi-drilldown="autoTrashed" class="rounded-xl bg-[var(--koa-sand)] p-4 text-left transition hover:ring-2 hover:ring-[var(--koa-clay)]/30"><p class="text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Auto-trashed</p><p data-analytics-auto-trash class="display mt-2 text-3xl text-[var(--koa-forest)]">0</p><p class="mt-1 text-[.58rem] font-bold uppercase tracking-[.05em] text-[var(--koa-ink)]/35">Click to inspect</p></button>
            <button type="button" data-kpi-drilldown="restores" class="rounded-xl bg-[var(--koa-sand)] p-4 text-left transition hover:ring-2 hover:ring-[var(--koa-clay)]/30"><p class="text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Restores</p><p data-analytics-restores class="display mt-2 text-3xl text-[var(--koa-forest)]">0</p><p class="mt-1 text-[.58rem] font-bold uppercase tracking-[.05em] text-[var(--koa-ink)]/35">Click to inspect</p></button>
