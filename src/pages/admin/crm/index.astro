<script is:inline>
  (() => {
    const meta = (name) => document.querySelector('meta[name="'+name+'"]')?.getAttribute('content') || '';
    const deployId = meta('koa-deploy-id');
    const commit = meta('koa-build-commit');
    let finished = false;
    let timer = null;

    const send = async (status, phase, detail) => {
      if (finished && status === 'failed') return;
      if (status === 'healthy') finished = true;
      if (timer) clearTimeout(timer);
      try {
        await fetch('/api/admin/crm',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          credentials:'same-origin',
          keepalive:true,
          body:JSON.stringify({action:'report-startup-health',status,phase,detail,deployId,commit}),
        });
      } catch {}
    };

    window.__koaCrmStartupWatchdog = {
      healthy(detail='CRM interface rendered') { send('healthy','rendered',detail); },
      failed(phase='browser-error',detail='CRM startup failed') { send('failed',phase,detail); },
    };

    const pending = window.__koaCrmStartupPending;
    if (pending) {
      window.__koaCrmStartupPending = null;
      window.__koaCrmStartupWatchdog[pending.status === 'healthy' ? 'healthy' : 'failed'](pending.phase, pending.detail);
      return;
    }

    (async () => {
      try {
        const response = await fetch('/api/admin/session',{cache:'no-store',credentials:'same-origin',signal:AbortSignal.timeout(8000)});
        if (!response.ok) return;
        const session = await response.json();
        const capabilities = new Set(session?.capabilities || session?.permissions || []);
        if (session?.accessBlocked || (!session?.isAdmin && !capabilities.has('crm.view'))) return;
        timer = setTimeout(() => {
          window.__koaCrmStartupWatchdog?.failed('browser-timeout','CRM page shell loaded but the client workspace did not finish initializing within 20 seconds.');
        }, 20000);
      } catch {}
    })();
  })();
</script>

<script is:inline>
    const approvedAdminEmails = new Set(['chris@sibel.org','koasadmin@koasevents.com']);
  const $=(s)=>document.querySelector(s);
  const $$=(s)=>[...document.querySelectorAll(s)];
  let data={projects:[],tasks:[],appointments:[],notes:[],workflows:[],enrollments:[],templates:[],activity:[],messages:[],trash:[],trashGroups:[],cleanupAudit:[],cleanupAnalytics:{},cleanupSettings:{mode:'auto_trash'}};
  let analyticsRange='7';
  let trendGranularity='day';
  let analyticsBreakdown='websiteForm';
  let bulkApproveIds=[];
  let selectedId='';
  const selectedProjects=new Set();
  let visibleProjectIds=[];

  function can(permission){ return Array.isArray(data.access?.capabilities) && data.access.capabilities.includes(permission); }
  function applyRoleUi(){
    if(!can('crm.cleanup_policy')) $('[data-cleanup-settings]')?.classList.add('hidden');
    if(!can('crm.destructive')) ['[data-bulk-trash]','[data-toggle-trash]','[data-trash-client]'].forEach((selector)=>$(selector)?.classList.add('hidden'));
    if(!can('crm.workflows')) $('[data-workflow-form]')?.closest('section')?.classList.add('hidden');
    if(!can('crm.templates')) $('[data-template-form]')?.closest('section')?.classList.add('hidden');
  }
  const money=(n)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(Number(n)||0);
  const esc=(s)=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const fmt=(s)=>{ if(!s)return '—'; const d=new Date(s); return Number.isNaN(d.getTime())?s:d.toLocaleString('en-US',{dateStyle:'medium',timeStyle:s.includes('T')?'short':undefined}); };
  async function post(payload){ const r=await fetch('/api/admin/crm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}); const j=await r.json().catch(()=>({})); if(!r.ok) throw new Error(j.error||'Request failed'); return j; }
  async function load(){
    const status=$('[data-crm-status]');
    const statusMessage=$('[data-crm-status-message]');
    status?.classList.remove('hidden');
    if(statusMessage) statusMessage.textContent='Loading client workspace…';
    const r=await fetch('/api/admin/crm',{cache:'no-store',credentials:'same-origin',signal:AbortSignal.timeout(15000)});
    if(r.status===401||r.status===403){
      status?.classList.add('hidden');
      $('[data-admin-ui]')?.classList.add('hidden');
      $('[data-unauthorized]')?.classList.remove('hidden');
      return false;
    }
    if(!r.ok) throw new Error('Unable to load CRM (HTTP '+r.status+')');
    data=await r.json();
    status?.classList.add('hidden');
    $('[data-unauthorized]')?.classList.add('hidden');
    $('[data-admin-ui]')?.classList.remove('hidden');
    applyRoleUi();
    render();
    const watchdog=window.__koaCrmStartupWatchdog;
    if(watchdog) watchdog.healthy('Business CRM data loaded and interface rendered.');
    else window.__koaCrmStartupPending={status:'healthy',phase:'rendered',detail:'Business CRM data loaded and interface rendered.'};
    return true;
  }
  function projectText(p){ return [p.customer?.name,p.customer?.email,p.customer?.phone,p.customer?.eventDate,p.packageId,p.stage,p.meta?.tags?.join(' '),p.meta?.company,p.meta?.partnerName].join(' ').toLowerCase(); }
  function openTasks(recordId){ return data.tasks.filter(t=>t.recordId===recordId&&t.status!=='done'); }
  function render(){
    const activeIds=new Set(data.projects.map(p=>p.id));
    $('[data-stat-projects]').textContent=data.projects.length;
    $('[data-stat-tasks]').textContent=data.tasks.filter(t=>activeIds.has(t.recordId)&&t.status!=='done').length;
    $('[data-stat-appointments]').textContent=data.appointments.filter(a=>activeIds.has(a.recordId)&&a.status==='scheduled').length;
    $('[data-stat-workflows]').textContent=data.workflows.filter(w=>w.active).length;
    $('[data-stat-templates]').textContent=data.templates.filter(t=>t.active).length;
    $('[data-stat-booked-value]').textContent=money(data.projects.filter(p=>p.stage==='booked').reduce((s,p)=>s+Number(p.proposal?.total||0),0));
    $('[data-trash-count]').textContent=(data.trashGroups||[]).length || data.trash.length;
    const settings=$('[data-cleanup-settings]'); if(settings) settings.mode.value=data.cleanupSettings?.mode||'auto_trash';
    const meta=$('[data-cleanup-policy-meta]'); if(meta) meta.textContent=data.cleanupSettings?.updatedAt?('Updated '+fmt(data.cleanupSettings.updatedAt)):'';
    renderProjects(); renderTrash(); renderAnalytics(); renderAudit(); renderWorkflows(); renderTemplates(); if(selectedId) renderDetail();
  }
  function updateBulkUi(){
    const n=selectedProjects.size, b=$('[data-bulk-trash]');
    b.classList.toggle('hidden',n===0);
    b.textContent=n?('Move '+n+' selected to Trash'):'Move selected to Trash';
    const reviewFilter=$('[data-review-filter]')?.value||'all';
    const approveVisible=$('[data-approve-visible]');
    if(approveVisible){
      const eligible=visibleProjectIds.filter(id=>{const p=data.projects.find(x=>x.id===id);return p&&p.cleanup&&!p.cleanup.approvedLegitimate&&['review','auto_trash'].includes(p.cleanup.disposition);});
      approveVisible.classList.toggle('hidden',reviewFilter!=='needs-review'||eligible.length===0);
      approveVisible.textContent=eligible.length?('Approve '+eligible.length+' visible as legitimate'):'Approve visible as legitimate';
    }
  }
  function renderProjects(){
    const q=String($('[data-search]')?.value||'').trim().toLowerCase();
    const stage=$('[data-stage-filter]')?.value||'all', tf=$('[data-task-filter]')?.value||'all', rf=$('[data-review-filter]')?.value||'all';
    const rows=data.projects.filter(p=>{
      const cleanup=p.cleanup||{disposition:'clean',approvedLegitimate:false};
      const reviewMatch=rf==='all' || (rf==='needs-review'&&(cleanup.disposition==='review'||cleanup.disposition==='auto_trash')) || (rf==='approved'&&cleanup.approvedLegitimate) || (rf==='clean'&&cleanup.disposition==='clean'&&!cleanup.approvedLegitimate);
      return (!q||projectText(p).includes(q))&&(stage==='all'||p.stage===stage)&&(tf==='all'||(tf==='due'?openTasks(p.id).length>0:openTasks(p.id).length===0))&&reviewMatch;
    });
    visibleProjectIds=rows.map(p=>p.id);
    $('[data-project-count]').textContent=rows.length+' shown';
    $('[data-project-list]').innerHTML=rows.length?rows.map(p=>{
      const tasks=openTasks(p.id).length;
      const tags=(p.meta?.tags||[]).slice(0,3).map(t=>'<span class="rounded-full bg-[var(--koa-sand)] px-2 py-1 text-[.58rem] font-black uppercase tracking-[.06em]">'+esc(t)+'</span>').join('');
      const cleanup=p.cleanup||{disposition:'clean',score:0,reasons:[]};
      const cleanupBadge=cleanup.disposition==='review'?'<span title="'+esc((cleanup.reasons||[]).join(' • '))+'" class="rounded-full bg-amber-100 px-2 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-amber-900">Review '+cleanup.score+'</span>':cleanup.disposition==='auto_trash'?'<span title="'+esc((cleanup.reasons||[]).join(' • '))+'" class="rounded-full bg-red-100 px-2 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-red-900">Auto-trash '+cleanup.score+'</span>':'';
      return '<div class="grid grid-cols-[auto_1fr] items-start gap-3 rounded-xl border '+(p.id===selectedId?'border-[var(--koa-clay)] bg-[var(--koa-sand)]':'border-[var(--koa-line)] bg-white')+' p-4 transition hover:border-[var(--koa-clay)]"><label class="mt-1 inline-flex cursor-pointer"><input data-project-check="'+esc(p.id)+'" type="checkbox" '+(selectedProjects.has(p.id)?'checked':'')+' class="h-4 w-4 accent-[var(--koa-forest)]"></label><button data-project="'+esc(p.id)+'" class="min-w-0 text-left"><div class="flex items-start justify-between gap-3"><div><strong class="text-base text-[var(--koa-ink)]">'+esc(p.customer?.name||'Unnamed client')+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/48">'+esc(p.customer?.eventDate||'No date')+' · '+esc(p.packageId||'No package')+'</p></div><div class="flex flex-wrap justify-end gap-1.5">'+cleanupBadge+'<span class="rounded-full bg-[var(--koa-forest)] px-2 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-white">'+esc(p.stage)+'</span></div></div><div class="mt-3 flex flex-wrap gap-1.5">'+tags+'</div><p class="mt-3 text-[.65rem] font-bold text-[var(--koa-clay)]">'+tasks+' open task'+(tasks===1?'':'s')+'</p></button></div>';
    }).join(''):'<p class="rounded-xl bg-[var(--koa-sand)] p-4 text-sm text-[var(--koa-ink)]/55">No projects match these filters.</p>';
    $('[data-project]').forEach(b=>b.addEventListener('click',()=>{selectedId=b.dataset.project;renderProjects();renderDetail();renderAudit();}));
    $$('[data-project-check]').forEach(ch=>ch.addEventListener('change',()=>{ch.checked?selectedProjects.add(ch.dataset.projectCheck):selectedProjects.delete(ch.dataset.projectCheck);updateBulkUi();}));
    updateBulkUi();
