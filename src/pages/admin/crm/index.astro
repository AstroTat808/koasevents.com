    if(why) why.classList.toggle('hidden',!showWhy);
    if(showWhy){
      $('[data-cleanup-score]').textContent=cleanup.score||0;
      $('[data-cleanup-summary]').textContent=cleanup.disposition==='auto_trash'?'This record meets the high-confidence bogus/test threshold. Review the contributing signals before approving or moving it to Trash.':'This record has one or more signals that warrant manual review.';
      $('[data-cleanup-signals]').innerHTML=(cleanup.signals||[]).map(s=>'<div class="flex items-start justify-between gap-4 rounded-xl bg-white p-3"><div><strong class="text-sm">'+esc(s.reason)+'</strong><p class="mt-1 text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-ink)]/40">'+esc(s.code.replaceAll('_',' '))+'</p></div><span class="rounded-full '+(Number(s.score)>=70?'bg-red-100 text-red-900':Number(s.score)>=35?'bg-amber-100 text-amber-900':'bg-[var(--koa-sand)] text-[var(--koa-ink)]')+' px-2 py-1 text-[.58rem] font-black">+'+Number(s.score||0)+'</span></div>').join('');
    }
    $('[data-detail-name]').textContent=p.customer?.name||'Unnamed client';
    $('[data-detail-contact]').textContent=[p.customer?.email,p.customer?.phone].filter(Boolean).join(' · ')||'No contact details';
    $('[data-detail-date]').textContent=p.customer?.eventDate||'—'; $('[data-detail-package]').textContent=p.packageId||'—';
    $('[data-detail-proposal]').textContent=p.proposal?((p.proposal.status||'proposal')+' · '+money(p.proposal.total)):'—';
    const payments=p.booking?.payments||[]; const paid=payments.filter(x=>x.status==='paid').reduce((s,x)=>s+Number(x.amount||0),0); const total=payments.reduce((s,x)=>s+Number(x.amount||0),0);
    $('[data-detail-payments]').textContent=payments.length?money(paid)+' / '+money(total):'—';
    const links=[]; if(p.proposal?.publicToken)links.push('<a target="_blank" href="/proposal/?token='+encodeURIComponent(p.proposal.publicToken)+'" class="rounded-full border border-white/15 bg-white/[.06] px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em]">Proposal</a>');
    if(p.stage==='booked')links.push('<a href="/admin/events/?recordId='+encodeURIComponent(p.id)+'" class="rounded-full border border-white/15 bg-white/[.06] px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em]">Event Ops</a>');
    links.push('<a href="/planning/?record='+encodeURIComponent(p.id)+'" target="_blank" class="rounded-full border border-white/15 bg-white/[.06] px-3 py-2 text-[.6rem] font-black uppercase tracking-[.08em]">Client planning</a>');
    $('[data-detail-links]').innerHTML=links.join('');
    const f=$('[data-project-form]'); f.projectStatus.value=p.meta?.projectStatus||''; f.owner.value=p.meta?.owner||''; f.company.value=p.meta?.company||''; f.address.value=p.meta?.address||''; f.partnerName.value=p.meta?.partnerName||''; f.sourceDetail.value=p.meta?.sourceDetail||''; f.tags.value=(p.meta?.tags||[]).join(', ');
    $('[data-notes]').innerHTML=data.notes.filter(n=>n.recordId===p.id).slice(0,12).map(n=>'<div class="rounded-xl bg-[var(--koa-sand)] p-3"><p class="text-sm leading-6">'+esc(n.body)+'</p><p class="mt-2 text-[.6rem] font-bold uppercase tracking-[.06em] text-[var(--koa-ink)]/42">'+esc(n.createdBy)+' · '+fmt(n.createdAt)+'</p></div>').join('')||'<p class="text-sm text-[var(--koa-ink)]/45">No notes yet.</p>';
    $('[data-tasks]').innerHTML=data.tasks.filter(t=>t.recordId===p.id).sort((a,b)=>String(a.dueDate).localeCompare(String(b.dueDate))).map(t=>'<button data-task-toggle="'+esc(t.id)+'" class="flex items-start justify-between gap-3 rounded-xl border border-[var(--koa-line)] p-3 text-left '+(t.status==='done'?'opacity-50':'')+'"><div><strong class="text-sm">'+esc(t.title)+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/45">'+esc(t.dueDate||'No due date')+(t.assignee?' · '+esc(t.assignee):'')+' · '+esc(t.priority)+'</p></div><span class="text-xs font-black uppercase text-[var(--koa-clay)]">'+(t.status==='done'?'Done':'Open')+'</span></button>').join('')||'<p class="text-sm text-[var(--koa-ink)]/45">No tasks yet.</p>';
    $$('[data-task-toggle]').forEach(b=>b.addEventListener('click',async()=>{await post({action:'toggle-task',taskId:b.dataset.taskToggle});await load();}));
    $('[data-appointments]').innerHTML=data.appointments.filter(a=>a.recordId===p.id).sort((a,b)=>String(a.startsAt).localeCompare(String(b.startsAt))).map(a=>'<div class="rounded-xl border border-[var(--koa-line)] p-3"><div class="flex justify-between gap-3"><div><strong class="text-sm">'+esc(a.title)+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/45">'+fmt(a.startsAt)+' · '+a.durationMinutes+' min'+(a.location?' · '+esc(a.location):'')+'</p></div><span class="text-[.6rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">'+esc(a.status)+'</span></div></div>').join('')||'<p class="text-sm text-[var(--koa-ink)]/45">No appointments yet.</p>';
    const options=data.workflows.filter(w=>w.active).map(w=>'<option value="'+esc(w.id)+'">'+esc(w.name)+'</option>').join(''); $('[data-enroll-form] select').innerHTML='<option value="">Choose workflow…</option>'+options;
