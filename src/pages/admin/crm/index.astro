    const timeline=[
      ...data.activity.filter(a=>a.recordId===p.id).map(a=>({type:a.type,detail:a.detail,createdAt:a.createdAt,kind:'activity'})),
      ...(data.messages||[]).filter(m=>m.recordId===p.id).map(m=>({type:'client message',detail:(m.senderName||m.sender||'Client')+': '+m.message,createdAt:m.createdAt,kind:'message'}))
    ].sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt))).slice(0,40);
