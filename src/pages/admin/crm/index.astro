    $('[data-appointments]').innerHTML=data.appointments.filter(a=>a.recordId===p.id).sort((a,b)=>String(a.startsAt).localeCompare(String(b.startsAt))).map(a=>'<div class="rounded-xl border border-[var(--koa-line)] p-3"><div class="flex justify-between gap-3"><div><strong class="text-sm">'+esc(a.title)+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/45">'+fmt(a.startsAt)+' · '+a.durationMinutes+' min'+(a.location?' · '+esc(a.location):'')+'</p></div><span class="text-[.6rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">'+esc(a.status)+'</span></div></div>').join('')||'<p class="text-sm text-[var(--koa-ink)]/45">No appointments yet.</p>';
    const options=data.workflows.filter(w=>w.active).map(w=>'<option value="'+esc(w.id)+'">'+esc(w.name)+'</option>').join(''); $('[data-enroll-form] select').innerHTML='<option value="">Choose workflow…</option>'+options;
    $('[data-workflow-enrollments]').innerHTML=data.enrollments.filter(e=>e.recordId===p.id).slice(0,8).map(e=>{const w=data.workflows.find(x=>x.id===e.workflowId);return '<div class="rounded-xl bg-[var(--koa-sand)] p-3 text-sm"><strong>'+esc(w?.name||'Workflow')+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/45">'+fmt(e.startedAt)+' · '+e.createdTaskIds.length+' tasks</p></div>'}).join('')||'<p class="text-sm text-[var(--koa-ink)]/45">No workflows enrolled.</p>';
    const timeline=[
      ...data.activity.filter(a=>a.recordId===p.id).map(a=>({type:a.type,detail:a.detail,createdAt:a.createdAt,kind:'activity'})),
      ...(data.messages||[]).filter(m=>m.recordId===p.id).map(m=>({type:'client message',detail:(m.senderName||m.sender||'Client')+': '+m.message,createdAt:m.createdAt,kind:'message'}))
    ].sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt))).slice(0,40);
    $('[data-activity]').innerHTML=timeline.map(a=>'<div class="rounded-xl bg-[var(--koa-sand)] p-3"><p class="text-[.58rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]">'+esc(a.type.replaceAll('_',' '))+'</p><p class="mt-1 text-sm">'+esc(a.detail)+'</p><p class="mt-1 text-xs text-[var(--koa-ink)]/40">'+fmt(a.createdAt)+'</p></div>').join('')||'<p class="text-sm text-[var(--koa-ink)]/45">No CRM activity yet.</p>';
  }
  function renderWorkflows(){
    $('[data-workflows]').innerHTML=data.workflows.length?data.workflows.map(w=>'<button data-edit-workflow="'+esc(w.id)+'" class="rounded-xl border border-[var(--koa-line)] p-4 text-left"><div class="flex justify-between gap-3"><strong>'+esc(w.name)+'</strong><span class="text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">'+esc(w.trigger)+'</span></div><p class="mt-2 text-sm text-[var(--koa-ink)]/55">'+esc(w.description||'No description')+'</p><p class="mt-2 text-xs text-[var(--koa-ink)]/42">'+w.steps.length+' step'+(w.steps.length===1?'':'s')+' · '+(w.active?'Active':'Paused')+'</p></button>').join(''):'<p class="text-sm text-[var(--koa-ink)]/45">No workflows saved yet.</p>';
    $$('[data-edit-workflow]').forEach(b=>b.addEventListener('click',()=>{const w=data.workflows.find(x=>x.id===b.dataset.editWorkflow);const f=$('[data-workflow-form]');f.id.value=w.id;f.name.value=w.name;f.description.value=w.description;f.trigger.value=w.trigger;f.active.checked=w.active;f.steps.value=w.steps.map(s=>s.offsetDays+'|'+s.taskTitle).join('\n');f.scrollIntoView({behavior:'smooth',block:'center'});}));
  }
  function renderTemplates(){
    $('[data-templates]').innerHTML=data.templates.length?data.templates.map(t=>'<button data-edit-template="'+esc(t.id)+'" class="rounded-xl border border-[var(--koa-line)] p-4 text-left"><div class="flex justify-between gap-3"><strong>'+esc(t.name)+'</strong><span class="text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">'+esc(t.type)+'</span></div><p class="mt-2 line-clamp-2 text-sm text-[var(--koa-ink)]/55">'+esc(t.subject||t.body)+'</p></button>').join(''):'<p class="text-sm text-[var(--koa-ink)]/45">No templates saved yet.</p>';
    $$('[data-edit-template]').forEach(b=>b.addEventListener('click',()=>{const t=data.templates.find(x=>x.id===b.dataset.editTemplate);const f=$('[data-template-form]');f.id.value=t.id;f.type.value=t.type;f.name.value=t.name;f.subject.value=t.subject;f.body.value=t.body;f.active.checked=t.active;f.scrollIntoView({behavior:'smooth',block:'center'});}));
  }
  $('[data-search]')?.addEventListener('input',renderProjects); $('[data-stage-filter]')?.addEventListener('change',renderProjects); $('[data-task-filter]')?.addEventListener('change',renderProjects); $('[data-review-filter]')?.addEventListener('change',renderProjects);
  $('[data-analytics-range]').forEach(b=>b.addEventListener('click',()=>{analyticsRange=b.dataset.analyticsRange||'7';renderAnalytics();}));
  $('[data-trend-granularity]').forEach(b=>b.addEventListener('click',()=>{trendGranularity=b.dataset.trendGranularity||'day';renderAnalytics();}));
  $('[data-breakdown]').forEach(b=>b.addEventListener('click',()=>{analyticsBreakdown=b.dataset.breakdown||'websiteForm';renderAnalytics();}));
  $('[data-close-drilldown]')?.addEventListener('click',()=>{const modal=$('[data-analytics-drilldown-modal]');modal.classList.add('hidden');modal.classList.remove('flex');});
  $('[data-approve-visible]')?.addEventListener('click',()=>{
    bulkApproveIds=visibleProjectIds.filter(id=>{const p=data.projects.find(x=>x.id===id);return p&&p.cleanup&&!p.cleanup.approvedLegitimate&&['review','auto_trash'].includes(p.cleanup.disposition);});
    if(!bulkApproveIds.length)return;
    $('[data-bulk-approve-count]').textContent=bulkApproveIds.length;
    $('[data-bulk-approve-list]').innerHTML=bulkApproveIds.map(id=>{const p=data.projects.find(x=>x.id===id);const reasons=(p?.cleanup?.reasons||[]).slice(0,3).map(esc).join(' • ');return '<div class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/40 p-4"><div class="flex items-start justify-between gap-4"><div><strong>'+esc(p?.customer?.name||'Unnamed client')+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/48">'+esc(p?.customer?.email||'No email')+' · '+esc(p?.customer?.eventDate||'No date')+'</p><p class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/55">'+reasons+'</p></div><span class="rounded-full bg-amber-100 px-2 py-1 text-[.58rem] font-black text-amber-900">'+Number(p?.cleanup?.score||0)+'/100</span></div></div>'}).join('');
    const modal=$('[data-bulk-approve-modal]');modal.classList.remove('hidden');modal.classList.add('flex');
  });
  $('[data-cancel-bulk-approve]')?.addEventListener('click',()=>{const modal=$('[data-bulk-approve-modal]');modal.classList.add('hidden');modal.classList.remove('flex');bulkApproveIds=[];});
  $('[data-confirm-bulk-approve]')?.addEventListener('click',async()=>{
    if(!bulkApproveIds.length)return;
    const button=$('[data-confirm-bulk-approve]');button.disabled=true;const original=button.innerHTML;button.textContent='Approving…';
    try{
      const result=await post({action:'bulk-approve-cleanup-review',recordIds:bulkApproveIds});
      const modal=$('[data-bulk-approve-modal]');modal.classList.add('hidden');modal.classList.remove('flex');bulkApproveIds=[];
      await load();
      if(result.skipped?.length)alert(result.count+' client(s) approved. '+result.skipped.length+' were skipped because their review status changed.');
    }catch(err){alert(err.message||'Bulk approval failed.');}
    finally{button.disabled=false;button.innerHTML=original;}
  });
  $('[data-cleanup-settings]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;const result=await post({action:'save-cleanup-settings',mode:f.mode.value});data.cleanupSettings=result.settings;await load();});
  $('[data-audit-filter]')?.addEventListener('change',renderAudit);
  $('[data-flag-client]')?.addEventListener('click',async()=>{const p=data.projects.find(x=>x.id===selectedId);if(!p)return;const note=prompt('Optional note for why '+(p.customer?.name||'this client')+' needs review:','');if(note===null)return;await post({action:'flag-cleanup-review',recordId:selectedId,note});await load();});
  $('[data-approve-client]')?.addEventListener('click',async()=>{const p=data.projects.find(x=>x.id===selectedId);if(!p)return;if(!confirm('Mark '+(p.customer?.name||'this client')+' as legitimate?\n\nThis suppresses future bogus-client cleanup flags for this CRM record.'))return;await post({action:'approve-cleanup-review',recordId:selectedId});await load();});
  $('[data-toggle-trash]')?.addEventListener('click',()=>{$('[data-trash-panel]').classList.remove('hidden');$('[data-project-list]').classList.add('hidden');});
  $('[data-close-trash]')?.addEventListener('click',()=>{$('[data-trash-panel]').classList.add('hidden');$('[data-project-list]').classList.remove('hidden');});
  $('[data-select-visible]')?.addEventListener('click',()=>{visibleProjectIds.forEach(id=>selectedProjects.add(id));renderProjects();});
  $('[data-clear-selection]')?.addEventListener('click',()=>{selectedProjects.clear();renderProjects();});
  $('[data-bulk-trash]')?.addEventListener('click',async()=>{
    const ids=[...selectedProjects]; if(!ids.length)return;
    if(!confirm('Move '+ids.length+' selected clients to Trash?\n\nAny proposal, booking, contract, invoice, or payment-linked records will be protected and skipped.'))return;
    const r=await fetch('/api/admin/quotes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'bulk-trash-client-chains',recordIds:ids})});
    const j=await r.json().catch(()=>({})); if(!r.ok){alert(j.error||'Bulk Trash failed.');return;}
    selectedProjects.clear(); selectedId=''; $('[data-detail]').classList.add('hidden'); $('[data-detail-empty]').classList.remove('hidden'); await load();
    if(j.skipped?.length) alert(j.moved.length+' client record(s) moved to Trash. '+j.skipped.length+' selection(s) were protected or ineligible.');
  });
  $('[data-trash-client]')?.addEventListener('click',async()=>{
    const p=data.projects.find(x=>x.id===selectedId); if(!p)return;
    const name=p.customer?.name||'this client';
    if(!confirm('Move '+name+' to Trash?\n\nThis removes the related inquiry/lead chain from the active pipeline for 30 days. Proposals, bookings, contracts, invoices, and payment-linked records are automatically protected.'))return;
    const button=$('[data-trash-client]'); const original=button.textContent; button.disabled=true; button.textContent='Moving…';
    try{
      const r=await fetch('/api/admin/quotes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'trash-client-chain',recordId:selectedId})});
      const j=await r.json().catch(()=>({})); if(!r.ok)throw new Error(j.error||'Unable to move client to Trash.');
      selectedId=''; $('[data-detail]').classList.add('hidden'); $('[data-detail-empty]').classList.remove('hidden');
      await load();
    }catch(err){alert(err.message||'Unable to move client to Trash.');}
    finally{button.disabled=false;button.textContent=original;}
  });
  $('[data-project-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'save-project',recordId:selectedId,projectStatus:f.projectStatus.value,owner:f.owner.value,company:f.company.value,address:f.address.value,partnerName:f.partnerName.value,sourceDetail:f.sourceDetail.value,tags:f.tags.value.split(',').map(x=>x.trim()).filter(Boolean)});await load();});
  $('[data-note-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'add-note',recordId:selectedId,body:f.body.value});f.reset();await load();});
  $('[data-task-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'add-task',recordId:selectedId,title:f.title.value,dueDate:f.dueDate.value,assignee:f.assignee.value,priority:f.priority.value});f.reset();await load();});
  $('[data-appointment-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'schedule-appointment',recordId:selectedId,title:f.title.value,startsAt:f.startsAt.value,durationMinutes:f.durationMinutes.value,location:f.location.value});f.reset();await load();});
  $('[data-enroll-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;if(!f.workflowId.value)return;await post({action:'enroll-workflow',recordId:selectedId,workflowId:f.workflowId.value});await load();});
  $('[data-workflow-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;const steps=f.steps.value.split('\n').map((line,i)=>{const [days,...rest]=line.split('|');return{id:'',label:'Step '+(i+1),offsetDays:Number(days)||0,taskTitle:rest.join('|').trim()}}).filter(x=>x.taskTitle);await post({action:'save-workflow',id:f.id.value,name:f.name.value,description:f.description.value,trigger:f.trigger.value,steps,active:f.active.checked});f.reset();f.active.checked=true;await load();});
  $('[data-template-form]')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;await post({action:'save-template',id:f.id.value,type:f.type.value,name:f.name.value,subject:f.subject.value,body:f.body.value,active:f.active.checked});f.reset();f.active.checked=true;await load();});
  $('[data-client-email-template]')?.addEventListener('change',e=>{
    const template=data.templates.find(t=>t.id===e.currentTarget.value);
    const form=$('[data-client-email-form]');
    if(!form||!template)return;
    form.subject.value=template.subject||template.name||'';
    form.body.value=template.body||'';
  });
  $('[data-client-email-form]')?.addEventListener('submit',async e=>{
    e.preventDefault();
    const form=e.currentTarget,status=$('[data-client-email-status]');
    if(!selectedId)return;
    const p=data.projects.find(x=>x.id===selectedId);
    if(!p?.customer?.email){if(status)status.textContent='This client does not have an email address.';return;}
    const button=form.querySelector('button[type="submit"],button:not([type])');
    const original=button?.textContent||'Send branded email';
    if(button){button.disabled=true;button.textContent='Sending…';}
    if(status)status.textContent='';
    try{
      const result=await post({action:'send-client-email',recordId:selectedId,subject:form.subject.value,body:form.body.value});
      if(status)status.textContent='Email sent via Resend'+(result?.messageId?' · '+result.messageId:'')+'.';
      form.subject.value='';form.body.value='';const select=$('[data-client-email-template]');if(select)select.value='';
      await load();
    }catch(error){
      if(status)status.textContent=error instanceof Error?error.message:'Email could not be sent.';
    }finally{
      if(button){button.disabled=false;button.textContent=original;}
    }
  });

  (async()=>{try{await load();}catch(error){console.error('Business CRM startup failed',error);const detail=error instanceof Error?error.message:'Business CRM startup failed';const watchdog=window.__koaCrmStartupWatchdog;if(watchdog)watchdog.failed('startup-exception',detail);else window.__koaCrmStartupPending={status:'failed',phase:'startup-exception',detail};$('[data-admin-ui]')?.classList.add('hidden');$('[data-unauthorized]')?.classList.add('hidden');const status=$('[data-crm-status]');const message=$('[data-crm-status-message]');status?.classList.remove('hidden');if(message)message.innerHTML='Business CRM could not initialize. <button type="button" data-crm-retry class="underline font-black">Retry</button>';status?.querySelector('[data-crm-retry]')?.addEventListener('click',()=>load().catch((retryError)=>{console.error('Business CRM retry failed',retryError);const retryDetail=retryError instanceof Error?retryError.message:'Business CRM retry failed';window.__koaCrmStartupWatchdog?.failed('retry-failed',retryDetail);if(message)message.textContent='Business CRM is still unavailable. The CRM service did not respond within 15 seconds.';}));}})();
</script>
</BaseLayout>
