        const verification=signals.verification||{};
        const verificationLabels:Record<string,string>={ready:'Ready to verify',blocked:'Blocked by production lag',catching_up:'One commit behind · deploying',caution:'One commit behind · investigate',unknown:'Unable to determine'};
        office365Verification.textContent=verificationLabels[String(verification.status||'unknown')]||String(verification.status||'Unknown');
        office365Verification.className='mt-2 text-sm font-semibold '+(
          verification.status==='ready'?'text-emerald-800':
