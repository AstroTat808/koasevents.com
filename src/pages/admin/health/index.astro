            actions.className='mt-3 flex flex-wrap items-center gap-2';
            const button=document.createElement('button');
            button.type='button';
            button.dataset.creditSaverAction=String(item.safeActionId);
            button.dataset.creditSaverEnabled=item.active?'false':'true';
            button.className='rounded-full px-3 py-2 text-[.6rem] font-black uppercase tracking-[.07em] '+(item.active?'border border-emerald-300 bg-white text-emerald-800':'bg-[var(--koa-forest)] text-white');
            button.textContent=item.active?'Restore normal cadence':'Apply until cycle reset';
            actions.appendChild(button);
            card.appendChild(actions);
          }
          creditRecommendations.appendChild(card);
        });
        if(!recommendations.length){
          creditRecommendations.innerHTML='<p class="text-xs leading-5 text-[var(--koa-ink)]/50">No credit-saving intervention is currently recommended. The weighted projection is within the configured allowance.</p>';
        }
      }
      const creditAutomationState=creditUsage.creditAutomation||{};
      if(creditAutomation){
        const autoApplied=Boolean(creditAutomationState.autoAppliedBalanced);
        const maxSuggested=Boolean(creditAutomationState.maximumSavingsSuggested);
        creditAutomation.className='mt-4 rounded-xl border p-3 text-xs leading-5 '+(autoApplied?'border-amber-200 bg-amber-50 text-amber-900':maxSuggested?'border-red-200 bg-red-50 text-red-900':'border-[var(--koa-line)] bg-[var(--koa-ivory)] text-[var(--koa-ink)]/58');
        creditAutomation.textContent=autoApplied
          ? 'Automatic Protection switched all six safe jobs to Balanced Savings when the projected cycle usage crossed 80%'+(creditAutomationState.autoAppliedAt?' at '+new Date(creditAutomationState.autoAppliedAt).toLocaleString():'')+'. Maximum Savings remains manual.'
          : maxSuggested
            ? 'Maximum Savings is recommended because the adjusted projection is still '+String(creditAutomationState.adjustedProjectedPercent??'—')+'% of the monthly allowance. It will not be enabled automatically.'
            : 'Automatic Protection will switch Normal Operations to Balanced Savings only when projected cycle usage crosses 80%. Maximum Savings is suggestion-only and never automatic.';
        if(creditAutomationState.skippedReason)creditAutomation.textContent+=' '+String(creditAutomationState.skippedReason);
      }

      if(creditPresets){
        creditPresets.innerHTML='';
        const presets=Array.isArray(creditUsage.presets)?creditUsage.presets:[];
        presets.forEach((preset)=>{
          const card=document.createElement('article');
          card.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
          const title=document.createElement('strong');
          title.className='block text-sm text-[var(--koa-forest)]';
          title.textContent=String(preset.name||'Preset');
          const description=document.createElement('p');
          description.className='mt-1 text-xs leading-5 text-[var(--koa-ink)]/55';
          description.textContent=String(preset.description||'');
          const list=document.createElement('div');
          list.className='mt-3 grid gap-1.5';
          (Array.isArray(preset.changes)?preset.changes:[]).forEach((change)=>{
            const line=document.createElement('div');
