          note.className='mt-1 text-[.65rem] leading-5 text-[var(--koa-ink)]/45';
          note.textContent='Realized aggregate savings are apportioned by each changed job’s predicted share; this is an attribution estimate, not a Netlify per-function billing ledger.';
          const grid=document.createElement('div');
          grid.className='mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3';
          completed.savingsAttribution.forEach((row)=>{
            const item=document.createElement('div');
            item.className='rounded-lg bg-white p-2.5';
            const name=document.createElement('p');
