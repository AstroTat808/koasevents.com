        const response=await fetch('/api/admin/health',{method:'POST'});
        postPayload=await response.json().catch(()=>null);
        if(!response.ok)throw new Error(postPayload?.error||'Health check request failed.');

        // Render the authoritative core result immediately, then mark the
        // dashboard refresh separately while the history/enrichment GET runs.
        renderHealthPayload(postPayload||{},'Manual check');
        updateCoreCheckStatus(postPayload?.current);
        updateDashboardRefreshStatus('running');

        try{
          const latest=await fetch('/api/admin/health',{cache:'no-store'});
          if(latest.ok){
            renderHealthPayload(await latest.json(),'Post-check refresh');
          }else{
            updateDashboardRefreshStatus('failed');
            showHealthRunWarning(
              'Core checks completed; dashboard history did not refresh.',
              '',
              [{section:'Dashboard refresh',error:'The follow-up System Health refresh returned HTTP '+latest.status+'.'}]
            );
          }
        }catch(refreshError){
          updateDashboardRefreshStatus('failed');
          showHealthRunWarning(
            'Core checks completed; dashboard history did not refresh.',
            '',
            [{section:'Dashboard refresh',error:refreshError instanceof Error?refreshError.message:'The follow-up dashboard refresh failed.'}]
          );
        }
      }catch(error){
        // Recover the persisted snapshot if the request failed after the core
        // checks finished. The two compact statuses show which layer failed.
        try{
          const latest=await fetch('/api/admin/health',{cache:'no-store'});
          if(latest.ok){
            const latestPayload=await latest.json();
            if(latestPayload?.current){
              renderHealthPayload(latestPayload,'Recovered health snapshot');
              updateCoreCheckStatus(latestPayload.current);
              updateDashboardRefreshStatus('partial',1);
              showHealthRunWarning(
                'Core health result recovered after a request error.',
                '',
                [{section:'Manual check request',error:error instanceof Error?error.message:'A non-core part of the manual check request failed.'}]
              );
              return;
            }
          }
        }catch(recoveryError){
          console.error('[system-health] recovery refresh failed:',recoveryError);
        }

        updateCoreCheckStatus(null,'failed');
        updateDashboardRefreshStatus('failed');
        overall.textContent='Check failed';
        overall.className='display mt-3 text-4xl text-red-800';
        showHealthRunWarning(
          'The manual health check did not complete.',
          '',
          [{section:'Core health check',error:error instanceof Error?error.message:'No completed health snapshot was available.'}]
        );
      }finally{
        refresh.disabled=false;refresh.textContent='Run checks now';
      }
    });

    healthRunWarning?.addEventListener('click',()=>{
      renderHealthRunWarningDialog();
      healthRunWarningDialog?.showModal();
    });
    document.querySelector('[data-health-run-warning-close]')?.addEventListener('click',()=>healthRunWarningDialog?.close());
    healthRunWarningDialog?.addEventListener('click',(event)=>{
      if(event.target===healthRunWarningDialog)healthRunWarningDialog.close();
    });

    function criticalIntegrationsExportParams(format){
      const params=new URLSearchParams({export:'critical-integrations',format});
      const from=String(criticalIntegrationsExportFrom?.value||'').trim();
      const to=String(criticalIntegrationsExportTo?.value||'').trim();
      const integration=String(criticalIntegrationsExportIntegration?.value||'all').trim();
      if(from)params.set('from',from);
      if(to)params.set('to',to);
      if(integration&&integration!=='all')params.set('integration',integration);
      if(criticalIntegrationsExportFailed?.checked)params.set('failedOnly','1');
      if(criticalIntegrationsExportRollback?.checked)params.set('rollbackOnly','1');
      return params;
    }

    function updateCriticalIntegrationsExportSummary(){
      if(!criticalIntegrationsExportSummary)return;
      const parts=[];
      const from=String(criticalIntegrationsExportFrom?.value||'').trim();
      const to=String(criticalIntegrationsExportTo?.value||'').trim();
      const integration=String(criticalIntegrationsExportIntegration?.selectedOptions?.[0]?.textContent||'All four integrations').trim();
      if(from||to)parts.push('Date '+(from||'earliest')+' → '+(to||'latest'));
      if(String(criticalIntegrationsExportIntegration?.value||'all')!=='all')parts.push(integration);
      if(criticalIntegrationsExportFailed?.checked)parts.push('failed releases only');
      if(criticalIntegrationsExportRollback?.checked)parts.push('rollback events only');
      criticalIntegrationsExportSummary.textContent=parts.length?'Filters · '+parts.join(' · '):'All recorded production releases';
    }

    criticalIntegrationsExportButtons.forEach((button)=>button.addEventListener('click',()=>{
      const format=String(button.dataset.criticalIntegrationsExport||'csv');
      window.location.href='/api/admin/health?'+criticalIntegrationsExportParams(format).toString();
    }));
    [criticalIntegrationsExportFrom,criticalIntegrationsExportTo,criticalIntegrationsExportIntegration,criticalIntegrationsExportFailed,criticalIntegrationsExportRollback]
      .filter(Boolean)
      .forEach((control)=>control.addEventListener('change',updateCriticalIntegrationsExportSummary));
    updateCriticalIntegrationsExportSummary();

    criticalIntegrationsDrill?.addEventListener('click',async()=>{
      if(criticalIntegrationsDrill.disabled)return;
      criticalIntegrationsDrill.disabled=true;
      criticalIntegrationsDrill.textContent='Running drill…';
      if(criticalIntegrationsDrillMessage){
        delete criticalIntegrationsDrillMessage.dataset.result;
        criticalIntegrationsDrillMessage.textContent='Deliberately failing SignWell in the non-production drill state machine…';
      }
      try{
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'run-critical-integrations-rollback-drill',failedProbeId:'synthetic-signwell-webhook'}),
        });
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Rollback drill failed.');
        const drill=data.drill||{};
        const phases=Array.isArray(drill.events)?drill.events:[];
        if(criticalIntegrationsDrillMessage){
          criticalIntegrationsDrillMessage.dataset.result='1';
          criticalIntegrationsDrillMessage.textContent=(drill.ok?'Drill passed · ':'Drill failed · ')+phases.map((row)=>String(row.phase||'phase')+': '+(row.ok?'passed':'failed')).join(' → ');
        }
      }catch(error){
        if(criticalIntegrationsDrillMessage){
          criticalIntegrationsDrillMessage.dataset.result='1';
          criticalIntegrationsDrillMessage.textContent=error instanceof Error?error.message:'Rollback drill failed.';
        }
      }finally{
        criticalIntegrationsDrill.disabled=false;
        criticalIntegrationsDrill.textContent='Run safe rollback drill';
      }
    });

    document.querySelector('[data-close-release]')?.addEventListener('click',()=>releaseDialog.close());
    document.querySelector('[data-close-compare]')?.addEventListener('click',()=>compareDialog.close());
    releaseSearch?.addEventListener('input',renderReleaseTimeline);
    releaseFilter?.addEventListener('change',renderReleaseTimeline);
    document.querySelector('[data-release-clear]')?.addEventListener('click',()=>{
      releaseSearch.value='';
      releaseFilter.value='all';
      renderReleaseTimeline();
    });
    document.querySelector('[data-compare-releases]')?.addEventListener('click',async()=>{
      const baseCommit=String(compareBase.value||'');
      const headCommit=String(compareHead.value||'');
      if(!baseCommit||!headCommit){compareMessage.textContent='Choose two releases to compare.';return;}
      if(baseCommit===headCommit){compareMessage.textContent='Choose two different releases.';return;}
      compareMessage.textContent='Comparing releases…';
      try{
        const response=await fetch('/api/admin/health',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'compare-releases',baseCommit,headCommit})});
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to compare releases.');
        compareMessage.textContent='';
        showComparison(data.comparison);
      }catch(error){compareMessage.textContent=error instanceof Error?error.message:'Unable to compare releases.';}
    });

    saveOffice365Thresholds?.addEventListener('click',async()=>{
      saveOffice365Thresholds.disabled=true;office365ThresholdMessage.textContent='Saving…';
      try{
        const yellowBelow=Number(office365YellowThreshold.value);
        const redBelow=Number(office365RedThreshold.value);
        if(!Number.isFinite(yellowBelow)||!Number.isFinite(redBelow)||yellowBelow<0||yellowBelow>100||redBelow<0||redBelow>100)throw new Error('Thresholds must be between 0 and 100.');
        if(redBelow>=yellowBelow)throw new Error('Red threshold must be lower than yellow.');
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'save-office365-thresholds',yellowBelow,redBelow}),
        });
        const result=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(result.error||'Unable to save thresholds.');
        office365ThresholdMessage.textContent='Office 365 reliability thresholds saved.';
        await load();
      }catch(error){office365ThresholdMessage.textContent=error instanceof Error?error.message:'Unable to save thresholds.';}
      finally{saveOffice365Thresholds.disabled=false;}
    });

    savePolicy?.addEventListener('click',async()=>{
      savePolicy.disabled=true;policyMessage.textContent='Saving…';
      try{
        const rules=[...policyBody.querySelectorAll('tr[data-policy-id]')].map((tr)=>({
          id:tr.dataset.policyId,
          alertAfter:Number(tr.querySelector('[data-alert-after]')?.value)===1?1:2,
          publicVisible:Boolean(tr.querySelector('[data-public-visible]')?.checked),
          publicName:String(tr.querySelector('[data-public-name]')?.value||'').trim(),
        }));
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'save-policy',policy:{publicStatusEnabled:Boolean(publicStatusEnabled?.checked),rules}}),
        });
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to save alert policy.');
        policyMessage.textContent='Alert policy saved.';
        await load();
      }catch(error){
        policyMessage.textContent=error instanceof Error?error.message:'Unable to save alert policy.';
      }finally{
        savePolicy.disabled=false;
      }
    });

    const session=await getAdminSession();
    const sessionCapabilities=new Set(session?.capabilities||session?.permissions||[]);
    const ok=Boolean(session&&!session.accessBlocked&&(session.isAdmin||sessionCapabilities.has('health.view')));
    app?.classList.toggle('hidden',!ok);
    unauthorized?.classList.toggle('hidden',ok);
    if(ok){
      await load();
      handleHealthPriorityHash();
      await maybeRetestPendingCredential();
    }
  </script>
</BaseLayout>
