            creditLearningActive.textContent='Measuring '+String(active.label||'credit-saver plan')+' · '+String(active.elapsedHours??0)+' / 24 hours observed · predicted '+String(active.predictedSavingsPerDay??0)+' credits/day · current realized estimate '+String(active.realizedSavingsPerDay??0)+' credits/day.';
          }
        }else{
