          const detail=document.createElement('p');
          detail.className='mt-1 text-xs leading-5 text-[var(--koa-ink)]/58';
          detail.textContent=String(item.detail||'');

          const savings=document.createElement('div');
          savings.className='mt-2 rounded-lg bg-white/75 p-2 text-[.68rem] leading-5 text-[var(--koa-ink)]/60';
          const perDay=item.estimatedSavingsPerDay;
          const cycle=item.estimatedSavingsThisCycle;
          savings.textContent=(perDay==null&&cycle==null)
            ? 'Estimated savings depend on future usage.'
            : 'Estimated savings: '+(perDay==null?'—':String(perDay)+' credits/day')+' · '+(cycle==null?'—':String(cycle)+' credits through this cycle');

          const impact=document.createElement('p');
          impact.className='mt-2 text-[.68rem] font-semibold leading-5 text-[var(--koa-clay)]';
          impact.textContent=String(item.impact||'');
          const protects=document.createElement('p');
          protects.className='mt-1 text-[.65rem] leading-5 text-[var(--koa-ink)]/42';
          protects.textContent=String(item.protects||'');
          card.append(title,detail,savings,impact,protects);

          if(item.canApply&&item.safeActionId){
            const actions=document.createElement('div');
            actions.className='mt-3 flex flex-wrap items-center gap-2';
            const button=document.createElement('button');
            button.type='button';
            button.dataset.creditSaverAction=String(item.safeActionId);
            button.dataset.creditSaverEnabled=item.active?'false':'true';
            button.className='rounded-full px-3 py-2 text-[.6rem] font-black uppercase tracking-[.07em] '+(item.active?'border border-emerald-300 bg-white text-emerald-800':'bg-[var(--koa-forest)] text-white');
            button.textContent=item.active?'Restore normal cadence':'Apply until cycle reset';
            actions.appendChild(button);
            card.appendChild(actions);
          }
          creditRecommendations.appendChild(card);
        });
        if(!recommendations.length){
          creditRecommendations.innerHTML='<p class="text-xs leading-5 text-[var(--koa-ink)]/50">No credit-saving intervention is currently recommended. The weighted projection is within the configured allowance.</p>';
        }
      }
      const presetRows=Array.isArray(creditUsage.presets)?creditUsage.presets:[];
      const derivedActivePreset=presetRows.find((preset)=>
        Array.isArray(preset?.changes)&&preset.changes.length>0&&preset.changes.every((change)=>!change.changed)
      )||null;
      const activeProfile=creditUsage.activeProfile||{
        id:derivedActivePreset?.id||'custom',
        name:derivedActivePreset?.name||'Custom Mix',
        isPreset:Boolean(derivedActivePreset),
        modeCounts:(Array.isArray(creditUsage.jobControls)?creditUsage.jobControls:[]).reduce((acc,item)=>{
          const mode=String(item?.currentMode||'normal');
          if(mode==='paused')acc.paused+=1;
          else if(mode==='saver')acc.saver+=1;
          else acc.normal+=1;
          return acc;
        },{normal:0,saver:0,paused:0}),
        updatedAt:String(creditUsage.saverPolicy?.updatedAt||''),
        updatedBy:String(creditUsage.saverPolicy?.updatedBy||''),
        expiresAt:String(creditUsage.saverPolicy?.expiresAt||''),
      };
      const activeProfileId=String(activeProfile.id||'custom');
      const activeProfileName=String(activeProfile.name||'Custom Mix');
      const activeProfileIsPreset=Boolean(activeProfile.isPreset&&activeProfileId!=='custom');
      const activeModeCounts=activeProfile.modeCounts||{};
      if(creditActiveProfile){
        creditActiveProfile.className='mt-4 rounded-xl border p-4 '+(
          activeProfileIsPreset
            ? 'border-emerald-200 bg-emerald-50'
            : 'border-amber-200 bg-amber-50'
        );
      }
      if(creditActiveProfileName)creditActiveProfileName.textContent=activeProfileName;
      if(creditActiveProfileBadge){
        creditActiveProfileBadge.textContent=activeProfileIsPreset?'In effect':'Custom configuration';
        creditActiveProfileBadge.className='rounded-full px-2.5 py-1 text-[.52rem] font-black uppercase tracking-[.08em] text-white '+(
          activeProfileIsPreset?'bg-emerald-700':'bg-amber-700'
        );
      }
      if(creditActiveProfileDetail){
        if(activeProfileIsPreset){
          const preset=derivedActivePreset||presetRows.find((row)=>String(row?.id||'')===activeProfileId);
          creditActiveProfileDetail.textContent=String(preset?.description||'All six scheduled jobs currently match this preset.');
        }else{
          const normal=Number(activeModeCounts.normal||0);
          const saver=Number(activeModeCounts.saver||0);
          const paused=Number(activeModeCounts.paused||0);
          creditActiveProfileDetail.textContent='Manual mix currently in effect · '+normal+' Normal · '+saver+' Saver · '+paused+' Paused.';
        }
        creditActiveProfileDetail.className='mt-1 text-xs leading-5 '+(activeProfileIsPreset?'text-emerald-950/65':'text-amber-950/70');
      }
      if(creditActiveProfileImpact){
        const controls=Array.isArray(creditUsage.jobControls)?creditUsage.jobControls:[];
        const pausedCount=controls.filter((item)=>String(item?.currentMode||'normal')==='paused').length;
        const saverCount=controls.filter((item)=>String(item?.currentMode||'normal')==='saver').length;
        const normalCount=controls.filter((item)=>String(item?.currentMode||'normal')==='normal').length;
        const estimatedSavedPerDay=controls.reduce((sum,item)=>{
          const mode=String(item?.currentMode||'normal');
          if(mode==='paused')return sum+Number(item?.pausedSavingsPerDay||0);
          if(mode==='saver')return sum+Number(item?.saverSavingsPerDay||0);
          return sum;
        },0);
        const parts=[];
        if(pausedCount)parts.push(pausedCount+' job'+(pausedCount===1?'':'s')+' paused');
        if(saverCount)parts.push(saverCount+' job'+(saverCount===1?'':'s')+' in Saver');
        if(normalCount)parts.push(normalCount+' job'+(normalCount===1?'':'s')+' Normal');
        const rounded=Math.round(estimatedSavedPerDay*100)/100;
        parts.push('estimated '+rounded.toLocaleString(undefined,{maximumFractionDigits:2})+' credits/day saved');
        if(activeProfile.expiresAt&&!activeProfile.expired){
          parts.push('resets '+new Date(activeProfile.expiresAt).toLocaleDateString(undefined,{month:'short',day:'numeric'}));
        }
        creditActiveProfileImpact.textContent=parts.join(' · ');
      }
      if(creditActiveProfileMeta){
        const meta=[];
        if(activeProfile.updatedAt)meta.push('Applied '+new Date(activeProfile.updatedAt).toLocaleString());
        if(activeProfile.updatedBy)meta.push('by '+String(activeProfile.updatedBy));
        if(activeProfile.expiresAt&&!activeProfile.expired)meta.push('Resets '+new Date(activeProfile.expiresAt).toLocaleString());
        creditActiveProfileMeta.textContent=meta.join(' · ');
        creditActiveProfileMeta.className='text-xs leading-5 '+(activeProfileIsPreset?'text-emerald-950/55':'text-amber-950/60')+' sm:max-w-xs sm:text-right';
      }

      const creditAutomationState=creditUsage.creditAutomation||{};
      if(creditAutomation){
        const autoApplied=Boolean(creditAutomationState.autoAppliedBalanced);
        const maxSuggested=Boolean(creditAutomationState.maximumSavingsSuggested);
        creditAutomation.className='mt-4 rounded-xl border p-3 text-xs leading-5 '+(autoApplied?'border-amber-200 bg-amber-50 text-amber-900':maxSuggested?'border-red-200 bg-red-50 text-red-900':'border-[var(--koa-line)] bg-[var(--koa-ivory)] text-[var(--koa-ink)]/58');
        creditAutomation.textContent=activeProfileId==='maximum-savings'
          ? 'Maximum Savings is currently in effect. All six optional scheduled jobs are paused; protected core workflows remain active.'
          : autoApplied
            ? 'Automatic Protection switched all six safe jobs to Balanced Savings when the projected cycle usage crossed 80%'+(creditAutomationState.autoAppliedAt?' at '+new Date(creditAutomationState.autoAppliedAt).toLocaleString():'')+'. Maximum Savings remains manual.'
            : maxSuggested
              ? 'Maximum Savings is recommended because the adjusted projection is still '+String(creditAutomationState.adjustedProjectedPercent??'—')+'% of the monthly allowance. It will not be enabled automatically.'
              : 'Automatic Protection will switch Normal Operations to Balanced Savings only when projected cycle usage crosses 80%. Maximum Savings is suggestion-only and never automatic.';
        if(creditAutomationState.skippedReason)creditAutomation.textContent+=' '+String(creditAutomationState.skippedReason);
      }

      if(creditPresets){
        creditPresets.innerHTML='';
        const presets=presetRows;
        presets.forEach((preset)=>{
          const isCurrent=String(preset.id||'')===activeProfileId&&activeProfileIsPreset;
          const card=document.createElement('article');
          card.className='rounded-xl border p-4 '+(
            isCurrent
              ? 'border-2 border-emerald-500 bg-emerald-50 shadow-sm'
              : 'border-[var(--koa-line)] bg-[var(--koa-ivory)]'
          );
          const title=document.createElement('strong');
          title.className='block text-sm text-[var(--koa-forest)]';
          title.textContent=String(preset.name||'Preset');
          const description=document.createElement('p');
          description.className='mt-1 text-xs leading-5 text-[var(--koa-ink)]/55';
          description.textContent=String(preset.description||'');
          const list=document.createElement('div');
          list.className='mt-3 grid gap-1.5';
          (Array.isArray(preset.changes)?preset.changes:[]).forEach((change)=>{
            const line=document.createElement('div');
            line.className='flex items-center justify-between gap-3 rounded-lg bg-white/75 px-2.5 py-2 text-[.66rem]';
            const label=document.createElement('span');
            label.className='font-semibold text-[var(--koa-forest)]';
            label.textContent=String(change.label||change.jobId||'Job');
            const modes=document.createElement('span');
            modes.className=change.changed?'font-black text-[var(--koa-clay)]':'text-[var(--koa-ink)]/40';
            modes.textContent=String(change.fromMode||'normal')+' → '+String(change.toMode||'normal');
            line.append(label,modes);
            list.appendChild(line);
          });
          const caution=document.createElement('p');
          caution.className='mt-3 text-[.64rem] leading-5 text-[var(--koa-ink)]/45';
          caution.textContent=String(preset.caution||'');
          const button=document.createElement('button');
          button.type='button';
          button.dataset.creditPreset=String(preset.id||'');
          const isMaximum=String(preset.id||'')==='maximum-savings';
          const suggested=!isCurrent&&isMaximum&&Boolean(creditAutomationState.maximumSavingsSuggested);
          if(isCurrent){
            const badge=document.createElement('span');
            badge.className='mt-3 inline-flex rounded-full bg-emerald-700 px-2.5 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-white';
            badge.textContent='Current profile · in effect';
            card.appendChild(badge);
          }else if(suggested){
            const badge=document.createElement('span');
            badge.className='mt-3 inline-flex rounded-full bg-red-100 px-2.5 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-red-800';
            badge.textContent='Suggested now · manual approval required';
            card.appendChild(badge);
          }
          button.disabled=isCurrent;
          button.className='mt-3 rounded-full px-4 py-2.5 text-[.6rem] font-black uppercase tracking-[.07em] '+(
            isCurrent
              ? 'cursor-default border border-emerald-300 bg-white text-emerald-800'
              : 'bg-[var(--koa-forest)] text-white'
          );
          button.textContent=isCurrent?'Currently active':(suggested?'Review & apply ':'Apply ')+String(preset.name||'preset');
          card.append(title,description,list,caution,button);
          creditPresets.appendChild(card);
        });
      }

      const learning=creditUsage.saverLearning||{};
      if(creditLearningFactor){
        const factor=Number(learning.calibrationFactor||1);
        creditLearningFactor.textContent='Calibration '+factor.toFixed(2)+'×';
      }
      if(creditLearningCount){
        const count=Number(learning.validMeasurementCount||0);
        creditLearningCount.textContent=count
          ? count+' completed clean measurement window'+(count===1?'':'s')
          : 'No completed clean windows yet';
      }
      if(creditLearningActive){
        const active=learning.liveMeasurement;
        if(active){
          const status=String(active.status||'measuring');
          if(status==='invalid'){
            creditLearningActive.className='mt-4 rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs leading-5 text-amber-900';
            creditLearningActive.textContent='Measurement excluded: '+String(active.invalidReason||'the observation window was contaminated.');
          }else if(status==='completed'){
            creditLearningActive.className='mt-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs leading-5 text-emerald-900';
            creditLearningActive.textContent='Latest clean window completed. Predicted '+String(active.predictedSavingsPerDay??0)+' credits/day; realized '+String(active.realizedSavingsPerDay??0)+' credits/day; accuracy '+String(active.accuracyPercent??'—')+'%.';
          }else{
            creditLearningActive.className='mt-4 rounded-xl bg-[var(--koa-ivory)] p-3 text-xs leading-5 text-[var(--koa-ink)]/58';
            creditLearningActive.textContent='Measuring '+String(active.label||'credit-saver plan')+' · '+String(active.elapsedHours??0)+' / 24 hours observed · predicted '+String(active.predictedSavingsPerDay??0)+' credits/day · current realized estimate '+String(active.realizedSavingsPerDay??0)+' credits/day.';
          }
        }else{
          creditLearningActive.className='mt-4 rounded-xl bg-[var(--koa-ivory)] p-3 text-xs leading-5 text-[var(--koa-ink)]/58';
          creditLearningActive.textContent='No saver-plan measurement is active.';
        }
      }
      if(creditLearningAttribution){
        const historyRows=Array.isArray(learning.history)?learning.history:[];
        const completed=historyRows.find((row)=>String(row?.status||'')==='completed'&&Array.isArray(row?.savingsAttribution));
        if(completed&&completed.savingsAttribution.length){
          creditLearningAttribution.classList.remove('hidden');
          creditLearningAttribution.innerHTML='';
          const title=document.createElement('strong');
          title.className='block text-sm text-[var(--koa-forest)]';
          title.textContent='What actually saved credits?';
          const note=document.createElement('p');
          note.className='mt-1 text-[.65rem] leading-5 text-[var(--koa-ink)]/45';
          note.textContent='Realized aggregate savings are apportioned by each changed job’s predicted share; this is an attribution estimate, not a Netlify per-function billing ledger.';
          const grid=document.createElement('div');
          grid.className='mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3';
          completed.savingsAttribution.forEach((row)=>{
            const item=document.createElement('div');
            item.className='rounded-lg bg-white p-2.5';
            const name=document.createElement('p');
            name.className='text-[.68rem] font-semibold text-[var(--koa-forest)]';
            name.textContent=String(row.label||row.jobId||'Scheduled job');
            const value=document.createElement('p');
            value.className='mt-1 text-sm font-black text-[var(--koa-clay)]';
            value.textContent='~'+String(row.realizedCreditsDuringWindow??0)+' credits';
            const meta=document.createElement('p');
            meta.className='mt-1 text-[.6rem] text-[var(--koa-ink)]/42';
            meta.textContent=String(row.attributionSharePercent??0)+'% share · '+String(row.fromMode||'normal')+' → '+String(row.toMode||'saver');
            item.append(name,value,meta);
            grid.appendChild(item);
          });
          creditLearningAttribution.append(title,note,grid);
        }else{
          creditLearningAttribution.classList.add('hidden');
          creditLearningAttribution.innerHTML='';
        }
      }

      if(creditLearningHistory){
        creditLearningHistory.innerHTML='';
        (Array.isArray(learning.history)?learning.history:[]).slice(0,5).forEach((row)=>{
          const item=document.createElement('div');
          item.className='rounded-lg border border-[var(--koa-line)] px-3 py-2 text-[.68rem] leading-5';
          const state=String(row.status||'');
          const at=row.endedAt||row.startedAt;
          item.textContent=String(row.label||'Saver plan')+' · '+state+(row.accuracyPercent!=null?' · '+String(row.accuracyPercent)+'% accuracy':'')+(at?' · '+new Date(at).toLocaleString():'')+(row.invalidReason?' · '+String(row.invalidReason):'');
          creditLearningHistory.appendChild(item);
        });
      }

      if(creditJobControls){
        creditJobControls.innerHTML='';
        const controls=Array.isArray(creditUsage.jobControls)?creditUsage.jobControls:[];
        controls.forEach((item)=>{
          const row=document.createElement('article');
          row.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-3';
          const top=document.createElement('div');
          top.className='flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between';
          const copy=document.createElement('div');
          const title=document.createElement('strong');
          title.className='block text-sm text-[var(--koa-forest)]';
          title.textContent=String(item.label||item.jobId||'Scheduled job');
          const meta=document.createElement('p');
          meta.className='mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/50';
          meta.textContent='Normal: '+String(item.normalLabel||'Normal cadence')+' · Saver: '+String(item.saverLabel||'Reduced cadence');
          copy.append(title,meta);

          const select=document.createElement('select');
          select.dataset.creditJobMode=String(item.jobId||'');
          select.className='rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]';
          select.innerHTML='<option value="normal">Normal</option><option value="saver">Saver</option><option value="paused">Paused</option>';
          select.value=String(item.currentMode||'normal');

          top.append(copy,select);
          const savings=document.createElement('p');
          savings.className='mt-2 text-[.65rem] leading-5 text-[var(--koa-ink)]/45';
          savings.textContent='Estimated future savings from Normal: Saver '+String(item.saverSavingsPerDay??0)+' credits/day · Paused '+String(item.pausedSavingsPerDay??0)+' credits/day. '+String(item.protects||'');
          row.append(top,savings);
          creditJobControls.appendChild(row);
        });
        if(!controls.length)creditJobControls.innerHTML='<p class="text-xs text-[var(--koa-ink)]/50">No safe scheduled-job controls were detected in the current production deploy.</p>';
      }

      latestAutoSaverPlan=creditUsage.autoSaverPlan||null;
      if(creditAutoPlan){
        const plan=latestAutoSaverPlan||{};
        creditAutoPlan.innerHTML='';
        const status=document.createElement('p');
        status.className='font-semibold '+(plan.status==='recommended'?'text-amber-800':plan.status==='insufficient'?'text-red-800':'text-emerald-800');
        status.textContent=plan.status==='recommended'
          ? 'A lower-disruption combination can bring the current forecast back within the allowance.'
          : plan.status==='insufficient'
            ? 'Even pausing all safe scheduled jobs is not estimated to fully cover the projected overage.'
            : 'Current scheduled-job settings are already projected within the allowance.';
        creditAutoPlan.appendChild(status);

        const summary=document.createElement('p');
        summary.className='mt-2';
        summary.textContent='Current adjusted projection: '+String(plan.currentProjectedEndOfCycle??'—')+' credits · projected after plan: '+String(plan.projectedAfterPlan??'—')+' · remaining shortfall: '+String(plan.estimatedShortfallAfterPlan??0)+'.';
        creditAutoPlan.appendChild(summary);

        const changes=Array.isArray(plan.recommendedChanges)?plan.recommendedChanges:[];
        if(changes.length){
          const list=document.createElement('div');
          list.className='mt-3 grid gap-2';
          changes.forEach((change)=>{
            const row=document.createElement('div');
            row.className='rounded-lg bg-[var(--koa-sand)]/60 p-2';
            row.textContent=String(change.label||change.jobId)+' · '+String(change.fromMode||'normal')+' → '+String(change.toMode||'saver')+' · saves ~'+String(change.estimatedSavingsThisCycle??0)+' credits this cycle';
            list.appendChild(row);
          });
          creditAutoPlan.appendChild(list);
        }
      }
      if(creditAutoPlanApply){
        const canApply=Boolean(latestAutoSaverPlan?.canApply);
        creditAutoPlanApply.classList.toggle('hidden',!canApply);
        creditAutoPlanApply.disabled=false;
        creditAutoPlanApply.textContent='Apply recommended plan';
      }

      if(creditNote)creditNote.textContent=creditUsage.note||'Credit estimate unavailable.';
      const currentDeploy=deployments.current||{};
      const connectionHealth=deployments.connectionHealth||{};
      document.querySelector('[data-deploy-commit]').textContent=currentDeploy.mainCommit||connectionHealth.githubCommit||currentDeploy.commit||'Unavailable';
      document.querySelector('[data-deploy-id]').textContent=currentDeploy.deployId||connectionHealth.deployId||'Unavailable';
      const deployStatusEl=document.querySelector('[data-deploy-status]');
      if(deployStatusEl)deployStatusEl.textContent=currentDeploy.deployStatus||connectionHealth.deployStatus||'Unavailable';
      document.querySelector('[data-deploy-built]').textContent=currentDeploy.deployTime?new Date(currentDeploy.deployTime).toLocaleString():(connectionHealth.deployTime?new Date(connectionHealth.deployTime).toLocaleString():(currentDeploy.builtAt?new Date(currentDeploy.builtAt).toLocaleString():'Unavailable'));
      const repoPrivateEl=document.querySelector('[data-deploy-private]');
      const repoPrivate=typeof currentDeploy.repositoryPrivate==='boolean'
        ? currentDeploy.repositoryPrivate
        : (typeof connectionHealth.repositoryPrivate==='boolean'?connectionHealth.repositoryPrivate:null);
      if(repoPrivateEl)repoPrivateEl.textContent=repoPrivate==null?'Unavailable':repoPrivate?'Private':'Public';
      const verificationSourceEl=document.querySelector('[data-deploy-verification-source]');
      if(verificationSourceEl){
        verificationSourceEl.textContent=currentDeploy.verificationSourceLabel||connectionHealth.verificationSourceLabel||'Unverified';
        verificationSourceEl.className='mt-2 text-sm font-semibold '+((currentDeploy.verificationSourceKey||connectionHealth.verificationSourceKey)==='github-netlify'?'text-emerald-800':(currentDeploy.verificationSourceKey||connectionHealth.verificationSourceKey)==='unverified'?'text-red-800':'text-amber-800');
      }
      document.querySelector('[data-deploy-functions]').textContent=currentDeploy.functionCount==null?'Unavailable':String(currentDeploy.functionCount);
      const syncEl=document.querySelector('[data-deploy-sync]');
      const mainEl=document.querySelector('[data-deploy-main]');
      const deploymentState=String(connectionHealth.deploymentState||'unknown');
      if(currentDeploy.behindMain===false){
        if(connectionHealth.verificationSourceKey==='netlify-fallback'){
          syncEl.textContent='Netlify production verified · GitHub main unavailable';
          syncEl.className='mt-2 text-sm font-semibold text-amber-800';
        }else{
          syncEl.textContent='Current with main';
          syncEl.className='mt-2 text-sm font-semibold text-emerald-800';
        }
      }else if(currentDeploy.behindMain===true){
        const behind=Number(currentDeploy.commitsBehind||0);
        const lag='Behind main'+(behind?' by '+behind+' commit'+(behind===1?'':'s'):'');
        if(deploymentState==='deploying'){
          syncEl.textContent=lag+' · build in progress';
        }else if(deploymentState==='waiting'){
          syncEl.textContent=lag+' · waiting for Git trigger';
        }else if(deploymentState==='release-policy-skipped'){
          syncEl.textContent=lag+' · commit skipped by release policy';
        }else if(deploymentState==='auto-deploy-broken'){
          syncEl.textContent=lag+' · Git auto-deploy stalled';
        }else if(deploymentState==='deploy-failed'){
          syncEl.textContent=lag+' · production deploy failed';
        }else{
          syncEl.textContent=lag;
        }
        syncEl.className='mt-2 text-sm font-semibold '+(connectionHealth.severity==='red'?'text-red-800':'text-amber-800');
      }else{
        syncEl.textContent='Unable to compare';
        syncEl.className='mt-2 text-sm font-semibold text-red-800';
      }
      mainEl.textContent=currentDeploy.mainCommit?'main '+String(currentDeploy.mainCommit).slice(0,12):'';
      const gitLinkEl=document.querySelector('[data-deploy-git-link]');
      const gitDetailEl=document.querySelector('[data-deploy-git-detail]');
      if(deploymentState==='synced'){
        if(connectionHealth.verificationSourceKey==='netlify-fallback'){
          gitLinkEl.textContent='Connected · production metadata verified';
          gitLinkEl.className='mt-2 text-sm font-semibold text-amber-800';
        }else{
          gitLinkEl.textContent='Connected · current';
          gitLinkEl.className='mt-2 text-sm font-semibold text-emerald-800';
        }
      }else if(deploymentState==='deploying'){
        gitLinkEl.textContent='Build in progress';
        gitLinkEl.className='mt-2 text-sm font-semibold '+(connectionHealth.severity==='red'?'text-red-800':'text-amber-800');
      }else if(deploymentState==='waiting'){
        gitLinkEl.textContent='Waiting for Git auto-deploy';
        gitLinkEl.className='mt-2 text-sm font-semibold text-amber-800';
      }else if(deploymentState==='deploy-failed'){
        gitLinkEl.textContent='Production deploy failed';
        gitLinkEl.className='mt-2 text-sm font-semibold text-red-800';
      }else if(deploymentState==='release-policy-skipped'){
        gitLinkEl.textContent='Commit skipped · [release] prefix required';
        gitLinkEl.className='mt-2 text-sm font-semibold text-amber-800';
      }else if(deploymentState==='auto-deploy-broken'){
        gitLinkEl.textContent=connectionHealth.githubLinked===false?'Disconnected or mislinked':'Git auto-deploy stalled';
        gitLinkEl.className='mt-2 text-sm font-semibold text-red-800';
      }else{
        gitLinkEl.textContent='Unable to verify';
        gitLinkEl.className='mt-2 text-sm font-semibold text-red-800';
      }
