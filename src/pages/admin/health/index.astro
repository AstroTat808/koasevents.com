            const modes=document.createElement('span');
            modes.className=change.changed?'font-black text-[var(--koa-clay)]':'text-[var(--koa-ink)]/40';
            modes.textContent=String(change.fromMode||'normal')+' → '+String(change.toMode||'normal');
            line.append(label,modes);
            list.appendChild(line);
