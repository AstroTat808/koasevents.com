      const expand=document.createElement('button');
      expand.type='button';
      expand.dataset.expandHealthWarnings='';
      expand.className='health-warning-tool-button health-expand-warnings-button';
      expand.textContent='Expand all warnings';
      expand.addEventListener('click',()=>{
        const sections=[...document.querySelectorAll('[data-mobile-collapsible]')]
