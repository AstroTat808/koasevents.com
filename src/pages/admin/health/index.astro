---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Admin Health" description="System health, monitoring, and deployment history for Koa’s protected workspaces." canonical="https://koasevents.com/admin/health/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-7xl">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Reliability</p>
          <h1 class="display mt-3 text-5xl">System health</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Hourly monitoring, transition-only alerts, protected page/API status, and deployment QA history in one place.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button data-refresh type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Run checks now</button>
          
        </div>
      </div>

      <div data-unauthorized class="mt-8 hidden rounded-[1.4rem] bg-white p-7 shadow-[var(--shadow-soft)]">This health dashboard requires an administrator account.</div>

      <div data-app class="mt-8 hidden grid gap-6">
        <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Overall</p><p data-overall class="display mt-3 text-4xl text-[var(--koa-forest)]">—</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Passed</p><p data-passed class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Failed</p><p data-failed class="display mt-3 text-4xl text-red-800">0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-ink)] p-5 text-white shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-amber-light)]">Last checked</p><p data-checked class="mt-3 text-sm font-semibold">—</p></article>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Microsoft 365 integration</p>
              <h2 class="display mt-2 text-4xl">Office 365 calendar sync</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Production synchronization health for the shared Koa’s Events calendar.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span data-office365-severity class="rounded-full bg-slate-100 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-slate-700">Reliability —</span>
              <a href="/admin/calendar/" class="w-fit rounded-full border border-[var(--koa-line)] px-4 py-3 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Open Master Calendar</a>
            </div>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Authentication</p>
              <p data-office365-auth class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
              <p data-office365-auth-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Last successful sync</p>
              <p data-office365-last-success class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Next scheduled sync</p>
              <p data-office365-next class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Unresolved conflicts</p>
              <p data-office365-conflicts class="display mt-2 text-3xl text-[var(--koa-forest)]">0</p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Events changed · 24h</p>
              <p data-office365-changed class="display mt-2 text-3xl text-[var(--koa-forest)]">0</p>
              <p data-office365-runs class="mt-1 text-[.68rem] text-[var(--koa-ink)]/45"></p>
            </article>
          </div>
          <div class="mt-5 grid gap-4 lg:grid-cols-2">
            <article class="rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
              <div class="flex items-center justify-between gap-3">
                <div><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">7-day reliability</p><h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Recent sync performance</h3></div>
                <span data-office365-reliability-7d-runs class="text-xs font-semibold text-[var(--koa-ink)]/45">—</span>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Success rate</p><p data-office365-reliability-7d-success class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Avg changed/run</p><p data-office365-reliability-7d-average class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Conflict rate</p><p data-office365-reliability-7d-conflict class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Auth failures</p><p data-office365-reliability-7d-auth class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
              </div>
            </article>
            <article class="rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
              <div class="flex items-center justify-between gap-3">
                <div><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">30-day reliability</p><h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Longer-term sync performance</h3></div>
                <span data-office365-reliability-30d-runs class="text-xs font-semibold text-[var(--koa-ink)]/45">—</span>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Success rate</p><p data-office365-reliability-30d-success class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Avg changed/run</p><p data-office365-reliability-30d-average class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Conflict rate</p><p data-office365-reliability-30d-conflict class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Auth failures</p><p data-office365-reliability-30d-auth class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
              </div>
            </article>
          </div>

          <div class="mt-5 rounded-[1.2rem] border border-[var(--koa-line)] bg-white p-5">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">30-day trend</p>
                <h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Daily Office 365 reliability</h3>
                <p class="mt-1 text-xs text-[var(--koa-ink)]/48">Success rate is shown as a line. Daily conflict runs and authentication failures are shown as bars.</p>
              </div>
              <div class="flex flex-wrap gap-3 text-[.62rem] font-bold text-[var(--koa-ink)]/55">
                <span>● Success rate</span><span>▮ Conflicts</span><span>▮ Auth failures</span>
              </div>
            </div>
            <div data-office365-trend class="mt-4 overflow-x-auto"></div>
          </div>

          <div class="mt-5 rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Reliability thresholds</p>
                <h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Automatic health severity</h3>
                <p class="mt-1 text-xs text-[var(--koa-ink)]/48">Based on the rolling 7-day sync success rate. Green is at or above the yellow threshold; red is below the red threshold.</p>
              </div>
              <div class="flex flex-wrap items-end gap-3">
                <label class="grid gap-1 text-xs font-bold text-[var(--koa-ink)]/65">Yellow below %
                  <input data-office365-yellow-threshold type="number" min="0" max="100" step=".1" class="w-28 rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-sm" />
                </label>
                <label class="grid gap-1 text-xs font-bold text-[var(--koa-ink)]/65">Red below %
                  <input data-office365-red-threshold type="number" min="0" max="100" step=".1" class="w-28 rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-sm" />
                </label>
                <button data-save-office365-thresholds type="button" class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-xs font-black uppercase tracking-[.08em] text-white">Save thresholds</button>
              </div>
            </div>
            <p data-office365-threshold-message class="mt-3 text-xs text-[var(--koa-ink)]/50"></p>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div><p class="eyebrow text-[var(--koa-clay)]">Current production</p><h2 class="display mt-2 text-4xl">Deployment</h2></div>
          <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-6">
            <article class="rounded-xl bg-[var(--koa-sand)] p-4 xl:col-span-2"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Commit</p><p data-deploy-commit class="mt-2 break-all text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4 xl:col-span-2"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Deploy ID</p><p data-deploy-id class="mt-2 break-all text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Deployed</p><p data-deploy-built class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Functions</p><p data-deploy-functions class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4 xl:col-span-2"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Production vs main</p><p data-deploy-sync class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p><p data-deploy-main class="mt-1 break-all text-[.65rem] text-[var(--koa-ink)]/45"></p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4 xl:col-span-2"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Last successful QA</p><p data-deploy-last-qa class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4 xl:col-span-2"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Deployment health</p><p data-deploy-health class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4 xl:col-span-2"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Post-deploy verification</p><p data-post-deploy-verification class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
          </div>

          <div data-credit-panel class="mt-6 rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Netlify credit usage</p>
                <h3 class="display mt-2 text-3xl text-[var(--koa-forest)]">Estimated total usage</h3>
              </div>
              <div class="text-right">
                <p data-credit-status class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-[.58rem] font-black uppercase tracking-[.08em] text-emerald-800">Healthy</p>
                <p data-credit-cycle class="mt-2 text-xs font-semibold text-[var(--koa-ink)]/55">—</p>
              </div>
            </div>

            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">
              <article class="rounded-xl bg-white p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Estimated total credits</p><p data-credit-total class="display mt-2 text-3xl text-[var(--koa-forest)]">—</p></article>
              <article class="rounded-xl bg-white p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Allowance used</p><p data-credit-percent class="display mt-2 text-3xl text-[var(--koa-forest)]">—</p></article>
              <article class="rounded-xl bg-white p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Projected cycle total</p><p data-credit-projected class="display mt-2 text-3xl text-[var(--koa-forest)]">—</p><p data-credit-projected-meta class="mt-2 text-xs text-[var(--koa-ink)]/50">—</p></article>
              <article class="rounded-xl bg-white p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Days until exhausted</p><p data-credit-exhaust-days class="display mt-2 text-3xl text-[var(--koa-forest)]">—</p><p data-credit-exhaust-date class="mt-2 text-xs text-[var(--koa-ink)]/50">Only shown when projected over allowance</p></article>
              <article class="rounded-xl bg-white p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Credits saved</p><p data-credit-saved class="display mt-2 text-3xl text-[var(--koa-forest)]">—</p><p data-credit-saved-meta class="mt-2 text-xs text-[var(--koa-ink)]/50">—</p></article>
              <article class="rounded-xl bg-white p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Estimated remaining</p><p data-credit-remaining class="display mt-2 text-3xl text-[var(--koa-forest)]">—</p></article>
              <article class="rounded-xl bg-white p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Monthly allowance</p><p data-credit-allowance class="display mt-2 text-3xl text-[var(--koa-forest)]">—</p></article>
            </div>
            <div data-credit-forecast-warning class="mt-4 hidden rounded-xl border p-4 text-sm font-semibold"></div>

            <div class="mt-4 h-3 overflow-hidden rounded-full bg-white">
              <div data-credit-bar class="h-full rounded-full bg-emerald-600 transition-[width] duration-500" style="width:0%"></div>
            </div>
            <div class="mt-2 flex justify-between text-[.62rem] font-semibold text-[var(--koa-ink)]/45">
              <span>0%</span><span>60% yellow</span><span>80% orange</span><span>90% red</span><span>100%</span>
            </div>

            <div class="mt-5 grid gap-4 xl:grid-cols-[1.35fr_.65fr]">
              <div class="rounded-xl bg-white p-4">
                <div class="flex flex-wrap items-end justify-between gap-3">
                  <div>
                    <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">30-day credit burn</p>
                    <p class="mt-1 text-xs text-[var(--koa-ink)]/50">Observed estimated usage versus current weighted projection</p>
                  </div>
                  <div class="flex items-center gap-3 text-[.62rem] font-semibold text-[var(--koa-ink)]/50">
                    <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-[var(--koa-forest)]"></span>Actual</span>
                    <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-[var(--koa-clay)]"></span>Projected</span>
                  </div>
                </div>
                <div class="mt-4 h-56 w-full">
                  <svg data-credit-chart viewBox="0 0 800 220" preserveAspectRatio="none" class="h-full w-full overflow-visible" role="img" aria-label="Netlify credit burn chart"></svg>
                </div>
                <p data-credit-chart-note class="mt-2 text-[.68rem] leading-5 text-[var(--koa-ink)]/45">—</p>
              </div>
              <div class="rounded-xl bg-white p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Recommended actions</p>
                    <p data-credit-saver-status class="mt-1 text-xs text-[var(--koa-ink)]/50">No temporary credit-saver settings active.</p>
                  </div>
                  <button data-credit-saver-clear type="button" class="hidden rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.6rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Restore all now</button>
                </div>
                <div data-credit-recommendations class="mt-3 grid gap-3"></div>
              </div>
            </div>

            <div data-credit-components class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-4"></div>
            <p data-credit-note class="mt-4 text-xs leading-5 text-[var(--koa-ink)]/52">—</p>
          </div>
          <div class="mt-6">
            <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Release timeline</p>
            <p class="mt-2 text-sm text-[var(--koa-ink)]/55">Search or filter releases, click one for details, or compare two production deploys side-by-side.</p>
            <div class="mt-4 grid gap-3 lg:grid-cols-[1fr_auto_auto]">
              <input data-release-search type="search" placeholder="Search commit, deploy, file, or feature…" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm" />
              <select data-release-filter class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-sm font-semibold">
                <option value="all">All changes</option>
                <option value="crm">CRM</option>
                <option value="quickbooks">QuickBooks</option>
                <option value="website">Website</option>
                <option value="security">Security</option>
                <option value="vendor">Vendor</option>
                <option value="users">User Management</option>
              </select>
              <button data-release-clear type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Clear</button>
            </div>
            <div class="mt-4 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] p-4">
              <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Compare releases</p>
              <div class="mt-3 grid gap-3 lg:grid-cols-[1fr_1fr_auto]">
                <select data-compare-base class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-sm font-semibold"><option value="">Older release</option></select>
                <select data-compare-head class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-sm font-semibold"><option value="">Newer release</option></select>
                <button data-compare-releases type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.08em] text-white">Compare</button>
              </div>
              <p data-compare-message class="mt-2 text-xs text-[var(--koa-ink)]/55"></p>
            </div>
            <div data-release-timeline class="mt-3 grid gap-3"></div>
          </div>
          <div class="mt-6">
            <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Grouped failed deploys</p>
            <p class="mt-2 text-sm text-[var(--koa-ink)]/55">Consecutive production failures with the same underlying error are grouped into one incident-style row.</p>
            <div data-failed-deploy-groups class="mt-3 grid gap-3"></div>
          </div>
          <div class="mt-6"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Recent deployment QA</p><div data-deploy-history class="mt-3 grid gap-3"></div></div>
        </section>

        <dialog data-release-dialog class="w-[min(94vw,760px)] rounded-[1.4rem] border-0 bg-white p-0 shadow-2xl backdrop:bg-black/40">
          <div class="p-6">
            <div class="flex items-start justify-between gap-4">
              <div><p class="eyebrow text-[var(--koa-clay)]">Production release</p><h2 data-release-title class="display mt-2 text-3xl">Release details</h2></div>
              <button data-close-release type="button" class="text-2xl leading-none text-[var(--koa-ink)]/40">×</button>
            </div>
            <div data-release-detail class="mt-5 grid gap-5 text-sm"></div>
          </div>
        </dialog>

        <dialog data-compare-dialog class="w-[min(96vw,980px)] rounded-[1.4rem] border-0 bg-white p-0 shadow-2xl backdrop:bg-black/40">
          <div class="p-6">
            <div class="flex items-start justify-between gap-4">
              <div><p class="eyebrow text-[var(--koa-clay)]">Release comparison</p><h2 data-compare-title class="display mt-2 text-3xl">Compare releases</h2></div>
              <button data-close-compare type="button" class="text-2xl leading-none text-[var(--koa-ink)]/40">×</button>
            </div>
            <div data-compare-detail class="mt-5 grid gap-5 text-sm"></div>
          </div>
        </dialog>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div><p class="eyebrow text-[var(--koa-clay)]">Protected interfaces</p><h2 class="display mt-2 text-4xl">Pages + APIs</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Hourly checks use non-destructive page-shell probes and protected endpoint reachability checks. Manual checks use the same monitor and immediately persist the result.</p></div>
          <div data-results class="mt-5 grid gap-3 lg:grid-cols-2"></div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Reliability</p>
            <h2 class="display mt-2 text-4xl">Uptime by service</h2>
            <p class="mt-2 text-sm text-[var(--koa-ink)]/55">Calculated only from completed hourly monitor samples. New monitoring periods build coverage over time; percentages are not backfilled from before the monitor existed.</p>
          </div>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full min-w-[820px] border-collapse text-sm">
              <thead>
                <tr class="border-b border-[var(--koa-line)] text-left text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">
                  <th class="py-3 pr-4">Service</th>
                  <th class="py-3 pr-4">Type</th>
                  <th class="py-3 pr-4">24 hours</th>
                  <th class="py-3 pr-4">7 days</th>
                  <th class="py-3 pr-4">30 days</th>
                  <th class="py-3">90 days</th>
                </tr>
              </thead>
              <tbody data-uptime-body></tbody>
            </table>
          </div>
          <p data-uptime-samples class="mt-4 text-xs text-[var(--koa-ink)]/48"></p>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Incidents</p>
            <h2 class="display mt-2 text-4xl">Observed outage duration</h2>
            <p class="mt-2 text-sm text-[var(--koa-ink)]/55">Durations are measured from the first failing hourly sample until the first subsequent healthy hourly sample. With hourly monitoring, the timeline has hourly resolution.</p>
          </div>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full min-w-[900px] border-collapse text-sm">
              <thead><tr class="border-b border-[var(--koa-line)] text-left text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">
                <th class="py-3 pr-4">Service</th><th class="py-3 pr-4">Current incident</th><th class="py-3 pr-4">7-day downtime</th><th class="py-3 pr-4">30-day downtime</th><th class="py-3">90-day downtime</th>
              </tr></thead>
              <tbody data-incident-body></tbody>
            </table>
          </div>
          <div class="mt-6"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Recent incident timeline</p><div data-incident-list class="mt-3 grid gap-3"></div></div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Alert policy</p>
              <h2 class="display mt-2 text-4xl">Notifications + public status</h2>
              <p class="mt-2 max-w-3xl text-sm text-[var(--koa-ink)]/55">Critical services can alert immediately. Lower-priority checks can require two consecutive scheduled hourly failures. Public status settings never expose internal paths, HTTP codes, commits, staff data, or security details.</p>
            </div>
            <a href="/status/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Preview public status</a>
          </div>

          <label class="mt-5 flex items-center gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4">
            <input data-public-status-enabled type="checkbox" class="h-4 w-4" />
            <span><strong class="block text-sm text-[var(--koa-forest)]">Enable public status publishing</strong><span class="mt-1 block text-xs text-[var(--koa-ink)]/50">When off, /status/ shows no individual service details or incident history.</span></span>
          </label>

          <div class="mt-5 overflow-x-auto">
            <table class="w-full min-w-[980px] border-collapse text-sm">
              <thead><tr class="border-b border-[var(--koa-line)] text-left text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">
                <th class="py-3 pr-4">Service</th><th class="py-3 pr-4">Alert after</th><th class="py-3 pr-4">Publish publicly</th><th class="py-3">Public label</th>
              </tr></thead>
              <tbody data-policy-body></tbody>
            </table>
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button data-save-policy type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save alert policy</button>
            <p data-policy-message class="text-sm text-[var(--koa-ink)]/52"></p>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div><p class="eyebrow text-[var(--koa-clay)]">History</p><h2 class="display mt-2 text-4xl">Recent health checks</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Hourly and manual snapshots. Email, Slack, and SMS notifications use the same transition-only logic when those channels are configured.</p></div>
          <div data-health-history class="mt-5 grid gap-3"></div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const app=document.querySelector('[data-app]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const refresh=document.querySelector('[data-refresh]');
    const results=document.querySelector('[data-results]');
    const historyEl=document.querySelector('[data-health-history]');
    const deployHistory=document.querySelector('[data-deploy-history]');
    const failedDeployGroups=document.querySelector('[data-failed-deploy-groups]');
    const releaseTimeline=document.querySelector('[data-release-timeline]');
    const releaseDialog=document.querySelector('[data-release-dialog]');
    const releaseTitle=document.querySelector('[data-release-title]');
    const releaseDetail=document.querySelector('[data-release-detail]');
    const releaseSearch=document.querySelector('[data-release-search]');
    const releaseFilter=document.querySelector('[data-release-filter]');
    const compareBase=document.querySelector('[data-compare-base]');
    const compareHead=document.querySelector('[data-compare-head]');
    const compareMessage=document.querySelector('[data-compare-message]');
    const compareDialog=document.querySelector('[data-compare-dialog]');
    const compareTitle=document.querySelector('[data-compare-title]');
    const compareDetail=document.querySelector('[data-compare-detail]');
    const uptimeBody=document.querySelector('[data-uptime-body]');
    const uptimeSamples=document.querySelector('[data-uptime-samples]');
    const incidentBody=document.querySelector('[data-incident-body]');
    const incidentList=document.querySelector('[data-incident-list]');
    const policyBody=document.querySelector('[data-policy-body]');
    const publicStatusEnabled=document.querySelector('[data-public-status-enabled]');
    const savePolicy=document.querySelector('[data-save-policy]');
    const policyMessage=document.querySelector('[data-policy-message]');
    const office365Auth=document.querySelector('[data-office365-auth]');
    const office365AuthDetail=document.querySelector('[data-office365-auth-detail]');
    const office365LastSuccess=document.querySelector('[data-office365-last-success]');
    const office365Next=document.querySelector('[data-office365-next]');
    const office365Conflicts=document.querySelector('[data-office365-conflicts]');
    const office365Changed=document.querySelector('[data-office365-changed]');
    const office365Runs=document.querySelector('[data-office365-runs]');
    const office365Reliability7dRuns=document.querySelector('[data-office365-reliability-7d-runs]');
    const office365Reliability7dSuccess=document.querySelector('[data-office365-reliability-7d-success]');
    const office365Reliability7dAverage=document.querySelector('[data-office365-reliability-7d-average]');
    const office365Reliability7dConflict=document.querySelector('[data-office365-reliability-7d-conflict]');
    const office365Reliability7dAuth=document.querySelector('[data-office365-reliability-7d-auth]');
    const office365Reliability30dRuns=document.querySelector('[data-office365-reliability-30d-runs]');
    const office365Reliability30dSuccess=document.querySelector('[data-office365-reliability-30d-success]');
    const office365Reliability30dAverage=document.querySelector('[data-office365-reliability-30d-average]');
    const office365Reliability30dConflict=document.querySelector('[data-office365-reliability-30d-conflict]');
    const office365Reliability30dAuth=document.querySelector('[data-office365-reliability-30d-auth]');
    const office365Trend=document.querySelector('[data-office365-trend]');
    const office365Severity=document.querySelector('[data-office365-severity]');
    const office365YellowThreshold=document.querySelector('[data-office365-yellow-threshold]');
    const office365RedThreshold=document.querySelector('[data-office365-red-threshold]');
    const saveOffice365Thresholds=document.querySelector('[data-save-office365-thresholds]');
    const office365ThresholdMessage=document.querySelector('[data-office365-threshold-message]');
    const overall=document.querySelector('[data-overall]');
    const creditPanel=document.querySelector('[data-credit-panel]');
    const creditCycle=document.querySelector('[data-credit-cycle]');
    const creditStatus=document.querySelector('[data-credit-status]');
    const creditTotal=document.querySelector('[data-credit-total]');
    const creditRemaining=document.querySelector('[data-credit-remaining]');
    const creditProjected=document.querySelector('[data-credit-projected]');
    const creditProjectedMeta=document.querySelector('[data-credit-projected-meta]');
    const creditSaved=document.querySelector('[data-credit-saved]');
    const creditExhaustDays=document.querySelector('[data-credit-exhaust-days]');
    const creditExhaustDate=document.querySelector('[data-credit-exhaust-date]');
    const creditSavedMeta=document.querySelector('[data-credit-saved-meta]');
    const creditForecastWarning=document.querySelector('[data-credit-forecast-warning]');
    const creditAllowance=document.querySelector('[data-credit-allowance]');
    const creditPercent=document.querySelector('[data-credit-percent]');
    const creditBar=document.querySelector('[data-credit-bar]');
    const creditComponents=document.querySelector('[data-credit-components]');
    const creditNote=document.querySelector('[data-credit-note]');
    const creditChart=document.querySelector('[data-credit-chart]');
    const creditChartNote=document.querySelector('[data-credit-chart-note]');
    const creditRecommendations=document.querySelector('[data-credit-recommendations]');
    const creditSaverStatus=document.querySelector('[data-credit-saver-status]');
    const creditSaverClear=document.querySelector('[data-credit-saver-clear]');
    let latestPolicy=null;
    let latestComponents=[];
    let latestReleases=[];
    const passed=document.querySelector('[data-passed]');
    const failed=document.querySelector('[data-failed]');
    const checked=document.querySelector('[data-checked]');

    function healthRow(row){
      const card=document.createElement('article');
      card.className='rounded-xl border '+(row.ok?'border-emerald-200 bg-emerald-50':'border-red-200 bg-red-50')+' p-4';
      const top=document.createElement('div');top.className='flex items-start justify-between gap-4';
      const left=document.createElement('div');
      const title=document.createElement('h3');title.className='font-semibold text-[var(--koa-forest)]';title.textContent=row.name;
      const meta=document.createElement('p');meta.className='mt-1 break-all text-xs text-[var(--koa-ink)]/48';meta.textContent=row.kind+' · '+row.path;
      left.append(title,meta);
      const badge=document.createElement('span');badge.className='shrink-0 rounded-full px-3 py-1 text-[.58rem] font-black uppercase tracking-[.08em] '+(row.ok?'bg-emerald-800 text-white':'bg-red-800 text-white');badge.textContent=row.ok?'Healthy':'Failed';
      top.append(left,badge);
      const detail=document.createElement('p');detail.className='mt-3 text-xs leading-5 text-[var(--koa-ink)]/60';detail.textContent='HTTP '+(row.status||'—')+' · '+row.ms+' ms · '+(row.detail||'');
      card.append(top,detail);return card;
    }

    function formatDuration(minutes){
      const value=Math.max(0,Number(minutes||0));
      const days=Math.floor(value/1440);
      const hours=Math.floor((value%1440)/60);
      const mins=Math.round(value%60);
      const parts=[];
      if(days)parts.push(days+'d');
      if(hours)parts.push(hours+'h');
      if(mins||!parts.length)parts.push(mins+'m');
      return parts.join(' ');
    }

    function renderReleaseTimeline(){
      releaseTimeline.innerHTML='';
      const term=String(releaseSearch?.value||'').trim().toLowerCase();
      const category=String(releaseFilter?.value||'all');
      const releases=latestReleases.filter((release)=>{
        const haystack=[
          release.commitTitle,release.commitMessage,release.commit,release.deployId,release.summary,
          release.authorName,release.authorLogin,release.pullRequestNumber,release.pullRequestUrl,
          ...(release.features||[]),...(release.changedFiles||[])
        ].join(' ').toLowerCase();
        const termOk=!term||haystack.includes(term);
        const features=new Set(release.features||[]);
        const categoryOk=
          category==='all' ||
          (category==='crm' && (features.has('Business CRM')||features.has('Sales CRM & Proposals'))) ||
          (category==='quickbooks' && features.has('QuickBooks')) ||
          (category==='website' && ['Public Website','Blog','Gallery','Local SEO'].some(value=>features.has(value))) ||
          (category==='security' && ['Authentication & Security','System Health'].some(value=>features.has(value))) ||
          (category==='vendor' && ['Vendor CRM','Insurance Compliance'].some(value=>features.has(value))) ||
          (category==='users' && features.has('User Management'));
        return termOk&&categoryOk;
      });
      releases.forEach((release)=>{
        const index=latestReleases.indexOf(release);
        const button=document.createElement('button');
        button.type='button';
        button.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)]';
        const qaLabel=release.qa?.conclusion==='success'?'QA passed':release.qa?.conclusion==='failure'?'QA failed':'QA unavailable';
        const incidentCount=(release.incidents||[]).length;
        button.innerHTML='<div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Release '+(index+1)+'</p><strong class="mt-1 block text-sm text-[var(--koa-forest)]"></strong><p class="mt-1 break-all text-xs text-[var(--koa-ink)]/45"></p></div><span class="rounded-full px-3 py-1 text-[.56rem] font-black uppercase tracking-[.06em] '+(release.qa?.conclusion==='success'?'bg-emerald-100 text-emerald-800':release.qa?.conclusion==='failure'?'bg-red-100 text-red-800':'bg-[var(--koa-sand)] text-[var(--koa-forest)]')+'">'+qaLabel+'</span></div><p data-release-summary class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/65"></p><p data-release-meta class="mt-2 text-xs text-[var(--koa-ink)]/55"></p>';
        button.querySelector('strong').textContent=release.commitTitle||'Production release';
        button.querySelector('p.text-xs').textContent=(release.commit||'').slice(0,12)+' · '+(release.deployId||'');
        button.querySelector('[data-release-summary]').textContent=release.summary||'Release summary not recorded yet.';
        const author=release.authorLogin?'@'+release.authorLogin:(release.authorName||'Unknown author');
        const pr=release.pullRequestNumber?'PR #'+release.pullRequestNumber:'No PR linked';
        button.querySelector('[data-release-meta]').textContent=author+' · '+pr+' · '+(release.publishedAt?new Date(release.publishedAt).toLocaleString():'Unknown deployment time')+' · '+(release.deployDurationSeconds==null?'duration unavailable':release.deployDurationSeconds+'s deploy')+' · '+incidentCount+' incident'+(incidentCount===1?'':'s')+' began';
        button.addEventListener('click',()=>showRelease(release));
        releaseTimeline.appendChild(button);
      });
      if(!releases.length)releaseTimeline.innerHTML='<p class="text-sm text-[var(--koa-ink)]/50">No releases match the current search/filter.</p>';
    }

    function populateCompareSelectors(){
      const currentBase=compareBase.value;
      const currentHead=compareHead.value;
      const options=latestReleases.map((release,index)=>'<option value="'+release.commit+'">'+(index+1)+'. '+(release.commitTitle||'Production release')+' · '+String(release.commit||'').slice(0,8)+'</option>').join('');
      compareBase.innerHTML='<option value="">Older release</option>'+options;
      compareHead.innerHTML='<option value="">Newer release</option>'+options;
      if(latestReleases.length>=2){
        compareBase.value=currentBase||latestReleases[1].commit;
        compareHead.value=currentHead||latestReleases[0].commit;
      }
    }

    function showComparison(comparison){
      compareDetail.innerHTML='';
      compareTitle.textContent='Release comparison';
      const stats=document.createElement('section');stats.className='grid gap-3 sm:grid-cols-4';
      [
        ['Commits',String(comparison.totalCommits||0)],
        ['Files',String((comparison.files||[]).length)],
        ['Additions',String((comparison.files||[]).reduce((sum,file)=>sum+Number(file.additions||0),0))],
        ['Deletions',String((comparison.files||[]).reduce((sum,file)=>sum+Number(file.deletions||0),0))],
      ].forEach(([label,value])=>{
        const card=document.createElement('div');card.className='rounded-xl bg-[var(--koa-sand)] p-4';
        card.innerHTML='<p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]"></p><p class="mt-2 text-lg font-semibold text-[var(--koa-forest)]"></p>';
        card.children[0].textContent=label;card.children[1].textContent=value;stats.appendChild(card);
      });
      compareDetail.appendChild(stats);

      const risks=document.createElement('section');
      const riskLevel=String(comparison.riskLevel||'low');
      risks.className='rounded-xl border '+(riskLevel==='high'?'border-red-200 bg-red-50':riskLevel==='medium'?'border-amber-200 bg-amber-50':'border-emerald-200 bg-emerald-50')+' p-4';
      risks.innerHTML='<div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-[.56rem] font-black uppercase tracking-[.09em] '+(riskLevel==='high'?'text-red-700':riskLevel==='medium'?'text-amber-800':'text-emerald-800')+'">Potentially risky changes</p><p class="mt-1 text-sm font-semibold text-[var(--koa-forest)]">'+(riskLevel==='high'?'High review attention':riskLevel==='medium'?'Review recommended':'No high-risk categories detected')+'</p></div><span class="rounded-full px-3 py-1 text-[.56rem] font-black uppercase tracking-[.06em] '+(riskLevel==='high'?'bg-red-700 text-white':riskLevel==='medium'?'bg-amber-200 text-amber-950':'bg-emerald-700 text-white')+'">'+riskLevel+'</span></div>';
      const riskList=document.createElement('div');riskList.className='mt-3 grid gap-2';
      (comparison.riskFlags||[]).forEach((flag)=>{
        const row=document.createElement('details');row.className='rounded-lg border border-black/10 bg-white/70 p-3';
        row.innerHTML='<summary class="cursor-pointer text-sm font-semibold text-[var(--koa-forest)]"></summary><p class="mt-2 text-xs text-[var(--koa-ink)]/55"></p>';
        row.querySelector('summary').textContent=flag.label+' · '+String(flag.severity||'').toUpperCase();
        const pieces=[];
        if((flag.files||[]).length)pieces.push('Files: '+flag.files.join(', '));
        if((flag.commits||[]).length)pieces.push('Commits: '+flag.commits.join(' | '));
        row.querySelector('p').textContent=pieces.join(' · ')||'Flagged by release-risk rules.';
        riskList.appendChild(row);
      });
      if(!(comparison.riskFlags||[]).length)riskList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No authentication, payment, CRM deletion, form, security, storage, or environment-variable risk categories were detected.</p>';
      risks.appendChild(riskList);compareDetail.appendChild(risks);

      const features=document.createElement('section');
      features.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Features affected</p>';
      const chips=document.createElement('div');chips.className='mt-3 flex flex-wrap gap-2';
      (comparison.features||[]).forEach((feature)=>{const chip=document.createElement('span');chip.className='rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]';chip.textContent=feature;chips.appendChild(chip);});
      if(!(comparison.features||[]).length)chips.innerHTML='<span class="text-sm text-[var(--koa-ink)]/48">No categorized feature changes.</span>';
      features.appendChild(chips);compareDetail.appendChild(features);

      const behavior=document.createElement('section');
      behavior.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Behavior changes</p>';
      const behaviorList=document.createElement('div');behaviorList.className='mt-3 grid gap-2';
      (comparison.behaviorChanges||[]).forEach((item)=>{const row=document.createElement('div');row.className='rounded-xl border border-[var(--koa-line)] p-3 text-sm text-[var(--koa-forest)]';row.textContent=item;behaviorList.appendChild(row);});
      if(!(comparison.behaviorChanges||[]).length)behaviorList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No commit-level behavior notes were found.</p>';
      behavior.appendChild(behaviorList);compareDetail.appendChild(behavior);

      const files=document.createElement('section');
      files.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Changed files</p>';
      const fileList=document.createElement('div');fileList.className='mt-3 max-h-[420px] overflow-auto rounded-xl border border-[var(--koa-line)]';
      (comparison.files||[]).forEach((file)=>{
        const row=document.createElement('div');row.className='border-b border-[var(--koa-line)] p-3 last:border-b-0';
        row.innerHTML='<div class="flex flex-wrap items-center justify-between gap-3"><code class="text-xs text-[var(--koa-forest)]"></code><span class="text-[.55rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]"></span></div><p class="mt-1 text-xs text-[var(--koa-ink)]/48"></p>';
        row.querySelector('code').textContent=file.filename;
        row.querySelector('span').textContent=file.status||'changed';
        row.querySelector('p').textContent='+'+Number(file.additions||0)+' / -'+Number(file.deletions||0)+' · '+Number(file.changes||0)+' total changes';
        fileList.appendChild(row);
      });
      if(!(comparison.files||[]).length)fileList.innerHTML='<p class="p-4 text-sm text-[var(--koa-ink)]/48">No file differences.</p>';
      files.appendChild(fileList);compareDetail.appendChild(files);
      compareDialog.showModal();
    }

    function showRelease(release){
      releaseTitle.textContent=release.commitTitle||'Production release';
      releaseDetail.innerHTML='';

      const summary=document.createElement('section');
      summary.className='rounded-xl bg-[var(--koa-sand)] p-4';
      const commitMessage=String(release.commitMessage||release.commitTitle||'No commit message recorded.');
      summary.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Commit</p><p class="mt-2 whitespace-pre-wrap font-semibold text-[var(--koa-forest)]"></p><p class="mt-3 break-all text-xs text-[var(--koa-ink)]/48"></p>';
      summary.querySelector('p.mt-2').textContent=commitMessage;
      summary.querySelector('p.mt-3').textContent='Commit '+(release.commit||'Unavailable')+' · Deploy '+(release.deployId||'Unavailable');
      releaseDetail.appendChild(summary);

      const releaseSummary=document.createElement('section');
      releaseSummary.className='rounded-xl border border-[var(--koa-line)] p-4';
      releaseSummary.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">What changed</p><p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/68"></p><div class="mt-3 flex flex-wrap gap-3 text-xs text-[var(--koa-ink)]/50"><span data-author></span><a data-pr class="hidden underline decoration-dotted underline-offset-4" target="_blank" rel="noopener noreferrer"></a></div>';
      releaseSummary.querySelector('p.mt-2').textContent=release.summary||'A plain-English release summary was not recorded for this deployment.';
      releaseSummary.querySelector('[data-author]').textContent='Author: '+(release.authorLogin?'@'+release.authorLogin:(release.authorName||'Unknown'));
      const prLink=releaseSummary.querySelector('[data-pr]');
      if(release.pullRequestUrl){
        prLink.href=release.pullRequestUrl;
        prLink.textContent='Pull request #'+(release.pullRequestNumber||'');
        prLink.classList.remove('hidden');
      }
      releaseDetail.appendChild(releaseSummary);

      const metrics=document.createElement('section');
      metrics.className='grid gap-3 sm:grid-cols-3';
      const qa=release.qa;
      const qaText=qa?.conclusion==='success'?'Passed':qa?.conclusion==='failure'?'Failed':qa?.status||'Unavailable';
      [
        ['Published',release.publishedAt?new Date(release.publishedAt).toLocaleString():'Unavailable'],
        ['Deploy duration',release.deployDurationSeconds==null?'Unavailable':release.deployDurationSeconds+' seconds'],
        ['QA result',qaText],
      ].forEach(([label,value])=>{
        const card=document.createElement('div');card.className='rounded-xl border border-[var(--koa-line)] p-4';
        card.innerHTML='<p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]"></p><p class="mt-2 text-sm font-semibold text-[var(--koa-forest)]"></p>';
        card.children[0].textContent=label;card.children[1].textContent=value;metrics.appendChild(card);
      });
      releaseDetail.appendChild(metrics);

      const features=document.createElement('section');
      features.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Features changed</p>';
      const featureList=document.createElement('div');featureList.className='mt-3 flex flex-wrap gap-2';
      (release.features||[]).forEach((feature)=>{const chip=document.createElement('span');chip.className='rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]';chip.textContent=feature;featureList.appendChild(chip);});
      if(!(release.features||[]).length)featureList.innerHTML='<span class="text-sm text-[var(--koa-ink)]/48">No categorized feature changes were recorded.</span>';
      features.appendChild(featureList);releaseDetail.appendChild(features);

      const incidents=document.createElement('section');
      incidents.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Incidents that began during this release</p>';
      const incidentList=document.createElement('div');incidentList.className='mt-3 grid gap-2';
      (release.incidents||[]).forEach((incident)=>{
        const row=document.createElement('div');row.className='rounded-xl border border-red-100 bg-red-50 p-3';
        row.innerHTML='<strong class="text-sm text-red-900"></strong><p class="mt-1 text-xs text-red-900/65"></p>';
        row.querySelector('strong').textContent=incident.componentName||incident.componentId||'System incident';
        row.querySelector('p').textContent=(incident.startedAt?new Date(incident.startedAt).toLocaleString():'Unknown start')+' · '+formatDuration(incident.durationMinutes||0)+(incident.ongoing?' · ongoing':'');
        incidentList.appendChild(row);
      });
      if(!(release.incidents||[]).length)incidentList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No monitored incidents began while this release was live.</p>';
      incidents.appendChild(incidentList);releaseDetail.appendChild(incidents);

      const files=document.createElement('details');
      files.className='rounded-xl border border-[var(--koa-line)] p-4';
      files.innerHTML='<summary class="cursor-pointer text-sm font-semibold text-[var(--koa-forest)]">Changed files ('+(release.changedFiles||[]).length+')</summary>';
      const pre=document.createElement('pre');pre.className='mt-3 max-h-60 overflow-auto whitespace-pre-wrap text-xs text-[var(--koa-ink)]/55';pre.textContent=(release.changedFiles||[]).join('\n')||'No changed-file list recorded.';files.appendChild(pre);releaseDetail.appendChild(files);

      releaseDialog.showModal();
    }

    function renderOffice365Trend(rows){
      if(!office365Trend)return;
      const data=Array.isArray(rows)?rows:[];
      if(!data.length){office365Trend.innerHTML='<p class="text-xs text-[var(--koa-ink)]/45">No sync trend history is available yet.</p>';return;}
      const width=900,height=250,padL=38,padR=20,padT=18,padB=34;
      const plotW=width-padL-padR,plotH=height-padT-padB;
      const maxCount=Math.max(1,...data.map((row)=>Math.max(Number(row.conflictRuns||0),Number(row.authenticationFailures||0))));
      const x=(index)=>padL+(data.length===1?plotW/2:index*(plotW/(data.length-1)));
      const yRate=(rate)=>padT+plotH-(Math.max(0,Math.min(100,Number(rate??0)))/100)*plotH;
      const yCount=(count)=>padT+plotH-(Math.max(0,Number(count||0))/maxCount)*(plotH*.35);
      const successPoints=data.filter((row)=>row.successRate!=null).map((row,index)=>{
        const actualIndex=data.indexOf(row);return x(actualIndex)+','+yRate(row.successRate);
      }).join(' ');
      let svg='<svg viewBox="0 0 '+width+' '+height+'" class="min-w-[760px] w-full" role="img" aria-label="Office 365 daily reliability trend">';
      [0,25,50,75,100].forEach((rate)=>{
        const y=yRate(rate);svg+='<line x1="'+padL+'" y1="'+y+'" x2="'+(width-padR)+'" y2="'+y+'" stroke="currentColor" opacity=".08"/><text x="4" y="'+(y+4)+'" font-size="10" fill="currentColor" opacity=".45">'+rate+'%</text>';
      });
      data.forEach((row,index)=>{
        const xx=x(index),barW=Math.max(4,Math.min(10,plotW/data.length*.28));
        const cy=yCount(row.conflictRuns),ay=yCount(row.authenticationFailures);
        const base=padT+plotH;
        if(Number(row.conflictRuns||0)>0)svg+='<rect x="'+(xx-barW-1)+'" y="'+cy+'" width="'+barW+'" height="'+(base-cy)+'" rx="2" fill="#c58a3a" opacity=".72"/>';
        if(Number(row.authenticationFailures||0)>0)svg+='<rect x="'+(xx+1)+'" y="'+ay+'" width="'+barW+'" height="'+(base-ay)+'" rx="2" fill="#991b1b" opacity=".72"/>';
        if(index%5===0||index===data.length-1)svg+='<text x="'+xx+'" y="'+(height-10)+'" text-anchor="middle" font-size="9" fill="currentColor" opacity=".45">'+String(row.date||'').slice(5)+'</text>';
      });
      if(successPoints)svg+='<polyline points="'+successPoints+'" fill="none" stroke="#24483b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>';
      data.forEach((row,index)=>{if(row.successRate!=null)svg+='<circle cx="'+x(index)+'" cy="'+yRate(row.successRate)+'" r="2.5" fill="#24483b"><title>'+row.date+': '+row.successRate+'% success, '+Number(row.conflictRuns||0)+' conflict runs, '+Number(row.authenticationFailures||0)+' auth failures</title></circle>';});
      svg+='</svg>';
      office365Trend.innerHTML=svg;
    }

    function render(data){
      const current=data.current;
      if(current){
        const bad=current.overall==='unhealthy';
        overall.textContent=bad?'Attention':'Healthy';
        overall.className='display mt-3 text-4xl '+(bad?'text-red-800':'text-[var(--koa-forest)]');
        passed.textContent=String(current.passed||0);
        failed.textContent=String(current.failed||0);
        checked.textContent=current.checkedAt?new Date(current.checkedAt).toLocaleString():'—';
        results.innerHTML='';
        (current.checks||[]).forEach(row=>results.appendChild(healthRow(row)));
      }else{
        overall.textContent='No data';
        results.innerHTML='<p class="text-sm text-[var(--koa-ink)]/50">No health snapshot has been recorded yet. Run checks now.</p>';
      }

      historyEl.innerHTML='';
      (data.history||[]).slice(0,20).forEach(row=>{
        const card=document.createElement('article');
        card.className='rounded-xl border '+(row.overall==='healthy'?'border-emerald-200':'border-red-200')+' p-4';
        card.innerHTML='<div class="flex items-center justify-between gap-4"><strong class="text-sm text-[var(--koa-forest)]">'+(row.overall==='healthy'?'Healthy':'Attention')+'</strong><span class="text-xs text-[var(--koa-ink)]/48">'+new Date(row.checkedAt).toLocaleString()+'</span></div><p class="mt-2 text-xs text-[var(--koa-ink)]/58">'+row.source+' · '+row.passed+' passed · '+row.failed+' failed'+(row.failedIds?.length?' · '+row.failedIds.join(', '):'')+'</p>';
        historyEl.appendChild(card);
      });

      const office365=data.office365||{};
      if(office365Auth){
        const authLabels={
          connected:'Connected',
          configured:'Configured · awaiting first sync',
          authentication_error:'Authentication error',
          sync_error:'Sync error',
          not_configured:'Not configured',
        };
        const authStatus=String(office365.authenticationStatus||'not_configured');
        office365Auth.textContent=authLabels[authStatus]||authStatus;
        office365Auth.className='mt-2 text-sm font-semibold '+(
          authStatus==='connected'?'text-emerald-800':
          authStatus==='configured'?'text-amber-800':
          'text-red-800'
        );
        office365AuthDetail.textContent=office365.lastError
          ? String(office365.lastError)
          : [office365.calendarName,office365.calendarOwner].filter(Boolean).join(' · ');
        office365LastSuccess.textContent=office365.lastSuccessAt?new Date(office365.lastSuccessAt).toLocaleString():'No successful sync yet';
        office365Next.textContent=office365.nextScheduledSyncAt?new Date(office365.nextScheduledSyncAt).toLocaleString():'—';
        office365Conflicts.textContent=String(office365.unresolvedConflicts||0);
        office365Conflicts.className='display mt-2 text-3xl '+(Number(office365.unresolvedConflicts||0)>0?'text-red-800':'text-[var(--koa-forest)]');
        office365Changed.textContent=String(office365.changedLast24Hours||0);
        office365Runs.textContent=String(office365.runsLast24Hours||0)+' sync run'+(Number(office365.runsLast24Hours||0)===1?'':'s')+' in the last 24 hours';
        const renderOfficeReliability=(period,nodes)=>{
          const runs=Number(period?.totalRuns||0);
          nodes.runs.textContent=runs+' run'+(runs===1?'':'s');
          nodes.success.textContent=period?.successRate==null?'—':String(period.successRate)+'%';
          nodes.average.textContent=period?.averageEventsChangedPerRun==null?'—':String(period.averageEventsChangedPerRun);
          nodes.conflict.textContent=period?.conflictRate==null?'—':String(period.conflictRate)+'%';
          nodes.auth.textContent=String(period?.authenticationFailures||0);
          nodes.auth.className='mt-1 text-xl font-semibold '+(Number(period?.authenticationFailures||0)>0?'text-red-800':'text-[var(--koa-forest)]');
          nodes.conflict.className='mt-1 text-xl font-semibold '+(Number(period?.conflictRate||0)>0?'text-amber-800':'text-[var(--koa-forest)]');
        };
        renderOfficeReliability(office365.reliability?.['7d']||{},{
          runs:office365Reliability7dRuns,success:office365Reliability7dSuccess,average:office365Reliability7dAverage,conflict:office365Reliability7dConflict,auth:office365Reliability7dAuth
        });
        renderOfficeReliability(office365.reliability?.['30d']||{},{
          runs:office365Reliability30dRuns,success:office365Reliability30dSuccess,average:office365Reliability30dAverage,conflict:office365Reliability30dConflict,auth:office365Reliability30dAuth
        });
        const thresholds=office365.reliabilityThresholds||{yellowBelow:98,redBelow:90};
        office365YellowThreshold.value=String(thresholds.yellowBelow??98);
        office365RedThreshold.value=String(thresholds.redBelow??90);
        const severity=String(office365.severity||'unknown');
        const severityLabels={green:'Healthy',yellow:'Watch',red:'Critical',unknown:'Insufficient data'};
        office365Severity.textContent='Reliability · '+(severityLabels[severity]||severity);
        office365Severity.className='rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+(
          severity==='green'?'bg-emerald-100 text-emerald-800':
          severity==='yellow'?'bg-amber-100 text-amber-900':
          severity==='red'?'bg-red-100 text-red-800':'bg-slate-100 text-slate-700'
        );
        renderOffice365Trend(office365.reliabilityTrend||[]);
      }

      const deployments=data.deployments||{};
      const creditUsage=deployments.creditUsage||{};
      if(creditCycle){
        const start=creditUsage.cycleStart?new Date(creditUsage.cycleStart).toLocaleDateString():'—';
        const end=creditUsage.cycleEnd?new Date(creditUsage.cycleEnd).toLocaleDateString():'—';
        creditCycle.textContent='Cycle '+start+' – '+end;
      }
      if(creditTotal)creditTotal.textContent=creditUsage.totalEstimatedCredits==null?'—':String(creditUsage.totalEstimatedCredits);
      if(creditRemaining)creditRemaining.textContent=creditUsage.estimatedRemainingCredits==null?'—':String(creditUsage.estimatedRemainingCredits);
      if(creditAllowance)creditAllowance.textContent=creditUsage.monthlyAllowance==null?'—':String(creditUsage.monthlyAllowance);
      if(creditProjected)creditProjected.textContent=creditUsage.projection?.projectedEndOfCycleCredits==null?'—':String(creditUsage.projection.projectedEndOfCycleCredits);
      if(creditProjectedMeta){
        const p=creditUsage.projection||{};
        if(p.projectedAllowancePercent==null){
          creditProjectedMeta.textContent='Forecast unavailable';
        }else{
          const recent=p.recent7DayBurnRate==null?'—':String(p.recent7DayBurnRate);
          const baseline=p.fullCycleDailyBurnRate==null?'—':String(p.fullCycleDailyBurnRate);
          const weighted=p.weightedDailyBurnRate==null?'—':String(p.weightedDailyBurnRate);
          creditProjectedMeta.textContent=String(p.projectedAllowancePercent)+'% of allowance · '+String(p.confidence||'low')+' confidence · '+recent+'/day recent · '+baseline+'/day cycle · '+weighted+'/day weighted';
        }
      }
      if(creditExhaustDays){
        const days=creditUsage.projection?.daysUntilExhausted;
        creditExhaustDays.textContent=days==null?'—':String(days);
      }
      if(creditExhaustDate){
        const at=creditUsage.projection?.exhaustionAt;
        creditExhaustDate.textContent=at
          ? 'Estimated '+new Date(at).toLocaleString()
          : 'Projection stays within current allowance';
      }
      if(creditSaved)creditSaved.textContent=creditUsage.savings?.estimatedCreditsSaved==null?'—':String(creditUsage.savings.estimatedCreditsSaved);
      if(creditSavedMeta){
        const s=creditUsage.savings||{};
        creditSavedMeta.textContent=(s.successfulDeployPreviews==null?'—':String(s.successfulDeployPreviews))+' successful preview'+(Number(s.successfulDeployPreviews)===1?'':'s')+' counted';
      }
      if(creditForecastWarning){
        const p=creditUsage.projection||{};
        const projectedSeverity=String(p.severity||'unknown');
        if(['yellow','orange','red'].includes(projectedSeverity)){
          creditForecastWarning.className='mt-4 rounded-xl border p-4 text-sm font-semibold '+(
            projectedSeverity==='red'?'border-red-300 bg-red-50 text-red-800':
            projectedSeverity==='orange'?'border-orange-300 bg-orange-50 text-orange-900':
            'border-yellow-300 bg-yellow-50 text-yellow-900'
          );
          const exhaustion=p.daysUntilExhausted==null?'':' Estimated exhaustion in '+String(p.daysUntilExhausted)+' days ('+new Date(p.exhaustionAt).toLocaleString()+').';
          creditForecastWarning.textContent='Projected end-of-cycle usage is '+String(p.projectedAllowancePercent)+'% ('+String(p.projectedEndOfCycleCredits)+' credits) using a recent-weighted burn rate.'+exhaustion;
        }else{
          creditForecastWarning.className='mt-4 hidden rounded-xl border p-4 text-sm font-semibold';
          creditForecastWarning.textContent='';
        }
      }
      if(creditPercent)creditPercent.textContent=creditUsage.estimatedAllowancePercent==null?'—':String(creditUsage.estimatedAllowancePercent)+'%';
      if(creditBar){
        const pct=Math.max(0,Math.min(100,Number(creditUsage.estimatedAllowancePercent||0)));
        creditBar.style.width=pct+'%';
      }
      if(creditStatus){
        const severity=String(creditUsage.warningSeverity||creditUsage.severity||'unknown');
        const statusMap={
          green:['Healthy','bg-emerald-100 text-emerald-800'],
          yellow:['Watch','bg-yellow-100 text-yellow-900'],
          orange:['High','bg-orange-100 text-orange-900'],
          red:['Critical','bg-red-100 text-red-800'],
          unknown:['Estimate unavailable','bg-[var(--koa-sand)] text-[var(--koa-forest)]'],
        };
        const selected=statusMap[severity]||statusMap.unknown;
        creditStatus.textContent=selected[0];
        creditStatus.className='inline-flex rounded-full px-3 py-1 text-[.58rem] font-black uppercase tracking-[.08em] '+selected[1];
        if(creditBar){
          creditBar.className='h-full rounded-full transition-[width] duration-500 '+(
            severity==='red'?'bg-red-700':severity==='orange'?'bg-orange-500':severity==='yellow'?'bg-yellow-500':'bg-emerald-600'
          );
        }
        if(creditPanel){
          creditPanel.className='mt-6 rounded-[1.2rem] border p-5 '+(
            severity==='red'?'border-red-300 bg-red-50':
            severity==='orange'?'border-orange-300 bg-orange-50':
            severity==='yellow'?'border-yellow-300 bg-yellow-50':
            'border-[var(--koa-line)] bg-[var(--koa-ivory)]'
          );
        }
      }
      if(creditComponents){
        creditComponents.innerHTML='';
        (creditUsage.components||[]).forEach((item)=>{
          const card=document.createElement('article');
          card.className='rounded-xl bg-white p-4';
          const label=document.createElement('p');
          label.className='text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]';
          label.textContent=item.label||item.id||'Usage';
          const value=document.createElement('p');
          value.className='display mt-2 text-2xl text-[var(--koa-forest)]';
          value.textContent=item.credits==null?'—':String(item.credits)+' credits';
          const meta=document.createElement('p');
          meta.className='mt-2 text-xs leading-5 text-[var(--koa-ink)]/52';
          const usage=item.usage==null?'usage unavailable':String(item.usage)+' '+String(item.unit||'');
          meta.textContent=usage+' · '+String(item.mode||'estimated');
          card.append(label,value,meta);
          creditComponents.appendChild(card);
        });
      }
      if(creditChart){
        creditChart.innerHTML='';
        const chart=creditUsage.chart||{};
        const actual=Array.isArray(chart.actual)?chart.actual:[];
        const projected=Array.isArray(chart.projected)?chart.projected:[];
        const allowance=Number(chart.allowance||creditUsage.monthlyAllowance||0);
        const all=[...actual,...projected].filter((row)=>Number.isFinite(Number(row?.credits))&&Number.isFinite(Date.parse(String(row?.at||''))));
        if(all.length){
          const width=800,height=220,padX=42,padY=18;
          const minX=Math.min(...all.map((row)=>Date.parse(String(row.at))));
          const maxX=Math.max(...all.map((row)=>Date.parse(String(row.at))));
          const maxCredit=Math.max(allowance||0,...all.map((row)=>Number(row.credits)||0),1);
          const x=(value)=>padX+((value-minX)/Math.max(1,maxX-minX))*(width-padX*2);
          const y=(value)=>height-padY-(value/maxCredit)*(height-padY*2);
          const ns='http://www.w3.org/2000/svg';
          const make=(tag,attrs={})=>{const el=document.createElementNS(ns,tag);Object.entries(attrs).forEach(([key,value])=>el.setAttribute(key,String(value)));return el;};

          [0,.25,.5,.75,1].forEach((fraction)=>{
            const value=maxCredit*fraction;
            const line=make('line',{x1:padX,y1:y(value),x2:width-padX,y2:y(value),stroke:'currentColor','stroke-opacity':'0.12','stroke-width':'1'});
            creditChart.appendChild(line);
            const label=make('text',{x:4,y:y(value)+4,fill:'currentColor','fill-opacity':'0.42','font-size':'10'});
            label.textContent=String(Math.round(value));
            creditChart.appendChild(label);
          });

          if(allowance>0){
            const allowanceLine=make('line',{x1:padX,y1:y(allowance),x2:width-padX,y2:y(allowance),stroke:'currentColor','stroke-opacity':'0.35','stroke-width':'1.5','stroke-dasharray':'6 5'});
            creditChart.appendChild(allowanceLine);
          }

          const pathFor=(rows)=>{
            const valid=rows.filter((row)=>Number.isFinite(Number(row?.credits))&&Number.isFinite(Date.parse(String(row?.at||''))));
            return valid.map((row,index)=>(index?'L':'M')+x(Date.parse(String(row.at)))+' '+y(Number(row.credits))).join(' ');
          };
          const actualPath=pathFor(actual);
          if(actualPath){
            const path=make('path',{d:actualPath,fill:'none',stroke:'var(--koa-forest)','stroke-width':'3','stroke-linecap':'round','stroke-linejoin':'round'});
            creditChart.appendChild(path);
          }
          const projectedPath=pathFor(projected);
          if(projectedPath){
            const path=make('path',{d:projectedPath,fill:'none',stroke:'var(--koa-clay)','stroke-width':'3','stroke-linecap':'round','stroke-linejoin':'round','stroke-dasharray':'8 6'});
            creditChart.appendChild(path);
          }
        }else{
          const ns='http://www.w3.org/2000/svg';
          const label=document.createElementNS(ns,'text');
          label.setAttribute('x','400');label.setAttribute('y','110');label.setAttribute('text-anchor','middle');label.setAttribute('fill','currentColor');label.setAttribute('fill-opacity','.45');label.setAttribute('font-size','14');
          label.textContent='Credit history will build as System Health stores snapshots.';
          creditChart.appendChild(label);
        }
      }
      if(creditChartNote)creditChartNote.textContent=creditUsage.chart?.note||'Credit history will build over time.';
      if(creditRecommendations){
        creditRecommendations.innerHTML='';
        const saverPolicy=creditUsage.saverPolicy||{};
        const activeActions=Array.isArray(saverPolicy.activeActions)?saverPolicy.activeActions:[];
        if(creditSaverStatus){
          creditSaverStatus.textContent=activeActions.length
            ? activeActions.length+' temporary setting'+(activeActions.length===1?' is':'s are')+' active until '+new Date(saverPolicy.expiresAt).toLocaleString()+'.'
            : 'No temporary credit-saver settings active.';
        }
        if(creditSaverClear)creditSaverClear.classList.toggle('hidden',activeActions.length===0);

        const recommendations=Array.isArray(creditUsage.recommendations)?creditUsage.recommendations:[];
        recommendations.sort((a,b)=>Number(a.priority||99)-Number(b.priority||99)).forEach((item,index)=>{
          const card=document.createElement('article');
          card.className='rounded-xl border '+(item.active?'border-emerald-300 bg-emerald-50':'border-[var(--koa-line)] bg-[var(--koa-ivory)]')+' p-3';
          const title=document.createElement('strong');
          title.className='block text-sm text-[var(--koa-forest)]';
          title.textContent=(index+1)+'. '+String(item.title||'Recommended action');
          const detail=document.createElement('p');
          detail.className='mt-1 text-xs leading-5 text-[var(--koa-ink)]/58';
          detail.textContent=String(item.detail||'');

          const savings=document.createElement('div');
          savings.className='mt-2 rounded-lg bg-white/75 p-2 text-[.68rem] leading-5 text-[var(--koa-ink)]/60';
          const perDay=item.estimatedSavingsPerDay;
          const cycle=item.estimatedSavingsThisCycle;
          savings.textContent=(perDay==null&&cycle==null)
            ? 'Estimated savings depend on future usage.'
            : 'Estimated savings: '+(perDay==null?'—':String(perDay)+' credits/day')+' · '+(cycle==null?'—':String(cycle)+' credits through this cycle');

          const impact=document.createElement('p');
          impact.className='mt-2 text-[.68rem] font-semibold leading-5 text-[var(--koa-clay)]';
          impact.textContent=String(item.impact||'');
          const protects=document.createElement('p');
          protects.className='mt-1 text-[.65rem] leading-5 text-[var(--koa-ink)]/42';
          protects.textContent=String(item.protects||'');
          card.append(title,detail,savings,impact,protects);

          if(item.canApply&&item.safeActionId){
            const actions=document.createElement('div');
            actions.className='mt-3 flex flex-wrap items-center gap-2';
            const button=document.createElement('button');
            button.type='button';
            button.dataset.creditSaverAction=String(item.safeActionId);
            button.dataset.creditSaverEnabled=item.active?'false':'true';
            button.className='rounded-full px-3 py-2 text-[.6rem] font-black uppercase tracking-[.07em] '+(item.active?'border border-emerald-300 bg-white text-emerald-800':'bg-[var(--koa-forest)] text-white');
            button.textContent=item.active?'Restore normal cadence':'Apply until cycle reset';
            actions.appendChild(button);
            card.appendChild(actions);
          }
          creditRecommendations.appendChild(card);
        });
        if(!recommendations.length){
          creditRecommendations.innerHTML='<p class="text-xs leading-5 text-[var(--koa-ink)]/50">No credit-saving intervention is currently recommended. The weighted projection is within the configured allowance.</p>';
        }
      }
      if(creditNote)creditNote.textContent=creditUsage.note||'Credit estimate unavailable.';
      const currentDeploy=deployments.current||{};
      document.querySelector('[data-deploy-commit]').textContent=currentDeploy.commit||'Unavailable';
      document.querySelector('[data-deploy-id]').textContent=currentDeploy.deployId||'Unavailable';
      document.querySelector('[data-deploy-built]').textContent=currentDeploy.deployTime?new Date(currentDeploy.deployTime).toLocaleString():(currentDeploy.builtAt?new Date(currentDeploy.builtAt).toLocaleString():'Unavailable');
      document.querySelector('[data-deploy-functions]').textContent=currentDeploy.functionCount==null?'Unavailable':String(currentDeploy.functionCount);
      const syncEl=document.querySelector('[data-deploy-sync]');
      const mainEl=document.querySelector('[data-deploy-main]');
      if(currentDeploy.behindMain===false){
        syncEl.textContent='Current with main';
        syncEl.className='mt-2 text-sm font-semibold text-emerald-800';
      }else if(currentDeploy.behindMain===true){
        const behind=Number(currentDeploy.commitsBehind||0);
        syncEl.textContent='Behind main'+(behind?' by '+behind+' commit'+(behind===1?'':'s'):'');
        syncEl.className='mt-2 text-sm font-semibold text-red-800';
      }else{
        syncEl.textContent='Unable to compare';
        syncEl.className='mt-2 text-sm font-semibold text-amber-800';
      }
      mainEl.textContent=currentDeploy.mainCommit?'main '+String(currentDeploy.mainCommit).slice(0,12):'';
      const lastQa=deployments.lastSuccessfulQa;
      document.querySelector('[data-deploy-last-qa]').textContent=lastQa
        ? ((lastQa.updatedAt||lastQa.createdAt)?new Date(lastQa.updatedAt||lastQa.createdAt).toLocaleString():'Success')+' · '+String(lastQa.commit||'').slice(0,12)
        : 'No successful production QA yet';
      const healthEl=document.querySelector('[data-deploy-health]');
      if(deployments.deploymentHealthy){
        healthEl.textContent='Healthy';
        healthEl.className='mt-2 text-sm font-semibold text-emerald-800';
      }else{
        const qaCurrent=deployments.latestQaForCurrentDeploy;
        healthEl.textContent=currentDeploy.behindMain===true?'Production is behind main':qaCurrent?.conclusion==='failure'?'Current deploy QA failed':'Waiting for successful QA on current deploy';
        healthEl.className='mt-2 text-sm font-semibold text-amber-800';
      }
      const postDeploy=deployments.postDeployVerification;
      const postDeployEl=document.querySelector('[data-post-deploy-verification]');
      if(postDeploy){
        const status=postDeploy.status==='success'?'Passed':'Attention';
        postDeployEl.textContent=status+' · '+(postDeploy.checkedAt?new Date(postDeploy.checkedAt).toLocaleString():'')+' · '+Number(postDeploy.passed||0)+' passed / '+Number(postDeploy.failed||0)+' failed';
        postDeployEl.className='mt-2 text-sm font-semibold '+(postDeploy.status==='success'?'text-emerald-800':'text-red-800');
      }else{
        postDeployEl.textContent='Waiting for the first scheduled verification';
        postDeployEl.className='mt-2 text-sm font-semibold text-amber-800';
      }

      latestReleases=deployments.releaseTimeline||[];
      renderReleaseTimeline();
      populateCompareSelectors();

      failedDeployGroups.innerHTML='';
      const deployGroups=deployments.failedDeployGroups||[];
      deployGroups.forEach((group)=>{
        const card=document.createElement('article');
        card.className='rounded-xl border border-red-200 bg-red-50 p-4';
        const commits=(group.commits||[]).filter(Boolean);
        const titles=(group.titles||[]).filter(Boolean);
        card.innerHTML='<div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-red-700">Same root cause</p><strong class="mt-1 block text-sm text-red-950"></strong></div><span class="rounded-full bg-red-700 px-3 py-1 text-[.56rem] font-black uppercase tracking-[.06em] text-white"></span></div><p data-group-window class="mt-2 text-xs text-red-900/65"></p><details class="mt-3 rounded-lg border border-red-200 bg-white/70 p-3"><summary class="cursor-pointer text-xs font-semibold text-red-900">Affected deploys / commits</summary><pre data-group-details class="mt-2 max-h-44 overflow-auto whitespace-pre-wrap text-[.68rem] text-red-900/65"></pre></details>';
        card.querySelector('strong').textContent=group.rootCause||'Unknown deployment failure';
        card.querySelector('span').textContent=String(group.count||1)+' failed deploy'+(Number(group.count||1)===1?'':'s');
        const first=group.firstAt?new Date(group.firstAt).toLocaleString():'';
        const last=group.lastAt?new Date(group.lastAt).toLocaleString():'';
        card.querySelector('[data-group-window]').textContent=(first&&last&&first!==last)?('Observed '+first+' through '+last):('Observed '+(last||first||'unknown time'));
        card.querySelector('[data-group-details]').textContent=[
          ...commits.map((commit,index)=>String(commit||'').slice(0,12)+(titles[index]?' · '+titles[index]:'')),
          ...(group.deployIds||[]).map((id)=>'Deploy '+id),
        ].join('\n');
        failedDeployGroups.appendChild(card);
      });
      if(!deployGroups.length)failedDeployGroups.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No grouped production deploy failures are available.</p>';

      deployHistory.innerHTML='';
      const rows=deployments.history||[];
      rows.slice(0,12).forEach(row=>{
        const ok=row.conclusion==='success';
        const card=document.createElement('article');
        card.className='rounded-xl border '+(ok?'border-emerald-200 bg-emerald-50':row.conclusion==='failure'?'border-red-200 bg-red-50':'border-[var(--koa-line)] bg-[var(--koa-ivory)]')+' p-4';
        const failedJobs=(row.failedJobs||[]).join(', ');
        card.innerHTML='<div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">'+(row.conclusion||row.status||'running')+'</p><p class="mt-1 break-all text-sm font-semibold text-[var(--koa-forest)]">'+String(row.commit||'').slice(0,12)+'</p></div><span class="text-xs text-[var(--koa-ink)]/48">'+(row.createdAt?new Date(row.createdAt).toLocaleString():'')+'</span></div>'+(failedJobs?'<p class="mt-2 text-xs font-semibold text-red-800">Failed QA: '+failedJobs+'</p>':'');
        deployHistory.appendChild(card);
      });
      if(!rows.length) deployHistory.innerHTML='<p class="text-sm text-[var(--koa-ink)]/50">Deployment QA history is not available yet.</p>';

      const uptime=data.uptime||{};
      uptimeBody.innerHTML='';
      const pct=(period)=>{
        if(!period||period.uptime==null)return '—';
        return period.uptime.toFixed(2)+'%';
      };
      const coverage=(period)=>{
        if(!period)return '';
        return period.samples+' / '+period.expected+' hourly samples';
      };
      (uptime.rows||[]).forEach((row)=>{
        const tr=document.createElement('tr');
        tr.className='border-b border-[var(--koa-line)] align-top';
        const service=document.createElement('td');service.className='py-4 pr-4';service.innerHTML='<strong class="text-[var(--koa-forest)]"></strong><span class="mt-1 block text-xs text-[var(--koa-ink)]/45"></span>';service.querySelector('strong').textContent=row.name;service.querySelector('span').textContent=row.path;
        const kind=document.createElement('td');kind.className='py-4 pr-4 text-xs font-semibold uppercase tracking-[.06em] text-[var(--koa-clay)]';kind.textContent=row.kind;
        tr.append(service,kind);
        ['24h','7d','30d','90d'].forEach((key)=>{
          const period=row.periods?.[key];
          const td=document.createElement('td');td.className='py-4 pr-4';
          const value=document.createElement('strong');value.className='block text-[var(--koa-forest)]';value.textContent=pct(period);
          const samples=document.createElement('span');samples.className='mt-1 block text-[.68rem] text-[var(--koa-ink)]/42';samples.textContent=coverage(period);
          td.append(value,samples);tr.appendChild(td);
        });
        uptimeBody.appendChild(tr);
      });
      if(!(uptime.rows||[]).length){
        const tr=document.createElement('tr');const td=document.createElement('td');td.colSpan=6;td.className='py-6 text-sm text-[var(--koa-ink)]/45';td.textContent='Hourly uptime data will appear after the scheduled monitor records its first run.';tr.appendChild(td);uptimeBody.appendChild(tr);
      }
      uptimeSamples.textContent=(uptime.hourlySamples||0)+' total hourly snapshot'+((uptime.hourlySamples||0)===1?'':'s')+' currently retained.';

      const incidentData=data.incidents||{};
      incidentBody.innerHTML='';
      (incidentData.rows||[]).forEach((row)=>{
        const tr=document.createElement('tr');tr.className='border-b border-[var(--koa-line)] align-top';
        const service=document.createElement('td');service.className='py-4 pr-4 font-semibold text-[var(--koa-forest)]';service.textContent=row.name;
        const current=document.createElement('td');current.className='py-4 pr-4';
        current.textContent=row.currentIncident?'Ongoing · '+formatDuration(row.currentIncident.durationMinutes):'None';
        tr.append(service,current);
        ['7d','30d','90d'].forEach((key)=>{
          const total=row.totals?.[key]||{};
          const td=document.createElement('td');td.className='py-4 pr-4';
          const strong=document.createElement('strong');strong.className='block text-[var(--koa-forest)]';strong.textContent=formatDuration(total.downtimeMinutes||0);
          const small=document.createElement('span');small.className='mt-1 block text-[.68rem] text-[var(--koa-ink)]/42';small.textContent=(total.incidentCount||0)+' incident'+((total.incidentCount||0)===1?'':'s');
          td.append(strong,small);tr.appendChild(td);
        });
        incidentBody.appendChild(tr);
      });
      if(!(incidentData.rows||[]).length){
        const tr=document.createElement('tr');const td=document.createElement('td');td.colSpan=5;td.className='py-6 text-sm text-[var(--koa-ink)]/45';td.textContent='Incident duration data will appear after hourly health samples accumulate.';tr.appendChild(td);incidentBody.appendChild(tr);
      }

      incidentList.innerHTML='';
      (incidentData.recentIncidents||[]).slice(0,20).forEach((incident)=>{
        const card=document.createElement('article');card.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
        const title=document.createElement('strong');title.className='text-sm text-[var(--koa-forest)]';title.textContent=incident.componentName;
        const detail=document.createElement('p');detail.className='mt-2 text-xs text-[var(--koa-ink)]/55';
        detail.textContent=(incident.ongoing?'Ongoing since ':'Observed from ')+new Date(incident.startedAt).toLocaleString()+(incident.endedAt?' to '+new Date(incident.endedAt).toLocaleString():'')+' · '+formatDuration(incident.durationMinutes);
        card.append(title,detail);incidentList.appendChild(card);
      });
      if(!(incidentData.recentIncidents||[]).length)incidentList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No observed incidents yet.</p>';

      latestPolicy=data.policy||null;
      latestComponents=data.components||[];
      publicStatusEnabled.checked=Boolean(latestPolicy?.publicStatusEnabled);
      const componentById=new Map(latestComponents.map((component)=>[component.id,component]));
      policyBody.innerHTML='';
      (latestPolicy?.rules||[]).forEach((rule)=>{
        const component=componentById.get(rule.id)||{name:rule.id,kind:''};
        const tr=document.createElement('tr');tr.className='border-b border-[var(--koa-line)] align-top';tr.dataset.policyId=rule.id;
        const service=document.createElement('td');service.className='py-4 pr-4';service.innerHTML='<strong class="block text-[var(--koa-forest)]"></strong><span class="mt-1 block text-xs uppercase tracking-[.06em] text-[var(--koa-ink)]/42"></span>';service.querySelector('strong').textContent=component.name;service.querySelector('span').textContent=component.kind||'';

        const timingTd=document.createElement('td');timingTd.className='py-4 pr-4';
        const timing=document.createElement('select');timing.dataset.alertAfter='';timing.className='rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold';timing.innerHTML='<option value="1">Immediately</option><option value="2">After 2 hourly failures</option>';timing.value=String(rule.alertAfter||2);timingTd.appendChild(timing);

        const publicTd=document.createElement('td');publicTd.className='py-4 pr-4';
        const visible=document.createElement('input');visible.type='checkbox';visible.dataset.publicVisible='';visible.checked=Boolean(rule.publicVisible);visible.className='h-4 w-4';publicTd.appendChild(visible);

        const labelTd=document.createElement('td');labelTd.className='py-4';
        const label=document.createElement('input');label.type='text';label.dataset.publicName='';label.value=rule.publicName||component.name;label.maxLength=120;label.className='w-full rounded-lg border border-[var(--koa-line)] px-3 py-2 text-sm';labelTd.appendChild(label);

        tr.append(service,timingTd,publicTd,labelTd);policyBody.appendChild(tr);
      });
    }

    creditRecommendations?.addEventListener('click',async(event)=>{
      const button=event.target?.closest?.('[data-credit-saver-action]');
      if(!button)return;
      const actionId=String(button.dataset.creditSaverAction||'');
      const enabled=button.dataset.creditSaverEnabled==='true';
      button.disabled=true;
      const original=button.textContent;
      button.textContent=enabled?'Applying…':'Restoring…';
      try{
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'set-credit-saver',actionId,enabled}),
        });
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to update credit-saver setting.');
        await load();
      }catch(error){
        button.textContent=error instanceof Error?error.message:original;
        button.disabled=false;
      }
    });

    creditSaverClear?.addEventListener('click',async()=>{
      creditSaverClear.disabled=true;
      const original=creditSaverClear.textContent;
      creditSaverClear.textContent='Restoring…';
      try{
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'clear-credit-saver'}),
        });
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to restore normal settings.');
        await load();
      }catch(error){
        creditSaverClear.textContent=error instanceof Error?error.message:original;
      }finally{
        creditSaverClear.disabled=false;
      }
    });

    async function load(){
      const response=await fetch('/api/admin/health',{cache:'no-store'});
      if(response.status===401||response.status===403){app?.classList.add('hidden');unauthorized?.classList.remove('hidden');return;}
      if(!response.ok) throw new Error('Unable to load System Health.');
      render(await response.json());
    }

    refresh?.addEventListener('click',async()=>{
      refresh.disabled=true;refresh.textContent='Checking…';
      try{
        const response=await fetch('/api/admin/health',{method:'POST'});
        if(!response.ok) throw new Error('Health check failed.');
        const data=await response.json();
        const latest=await fetch('/api/admin/health',{cache:'no-store'});
        render(await latest.json());
      }catch(error){
        overall.textContent='Check failed';overall.className='display mt-3 text-4xl text-red-800';
      }finally{
        refresh.disabled=false;refresh.textContent='Run checks now';
      }
    });

    document.querySelector('[data-close-release]')?.addEventListener('click',()=>releaseDialog.close());
    document.querySelector('[data-close-compare]')?.addEventListener('click',()=>compareDialog.close());
    releaseSearch?.addEventListener('input',renderReleaseTimeline);
    releaseFilter?.addEventListener('change',renderReleaseTimeline);
    document.querySelector('[data-release-clear]')?.addEventListener('click',()=>{
      releaseSearch.value='';
      releaseFilter.value='all';
      renderReleaseTimeline();
    });
    document.querySelector('[data-compare-releases]')?.addEventListener('click',async()=>{
      const baseCommit=String(compareBase.value||'');
      const headCommit=String(compareHead.value||'');
      if(!baseCommit||!headCommit){compareMessage.textContent='Choose two releases to compare.';return;}
      if(baseCommit===headCommit){compareMessage.textContent='Choose two different releases.';return;}
      compareMessage.textContent='Comparing releases…';
      try{
        const response=await fetch('/api/admin/health',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'compare-releases',baseCommit,headCommit})});
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to compare releases.');
        compareMessage.textContent='';
        showComparison(data.comparison);
      }catch(error){compareMessage.textContent=error instanceof Error?error.message:'Unable to compare releases.';}
    });

    saveOffice365Thresholds?.addEventListener('click',async()=>{
      saveOffice365Thresholds.disabled=true;office365ThresholdMessage.textContent='Saving…';
      try{
        const yellowBelow=Number(office365YellowThreshold.value);
        const redBelow=Number(office365RedThreshold.value);
        if(!Number.isFinite(yellowBelow)||!Number.isFinite(redBelow)||yellowBelow<0||yellowBelow>100||redBelow<0||redBelow>100)throw new Error('Thresholds must be between 0 and 100.');
        if(redBelow>=yellowBelow)throw new Error('Red threshold must be lower than yellow.');
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'save-office365-thresholds',yellowBelow,redBelow}),
        });
        const result=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(result.error||'Unable to save thresholds.');
        office365ThresholdMessage.textContent='Office 365 reliability thresholds saved.';
        await load();
      }catch(error){office365ThresholdMessage.textContent=error instanceof Error?error.message:'Unable to save thresholds.';}
      finally{saveOffice365Thresholds.disabled=false;}
    });

    savePolicy?.addEventListener('click',async()=>{
      savePolicy.disabled=true;policyMessage.textContent='Saving…';
      try{
        const rules=[...policyBody.querySelectorAll('tr[data-policy-id]')].map((tr)=>({
          id:tr.dataset.policyId,
          alertAfter:Number(tr.querySelector('[data-alert-after]')?.value)===1?1:2,
          publicVisible:Boolean(tr.querySelector('[data-public-visible]')?.checked),
          publicName:String(tr.querySelector('[data-public-name]')?.value||'').trim(),
        }));
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'save-policy',policy:{publicStatusEnabled:Boolean(publicStatusEnabled?.checked),rules}}),
        });
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to save alert policy.');
        policyMessage.textContent='Alert policy saved.';
        await load();
      }catch(error){
        policyMessage.textContent=error instanceof Error?error.message:'Unable to save alert policy.';
      }finally{
        savePolicy.disabled=false;
      }
    });

    const session=await getAdminSession();
    const ok=Boolean(session?.isAdmin);
    app?.classList.toggle('hidden',!ok);
    unauthorized?.classList.toggle('hidden',ok);
    if(ok) await load();
  </script>
</BaseLayout>
