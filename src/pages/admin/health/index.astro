        const redInputs=[...(credentialReliabilityGrid?.querySelectorAll('[data-credential-threshold-red]')||[])];
        const redById=new Map(redInputs.map((input)=>[String(input.dataset.credentialThresholdRed||''),input]));
        yellowInputs.forEach((input)=>{
          const id=String(input.dataset.credentialThresholdYellow||'');
          const redInput=redById.get(id);
          const yellowBelow=Number(input.value);
          const redBelow=Number(redInput?.value);
          if(!id||!Number.isFinite(yellowBelow)||!Number.isFinite(redBelow)||yellowBelow<0||yellowBelow>100||redBelow<0||redBelow>100){
            throw new Error('Every provider threshold must be between 0 and 100.');
          }
          if(redBelow>=yellowBelow)throw new Error('Red threshold must be lower than yellow for '+id+'.');
          providers[id]={yellowBelow,redBelow};
        });
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'save-credential-reliability-thresholds',providers}),
