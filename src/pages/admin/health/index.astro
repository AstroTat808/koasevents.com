            creditLearningActive.textContent='Latest clean window completed. Predicted '+String(active.predictedSavingsPerDay??0)+' credits/day; realized '+String(active.realizedSavingsPerDay??0)+' credits/day; accuracy '+String(active.accuracyPercent??'—')+'%.';
          }else{
