---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Admin Health" description="System health, monitoring, and deployment history for Koa’s protected workspaces." canonical="https://koasevents.com/admin/health/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-7xl">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Reliability</p>
          <h1 class="display mt-3 text-5xl">System health</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Hourly monitoring, transition-only alerts, protected page/API status, and deployment QA history in one place.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button data-refresh type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Run checks now</button>
          
        </div>
      </div>

      <div data-unauthorized class="mt-8 hidden rounded-[1.4rem] bg-white p-7 shadow-[var(--shadow-soft)]">This health dashboard requires an administrator account.</div>

      <div data-app class="mt-8 hidden grid gap-6">
        <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <button data-overall-card type="button" class="rounded-[1.3rem] bg-white p-5 text-left shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[var(--koa-clay)] disabled:cursor-default disabled:hover:translate-y-0" aria-label="Show failed health checks">
            <p class="eyebrow text-[var(--koa-clay)]">Overall</p>
            <p data-overall class="display mt-3 text-4xl text-[var(--koa-forest)]">—</p>
            <div data-severity-summary class="mt-3 hidden flex-wrap gap-2 text-[.56rem] font-black uppercase tracking-[.08em]">
              <span data-critical-count class="rounded-full bg-red-100 px-2.5 py-1 text-red-800"></span>
              <span data-warning-count class="rounded-full bg-amber-100 px-2.5 py-1 text-amber-800"></span>
              <span data-info-count class="rounded-full bg-sky-100 px-2.5 py-1 text-sky-800"></span>
            </div>
            <p data-overall-hint class="mt-2 hidden text-[.62rem] font-black uppercase tracking-[.08em] text-red-700">View issues ↓</p>
          </button>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Passed</p><p data-passed class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <button data-failed-card type="button" class="rounded-[1.3rem] bg-white p-5 text-left shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-red-700 disabled:cursor-default disabled:hover:translate-y-0" aria-label="Show failed health checks">
            <p class="eyebrow text-[var(--koa-clay)]">Failed</p>
            <p data-failed class="display mt-3 text-4xl text-red-800">0</p>
            <p data-failed-hint class="mt-2 hidden text-[.62rem] font-black uppercase tracking-[.08em] text-red-700">View failed checks ↓</p>
          </button>
          <article class="rounded-[1.3rem] bg-[var(--koa-ink)] p-5 text-white shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-amber-light)]">Last checked</p><p data-checked class="mt-3 text-sm font-semibold">—</p></article>
        </section>

        <section data-root-cause-summary class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Root cause summary</p>
              <p class="mt-2 text-sm text-[var(--koa-ink)]/55">Click a category to show only checks with that classification.</p>
            </div>
            <button data-root-cause-clear type="button" class="hidden rounded-full border border-[var(--koa-line)] px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Clear filter</button>
          </div>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
            <button data-root-cause-filter="Service Failure" type="button" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)] disabled:cursor-default disabled:opacity-45">
              <span class="block text-[.54rem] font-black uppercase tracking-[.08em]">Service Failure</span>
              <strong data-root-cause-count class="display mt-2 block text-3xl">0</strong>
            </button>
            <button data-root-cause-filter="Authentication Expected" type="button" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)] disabled:cursor-default disabled:opacity-45">
              <span class="block text-[.54rem] font-black uppercase tracking-[.08em]">Authentication Expected</span>
              <strong data-root-cause-count class="display mt-2 block text-3xl">0</strong>
            </button>
            <button data-root-cause-filter="Configuration Problem" type="button" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)] disabled:cursor-default disabled:opacity-45">
              <span class="block text-[.54rem] font-black uppercase tracking-[.08em]">Configuration Problem</span>
              <strong data-root-cause-count class="display mt-2 block text-3xl">0</strong>
            </button>
            <button data-root-cause-filter="Permission Problem" type="button" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)] disabled:cursor-default disabled:opacity-45">
              <span class="block text-[.54rem] font-black uppercase tracking-[.08em]">Permission Problem</span>
              <strong data-root-cause-count class="display mt-2 block text-3xl">0</strong>
            </button>
            <button data-root-cause-filter="Deployment Problem" type="button" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)] disabled:cursor-default disabled:opacity-45">
              <span class="block text-[.54rem] font-black uppercase tracking-[.08em]">Deployment Problem</span>
              <strong data-root-cause-count class="display mt-2 block text-3xl">0</strong>
            </button>
            <button data-root-cause-filter="External Dependency Problem" type="button" class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)] disabled:cursor-default disabled:opacity-45">
              <span class="block text-[.54rem] font-black uppercase tracking-[.08em]">External Dependency Problem</span>
              <strong data-root-cause-count class="display mt-2 block text-3xl">0</strong>
            </button>
          </div>
        </section>

        <section data-needs-action class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Action queue</p>
              <h2 class="display mt-2 text-4xl">Needs my action</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Combines configuration problems, permission problems, and failed credential checks into one prioritized troubleshooting queue.</p>
            </div>
            <span data-needs-action-count class="w-fit rounded-full bg-slate-100 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-slate-700">0 items</span>
          </div>
          <div data-needs-action-list class="mt-5 grid gap-3 lg:grid-cols-2"></div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Email delivery + rendering</p>
              <h2 class="display mt-2 text-4xl">Email Health</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Automatic checks for the production logo, Resend delivery problems, complaints and bounces, webhook coverage, and the email template compatibility gate.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span data-email-health-overall class="rounded-full bg-slate-100 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-slate-700">Checking</span>
              <a href="/admin/email-preview/" class="w-fit rounded-full border border-[var(--koa-line)] px-4 py-3 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Open Email Preview</a>
            </div>
          </div>

          <div data-email-health-release-alert class="mt-5 hidden rounded-[1.2rem] border p-5">
            <p class="text-[.56rem] font-black uppercase tracking-[.09em]">Production email release</p>
            <h3 data-email-health-release-title class="mt-1 text-lg font-semibold">—</h3>
            <p data-email-health-release-detail class="mt-1 text-xs leading-5"></p>
            <div data-email-health-release-actions class="mt-4 flex flex-wrap gap-2"></div>
          </div>

          <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-7">
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Logo availability</p>
              <p data-email-health-logo class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
              <p data-email-health-logo-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Can send email</p>
              <p data-email-health-send class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
              <p data-email-health-send-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Can read delivery health</p>
              <p data-email-health-monitoring class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
              <p data-email-health-monitoring-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Delivery source</p>
              <p data-email-health-source class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
              <p data-email-health-source-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Template compatibility</p>
              <p data-email-health-templates class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
              <p data-email-health-template-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Production email release</p>
              <p data-email-health-release class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
              <p data-email-health-release-meta class="mt-1 break-all text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
            </article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Last checked</p>
              <p data-email-health-checked class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
            </article>
          </div>

          <article class="mt-5 rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Production email renderer</p>
                <h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Live deployment identity</h3>
                <p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/50">Shows the exact production commit serving email code compared with GitHub main.</p>
              </div>
              <span data-email-renderer-match class="w-fit rounded-full bg-slate-100 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-slate-700">Checking</span>
            </div>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
              <div class="rounded-xl bg-white p-4">
                <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Live commit</p>
                <a data-email-renderer-live href="#" target="_blank" rel="noreferrer" class="mt-2 block break-all text-sm font-semibold text-[var(--koa-forest)] underline decoration-[var(--koa-line)] underline-offset-4">—</a>
              </div>
              <div class="rounded-xl bg-white p-4">
                <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">GitHub main</p>
                <a data-email-renderer-main href="#" target="_blank" rel="noreferrer" class="mt-2 block break-all text-sm font-semibold text-[var(--koa-forest)] underline decoration-[var(--koa-line)] underline-offset-4">—</a>
              </div>
              <div class="rounded-xl bg-white p-4">
                <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Netlify deploy ID</p>
                <a data-email-renderer-deploy href="#" target="_blank" rel="noreferrer" class="mt-2 block break-all text-sm font-semibold text-[var(--koa-forest)] underline decoration-[var(--koa-line)] underline-offset-4">—</a>
              </div>
              <div class="rounded-xl bg-white p-4">
                <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Status</p>
                <p data-email-renderer-status class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
                <p data-email-renderer-status-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
              </div>
            </div>
          </article>

          <div class="mt-5 grid gap-4 lg:grid-cols-2">
            <article class="rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
              <div class="flex items-center justify-between gap-3">
                <div><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Last 24 hours</p><h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Delivery lifecycle</h3></div>
                <span data-email-health-24-total class="text-xs font-semibold text-[var(--koa-ink)]/45">—</span>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5">
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Delivered</p><p data-email-health-24-delivered class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">0</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Bounced</p><p data-email-health-24-bounced class="mt-1 text-xl font-semibold text-red-800">0</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Complaints</p><p data-email-health-24-complained class="mt-1 text-xl font-semibold text-red-800">0</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Failed</p><p data-email-health-24-failed class="mt-1 text-xl font-semibold text-red-800">0</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Delayed</p><p data-email-health-24-delayed class="mt-1 text-xl font-semibold text-amber-800">0</p></div>
              </div>
            </article>

            <article class="rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
              <div class="flex items-center justify-between gap-3">
                <div><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Rolling 7 days</p><h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Delivery problem rate</h3></div>
                <span data-email-health-7-total class="text-xs font-semibold text-[var(--koa-ink)]/45">—</span>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Failure rate</p><p data-email-health-7-rate class="mt-1 text-xl font-semibold text-[var(--koa-forest)]">—</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Bounced</p><p data-email-health-7-bounced class="mt-1 text-xl font-semibold text-red-800">0</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Complaints</p><p data-email-health-7-complained class="mt-1 text-xl font-semibold text-red-800">0</p></div>
                <div><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Suppressed</p><p data-email-health-7-suppressed class="mt-1 text-xl font-semibold text-red-800">0</p></div>
              </div>
            </article>
          </div>

          <div class="mt-5 rounded-[1.2rem] border border-[var(--koa-line)] bg-white p-5">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Recent delivery issues</p>
                <h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Bounces, complaints, failures, suppression + delays</h3>
              </div>
            </div>
            <div data-email-health-issues class="mt-4 grid gap-2"></div>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Authentication + permissions</p>
              <h2 class="display mt-2 text-4xl">Credential Health</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Validates credentials and access scopes independently from service uptime. A credential warning does not automatically mean the underlying service is down.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span data-credential-health-overall class="rounded-full bg-slate-100 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-slate-700">Checking</span>
              <span data-credential-health-checked class="text-xs text-[var(--koa-ink)]/45">—</span>
            </div>
          </div>
          <div data-credential-health-grid class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-3"></div>
          <div class="mt-5 rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
            <div>
              <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Credential change history</p>
              <h3 class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Invalid, changed, and recovered credentials</h3>
              <p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/50">Records when a credential problem starts, changes classification, recovers, and how long the problem lasted.</p>
            </div>
            <div data-credential-health-history class="mt-4 grid gap-2"></div>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Microsoft 365 integration</p>
              <h2 class="display mt-2 text-4xl">Office 365 calendar sync</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Production synchronization health for the shared Koa’s Events calendar.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span data-office365-severity class="rounded-full bg-slate-100 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-slate-700">Reliability —</span>
              <a href="/admin/calendar/" class="w-fit rounded-full border border-[var(--koa-line)] px-4 py-3 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Open Master Calendar</a>
            </div>
          </div>
          <div data-office365-operational class="mt-5 rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
              <div>
                <p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Operational state</p>
                <h3 data-office365-operational-title class="mt-1 text-lg font-semibold text-[var(--koa-forest)]">Checking Office 365 sync…</h3>
                <p data-office365-operational-detail class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/52"></p>
              </div>
              <span data-office365-operational-badge class="w-fit rounded-full bg-slate-100 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-slate-700">Checking</span>
            </div>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
              <article data-office365-signal-schedule class="rounded-xl bg-white p-4">
                <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Scheduled function</p>
                <p data-office365-schedule class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
                <p data-office365-schedule-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
              </article>
              <article data-office365-signal-pause class="rounded-xl bg-white p-4">
                <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Credit saver</p>
                <p data-office365-pause class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p>
                <p data-office365-pause-detail class="mt-1 text-[.68rem] leading-5 text-[var(--koa-ink)]/45"></p>
              </article>
              <article data-office365-signal-auth class="rounded-xl bg-white p-4">
                <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Microsoft Graph</p>
