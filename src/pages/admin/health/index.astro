          creditLearningHistory.appendChild(item);
        });
      }

      if(creditJobControls){
        creditJobControls.innerHTML='';
        const controls=Array.isArray(creditUsage.jobControls)?creditUsage.jobControls:[];
        controls.forEach((item)=>{
          const row=document.createElement('article');
          row.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-3';
