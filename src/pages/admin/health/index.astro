    function ensureHealthWarningTools(){
      if(!(app instanceof HTMLElement))return null;
      let tools=app.querySelector('[data-health-warning-tools]');
      if(tools instanceof HTMLElement)return tools;
      tools=document.createElement('div');
      tools.dataset.healthWarningTools='';
      tools.dataset.mobileOrder='2';
      tools.className='health-warning-tools hidden';

      const counts=document.createElement('div');
      counts.dataset.healthToolbarCounts='';
      counts.className='health-toolbar-counts';
