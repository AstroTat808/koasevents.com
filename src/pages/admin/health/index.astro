        );
        renderOffice365Trend(office365.reliabilityTrend||[]);
      }

      markDashboardRenderPanel('Credit Usage');
      const deployments=data.deployments||{};
      const creditUsage=deployments.creditUsage||{};
      if(creditCycle){
        const start=creditUsage.cycleStart?new Date(creditUsage.cycleStart).toLocaleDateString():'—';
        const end=creditUsage.cycleEnd?new Date(creditUsage.cycleEnd).toLocaleDateString():'—';
        creditCycle.textContent='Cycle '+start+' – '+end;
      }
      if(creditTotal)creditTotal.textContent=creditUsage.totalEstimatedCredits==null?'—':String(creditUsage.totalEstimatedCredits);
      if(creditRemaining)creditRemaining.textContent=creditUsage.estimatedRemainingCredits==null?'—':String(creditUsage.estimatedRemainingCredits);
      if(creditAllowance)creditAllowance.textContent=creditUsage.monthlyAllowance==null?'—':String(creditUsage.monthlyAllowance);
      if(creditProjected)creditProjected.textContent=creditUsage.projection?.projectedEndOfCycleCredits==null?'—':String(creditUsage.projection.projectedEndOfCycleCredits);
      if(creditProjectedMeta){
