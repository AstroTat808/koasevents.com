    function weeklyPercent(value){
      return value==null?'—':Number(value).toFixed(2)+'%';
    }

    function weeklyDelta(value,unit='pp'){
      if(value==null)return 'No prior-week comparison yet';
      const number=Number(value);
      const sign=number>0?'+':'';
      return sign+number.toFixed(unit==='pp'?2:0)+' '+unit+' vs prior week';
    }

    function renderWeeklyExecutiveSummary(summary){
      const data=summary||{};
      const uptime=data.uptime||{};
      const credential=data.credentialReliability||{};
      const incidents=data.incidents||{};
      const repairs=data.automaticRepairs||{};
      const unresolved=data.unresolved||{};
      if(weeklySummaryBasis)weeklySummaryBasis.textContent=String(data.basis||'Rolling 7 days compared with the immediately preceding 7 days.');
      if(weeklySummaryGenerated)weeklySummaryGenerated.textContent=data.generatedAt?'Updated '+new Date(data.generatedAt).toLocaleString():'—';
      if(weeklyUptime)weeklyUptime.textContent=weeklyPercent(uptime?.current?.percentage);
      if(weeklyUptimeDelta)weeklyUptimeDelta.textContent=weeklyDelta(uptime?.deltaPercentagePoints,'pp');
      if(weeklyCredentialReliability)weeklyCredentialReliability.textContent=weeklyPercent(credential?.currentAverage);
      if(weeklyCredentialDelta)weeklyCredentialDelta.textContent=weeklyDelta(credential?.deltaPercentagePoints,'pp');
      if(weeklyIncidents)weeklyIncidents.textContent=String(incidents?.current?.incidentCount||0);
      if(weeklyIncidentsDelta){
        const delta=Number(incidents?.incidentDelta||0);
        const downtime=Number(incidents?.current?.downtimeMinutes||0);
        weeklyIncidentsDelta.textContent=(delta===0?'No change':(delta>0?'+':'')+delta+' vs prior week')+' · '+formatDuration(downtime)+' downtime';
      }
      if(weeklyRepairs)weeklyRepairs.textContent=String(repairs?.current?.fixed||0);
      if(weeklyRepairsDetail){
        weeklyRepairsDetail.textContent=Number(repairs?.current?.runs||0)+' repair run'+(Number(repairs?.current?.runs||0)===1?'':'s')+' · '+Number(repairs?.current?.attempted||0)+' credential re-test'+(Number(repairs?.current?.attempted||0)===1?'':'s');
      }
      if(weeklyUnresolved)weeklyUnresolved.textContent=String(unresolved?.count||0);
      if(weeklyUnresolvedDetail)weeklyUnresolvedDetail.textContent=Number(unresolved?.critical||0)+' critical · '+Number(unresolved?.attention||0)+' attention';

      const renderComparisonList=(target,rows,empty)=>{
        if(!target)return;
        target.innerHTML='';
        (Array.isArray(rows)?rows:[]).slice(0,10).forEach((row)=>{
          const item=document.createElement('div');
          item.className='rounded-lg bg-white/75 p-3';
          const title=document.createElement('strong');
          title.className='block text-xs text-[var(--koa-forest)]';
          title.textContent=String(row.metric||'Metric');
          const detail=document.createElement('p');
          detail.className='mt-1 text-[.65rem] leading-4 text-[var(--koa-ink)]/52';
          const unit=String(row.unit||'');
          const current=Number(row.current);
          const previous=Number(row.previous);
          if(unit==='%'){
            const delta=Number(row.delta||0);
            detail.textContent=current.toFixed(1)+'% now · '+previous.toFixed(1)+'% prior · '+(delta>0?'+':'')+delta.toFixed(1)+' pp';
          }else if(unit===' incidents'){
            const delta=Number(row.delta||0);
            detail.textContent=current+' now · '+previous+' prior · '+(delta>0?'+':'')+delta+' incidents';
          }else if(unit===' minutes'){
            const delta=Number(row.delta||0);
            detail.textContent=formatDuration(current)+' now · '+formatDuration(previous)+' prior · '+(delta>0?'+':'')+delta+' min';
          }else{
            detail.textContent=String(current)+' now · '+String(previous)+' prior';
          }
          item.append(title,detail);
          target.appendChild(item);
        });
        if(!(Array.isArray(rows)&&rows.length)){
          target.innerHTML='<p class="text-xs leading-5 text-[var(--koa-ink)]/50">'+empty+'</p>';
        }
      };
      renderComparisonList(weeklyImproved,data.improved||[],'No measurable improvement is available yet for the observed comparison window.');
      renderComparisonList(weeklyWorsened,data.worsened||[],'No measured regression versus the prior 7-day period.');

      if(weeklyProviderReliability){
        weeklyProviderReliability.innerHTML='';
        const providers=Array.isArray(credential?.providers)?credential.providers:[];
        providers.forEach((provider)=>{
          const row=document.createElement('div');
          row.className='flex items-center justify-between gap-3 rounded-lg bg-white p-3';
          const left=document.createElement('div');
          const title=document.createElement('strong');
          title.className='block text-xs text-[var(--koa-forest)]';
          title.textContent=String(provider.label||provider.id||'Provider');
          const detail=document.createElement('p');
          detail.className='mt-1 text-[.62rem] text-[var(--koa-ink)]/45';
          const previous=provider.previousPercentage==null?'—':Number(provider.previousPercentage).toFixed(1)+'%';
          detail.textContent='Prior '+previous+' · '+Number(provider.samples||0)+' observed hourly samples';
          left.append(title,detail);
          const value=document.createElement('strong');
          value.className='text-sm '+(
            provider.trend==='worsened'?'text-red-800':
            provider.trend==='improved'?'text-emerald-800':'text-[var(--koa-forest)]'
          );
          value.textContent=provider.percentage==null?'—':Number(provider.percentage).toFixed(1)+'%';
          row.append(left,value);
          weeklyProviderReliability.appendChild(row);
        });
        if(!providers.length)weeklyProviderReliability.innerHTML='<p class="text-xs text-[var(--koa-ink)]/45">Credential reliability history is still building.</p>';
      }

      if(weeklyUnresolvedList){
        weeklyUnresolvedList.innerHTML='';
        const rows=Array.isArray(unresolved?.rows)?unresolved.rows:[];
        rows.slice(0,12).forEach((problem)=>{
          const item=document.createElement('div');
          item.className='rounded-lg border p-3 '+(problem.severity==='red'?'border-red-200 bg-red-50':'border-amber-200 bg-amber-50');
          const title=document.createElement('strong');
          title.className='block text-xs text-[var(--koa-forest)]';
          title.textContent=String(problem.name||problem.id||'Health problem');
          const detail=document.createElement('p');
          detail.className='mt-1 text-[.62rem] leading-4 text-[var(--koa-ink)]/50';
          detail.textContent=String(problem.issueType||'Problem')+' · '+String(problem.source||'system');
          item.append(title,detail);
          weeklyUnresolvedList.appendChild(item);
        });
        if(!rows.length)weeklyUnresolvedList.innerHTML='<p class="text-xs text-emerald-800">No unresolved System Health or Credential Health problems.</p>';
      }

      if(weeklySummaryCoverage){
        const coverage=data.coverage||{};
        weeklySummaryCoverage.textContent='Coverage: '+Number(coverage.systemHourlyCurrent||0)+' / '+Number(coverage.expectedHoursPerPeriod||168)+' hourly System Health samples this week · '+Number(coverage.systemHourlyPrevious||0)+' prior week · '+String(coverage.note||'');
      }
    }

