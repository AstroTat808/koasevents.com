        if(creditSaverClear)creditSaverClear.classList.toggle('hidden',activeModes.length===0);

        const recommendations=Array.isArray(creditUsage.recommendations)?creditUsage.recommendations:[];
        recommendations.sort((a,b)=>Number(a.priority||99)-Number(b.priority||99)).forEach((item,index)=>{
