      const columns=document.createElement('div');
      columns.className='mt-4 grid gap-3 lg:grid-cols-2 xl:grid-cols-4';
      const sections=[
        {
          label:'Before',
          rows:[...(report?.before?.failedCredentials||[]),...(report?.before?.systemIssues||[])],
          empty:'No problems were present before the run.',
        },
        {
          label:'Re-tested',
          rows:report?.retested||[],
          empty:'No failed credentials needed re-testing.',
          retested:true,
        },
        {
          label:'Fixed automatically',
          rows:report?.fixedItems||[],
          empty:'No problem cleared automatically on this run.',
