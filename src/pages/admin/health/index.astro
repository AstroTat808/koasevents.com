        const summary=document.createElement('p');
        summary.className='mt-2';
        summary.textContent='Current adjusted projection: '+String(plan.currentProjectedEndOfCycle??'—')+' credits · projected after plan: '+String(plan.projectedAfterPlan??'—')+' · remaining shortfall: '+String(plan.estimatedShortfallAfterPlan??0)+'.';
