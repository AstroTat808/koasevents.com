      }
      if(creditComponents){
        creditComponents.innerHTML='';
        (creditUsage.components||[]).forEach((item)=>{
          const card=document.createElement('article');
          card.className='rounded-xl bg-white p-4';
          const label=document.createElement('p');
          label.className='text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]';
          label.textContent=item.label||item.id||'Usage';
          const value=document.createElement('p');
          value.className='display mt-2 text-2xl text-[var(--koa-forest)]';
