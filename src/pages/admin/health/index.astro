    function closeAccountingRepairDialog(){
      accountingRepairPreview=null;
      if(accountingRepairMessage)accountingRepairMessage.textContent='';
      accountingRepairDialog?.close();
    }

    async function previewAccountingRepair(row){
      if(!row?.recordId)return;
      if(accountingRepairMessage)accountingRepairMessage.textContent='Loading a fresh live QuickBooks preview…';
      if(accountingRepairBody)accountingRepairBody.innerHTML='';
      accountingRepairApprove?.setAttribute('disabled','');
      accountingRepairDialog?.showModal();
      try{
        const response=await fetch('/api/admin/quickbooks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'preview-accounting-repair',recordId:String(row.recordId)})});
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data?.error||'Unable to preview this repair.');
        accountingRepairPreview=data?.preview||null;
        if(accountingRepairTitle)accountingRepairTitle.textContent='Repair preview · '+String(data?.preview?.clientName||row.client||row.recordId);
        if(accountingRepairMeta)accountingRepairMeta.textContent='Preview '+String(data?.preview?.previewId||'')+' · expires '+(data?.preview?.expiresAt?new Date(data.preview.expiresAt).toLocaleString():'soon')+' · no changes have been made.';
        if(accountingRepairBody){
          const changes=Array.isArray(data?.preview?.changes)?data.preview.changes:[];
          const blocked=Array.isArray(data?.preview?.blockedIssues)?data.preview.blockedIssues:[];
          if(!changes.length&&!blocked.length)accountingRepairBody.innerHTML='<p class="rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900">No repair changes are needed for the current live state.</p>';
          changes.forEach((change)=>{
            const card=document.createElement('article');card.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
            const before=change?.before||{},after=change?.after||{};
            card.innerHTML='<strong class="text-sm text-[var(--koa-forest)]">'+String(change?.target||change?.type||'QuickBooks change')+'</strong><p class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/60">Type: '+String(change?.type||'')+' · Before total: '+accountingMoney(before?.total)+' · After total: '+accountingMoney(after?.total)+'. '+String(after?.taxHandling||'')+'</p>';
            accountingRepairBody.appendChild(card);
          });
          blocked.forEach((issue)=>{
            const card=document.createElement('article');card.className='rounded-xl border border-amber-200 bg-amber-50 p-4';
            card.innerHTML='<strong class="text-sm text-amber-950">Protected / blocked</strong><p class="mt-2 text-xs leading-5 text-amber-900/75">'+String(issue?.label||issue?.code||'Issue')+' · '+String(issue?.protection||'This item is not eligible for an automatic write.')+'</p>';
            accountingRepairBody.appendChild(card);
          });
        }
        if(accountingRepairMessage)accountingRepairMessage.textContent=data?.preview?.canApply?'Review the exact before/after changes above. Approval is the second, separate step.':'This preview has no eligible automatic write.';
        if(data?.preview?.canApply)accountingRepairApprove?.removeAttribute('disabled');
      }catch(error){
        if(accountingRepairMessage)accountingRepairMessage.textContent=error instanceof Error?error.message:'Unable to preview this repair.';
      }
    }

    async function approveAccountingRepair(){
      const previewId=String(accountingRepairPreview?.previewId||'');
      if(!previewId)return;
      accountingRepairApprove?.setAttribute('disabled','');
      if(accountingRepairMessage)accountingRepairMessage.textContent='Rechecking the live fingerprint and applying only the approved preview…';
      try{
        const response=await fetch('/api/admin/quickbooks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'apply-accounting-repair',previewId,approved:true})});
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data?.error||'Unable to apply this repair.');
        if(accountingRepairMessage)accountingRepairMessage.textContent=data?.resolved?'Repair applied and reconciliation is clean.':'Repair applied; remaining accounting issues still require review.';
        setTimeout(()=>{closeAccountingRepairDialog();document.querySelector('[data-refresh]')?.click();},800);
      }catch(error){
        if(accountingRepairMessage)accountingRepairMessage.textContent=error instanceof Error?error.message:'Unable to apply this repair.';
        accountingRepairApprove?.removeAttribute('disabled');
      }
    }

