      return tools;
    }

    function formatHealthCheckAge(value){
      const checkedMs=Date.parse(String(value||''));
      if(!Number.isFinite(checkedMs))return '';
      const diff=Math.max(0,Date.now()-checkedMs);
      const seconds=Math.floor(diff/1000);
      if(seconds<45)return 'just now';
      const minutes=Math.floor(seconds/60);
      if(minutes<60)return minutes+' minute'+(minutes===1?'':'s')+' ago';
      const hours=Math.floor(minutes/60);
      if(hours<24)return hours+' hour'+(hours===1?'':'s')+' ago';
      const days=Math.floor(hours/24);
      return days+' day'+(days===1?'':'s')+' ago';
    }

    function formatHealthDuration(value){
      const ms=Number(value);
      if(!Number.isFinite(ms)||ms<0)return 'Available after next check';
      if(ms<1000)return Math.round(ms)+' ms';
      if(ms<60000)return (Math.round(ms/100)/10)+' s';
      const minutes=Math.floor(ms/60000);
      const seconds=Math.round((ms%60000)/1000);
      return minutes+'m '+seconds+'s';
    }

    function healthVerificationSource(snapshot){
      const checks=Array.isArray(snapshot?.checks)?snapshot.checks:[];
      const deploymentCheck=checks.find((row)=>String(row?.id||'')==='netlify-github-sync');
      const details=deploymentCheck?.deploymentDetails||{};
      const key=String(details?.verificationSourceKey||'');
      const label=String(details?.verificationSourceLabel||details?.verificationSource||'').trim();
      if(label)return label;
      if(key==='github-netlify')return 'GitHub + Netlify';
      if(key==='netlify-fallback')return 'Netlify fallback';
      if(key==='netlify-runtime')return 'Netlify runtime';
      return 'Direct service verification';
    }

    function updateAllSystemsGoodTime(){
      const copy=document.querySelector('[data-health-all-good-copy]');
      if(copy instanceof HTMLElement){
        const age=formatHealthCheckAge(latestHealthyCheckAt);
        copy.textContent=age?'All systems good · checked '+age:'All systems good';
      }
      const snapshot=latestHealthSnapshot||{};
      const passed=document.querySelector('[data-health-all-good-passed]');
      const duration=document.querySelector('[data-health-all-good-duration]');
      const verified=document.querySelector('[data-health-all-good-verified]');
      const source=document.querySelector('[data-health-all-good-source]');
      const total=Number(snapshot?.passed||0)+Number(snapshot?.failed||0);
      if(passed instanceof HTMLElement){
        passed.textContent=total?Number(snapshot?.passed||0)+' / '+total+' checks':'—';
      }
      if(duration instanceof HTMLElement){
        duration.textContent=formatHealthDuration(snapshot?.durationMs);
      }
      if(verified instanceof HTMLElement){
        const checkedMs=Date.parse(String(snapshot?.checkedAt||''));
        verified.textContent=Number.isFinite(checkedMs)
          ? new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit',second:'2-digit'}).format(new Date(checkedMs))
          : '—';
      }
      if(source instanceof HTMLElement){
        source.textContent=healthVerificationSource(snapshot);
      }
    }

    function refreshMobileHealthPresentation(){
      if(!(app instanceof HTMLElement)||!healthSectionStatusesReady)return;
      const directSections=[...app.children].filter((node)=>
        node instanceof HTMLElement&&
        node.dataset.mobileCollapsible==='true'&&
        node.hasAttribute('data-mobile-order')
      );
      const severityRank={red:0,yellow:1,green:2};

      directSections.forEach((section)=>{
        if(!mobileHealthQuery.matches){
          section.style.removeProperty('order');
          return;
        }
        const severity=String(section.dataset.healthSectionStatus||'green');
        const baseOrder=Number(section.dataset.mobileOrder||99);
        section.style.order=String(10+(severityRank[severity]??3)*100+baseOrder);
      });

      const allSections=[...document.querySelectorAll('[data-mobile-collapsible]')]
        .filter((section)=>section instanceof HTMLElement);
      const allGreen=allSections.length>0&&allSections.every((section)=>section.dataset.healthSectionStatus==='green');
      const banner=ensureAllSystemsGoodBanner();
      if(banner instanceof HTMLElement){
        banner.classList.toggle('hidden',!mobileHealthQuery.matches||!allGreen);
        if(allGreen)updateAllSystemsGoodTime();
      }

      const criticalSections=allSections.filter((section)=>String(section.dataset.healthSectionStatus||'')==='red');
      const warningSections=allSections.filter((section)=>String(section.dataset.healthSectionStatus||'')==='yellow');
      const problemSections=[...criticalSections,...warningSections];
      const healthySections=allSections.filter((section)=>String(section.dataset.healthSectionStatus||'')==='green');
      const tools=ensureHealthWarningTools();
      if(tools instanceof HTMLElement){
        const counts=tools.querySelector('[data-health-toolbar-counts]');
        if(counts instanceof HTMLElement){
          counts.textContent=criticalSections.length+' critical · '+warningSections.length+' warning'+(warningSections.length===1?'':'s')+' · '+healthySections.length+' healthy';
        }
        const expand=tools.querySelector('[data-expand-health-warnings]');
        if(expand instanceof HTMLButtonElement){
          expand.textContent='Expand all warnings'+(problemSections.length?' · '+problemSections.length:'');
          expand.disabled=problemSections.length===0;
        }
        const collapseHealthy=tools.querySelector('[data-collapse-healthy]');
        if(collapseHealthy instanceof HTMLButtonElement){
          collapseHealthy.textContent='Collapse healthy'+(healthySections.length?' · '+healthySections.length:'');
          collapseHealthy.disabled=healthySections.length===0;
        }
        tools.classList.toggle('hidden',!mobileHealthQuery.matches);
      }
    }

    function jumpToHealthSection(selector){
      const target=document.querySelector(selector);
      if(!(target instanceof HTMLElement))return;
      if(target.matches('[data-mobile-collapsible]'))setMobileCollapsed(target,false);
      const collapsedParent=target.closest('[data-mobile-collapsible]');
      if(collapsedParent instanceof HTMLElement)setMobileCollapsed(collapsedParent,false);
      target.scrollIntoView({behavior:'smooth',block:'start'});
      target.classList.add('health-jump-highlight');
      window.setTimeout(()=>target.classList.remove('health-jump-highlight'),1300);
    }

    function makeHealthJumpCard(card,handler,label){
      if(!(card instanceof HTMLElement)||card.dataset.healthJumpReady==='true')return;
      card.dataset.healthJumpReady='true';
      card.classList.add('health-jump-card');
      if(!(card instanceof HTMLButtonElement)&&!(card instanceof HTMLAnchorElement)){
        card.setAttribute('role','button');
        card.tabIndex=0;
        card.setAttribute('aria-label',label);
        card.addEventListener('keydown',(event)=>{
          if(event.key==='Enter'||event.key===' '){
            event.preventDefault();
            handler();
          }
        });
      }
      card.addEventListener('click',handler);
    }

    function findDirectHealthSection(title){
      if(!(app instanceof HTMLElement))return null;
      return [...app.children].find((node)=>{
        if(!(node instanceof HTMLElement)||node.tagName!=='SECTION')return false;
        return String(node.querySelector('h2')?.textContent||'').trim()===title;
      })||null;
    }

    function configureMobileHealthSection(section,id,order,collapsible=false){
      if(!(section instanceof HTMLElement))return;
      if(id)section.id=id;
      section.dataset.mobileOrder=String(order);
      if(collapsible)prepareMobileCollapsible(section);
    }

    function initializeMobileHealthExperience(){
      if(!(app instanceof HTMLElement))return;
