    function needsActionPriority(item){
      let score=item.source==='credential'?0:20;
      if(item.issueType==='Permission Problem')score-=8;
      else if(item.issueType==='Configuration Problem')score-=5;
      else score+=8;
      if(item.severity==='red')score-=4;
      else if(item.severity==='yellow')score+=2;
      return score;
    }

    function renderNeedsMyAction(){
      if(!needsActionList||!needsActionCount)return;
      const systemRows=(Array.isArray(latestHealthChecks)?latestHealthChecks:[])
        .filter((row)=>!['email-send-access','email-monitoring-access'].includes(String(row?.id||'')))
        .filter((row)=>['Configuration Problem','Permission Problem'].includes(String(row?.issueType||''))&&normalizedSeverity(row)!=='healthy')
        .map((row)=>({
          source:'system',
          key:'system:'+String(row.id||row.name||'check'),
          title:String(row.name||'System Health check'),
          subtitle:'System Health',
          issueType:String(row.issueType||''),
          severity:row.severity==='red'?'red':'yellow',
