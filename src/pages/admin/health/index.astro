      collapseAll.addEventListener('click',()=>{
        const sections=[...document.querySelectorAll('[data-mobile-collapsible]')]
          .filter((section)=>section instanceof HTMLElement);
        sections.forEach((section)=>{
          const severity=String(section.dataset.healthSectionStatus||'green');
          if(severity==='red')setMobileCollapsed(section,false);
