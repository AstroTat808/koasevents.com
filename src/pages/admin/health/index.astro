          const caution=document.createElement('p');
          caution.className='mt-3 text-[.64rem] leading-5 text-[var(--koa-ink)]/45';
          caution.textContent=String(preset.caution||'');
          const button=document.createElement('button');
          button.type='button';
          button.dataset.creditPreset=String(preset.id||'');
          button.className='mt-3 rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-[.6rem] font-black uppercase tracking-[.07em] text-white';
          const isMaximum=String(preset.id||'')==='maximum-savings';
          const suggested=isMaximum&&Boolean(creditAutomationState.maximumSavingsSuggested);
          if(suggested){
            const badge=document.createElement('span');
            badge.className='mt-3 inline-flex rounded-full bg-red-100 px-2.5 py-1 text-[.55rem] font-black uppercase tracking-[.07em] text-red-800';
            badge.textContent='Suggested now · manual approval required';
