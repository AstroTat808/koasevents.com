      if(creditChart){
        creditChart.innerHTML='';
        const chart=creditUsage.chart||{};
        const actual=Array.isArray(chart.actual)?chart.actual:[];
        const projected=Array.isArray(chart.projected)?chart.projected:[];
        const allowance=Number(chart.allowance||creditUsage.monthlyAllowance||0);
        const all=[...actual,...projected].filter((row)=>Number.isFinite(Number(row?.credits))&&Number.isFinite(Date.parse(String(row?.at||''))));
        if(all.length){
          const width=800,height=220,padX=42,padY=18;
          const minX=Math.min(...all.map((row)=>Date.parse(String(row.at))));
          const maxX=Math.max(...all.map((row)=>Date.parse(String(row.at))));
          const maxCredit=Math.max(allowance||0,...all.map((row)=>Number(row.credits)||0),1);
          const x=(value)=>padX+((value-minX)/Math.max(1,maxX-minX))*(width-padX*2);
          const y=(value)=>height-padY-(value/maxCredit)*(height-padY*2);
          const ns='http://www.w3.org/2000/svg';
          const make=(tag,attrs={})=>{const el=document.createElementNS(ns,tag);Object.entries(attrs).forEach(([key,value])=>el.setAttribute(key,String(value)));return el;};

          [0,.25,.5,.75,1].forEach((fraction)=>{
            const value=maxCredit*fraction;
            const line=make('line',{x1:padX,y1:y(value),x2:width-padX,y2:y(value),stroke:'currentColor','stroke-opacity':'0.12','stroke-width':'1'});
            creditChart.appendChild(line);
            const label=make('text',{x:4,y:y(value)+4,fill:'currentColor','fill-opacity':'0.42','font-size':'10'});
            label.textContent=String(Math.round(value));
            creditChart.appendChild(label);
