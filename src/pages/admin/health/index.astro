    function renderAccountingInvariantTable(){
      if(!accountingInvariantTableBody)return;
      const release=accountingReleaseAudits.find((row)=>String(row.commit||'')===String(accountingReleaseSelect?.value||''))||accountingReleaseAudits[0]||null;
      const rows=Array.isArray(release?.rows)?release.rows:[];
      const status=String(accountingFilterStatus?.value||'all');
      const taxableOnly=Boolean(accountingFilterTaxable?.checked);
      const missingEstimateOnly=Boolean(accountingFilterMissingEstimate?.checked);
      accountingQueueCounts.forEach((node)=>{
        const category=String(node.dataset.accountingQueueCount||'');
        node.textContent=String(rows.filter((row)=>String(row?.repairCategory||'')===category).length);
      });
      const filtered=rows.filter((row)=>{
        if(status!=='all'&&String(row?.status||'unverified')!==status)return false;
        if(taxableOnly&&!(Number(row?.taxableLines||0)>0))return false;
        if(missingEstimateOnly&&row?.qboEstimate!=null&&String(row?.estimateId||''))return false;
        if(accountingQueueFilter!=='all'&&String(row?.repairCategory||'')!==accountingQueueFilter)return false;
        return true;
      });
      accountingInvariantTableBody.innerHTML='';
      for(const row of filtered){
        const tr=document.createElement('tr');
        tr.className='border-b border-[var(--koa-line)]/70 align-top';
        const statusValue=String(row?.status||'unverified');
        const statusClass=statusValue==='passed'?'text-emerald-800':statusValue==='failed'?'text-red-800':'text-amber-800';
        const category=String(row?.repairCategory||'');
        const cells=[
          String(row?.client||row?.recordId||'—'),
          accountingMoney(row?.crmTotal),
          row?.lineTotal==null?'—':accountingMoney(row.lineTotal),
          row?.lineTotal==null||row?.qboEstimate==null?'—':accountingMoney(Number(row.qboEstimate)-Number(row.lineTotal)),
          row?.qboEstimate==null?'—':accountingMoney(row.qboEstimate),
          row?.estimateDocNumber?'#'+String(row.estimateDocNumber):(row?.estimateId?String(row.estimateId):'—'),
          row?.taxableLines==null?'—':String(row.taxableLines),
          accountingQueueLabel(category),
          statusValue,
          String(row?.failureReason||''),
        ];
        cells.forEach((value,index)=>{
          const td=document.createElement('td');
          td.className='py-3 pr-4 '+(index===8?statusClass+' font-semibold':'text-[var(--koa-ink)]/70')+(index===9?' max-w-[360px] leading-5':'');
          td.textContent=value||'—';
          if(index===7&&['missing-estimate','taxable-lines','sales-line-mismatch','unverified'].includes(category)){
            td.classList.add('cursor-pointer','underline','underline-offset-2');
            td.title='Filter the repair queue to '+accountingQueueLabel(category);
            td.addEventListener('click',()=>{accountingQueueFilter=category;renderAccountingInvariantTable();});
          }
          tr.appendChild(td);
        });
        const actionTd=document.createElement('td');actionTd.className='py-3';
        const action=document.createElement('button');action.type='button';action.className='rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-[var(--koa-forest)]';
        if(statusValue==='passed'){action.textContent='Clean';action.disabled=true;action.classList.add('opacity-40');}
        else if(statusValue==='unverified'){action.textContent='Recheck';action.addEventListener('click',()=>document.querySelector('[data-refresh]')?.click());}
        else{action.textContent='Preview repair';action.addEventListener('click',()=>previewAccountingRepair(row));}
        actionTd.appendChild(action);tr.appendChild(actionTd);
        accountingInvariantTableBody.appendChild(tr);
      }
      if(accountingInvariantTableEmpty)accountingInvariantTableEmpty.classList.toggle('hidden',filtered.length>0);
      if(accountingInvariantTableMeta){
        accountingInvariantTableMeta.textContent=release
          ? filtered.length+' of '+rows.length+' rows shown · commit '+String(release.commit||'').slice(0,12)+' · '+String(release.status||'unverified')+' · '+(release.checkedAt?new Date(release.checkedAt).toLocaleString():'time unavailable')
          : 'No signed production accounting release audit is available yet.';
      }
    }

    function setAccountingReleaseAudits(audits){
      accountingReleaseAudits=Array.isArray(audits)?audits:[];
      if(accountingReleaseSelect){
        accountingReleaseSelect.innerHTML='';
        accountingReleaseAudits.forEach((row,index)=>{
          const option=document.createElement('option');
          option.value=String(row?.commit||'');
          option.textContent=(index===0?'Latest · ':'')+String(row?.commit||'').slice(0,12)+' · '+String(row?.clientCount||0)+' clients · '+String(row?.status||'unverified');
          accountingReleaseSelect.appendChild(option);
        });
      }
      renderAccountingInvariantTable();
    }

    [accountingFilterStatus,accountingFilterTaxable,accountingFilterMissingEstimate,accountingReleaseSelect].forEach((node)=>{
      node?.addEventListener('change',renderAccountingInvariantTable);
    });

    function renderAccountingHealth(summary,releaseAudits=[]){
      const data=summary||{};
      setAccountingReleaseAudits(releaseAudits);
      const latest=data.latest||null;
      const healthy=Boolean(latest?.ok)&&String(latest?.severity||'')!=='red';
      const warning=Boolean(latest?.ok)&&String(latest?.severity||'')==='yellow';
      if(accountingHealthStatus){
        accountingHealthStatus.textContent=!latest?'No sample':healthy?(warning?'Code safe · QBO unverified':'Healthy'):'Failed';
        accountingHealthStatus.className='rounded-full px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] '+(!latest?'bg-slate-100 text-slate-700':healthy?(warning?'bg-amber-100 text-amber-900':'bg-emerald-100 text-emerald-800'):'bg-red-100 text-red-800');
      }
      if(accountingInvariantResult)accountingInvariantResult.textContent=latest?.ok?'$15,706.80 passed':latest?'Invariant failed':'No sample';
      if(accountingInvariantDetail)accountingInvariantDetail.textContent=latest?.detail||'Run System Health to record the accounting invariant.';
      const liveClient=data.liveClientInvariant||null;
      const liveClientStatus=String(liveClient?.status||'unverified');
      if(accountingLiveClient){
        accountingLiveClient.textContent=liveClientStatus==='passed'
          ? '$15,706.80 = $15,706.80'
          : liveClientStatus==='failed'
            ? (liveClient?.historicalTaxOnTaxDetected?'$16,446.90 detected':'Mismatch detected')
            : liveClientStatus==='not-applicable'?'Not applicable':'Unverified';
        accountingLiveClient.className='mt-2 block text-lg '+(liveClientStatus==='passed'?'text-emerald-800':liveClientStatus==='failed'?'text-red-800':'text-amber-800');
      }
      if(accountingLiveClientDetail){
        const estimateNumber=liveClient?.estimateDocNumber?'Estimate #'+liveClient.estimateDocNumber:(liveClient?.estimateId?'Estimate ID '+liveClient.estimateId:'No estimate number');
        const verifiedAt=liveClient?.verifiedAt?new Date(liveClient.verifiedAt).toLocaleString():'not verified';
        accountingLiveClientDetail.textContent=liveClient
          ? estimateNumber+' · verified '+verifiedAt+' · taxable lines '+(liveClient?.taxableLineCount==null?'—':Number(liveClient.taxableLineCount))+'. '+String(liveClient.detail||'')
          : 'Run System Health to verify the live Chris Sibel estimate.';
      }
      const liveClients=data.liveClientInvariants||null;
      const clientStatus=String(liveClients?.status||'unverified');
      const clientCount=Number(liveClients?.clientCount||0);
      const clientPassed=Number(liveClients?.passedCount||0);
      const clientFailed=Number(liveClients?.failedCount||0);
      const clientUnverified=Number(liveClients?.unverifiedCount||0);
      if(accountingLiveClients){
        accountingLiveClients.textContent=liveClients
          ? clientPassed+'/'+clientCount+' passed'
          : 'Unverified';
        accountingLiveClients.className='mt-2 block text-lg '+(clientStatus==='passed'?'text-emerald-800':clientStatus==='failed'?'text-red-800':'text-amber-800');
      }
      if(accountingLiveClientsDetail){
        accountingLiveClientsDetail.textContent=liveClients
          ? clientFailed+' failed · '+clientUnverified+' unverified · '+String(liveClients.detail||'')
          : 'Run System Health to verify every accepted/booked client against live QuickBooks.';
      }
      const nonStatus=String(data.liveNonTaxStatus||'unverified');
      if(accountingNonStatus){
        accountingNonStatus.textContent=nonStatus==='available'?'Available':nonStatus==='missing-or-inactive'?'Missing / inactive':'Unverified';
        accountingNonStatus.className='mt-2 block text-lg '+(nonStatus==='available'?'text-emerald-800':nonStatus==='missing-or-inactive'?'text-red-800':'text-amber-800');
      }
      if(accountingNonDetail)accountingNonDetail.textContent=nonStatus==='available'
        ? 'Live QuickBooks NON tax code '+([data.liveNonTaxName,data.liveNonTaxId&&'#'+data.liveNonTaxId].filter(Boolean).join(' · ')||'verified')+'.'
        : nonStatus==='missing-or-inactive'
          ? 'Code math is checked separately, but live QuickBooks tax configuration is incompatible.'
          : 'Live QuickBooks tax-code availability could not be confirmed on the latest sample.';
      if(accountingLastSuccess)accountingLastSuccess.textContent=data.lastSuccessfulAt?new Date(data.lastSuccessfulAt).toLocaleString():'None recorded';
      if(accountingSampleCount)accountingSampleCount.textContent=Number(data.sampleCount||0)+' stored accounting sample'+(Number(data.sampleCount||0)===1?'':'s')+'.';
      if(accountingTaxablePayload){
        const amount=Number(data.taxablePayload||0);
        accountingTaxablePayload.textContent=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(amount);
        accountingTaxablePayload.className='mt-2 block text-lg '+(Math.abs(amount)<0.005?'text-emerald-800':'text-red-800');
      }

      const failures=Array.isArray(data.failures)?data.failures:[];
      if(accountingFailureCount)accountingFailureCount.textContent=failures.length+' shown';
      if(accountingFailures){
        accountingFailures.innerHTML='';
        if(!failures.length){
          accountingFailures.appendChild(accountingHistoryRow('No stored failures','The accounting invariant has no failed samples in the retained System Health history.','', 'emerald'));
        }else failures.forEach((row)=>accountingFailures.appendChild(accountingHistoryRow('Accounting invariant failed',row.detail,row.checkedAt,'red')));
      }

      const incidents=Array.isArray(data.incidentTimeline)?data.incidentTimeline:[];
      if(accountingAlertCount)accountingAlertCount.textContent=incidents.length+' permanent event'+(incidents.length===1?'':'s');
      if(accountingAlertHistory){
        accountingAlertHistory.innerHTML='';
        if(!incidents.length){
          accountingAlertHistory.appendChild(accountingHistoryRow('No invariant transitions yet','The permanent accounting timeline will record each client baseline, failure, value change, and recovery with before/after totals.','', 'emerald'));
        }else incidents.forEach((row)=>{
          const type=String(row.type||'event').replaceAll('_',' ');
          const tone=row.type==='recovered'||row.type==='baseline'?'emerald':row.type==='changed'?'amber':'red';
          const before=row.before||null;
          const after=row.after||{};
          const estimateNumber=row.estimateDocNumber?'Estimate #'+row.estimateDocNumber:(row.estimateId?'Estimate ID '+row.estimateId:'No estimate');
          const beforeText=before
            ? 'Before: CRM '+accountingMoney(before.proposalTotal)+' · QBO '+accountingMoney(before.estimateTotal)+' · taxable lines '+(before.taxableLineCount==null?'—':before.taxableLineCount)+'. '
            : 'Before: no stored invariant baseline. ';
          const afterText='After: CRM '+accountingMoney(after.proposalTotal)+' · QBO '+accountingMoney(after.estimateTotal)+' · taxable lines '+(after.taxableLineCount==null?'—':after.taxableLineCount)+'. ';
          const detail=beforeText+afterText+estimateNumber+'. '+String(row.detail||'');
          const title=[row.clientName||row.recordId,type.charAt(0).toUpperCase()+type.slice(1)].filter(Boolean).join(' · ');
          accountingAlertHistory.appendChild(accountingHistoryRow(title,detail,row.checkedAt,tone));
        });
      }
    }

    function render(data){
      markDashboardRenderPanel('Core summary');
      const current=data.current;
      if(current){
        const bad=current.overall==='unhealthy';
        const severityCounts=(current.checks||[]).reduce((acc,row)=>{
          const severity=normalizedSeverity(row);
          if(severity==='critical')acc.critical++;
          else if(severity==='warning')acc.warning++;
          else if(severity==='info')acc.info++;
          return acc;
        },{critical:0,warning:0,info:0});
        const hasIssues=severityCounts.critical+severityCounts.warning+severityCounts.info>0;
        const allHealthy=!hasIssues&&Number(current.failed||0)===0;
        overall.textContent=severityCounts.critical?'Critical':severityCounts.warning?'Warning':severityCounts.info?'Info':'Healthy';
        overall.className='display mt-3 text-4xl '+(severityCounts.critical?'text-red-800':severityCounts.warning?'text-amber-800':severityCounts.info?'text-sky-800':'text-emerald-800');
        overallCard.classList.toggle('bg-emerald-50',allHealthy);
        overallCard.classList.toggle('border',allHealthy);
        overallCard.classList.toggle('border-emerald-200',allHealthy);
        overallCard.classList.toggle('bg-white',!allHealthy);
        criticalCount.textContent=severityCounts.critical+' critical';
        warningCount.textContent=severityCounts.warning+' warning';
        infoCount.textContent=severityCounts.info+' info';
        criticalCount.classList.toggle('hidden',severityCounts.critical===0);
        warningCount.classList.toggle('hidden',severityCounts.warning===0);
        infoCount.classList.toggle('hidden',severityCounts.info===0);
        severitySummary.classList.toggle('hidden',!hasIssues);
        passed.textContent=String(current.passed||0);
        failed.textContent=String(current.failed||0);
        checked.textContent=current.checkedAt?new Date(current.checkedAt).toLocaleString():'—';
        const hasFailures=Number(current.failed||0)>0;
        const hasResults=Number(current.passed||0)+Number(current.failed||0)>0;

        // Make the top summary scannable by color:
        // Passed is green when results exist. Failed is red only when failures exist;
        // zero failures gets the same healthy green treatment rather than looking alarming.
        if(passedCard){
          passedCard.classList.toggle('bg-emerald-50',hasResults);
          passedCard.classList.toggle('border',hasResults);
          passedCard.classList.toggle('border-emerald-200',hasResults);
          passedCard.classList.toggle('bg-white',!hasResults);
