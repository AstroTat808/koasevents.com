---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Admin Health" description="Read-only health checks for Koa’s protected admin workspaces and APIs." canonical="https://koasevents.com/admin/health/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-7xl">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Reliability</p>
          <h1 class="display mt-3 text-5xl">System health</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Read-only checks for protected pages and APIs. Green means the page/API responded correctly from your current authenticated administrator session.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button data-refresh type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Run checks</button>
          <a href="/admin/" class="rounded-full bg-[var(--koa-ink)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Admin home</a>
        </div>
      </div>

      <div data-unauthorized class="mt-8 hidden rounded-[1.4rem] bg-white p-7 shadow-[var(--shadow-soft)]">This health dashboard requires an administrator account.</div>

      <div data-app class="mt-8 hidden grid gap-6">
        <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Overall</p><p data-overall class="display mt-3 text-4xl text-[var(--koa-forest)]">Checking…</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Passed</p><p data-passed class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Failed</p><p data-failed class="display mt-3 text-4xl text-red-800">0</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-ink)] p-5 text-white shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-amber-light)]">Last checked</p><p data-checked class="mt-3 text-sm font-semibold">—</p></article>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div><p class="eyebrow text-[var(--koa-clay)]">Protected interfaces</p><h2 class="display mt-2 text-4xl">Page startup health</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Confirms each generated page exists and still contains the expected startup container.</p></div>
          <div data-page-results class="mt-5 grid gap-3 lg:grid-cols-2"></div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div><p class="eyebrow text-[var(--koa-clay)]">Protected services</p><h2 class="display mt-2 text-4xl">API health</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Performs GET-only checks using your current authenticated session. No client, accounting, gallery, security, or staff data is changed.</p></div>
          <div data-api-results class="mt-5 grid gap-3 lg:grid-cols-2"></div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const app=document.querySelector('[data-app]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const pageResults=document.querySelector('[data-page-results]');
    const apiResults=document.querySelector('[data-api-results]');
    const overall=document.querySelector('[data-overall]');
    const passed=document.querySelector('[data-passed]');
    const failed=document.querySelector('[data-failed]');
    const checked=document.querySelector('[data-checked]');
    const refresh=document.querySelector('[data-refresh]');

    const pages=[
      ['Business CRM','/admin/crm/','data-admin-ui'],
      ['Sales CRM','/admin/quotes/','data-admin-ui'],
      ['Event Ops','/admin/events/','data-app'],
      ['Master Calendar','/admin/calendar/','data-app'],
      ['Blog Admin','/admin/blog/','data-admin-ui'],
      ['Staff Management','/admin/staff/','data-app'],
      ['QuickBooks','/admin/quickbooks/','data-app'],
      ['Gallery','/admin/gallery/','data-admin-ui'],
      ['Security + Spam','/admin/security/','data-app'],
      ['Local SEO','/admin/seo/','data-admin-ui'],
      ['Staff Home','/staff/','data-staff-ui'],
    ];

    function monthRange(){
      const now=new Date();
      const start=new Date(now.getFullYear(),now.getMonth(),1);
      const end=new Date(now.getFullYear(),now.getMonth()+1,0);
      const iso=(d)=>d.toISOString().slice(0,10);
      return {start:iso(start),end:iso(end)};
    }
    const range=monthRange();
    const apis=[
      ['Admin session','/api/admin/session'],
      ['Business CRM API','/api/admin/crm'],
      ['Sales CRM API','/api/admin/quotes'],
      ['Event Ops API','/api/admin/events'],
      ['Master Calendar API','/api/admin/calendar?start='+encodeURIComponent(range.start)+'&end='+encodeURIComponent(range.end)],
      ['Blog API','/api/blog?admin=1'],
      ['Staff Management API','/api/admin/staff'],
      ['QuickBooks API','/api/admin/quickbooks'],
      ['Gallery API','/api/gallery'],
      ['Security API','/api/admin/security?days=7'],
      ['Local SEO API','/api/admin/local-seo'],
    ];

    function row(name,path,result){
      const card=document.createElement('article');
      card.className='rounded-xl border '+(result.ok?'border-emerald-200 bg-emerald-50':'border-red-200 bg-red-50')+' p-4';
      const top=document.createElement('div');top.className='flex items-start justify-between gap-4';
      const left=document.createElement('div');
      const title=document.createElement('h3');title.className='font-semibold text-[var(--koa-forest)]';title.textContent=name;
      const meta=document.createElement('p');meta.className='mt-1 break-all text-xs text-[var(--koa-ink)]/48';meta.textContent=path;
      left.append(title,meta);
      const badge=document.createElement('span');badge.className='shrink-0 rounded-full px-3 py-1 text-[.58rem] font-black uppercase tracking-[.08em] '+(result.ok?'bg-emerald-800 text-white':'bg-red-800 text-white');badge.textContent=result.ok?'Healthy':'Failed';
      top.append(left,badge);
      const detail=document.createElement('p');detail.className='mt-3 text-xs leading-5 text-[var(--koa-ink)]/60';detail.textContent='HTTP '+(result.status||'—')+' · '+result.ms+' ms'+(result.detail?' · '+result.detail:'');
      card.append(top,detail);return card;
    }

    async function checkPage([name,path,marker]){
      const started=performance.now();
      try{
        const response=await fetch(path,{cache:'no-store'});
        const html=await response.text();
        return {name,path,ok:response.ok&&html.includes(marker),status:response.status,ms:Math.round(performance.now()-started),detail:html.includes(marker)?'Startup marker present':'Expected startup marker missing'};
      }catch(error){
        return {name,path,ok:false,status:0,ms:Math.round(performance.now()-started),detail:error instanceof Error?error.message:'Request failed'};
      }
    }

    async function checkApi([name,path]){
      const started=performance.now();
      try{
        const response=await fetch(path,{cache:'no-store'});
        const type=response.headers.get('content-type')||'';
        let detail='';
        if(response.ok && type.includes('application/json')) await response.json();
        else if(!response.ok) detail='Protected API returned '+response.status;
        return {name,path,ok:response.ok,status:response.status,ms:Math.round(performance.now()-started),detail};
      }catch(error){
        return {name,path,ok:false,status:0,ms:Math.round(performance.now()-started),detail:error instanceof Error?error.message:'Request failed'};
      }
    }

    async function run(){
      refresh.disabled=true;refresh.textContent='Checking…';
      overall.textContent='Checking…';pageResults.innerHTML='';apiResults.innerHTML='';
      const [pageRows,apiRows]=await Promise.all([Promise.all(pages.map(checkPage)),Promise.all(apis.map(checkApi))]);
      pageRows.forEach((result,index)=>pageResults.appendChild(row(pages[index][0],pages[index][1],result)));
      apiRows.forEach((result,index)=>apiResults.appendChild(row(apis[index][0],apis[index][1],result)));
      const all=[...pageRows,...apiRows];const pass=all.filter(item=>item.ok).length;const fail=all.length-pass;
      passed.textContent=String(pass);failed.textContent=String(fail);overall.textContent=fail?'Attention':'Healthy';
      overall.className='display mt-3 text-4xl '+(fail?'text-red-800':'text-[var(--koa-forest)]');
      checked.textContent=new Date().toLocaleString();
      refresh.disabled=false;refresh.textContent='Run checks';
    }

    refresh?.addEventListener('click',run);
    const session=await getAdminSession();
    const ok=Boolean(session?.isAdmin);
    app?.classList.toggle('hidden',!ok);
    unauthorized?.classList.toggle('hidden',ok);
    if(ok) await run();
  </script>
</BaseLayout>
