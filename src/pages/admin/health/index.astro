    const healthDetailCause=document.querySelector('[data-health-detail-cause]');
    const healthDetailFix=document.querySelector('[data-health-detail-fix]');
    let latestHealthChecks=[];

    let latestHealthRunWarnings=[];
    let currentDashboardRenderPanel='Starting';

    function markDashboardRenderPanel(label){
      currentDashboardRenderPanel=String(label||'Dashboard');
      setCompactStatus(dashboardRefreshStatus,'running','Rendering · '+currentDashboardRenderPanel);
    }

    let latestDashboardRenderWarnings=[];

    function renderDashboardPanel(label,renderPanel){
      markDashboardRenderPanel(label);
      try{
        renderPanel();
        return true;
      }catch(error){
        const warning={
          section:'Dashboard rendering · '+String(label||'Dashboard'),
          error:error instanceof Error?error.message:'A secondary System Health panel failed to render.',
        };
        latestDashboardRenderWarnings.push(warning);
        console.error('[system-health] '+warning.section+':',error);
        return false;
      }
    }

    function setCompactStatus(node,state,label){
      if(!(node instanceof HTMLElement))return;
      const states:Record<string,string>={
        healthy:'text-emerald-700',
        current:'text-emerald-700',
        running:'text-sky-700',
        partial:'text-amber-700',
        failed:'text-red-700',
        idle:'text-slate-600',
      };
      node.className=states[state]||states.idle;
      node.textContent=label;
    }

    function updateCoreCheckStatus(current,state='complete'){
      if(state==='running'){
        setCompactStatus(coreCheckStatus,'running','Checking…');
        return;
      }
      if(state==='failed'){
        setCompactStatus(coreCheckStatus,'failed','Run failed');
        return;
      }
      if(!current){
        setCompactStatus(coreCheckStatus,'idle','No data');
        return;
      }
      const failedCount=Number(current.failed||0);
      if(failedCount>0||String(current.overall||'')==='unhealthy'){
        setCompactStatus(coreCheckStatus,'failed',failedCount?failedCount+' failed':'Attention');
      }else{
        setCompactStatus(coreCheckStatus,'healthy','Healthy');
      }
    }

    function updateDashboardRefreshStatus(state,count=0){
      if(state==='running')setCompactStatus(dashboardRefreshStatus,'running','Refreshing…');
      else if(state==='partial')setCompactStatus(dashboardRefreshStatus,'partial',count?('Partial · '+count):'Partial');
      else if(state==='failed')setCompactStatus(dashboardRefreshStatus,'failed','Failed');
      else if(state==='current')setCompactStatus(dashboardRefreshStatus,'current','Current');
      else setCompactStatus(dashboardRefreshStatus,'idle','No data');
    }

    function normalizeHealthRunWarnings(warnings){
      return (Array.isArray(warnings)?warnings:[])
        .map((warning)=>({
          section:String(warning?.section||'Supporting data').trim()||'Supporting data',
          error:String(warning?.error||'Refresh failed.').trim()||'Refresh failed.',
        }))
        .filter((warning)=>warning.section||warning.error);
    }

    function warningTarget(section){
      const normalized=String(section||'').toLowerCase();
      const mappings=[
        [/office 365|microsoft/, '[data-office365-operational]'],
        [/credential/, '#credential-health'],
        [/email health|email/, '[data-email-health-overall]'],
        [/weekly|executive summary/, '[data-weekly-executive-summary]'],
        [/release metadata|production release|deployment/, '[data-deploy-history]'],
        [/uptime|incident/, '[data-uptime-body]'],
        [/policy|transition alert/, '[data-policy-body]'],
        [/snapshot|history|previous health/, '[data-health-history]'],
      ];
      const match=mappings.find(([pattern])=>pattern.test(normalized));
      if(!match)return null;
      const found=document.querySelector(match[1]);
      if(!(found instanceof HTMLElement))return null;
      return found.closest('section')||found;
    }

    function openWarningSubsystem(section){
      const target=warningTarget(section);
      if(!(target instanceof HTMLElement))return false;
      healthRunWarningDialog?.close();
      target.scrollIntoView({behavior:'smooth',block:'start'});
      target.classList.add('ring-2','ring-amber-400','ring-offset-2');
      window.setTimeout(()=>target.classList.remove('ring-2','ring-amber-400','ring-offset-2'),2600);
      return true;
    }

    function renderHealthRunWarningDialog(){
      if(!healthRunWarningList)return;
      healthRunWarningList.innerHTML='';
      latestHealthRunWarnings.forEach((warning,index)=>{
        const card=document.createElement('article');
        card.className='rounded-xl border border-amber-200 bg-amber-50 p-4';
        const top=document.createElement('div');
        top.className='flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between';
        const text=document.createElement('div');
        const label=document.createElement('p');
        label.className='text-[.54rem] font-black uppercase tracking-[.08em] text-amber-800';
        label.textContent='Subsystem '+(index+1);
        const title=document.createElement('h3');
        title.className='mt-1 text-sm font-semibold text-[var(--koa-forest)]';
        title.textContent=warning.section;
        const detail=document.createElement('p');
        detail.className='mt-2 break-words text-xs leading-5 text-amber-950/75';
        detail.textContent=warning.error;
        text.append(label,title,detail);
        top.appendChild(text);

        if(warningTarget(warning.section)){
          const open=document.createElement('button');
          open.type='button';
          open.className='shrink-0 rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-white';
          open.textContent='Open subsystem';
          open.addEventListener('click',()=>openWarningSubsystem(warning.section));
          top.appendChild(open);
        }
        card.appendChild(top);
        healthRunWarningList.appendChild(card);
      });
      if(!latestHealthRunWarnings.length){
        healthRunWarningList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/55">No supporting-data error details were recorded.</p>';
      }
    }

    function clearHealthRunWarning(){
      latestHealthRunWarnings=[];
      healthRunWarning?.classList.add('hidden');
      if(healthRunWarningDetail)healthRunWarningDetail.textContent='';
    }

    function showHealthRunWarning(title,detail='',warnings=[]){
      if(!healthRunWarning)return;
      latestHealthRunWarnings=normalizeHealthRunWarnings(
        warnings.length?warnings:(detail?[{section:'Dashboard refresh',error:detail}]:[])
      );
      healthRunWarning.classList.remove('hidden');
      if(healthRunWarningTitle)healthRunWarningTitle.textContent=title;
      if(healthRunWarningDetail){
        healthRunWarningDetail.textContent=latestHealthRunWarnings.length
          ? latestHealthRunWarnings.length+' supporting-data issue'+(latestHealthRunWarnings.length===1?'':'s')+' · click for exact subsystem and error'
          : detail;
      }
      renderHealthRunWarningDialog();
    }

    function prepareMobileHealthTables(){
      document.querySelectorAll('main[data-system-health-page] table').forEach((table)=>{
        if(!(table instanceof HTMLTableElement))return;
        table.classList.add('koa-mobile-card-table');
        const labels=[...table.querySelectorAll('thead th')].map((cell)=>String(cell.textContent||'').trim());
        table.querySelectorAll('tbody tr').forEach((row)=>{
          [...row.children].forEach((cell,index)=>{
            if(cell instanceof HTMLElement)cell.dataset.mobileLabel=labels[index]||'';
          });
        });
      });
    }

    function renderHealthPayload(payload,source='System Health'){
      clearHealthRunWarning();
      updateCoreCheckStatus(payload?.current);
      const backendWarnings=normalizeHealthRunWarnings(payload?.enrichmentWarnings);
      latestDashboardRenderWarnings=[];
      updateDashboardRefreshStatus('running');
      currentDashboardRenderPanel='Starting';
      let unexpectedRenderFailure=false;
      try{
        render(payload||{});
      }catch(error){
        console.error('[system-health] '+source+' detail rendering failed in '+currentDashboardRenderPanel+':',error);
        if(!payload?.current)throw error;
        unexpectedRenderFailure=true;
        latestDashboardRenderWarnings.push({
          section:'Dashboard rendering · '+currentDashboardRenderPanel,
          error:error instanceof Error?error.message:'A secondary System Health panel failed to render.',
        });
      }

      prepareMobileHealthTables();

      const warnings=[...backendWarnings,...latestDashboardRenderWarnings];
      updateDashboardRefreshStatus(warnings.length?'partial':'current',warnings.length);
      if(warnings.length){
        showHealthRunWarning(
          latestDashboardRenderWarnings.length
            ? 'Core checks completed; a detail panel could not refresh.'
            : 'Core checks completed; supporting data needs attention.',
          '',
          warnings
        );
      }
      return !unexpectedRenderFailure&&latestDashboardRenderWarnings.length===0;
    }

    function normalizedSeverity(row){
      if(row?.severity==='red')return 'critical';
      if(row?.severity==='yellow')return 'warning';
      if(row?.severity==='info')return 'info';
      return row?.ok?'healthy':'critical';
    }

    function explainHealthIssue(row){
      const detail=String(row?.detail||'').trim();
      const status=Number(row?.status||0);
      const deploymentState=String(row?.deploymentState||'');
      const issueType=String(row?.issueType||'');
      const issueDefaults={
        'Service Failure':[
          'The monitored service or application path is not meeting its expected operational contract.',
          'Inspect the affected service, runtime logs, and most recent code change, then rerun the check after the operational failure is corrected.',
        ],
        'Authentication Expected':[
          'The protected endpoint returned an authentication response exactly as expected for an unauthenticated health probe.',
          'No action is required. The authentication boundary is working as designed.',
        ],
        'Configuration Problem':[
          'The service is reachable, but a required setting, environment value, route contract, or integration configuration is missing or inconsistent.',
          'Correct the named configuration without treating the underlying provider as an outage, then rerun System Health.',
        ],
        'Permission Problem':[
          'The credential or authenticated identity reached the service but does not currently have the access required for this check.',
          'Correct the credential scope, role, consent, or permission. Keep unrelated service-health checks separate so a permission issue does not imply an outage.',
        ],
        'Deployment Problem':[
          'The current production deployment state is preventing a clean verification of the expected release.',
          'Resolve the identified deployment, release-policy, or Git-to-Netlify synchronization state, then rerun the check.',
        ],
        'External Dependency Problem':[
          'An external provider or upstream API could not be verified independently of the Koa application itself.',
          'Confirm the provider response and retry. Treat this separately from an internal application failure unless the provider problem is proven to be caused by Koa configuration.',
        ],
      };
      const defaults=issueDefaults[issueType]||[
        'The monitor received an unexpected response from this service.',
        'Run the check again. If it still fails, inspect the affected service and its most recent deployment or configuration change.',
      ];
      let cause=defaults[0];
      let fix=defaults[1];

      if(row?.id==='email-send-access'){
        cause=status===0
          ? 'The production Resend sending credential is missing or could not be verified.'
          : 'The production Resend sending credential did not pass its non-destructive permission verification.';
        fix='Verify RESEND_API_KEY is present in Netlify production and has Resend sending permission. Do not replace it with the broader monitoring credential.';
      }else if(row?.id==='email-monitoring-access'){
        cause=status===401||status===403
          ? 'The dedicated Resend monitoring credential does not have permission to read delivery history.'
          : status===0
            ? 'The dedicated Resend monitoring credential is missing or the monitoring request could not reach Resend.'
            : 'The dedicated Resend monitoring credential could not read delivery history.';
        fix='Verify RESEND_MONITORING_API_KEY is configured in Netlify functions/runtime with a Resend credential that can read email history. This does not mean outbound sending is broken.';
      }else if(row?.id==='credential-turnstile'){
        cause='The Turnstile site key, server secret, widget rendering, Siteverify probe, or recent hostname/action validation is not healthy.';
        fix='Open the Turnstile credential card below to see the failing layer. Verify the Netlify site/secret variables and Cloudflare widget hostname configuration, then re-test Turnstile only.';
      }else if(row?.id==='turnstile-site-key'){
        cause='The production runtime cannot see the configured public Turnstile site key.';
        fix='Verify PUBLIC_TURNSTILE_SITE_KEY in Netlify production matches the Cloudflare widget site key, then redeploy.';
      }else if(row?.id==='turnstile-secret'){
        cause='The server-side Turnstile secret is missing from the production runtime.';
        fix='Configure TURNSTILE_SECRET_KEY (or TURNSTILE_SECRET) as a secret Netlify runtime variable. Never place this secret in browser code.';
      }else if(row?.id==='turnstile-widgets'){
        cause='One or more protected public forms is not rendering the configured Turnstile site key, script, or expected action.';
        fix='Open the affected form named in the check detail and restore its cf-turnstile widget, Cloudflare script, and expected data-action.';
      }else if(row?.id==='turnstile-siteverify'){
        cause=status===401||status===403
          ? 'Cloudflare Siteverify rejected the configured Turnstile secret.'
          : 'Cloudflare Siteverify could not be reached or did not accept the health probe.';
        fix='Verify the production secret against the existing Cloudflare widget and rerun System Health. If Cloudflare is temporarily unavailable, the check will recover automatically.';
      }else if(row?.id==='turnstile-validation-history'){
        cause='No successful production Turnstile validation has been recorded yet in the current security history.';
        fix='Submit one protected production form normally, then rerun System Health to establish a verified validation record.';
      }else if(row?.id==='turnstile-hostname-action'){
        cause='Cloudflare accepted one or more tokens whose returned hostname or action did not match the Koa’s Events request.';
        fix='Check the latest mismatch detail in Security + Spam, confirm the widget hostname is koasevents.com and each form uses its expected data-action, then retest.';
      }else if(row?.id==='credential-signwell'){
        cause=status===401||status===403
          ? 'The SignWell API key was rejected by SignWell.'
          : 'The SignWell API key, webhook ID, registration, delivery verification, or completed-PDF path is not fully verified.';
        fix='Verify SIGNWELL_API_KEY and SIGNWELL_WEBHOOK_ID in Netlify production, confirm the webhook callback is https://koasevents.com/api/webhooks/signwell, then rerun System Health.';
      }else if(row?.id==='signwell-webhook-registration'){
        cause='The configured SignWell webhook ID could not be matched to the expected production callback URL.';
        fix='In SignWell, register https://koasevents.com/api/webhooks/signwell and copy the returned webhook ID into SIGNWELL_WEBHOOK_ID in Netlify production.';
      }else if(row?.id==='signwell-webhook-delivery'){
        cause='No verified production SignWell webhook has been recorded yet.';
        fix='Complete a SignWell test-mode agreement so SignWell sends a real signed webhook event, then rerun System Health.';
      }else if(row?.id==='signwell-signed-pdf'){
        cause='The completed SignWell agreement PDF could not be retrieved, or no completed agreement exists yet to exercise this path.';
        fix='Finish a test-mode agreement, wait for document_completed, and verify the completed PDF can be retrieved and stored with the CRM record.';
      }else if(deploymentState==='synced'&&row?.deploymentDetails?.fallbackUsed){
        cause='Direct GitHub main metadata was not available to the production function, so the monitor verified the current release from Netlify commit_ref instead.';
        fix='No manual action is required. System Health automatically retries direct GitHub metadata on later checks and returns to full green as soon as GitHub + Netlify verification succeeds.';
      }else if(deploymentState==='deploying'){
        cause='Production is behind main because a Netlify production build is currently running.';
        fix='Wait for the active deploy to finish, then run System Health again. If the deploy fails, open the deploy failure and fix that build error.';
      }else if(deploymentState==='waiting'){
        cause='A new main-branch commit is waiting for Netlify Git auto-deploy to begin within the normal trigger grace period.';
        fix='Give Netlify a few minutes to start the build. If no build appears after the grace period, check the Git-linked site and auto-deploy configuration.';
      }else if(deploymentState==='release-policy-skipped'){
        cause='The newest main-branch commit was intentionally skipped by the production release policy because it was a direct commit without a [release] prefix.';
        fix='For an intentional direct production release, prefix the commit message with [release]. Normal pull-request merges and squash merges are already approved by policy.';
      }else if(deploymentState==='auto-deploy-broken'){
        cause='Git auto-deploy appears stalled or the Netlify site is no longer linked correctly to the production repository/branch.';
        fix='Verify the Netlify site is linked to AstroTat808/koasevents.com, production branch main, and automatic Git deploys are enabled. Then trigger or retry a production deploy.';
      }else if(deploymentState==='deploy-failed'){
        cause='The production deploy associated with the current main commit ended in a failed state.';
        fix='Open the failed Netlify deploy, correct the reported build/runtime error, push the fix, and verify the new production deploy succeeds.';
      }else if(/startup marker missing/i.test(detail)){
        cause='The page returned HTML, but the expected application startup marker was missing. This often means the page shell changed, the client app did not initialize, or the health probe marker is outdated.';
        fix='Open the affected page, confirm it loads for staff, then either fix the page startup error or update the monitor marker if the page structure intentionally changed.';
      }else if(/page request failed/i.test(detail)||status===0){
        cause='The page could not be reached successfully. This can come from a routing, deployment, DNS/CDN, or server-side runtime failure.';
        fix='Verify the route exists in the current production deploy, then inspect the latest deploy logs and any function/edge errors tied to this request.';
      }else if(/unexpected api response/i.test(detail)){
        if(status>=500){
          cause='The API is reachable but returned a server error, indicating a function/runtime exception or an upstream dependency failure.';
          fix='Inspect the corresponding Netlify function logs and the most recent code/configuration changes for this endpoint. Fix the server error, redeploy, and rerun the check.';
        }else if(status===404){
          cause='The monitored API route was not found in production. The route may have moved, been removed, or failed to deploy.';
          fix='Confirm the endpoint path is still correct. Restore the route or update the System Health check if the API was intentionally renamed.';
        }else if(status===429){
          cause='The health probe was rate-limited.';
          fix='Review the endpoint rate-limit rules and allow safe internal health checks without weakening client-facing protections.';
        }else{
          cause='The endpoint responded with a status outside the expected 200/401/403 range.';
          fix='Check the endpoint response and authentication behavior. Restore the expected contract or update the monitor only if the behavior changed intentionally.';
        }
      }else if(/startup failure/i.test(detail)){
        cause='A logged-in staff browser reported that the Business CRM did not initialize successfully on the current release.';
        fix='Open the Business CRM in production, inspect the browser console/network errors, and fix the first startup failure before redeploying.';
      }

      return {cause,fix};
    }

    function openHealthDetail(row){
      if(!row)return;
      const severity=normalizedSeverity(row);
      const explanation=explainHealthIssue(row);
      healthDetailSeverity.textContent=severity==='critical'?'Critical issue':severity==='warning'?'Warning':severity==='info'?'Information':'Healthy';
      healthDetailSeverity.className='eyebrow '+(severity==='critical'?'text-red-800':severity==='warning'?'text-amber-800':severity==='info'?'text-sky-800':'text-emerald-800');
      healthDetailTitle.textContent=String(row.name||'Health check');
      const deploymentDetails=row?.deploymentDetails||null;
      const syntheticDetails=row?.syntheticDetails||null;
      const deploymentMeta=deploymentDetails
        ? [
            deploymentDetails.githubCommit?'GitHub '+String(deploymentDetails.githubCommit).slice(0,12):'',
            deploymentDetails.netlifyDeployId?'Netlify '+String(deploymentDetails.netlifyDeployId).slice(0,12):'',
            deploymentDetails.deployStatus?'Status '+String(deploymentDetails.deployStatus):'',
            deploymentDetails.deployTime?'Deployed '+new Date(deploymentDetails.deployTime).toLocaleString():'',
            typeof deploymentDetails.repositoryPrivate==='boolean'?(deploymentDetails.repositoryPrivate?'Private repo':'Public repo'):'',
            deploymentDetails.verificationSourceLabel?('Verified by '+String(deploymentDetails.verificationSourceLabel)):'',
          ].filter(Boolean).join(' · ')
        : '';
      const syntheticMeta=syntheticDetails
        ? [
            String(syntheticDetails.source||'live').toUpperCase(),
            'Expected HTTP '+String(syntheticDetails.expectedStatus||204),
            syntheticDetails.returnedMarker?'Marker '+String(syntheticDetails.returnedMarker):'No marker returned',
            syntheticDetails.lastLiveCheckedAt?'Last live '+new Date(syntheticDetails.lastLiveCheckedAt).toLocaleString():'',
          ].filter(Boolean).join(' · ')
        : '';
      healthDetailMeta.textContent=[
        String(row.kind||'check')+' · '+String(row.path||'')+' · HTTP '+String(row.status||'—')+' · '+String(row.ms||0)+' ms',
        syntheticMeta,
        deploymentMeta,
      ].filter(Boolean).join(' · ');
      if(healthDetailIssueType){
        const issueType=String(row.issueType||'');
        healthDetailIssueType.textContent=issueType;
        healthDetailIssueType.classList.toggle('hidden',!issueType);
      }
      healthDetailError.textContent=String(row.detail||'No additional detail was recorded.');
      if(syntheticDetails){
        const source=String(syntheticDetails.source||'live').toUpperCase();
        const returned=String(syntheticDetails.returnedMarker||'none');
        const expected=String(syntheticDetails.expectedMarker||'');
        const lastLive=syntheticDetails.lastLiveCheckedAt?new Date(syntheticDetails.lastLiveCheckedAt).toLocaleString():'unknown';
        healthDetailVerification.textContent=source+' synthetic verification · last live '+lastLive+' · returned marker '+returned+(expected?' · expected '+expected:'')+' · expected HTTP '+String(syntheticDetails.expectedStatus||204);
        healthDetailVerificationWrap.classList.remove('hidden');
      }else if(deploymentDetails){
        const verificationLabel=String(deploymentDetails.verificationSourceLabel||deploymentDetails.verificationSource||'Unverified');
        const githubSource=String(deploymentDetails.githubMetadataSource||'').trim();
        healthDetailVerification.textContent=verificationLabel+(githubSource?' · '+githubSource:'');
        healthDetailVerificationWrap.classList.remove('hidden');
      }else{
        healthDetailVerification.textContent='';
        healthDetailVerificationWrap.classList.add('hidden');
      }
      healthDetailCause.textContent=explanation.cause;
      healthDetailFix.textContent=explanation.fix;
      healthDetailDialog.showModal();
    }

    function healthRow(row){
      const severity=normalizedSeverity(row);
      const palette=severity==='critical'
        ? 'border-red-200 bg-red-50'
        : severity==='warning'
          ? 'border-amber-200 bg-amber-50'
          : severity==='info'
            ? 'border-sky-200 bg-sky-50'
            : 'border-emerald-200 bg-emerald-50';
      const badgePalette=severity==='critical'
        ? 'bg-red-800 text-white'
        : severity==='warning'
          ? 'bg-amber-700 text-white'
          : severity==='info'
            ? 'bg-sky-700 text-white'
            : 'bg-emerald-800 text-white';
      const badgeText=severity==='critical'?'Critical':severity==='warning'?'Warning':severity==='info'?'Info':'Healthy';
      const card=document.createElement('button');
      card.type='button';
      card.className='rounded-xl border '+palette+' p-4 text-left transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--koa-clay)]';
      card.dataset.healthOk=row.ok?'true':'false';
      card.dataset.healthSeverity=severity;
      card.addEventListener('click',()=>openHealthDetail(row));
      const top=document.createElement('div');top.className='flex items-start justify-between gap-4';
      const left=document.createElement('div');
      const title=document.createElement('h3');title.className='font-semibold text-[var(--koa-forest)]';title.textContent=row.name;
      const meta=document.createElement('p');meta.className='mt-1 break-all text-xs text-[var(--koa-ink)]/48';meta.textContent=row.kind+' · '+row.path;
      left.append(title,meta);
      if(row.issueType){
        const type=document.createElement('span');
        type.className='mt-2 inline-flex rounded-full bg-white/75 px-2.5 py-1 text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]';
        type.textContent=String(row.issueType);
        left.appendChild(type);
      }
      const badge=document.createElement('span');badge.className='shrink-0 rounded-full px-3 py-1 text-[.58rem] font-black uppercase tracking-[.08em] '+badgePalette;badge.textContent=badgeText;
      top.append(left,badge);
      const detail=document.createElement('p');detail.className='mt-3 text-xs leading-5 text-[var(--koa-ink)]/60';detail.textContent='HTTP '+(row.status||'—')+' · '+row.ms+' ms · '+(row.detail||'');
      const synthetic=row?.syntheticDetails||null;
      let diagnostics=null;
      if(synthetic){
        diagnostics=document.createElement('div');
        diagnostics.className='mt-3 flex flex-wrap gap-2 text-[.54rem] font-black uppercase tracking-[.07em]';
        const source=document.createElement('span');
        const sourceName=String(synthetic.source||'live').toLowerCase();
        source.className='rounded-full px-2.5 py-1 '+(sourceName==='cached'?'bg-amber-100 text-amber-900':'bg-emerald-100 text-emerald-800');
        source.textContent=sourceName==='cached'?'Cached result':'Live result';
        const http=document.createElement('span');
        http.className='rounded-full bg-white/80 px-2.5 py-1 text-[var(--koa-forest)]';
        http.textContent='HTTP '+String(row.status||'—')+' / '+String(synthetic.expectedStatus||204);
        const marker=document.createElement('span');
        marker.className='rounded-full bg-white/80 px-2.5 py-1 text-[var(--koa-forest)]';
        marker.textContent='Marker '+String(synthetic.returnedMarker||'none');
        const verified=document.createElement('span');
        verified.className='rounded-full bg-white/80 px-2.5 py-1 text-[var(--koa-forest)]';
        verified.textContent='Last live '+(synthetic.lastLiveCheckedAt?new Date(synthetic.lastLiveCheckedAt).toLocaleString():'unknown');
        diagnostics.append(source,http,marker,verified);
      }
      const more=document.createElement('p');more.className='mt-3 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]';more.textContent='Open explanation →';
      card.append(top,detail);
      if(diagnostics)card.appendChild(diagnostics);
      card.append(more);return card;
    }

    function renderRootCauseSummary(rows){
      const counts=(Array.isArray(rows)?rows:[]).reduce((acc,row)=>{
        const type=String(row?.issueType||'');
        if(type)acc[type]=(acc[type]||0)+1;
        return acc;
      },{});
      rootCauseButtons.forEach((button)=>{
        const type=String(button.dataset.rootCauseFilter||'');
        const count=Number(counts[type]||0);
        const countNode=button.querySelector('[data-root-cause-count]');
        if(countNode)countNode.textContent=String(count);
        const active=activeRootCause===type;
        button.disabled=count===0;
        button.setAttribute('aria-pressed',String(active));
        button.className='rounded-xl border p-4 text-left transition disabled:cursor-default disabled:opacity-45 '+(
          active
            ? 'border-[var(--koa-forest)] bg-[var(--koa-forest)] text-white shadow-md'
            : 'border-[var(--koa-line)] bg-[var(--koa-ivory)] text-[var(--koa-forest)] hover:border-[var(--koa-clay)]'
        );
      });
      rootCauseClear?.classList.toggle('hidden',!activeRootCause);
    }

    function activeHealthFilterLabelFor(count){
      const suffix=count+' check'+(count===1?'':'s');
      if(activeSeverity){
        const label=activeSeverity==='critical'?'Critical':activeSeverity==='warning'?'Warning':'Info';
        return 'Showing: '+label+' · '+suffix;
      }
      if(activeRootCause)return 'Showing: '+activeRootCause+' · '+suffix;
      if(failuresOnly?.checked)return 'Showing: Issues · '+suffix;
      return '';
    }

    function renderActiveHealthFilter(count){
      if(!(activeHealthFilter instanceof HTMLElement)||!(activeHealthFilterLabel instanceof HTMLElement))return;
      const label=activeHealthFilterLabelFor(Number(count||0));
      activeHealthFilter.classList.toggle('hidden',!label);
      activeHealthFilter.classList.toggle('flex',Boolean(label));
      if(label)activeHealthFilterLabel.textContent=label;
    }

    function clearHealthFilters(){
      activeRootCause='';
      activeSeverity='';
      if(failuresOnly)failuresOnly.checked=false;
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
    }

    function healthCheckSection(row){
      const id=String(row?.id||'').toLowerCase();
      const name=String(row?.name||'').toLowerCase();
      const path=String(row?.path||'').toLowerCase();
      const issueType=String(row?.issueType||'').toLowerCase();
      const haystack=[id,name,path,issueType].join(' ');

      if(row?.deploymentState||row?.deploymentDetails||issueType==='deployment problem'||/(netlify|github|deploy(?:ment)?|release)/.test(haystack)){
        return {label:'Deployment',selector:'#health-deployment'};
      }
      if(/office[ -]?365|microsoft graph|calendar sync/.test(haystack)){
        return {label:'Office 365 calendar sync',selector:'#health-office365'};
      }
      if(/(email|resend|mailer|mail|renderer)|inline logo/.test(haystack)){
        return {label:'Email Health',selector:'#health-email'};
      }
      if(row?.syntheticDetails||/event[- ]?documents?|vendor[- ]?insurance|quickbooks[- ]?webhook|signwell/.test(haystack)){
        return {label:'Critical Integrations',selector:'[data-critical-integrations-card]'};
      }
      if(/credential|oauth|api key|secret|permission|configuration/.test(haystack)){
        return {label:'Credential Health',selector:'#credential-health'};
      }
      return {label:'Pages + APIs',selector:'#health-pages-apis'};
    }

    function sectionBreakdownForSeverity(severity){
      const normalized=String(severity||'');
      const counts=new Map();
      latestHealthChecks
        .filter((row)=>normalizedSeverity(row)===normalized)
        .forEach((row)=>{
          const section=healthCheckSection(row);
          const key=section.selector;
          const current=counts.get(key)||{...section,count:0};
          current.count+=1;
          counts.set(key,current);
        });
      return [...counts.values()].sort((a,b)=>b.count-a.count||a.label.localeCompare(b.label));
    }

    function severityCountWord(severity,count){
      if(severity==='warning')return count===1?'warning':'warnings';
      if(severity==='info')return count===1?'notice':'notices';
      return 'critical';
    }

    function updateSeverityBadgeSectionHints(){
      const rows=[
        {severity:'critical',node:criticalCount,count:latestHealthChecks.filter((row)=>normalizedSeverity(row)==='critical').length,label:'Critical'},
        {severity:'warning',node:warningCount,count:latestHealthChecks.filter((row)=>normalizedSeverity(row)==='warning').length,label:'Warnings'},
        {severity:'info',node:infoCount,count:latestHealthChecks.filter((row)=>normalizedSeverity(row)==='info').length,label:'Info'},
      ];
      if(severitySectionHints instanceof HTMLElement)severitySectionHints.innerHTML='';

      let visibleGroups=0;
      rows.forEach(({severity,node,count,label})=>{
        if(!(node instanceof HTMLButtonElement)||!count)return;
        const sections=sectionBreakdownForSeverity(severity);
        const sectionText=sections.length
          ? sections.map((section)=>section.label+' · '+section.count+' '+severityCountWord(severity,section.count)).join(', ')
          : 'Pages + APIs · '+count+' '+severityCountWord(severity,count);
        node.title=label+' by section: '+sectionText;
        node.setAttribute('aria-label','Show '+count+' '+severity+' health check'+(count===1?'':'s')+'. By section: '+sectionText+'.');

        if(!(severitySectionHints instanceof HTMLElement))return;
        const group=document.createElement('div');
        group.className='flex flex-wrap items-center gap-1.5';
        const prefix=document.createElement('span');
        prefix.className='mr-0.5 font-black text-[var(--koa-clay)]';
        prefix.textContent=label+':';
        group.appendChild(prefix);

        (sections.length?sections:[{label:'Pages + APIs',selector:'#health-pages-apis',count}]).forEach((section)=>{
          const button=document.createElement('button');
          button.type='button';
          button.className='rounded-full border border-[var(--koa-line)] bg-white px-2.5 py-1 text-[.54rem] font-black uppercase tracking-[.06em] text-[var(--koa-forest)] transition hover:border-[var(--koa-clay)] hover:bg-[var(--koa-ivory)] focus:outline-none focus:ring-2 focus:ring-[var(--koa-clay)]';
          button.textContent=section.label+' · '+section.count+' '+severityCountWord(severity,section.count);
          button.title='Jump to '+section.label;
          button.setAttribute('aria-label','Jump to '+section.label+' with '+section.count+' '+severityCountWord(severity,section.count));
          button.addEventListener('click',(event)=>{
            event.stopPropagation();
            jumpToHealthSection(section.selector);
          });
          group.appendChild(button);
        });
        severitySectionHints.appendChild(group);
        visibleGroups+=1;
      });

      if(severitySectionHints instanceof HTMLElement){
        severitySectionHints.classList.toggle('hidden',visibleGroups===0);
      }
    }

    function renderHealthChecks(){
      results.innerHTML='';
      const onlyFailures=Boolean(failuresOnly?.checked);
      const rows=latestHealthChecks.filter((row)=>{
        const severity=normalizedSeverity(row);
        if(activeRootCause&&String(row?.issueType||'')!==activeRootCause)return false;
        if(activeSeverity&&severity!==activeSeverity)return false;
        if(onlyFailures&&severity==='healthy')return false;
        return true;
      });
      renderActiveHealthFilter(rows.length);
      if(!rows.length){
        const message=activeRootCause
          ? 'No health checks currently match '+activeRootCause+'.'
          : onlyFailures
            ? 'No failing or warning checks in the current snapshot.'
            : 'No current health checks are available.';
        const empty=document.createElement('p');
        empty.className='text-sm text-[var(--koa-ink)]/50';
        empty.textContent=message;
        results.appendChild(empty);
        return;
      }
      rows.forEach(row=>results.appendChild(healthRow(row)));
    }

    rootCauseButtons.forEach((button)=>button.addEventListener('click',()=>{
      const type=String(button.dataset.rootCauseFilter||'');
      activeRootCause=activeRootCause===type?'':type;
      activeSeverity='';
      if(activeRootCause&&failuresOnly)failuresOnly.checked=false;
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
      results.scrollIntoView({behavior:'smooth',block:'start'});
    }));
    rootCauseClear?.addEventListener('click',()=>{
      activeRootCause='';
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
    });
    activeHealthFilterClear?.addEventListener('click',clearHealthFilters);
    failuresOnly?.addEventListener('change',()=>{
      activeSeverity='';
      if(failuresOnly.checked)activeRootCause='';
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
    });
    healthDetailClose?.addEventListener('click',()=>healthDetailDialog.close());
    healthDetailDialog?.addEventListener('click',(event)=>{if(event.target===healthDetailDialog)healthDetailDialog.close();});

    function expandHealthSectionsForSeverities(severities){
      const requested=new Set((Array.isArray(severities)?severities:[]).map(String));
      const sectionStatuses=new Set();
      if(requested.has('critical'))sectionStatuses.add('red');
      if(requested.has('warning'))sectionStatuses.add('yellow');
      document.querySelectorAll('[data-mobile-collapsible]').forEach((section)=>{
        if(!(section instanceof HTMLElement))return;
        if(sectionStatuses.has(String(section.dataset.healthSectionStatus||''))){
          setMobileCollapsed(section,false,true);
        }
      });
      const resultsSection=results?.closest?.('[data-mobile-collapsible]');
      if(resultsSection instanceof HTMLElement)setMobileCollapsed(resultsSection,false,true);
      refreshMobileHealthPresentation();
    }

    function focusFirstVisibleHealthCheck(selector,ringClass='ring-red-700'){
      const first=results.querySelector(selector);
      if(!(first instanceof HTMLElement)){
        jumpToHealthSection('#health-pages-apis');
        return;
      }
      first.scrollIntoView({behavior:'smooth',block:'center'});
      window.setTimeout(()=>{
        first.focus({preventScroll:true});
        first.classList.add('ring-2',ringClass,'ring-offset-2');
        window.setTimeout(()=>first.classList.remove('ring-2',ringClass,'ring-offset-2'),1800);
      },450);
    }

    function showFailedChecks(){
      activeRootCause='';
      activeSeverity='';
      if(failuresOnly)failuresOnly.checked=true;
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
      expandHealthSectionsForSeverities(['critical','warning','info']);
      focusFirstVisibleHealthCheck('[data-health-severity="critical"], [data-health-severity="warning"], [data-health-severity="info"]');
    }

    function showChecksForSeverity(severity){
      const normalized=['critical','warning','info'].includes(String(severity))?String(severity):'';
      if(!normalized)return;
      activeRootCause='';
      activeSeverity=normalized;
      if(failuresOnly)failuresOnly.checked=false;
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
      expandHealthSectionsForSeverities([normalized]);
      const ringClass=normalized==='critical'?'ring-red-700':normalized==='warning'?'ring-amber-700':'ring-sky-700';
      focusFirstVisibleHealthCheck('[data-health-severity="'+normalized+'"]',ringClass);
    }

    overallAction?.addEventListener('click',showFailedChecks);
    failedCard?.addEventListener('click',showFailedChecks);
    severityFilterButtons.forEach((button)=>button.addEventListener('click',()=>{
      showChecksForSeverity(String(button.dataset.severityFilter||''));
    }));


    function showHealthyChecks(){
      activeRootCause='';
      activeSeverity='';
      if(failuresOnly)failuresOnly.checked=false;
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
      const firstHealthy=results.querySelector('[data-health-severity="healthy"]');
      if(!(firstHealthy instanceof HTMLElement)){
        jumpToHealthSection('#health-pages-apis');
        return;
      }
      firstHealthy.scrollIntoView({behavior:'smooth',block:'center'});
      window.setTimeout(()=>{
        firstHealthy.focus({preventScroll:true});
        firstHealthy.classList.add('ring-2','ring-emerald-700','ring-offset-2');
        window.setTimeout(()=>firstHealthy.classList.remove('ring-2','ring-emerald-700','ring-offset-2'),1800);
      },450);
    }

    const mobileHealthQuery=window.matchMedia('(max-width: 767px)');
    const healthExpandedSessionKey='koa-system-health-expanded-v1';
    let healthSectionStatusesReady=false;
    let latestHealthyCheckAt='';
    let latestHealthSnapshot=null;

    function readExpandedHealthSections(){
      try{
        const stored=JSON.parse(sessionStorage.getItem(healthExpandedSessionKey)||'[]');
        return new Set(Array.isArray(stored)?stored.map(String).filter(Boolean):[]);
      }catch{return new Set();}
    }

    const expandedHealthSections=readExpandedHealthSections();

    function healthSectionSessionId(section){
      if(!(section instanceof HTMLElement))return '';
      return String(section.id||section.dataset.mobileOrder||'').trim();
    }

    function rememberHealthSection(section,expanded){
      const id=healthSectionSessionId(section);
      if(!id)return;
      if(expanded)expandedHealthSections.add(id);
      else expandedHealthSections.delete(id);
      try{sessionStorage.setItem(healthExpandedSessionKey,JSON.stringify([...expandedHealthSections]));}catch{}
    }

    function isHealthSectionRememberedOpen(section){
      const id=healthSectionSessionId(section);
      return Boolean(id&&expandedHealthSections.has(id));
    }

    function setMobileCollapsed(section,collapsed,persist=false){
      if(!(section instanceof HTMLElement))return;
      if(mobileHealthQuery.matches&&collapsed&&section.dataset.healthSectionStatus==='red')collapsed=false;
      const content=[...section.children].filter((child,index)=>index>0&&!(child instanceof HTMLButtonElement&&child.hasAttribute('data-mobile-collapse-toggle')));
      content.forEach((child)=>child.classList.toggle('koa-mobile-collapsed-content',collapsed));
      section.dataset.mobileCollapsed=collapsed?'true':'false';
      const toggleButton=section.querySelector('[data-mobile-collapse-toggle]');
      if(toggleButton instanceof HTMLButtonElement){
        toggleButton.setAttribute('aria-expanded',collapsed?'false':'true');
        const label=toggleButton.querySelector('[data-health-toggle-label]');
        if(label)label.textContent=collapsed?'Expand':'Collapse';
      }
      if(persist&&section.dataset.healthSectionStatus!=='red'){
        rememberHealthSection(section,!collapsed);
      }
    }

    function setHealthSectionStatus(section,status,count=0,summary=''){
      if(!(section instanceof HTMLElement))return;
      const normalized=['red','yellow','green'].includes(status)?status:'green';
      const previous=String(section.dataset.healthSectionStatus||'');
      section.dataset.healthSectionStatus=normalized;
      const badge=section.querySelector('[data-health-section-status-badge]');
      if(!(badge instanceof HTMLElement))return;
      const map={
        red:['Critical','bg-red-100 text-red-800 border-red-200'],
        yellow:['Warning','bg-amber-100 text-amber-900 border-amber-200'],
        green:['Good','bg-emerald-100 text-emerald-800 border-emerald-200'],
      };
      const selected=map[normalized]||map.green;
      badge.className='inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[.56rem] font-black uppercase tracking-[.07em] '+selected[1];
      badge.textContent=selected[0]+(count>0?' · '+count:'');
      const summaryNode=section.querySelector('[data-health-section-summary]');
      if(summaryNode instanceof HTMLElement){
        summaryNode.textContent=String(summary||'');
        summaryNode.classList.toggle('hidden',!summary);
        const title=String(section.querySelector('h2,h3')?.textContent||'System Health section').trim();
        summaryNode.setAttribute('aria-label','Expand '+title+(summary?': '+summary:''));
      }
      if(mobileHealthQuery.matches&&section.dataset.mobileCollapsible==='true'){
        if(normalized==='red'){
          setMobileCollapsed(section,false);
        }else if(isHealthSectionRememberedOpen(section)){
          setMobileCollapsed(section,false);
        }else if(!previous||previous!==normalized){
          setMobileCollapsed(section,true);
        }
      }
    }

    function prepareMobileCollapsible(section){
      if(!(section instanceof HTMLElement))return;
      section.dataset.mobileCollapsible='true';
      if(section.dataset.mobileCollapseReady==='true')return;
      const header=section.firstElementChild;
      if(!(header instanceof HTMLElement))return;
      const controls=document.createElement('div');
      controls.className='health-section-mobile-controls';
      const badge=document.createElement('span');
      badge.dataset.healthSectionStatusBadge='';
      const button=document.createElement('button');
      button.type='button';
      button.dataset.mobileCollapseToggle='';
      button.className='health-mobile-detail-toggle';
      button.setAttribute('aria-expanded','false');
      button.innerHTML='<span data-health-toggle-label>Expand</span><span aria-hidden="true">⌄</span>';
      button.addEventListener('click',(event)=>{
        event.stopPropagation();
        setMobileCollapsed(section,section.dataset.mobileCollapsed!=='true',true);
      });
      const summary=document.createElement('button');
      summary.type='button';
      summary.dataset.healthSectionSummary='';
      summary.className='health-section-mobile-summary hidden';
      summary.addEventListener('click',(event)=>{
        event.stopPropagation();
        if(section.dataset.mobileCollapsed==='true')setMobileCollapsed(section,false,true);
      });
      controls.append(badge,button,summary);
      header.appendChild(controls);
      header.classList.add('health-section-mobile-header');
      header.addEventListener('click',(event)=>{
        if(!mobileHealthQuery.matches)return;
        const target=event.target;
        if(target instanceof Element&&target.closest('a,button,input,select,textarea,label'))return;
        setMobileCollapsed(section,section.dataset.mobileCollapsed!=='true',true);
      });
      section.dataset.mobileCollapseReady='true';
      setHealthSectionStatus(section,'green',0);
      setMobileCollapsed(section,mobileHealthQuery.matches);
    }


    function ensureAllSystemsGoodBanner(){
      if(!(app instanceof HTMLElement))return null;
      let banner=app.querySelector('[data-health-all-good]');
      if(banner instanceof HTMLElement)return banner;
      banner=document.createElement('section');
      banner.dataset.healthAllGood='';
      banner.dataset.mobileOrder='1';
      banner.className='health-all-good-banner hidden';
      const toggle=document.createElement('button');
      toggle.type='button';
      toggle.dataset.healthAllGoodToggle='';
      toggle.className='health-all-good-toggle';
      toggle.setAttribute('aria-expanded','false');
      toggle.innerHTML='<span class="health-all-good-dot" aria-hidden="true"></span><strong data-health-all-good-copy>All systems good</strong><span class="health-all-good-chevron" aria-hidden="true">⌄</span>';
      const detail=document.createElement('div');
      detail.dataset.healthAllGoodDetail='';
      detail.className='health-all-good-detail hidden';
      detail.innerHTML='<div><span>Passed</span><strong data-health-all-good-passed>—</strong></div><div><span>Duration</span><strong data-health-all-good-duration>—</strong></div><div><span>Verified</span><strong data-health-all-good-verified>—</strong></div><div><span>Verification source</span><strong data-health-all-good-source>—</strong></div>';
      toggle.addEventListener('click',()=>{
        const expanded=toggle.getAttribute('aria-expanded')==='true';
        toggle.setAttribute('aria-expanded',expanded?'false':'true');
        detail.classList.toggle('hidden',expanded);
      });
