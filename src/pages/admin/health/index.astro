    function renderOffice365Trend(rows){
      if(!office365Trend)return;
      const data=Array.isArray(rows)?rows:[];
      if(!data.length){office365Trend.innerHTML='<p class="text-xs text-[var(--koa-ink)]/45">No sync trend history is available yet.</p>';return;}
      const width=900,height=250,padL=38,padR=20,padT=18,padB=34;
      const plotW=width-padL-padR,plotH=height-padT-padB;
      const maxCount=Math.max(1,...data.map((row)=>Math.max(Number(row.conflictRuns||0),Number(row.authenticationFailures||0))));
      const x=(index)=>padL+(data.length===1?plotW/2:index*(plotW/(data.length-1)));
      const yRate=(rate)=>padT+plotH-(Math.max(0,Math.min(100,Number(rate??0)))/100)*plotH;
      const yCount=(count)=>padT+plotH-(Math.max(0,Number(count||0))/maxCount)*(plotH*.35);
      const successPoints=data.filter((row)=>row.successRate!=null).map((row,index)=>{
        const actualIndex=data.indexOf(row);return x(actualIndex)+','+yRate(row.successRate);
      }).join(' ');
      let svg='<svg viewBox="0 0 '+width+' '+height+'" class="min-w-[760px] w-full" role="img" aria-label="Office 365 daily reliability trend">';
      [0,25,50,75,100].forEach((rate)=>{
        const y=yRate(rate);svg+='<line x1="'+padL+'" y1="'+y+'" x2="'+(width-padR)+'" y2="'+y+'" stroke="currentColor" opacity=".08"/><text x="4" y="'+(y+4)+'" font-size="10" fill="currentColor" opacity=".45">'+rate+'%</text>';
      });
      data.forEach((row,index)=>{
        const xx=x(index),barW=Math.max(4,Math.min(10,plotW/data.length*.28));
        const cy=yCount(row.conflictRuns),ay=yCount(row.authenticationFailures);
        const base=padT+plotH;
        if(Number(row.conflictRuns||0)>0)svg+='<rect x="'+(xx-barW-1)+'" y="'+cy+'" width="'+barW+'" height="'+(base-cy)+'" rx="2" fill="#c58a3a" opacity=".72"/>';
        if(Number(row.authenticationFailures||0)>0)svg+='<rect x="'+(xx+1)+'" y="'+ay+'" width="'+barW+'" height="'+(base-ay)+'" rx="2" fill="#991b1b" opacity=".72"/>';
        if(index%5===0||index===data.length-1)svg+='<text x="'+xx+'" y="'+(height-10)+'" text-anchor="middle" font-size="9" fill="currentColor" opacity=".45">'+String(row.date||'').slice(5)+'</text>';
      });
      if(successPoints)svg+='<polyline points="'+successPoints+'" fill="none" stroke="#24483b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>';
      data.forEach((row,index)=>{if(row.successRate!=null)svg+='<circle cx="'+x(index)+'" cy="'+yRate(row.successRate)+'" r="2.5" fill="#24483b"><title>'+row.date+': '+row.successRate+'% success, '+Number(row.conflictRuns||0)+' conflict runs, '+Number(row.authenticationFailures||0)+' auth failures</title></circle>';});
      svg+='</svg>';
      office365Trend.innerHTML=svg;
    }

    function renderCoverage(coverage){
      const summary=coverage||{};
      const pages=Number(summary.pages||0);
      const apis=Number(summary.apis||0);
      const integrations=Number(summary.integrations||0);
      const total=Number(summary.total||0);
      const monitored=Number(summary.monitored||0);
      const percent=Number(summary.percent||0);
      if(coveragePages)coveragePages.textContent=String(pages);
      if(coverageApis)coverageApis.textContent=String(apis);
      if(coverageIntegrations)coverageIntegrations.textContent=String(integrations);
      if(coveragePercent){
        coveragePercent.textContent=(Number.isFinite(percent)?percent:0).toFixed(percent%1?1:0)+'%';
        coveragePercent.className='display mt-2 block text-3xl '+(percent>=100?'text-emerald-800':percent>=90?'text-amber-800':'text-red-800');
      }
      if(coverageBadge){
        coverageBadge.textContent=percent>=100?'100% monitored':'Coverage gap';
        coverageBadge.className='rounded-full px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] '+(percent>=100?'bg-emerald-100 text-emerald-800':'bg-amber-100 text-amber-800');
      }
      if(coverageDetail){
        coverageDetail.textContent=total
          ? pages+' pages · '+apis+' APIs · '+integrations+' integration checks · '+monitored+' of '+total+' registered checks present in the latest snapshot.'
          : 'Coverage inventory is not available yet.';
      }
    }

    function compactAge(seconds){
      const value=Number(seconds);
      if(!Number.isFinite(value)||value<0)return 'Age unavailable';
      if(value<60)return Math.floor(value)+'s old';
      const minutes=Math.floor(value/60);
      if(minutes<60)return minutes+'m old';
      const hours=Math.floor(minutes/60);
      if(hours<48)return hours+'h '+(minutes%60)+'m old';
      const days=Math.floor(hours/24);
      if(days<90)return days+'d '+(hours%24)+'h old';
      const months=Math.floor(days/30);
      return months+'mo '+(days%30)+'d old';
    }

    function renderCriticalIntegrations(summary,rollbackReady={},runtime={}){
      const data=summary||{};
      const healthyCount=Number(data.healthyCount||0);
      const totalCount=Number(data.totalCount||4);
      const healthy=Boolean(data.healthy)&&healthyCount===totalCount;
      const liveCount=Number(data.liveCount||0);
      const cachedCount=Number(data.cachedCount||0);
      if(criticalIntegrationsStatus){
        criticalIntegrationsStatus.textContent=healthy?'Healthy':'Attention';
        criticalIntegrationsStatus.className='rounded-full px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] '+(healthy?'bg-emerald-100 text-emerald-800':'bg-red-100 text-red-800');
      }
      if(criticalIntegrationsCount){
        criticalIntegrationsCount.textContent=healthyCount+'/'+totalCount+' healthy';
        criticalIntegrationsCount.className='display mt-2 block text-3xl '+(healthy?'text-emerald-800':'text-red-800');
      }
      if(criticalIntegrationsLastLive)criticalIntegrationsLastLive.textContent=data.lastLiveVerification?new Date(data.lastLiveVerification).toLocaleString():'No live verification';
      if(criticalIntegrationsSource){
        criticalIntegrationsSource.textContent=liveCount+' live · '+cachedCount+' cached';
        criticalIntegrationsSource.className='mt-2 block text-sm '+(cachedCount?'text-amber-800':'text-emerald-800');
      }
      if(criticalIntegrationsOldestCache){
        const oldest=data.oldestCached||null;
        criticalIntegrationsOldestCache.textContent=oldest
          ? String(oldest.name||oldest.id||'Cached probe')+' · '+(oldest.lastLiveCheckedAt?new Date(oldest.lastLiveCheckedAt).toLocaleString():'unknown time')
          : 'None — all results live';
      }
      const rollback=rollbackReady||{};
      const ready=Boolean(rollback.ready&&rollback.targetDeployId&&rollback.targetCommit);
      if(criticalIntegrationsRollbackStatus){
        criticalIntegrationsRollbackStatus.textContent=ready?'Ready':'Unavailable';
        criticalIntegrationsRollbackStatus.className='mt-2 block text-sm font-semibold '+(ready?'text-emerald-800':'text-amber-800');
      }
      if(criticalIntegrationsRollbackTarget){
        criticalIntegrationsRollbackTarget.textContent=ready
          ? 'Deploy '+String(rollback.targetDeployId)+' · Commit '+String(rollback.targetCommit)
          : String(rollback.detail||'No passing rollback target is recorded yet.');
      }
      if(criticalIntegrationsRollbackAge){
        criticalIntegrationsRollbackAge.textContent=ready
          ? 'Known-good release · '+compactAge(rollback.targetAgeSeconds)+(rollback.targetPublishedAt?' · '+new Date(rollback.targetPublishedAt).toLocaleString():'')
          : 'Known-good age · unavailable';
      }
      if(criticalIntegrationsRollbackAccounting){
        const accountingStatus=String(rollback.accountingStatus||'unverified');
        const counts=Number(rollback.accountingDynamicClientCount||0);
        const failed=Number(rollback.accountingDynamicClientFailedCount||0);
        const unverified=Number(rollback.accountingDynamicClientUnverifiedCount||0);
        criticalIntegrationsRollbackAccounting.textContent=accountingStatus==='passed'
          ? 'QuickBooks invariants · passed at release verification'+(counts?' · '+counts+' client'+(counts===1?'':'s')+' checked':'')
          : accountingStatus==='failed'
            ? 'QuickBooks invariants · failed at release verification · '+failed+' failed · '+unverified+' unverified'
            : 'QuickBooks invariants · not recorded for this older release';
        criticalIntegrationsRollbackAccounting.className='mt-1 text-[.62rem] leading-5 '+(
          accountingStatus==='passed'?'text-emerald-800':accountingStatus==='failed'?'text-red-800':'text-amber-800'
        );
      }
      if(criticalIntegrationsDrill){
        const production=String(runtime?.deployContext||'')==='production';
        criticalIntegrationsDrill.disabled=production;
        criticalIntegrationsDrill.textContent=production?'Preview simulation only':'Run safe rollback drill';
        if(criticalIntegrationsDrillMessage&&!criticalIntegrationsDrillMessage.dataset.result){
          criticalIntegrationsDrillMessage.textContent=production
            ? 'Real infrastructure rollback drills run only against the isolated Netlify sandbox through signed CI.'
            : 'Non-production only · no Netlify production restore is attempted.';
        }
      }
      if(criticalIntegrationsDetail){
        const probes=Array.isArray(data.probes)?data.probes:[];
        criticalIntegrationsDetail.textContent=probes.length
          ? probes.map((probe)=>String(probe.name||probe.id||'Probe')+': '+(probe.ok&&Number(probe.status)===204?'healthy':'failed')+' · HTTP '+String(probe.status||'—')+' · '+String(probe.source||'unknown')).join(' | ')
          : 'No Critical Integrations probe data is available yet.';
      }
    }

