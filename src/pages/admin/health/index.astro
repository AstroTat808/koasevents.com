      configureMobileHealthSection(directSections[0],'health-summary',0,false);
      configureMobileHealthSection(document.querySelector('[data-needs-action]'),'health-needs-action',1,true);
      configureMobileHealthSection(document.querySelector('[data-root-cause-summary]'),'health-root-causes',2,true);
      configureMobileHealthSection(findDirectHealthSection('Pages + APIs'),'health-pages-apis',3,true);
      configureMobileHealthSection(document.querySelector('#credential-health'),'credential-health',4,true);
      configureMobileHealthSection(findDirectHealthSection('Email Health'),'health-email',5,true);
      configureMobileHealthSection(findDirectHealthSection('Office 365 calendar sync'),'health-office365',6,true);
      configureMobileHealthSection(findDirectHealthSection('Deployment'),'health-deployment',7,true);
      configureMobileHealthSection(document.querySelector('[data-weekly-executive-summary]'),'health-weekly',8,true);
      configureMobileHealthSection(findDirectHealthSection('Observed outage duration'),'health-incidents',9,true);
      configureMobileHealthSection(findDirectHealthSection('Uptime by service'),'health-uptime',10,true);
      configureMobileHealthSection(findDirectHealthSection('Notifications + public status'),'health-notifications',11,true);
