          'The protected endpoint returned an authentication response exactly as expected for an unauthenticated health probe.',
          'No action is required. The authentication boundary is working as designed.',
        ],
        'Configuration Problem':[
          'The service is reachable, but a required setting, environment value, route contract, or integration configuration is missing or inconsistent.',
          'Correct the named configuration without treating the underlying provider as an outage, then rerun System Health.',
        ],
        'Permission Problem':[
          'The credential or authenticated identity reached the service but does not currently have the access required for this check.',
          'Correct the credential scope, role, consent, or permission. Keep unrelated service-health checks separate so a permission issue does not imply an outage.',
        ],
        'Deployment Problem':[
          'The current production deployment state is preventing a clean verification of the expected release.',
          'Resolve the identified deployment, release-policy, or Git-to-Netlify synchronization state, then rerun the check.',
        ],
        'External Dependency Problem':[
          'An external provider or upstream API could not be verified independently of the Koa application itself.',
          'Confirm the provider response and retry. Treat this separately from an internal application failure unless the provider problem is proven to be caused by Koa configuration.',
        ],
      };
      const defaults=issueDefaults[issueType]||[
        'The monitor received an unexpected response from this service.',
        'Run the check again. If it still fails, inspect the affected service and its most recent deployment or configuration change.',
      ];
      let cause=defaults[0];
      let fix=defaults[1];

      if(deploymentState==='synced'&&row?.deploymentDetails?.fallbackUsed){
        cause='Direct GitHub main metadata was not available to the production function, so the monitor verified the current release from Netlify commit_ref instead.';
        fix='No manual action is required. System Health automatically retries direct GitHub metadata on later checks and returns to full green as soon as GitHub + Netlify verification succeeds.';
      }else if(deploymentState==='deploying'){
        cause='Production is behind main because a Netlify production build is currently running.';
        fix='Wait for the active deploy to finish, then run System Health again. If the deploy fails, open the deploy failure and fix that build error.';
      }else if(deploymentState==='waiting'){
        cause='A new main-branch commit is waiting for Netlify Git auto-deploy to begin within the normal trigger grace period.';
        fix='Give Netlify a few minutes to start the build. If no build appears after the grace period, check the Git-linked site and auto-deploy configuration.';
      }else if(deploymentState==='release-policy-skipped'){
        cause='The newest main-branch commit was intentionally skipped by the production release policy because it was a direct commit without a [release] prefix.';
        fix='For an intentional direct production release, prefix the commit message with [release]. Normal pull-request merges and squash merges are already approved by policy.';
      }else if(deploymentState==='auto-deploy-broken'){
        cause='Git auto-deploy appears stalled or the Netlify site is no longer linked correctly to the production repository/branch.';
        fix='Verify the Netlify site is linked to AstroTat808/koasevents.com, production branch main, and automatic Git deploys are enabled. Then trigger or retry a production deploy.';
      }else if(deploymentState==='deploy-failed'){
        cause='The production deploy associated with the current main commit ended in a failed state.';
        fix='Open the failed Netlify deploy, correct the reported build/runtime error, push the fix, and verify the new production deploy succeeds.';
      }else if(/startup marker missing/i.test(detail)){
        cause='The page returned HTML, but the expected application startup marker was missing. This often means the page shell changed, the client app did not initialize, or the health probe marker is outdated.';
        fix='Open the affected page, confirm it loads for staff, then either fix the page startup error or update the monitor marker if the page structure intentionally changed.';
      }else if(/page request failed/i.test(detail)||status===0){
        cause='The page could not be reached successfully. This can come from a routing, deployment, DNS/CDN, or server-side runtime failure.';
        fix='Verify the route exists in the current production deploy, then inspect the latest deploy logs and any function/edge errors tied to this request.';
      }else if(/unexpected api response/i.test(detail)){
        if(status>=500){
          cause='The API is reachable but returned a server error, indicating a function/runtime exception or an upstream dependency failure.';
          fix='Inspect the corresponding Netlify function logs and the most recent code/configuration changes for this endpoint. Fix the server error, redeploy, and rerun the check.';
        }else if(status===404){
          cause='The monitored API route was not found in production. The route may have moved, been removed, or failed to deploy.';
          fix='Confirm the endpoint path is still correct. Restore the route or update the System Health check if the API was intentionally renamed.';
        }else if(status===429){
          cause='The health probe was rate-limited.';
          fix='Review the endpoint rate-limit rules and allow safe internal health checks without weakening client-facing protections.';
        }else{
          cause='The endpoint responded with a status outside the expected 200/401/403 range.';
          fix='Check the endpoint response and authentication behavior. Restore the expected contract or update the monitor only if the behavior changed intentionally.';
        }
      }else if(/startup failure/i.test(detail)){
        cause='A logged-in staff browser reported that the Business CRM did not initialize successfully on the current release.';
        fix='Open the Business CRM in production, inspect the browser console/network errors, and fix the first startup failure before redeploying.';
      }

      return {cause,fix};
    }

    function openHealthDetail(row){
      if(!row)return;
      const severity=normalizedSeverity(row);
      const explanation=explainHealthIssue(row);
      healthDetailSeverity.textContent=severity==='critical'?'Critical issue':severity==='warning'?'Warning':severity==='info'?'Information':'Healthy';
      healthDetailSeverity.className='eyebrow '+(severity==='critical'?'text-red-800':severity==='warning'?'text-amber-800':severity==='info'?'text-sky-800':'text-emerald-800');
      healthDetailTitle.textContent=String(row.name||'Health check');
      const deploymentDetails=row?.deploymentDetails||null;
      const deploymentMeta=deploymentDetails
        ? [
            deploymentDetails.githubCommit?'GitHub '+String(deploymentDetails.githubCommit).slice(0,12):'',
            deploymentDetails.netlifyDeployId?'Netlify '+String(deploymentDetails.netlifyDeployId).slice(0,12):'',
            deploymentDetails.deployStatus?'Status '+String(deploymentDetails.deployStatus):'',
            deploymentDetails.deployTime?'Deployed '+new Date(deploymentDetails.deployTime).toLocaleString():'',
            typeof deploymentDetails.repositoryPrivate==='boolean'?(deploymentDetails.repositoryPrivate?'Private repo':'Public repo'):'',
            deploymentDetails.verificationSourceLabel?('Verified by '+String(deploymentDetails.verificationSourceLabel)):'',
          ].filter(Boolean).join(' · ')
        : '';
      healthDetailMeta.textContent=[
        String(row.kind||'check')+' · '+String(row.path||'')+' · HTTP '+String(row.status||'—')+' · '+String(row.ms||0)+' ms',
        deploymentMeta,
      ].filter(Boolean).join(' · ');
      if(healthDetailIssueType){
        const issueType=String(row.issueType||'');
        healthDetailIssueType.textContent=issueType;
        healthDetailIssueType.classList.toggle('hidden',!issueType);
      }
      healthDetailError.textContent=String(row.detail||'No additional detail was recorded.');
      if(deploymentDetails){
        const verificationLabel=String(deploymentDetails.verificationSourceLabel||deploymentDetails.verificationSource||'Unverified');
        const githubSource=String(deploymentDetails.githubMetadataSource||'').trim();
        healthDetailVerification.textContent=verificationLabel+(githubSource?' · '+githubSource:'');
        healthDetailVerificationWrap.classList.remove('hidden');
      }else{
        healthDetailVerification.textContent='';
        healthDetailVerificationWrap.classList.add('hidden');
      }
      healthDetailCause.textContent=explanation.cause;
      healthDetailFix.textContent=explanation.fix;
      healthDetailDialog.showModal();
    }

    function healthRow(row){
      const severity=normalizedSeverity(row);
      const palette=severity==='critical'
        ? 'border-red-200 bg-red-50'
        : severity==='warning'
          ? 'border-amber-200 bg-amber-50'
          : severity==='info'
            ? 'border-sky-200 bg-sky-50'
            : 'border-emerald-200 bg-emerald-50';
      const badgePalette=severity==='critical'
        ? 'bg-red-800 text-white'
        : severity==='warning'
          ? 'bg-amber-700 text-white'
          : severity==='info'
            ? 'bg-sky-700 text-white'
            : 'bg-emerald-800 text-white';
      const badgeText=severity==='critical'?'Critical':severity==='warning'?'Warning':severity==='info'?'Info':'Healthy';
      const card=document.createElement('button');
      card.type='button';
      card.className='rounded-xl border '+palette+' p-4 text-left transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--koa-clay)]';
      card.dataset.healthOk=row.ok?'true':'false';
      card.dataset.healthSeverity=severity;
      card.addEventListener('click',()=>openHealthDetail(row));
      const top=document.createElement('div');top.className='flex items-start justify-between gap-4';
      const left=document.createElement('div');
      const title=document.createElement('h3');title.className='font-semibold text-[var(--koa-forest)]';title.textContent=row.name;
      const meta=document.createElement('p');meta.className='mt-1 break-all text-xs text-[var(--koa-ink)]/48';meta.textContent=row.kind+' · '+row.path;
      left.append(title,meta);
      if(row.issueType){
        const type=document.createElement('span');
        type.className='mt-2 inline-flex rounded-full bg-white/75 px-2.5 py-1 text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]';
        type.textContent=String(row.issueType);
        left.appendChild(type);
      }
      const badge=document.createElement('span');badge.className='shrink-0 rounded-full px-3 py-1 text-[.58rem] font-black uppercase tracking-[.08em] '+badgePalette;badge.textContent=badgeText;
      top.append(left,badge);
      const detail=document.createElement('p');detail.className='mt-3 text-xs leading-5 text-[var(--koa-ink)]/60';detail.textContent='HTTP '+(row.status||'—')+' · '+row.ms+' ms · '+(row.detail||'');
      const more=document.createElement('p');more.className='mt-3 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]';more.textContent='Open explanation →';
      card.append(top,detail,more);return card;
    }

    function renderRootCauseSummary(rows){
      const counts=(Array.isArray(rows)?rows:[]).reduce((acc,row)=>{
        const type=String(row?.issueType||'');
        if(type)acc[type]=(acc[type]||0)+1;
        return acc;
      },{});
      rootCauseButtons.forEach((button)=>{
        const type=String(button.dataset.rootCauseFilter||'');
        const count=Number(counts[type]||0);
        const countNode=button.querySelector('[data-root-cause-count]');
        if(countNode)countNode.textContent=String(count);
        const active=activeRootCause===type;
        button.disabled=count===0;
        button.setAttribute('aria-pressed',String(active));
        button.className='rounded-xl border p-4 text-left transition disabled:cursor-default disabled:opacity-45 '+(
          active
            ? 'border-[var(--koa-forest)] bg-[var(--koa-forest)] text-white shadow-md'
            : 'border-[var(--koa-line)] bg-[var(--koa-ivory)] text-[var(--koa-forest)] hover:border-[var(--koa-clay)]'
        );
      });
      rootCauseClear?.classList.toggle('hidden',!activeRootCause);
    }

    function renderHealthChecks(){
      results.innerHTML='';
      const onlyFailures=Boolean(failuresOnly?.checked);
      const rows=latestHealthChecks.filter((row)=>{
        if(activeRootCause&&String(row?.issueType||'')!==activeRootCause)return false;
        if(onlyFailures&&normalizedSeverity(row)==='healthy')return false;
        return true;
      });
      if(!rows.length){
        const message=activeRootCause
          ? 'No health checks currently match '+activeRootCause+'.'
          : onlyFailures
            ? 'No failing or warning checks in the current snapshot.'
            : 'No current health checks are available.';
        const empty=document.createElement('p');
        empty.className='text-sm text-[var(--koa-ink)]/50';
        empty.textContent=message;
        results.appendChild(empty);
        return;
      }
      rows.forEach(row=>results.appendChild(healthRow(row)));
    }

    rootCauseButtons.forEach((button)=>button.addEventListener('click',()=>{
      const type=String(button.dataset.rootCauseFilter||'');
      activeRootCause=activeRootCause===type?'':type;
      if(activeRootCause&&failuresOnly)failuresOnly.checked=false;
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
      results.scrollIntoView({behavior:'smooth',block:'start'});
    }));
    rootCauseClear?.addEventListener('click',()=>{
      activeRootCause='';
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
    });
    failuresOnly?.addEventListener('change',()=>{
      if(failuresOnly.checked)activeRootCause='';
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
    });
    healthDetailClose?.addEventListener('click',()=>healthDetailDialog.close());
    healthDetailDialog?.addEventListener('click',(event)=>{if(event.target===healthDetailDialog)healthDetailDialog.close();});

    function showFailedChecks(){
      activeRootCause='';
      if(failuresOnly)failuresOnly.checked=true;
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
      const failedChecks=[...results.querySelectorAll('[data-health-ok="false"]')];
      if(!failedChecks.length)return;
      const firstFailure=failedChecks[0];
      firstFailure.scrollIntoView({behavior:'smooth',block:'center'});
      window.setTimeout(()=>{
        firstFailure.focus({preventScroll:true});
        firstFailure.classList.add('ring-2','ring-red-700','ring-offset-2');
        window.setTimeout(()=>firstFailure.classList.remove('ring-2','ring-red-700','ring-offset-2'),1800);
      },450);
    }

    overallCard?.addEventListener('click',showFailedChecks);
    failedCard?.addEventListener('click',showFailedChecks);

    function formatDuration(minutes){
      const value=Math.max(0,Number(minutes||0));
      const days=Math.floor(value/1440);
      const hours=Math.floor((value%1440)/60);
      const mins=Math.round(value%60);
      const parts=[];
      if(days)parts.push(days+'d');
      if(hours)parts.push(hours+'h');
      if(mins||!parts.length)parts.push(mins+'m');
      return parts.join(' ');
    }

    function renderReleaseTimeline(){
      releaseTimeline.innerHTML='';
      const term=String(releaseSearch?.value||'').trim().toLowerCase();
      const category=String(releaseFilter?.value||'all');
      const releases=latestReleases.filter((release)=>{
        const haystack=[
          release.commitTitle,release.commitMessage,release.commit,release.deployId,release.summary,
          release.authorName,release.authorLogin,release.pullRequestNumber,release.pullRequestUrl,
          ...(release.features||[]),...(release.changedFiles||[])
        ].join(' ').toLowerCase();
        const termOk=!term||haystack.includes(term);
        const features=new Set(release.features||[]);
        const categoryOk=
          category==='all' ||
          (category==='crm' && (features.has('Business CRM')||features.has('Sales CRM & Proposals'))) ||
          (category==='quickbooks' && features.has('QuickBooks')) ||
          (category==='website' && ['Public Website','Blog','Gallery','Local SEO'].some(value=>features.has(value))) ||
          (category==='security' && ['Authentication & Security','System Health'].some(value=>features.has(value))) ||
          (category==='vendor' && ['Vendor CRM','Insurance Compliance'].some(value=>features.has(value))) ||
          (category==='users' && features.has('User Management'));
        return termOk&&categoryOk;
      });
      releases.forEach((release)=>{
        const index=latestReleases.indexOf(release);
        const button=document.createElement('button');
        button.type='button';
        button.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)]';
        const qaLabel=release.qa?.conclusion==='success'?'QA passed':release.qa?.conclusion==='failure'?'QA failed':'QA unavailable';
        const incidentCount=(release.incidents||[]).length;
        button.innerHTML='<div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Release '+(index+1)+'</p><strong class="mt-1 block text-sm text-[var(--koa-forest)]"></strong><p class="mt-1 break-all text-xs text-[var(--koa-ink)]/45"></p></div><span class="rounded-full px-3 py-1 text-[.56rem] font-black uppercase tracking-[.06em] '+(release.qa?.conclusion==='success'?'bg-emerald-100 text-emerald-800':release.qa?.conclusion==='failure'?'bg-red-100 text-red-800':'bg-[var(--koa-sand)] text-[var(--koa-forest)]')+'">'+qaLabel+'</span></div><p data-release-summary class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/65"></p><p data-release-meta class="mt-2 text-xs text-[var(--koa-ink)]/55"></p>';
        button.querySelector('strong').textContent=release.commitTitle||'Production release';
        button.querySelector('p.text-xs').textContent=(release.commit||'').slice(0,12)+' · '+(release.deployId||'');
        button.querySelector('[data-release-summary]').textContent=release.summary||'Release summary not recorded yet.';
        const author=release.authorLogin?'@'+release.authorLogin:(release.authorName||'Unknown author');
        const pr=release.pullRequestNumber?'PR #'+release.pullRequestNumber:'No PR linked';
        button.querySelector('[data-release-meta]').textContent=author+' · '+pr+' · '+(release.publishedAt?new Date(release.publishedAt).toLocaleString():'Unknown deployment time')+' · '+(release.deployDurationSeconds==null?'duration unavailable':release.deployDurationSeconds+'s deploy')+' · '+incidentCount+' incident'+(incidentCount===1?'':'s')+' began';
        button.addEventListener('click',()=>showRelease(release));
        releaseTimeline.appendChild(button);
      });
      if(!releases.length)releaseTimeline.innerHTML='<p class="text-sm text-[var(--koa-ink)]/50">No releases match the current search/filter.</p>';
    }

    function populateCompareSelectors(){
      const currentBase=compareBase.value;
      const currentHead=compareHead.value;
      const options=latestReleases.map((release,index)=>'<option value="'+release.commit+'">'+(index+1)+'. '+(release.commitTitle||'Production release')+' · '+String(release.commit||'').slice(0,8)+'</option>').join('');
      compareBase.innerHTML='<option value="">Older release</option>'+options;
      compareHead.innerHTML='<option value="">Newer release</option>'+options;
      if(latestReleases.length>=2){
        compareBase.value=currentBase||latestReleases[1].commit;
        compareHead.value=currentHead||latestReleases[0].commit;
      }
    }

    function showComparison(comparison){
      compareDetail.innerHTML='';
      compareTitle.textContent='Release comparison';
      const stats=document.createElement('section');stats.className='grid gap-3 sm:grid-cols-4';
      [
        ['Commits',String(comparison.totalCommits||0)],
        ['Files',String((comparison.files||[]).length)],
        ['Additions',String((comparison.files||[]).reduce((sum,file)=>sum+Number(file.additions||0),0))],
        ['Deletions',String((comparison.files||[]).reduce((sum,file)=>sum+Number(file.deletions||0),0))],
      ].forEach(([label,value])=>{
        const card=document.createElement('div');card.className='rounded-xl bg-[var(--koa-sand)] p-4';
        card.innerHTML='<p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]"></p><p class="mt-2 text-lg font-semibold text-[var(--koa-forest)]"></p>';
        card.children[0].textContent=label;card.children[1].textContent=value;stats.appendChild(card);
      });
      compareDetail.appendChild(stats);

      const risks=document.createElement('section');
      const riskLevel=String(comparison.riskLevel||'low');
      risks.className='rounded-xl border '+(riskLevel==='high'?'border-red-200 bg-red-50':riskLevel==='medium'?'border-amber-200 bg-amber-50':'border-emerald-200 bg-emerald-50')+' p-4';
      risks.innerHTML='<div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-[.56rem] font-black uppercase tracking-[.09em] '+(riskLevel==='high'?'text-red-700':riskLevel==='medium'?'text-amber-800':'text-emerald-800')+'">Potentially risky changes</p><p class="mt-1 text-sm font-semibold text-[var(--koa-forest)]">'+(riskLevel==='high'?'High review attention':riskLevel==='medium'?'Review recommended':'No high-risk categories detected')+'</p></div><span class="rounded-full px-3 py-1 text-[.56rem] font-black uppercase tracking-[.06em] '+(riskLevel==='high'?'bg-red-700 text-white':riskLevel==='medium'?'bg-amber-200 text-amber-950':'bg-emerald-700 text-white')+'">'+riskLevel+'</span></div>';
      const riskList=document.createElement('div');riskList.className='mt-3 grid gap-2';
      (comparison.riskFlags||[]).forEach((flag)=>{
        const row=document.createElement('details');row.className='rounded-lg border border-black/10 bg-white/70 p-3';
        row.innerHTML='<summary class="cursor-pointer text-sm font-semibold text-[var(--koa-forest)]"></summary><p class="mt-2 text-xs text-[var(--koa-ink)]/55"></p>';
        row.querySelector('summary').textContent=flag.label+' · '+String(flag.severity||'').toUpperCase();
        const pieces=[];
        if((flag.files||[]).length)pieces.push('Files: '+flag.files.join(', '));
        if((flag.commits||[]).length)pieces.push('Commits: '+flag.commits.join(' | '));
        row.querySelector('p').textContent=pieces.join(' · ')||'Flagged by release-risk rules.';
        riskList.appendChild(row);
      });
      if(!(comparison.riskFlags||[]).length)riskList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No authentication, payment, CRM deletion, form, security, storage, or environment-variable risk categories were detected.</p>';
      risks.appendChild(riskList);compareDetail.appendChild(risks);

      const features=document.createElement('section');
      features.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Features affected</p>';
      const chips=document.createElement('div');chips.className='mt-3 flex flex-wrap gap-2';
      (comparison.features||[]).forEach((feature)=>{const chip=document.createElement('span');chip.className='rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]';chip.textContent=feature;chips.appendChild(chip);});
      if(!(comparison.features||[]).length)chips.innerHTML='<span class="text-sm text-[var(--koa-ink)]/48">No categorized feature changes.</span>';
      features.appendChild(chips);compareDetail.appendChild(features);

      const behavior=document.createElement('section');
      behavior.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Behavior changes</p>';
      const behaviorList=document.createElement('div');behaviorList.className='mt-3 grid gap-2';
      (comparison.behaviorChanges||[]).forEach((item)=>{const row=document.createElement('div');row.className='rounded-xl border border-[var(--koa-line)] p-3 text-sm text-[var(--koa-forest)]';row.textContent=item;behaviorList.appendChild(row);});
      if(!(comparison.behaviorChanges||[]).length)behaviorList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No commit-level behavior notes were found.</p>';
      behavior.appendChild(behaviorList);compareDetail.appendChild(behavior);

      const files=document.createElement('section');
      files.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Changed files</p>';
      const fileList=document.createElement('div');fileList.className='mt-3 max-h-[420px] overflow-auto rounded-xl border border-[var(--koa-line)]';
      (comparison.files||[]).forEach((file)=>{
        const row=document.createElement('div');row.className='border-b border-[var(--koa-line)] p-3 last:border-b-0';
        row.innerHTML='<div class="flex flex-wrap items-center justify-between gap-3"><code class="text-xs text-[var(--koa-forest)]"></code><span class="text-[.55rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]"></span></div><p class="mt-1 text-xs text-[var(--koa-ink)]/48"></p>';
        row.querySelector('code').textContent=file.filename;
        row.querySelector('span').textContent=file.status||'changed';
        row.querySelector('p').textContent='+'+Number(file.additions||0)+' / -'+Number(file.deletions||0)+' · '+Number(file.changes||0)+' total changes';
        fileList.appendChild(row);
      });
      if(!(comparison.files||[]).length)fileList.innerHTML='<p class="p-4 text-sm text-[var(--koa-ink)]/48">No file differences.</p>';
      files.appendChild(fileList);compareDetail.appendChild(files);
      compareDialog.showModal();
    }

    function showRelease(release){
      releaseTitle.textContent=release.commitTitle||'Production release';
      releaseDetail.innerHTML='';

      const summary=document.createElement('section');
      summary.className='rounded-xl bg-[var(--koa-sand)] p-4';
      const commitMessage=String(release.commitMessage||release.commitTitle||'No commit message recorded.');
      summary.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Commit</p><p class="mt-2 whitespace-pre-wrap font-semibold text-[var(--koa-forest)]"></p><p class="mt-3 break-all text-xs text-[var(--koa-ink)]/48"></p>';
      summary.querySelector('p.mt-2').textContent=commitMessage;
      summary.querySelector('p.mt-3').textContent='Commit '+(release.commit||'Unavailable')+' · Deploy '+(release.deployId||'Unavailable');
      releaseDetail.appendChild(summary);

      const releaseSummary=document.createElement('section');
      releaseSummary.className='rounded-xl border border-[var(--koa-line)] p-4';
      releaseSummary.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">What changed</p><p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/68"></p><div class="mt-3 flex flex-wrap gap-3 text-xs text-[var(--koa-ink)]/50"><span data-author></span><a data-pr class="hidden underline decoration-dotted underline-offset-4" target="_blank" rel="noopener noreferrer"></a></div>';
      releaseSummary.querySelector('p.mt-2').textContent=release.summary||'A plain-English release summary was not recorded for this deployment.';
