          const actualPath=pathFor(actual);
          if(actualPath){
            const path=make('path',{d:actualPath,fill:'none',stroke:'var(--koa-forest)','stroke-width':'3','stroke-linecap':'round','stroke-linejoin':'round'});
            creditChart.appendChild(path);
          }
          const projectedPath=pathFor(projected);
          if(projectedPath){
            const path=make('path',{d:projectedPath,fill:'none',stroke:'var(--koa-clay)','stroke-width':'3','stroke-linecap':'round','stroke-linejoin':'round','stroke-dasharray':'8 6'});
            creditChart.appendChild(path);
