          const savings=document.createElement('p');
          savings.className='mt-2 text-[.65rem] leading-5 text-[var(--koa-ink)]/45';
          savings.textContent='Estimated future savings from Normal: Saver '+String(item.saverSavingsPerDay??0)+' credits/day · Paused '+String(item.pausedSavingsPerDay??0)+' credits/day. '+String(item.protects||'');
          row.append(top,savings);
          creditJobControls.appendChild(row);
