          }
          button.textContent=(suggested?'Review & apply ':'Apply ')+String(preset.name||'preset');
          card.append(title,description,list,caution,button);
          creditPresets.appendChild(card);
        });
      }

      const learning=creditUsage.saverLearning||{};
      if(creditLearningFactor){
        const factor=Number(learning.calibrationFactor||1);
        creditLearningFactor.textContent='Calibration '+factor.toFixed(2)+'×';
      }
      if(creditLearningCount){
        const count=Number(learning.validMeasurementCount||0);
        creditLearningCount.textContent=count
          ? count+' completed clean measurement window'+(count===1?'':'s')
          : 'No completed clean windows yet';
      }
      if(creditLearningActive){
        const active=learning.liveMeasurement;
        if(active){
          const status=String(active.status||'measuring');
          if(status==='invalid'){
            creditLearningActive.className='mt-4 rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs leading-5 text-amber-900';
            creditLearningActive.textContent='Measurement excluded: '+String(active.invalidReason||'the observation window was contaminated.');
          }else if(status==='completed'){
