    function renderEmailHealth(summary,current){
      const email=summary||{};
      const releaseCheck=(current?.checks||[]).find((row)=>row.id==='email-release-sync')||null;
      const releaseSeverity=String(releaseCheck?.severity||'green');
      const releaseDetails=releaseCheck?.deploymentDetails||{};
      let overallState=String(email.overall||'yellow');
      if(releaseSeverity==='red')overallState='red';
      else if(releaseSeverity==='yellow'&&overallState==='green')overallState='yellow';
      const overallMap={
        green:['Healthy','bg-emerald-100 text-emerald-800'],
        yellow:['Attention','bg-amber-100 text-amber-900'],
        red:['Critical','bg-red-100 text-red-800'],
      };
      const overallChoice=overallMap[overallState]||overallMap.yellow;
      if(emailHealthOverall){
        emailHealthOverall.textContent=overallChoice[0];
        emailHealthOverall.className='rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+overallChoice[1];
      }

      const logo=email.logo||{};
      if(emailHealthLogo){
        emailHealthLogo.textContent=logo.ok?'Available':'Unavailable';
        emailHealthLogo.className='mt-2 text-sm font-semibold '+(logo.ok?'text-emerald-800':'text-red-800');
      }
      if(emailHealthLogoDetail)emailHealthLogoDetail.textContent=(logo.status?'HTTP '+logo.status+' · ':'')+(logo.contentType||'')+(logo.ms!=null?' · '+logo.ms+' ms':'');

      const sendAccess=email.sendAccess||{};
      if(emailHealthSend){
        emailHealthSend.textContent=sendAccess.ok?'Available':'Unavailable';
        emailHealthSend.className='mt-2 text-sm font-semibold '+(sendAccess.ok?'text-emerald-800':'text-red-800');
      }
      if(emailHealthSendDetail)emailHealthSendDetail.textContent=sendAccess.detail||'';

      const monitoringAccess=email.monitoringAccess||{};
      if(emailHealthMonitoring){
        emailHealthMonitoring.textContent=monitoringAccess.reachable?'Available':monitoringAccess.configured?'Permission/configuration issue':'Not configured';
        emailHealthMonitoring.className='mt-2 text-sm font-semibold '+(monitoringAccess.reachable?'text-emerald-800':'text-amber-800');
      }
      if(emailHealthMonitoringDetail)emailHealthMonitoringDetail.textContent=monitoringAccess.detail||'';

      const delivery=email.delivery||{};
      if(emailHealthSource)emailHealthSource.textContent=delivery.source==='resend-api'?'Resend API':delivery.source==='signed-webhook-history'?'Signed webhook history':'No delivery history';
      if(emailHealthSourceDetail){
        const parts=[];
        parts.push(delivery.apiConfigured?'API key configured':'API key missing');
        parts.push(delivery.webhookConfigured?'webhook configured':'webhook missing');
        if(delivery.apiDetail)parts.push(delivery.apiDetail);
        emailHealthSourceDetail.textContent=parts.join(' · ');
      }

      const templates=email.templateCompatibility||{};
      if(emailHealthTemplates){
        emailHealthTemplates.textContent=templates.passed?Number(templates.templateCount||0)+' templates passing':'Compatibility gate failed';
        emailHealthTemplates.className='mt-2 text-sm font-semibold '+(templates.passed?'text-emerald-800':'text-red-800');
      }
      if(emailHealthTemplateDetail)emailHealthTemplateDetail.textContent=templates.detail||'';
      if(emailHealthChecked)emailHealthChecked.textContent=email.generatedAt?new Date(email.generatedAt).toLocaleString():'—';

      if(emailHealthRelease){
        const behind=Boolean(releaseDetails.emailRenderingBehind);
        const commitsBehind=Number(releaseDetails.commitsBehind||0);
        emailHealthRelease.textContent=behind
          ? commitsBehind+' commit'+(commitsBehind===1?'':'s')+' behind'
          : releaseSeverity==='yellow'
            ? 'Verification attention'
            : 'Current';
        emailHealthRelease.className='mt-2 text-sm font-semibold '+(releaseSeverity==='red'?'text-red-800':releaseSeverity==='yellow'?'text-amber-800':'text-emerald-800');
      }
      if(emailHealthReleaseMeta){
        const live=String(releaseDetails.netlifyCommit||'').slice(0,12);
        const main=String(releaseDetails.githubCommit||'').slice(0,12);
        emailHealthReleaseMeta.textContent=(live?'Production '+live:'Production commit unavailable')+(main?' · Main '+main:'');
      }
      if(emailHealthReleaseAlert){
        const show=releaseSeverity==='yellow'||releaseSeverity==='red';
        const changed=Array.isArray(releaseDetails.emailRenderingChangedFiles)?releaseDetails.emailRenderingChangedFiles:[];
        const liveCommit=String(releaseDetails.netlifyCommit||'');
        const mainCommit=String(releaseDetails.githubCommit||'');
        const deployId=String(releaseDetails.netlifyDeployId||'');
        emailHealthReleaseAlert.classList.toggle('hidden',!show);
        emailHealthReleaseAlert.className='mt-5 rounded-[1.2rem] border p-5 '+(show?'':'hidden ')+(releaseSeverity==='red'?'border-red-200 bg-red-50 text-red-900':'border-amber-200 bg-amber-50 text-amber-900');
        if(emailHealthReleaseTitle)emailHealthReleaseTitle.textContent=releaseSeverity==='red'
          ? 'Production is serving an older email renderer.'
          : 'A newer email-rendering release is waiting to reach production.';
        if(emailHealthReleaseDetail){
          emailHealthReleaseDetail.textContent=String(releaseCheck?.detail||'')
            +(changed.length?' Pending email files: '+changed.join(', '):'');
        }
        if(emailHealthReleaseActions){
          emailHealthReleaseActions.innerHTML='';
          if(deployId){
            const deployment=document.createElement('a');
            deployment.href='https://app.netlify.com/projects/koasevents-website/deploys/'+encodeURIComponent(deployId);
            deployment.target='_blank';deployment.rel='noreferrer';
            deployment.className='rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.6rem] font-black uppercase tracking-[.08em] text-white';
            deployment.textContent='Open affected deploy';
            emailHealthReleaseActions.appendChild(deployment);
          }
          const fileRef=mainCommit||liveCommit||'main';
          changed.slice(0,8).forEach((file)=>{
            const link=document.createElement('a');
            link.href='https://github.com/AstroTat808/koasevents.com/blob/'+encodeURIComponent(fileRef)+'/'+String(file).split('/').map(encodeURIComponent).join('/');
            link.target='_blank';link.rel='noreferrer';
            link.className='rounded-full border border-current px-3 py-2 text-[.58rem] font-black uppercase tracking-[.06em]';
            link.textContent=String(file).split('/').pop()||String(file);
            emailHealthReleaseActions.appendChild(link);
          });
        }
      }

      if(emailRendererMatch||emailRendererLive||emailRendererMain||emailRendererDeploy){
        const liveCommit=String(releaseDetails.netlifyCommit||'');
        const mainCommit=String(releaseDetails.githubCommit||'');
        const deployId=String(releaseDetails.netlifyDeployId||'');
        const commitsKnown=Boolean(liveCommit&&mainCommit);
        const match=commitsKnown&&liveCommit===mainCommit;
        if(emailRendererMatch){
          emailRendererMatch.textContent=match?'Matched':commitsKnown?'Behind / different':'Unverified';
          emailRendererMatch.className='w-fit rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+(match?'bg-emerald-100 text-emerald-800':commitsKnown?'bg-red-100 text-red-800':'bg-amber-100 text-amber-900');
        }
        if(emailRendererLive){
          emailRendererLive.textContent=liveCommit?liveCommit.slice(0,12):'Unavailable';
          emailRendererLive.href=liveCommit?'https://github.com/AstroTat808/koasevents.com/commit/'+encodeURIComponent(liveCommit):'#';
          emailRendererLive.classList.toggle('pointer-events-none',!liveCommit);
          emailRendererLive.classList.toggle('no-underline',!liveCommit);
        }
        if(emailRendererMain){
          emailRendererMain.textContent=mainCommit?mainCommit.slice(0,12):'Unavailable';
          emailRendererMain.href=mainCommit?'https://github.com/AstroTat808/koasevents.com/commit/'+encodeURIComponent(mainCommit):'#';
          emailRendererMain.classList.toggle('pointer-events-none',!mainCommit);
          emailRendererMain.classList.toggle('no-underline',!mainCommit);
        }
        if(emailRendererDeploy){
          emailRendererDeploy.textContent=deployId||'Unavailable';
          emailRendererDeploy.href=deployId?'https://app.netlify.com/projects/koasevents-website/deploys/'+encodeURIComponent(deployId):'#';
          emailRendererDeploy.classList.toggle('pointer-events-none',!deployId);
          emailRendererDeploy.classList.toggle('no-underline',!deployId);
        }
        if(emailRendererStatus){
          emailRendererStatus.textContent=match?'Production matches GitHub main':commitsKnown?'Production differs from GitHub main':'Commit comparison unavailable';
          emailRendererStatus.className='mt-2 text-sm font-semibold '+(match?'text-emerald-800':commitsKnown?'text-red-800':'text-amber-800');
        }
        if(emailRendererStatusDetail){
          const behindCount=Number(releaseDetails.commitsBehind||0);
          emailRendererStatusDetail.textContent=match
            ? 'The live email renderer is current.'
            : commitsKnown
              ? (behindCount?behindCount+' commit'+(behindCount===1?'':'s')+' behind.':'The commit identities differ.')
              : 'System Health could not verify both commit identities.';
        }
      }

      const p24=delivery.period24h||{};
      if(emailHealth24Total)emailHealth24Total.textContent=Number(p24.total||0)+' lifecycle events';
      if(emailHealth24Delivered)emailHealth24Delivered.textContent=String(Number(p24.delivered||0));
      if(emailHealth24Bounced)emailHealth24Bounced.textContent=String(Number(p24.bounced||0));
      if(emailHealth24Complained)emailHealth24Complained.textContent=String(Number(p24.complained||0));
      if(emailHealth24Failed)emailHealth24Failed.textContent=String(Number(p24.failed||0)+Number(p24.suppressed||0));
      if(emailHealth24Delayed)emailHealth24Delayed.textContent=String(Number(p24.delayed||0));

      const p7=delivery.period7d||{};
      if(emailHealth7Total)emailHealth7Total.textContent=Number(p7.total||0)+' lifecycle events';
      if(emailHealth7Rate)emailHealth7Rate.textContent=Number(p7.failureRate||0).toFixed(1)+'%';
      if(emailHealth7Bounced)emailHealth7Bounced.textContent=String(Number(p7.bounced||0));
      if(emailHealth7Complained)emailHealth7Complained.textContent=String(Number(p7.complained||0));
      if(emailHealth7Suppressed)emailHealth7Suppressed.textContent=String(Number(p7.suppressed||0));

      if(emailHealthIssues){
        emailHealthIssues.innerHTML='';
        const issues=Array.isArray(delivery.recentIssues)?delivery.recentIssues:[];
        if(!issues.length){
          emailHealthIssues.innerHTML='<p class="text-sm text-emerald-800">No recent bounced, complained, failed, suppressed, or delayed email events were found.</p>';
        }else{
          issues.forEach((issue)=>{
            const row=document.createElement('div');
            const red=['bounced','complained','failed','suppressed'].includes(String(issue.status||''));
            row.className='flex flex-col gap-1 rounded-xl border p-3 sm:flex-row sm:items-center sm:justify-between '+(red?'border-red-200 bg-red-50':'border-amber-200 bg-amber-50');
            const left=document.createElement('div');
            const status=document.createElement('strong');
            status.className='text-sm '+(red?'text-red-900':'text-amber-900');
            status.textContent=String(issue.status||'issue').replaceAll('_',' ');
            const id=document.createElement('p');
            id.className='mt-1 break-all text-[.68rem] text-[var(--koa-ink)]/50';
            id.textContent=String(issue.emailId||'');
            left.append(status,id);
            const when=document.createElement('span');
            when.className='text-xs text-[var(--koa-ink)]/48';
            when.textContent=issue.createdAt?new Date(issue.createdAt).toLocaleString():'';
            row.append(left,when);
            emailHealthIssues.appendChild(row);
          });
        }
      }
    }

    function rememberCredentialRetest(credentialId){
      const id=String(credentialId||'').trim();
      if(!id)return;
      try{
        sessionStorage.setItem('koaCredentialRetest',JSON.stringify({credentialId:id,openedAt:Date.now()}));
      }catch{}
    }

    function pendingCredentialRetest(){
      try{
        const raw=sessionStorage.getItem('koaCredentialRetest');
        if(!raw)return null;
        const parsed=JSON.parse(raw);
        const credentialId=String(parsed?.credentialId||'').trim();
        const openedAt=Number(parsed?.openedAt||0);
        return credentialId?{credentialId,openedAt}:null;
      }catch{
        return null;
      }
    }

    function clearPendingCredentialRetest(){
      try{sessionStorage.removeItem('koaCredentialRetest');}catch{}
    }

    async function retestCredential(credentialId,button=null){
      const id=String(credentialId||'').trim();
      if(!id||credentialRetestInFlight)return false;
      credentialRetestInFlight=true;
      const original=button?.textContent||'';
      if(button){
        button.disabled=true;
        button.textContent='Re-testing…';
      }
      try{
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'retest-credential',credentialId:id}),
        });
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to re-test credential.');
        renderCredentialHealth(data.credentialHealth||{});
        clearPendingCredentialRetest();
        return true;
      }catch(error){
        if(button)button.textContent=error instanceof Error?error.message:'Re-test failed';
        return false;
      }finally{
        credentialRetestInFlight=false;
        if(button){
          window.setTimeout(()=>{
            button.disabled=false;
            if(button.isConnected)button.textContent=original||'Re-test only';
          },800);
        }
      }
    }

    async function maybeRetestPendingCredential(){
      const pending=pendingCredentialRetest();
      if(!pending||credentialRetestInFlight)return;
      if(Date.now()-Number(pending.openedAt||0)<1200)return;
      await retestCredential(pending.credentialId);
    }

    function renderCredentialHistory(rows){
      if(!credentialHealthHistory)return;
      const history=Array.isArray(rows)?rows:[];
      credentialHealthHistory.innerHTML='';
      history.slice(0,30).forEach((event)=>{
        const kind=String(event.event||'changed');
        const card=document.createElement('article');
        card.className='rounded-xl border p-3 '+(
          kind==='recovered'?'border-emerald-200 bg-emerald-50':
          kind==='became_invalid'?'border-red-200 bg-red-50':'border-amber-200 bg-amber-50'
        );
        const top=document.createElement('div');
        top.className='flex flex-wrap items-start justify-between gap-3';
        const left=document.createElement('div');
        const title=document.createElement('strong');
        title.className='block text-sm text-[var(--koa-forest)]';
        const label=kind==='recovered'?'Recovered':kind==='became_invalid'?'Became invalid':'Problem changed';
        title.textContent=String(event.provider||'Credential')+' · '+String(event.credential||event.credentialId||'Credential');
        const detail=document.createElement('p');
        detail.className='mt-1 text-xs leading-5 text-[var(--koa-ink)]/58';
        const duration=event.durationMinutes==null?'':(' · '+formatDuration(Number(event.durationMinutes||0)));
        detail.textContent=label+(event.issueType?' · '+String(event.issueType):'')+duration;
        left.append(title,detail);
        const when=document.createElement('span');
        when.className='text-xs text-[var(--koa-ink)]/45';
        when.textContent=event.occurredAt?new Date(event.occurredAt).toLocaleString():'';
        top.append(left,when);
        card.appendChild(top);
        if(event.detail){
          const message=document.createElement('p');
          message.className='mt-2 text-[.68rem] leading-5 text-[var(--koa-ink)]/50';
          message.textContent=String(event.detail);
          card.appendChild(message);
        }
        credentialHealthHistory.appendChild(card);
      });
      if(!history.length){
        credentialHealthHistory.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No credential-state changes have been recorded yet. History starts when this release performs its first credential check.</p>';
      }
    }

    function needsActionPriority(item){
      let score=item.source==='credential'?0:20;
      if(item.issueType==='Permission Problem')score-=8;
      else if(item.issueType==='Configuration Problem')score-=5;
      else score+=8;
      if(item.severity==='red')score-=4;
      else if(item.severity==='yellow')score+=2;
      return score;
    }

    function renderNeedsMyAction(){
      if(!needsActionList||!needsActionCount)return;
      const systemRows=(Array.isArray(latestHealthChecks)?latestHealthChecks:[])
        .filter((row)=>['Configuration Problem','Permission Problem'].includes(String(row?.issueType||''))&&normalizedSeverity(row)!=='healthy')
        .map((row)=>({
          source:'system',
          key:'system:'+String(row.id||row.name||'check'),
          title:String(row.name||'System Health check'),
          subtitle:'System Health',
          issueType:String(row.issueType||''),
          severity:row.severity==='red'?'red':'yellow',
          detail:String(row.detail||''),
          row,
        }));
      const credentialRows=(Array.isArray(latestCredentialHealth?.rows)?latestCredentialHealth.rows:[])
        .filter((row)=>!row?.ok)
        .map((row)=>({
          source:'credential',
          key:'credential:'+String(row.id||row.provider||'credential'),
          title:String(row.provider||'Credential')+' · '+String(row.credential||'Credential'),
          subtitle:'Credential Health',
          issueType:String(row.issueType||'Credential problem'),
          severity:String(row.severity||'yellow'),
          detail:String(row.detail||''),
          row,
        }));
      const items=[...credentialRows,...systemRows].sort((a,b)=>needsActionPriority(a)-needsActionPriority(b));
      needsActionCount.textContent=items.length+' item'+(items.length===1?'':'s');
      needsActionCount.className='w-fit rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+(
        items.some((item)=>item.severity==='red')?'bg-red-100 text-red-800':
        items.length?'bg-amber-100 text-amber-900':'bg-emerald-100 text-emerald-800'
      );
      needsActionList.innerHTML='';
      items.forEach((item,index)=>{
        const card=document.createElement('article');
        card.className='rounded-[1.1rem] border p-4 '+(item.severity==='red'?'border-red-200 bg-red-50':'border-amber-200 bg-amber-50');
        const top=document.createElement('div');
        top.className='flex items-start justify-between gap-3';
        const left=document.createElement('div');
        const rank=document.createElement('p');
        rank.className='text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]';
        rank.textContent='Priority '+(index+1)+' · '+item.subtitle;
        const title=document.createElement('h3');
        title.className='mt-1 text-sm font-semibold text-[var(--koa-forest)]';
        title.textContent=item.title;
        left.append(rank,title);
        const badge=document.createElement('span');
        badge.className='shrink-0 rounded-full bg-white/80 px-2.5 py-1 text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]';
        badge.textContent=item.issueType;
        top.append(left,badge);
        const detail=document.createElement('p');
        detail.className='mt-3 text-xs leading-5 text-[var(--koa-ink)]/60';
        detail.textContent=item.detail||'No additional detail recorded.';
        card.append(top,detail);
        const actions=document.createElement('div');
        actions.className='mt-4 flex flex-wrap gap-2';
        if(item.source==='credential'){
          const action=item.row?.recommendedAction||null;
          if(action?.href){
            const link=document.createElement('a');
            link.href=String(action.href);
            if(action.external){link.target='_blank';link.rel='noreferrer';}
            link.dataset.credentialHealthAction=String(item.row.id||'');
            link.className='rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white';
            link.textContent=String(action.label||'Open recommended action');
            actions.appendChild(link);
          }
          const retest=document.createElement('button');
          retest.type='button';
          retest.dataset.credentialRetest=String(item.row.id||'');
          retest.className='rounded-full border border-[var(--koa-line)] bg-white px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]';
          retest.textContent='Re-test only';
          actions.appendChild(retest);
        }else{
          const open=document.createElement('button');
          open.type='button';
          open.className='rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white';
          open.textContent='Open explanation';
          open.addEventListener('click',()=>openHealthDetail(item.row));
          actions.appendChild(open);
        }
        card.appendChild(actions);
        needsActionList.appendChild(card);
      });
      if(!items.length){
        needsActionList.innerHTML='<div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">Nothing currently needs manual configuration, permission, or credential action.</div>';
      }
    }

    function renderCredentialHealth(summary){
      const health=summary||{};
      latestCredentialHealth=health;
      const state=String(health.overall||'yellow');
      const overallMap={
        green:['Credentials healthy','bg-emerald-100 text-emerald-800'],
        yellow:['Credential attention','bg-amber-100 text-amber-900'],
        red:['Credential problem','bg-red-100 text-red-800'],
      };
      const selected=overallMap[state]||overallMap.yellow;
      if(credentialHealthOverall){
        credentialHealthOverall.textContent=selected[0];
        credentialHealthOverall.className='rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+selected[1];
      }
      if(credentialHealthChecked)credentialHealthChecked.textContent=health.generatedAt?'Checked '+new Date(health.generatedAt).toLocaleString():'—';
      if(!credentialHealthGrid)return;
      credentialHealthGrid.innerHTML='';
      const rows=Array.isArray(health.rows)?health.rows:[];
      rows.forEach((row)=>{
        const severity=String(row.severity||'yellow');
        const card=document.createElement('article');
        card.className='rounded-[1.1rem] border p-4 '+(
          severity==='green'?'border-emerald-200 bg-emerald-50':
          severity==='red'?'border-red-200 bg-red-50':'border-amber-200 bg-amber-50'
        );
        const top=document.createElement('div');
        top.className='flex items-start justify-between gap-3';
        const left=document.createElement('div');
        const provider=document.createElement('p');
        provider.className='text-[.55rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]';
        provider.textContent=String(row.provider||row.id||'Credential');
        const credential=document.createElement('h3');
        credential.className='mt-1 text-sm font-semibold text-[var(--koa-forest)]';
        credential.textContent=String(row.credential||'Credential');
        left.append(provider,credential);
        const badge=document.createElement('span');
        badge.className='shrink-0 rounded-full px-2.5 py-1 text-[.54rem] font-black uppercase tracking-[.07em] '+(
          severity==='green'?'bg-emerald-800 text-white':
          severity==='red'?'bg-red-800 text-white':'bg-amber-700 text-white'
        );
        badge.textContent=severity==='green'?'Valid':severity==='red'?'Problem':'Attention';
        top.append(left,badge);
        card.appendChild(top);
        if(row.issueType){
          const issue=document.createElement('span');
          issue.className='mt-3 inline-flex rounded-full bg-white/75 px-2.5 py-1 text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]';
          issue.textContent=String(row.issueType);
          card.appendChild(issue);
        }
        const detail=document.createElement('p');
        detail.className='mt-3 text-xs leading-5 text-[var(--koa-ink)]/60';
        detail.textContent=(row.status?'HTTP '+row.status+' · ':'')+String(row.detail||'No verification detail recorded.');
        card.appendChild(detail);
        if(!row.ok&&row.problemSince){
          const since=document.createElement('p');
          const started=Date.parse(String(row.problemSince||''));
          const minutes=Number.isFinite(started)?Math.max(0,Math.round((Date.now()-started)/60000)):0;
          since.className='mt-2 text-[.66rem] font-semibold text-[var(--koa-clay)]';
          since.textContent='Needs attention since '+new Date(row.problemSince).toLocaleString()+' · '+formatDuration(minutes);
          card.appendChild(since);
        }
        if(severity!=='green'){
          const actions=document.createElement('div');
          actions.className='mt-4 flex flex-wrap gap-2';
          const action=row.recommendedAction||null;
          if(action&&action.href){
            const link=document.createElement('a');
            link.href=String(action.href);
            if(action.external){
              link.target='_blank';
              link.rel='noreferrer';
            }
            link.dataset.credentialHealthAction=String(row.id||'credential');
            link.className='rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white';
            link.textContent=String(action.label||'Open recommended action');
            actions.appendChild(link);
          }
          const retest=document.createElement('button');
          retest.type='button';
          retest.dataset.credentialRetest=String(row.id||'credential');
          retest.className='rounded-full border border-[var(--koa-line)] bg-white px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]';
          retest.textContent='Re-test only';
          actions.appendChild(retest);
          card.appendChild(actions);
        }
        credentialHealthGrid.appendChild(card);
      });
      if(!rows.length)credentialHealthGrid.innerHTML='<p class="text-sm text-[var(--koa-ink)]/50">Credential checks are not available yet.</p>';
      renderCredentialHistory(health.history||[]);
      renderNeedsMyAction();
    }

    function renderOffice365Trend(rows){
      if(!office365Trend)return;
      const data=Array.isArray(rows)?rows:[];
      if(!data.length){office365Trend.innerHTML='<p class="text-xs text-[var(--koa-ink)]/45">No sync trend history is available yet.</p>';return;}
      const width=900,height=250,padL=38,padR=20,padT=18,padB=34;
      const plotW=width-padL-padR,plotH=height-padT-padB;
      const maxCount=Math.max(1,...data.map((row)=>Math.max(Number(row.conflictRuns||0),Number(row.authenticationFailures||0))));
      const x=(index)=>padL+(data.length===1?plotW/2:index*(plotW/(data.length-1)));
      const yRate=(rate)=>padT+plotH-(Math.max(0,Math.min(100,Number(rate??0)))/100)*plotH;
      const yCount=(count)=>padT+plotH-(Math.max(0,Number(count||0))/maxCount)*(plotH*.35);
      const successPoints=data.filter((row)=>row.successRate!=null).map((row,index)=>{
        const actualIndex=data.indexOf(row);return x(actualIndex)+','+yRate(row.successRate);
      }).join(' ');
      let svg='<svg viewBox="0 0 '+width+' '+height+'" class="min-w-[760px] w-full" role="img" aria-label="Office 365 daily reliability trend">';
      [0,25,50,75,100].forEach((rate)=>{
        const y=yRate(rate);svg+='<line x1="'+padL+'" y1="'+y+'" x2="'+(width-padR)+'" y2="'+y+'" stroke="currentColor" opacity=".08"/><text x="4" y="'+(y+4)+'" font-size="10" fill="currentColor" opacity=".45">'+rate+'%</text>';
      });
      data.forEach((row,index)=>{
        const xx=x(index),barW=Math.max(4,Math.min(10,plotW/data.length*.28));
        const cy=yCount(row.conflictRuns),ay=yCount(row.authenticationFailures);
        const base=padT+plotH;
        if(Number(row.conflictRuns||0)>0)svg+='<rect x="'+(xx-barW-1)+'" y="'+cy+'" width="'+barW+'" height="'+(base-cy)+'" rx="2" fill="#c58a3a" opacity=".72"/>';
        if(Number(row.authenticationFailures||0)>0)svg+='<rect x="'+(xx+1)+'" y="'+ay+'" width="'+barW+'" height="'+(base-ay)+'" rx="2" fill="#991b1b" opacity=".72"/>';
        if(index%5===0||index===data.length-1)svg+='<text x="'+xx+'" y="'+(height-10)+'" text-anchor="middle" font-size="9" fill="currentColor" opacity=".45">'+String(row.date||'').slice(5)+'</text>';
      });
      if(successPoints)svg+='<polyline points="'+successPoints+'" fill="none" stroke="#24483b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>';
      data.forEach((row,index)=>{if(row.successRate!=null)svg+='<circle cx="'+x(index)+'" cy="'+yRate(row.successRate)+'" r="2.5" fill="#24483b"><title>'+row.date+': '+row.successRate+'% success, '+Number(row.conflictRuns||0)+' conflict runs, '+Number(row.authenticationFailures||0)+' auth failures</title></circle>';});
      svg+='</svg>';
      office365Trend.innerHTML=svg;
    }

    function render(data){
      const current=data.current;
      if(current){
        const bad=current.overall==='unhealthy';
        const severityCounts=(current.checks||[]).reduce((acc,row)=>{
          const severity=normalizedSeverity(row);
          if(severity==='critical')acc.critical++;
          else if(severity==='warning')acc.warning++;
          else if(severity==='info')acc.info++;
          return acc;
        },{critical:0,warning:0,info:0});
        const hasIssues=severityCounts.critical+severityCounts.warning+severityCounts.info>0;
        overall.textContent=severityCounts.critical?'Critical':severityCounts.warning?'Warning':severityCounts.info?'Info':'Healthy';
        overall.className='display mt-3 text-4xl '+(severityCounts.critical?'text-red-800':severityCounts.warning?'text-amber-800':severityCounts.info?'text-sky-800':'text-[var(--koa-forest)]');
        criticalCount.textContent=severityCounts.critical+' critical';
        warningCount.textContent=severityCounts.warning+' warning';
        infoCount.textContent=severityCounts.info+' info';
        criticalCount.classList.toggle('hidden',severityCounts.critical===0);
        warningCount.classList.toggle('hidden',severityCounts.warning===0);
        infoCount.classList.toggle('hidden',severityCounts.info===0);
        severitySummary.classList.toggle('hidden',!hasIssues);
        passed.textContent=String(current.passed||0);
        failed.textContent=String(current.failed||0);
        checked.textContent=current.checkedAt?new Date(current.checkedAt).toLocaleString():'—';
        const hasFailures=Number(current.failed||0)>0;
        overallCard.disabled=!hasFailures;
        failedCard.disabled=!hasFailures;
        overallCard.setAttribute('aria-disabled',String(!hasFailures));
        failedCard.setAttribute('aria-disabled',String(!hasFailures));
        overallHint.classList.toggle('hidden',!hasFailures);
        failedHint.classList.toggle('hidden',!hasFailures);
        const severityRank={critical:0,warning:1,info:2,healthy:3};
        latestHealthChecks=[...(current.checks||[])];
        latestHealthChecks.sort((a,b)=>severityRank[normalizedSeverity(a)]-severityRank[normalizedSeverity(b)]);
        renderRootCauseSummary(latestHealthChecks);
        renderHealthChecks();
      }else{
        overall.textContent='No data';
        overallCard.disabled=true;
        failedCard.disabled=true;
        overallHint.classList.add('hidden');
        failedHint.classList.add('hidden');
        severitySummary.classList.add('hidden');
        latestHealthChecks=[];
        activeRootCause='';
        renderRootCauseSummary([]);
        results.innerHTML='<p class="text-sm text-[var(--koa-ink)]/50">No health snapshot has been recorded yet. Run checks now.</p>';
      }

      historyEl.innerHTML='';
      (data.history||[]).slice(0,20).forEach(row=>{
        const card=document.createElement('article');
        card.className='rounded-xl border '+(row.overall==='healthy'?'border-emerald-200':'border-red-200')+' p-4';
        card.innerHTML='<div class="flex items-center justify-between gap-4"><strong class="text-sm text-[var(--koa-forest)]">'+(row.overall==='healthy'?'Healthy':'Attention')+'</strong><span class="text-xs text-[var(--koa-ink)]/48">'+new Date(row.checkedAt).toLocaleString()+'</span></div><p class="mt-2 text-xs text-[var(--koa-ink)]/58">'+row.source+' · '+row.passed+' passed · '+row.failed+' failed'+(row.failedIds?.length?' · '+row.failedIds.join(', '):'')+'</p>';
        historyEl.appendChild(card);
      });

      renderEmailHealth(data.emailHealth||{},data.current||null);
      renderCredentialHealth(data.credentialHealth||{});
      const office365=data.office365||{};
      if(office365Operational){
        const signals=office365.signals||{};
        const operational=String(office365.operationalStatus||'unknown');
        const operationalMap={
          scheduled:['Scheduled function deployed','Office 365 automatic synchronization is deployed and eligible to run on schedule.','Healthy','border-emerald-200 bg-emerald-50','bg-emerald-100 text-emerald-800'],
          paused:['Sync intentionally paused by credit saver','The Office 365 scheduled function is deployed, but automatic runs are intentionally paused by the active credit-saver policy. Manual Sync now + verify remains available.','Paused','border-amber-200 bg-amber-50','bg-amber-100 text-amber-900'],
          saver:['Office 365 sync running in Saver mode','Automatic Office 365 synchronization is reduced from hourly to every four hours. Manual Sync now + verify remains available.','Saver','border-amber-200 bg-amber-50','bg-amber-100 text-amber-900'],
          authentication_failed:['Microsoft Graph authentication failed','The production sync reported an authentication, permission, credential, or tenant-consent failure.','Auth failed','border-red-300 bg-red-50','bg-red-100 text-red-800'],
          production_behind:['Production too far behind GitHub to verify','Production is more than one commit behind main, so the newest Office 365 code cannot be treated as verified yet.','Verification blocked','border-red-300 bg-red-50','bg-red-100 text-red-800'],
          schedule_missing:['Office 365 scheduled function missing','The current Netlify production deploy does not report the office365-calendar-sync scheduled function.','Missing','border-red-300 bg-red-50','bg-red-100 text-red-800'],
          not_configured:['Office 365 Graph configuration incomplete','One or more required Microsoft Graph environment variables are missing.','Not configured','border-red-300 bg-red-50','bg-red-100 text-red-800'],
          deployment_catching_up:['Production is catching up','Production is one commit behind while deployment is starting or running. Verification is temporarily cautionary, not failed.','Catching up','border-amber-200 bg-amber-50','bg-amber-100 text-amber-900'],
          unknown:['Office 365 state unavailable','System Health could not determine the current Office 365 operational state.','Unknown','border-slate-200 bg-slate-50','bg-slate-100 text-slate-700'],
        };
        const selected=operationalMap[operational]||operationalMap.unknown;
        office365Operational.className='mt-5 rounded-[1.2rem] border p-5 '+selected[3];
        office365OperationalTitle.textContent=selected[0];
        office365OperationalDetail.textContent=selected[1];
        office365OperationalBadge.textContent=selected[2];
        office365OperationalBadge.className='w-fit rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+selected[4];

        const schedule=signals.scheduledFunction||{};
        office365Schedule.textContent=schedule.deployed?'Deployed':'Not deployed';
        office365Schedule.className='mt-2 text-sm font-semibold '+(schedule.deployed?'text-emerald-800':'text-red-800');
        office365ScheduleDetail.textContent=schedule.deployed
          ? 'Netlify schedule '+String(schedule.cron||'detected')
          : 'Current production deploy does not list office365-calendar-sync.';

        const pause=signals.creditSaver||{};
        const officeMode=String(pause.mode||'normal');
        office365Pause.textContent=officeMode==='paused'?'Paused intentionally':officeMode==='saver'?'Saver · every 4 hours':'Automatic sync active';
        office365Pause.className='mt-2 text-sm font-semibold '+(officeMode==='normal'?'text-emerald-800':'text-amber-800');
        office365PauseDetail.textContent=officeMode==='paused'
          ? 'Credit saver is suppressing scheduled Office 365 runs'+(pause.expiresAt?' until '+new Date(pause.expiresAt).toLocaleString():'')+'.'
          : officeMode==='saver'
            ? 'Credit saver allows one scheduled sync every four hours'+(pause.expiresAt?' until '+new Date(pause.expiresAt).toLocaleString():'')+'.'
            : 'Office 365 is using its normal hourly automatic schedule.';

        const graphAuth=signals.authentication||{};
        const graphLabels={succeeded:'Succeeded',failed:'Failed',awaiting:'Awaiting first confirmed sync',not_configured:'Not configured'};
        office365GraphAuth.textContent=graphLabels[String(graphAuth.status||'awaiting')]||String(graphAuth.status||'Unknown');
        office365GraphAuth.className='mt-2 text-sm font-semibold '+(
          graphAuth.status==='succeeded'?'text-emerald-800':
          graphAuth.status==='failed'||graphAuth.status==='not_configured'?'text-red-800':'text-amber-800'
        );
        office365GraphAuthDetail.textContent=graphAuth.failed
          ? String(graphAuth.error||'Microsoft Graph authentication failed.')
          : graphAuth.status==='succeeded'
            ? 'At least one production sync completed successfully.'
            : 'No Graph authentication failure is recorded, but a successful production sync has not been confirmed yet.';

        const verification=signals.verification||{};
        const verificationLabels={ready:'Ready to verify',blocked:'Blocked by production lag',catching_up:'One commit behind · deploying',caution:'One commit behind · investigate',unknown:'Unable to determine'};
        office365Verification.textContent=verificationLabels[String(verification.status||'unknown')]||String(verification.status||'Unknown');
        office365Verification.className='mt-2 text-sm font-semibold '+(
          verification.status==='ready'?'text-emerald-800':
          verification.status==='blocked'?'text-red-800':'text-amber-800'
        );
        const commitsBehind=verification.commitsBehind;
        office365VerificationDetail.textContent=commitsBehind==null
          ? 'Production/main commit distance is unavailable.'
          : commitsBehind===0
            ? 'Production matches GitHub main.'
            : 'Production is '+commitsBehind+' commit'+(Number(commitsBehind)===1?'':'s')+' behind main · '+String(verification.deploymentState||'unknown')+'.';
      }
      if(office365Auth){
        const authLabels={
          connected:'Connected',
          configured:'Configured · awaiting first sync',
          authentication_error:'Authentication error',
          sync_error:'Sync error',
          not_configured:'Not configured',
        };
        const authStatus=String(office365.authenticationStatus||'not_configured');
        office365Auth.textContent=authLabels[authStatus]||authStatus;
        office365Auth.className='mt-2 text-sm font-semibold '+(
          authStatus==='connected'?'text-emerald-800':
          authStatus==='configured'?'text-amber-800':
          'text-red-800'
        );
        office365AuthDetail.textContent=office365.lastError
          ? String(office365.lastError)
          : [office365.calendarName,office365.calendarOwner].filter(Boolean).join(' · ');
        office365LastSuccess.textContent=office365.lastSuccessAt?new Date(office365.lastSuccessAt).toLocaleString():'No successful sync yet';
        office365Next.textContent=office365.signals?.creditSaver?.paused
          ? 'Paused by credit saver'
          : office365.nextScheduledSyncAt?new Date(office365.nextScheduledSyncAt).toLocaleString():'—';
        office365Conflicts.textContent=String(office365.unresolvedConflicts||0);
        office365Conflicts.className='display mt-2 text-3xl '+(Number(office365.unresolvedConflicts||0)>0?'text-red-800':'text-[var(--koa-forest)]');
        office365Changed.textContent=String(office365.changedLast24Hours||0);
        office365Runs.textContent=String(office365.runsLast24Hours||0)+' sync run'+(Number(office365.runsLast24Hours||0)===1?'':'s')+' in the last 24 hours';
        const renderOfficeReliability=(period,nodes)=>{
          const runs=Number(period?.totalRuns||0);
          nodes.runs.textContent=runs+' run'+(runs===1?'':'s');
          nodes.success.textContent=period?.successRate==null?'—':String(period.successRate)+'%';
          nodes.average.textContent=period?.averageEventsChangedPerRun==null?'—':String(period.averageEventsChangedPerRun);
          nodes.conflict.textContent=period?.conflictRate==null?'—':String(period.conflictRate)+'%';
          nodes.auth.textContent=String(period?.authenticationFailures||0);
          nodes.auth.className='mt-1 text-xl font-semibold '+(Number(period?.authenticationFailures||0)>0?'text-red-800':'text-[var(--koa-forest)]');
          nodes.conflict.className='mt-1 text-xl font-semibold '+(Number(period?.conflictRate||0)>0?'text-amber-800':'text-[var(--koa-forest)]');
        };
        renderOfficeReliability(office365.reliability?.['7d']||{},{
          runs:office365Reliability7dRuns,success:office365Reliability7dSuccess,average:office365Reliability7dAverage,conflict:office365Reliability7dConflict,auth:office365Reliability7dAuth
        });
        renderOfficeReliability(office365.reliability?.['30d']||{},{
          runs:office365Reliability30dRuns,success:office365Reliability30dSuccess,average:office365Reliability30dAverage,conflict:office365Reliability30dConflict,auth:office365Reliability30dAuth
        });
        const thresholds=office365.reliabilityThresholds||{yellowBelow:98,redBelow:90};
        office365YellowThreshold.value=String(thresholds.yellowBelow??98);
        office365RedThreshold.value=String(thresholds.redBelow??90);
        const severity=String(office365.severity||'unknown');
        const severityLabels={green:'Healthy',yellow:'Watch',red:'Critical',unknown:'Insufficient data'};
        office365Severity.textContent='Reliability · '+(severityLabels[severity]||severity);
        office365Severity.className='rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+(
          severity==='green'?'bg-emerald-100 text-emerald-800':
          severity==='yellow'?'bg-amber-100 text-amber-900':
          severity==='red'?'bg-red-100 text-red-800':'bg-slate-100 text-slate-700'
        );
        renderOffice365Trend(office365.reliabilityTrend||[]);
      }

      const deployments=data.deployments||{};
      const creditUsage=deployments.creditUsage||{};
      if(creditCycle){
        const start=creditUsage.cycleStart?new Date(creditUsage.cycleStart).toLocaleDateString():'—';
        const end=creditUsage.cycleEnd?new Date(creditUsage.cycleEnd).toLocaleDateString():'—';
        creditCycle.textContent='Cycle '+start+' – '+end;
      }
      if(creditTotal)creditTotal.textContent=creditUsage.totalEstimatedCredits==null?'—':String(creditUsage.totalEstimatedCredits);
      if(creditRemaining)creditRemaining.textContent=creditUsage.estimatedRemainingCredits==null?'—':String(creditUsage.estimatedRemainingCredits);
      if(creditAllowance)creditAllowance.textContent=creditUsage.monthlyAllowance==null?'—':String(creditUsage.monthlyAllowance);
      if(creditProjected)creditProjected.textContent=creditUsage.projection?.projectedEndOfCycleCredits==null?'—':String(creditUsage.projection.projectedEndOfCycleCredits);
      if(creditProjectedMeta){
        const p=creditUsage.projection||{};
        if(p.projectedAllowancePercent==null){
          creditProjectedMeta.textContent='Forecast unavailable';
        }else{
          const recent=p.recent7DayBurnRate==null?'—':String(p.recent7DayBurnRate);
          const baseline=p.fullCycleDailyBurnRate==null?'—':String(p.fullCycleDailyBurnRate);
          const weighted=p.weightedDailyBurnRate==null?'—':String(p.weightedDailyBurnRate);
          creditProjectedMeta.textContent=String(p.projectedAllowancePercent)+'% of allowance · '+String(p.confidence||'low')+' confidence · '+recent+'/day recent · '+baseline+'/day cycle · '+weighted+'/day weighted';
        }
      }
      if(creditExhaustDays){
        const days=creditUsage.projection?.daysUntilExhausted;
        creditExhaustDays.textContent=days==null?'—':String(days);
      }
      if(creditExhaustDate){
        const at=creditUsage.projection?.exhaustionAt;
        creditExhaustDate.textContent=at
          ? 'Estimated '+new Date(at).toLocaleString()
          : 'Projection stays within current allowance';
      }
      if(creditSaved)creditSaved.textContent=creditUsage.savings?.estimatedCreditsSaved==null?'—':String(creditUsage.savings.estimatedCreditsSaved);
      if(creditSavedMeta){
        const s=creditUsage.savings||{};
        creditSavedMeta.textContent=(s.successfulDeployPreviews==null?'—':String(s.successfulDeployPreviews))+' successful preview'+(Number(s.successfulDeployPreviews)===1?'':'s')+' counted';
      }
      if(creditForecastWarning){
        const p=creditUsage.projection||{};
        const projectedSeverity=String(p.severity||'unknown');
        if(['yellow','orange','red'].includes(projectedSeverity)){
          creditForecastWarning.className='mt-4 rounded-xl border p-4 text-sm font-semibold '+(
            projectedSeverity==='red'?'border-red-300 bg-red-50 text-red-800':
            projectedSeverity==='orange'?'border-orange-300 bg-orange-50 text-orange-900':
            'border-yellow-300 bg-yellow-50 text-yellow-900'
          );
          const exhaustion=p.daysUntilExhausted==null?'':' Estimated exhaustion in '+String(p.daysUntilExhausted)+' days ('+new Date(p.exhaustionAt).toLocaleString()+').';
          creditForecastWarning.textContent='Projected end-of-cycle usage is '+String(p.projectedAllowancePercent)+'% ('+String(p.projectedEndOfCycleCredits)+' credits) using a recent-weighted burn rate.'+exhaustion;
        }else{
          creditForecastWarning.className='mt-4 hidden rounded-xl border p-4 text-sm font-semibold';
          creditForecastWarning.textContent='';
        }
      }
      if(creditPercent)creditPercent.textContent=creditUsage.estimatedAllowancePercent==null?'—':String(creditUsage.estimatedAllowancePercent)+'%';
      if(creditBar){
        const pct=Math.max(0,Math.min(100,Number(creditUsage.estimatedAllowancePercent||0)));
        creditBar.style.width=pct+'%';
      }
      if(creditStatus){
        const severity=String(creditUsage.warningSeverity||creditUsage.severity||'unknown');
        const statusMap={
          green:['Healthy','bg-emerald-100 text-emerald-800'],
          yellow:['Watch','bg-yellow-100 text-yellow-900'],
          orange:['High','bg-orange-100 text-orange-900'],
          red:['Critical','bg-red-100 text-red-800'],
          unknown:['Estimate unavailable','bg-[var(--koa-sand)] text-[var(--koa-forest)]'],
        };
        const selected=statusMap[severity]||statusMap.unknown;
        creditStatus.textContent=selected[0];
