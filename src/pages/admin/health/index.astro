      const creditPanel=document.querySelector('[data-credit-panel]');
      if(creditPanel instanceof HTMLElement&&!creditPanel.id)creditPanel.id='health-credit-usage';
      prepareMobileCollapsible(creditPanel);

      makeHealthJumpCard(passedCard,showHealthyChecks,'Show healthy System Health checks');
      makeHealthJumpCard(checkedCard,()=>jumpToHealthSection('#health-history'),'Open recent System Health history');

      const weeklyTargets=new Map([
        ['Observed uptime','#health-uptime'],
        ['Credential reliability','#credential-health'],
        ['Incidents','#health-incidents'],
        ['Automatic repairs','#health-history'],
        ['Unresolved now','#health-needs-action'],
      ]);
      document.querySelector('[data-weekly-executive-summary]')?.querySelectorAll('article').forEach((card)=>{
        const label=String(card.querySelector('p')?.textContent||'').trim();
        const target=weeklyTargets.get(label);
        if(target)makeHealthJumpCard(card,()=>jumpToHealthSection(target),'Open '+label+' details');
