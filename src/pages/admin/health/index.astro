        });
        const thresholds=office365.reliabilityThresholds||{yellowBelow:98,redBelow:90};
        office365YellowThreshold.value=String(thresholds.yellowBelow??98);
        office365RedThreshold.value=String(thresholds.redBelow??90);
        const severity=String(office365.severity||'unknown');
        const severityLabels:Record<string,string>={green:'Healthy',yellow:'Watch',red:'Critical',unknown:'Insufficient data'};
        office365Severity.textContent='Reliability · '+(severityLabels[severity]||severity);
        office365Severity.className='rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+(
          severity==='green'?'bg-emerald-100 text-emerald-800':
