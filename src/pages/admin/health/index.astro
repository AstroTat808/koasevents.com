---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Admin Health" description="System health, monitoring, and deployment history for Koa’s protected workspaces." canonical="https://koasevents.com/admin/health/">
  <main data-system-health-page class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-7xl">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Reliability</p>
          <h1 class="display mt-3 text-5xl">System Health</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Hourly monitoring, transition-only alerts, protected page/API status, and deployment QA history in one place.</p>
        </div>
        <div class="health-page-header-actions flex flex-col items-start gap-2 lg:items-end">
          <button data-refresh type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Run checks now</button>
          <div class="flex flex-wrap gap-2 text-[.54rem] font-black uppercase tracking-[.08em]">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[var(--koa-ink)]/55">
              <span>Core check</span>
              <strong data-core-check-status class="text-slate-600">Loading</strong>
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[var(--koa-ink)]/55">
              <span>Dashboard refresh</span>
              <strong data-dashboard-refresh-status class="text-slate-600">Loading</strong>
            </span>
          </div>
        </div>
      </div>

      <div data-unauthorized class="mt-8 hidden rounded-[1.4rem] bg-white p-7 shadow-[var(--shadow-soft)]">
        <p class="eyebrow text-[var(--koa-clay)]">Permission required</p>
        <h2 class="display mt-2 text-3xl text-[var(--koa-forest)]">System Health access is not enabled for this account.</h2>
        <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58">You are signed in, but your role does not include the System Health permission.</p>
      </div>

      <div data-app class="mt-8 hidden grid gap-6">
        <section data-health-summary-grid class="health-summary-grid grid gap-4">
          <article data-overall-card class="health-summary-card health-summary-card--overall rounded-[1.3rem] bg-white p-5 text-left shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5 hover:shadow-lg">
            <button data-overall-action type="button" class="block w-full text-left focus:outline-none focus:ring-2 focus:ring-[var(--koa-clay)] disabled:cursor-default" aria-label="Show health issues">
              <p class="eyebrow text-[var(--koa-clay)]">Overall</p>
              <p data-overall class="display mt-3 text-4xl text-[var(--koa-forest)]">—</p>
            </button>
            <div data-severity-summary class="mt-3 hidden flex-wrap gap-2 text-[.56rem] font-black uppercase tracking-[.08em]">
              <button data-critical-count data-severity-filter="critical" type="button" class="rounded-full bg-red-100 px-2.5 py-1 text-red-800 transition hover:bg-red-200 focus:outline-none focus:ring-2 focus:ring-red-700"></button>
              <button data-warning-count data-severity-filter="warning" type="button" class="rounded-full bg-amber-100 px-2.5 py-1 text-amber-800 transition hover:bg-amber-200 focus:outline-none focus:ring-2 focus:ring-amber-700"></button>
              <button data-info-count data-severity-filter="info" type="button" class="rounded-full bg-sky-100 px-2.5 py-1 text-sky-800 transition hover:bg-sky-200 focus:outline-none focus:ring-2 focus:ring-sky-700"></button>
            </div>
            <div data-severity-section-hints class="mt-2 hidden grid gap-1 text-[.56rem] leading-4 text-[var(--koa-ink)]/55"></div>
            <p data-overall-hint class="mt-2 hidden text-[.62rem] font-black uppercase tracking-[.08em] text-red-700">View issues ↓</p>
          </article>
          <article class="health-summary-card rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Passed</p><p data-passed class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p><p class="health-summary-support mt-2 text-xs leading-5 text-[var(--koa-ink)]/48">Checks currently passing.</p></article>
          <button data-failed-card type="button" class="health-summary-card rounded-[1.3rem] bg-white p-5 text-left shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-red-700 disabled:cursor-default disabled:hover:translate-y-0" aria-label="Show failed health checks">
            <p class="eyebrow text-[var(--koa-clay)]">Failed</p>
            <p data-failed class="display mt-3 text-4xl text-red-800">0</p>
            <p data-failed-hint class="mt-2 hidden text-[.62rem] font-black uppercase tracking-[.08em] text-red-700">View failed checks ↓</p>
            <p class="health-summary-support mt-2 text-xs leading-5 text-[var(--koa-ink)]/48">Checks currently failing.</p>
          </button>
          <article class="health-summary-card health-summary-card--checked rounded-[1.3rem] bg-[var(--koa-ink)] p-5 text-white shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-amber-light)]">Last checked</p><p data-checked class="mt-3 text-sm font-semibold">—</p><p class="health-summary-support mt-2 text-xs leading-5 text-white/55">Latest completed System Health snapshot.</p></article>
        </section>

        <section data-health-coverage class="rounded-[1.3rem] border border-[var(--koa-line)] bg-white p-5 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Monitoring coverage</p>
              <h2 class="display mt-1 text-3xl text-[var(--koa-forest)]">Coverage summary</h2>
            </div>
            <span data-coverage-badge class="rounded-full bg-emerald-100 px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-emerald-800">Loading…</span>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Pages</p><strong data-coverage-pages class="display mt-2 block text-3xl text-[var(--koa-forest)]">—</strong></article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">APIs</p><strong data-coverage-apis class="display mt-2 block text-3xl text-[var(--koa-forest)]">—</strong></article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Integration checks</p><strong data-coverage-integrations class="display mt-2 block text-3xl text-[var(--koa-forest)]">—</strong></article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Monitored</p><strong data-coverage-percent class="display mt-2 block text-3xl text-emerald-800">—</strong></article>
          </div>
          <p data-coverage-detail class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/50">Coverage is calculated from the registered health-check inventory and the most recent completed snapshot.</p>
        </section>

        <section data-critical-integrations-card class="rounded-[1.3rem] border border-[var(--koa-line)] bg-white p-5 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Release-critical probes</p>
              <h2 class="display mt-1 text-3xl text-[var(--koa-forest)]">Critical Integrations</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Groups the four zero-write release gates for Event Documents, Vendor Insurance, QuickBooks webhooks, and SignWell. Production verification must pass all four.</p>
            </div>
            <div class="flex flex-wrap items-center justify-end gap-2">
              <span data-critical-integrations-status class="rounded-full bg-slate-100 px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-slate-700">Loading</span>
              <button data-critical-integrations-export="csv" type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Export CSV</button>
              <button data-critical-integrations-export="json" type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Export JSON</button>
            </div>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4">
              <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Healthy now</p>
              <strong data-critical-integrations-count class="display mt-2 block text-3xl text-[var(--koa-forest)]">—</strong>
            </article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4">
              <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Last live verification</p>
              <strong data-critical-integrations-last-live class="mt-2 block text-sm text-[var(--koa-forest)]">—</strong>
            </article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4">
              <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Current source</p>
              <strong data-critical-integrations-source class="mt-2 block text-sm text-[var(--koa-forest)]">—</strong>
            </article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4">
              <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Oldest cached result</p>
              <strong data-critical-integrations-oldest-cache class="mt-2 block text-sm text-[var(--koa-forest)]">—</strong>
            </article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4">
              <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Rollback Ready</p>
              <strong data-critical-integrations-rollback-status class="mt-2 block text-sm text-[var(--koa-forest)]">—</strong>
              <code data-critical-integrations-rollback-target class="mt-2 block break-all text-[.62rem] leading-5 text-[var(--koa-ink)]/55">—</code>
              <p data-critical-integrations-rollback-age class="mt-2 text-[.62rem] leading-5 text-[var(--koa-ink)]/55">Age —</p>
              <p data-critical-integrations-rollback-accounting class="mt-1 text-[.62rem] leading-5 text-[var(--koa-ink)]/55">QuickBooks invariants —</p>
            </article>
          </div>
          <div class="mt-4 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <strong class="text-xs font-semibold text-[var(--koa-forest)]">Audit export filters</strong>
              <span data-critical-integrations-export-summary class="text-[.6rem] text-[var(--koa-ink)]/50">All recorded production releases</span>
            </div>
            <div class="mt-3 grid gap-3 md:grid-cols-2 xl:grid-cols-5">
              <label class="text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">From
                <input data-critical-integrations-export-from type="date" class="mt-1 block w-full rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-medium normal-case tracking-normal text-[var(--koa-forest)]" />
              </label>
              <label class="text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">To
                <input data-critical-integrations-export-to type="date" class="mt-1 block w-full rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-medium normal-case tracking-normal text-[var(--koa-forest)]" />
              </label>
              <label class="text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">Integration
                <select data-critical-integrations-export-integration class="mt-1 block w-full rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-medium normal-case tracking-normal text-[var(--koa-forest)]">
                  <option value="all">All four integrations</option>
                  <option value="synthetic-event-documents">Event Documents</option>
                  <option value="synthetic-vendor-insurance-document">Vendor Insurance</option>
                  <option value="synthetic-quickbooks-webhook">QuickBooks webhook</option>
                  <option value="synthetic-signwell-webhook">SignWell webhook</option>
                </select>
              </label>
              <label class="flex items-center gap-2 rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]">
                <input data-critical-integrations-export-failed type="checkbox" class="h-4 w-4" />
                Failed releases only
              </label>
              <label class="flex items-center gap-2 rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]">
                <input data-critical-integrations-export-rollback type="checkbox" class="h-4 w-4" />
                Rollback events only
              </label>
            </div>
          </div>
          <div class="mt-4 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <p data-critical-integrations-detail class="text-xs leading-5 text-[var(--koa-ink)]/55">Waiting for the latest System Health snapshot.</p>
            <div class="flex flex-wrap items-center gap-2">
              <button data-critical-integrations-drill type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-4 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)] disabled:cursor-not-allowed disabled:opacity-50">Run safe rollback drill</button>
              <span data-critical-integrations-drill-message class="text-[.62rem] text-[var(--koa-ink)]/50"></span>
            </div>
          </div>
        </section>

        <section data-accounting-health-card class="rounded-[1.3rem] border border-[var(--koa-line)] bg-white p-5 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Accounting protection</p>
              <h2 class="display mt-1 text-3xl text-[var(--koa-forest)]">Live accounting invariants</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Protects the $15,706.80 Chris Sibel canary and dynamically verifies every accepted/booked CRM proposal against its live QuickBooks estimate, including non-taxable line behavior.</p>
            </div>
            <span data-accounting-health-status class="rounded-full bg-slate-100 px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-slate-700">Loading</span>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-6">
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Invariant result</p><strong data-accounting-invariant-result class="mt-2 block text-lg text-[var(--koa-forest)]">—</strong><p data-accounting-invariant-detail class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">—</p></article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Chris Sibel live estimate</p><strong data-accounting-live-client class="mt-2 block text-lg text-[var(--koa-forest)]">—</strong><p data-accounting-live-client-detail class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">—</p></article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Accepted / booked clients</p><strong data-accounting-live-clients class="mt-2 block text-lg text-[var(--koa-forest)]">—</strong><p data-accounting-live-clients-detail class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">—</p></article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">QuickBooks NON tax code</p><strong data-accounting-non-status class="mt-2 block text-lg text-[var(--koa-forest)]">—</strong><p data-accounting-non-detail class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">—</p></article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Last successful check</p><strong data-accounting-last-success class="mt-2 block text-lg text-[var(--koa-forest)]">—</strong><p data-accounting-sample-count class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">—</p></article>
            <article class="rounded-xl bg-[var(--koa-ivory)] p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Current taxable payload</p><strong data-accounting-taxable-payload class="mt-2 block text-lg text-[var(--koa-forest)]">—</strong><p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">Must remain $0.00 to prevent tax-on-tax.</p></article>
          </div>
          <div class="mt-5 rounded-xl border border-[var(--koa-line)] p-4" data-accounting-invariant-table-panel>
            <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <strong class="text-sm text-[var(--koa-forest)]">Client invariant audit</strong>
                <p data-accounting-invariant-table-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">Waiting for production accounting audit rows.</p>
              </div>
              <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
                <label class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Status
                  <select data-accounting-filter-status class="mt-1 w-full rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-medium normal-case tracking-normal text-[var(--koa-forest)]">
                    <option value="all">All statuses</option><option value="passed">Passed</option><option value="failed">Failed</option><option value="unverified">Unverified</option>
                  </select>
                </label>
                <label class="flex items-center gap-2 rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]"><input data-accounting-filter-taxable type="checkbox" class="h-4 w-4" /> Taxable lines only</label>
                <label class="flex items-center gap-2 rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]"><input data-accounting-filter-missing-estimate type="checkbox" class="h-4 w-4" /> Missing QBO estimate</label>
                <label class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)] sm:col-span-2 lg:col-span-2">Release
                  <select data-accounting-release-select class="mt-1 w-full rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-medium normal-case tracking-normal text-[var(--koa-forest)]"></select>
                </label>
              </div>
            </div>
            <div class="mt-4 rounded-xl bg-[var(--koa-ivory)] p-4" data-accounting-repair-queue>
              <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                <div>
                  <strong class="text-sm text-[var(--koa-forest)]">Safe repair queue</strong>
                  <p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/50">Every QuickBooks write requires a fresh live preview, explicit approval, and a fingerprint recheck before anything changes.</p>
                </div>
                <button data-accounting-filter-clear type="button" class="w-fit rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Clear queue filter</button>
              </div>
              <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                <button data-accounting-queue-filter="missing-estimate" type="button" class="rounded-lg border border-[var(--koa-line)] bg-white p-3 text-left"><span class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Missing QBO estimate</span><strong data-accounting-queue-count="missing-estimate" class="mt-1 block text-xl text-[var(--koa-forest)]">0</strong></button>
                <button data-accounting-queue-filter="taxable-lines" type="button" class="rounded-lg border border-[var(--koa-line)] bg-white p-3 text-left"><span class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Taxable lines</span><strong data-accounting-queue-count="taxable-lines" class="mt-1 block text-xl text-[var(--koa-forest)]">0</strong></button>
                <button data-accounting-queue-filter="sales-line-mismatch" type="button" class="rounded-lg border border-[var(--koa-line)] bg-white p-3 text-left"><span class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Sales-line mismatch</span><strong data-accounting-queue-count="sales-line-mismatch" class="mt-1 block text-xl text-[var(--koa-forest)]">0</strong></button>
                <button data-accounting-queue-filter="unverified" type="button" class="rounded-lg border border-[var(--koa-line)] bg-white p-3 text-left"><span class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Unverified</span><strong data-accounting-queue-count="unverified" class="mt-1 block text-xl text-[var(--koa-forest)]">0</strong></button>
              </div>
            </div>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full min-w-[1460px] border-collapse text-xs">
                <thead><tr class="border-b border-[var(--koa-line)] text-left text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">
                  <th class="py-3 pr-4">Client</th><th class="py-3 pr-4">CRM total</th><th class="py-3 pr-4">Sales lines</th><th class="py-3 pr-4">QBO adjustment</th><th class="py-3 pr-4">QBO estimate</th><th class="py-3 pr-4">Estimate</th><th class="py-3 pr-4">Taxable lines</th><th class="py-3 pr-4">Queue</th><th class="py-3 pr-4">Status</th><th class="py-3 pr-4">Failure reason</th><th class="py-3">Action</th>
                </tr></thead>
                <tbody data-accounting-invariant-table-body></tbody>
              </table>
            </div>
            <p data-accounting-invariant-table-empty class="mt-3 hidden text-xs text-[var(--koa-ink)]/50">No client invariant rows match these filters.</p>
          </div>
          <dialog data-accounting-repair-dialog class="w-[min(94vw,900px)] rounded-[1.4rem] border-0 bg-white p-0 shadow-2xl backdrop:bg-black/40">
            <div class="p-6">
              <div class="flex items-start justify-between gap-4">
                <div><p class="eyebrow text-[var(--koa-clay)]">Preview before change</p><h3 data-accounting-repair-title class="display mt-2 text-3xl text-[var(--koa-forest)]">Accounting repair preview</h3><p data-accounting-repair-meta class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/55"></p></div>
                <button data-accounting-repair-close type="button" class="text-2xl leading-none text-[var(--koa-ink)]/40" aria-label="Close repair preview">×</button>
              </div>
              <div data-accounting-repair-body class="mt-5 grid gap-3"></div>
