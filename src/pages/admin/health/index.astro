    mobileHealthQuery.addEventListener?.('change',(event)=>{
      document.querySelectorAll('[data-mobile-collapsible]').forEach((section)=>{
        if(!(section instanceof HTMLElement))return;
        if(!event.matches){
          setMobileCollapsed(section,false);
        }else if(section.dataset.healthSectionStatus==='red'||isHealthSectionRememberedOpen(section)){
          setMobileCollapsed(section,false);
        }else{
          setMobileCollapsed(section,true);
        }
      });
      refreshMobileHealthPresentation();
    });

    window.setInterval(()=>{
      const banner=document.querySelector('[data-health-all-good]');
      if(banner instanceof HTMLElement&&!banner.classList.contains('hidden'))updateAllSystemsGoodTime();
    },30000);

    initializeMobileHealthExperience();



    function healthStatusFromChecks(rows){
      const severities=(Array.isArray(rows)?rows:[]).map(normalizedSeverity);
      const red=severities.filter((value)=>value==='critical').length;
      const yellow=severities.filter((value)=>value==='warning').length;
      return {status:red?'red':yellow?'yellow':'green',count:red||yellow};
    }

    function refreshHealthSectionStatuses(data){
      latestHealthSnapshot=data?.current||null;
      latestHealthyCheckAt=String(data?.current?.checkedAt||'');
      const currentChecks=Array.isArray(data?.current?.checks)?data.current.checks:[];
      const allStatus=healthStatusFromChecks(currentChecks);
      const problemChecks=currentChecks.filter((row)=>['critical','warning'].includes(normalizedSeverity(row)));
      const configChecks=problemChecks.filter((row)=>['Configuration Problem','Permission Problem'].includes(String(row?.issueType||'')));
      const configStatus=healthStatusFromChecks(configChecks);
      const deploymentChecks=currentChecks.filter((row)=>/deploy|netlify|github|release/i.test(String(row?.id||'')+' '+String(row?.name||'')));
      const deploymentStatus=healthStatusFromChecks(deploymentChecks);
      const apiProblems=problemChecks.filter((row)=>String(row?.kind||'').toLowerCase()==='api'||String(row?.path||'').startsWith('/api/'));
      const pageProblems=problemChecks.filter((row)=>!apiProblems.includes(row));
      const rootCauseGroups=new Set(problemChecks.map((row)=>String(row?.issueType||'').trim()).filter(Boolean));

      const actionItems=[...document.querySelectorAll('[data-needs-action-item]')];
      const actionRed=actionItems.filter((item)=>item instanceof HTMLElement&&item.dataset.needsActionSeverity==='red').length;
      const actionSummary=actionItems.length
        ? actionItems.length+' item'+(actionItems.length===1?'':'s')+' need'+(actionItems.length===1?'s':'')+' manual action'
        : 'No manual action needed';
      setHealthSectionStatus(
        document.querySelector('#health-needs-action'),
        actionRed?'red':actionItems.length?'yellow':'green',
        actionItems.length,
        actionSummary
      );

      const rootSummary=rootCauseGroups.size
        ? rootCauseGroups.size+' active root-cause '+(rootCauseGroups.size===1?'category':'categories')
        : 'No active root causes';
      setHealthSectionStatus(document.querySelector('#health-root-causes'),allStatus.status,allStatus.count,rootSummary);

      let pagesSummary='All monitored pages and APIs healthy';
      if(problemChecks.length){
        const parts=[];
        if(apiProblems.length)parts.push(apiProblems.length+' API '+(apiProblems.length===1?'check':'checks'));
        if(pageProblems.length)parts.push(pageProblems.length+' page '+(pageProblems.length===1?'check':'checks'));
        pagesSummary=parts.join(' + ')+' need attention';
      }
      setHealthSectionStatus(document.querySelector('#health-pages-apis'),allStatus.status,allStatus.count,pagesSummary);

      const credentialState=String(data?.credentialHealth?.operationalOverall||data?.credentialHealth?.overall||'green');
      const credentialReliabilityState=String(data?.credentialHealth?.reliability?.overall||'insufficient');
      const credentialRows=Array.isArray(data?.credentialHealth?.rows)?data.credentialHealth.rows:[];
      const credentialProblems=credentialRows.filter((row)=>!row?.ok);
      const reliabilityLabel=
        credentialReliabilityState==='red'?'historical reliability critical':
        credentialReliabilityState==='yellow'?'historical reliability below target':
        credentialReliabilityState==='green'?'historical reliability healthy':'reliability history still building';
      const credentialSummary=credentialProblems.length
        ? credentialProblems.length+' current credential '+(credentialProblems.length===1?'warning':'warnings')+' · '+reliabilityLabel
        : credentialRows.length?'All current credentials valid · '+reliabilityLabel:'Credential checks not available yet';
      const combinedCredentialSectionState=
        credentialState==='red'?'red':
        credentialState==='yellow'?'yellow':
        credentialReliabilityState==='red'?'red':
        credentialReliabilityState==='yellow'?'yellow':'green';
      setHealthSectionStatus(
        document.querySelector('#credential-health'),
        combinedCredentialSectionState,
        credentialProblems.length,
        credentialSummary
      );

      const releaseCheck=currentChecks.find((row)=>row?.id==='email-release-sync');
      let emailState=String(data?.emailHealth?.overall||'green');
      if(String(releaseCheck?.severity||'')==='red')emailState='red';
      else if(String(releaseCheck?.severity||'')==='yellow'&&emailState==='green')emailState='yellow';
      const emailSummary=emailState==='green'
        ? 'Email delivery, templates, and renderer healthy'
        : String(releaseCheck?.deploymentDetails?.emailRenderingBehind?'Production email renderer is behind GitHub main':'Email Health needs attention');
      setHealthSectionStatus(document.querySelector('#health-email'),emailState==='red'?'red':emailState==='yellow'?'yellow':'green',emailState==='green'?0:1,emailSummary);

      const officeState=String(data?.office365?.severity||'green');
      const officeOperational=String(data?.office365?.operationalStatus||'unknown');
      const officeSummaryMap:Record<string,string>={
        scheduled:'Calendar sync scheduled and healthy',
        paused:'Calendar sync intentionally paused',
        saver:'Calendar sync running in Saver mode',
        authentication_failed:'Microsoft Graph authentication failed',
        production_behind:'Calendar verification blocked by production version',
        schedule_missing:'Office 365 scheduled sync is missing',
        not_configured:'Office 365 configuration is incomplete',
        deployment_catching_up:'Calendar verification waiting for deployment',
        unknown:'Office 365 status is unavailable',
      };
      const officeSummary=officeSummaryMap[officeOperational]||'Office 365 calendar sync needs attention';
      setHealthSectionStatus(document.querySelector('#health-office365'),officeState==='red'?'red':officeState==='yellow'?'yellow':'green',officeState==='green'?0:1,officeSummary);

      const deploymentSummary=deploymentStatus.count
        ? deploymentStatus.count+' deployment '+(deploymentStatus.count===1?'check':'checks')+' need attention'
        : 'Production deployment checks are healthy';
      setHealthSectionStatus(document.querySelector('#health-deployment'),deploymentStatus.status,deploymentStatus.count,deploymentSummary);

      const weeklySummary=allStatus.count
        ? allStatus.count+' current '+(allStatus.count===1?'issue is':'issues are')+' reflected in this summary'
        : 'Current reliability signals are healthy';
      setHealthSectionStatus(document.querySelector('#health-weekly'),allStatus.status,allStatus.count,weeklySummary);

      const incidentRows=Array.isArray(data?.incidents?.rows)?data.incidents.rows:[];
      const ongoing=incidentRows.filter((row)=>row?.currentIncident).length;
      const recent=Array.isArray(data?.incidents?.recentIncidents)?data.incidents.recentIncidents:[];
      const incidentSummary=ongoing
        ? ongoing+' ongoing '+(ongoing===1?'incident':'incidents')
        : recent.length
          ? recent.length+' recent '+(recent.length===1?'incident':'incidents')+' · none ongoing'
          : 'No observed incidents';
      setHealthSectionStatus(document.querySelector('#health-incidents'),ongoing?'red':recent.length?'yellow':'green',ongoing||recent.length,incidentSummary);

      const uptimeRows=Array.isArray(data?.uptime?.rows)?data.uptime.rows:[];
      const degraded24=uptimeRows.filter((row)=>{
        const value=Number(row?.periods?.['24h']?.uptime);
        return Number.isFinite(value)&&value<100;
      });
      const uptimeSummary=!uptimeRows.length
        ? 'Uptime history is still collecting'
        : degraded24.length
          ? degraded24.length+' service'+(degraded24.length===1?'':'s')+' below 100% uptime in the last 24h'
          : 'All monitored services at 100% uptime in the last 24h';
      setHealthSectionStatus(document.querySelector('#health-uptime'),degraded24.length?'yellow':'green',degraded24.length,uptimeSummary);

      const publicStatusOn=Boolean(data?.policy?.publicStatusEnabled);
      setHealthSectionStatus(
        document.querySelector('#health-notifications'),
        'green',
        0,
        publicStatusOn?'Alert policy active · public status enabled':'Alert policy active · public status off'
      );

      const historySummary=allStatus.count
        ? 'Latest health check has '+allStatus.count+' '+(allStatus.count===1?'issue':'issues')
        : data?.current?.checkedAt?'Latest health check is healthy':'No health snapshot recorded yet';
      setHealthSectionStatus(document.querySelector('#health-history'),allStatus.status,allStatus.count,historySummary);

      const creditUsage=data?.deployments?.creditUsage||{};
      const credit=String(creditUsage?.warningSeverity||creditUsage?.severity||'green');
      const projected=creditUsage?.projectedAllowancePercent??creditUsage?.projection?.projectedAllowancePercent??null;
      const creditSummary=projected!=null
        ? 'Projected '+String(projected)+'% of monthly Netlify credit allowance'
        : credit==='green'?'Netlify credit usage is within the configured allowance':'Netlify credit usage needs attention';
      setHealthSectionStatus(document.querySelector('[data-credit-panel]'),credit==='red'?'red':['orange','yellow'].includes(credit)?'yellow':'green',credit==='green'?0:1,creditSummary);

      healthSectionStatusesReady=true;
      refreshMobileHealthPresentation();
      updateSeverityBadgeSectionHints();
    }

    function goToHighestPriorityProblem(){
      const actionItems=[...document.querySelectorAll('[data-needs-action-item]')];
      const redAction=actionItems.find((item)=>item instanceof HTMLElement&&item.dataset.needsActionSeverity==='red');
      const firstAction=redAction||actionItems[0];
      if(firstAction instanceof HTMLElement){
        jumpToHealthSection('#health-needs-action');
        window.setTimeout(()=>{
          firstAction.scrollIntoView({behavior:'smooth',block:'center'});
          firstAction.classList.add('ring-2','ring-red-700','ring-offset-2');
          window.setTimeout(()=>firstAction.classList.remove('ring-2','ring-red-700','ring-offset-2'),1800);
        },320);
        return;
      }

      activeRootCause='';
      activeSeverity='';
      if(failuresOnly)failuresOnly.checked=true;
      renderRootCauseSummary(latestHealthChecks);
      renderHealthChecks();
      const firstProblem=results.querySelector('[data-health-severity="critical"], [data-health-severity="warning"]');
      if(firstProblem instanceof HTMLElement){
        jumpToHealthSection('#health-pages-apis');
        window.setTimeout(()=>{
          firstProblem.scrollIntoView({behavior:'smooth',block:'center'});
          firstProblem.focus({preventScroll:true});
          firstProblem.classList.add('ring-2','ring-red-700','ring-offset-2');
          window.setTimeout(()=>firstProblem.classList.remove('ring-2','ring-red-700','ring-offset-2'),1800);
        },320);
        return;
      }

      jumpToHealthSection('#health-summary');
    }

    function handleHealthPriorityHash(){
      if(window.location.hash==='#health-priority'){
        window.setTimeout(goToHighestPriorityProblem,80);
      }
    }

    window.addEventListener('hashchange',handleHealthPriorityHash);

    function formatDuration(minutes){
      const value=Math.max(0,Number(minutes||0));
      const days=Math.floor(value/1440);
      const hours=Math.floor((value%1440)/60);
      const mins=Math.round(value%60);
      const parts=[];
      if(days)parts.push(days+'d');
      if(hours)parts.push(hours+'h');
      if(mins||!parts.length)parts.push(mins+'m');
      return parts.join(' ');
    }

    function renderReleaseTimeline(){
      releaseTimeline.innerHTML='';
      const term=String(releaseSearch?.value||'').trim().toLowerCase();
      const category=String(releaseFilter?.value||'all');
      const releases=latestReleases.filter((release)=>{
        const haystack=[
          release.commitTitle,release.commitMessage,release.commit,release.deployId,release.summary,
          release.authorName,release.authorLogin,release.pullRequestNumber,release.pullRequestUrl,
          ...(release.features||[]),...(release.changedFiles||[])
        ].join(' ').toLowerCase();
        const termOk=!term||haystack.includes(term);
        const features=new Set(release.features||[]);
        const categoryOk=
          category==='all' ||
          (category==='crm' && (features.has('Business CRM')||features.has('Sales CRM & Proposals'))) ||
          (category==='quickbooks' && features.has('QuickBooks')) ||
          (category==='website' && ['Public Website','Blog','Gallery','Local SEO'].some(value=>features.has(value))) ||
          (category==='security' && ['Authentication & Security','System Health'].some(value=>features.has(value))) ||
          (category==='vendor' && ['Vendor CRM','Insurance Compliance'].some(value=>features.has(value))) ||
          (category==='users' && features.has('User Management'));
        return termOk&&categoryOk;
      });
      releases.forEach((release)=>{
        const index=latestReleases.indexOf(release);
        const button=document.createElement('button');
        button.type='button';
        button.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 text-left transition hover:border-[var(--koa-clay)]';
        const qaLabel=release.qa?.conclusion==='success'?'QA passed':release.qa?.conclusion==='failure'?'QA failed':'QA unavailable';
        const probeAudit=release.syntheticProbeVerification||null;
        const probePassed=probeAudit?.status==='passed';
        const probeLabel=probeAudit
          ? Number(probeAudit.healthyCount||0)+'/'+Number(probeAudit.totalCount||4)+' integrations'
          : 'Probe audit unavailable';
        const incidentCount=(release.incidents||[]).length;
        button.innerHTML='<div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-[.55rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Release '+(index+1)+'</p><strong class="mt-1 block text-sm text-[var(--koa-forest)]"></strong><p class="mt-1 break-all text-xs text-[var(--koa-ink)]/45"></p></div><div class="flex flex-wrap gap-2"><span class="rounded-full px-3 py-1 text-[.56rem] font-black uppercase tracking-[.06em] '+(release.qa?.conclusion==='success'?'bg-emerald-100 text-emerald-800':release.qa?.conclusion==='failure'?'bg-red-100 text-red-800':'bg-[var(--koa-sand)] text-[var(--koa-forest)]')+'">'+qaLabel+'</span><span data-release-probes class="rounded-full px-3 py-1 text-[.56rem] font-black uppercase tracking-[.06em] '+(probeAudit?(probePassed?'bg-emerald-100 text-emerald-800':'bg-red-100 text-red-800'):'bg-slate-100 text-slate-700')+'">'+probeLabel+'</span></div></div><p data-release-summary class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/65"></p><p data-release-meta class="mt-2 text-xs text-[var(--koa-ink)]/55"></p>';
        button.querySelector('strong').textContent=release.commitTitle||'Production release';
        button.querySelector('p.text-xs').textContent=(release.commit||'').slice(0,12)+' · '+(release.deployId||'');
        button.querySelector('[data-release-summary]').textContent=release.summary||'Release summary not recorded yet.';
        const author=release.authorLogin?'@'+release.authorLogin:(release.authorName||'Unknown author');
        const pr=release.pullRequestNumber?'PR #'+release.pullRequestNumber:'No PR linked';
        button.querySelector('[data-release-meta]').textContent=author+' · '+pr+' · '+(release.publishedAt?new Date(release.publishedAt).toLocaleString():'Unknown deployment time')+' · '+(release.deployDurationSeconds==null?'duration unavailable':release.deployDurationSeconds+'s deploy')+' · '+incidentCount+' incident'+(incidentCount===1?'':'s')+' began';
        button.addEventListener('click',()=>showRelease(release));
        releaseTimeline.appendChild(button);
      });
      if(!releases.length)releaseTimeline.innerHTML='<p class="text-sm text-[var(--koa-ink)]/50">No releases match the current search/filter.</p>';
    }

    function populateCompareSelectors(){
      const currentBase=compareBase.value;
      const currentHead=compareHead.value;
      const options=latestReleases.map((release,index)=>'<option value="'+release.commit+'">'+(index+1)+'. '+(release.commitTitle||'Production release')+' · '+String(release.commit||'').slice(0,8)+'</option>').join('');
      compareBase.innerHTML='<option value="">Older release</option>'+options;
      compareHead.innerHTML='<option value="">Newer release</option>'+options;
      if(latestReleases.length>=2){
        compareBase.value=currentBase||latestReleases[1].commit;
        compareHead.value=currentHead||latestReleases[0].commit;
      }
    }

    function showComparison(comparison){
      compareDetail.innerHTML='';
      compareTitle.textContent='Release comparison';
      const stats=document.createElement('section');stats.className='grid gap-3 sm:grid-cols-4';
      [
        ['Commits',String(comparison.totalCommits||0)],
        ['Files',String((comparison.files||[]).length)],
        ['Additions',String((comparison.files||[]).reduce((sum,file)=>sum+Number(file.additions||0),0))],
        ['Deletions',String((comparison.files||[]).reduce((sum,file)=>sum+Number(file.deletions||0),0))],
      ].forEach(([label,value])=>{
        const card=document.createElement('div');card.className='rounded-xl bg-[var(--koa-sand)] p-4';
        card.innerHTML='<p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]"></p><p class="mt-2 text-lg font-semibold text-[var(--koa-forest)]"></p>';
        card.children[0].textContent=label;card.children[1].textContent=value;stats.appendChild(card);
      });
      compareDetail.appendChild(stats);

      const risks=document.createElement('section');
      const riskLevel=String(comparison.riskLevel||'low');
      risks.className='rounded-xl border '+(riskLevel==='high'?'border-red-200 bg-red-50':riskLevel==='medium'?'border-amber-200 bg-amber-50':'border-emerald-200 bg-emerald-50')+' p-4';
      risks.innerHTML='<div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-[.56rem] font-black uppercase tracking-[.09em] '+(riskLevel==='high'?'text-red-700':riskLevel==='medium'?'text-amber-800':'text-emerald-800')+'">Potentially risky changes</p><p class="mt-1 text-sm font-semibold text-[var(--koa-forest)]">'+(riskLevel==='high'?'High review attention':riskLevel==='medium'?'Review recommended':'No high-risk categories detected')+'</p></div><span class="rounded-full px-3 py-1 text-[.56rem] font-black uppercase tracking-[.06em] '+(riskLevel==='high'?'bg-red-700 text-white':riskLevel==='medium'?'bg-amber-200 text-amber-950':'bg-emerald-700 text-white')+'">'+riskLevel+'</span></div>';
      const riskList=document.createElement('div');riskList.className='mt-3 grid gap-2';
      (comparison.riskFlags||[]).forEach((flag)=>{
        const row=document.createElement('details');row.className='rounded-lg border border-black/10 bg-white/70 p-3';
        row.innerHTML='<summary class="cursor-pointer text-sm font-semibold text-[var(--koa-forest)]"></summary><p class="mt-2 text-xs text-[var(--koa-ink)]/55"></p>';
        row.querySelector('summary').textContent=flag.label+' · '+String(flag.severity||'').toUpperCase();
        const pieces=[];
        if((flag.files||[]).length)pieces.push('Files: '+flag.files.join(', '));
        if((flag.commits||[]).length)pieces.push('Commits: '+flag.commits.join(' | '));
        row.querySelector('p').textContent=pieces.join(' · ')||'Flagged by release-risk rules.';
        riskList.appendChild(row);
      });
      if(!(comparison.riskFlags||[]).length)riskList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No authentication, payment, CRM deletion, form, security, storage, or environment-variable risk categories were detected.</p>';
      risks.appendChild(riskList);compareDetail.appendChild(risks);

      const features=document.createElement('section');
      features.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Features affected</p>';
      const chips=document.createElement('div');chips.className='mt-3 flex flex-wrap gap-2';
      (comparison.features||[]).forEach((feature)=>{const chip=document.createElement('span');chip.className='rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]';chip.textContent=feature;chips.appendChild(chip);});
      if(!(comparison.features||[]).length)chips.innerHTML='<span class="text-sm text-[var(--koa-ink)]/48">No categorized feature changes.</span>';
      features.appendChild(chips);compareDetail.appendChild(features);

      const behavior=document.createElement('section');
      behavior.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Behavior changes</p>';
      const behaviorList=document.createElement('div');behaviorList.className='mt-3 grid gap-2';
      (comparison.behaviorChanges||[]).forEach((item)=>{const row=document.createElement('div');row.className='rounded-xl border border-[var(--koa-line)] p-3 text-sm text-[var(--koa-forest)]';row.textContent=item;behaviorList.appendChild(row);});
      if(!(comparison.behaviorChanges||[]).length)behaviorList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No commit-level behavior notes were found.</p>';
      behavior.appendChild(behaviorList);compareDetail.appendChild(behavior);

      const files=document.createElement('section');
      files.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Changed files</p>';
      const fileList=document.createElement('div');fileList.className='mt-3 max-h-[420px] overflow-auto rounded-xl border border-[var(--koa-line)]';
      (comparison.files||[]).forEach((file)=>{
        const row=document.createElement('div');row.className='border-b border-[var(--koa-line)] p-3 last:border-b-0';
        row.innerHTML='<div class="flex flex-wrap items-center justify-between gap-3"><code class="text-xs text-[var(--koa-forest)]"></code><span class="text-[.55rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]"></span></div><p class="mt-1 text-xs text-[var(--koa-ink)]/48"></p>';
        row.querySelector('code').textContent=file.filename;
        row.querySelector('span').textContent=file.status||'changed';
        row.querySelector('p').textContent='+'+Number(file.additions||0)+' / -'+Number(file.deletions||0)+' · '+Number(file.changes||0)+' total changes';
        fileList.appendChild(row);
      });
      if(!(comparison.files||[]).length)fileList.innerHTML='<p class="p-4 text-sm text-[var(--koa-ink)]/48">No file differences.</p>';
      files.appendChild(fileList);compareDetail.appendChild(files);
      compareDialog.showModal();
    }

    function showRelease(release){
      releaseTitle.textContent=release.commitTitle||'Production release';
      releaseDetail.innerHTML='';

      const summary=document.createElement('section');
      summary.className='rounded-xl bg-[var(--koa-sand)] p-4';
      const commitMessage=String(release.commitMessage||release.commitTitle||'No commit message recorded.');
      summary.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Commit</p><p class="mt-2 whitespace-pre-wrap font-semibold text-[var(--koa-forest)]"></p><p class="mt-3 break-all text-xs text-[var(--koa-ink)]/48"></p>';
      summary.querySelector('p.mt-2').textContent=commitMessage;
      summary.querySelector('p.mt-3').textContent='Commit '+(release.commit||'Unavailable')+' · Deploy '+(release.deployId||'Unavailable');
      releaseDetail.appendChild(summary);

      const releaseSummary=document.createElement('section');
      releaseSummary.className='rounded-xl border border-[var(--koa-line)] p-4';
      releaseSummary.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">What changed</p><p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/68"></p><div class="mt-3 flex flex-wrap gap-3 text-xs text-[var(--koa-ink)]/50"><span data-author></span><a data-pr class="hidden underline decoration-dotted underline-offset-4" target="_blank" rel="noopener noreferrer"></a></div>';
      releaseSummary.querySelector('p.mt-2').textContent=release.summary||'A plain-English release summary was not recorded for this deployment.';
      releaseSummary.querySelector('[data-author]').textContent='Author: '+(release.authorLogin?'@'+release.authorLogin:(release.authorName||'Unknown'));
      const prLink=releaseSummary.querySelector('[data-pr]');
      if(release.pullRequestUrl){
        prLink.href=release.pullRequestUrl;
        prLink.textContent='Pull request #'+(release.pullRequestNumber||'');
        prLink.classList.remove('hidden');
      }
      releaseDetail.appendChild(releaseSummary);

      const metrics=document.createElement('section');
      metrics.className='grid gap-3 sm:grid-cols-3';
      const qa=release.qa;
      const qaText=qa?.conclusion==='success'?'Passed':qa?.conclusion==='failure'?'Failed':qa?.status||'Unavailable';
      [
        ['Published',release.publishedAt?new Date(release.publishedAt).toLocaleString():'Unavailable'],
        ['Deploy duration',release.deployDurationSeconds==null?'Unavailable':release.deployDurationSeconds+' seconds'],
        ['QA result',qaText],
      ].forEach(([label,value])=>{
        const card=document.createElement('div');card.className='rounded-xl border border-[var(--koa-line)] p-4';
        card.innerHTML='<p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]"></p><p class="mt-2 text-sm font-semibold text-[var(--koa-forest)]"></p>';
        card.children[0].textContent=label;card.children[1].textContent=value;metrics.appendChild(card);
      });
      releaseDetail.appendChild(metrics);

      const probeAudit=release.syntheticProbeVerification||null;
      const probes=document.createElement('section');
      probes.className='rounded-xl border '+(probeAudit?.status==='passed'?'border-emerald-200 bg-emerald-50':probeAudit?'border-red-200 bg-red-50':'border-[var(--koa-line)] bg-[var(--koa-ivory)]')+' p-4';
      probes.innerHTML='<div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Critical Integrations release gate</p><p data-probe-summary class="mt-1 text-sm font-semibold text-[var(--koa-forest)]"></p></div><span data-probe-time class="text-xs text-[var(--koa-ink)]/48"></span></div><div data-probe-rows class="mt-3 grid gap-2"></div>';
      probes.querySelector('[data-probe-summary]').textContent=probeAudit
        ? Number(probeAudit.healthyCount||0)+' / '+Number(probeAudit.totalCount||4)+' passed · '+String(probeAudit.status||'unknown')
        : 'No stored probe audit for this older release.';
      probes.querySelector('[data-probe-time]').textContent=probeAudit?.checkedAt?new Date(probeAudit.checkedAt).toLocaleString():'';
      const probeRows=probes.querySelector('[data-probe-rows]');
      (probeAudit?.probes||[]).forEach((probe)=>{
        const row=document.createElement('div');
        const pass=Boolean(probe.ok)&&Number(probe.status)===204&&String(probe.marker||'')===String(probe.expectedMarker||'');
        row.className='rounded-lg border p-3 '+(pass?'border-emerald-200 bg-white':'border-red-200 bg-white');
        row.innerHTML='<div class="flex flex-wrap items-center justify-between gap-2"><strong class="text-xs text-[var(--koa-forest)]"></strong><span class="text-[.56rem] font-black uppercase tracking-[.06em]"></span></div><p class="mt-1 text-[.64rem] leading-5 text-[var(--koa-ink)]/55"></p>';
        row.querySelector('strong').textContent=String(probe.name||probe.id||'Synthetic probe');
        const badge=row.querySelector('span');
        badge.textContent=pass?'Passed':'Failed';
        badge.className='text-[.56rem] font-black uppercase tracking-[.06em] '+(pass?'text-emerald-800':'text-red-800');
        row.querySelector('p').textContent='HTTP '+String(probe.status||'—')+' · marker '+String(probe.marker||'none')+' · '+String(probe.source||'unknown')+' · last live '+(probe.lastLiveCheckedAt?new Date(probe.lastLiveCheckedAt).toLocaleString():'unknown');
        probeRows.appendChild(row);
      });
      if(!(probeAudit?.probes||[]).length)probeRows.innerHTML='<p class="text-xs text-[var(--koa-ink)]/48">Probe-level evidence was not recorded for this release.</p>';
      const rollback=release.rollbackProtection||null;
      if(rollback){
        const guard=document.createElement('p');
        guard.className='mt-3 rounded-lg border p-3 text-xs font-semibold '+(rollback.status==='rolled-back'?'border-amber-200 bg-amber-50 text-amber-950':'border-red-200 bg-red-50 text-red-900');
        guard.textContent=rollback.status==='rolled-back'
          ? 'Automatic rollback executed · restored deploy '+String(rollback.targetDeployId||'')+' ('+String(rollback.targetCommit||'').slice(0,12)+')'
          : 'Automatic rollback '+String(rollback.status||'failed')+' · '+String(rollback.error||rollback.reason||'');
        probes.appendChild(guard);
      }
      releaseDetail.appendChild(probes);

      const features=document.createElement('section');
      features.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Features changed</p>';
      const featureList=document.createElement('div');featureList.className='mt-3 flex flex-wrap gap-2';
      (release.features||[]).forEach((feature)=>{const chip=document.createElement('span');chip.className='rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-semibold text-[var(--koa-forest)]';chip.textContent=feature;featureList.appendChild(chip);});
      if(!(release.features||[]).length)featureList.innerHTML='<span class="text-sm text-[var(--koa-ink)]/48">No categorized feature changes were recorded.</span>';
      features.appendChild(featureList);releaseDetail.appendChild(features);

      const incidents=document.createElement('section');
      incidents.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Incidents that began during this release</p>';
      const incidentList=document.createElement('div');incidentList.className='mt-3 grid gap-2';
      (release.incidents||[]).forEach((incident)=>{
        const row=document.createElement('div');row.className='rounded-xl border border-red-100 bg-red-50 p-3';
        row.innerHTML='<strong class="text-sm text-red-900"></strong><p class="mt-1 text-xs text-red-900/65"></p>';
        row.querySelector('strong').textContent=incident.componentName||incident.componentId||'System incident';
        row.querySelector('p').textContent=(incident.startedAt?new Date(incident.startedAt).toLocaleString():'Unknown start')+' · '+formatDuration(incident.durationMinutes||0)+(incident.ongoing?' · ongoing':'');
        incidentList.appendChild(row);
      });
      if(!(release.incidents||[]).length)incidentList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No monitored incidents began while this release was live.</p>';
      incidents.appendChild(incidentList);releaseDetail.appendChild(incidents);

      const files=document.createElement('details');
      files.className='rounded-xl border border-[var(--koa-line)] p-4';
      files.innerHTML='<summary class="cursor-pointer text-sm font-semibold text-[var(--koa-forest)]">Changed files ('+(release.changedFiles||[]).length+')</summary>';
      const pre=document.createElement('pre');pre.className='mt-3 max-h-60 overflow-auto whitespace-pre-wrap text-xs text-[var(--koa-ink)]/55';pre.textContent=(release.changedFiles||[]).join('\n')||'No changed-file list recorded.';files.appendChild(pre);releaseDetail.appendChild(files);

      releaseDialog.showModal();
    }

    function renderEmailHealth(summary,current){
      const email=summary||{};
      const releaseCheck=(current?.checks||[]).find((row)=>row.id==='email-release-sync')||null;
      const releaseSeverity=String(releaseCheck?.severity||'green');
      const releaseDetails=releaseCheck?.deploymentDetails||{};
      let overallState=String(email.overall||'yellow');
      if(releaseSeverity==='red')overallState='red';
      else if(releaseSeverity==='yellow'&&overallState==='green')overallState='yellow';
      const overallMap={
        green:['Healthy','bg-emerald-100 text-emerald-800'],
        yellow:['Attention','bg-amber-100 text-amber-900'],
        red:['Critical','bg-red-100 text-red-800'],
      };
      const overallChoice=overallMap[overallState]||overallMap.yellow;
      if(emailHealthOverall){
        emailHealthOverall.textContent=overallChoice[0];
        emailHealthOverall.className='rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+overallChoice[1];
      }

      const logo=email.logo||{};
      if(emailHealthLogo){
        emailHealthLogo.textContent=logo.ok?'Available':'Unavailable';
        emailHealthLogo.className='mt-2 text-sm font-semibold '+(logo.ok?'text-emerald-800':'text-red-800');
      }
      if(emailHealthLogoDetail)emailHealthLogoDetail.textContent=(logo.status?'HTTP '+logo.status+' · ':'')+(logo.contentType||'')+(logo.ms!=null?' · '+logo.ms+' ms':'');

      const sendAccess=email.sendAccess||{};
      if(emailHealthSend){
        emailHealthSend.textContent=sendAccess.ok?'Available':'Unavailable';
        emailHealthSend.className='mt-2 text-sm font-semibold '+(sendAccess.ok?'text-emerald-800':'text-red-800');
      }
      if(emailHealthSendDetail)emailHealthSendDetail.textContent=sendAccess.detail||'';

      const monitoringAccess=email.monitoringAccess||{};
      if(emailHealthMonitoring){
        emailHealthMonitoring.textContent=monitoringAccess.reachable?'Available':monitoringAccess.configured?'Permission/configuration issue':'Not configured';
        emailHealthMonitoring.className='mt-2 text-sm font-semibold '+(monitoringAccess.reachable?'text-emerald-800':'text-amber-800');
      }
      if(emailHealthMonitoringDetail)emailHealthMonitoringDetail.textContent=monitoringAccess.detail||'';

      const delivery=email.delivery||{};
      if(emailHealthSource)emailHealthSource.textContent=delivery.source==='resend-api'?'Resend API':delivery.source==='signed-webhook-history'?'Signed webhook history':'No delivery history';
      if(emailHealthSourceDetail){
        const parts=[];
        const webhook=delivery.webhook||{};
        parts.push(delivery.apiConfigured?'API key configured':'API key missing');
        if(webhook.existsInResend===true){
          parts.push(webhook.enabled===false?'Resend webhook exists but is disabled':'Resend webhook exists and is enabled');
        }else if(webhook.existsInResend===false){
          parts.push('Resend webhook not found');
        }else{
          parts.push('Resend webhook existence not verified');
        }
        parts.push(webhook.signingSecretConfigured||delivery.webhookConfigured
          ? 'Netlify signing secret configured'
          : 'Netlify signing secret missing');
        if(webhook.detail)parts.push(webhook.detail);
        else if(delivery.apiDetail)parts.push(delivery.apiDetail);
        emailHealthSourceDetail.textContent=parts.join(' · ');
      }

      const webhookDelivery=delivery.webhookDelivery||{};
      if(emailWebhookDeliveryStatus){
        const state=String(webhookDelivery.status||'unknown').toLowerCase();
        const labels:Record<string,string>={
          success:'Successful',
          failed:'Failed',
          pending:'Pending',
          attempting:'Attempting',
          none:'No events yet',
          unknown:'Not verified',
        };
        emailWebhookDeliveryStatus.textContent=labels[state]||state;
        emailWebhookDeliveryStatus.className='text-sm font-semibold '+(
          state==='success'?'text-emerald-800':
          state==='failed'?'text-red-800':
          ['pending','attempting'].includes(state)?'text-amber-800':'text-slate-700'
        );
      }
      if(emailWebhookDeliveryHttp){
        const httpStatus=Number(webhookDelivery?.attempt?.httpStatus||0);
        emailWebhookDeliveryHttp.textContent=httpStatus?'HTTP '+httpStatus:'';
        emailWebhookDeliveryHttp.classList.toggle('hidden',!httpStatus);
        emailWebhookDeliveryHttp.className=(httpStatus?'':'hidden ')+'rounded-full px-2.5 py-1 text-[.52rem] font-black uppercase tracking-[.07em] '+(
          httpStatus>=200&&httpStatus<300?'bg-emerald-100 text-emerald-800':
          httpStatus?'bg-red-100 text-red-800':'bg-slate-100 text-slate-700'
        );
      }
      if(emailWebhookDeliveryDetail){
        const detailParts=[];
        if(webhookDelivery.eventType)detailParts.push(String(webhookDelivery.eventType));
        const deliveredAt=String(webhookDelivery?.attempt?.sentAt||webhookDelivery.createdAt||'');
        if(deliveredAt)detailParts.push(new Date(deliveredAt).toLocaleString());
        if(webhookDelivery.detail)detailParts.push(String(webhookDelivery.detail));
        emailWebhookDeliveryDetail.textContent=detailParts.join(' · ');
      }

      const templates=email.templateCompatibility||{};
      if(emailHealthTemplates){
        emailHealthTemplates.textContent=templates.passed?Number(templates.templateCount||0)+' templates passing':'Compatibility gate failed';
        emailHealthTemplates.className='mt-2 text-sm font-semibold '+(templates.passed?'text-emerald-800':'text-red-800');
      }
      if(emailHealthTemplateDetail)emailHealthTemplateDetail.textContent=templates.detail||'';
      if(emailHealthChecked)emailHealthChecked.textContent=email.generatedAt?new Date(email.generatedAt).toLocaleString():'—';

      if(emailHealthRelease){
        const behind=Boolean(releaseDetails.emailRenderingBehind);
        const commitsBehind=Number(releaseDetails.commitsBehind||0);
        emailHealthRelease.textContent=behind
          ? commitsBehind+' commit'+(commitsBehind===1?'':'s')+' behind'
          : releaseSeverity==='yellow'
            ? 'Verification attention'
            : 'Current';
        emailHealthRelease.className='mt-2 text-sm font-semibold '+(releaseSeverity==='red'?'text-red-800':releaseSeverity==='yellow'?'text-amber-800':'text-emerald-800');
      }
      if(emailHealthReleaseMeta){
        const live=String(releaseDetails.netlifyCommit||'').slice(0,12);
        const main=String(releaseDetails.githubCommit||'').slice(0,12);
        emailHealthReleaseMeta.textContent=(live?'Production '+live:'Production commit unavailable')+(main?' · Main '+main:'');
      }
      if(emailHealthReleaseAlert){
        const show=releaseSeverity==='yellow'||releaseSeverity==='red';
        const changed=Array.isArray(releaseDetails.emailRenderingChangedFiles)?releaseDetails.emailRenderingChangedFiles:[];
        const liveCommit=String(releaseDetails.netlifyCommit||'');
        const mainCommit=String(releaseDetails.githubCommit||'');
        const deployId=String(releaseDetails.netlifyDeployId||'');
        emailHealthReleaseAlert.classList.toggle('hidden',!show);
        emailHealthReleaseAlert.className='mt-5 rounded-[1.2rem] border p-5 '+(show?'':'hidden ')+(releaseSeverity==='red'?'border-red-200 bg-red-50 text-red-900':'border-amber-200 bg-amber-50 text-amber-900');
        if(emailHealthReleaseTitle)emailHealthReleaseTitle.textContent=releaseSeverity==='red'
          ? 'Production is serving an older email renderer.'
          : 'A newer email-rendering release is waiting to reach production.';
        if(emailHealthReleaseDetail){
          emailHealthReleaseDetail.textContent=String(releaseCheck?.detail||'')
            +(changed.length?' Pending email files: '+changed.join(', '):'');
        }
        if(emailHealthReleaseActions){
          emailHealthReleaseActions.innerHTML='';
          if(deployId){
            const deployment=document.createElement('a');
            deployment.href='https://app.netlify.com/projects/koasevents-website/deploys/'+encodeURIComponent(deployId);
            deployment.target='_blank';deployment.rel='noreferrer';
            deployment.className='rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.6rem] font-black uppercase tracking-[.08em] text-white';
            deployment.textContent='Open affected deploy';
            emailHealthReleaseActions.appendChild(deployment);
          }
          const fileRef=mainCommit||liveCommit||'main';
          changed.slice(0,8).forEach((file)=>{
            const link=document.createElement('a');
            link.href='https://github.com/AstroTat808/koasevents.com/blob/'+encodeURIComponent(fileRef)+'/'+String(file).split('/').map(encodeURIComponent).join('/');
            link.target='_blank';link.rel='noreferrer';
            link.className='rounded-full border border-current px-3 py-2 text-[.58rem] font-black uppercase tracking-[.06em]';
            link.textContent=String(file).split('/').pop()||String(file);
            emailHealthReleaseActions.appendChild(link);
          });
        }
      }

      if(emailRendererMatch||emailRendererLive||emailRendererMain||emailRendererDeploy){
        const liveCommit=String(releaseDetails.netlifyCommit||'');
        const mainCommit=String(releaseDetails.githubCommit||'');
        const deployId=String(releaseDetails.netlifyDeployId||'');
        const commitsKnown=Boolean(liveCommit&&mainCommit);
        const match=commitsKnown&&liveCommit===mainCommit;
        if(emailRendererMatch){
          emailRendererMatch.textContent=match?'Matched':commitsKnown?'Behind / different':'Unverified';
          emailRendererMatch.className='w-fit rounded-full px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] '+(match?'bg-emerald-100 text-emerald-800':commitsKnown?'bg-red-100 text-red-800':'bg-amber-100 text-amber-900');
        }
        if(emailRendererLive){
          emailRendererLive.textContent=liveCommit?liveCommit.slice(0,12):'Unavailable';
          emailRendererLive.href=liveCommit?'https://github.com/AstroTat808/koasevents.com/commit/'+encodeURIComponent(liveCommit):'#';
          emailRendererLive.classList.toggle('pointer-events-none',!liveCommit);
          emailRendererLive.classList.toggle('no-underline',!liveCommit);
        }
        if(emailRendererMain){
          emailRendererMain.textContent=mainCommit?mainCommit.slice(0,12):'Unavailable';
          emailRendererMain.href=mainCommit?'https://github.com/AstroTat808/koasevents.com/commit/'+encodeURIComponent(mainCommit):'#';
          emailRendererMain.classList.toggle('pointer-events-none',!mainCommit);
          emailRendererMain.classList.toggle('no-underline',!mainCommit);
        }
        if(emailRendererDeploy){
          emailRendererDeploy.textContent=deployId||'Unavailable';
          emailRendererDeploy.href=deployId?'https://app.netlify.com/projects/koasevents-website/deploys/'+encodeURIComponent(deployId):'#';
          emailRendererDeploy.classList.toggle('pointer-events-none',!deployId);
          emailRendererDeploy.classList.toggle('no-underline',!deployId);
        }
        if(emailRendererStatus){
          emailRendererStatus.textContent=match?'Production matches GitHub main':commitsKnown?'Production differs from GitHub main':'Commit comparison unavailable';
          emailRendererStatus.className='mt-2 text-sm font-semibold '+(match?'text-emerald-800':commitsKnown?'text-red-800':'text-amber-800');
        }
        if(emailRendererStatusDetail){
          const behindCount=Number(releaseDetails.commitsBehind||0);
          emailRendererStatusDetail.textContent=match
            ? 'The live email renderer is current.'
            : commitsKnown
              ? (behindCount?behindCount+' commit'+(behindCount===1?'':'s')+' behind.':'The commit identities differ.')
              : 'System Health could not verify both commit identities.';
        }
      }

      const p24=delivery.period24h||{};
      if(emailHealth24Total)emailHealth24Total.textContent=Number(p24.total||0)+' lifecycle events';
      if(emailHealth24Delivered)emailHealth24Delivered.textContent=String(Number(p24.delivered||0));
      if(emailHealth24Bounced)emailHealth24Bounced.textContent=String(Number(p24.bounced||0));
      if(emailHealth24Complained)emailHealth24Complained.textContent=String(Number(p24.complained||0));
      if(emailHealth24Failed)emailHealth24Failed.textContent=String(Number(p24.failed||0)+Number(p24.suppressed||0));
      if(emailHealth24Delayed)emailHealth24Delayed.textContent=String(Number(p24.delayed||0));

      const p7=delivery.period7d||{};
      if(emailHealth7Total)emailHealth7Total.textContent=Number(p7.total||0)+' lifecycle events';
      if(emailHealth7Rate)emailHealth7Rate.textContent=Number(p7.failureRate||0).toFixed(1)+'%';
      if(emailHealth7Bounced)emailHealth7Bounced.textContent=String(Number(p7.bounced||0));
      if(emailHealth7Complained)emailHealth7Complained.textContent=String(Number(p7.complained||0));
      if(emailHealth7Suppressed)emailHealth7Suppressed.textContent=String(Number(p7.suppressed||0));

      if(emailHealthIssues){
        emailHealthIssues.innerHTML='';
        const issues=Array.isArray(delivery.recentIssues)?delivery.recentIssues:[];
        if(!issues.length){
          emailHealthIssues.innerHTML='<p class="text-sm text-emerald-800">No recent bounced, complained, failed, suppressed, or delayed email events were found.</p>';
        }else{
          issues.forEach((issue)=>{
            const row=document.createElement('div');
            const red=['bounced','complained','failed','suppressed'].includes(String(issue.status||''));
            row.className='flex flex-col gap-1 rounded-xl border p-3 sm:flex-row sm:items-center sm:justify-between '+(red?'border-red-200 bg-red-50':'border-amber-200 bg-amber-50');
            const left=document.createElement('div');
            const status=document.createElement('strong');
            status.className='text-sm '+(red?'text-red-900':'text-amber-900');
            status.textContent=String(issue.status||'issue').replaceAll('_',' ');
            const id=document.createElement('p');
            id.className='mt-1 break-all text-[.68rem] text-[var(--koa-ink)]/50';
            id.textContent=String(issue.emailId||'');
            left.append(status,id);
            const when=document.createElement('span');
            when.className='text-xs text-[var(--koa-ink)]/48';
            when.textContent=issue.createdAt?new Date(issue.createdAt).toLocaleString():'';
            row.append(left,when);
            emailHealthIssues.appendChild(row);
          });
        }
      }
    }

    function rememberCredentialRetest(credentialId){
      const id=String(credentialId||'').trim();
      if(!id)return;
      try{
        sessionStorage.setItem('koaCredentialRetest',JSON.stringify({credentialId:id,openedAt:Date.now()}));
      }catch{}
    }

    function pendingCredentialRetest(){
      try{
        const raw=sessionStorage.getItem('koaCredentialRetest');
        if(!raw)return null;
        const parsed=JSON.parse(raw);
        const credentialId=String(parsed?.credentialId||'').trim();
        const openedAt=Number(parsed?.openedAt||0);
        return credentialId?{credentialId,openedAt}:null;
      }catch{
        return null;
      }
    }

    function clearPendingCredentialRetest(){
      try{sessionStorage.removeItem('koaCredentialRetest');}catch{}
    }

    async function retestCredential(credentialId,button=null){
      const id=String(credentialId||'').trim();
      if(!id||credentialRetestInFlight)return false;
      credentialRetestInFlight=true;
      const original=button?.textContent||'';
      if(button){
        button.disabled=true;
        button.textContent='Re-testing…';
      }
      try{
        const response=await fetch('/api/admin/health',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'retest-credential',credentialId:id}),
        });
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to re-test credential.');
        renderCredentialHealth(data.credentialHealth||{});
        clearPendingCredentialRetest();
        window.dispatchEvent(new CustomEvent('koa:workspace-alerts-refresh'));
        return true;
      }catch(error){
        if(button)button.textContent=error instanceof Error?error.message:'Re-test failed';
        return false;
      }finally{
        credentialRetestInFlight=false;
        if(button){
          window.setTimeout(()=>{
            button.disabled=false;
            if(button.isConnected)button.textContent=original||'Re-test only';
          },800);
        }
      }
    }

    async function maybeRetestPendingCredential(){
      const pending=pendingCredentialRetest();
      if(!pending||credentialRetestInFlight)return;
      if(Date.now()-Number(pending.openedAt||0)<1200)return;
      await retestCredential(pending.credentialId);
    }

    function renderCredentialReliability(reliability){
      if(!credentialReliabilityGrid)return;
      const providers=Array.isArray(reliability?.providers)?reliability.providers:[];
      if(credentialReliabilityNote){
        credentialReliabilityNote.textContent=String(reliability?.note||'Reliability is based on observed hourly Credential Health samples. Coverage grows over time.');
      }
      credentialReliabilityGrid.innerHTML='';
      const periodKeys=['7d','30d','90d'];
      providers.forEach((provider)=>{
        const severity=String(provider?.severity||'insufficient');
        const card=document.createElement('article');
        card.className='rounded-xl border p-4 '+(
          severity==='red'?'border-red-200 bg-red-50':
          severity==='yellow'?'border-amber-200 bg-amber-50':
          severity==='green'?'border-emerald-200 bg-emerald-50':
          'border-[var(--koa-line)] bg-white'
        );
        const top=document.createElement('div');
        top.className='flex items-start justify-between gap-3';
        const left=document.createElement('div');
        const title=document.createElement('h4');
        title.className='text-sm font-semibold text-[var(--koa-forest)]';
        title.textContent=String(provider.label||provider.id||'Provider');
        const meta=document.createElement('p');
        meta.className='mt-1 text-[.62rem] text-[var(--koa-ink)]/45';
        const credentialCount=Number(provider.credentialCount||1);
        meta.textContent=credentialCount+' credential check'+(credentialCount===1?'':'s');
        left.append(title,meta);
        const badge=document.createElement('span');
        badge.className='shrink-0 rounded-full px-2.5 py-1 text-[.5rem] font-black uppercase tracking-[.07em] '+(
          severity==='red'?'bg-red-100 text-red-800':
          severity==='yellow'?'bg-amber-100 text-amber-900':
          severity==='green'?'bg-emerald-100 text-emerald-800':
          'bg-slate-100 text-slate-700'
        );
        badge.textContent=severity==='red'?'Critical':severity==='yellow'?'Warning':severity==='green'?'Healthy':'Building';
        top.append(left,badge);

        const grid=document.createElement('div');
        grid.className='mt-3 grid grid-cols-3 gap-2';
        periodKeys.forEach((key)=>{
          const period=provider?.periods?.[key]||{};
          const box=document.createElement('div');
          box.className='rounded-lg bg-white/80 p-2 text-center';
          const label=document.createElement('p');
          label.className='text-[.5rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]';
          label.textContent=key;
          const value=document.createElement('strong');
          value.className='mt-1 block text-lg text-[var(--koa-forest)]';
          value.textContent=period.percentage==null?'—':Number(period.percentage).toFixed(1)+'%';
          const coverage=document.createElement('p');
          coverage.className='mt-1 text-[.54rem] leading-4 text-[var(--koa-ink)]/42';
          coverage.textContent=Number(period.samples||0)+' / '+Number(period.expectedSamples||0)+' hourly';
          box.append(label,value,coverage);
          grid.appendChild(box);
        });

        const thresholds=provider?.thresholds||{yellowBelow:99,redBelow:95};
        const controls=document.createElement('div');
        controls.className='mt-3 grid grid-cols-2 gap-2';
        const yellowLabel=document.createElement('label');
        yellowLabel.className='text-[.52rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]';
        yellowLabel.textContent='Yellow below %';
        const yellowInput=document.createElement('input');
        yellowInput.type='number';
        yellowInput.min='0';yellowInput.max='100';yellowInput.step='0.1';
        yellowInput.value=String(Number(thresholds.yellowBelow??99));
        yellowInput.dataset.credentialThresholdYellow=String(provider.id||'');
        yellowInput.className='mt-1 w-full rounded-lg border border-[var(--koa-line)] bg-white px-2 py-2 text-sm font-semibold text-[var(--koa-forest)]';
        yellowLabel.appendChild(yellowInput);
        const redLabel=document.createElement('label');
        redLabel.className='text-[.52rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]';
        redLabel.textContent='Red below %';
        const redInput=document.createElement('input');
        redInput.type='number';
        redInput.min='0';redInput.max='100';redInput.step='0.1';
        redInput.value=String(Number(thresholds.redBelow??95));
        redInput.dataset.credentialThresholdRed=String(provider.id||'');
        redInput.className='mt-1 w-full rounded-lg border border-[var(--koa-line)] bg-white px-2 py-2 text-sm font-semibold text-[var(--koa-forest)]';
        redLabel.appendChild(redInput);
        controls.append(yellowLabel,redLabel);

        const thresholdMeta=document.createElement('p');
        thresholdMeta.className='mt-2 text-[.58rem] leading-4 text-[var(--koa-ink)]/45';
        const firstVerifiedAt=String(provider?.firstVerifiedAt||'');
        thresholdMeta.textContent=(provider.thresholdActive
          ? '7-day threshold active · '+Number(provider?.periods?.['7d']?.samples||0)+' samples'
          : 'Threshold starts after '+Number(provider.minimumSamples||24)+' hourly samples.')
          +(firstVerifiedAt?' · Reliability baseline '+new Date(firstVerifiedAt).toLocaleString():'');

        const period7=provider?.periods?.['7d']||{};
        const minimumSamples=Number(provider.minimumSamples||24);
        const sampleCount=Number(period7.samples||0);
        const sampleProgress=Math.max(0,Math.min(100,minimumSamples?sampleCount/minimumSamples*100:100));
        const currentPercentage=period7.percentage==null?0:Number(period7.percentage);
        const healthyThreshold=Number(thresholds.yellowBelow??99);
        const healthyProgress=Math.max(0,Math.min(100,healthyThreshold?currentPercentage/healthyThreshold*100:100));

        const progressWrap=document.createElement('div');
        progressWrap.className='mt-3 grid gap-2';
        const makeProgress=(labelText,valueText,width,tone)=>{
          const wrap=document.createElement('div');
          const header=document.createElement('div');
          header.className='mb-1 flex items-center justify-between gap-2 text-[.54rem] font-bold text-[var(--koa-ink)]/55';
          const label=document.createElement('span');label.textContent=labelText;
          const value=document.createElement('span');value.textContent=valueText;
          header.append(label,value);
          const rail=document.createElement('div');rail.className='h-2 overflow-hidden rounded-full bg-white/80';
          const fill=document.createElement('div');
          fill.className='h-full rounded-full '+tone;
          fill.style.width=String(width)+'%';
          rail.appendChild(fill);wrap.append(header,rail);return wrap;
        };
        progressWrap.append(
          makeProgress('Sample readiness',sampleCount+' / '+minimumSamples, sampleProgress,'bg-[var(--koa-clay)]'),
          makeProgress('Healthy target',currentPercentage.toFixed(1)+'% / '+healthyThreshold+'%', healthyProgress,'bg-emerald-600')
        );

        const recovery=provider?.recovery||{};
        const recoveryNote=document.createElement('p');
        recoveryNote.className='mt-2 rounded-lg bg-white/80 p-2.5 text-[.6rem] font-semibold leading-4 '+(
          severity==='red'?'text-red-800':
          severity==='yellow'?'text-amber-900':'text-[var(--koa-forest)]'
        );
        const remaining=Number(recovery.samplesUntilThresholdActive||0);
        const exitCritical=Number(recovery.healthySamplesToExitCritical||0);
        const toHealthy=Number(recovery.healthySamplesToHealthy||0);
        const redThreshold=Number(thresholds.redBelow??95);
        const estimate=(iso)=>iso?new Date(iso).toLocaleString():'';
        if(!provider.thresholdActive&&remaining>0){
          const when=estimate(recovery.estimatedThresholdActiveAt);
          recoveryNote.textContent='Recovery estimate · about '+remaining+' more healthy hourly sample'+(remaining===1?'':'s')+' before reliability thresholds activate'+(when?' · around '+when:'')+'.';
        }else if(severity==='red'&&exitCritical>0){
          const when=estimate(recovery.estimatedExitCriticalAt);
          recoveryNote.textContent='Recovery estimate · about '+exitCritical+' healthy hourly sample'+(exitCritical===1?'':'s')+' needed to reach '+redThreshold+'% and exit critical'+(when?' · around '+when:'')+'.';
        }else if(severity==='yellow'&&toHealthy>0){
          const when=estimate(recovery.estimatedHealthyAt);
          recoveryNote.textContent='Recovery estimate · about '+toHealthy+' healthy hourly sample'+(toHealthy===1?'':'s')+' needed to reach '+healthyThreshold+'% and return green'+(when?' · around '+when:'')+'.';
        }else if(severity==='green'){
          recoveryNote.textContent='Recovery estimate · reliability is currently above the configured healthy threshold.';
        }else{
          recoveryNote.textContent='Recovery estimate · waiting for the first successful credential verification.';
        }

        card.append(top,grid,controls,thresholdMeta,progressWrap,recoveryNote);
        credentialReliabilityGrid.appendChild(card);
      });
      if(!providers.length){
        credentialReliabilityGrid.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">Credential reliability will appear after the first hourly Credential Health sample.</p>';
      }
    }

