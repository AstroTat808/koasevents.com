        ['Assignment',record.assignment,'Sales CRM · record.assignment'],
        ['Security/lead quality',record.security,'Sales CRM · record.security'],
        ['Business CRM project metadata',project?.meta,'Business CRM · projects'],
        ['Business CRM notes',linkedRows('notes'),'Business CRM · notes'],
