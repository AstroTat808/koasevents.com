---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Client Workspace | Koa’s Events" description="Unified Koa’s Events client workspace." canonical="https://koasevents.com/admin/clients/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-8">
    <div class="container-shell max-w-7xl">
      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">
        <strong class="text-[var(--koa-forest)]">CRM access required.</strong>
        <p class="mt-2 text-sm text-[var(--koa-ink)]/55">Your current staff role does not include access to this client record.</p>
      </div>

      <div data-app class="hidden">
        <header class="rounded-[1.6rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-8">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <p class="eyebrow text-[var(--koa-clay)]">Client Workspace</p>
                <span data-stage class="rounded-full bg-[var(--koa-sand)] px-3 py-1 text-[.6rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]"></span>
              </div>
              <h1 data-name class="display mt-3 break-words text-4xl sm:text-5xl">Loading client…</h1>
              <p data-meta class="mt-3 break-words text-sm text-[var(--koa-ink)]/55"></p>
            </div>
            <div class="flex flex-wrap gap-2">
              <a href="/admin/quotes/" class="rounded-full border border-[var(--koa-line)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Sales CRM</a>
              <a href="/admin/crm/" class="rounded-full border border-[var(--koa-line)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Business CRM</a>
              <a href="/admin/quickbooks/#accounting-audit" class="rounded-full border border-[var(--koa-line)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Accounting Audit</a>
              <button data-sync type="button" class="rounded-full bg-[var(--koa-clay)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Sync & Recheck</button>
            </div>
          </div>

          <nav data-tabs class="mt-6 flex gap-2 overflow-x-auto border-t border-[var(--koa-line)] pt-5">
            <button type="button" data-tab="overview" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Overview</button>
            <button type="button" data-tab="accounting" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Accounting</button>
            <button type="button" data-tab="proposal" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Proposal</button>
            <button type="button" data-tab="payments" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Payments</button>
            <button type="button" data-tab="operations" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Operations</button>
            <button type="button" data-tab="documents" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Documents</button>
            <button type="button" data-tab="communications" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Communications</button>
            <button type="button" data-tab="activity" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Activity</button>
            <button type="button" data-tab="data" class="whitespace-nowrap rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Data Audit</button>
          </nav>
        </header>

        <p data-message class="mt-4 min-h-6 text-sm font-semibold text-[var(--koa-clay)]"></p>

        <section data-panel="overview" class="mt-5 grid gap-5 lg:grid-cols-[1.15fr_.85fr]">
          <form data-client-form class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Authoritative Sales CRM record</p>
            <h2 class="display mt-2 text-3xl">Client + event</h2>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <label class="grid gap-2 text-sm font-semibold">Client name<input name="name" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Email<input name="email" type="email" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Phone<input name="phone" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Event date<input name="eventDate" type="date" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Package / collection<input name="packageId" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Internal client notes<textarea name="notes" rows="5" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"></textarea></label>
            </div>
            <div class="mt-5 flex flex-wrap items-center gap-3">
              <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save client</button>
              <span class="text-xs text-[var(--koa-ink)]/45">Edits update the existing Sales CRM record; no duplicate client record is created.</span>
            </div>
          </form>

          <div class="grid gap-5">
            <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
              <p class="eyebrow text-[var(--koa-clay)]">At a glance</p>
              <div data-summary class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"></div>
            </div>
            <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
              <p class="eyebrow text-[var(--koa-clay)]">Ownership + source</p>
              <div data-source class="mt-4 grid gap-2 text-sm"></div>
            </div>
          </div>
        </section>

        <section data-panel="accounting" class="mt-5 hidden grid gap-5">
          <div data-accounting-hero class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7"></div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Accounting authority map</p>
                <h2 class="display mt-2 text-3xl">Source of Truth</h2>
                <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">These badges show which system controls each financial value. QuickBooks mirrors CRM proposal pricing, while issued invoices and payment activity remain authoritative in QuickBooks.</p>
              </div>
              <button data-repair-preview type="button" class="rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Preview Accounting Repair</button>
            </div>
            <div data-source-truth class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-5"></div>
            <div data-repair-panel class="mt-5 hidden"></div>
          </div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Line-by-line reconciliation</p>
                <h2 class="display mt-2 text-3xl">CRM proposal vs QuickBooks estimate</h2>
              </div>
              <button data-sync-2 type="button" class="rounded-full bg-[var(--koa-clay)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Sync & Recheck</button>
            </div>
            <div data-line-diff class="mt-5 overflow-x-auto"></div>
          </div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">QuickBooks mirror</p>
            <div data-qbo-docs class="mt-4 grid gap-3 md:grid-cols-2"></div>
          </div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Separate refundable liability</p>
                <h2 class="display mt-2 text-3xl">Refundable Damage Deposit</h2>
                <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Tracked separately from event revenue. The QuickBooks deposit invoice uses a NON-taxable line and a dedicated liability item; paid deposits can only be resolved through an explicit refund/deduction action.</p>
              </div>
              <span data-damage-deposit-status class="rounded-full bg-slate-100 px-3 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-slate-700">Not configured</span>
            </div>
            <div data-damage-deposit-unavailable class="mt-5 hidden rounded-xl bg-amber-50 p-4 text-sm leading-6 text-amber-950"></div>
            <form data-damage-deposit-form class="mt-5 grid gap-4">
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                <label class="grid gap-2 text-sm font-semibold">Rental type<select name="rentalType" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><option value="one-day">One-day event</option><option value="weekend">Weekend event</option></select></label>
                <label class="grid gap-2 text-sm font-semibold">Deposit amount<input name="amount" type="text" readonly class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 px-4 py-3" /></label>
                <label class="grid gap-2 text-sm font-semibold">Due date<input name="dueDate" type="date" readonly class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 px-4 py-3" /></label>
                <label class="grid gap-2 text-sm font-semibold">Refund due<input name="refundDueDate" type="date" readonly class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 px-4 py-3" /></label>
              </div>
              <div data-damage-deposit-summary class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-semibold">Documented deduction<input name="deductionAmount" type="number" min="0" step=".01" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
                <label class="grid gap-2 text-sm font-semibold">Deduction reason<input name="deductionReason" maxlength="1000" placeholder="Required if retaining any amount" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <button data-damage-save type="submit" class="rounded-full border border-[var(--koa-line)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Save Deposit Details</button>
                <button data-damage-create type="button" class="rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Create QuickBooks Deposit Invoice</button>
                <button data-damage-sync type="button" class="rounded-full bg-[var(--koa-clay)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Sync Deposit</button>
              </div>
              <div data-damage-refund-panel class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 p-4">
                <label class="flex items-start gap-3 text-sm"><input data-damage-refund-approve type="checkbox" class="mt-1 h-4 w-4"><span><strong class="text-[var(--koa-forest)]">I approve posting the refund/deduction to QuickBooks.</strong><span class="mt-1 block text-xs leading-5 text-[var(--koa-ink)]/50">This action requires the deposit invoice to be fully paid. Any documented deduction releases liability to the configured deduction-income account; the remaining amount is returned from the configured refund bank account.</span></span></label>
                <button data-damage-refund type="button" class="mt-3 rounded-full bg-[var(--koa-ink)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Post Refund / Deduction</button>
              </div>
            </form>
          </div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Audit trail</p>
                <h2 class="display mt-2 text-3xl">Accounting Repair History</h2>
                <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Every approved accounting repair retained on this client record, including the approver, QuickBooks documents, before/after values, and final reconciliation result.</p>
              </div>
              <span data-repair-history-count class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">0 repairs</span>
            </div>
            <div data-repair-history class="mt-5 grid gap-3"></div>
          </div>
        </section>

        <section data-panel="proposal" class="mt-5 hidden">
          <form data-proposal-form class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div><p class="eyebrow text-[var(--koa-clay)]">Proposal source of truth</p><h2 class="display mt-2 text-3xl">Pricing + line items</h2></div>
              <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save proposal</button>
            </div>
            <div data-proposal-empty class="hidden mt-5 rounded-xl bg-[var(--koa-sand)] p-4 text-sm text-[var(--koa-ink)]/58">This client does not have a proposal record yet. Promote the opportunity from Sales CRM before editing proposal pricing.</div>
            <div data-proposal-editor>
              <div data-proposal-lines class="mt-5 grid gap-3"></div>
              <button data-add-line type="button" class="mt-3 rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Add line item</button>
              <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <label class="grid gap-2 text-sm font-semibold">Discount<input name="discountAmount" type="number" step=".01" min="0" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
                <label class="grid gap-2 text-sm font-semibold">Deposit %<input name="depositPercent" type="number" step=".1" min="0" max="100" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
                <label class="grid gap-2 text-sm font-semibold">Proposal status<select name="status" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><option>draft</option><option>sent</option><option>viewed</option><option>accepted</option><option>declined</option><option>expired</option><option>booked</option></select></label>
                <label class="grid gap-2 text-sm font-semibold sm:col-span-3">Client-facing notes<textarea name="notesToClient" rows="4" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"></textarea></label>
              </div>
              <div data-proposal-totals class="mt-5 rounded-xl bg-[var(--koa-sand)] p-4 text-sm"></div>
            </div>
          </form>
        </section>

        <section data-panel="payments" class="mt-5 hidden grid gap-5">
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Payment schedule</p>
            <div data-payments class="mt-4 grid gap-3"></div>
          </div>
        </section>

        <section data-panel="operations" class="mt-5 hidden grid gap-5 xl:grid-cols-2">
          <form data-project-form class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7 xl:col-span-2">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div><p class="eyebrow text-[var(--koa-clay)]">Business CRM metadata</p><h2 class="display mt-2 text-3xl">Project details, tags + custom fields</h2></div>
              <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save project details</button>
            </div>
            <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
              <label class="grid gap-2 text-sm font-semibold">Project status<input name="projectStatus" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Owner<input name="owner" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Company<input name="company" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Partner name<input name="partnerName" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold md:col-span-2">Address<input name="address" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Business line<select name="businessLine" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><option value="events">Events</option><option value="mobile-bar">Mobile Bar</option><option value="wild-ones">Wild Ones</option></select></label>
              <label class="grid gap-2 text-sm font-semibold">Project type<input name="projectType" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold md:col-span-2">Source detail<input name="sourceDetail" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold md:col-span-2">Tags<input name="tags" placeholder="VIP, wedding, referral" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            </div>
            <div class="mt-6">
              <div class="flex items-center justify-between gap-3">
                <strong class="text-sm text-[var(--koa-forest)]">Custom fields</strong>
                <button data-add-custom type="button" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Add custom field</button>
              </div>
              <div data-custom-fields class="mt-3 grid gap-2"></div>
            </div>
          </form>

          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Internal notes</p>
            <form data-note-form class="mt-4 grid gap-3">
              <textarea name="body" rows="4" placeholder="Add an internal note…" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"></textarea>
              <button class="justify-self-start rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Add note</button>
            </form>
            <div data-notes class="mt-5 grid gap-3"></div>
          </div>

          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Tasks</p>
            <form data-task-form class="mt-4 grid gap-3 sm:grid-cols-2">
              <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Task<input name="title" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Due date<input name="dueDate" type="date" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Priority<select name="priority" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><option value="normal">Normal</option><option value="high">High</option><option value="low">Low</option></select></label>
              <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Assignee<input name="assignee" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <button class="justify-self-start rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Add task</button>
            </form>
            <div data-tasks class="mt-5 grid gap-3"></div>
          </div>

          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7 xl:col-span-2">
            <p class="eyebrow text-[var(--koa-clay)]">Appointments</p>
            <form data-appointment-form class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
              <label class="grid gap-2 text-sm font-semibold md:col-span-2">Title<input name="title" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Starts<input name="startsAt" type="datetime-local" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Duration (minutes)<input name="durationMinutes" type="number" min="15" max="480" value="60" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold md:col-span-2">Location<input name="location" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold md:col-span-2">Notes<input name="notes" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <button class="justify-self-start rounded-full bg-[var(--koa-forest)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Schedule appointment</button>
            </form>
            <div data-appointments class="mt-5 grid gap-3"></div>
          </div>
        </section>

        <section data-panel="documents" class="mt-5 hidden grid gap-5 lg:grid-cols-2">
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Contracts + accounting documents</p>
            <div data-documents class="mt-4 grid gap-3"></div>
          </div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">SignWell</p>
            <div data-signwell class="mt-4 grid gap-3"></div>
          </div>
        </section>

        <section data-panel="communications" class="mt-5 hidden grid gap-5 lg:grid-cols-[.85fr_1.15fr]">
          <form data-email-form class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Send client email</p>
            <p data-email-to class="mt-2 text-sm text-[var(--koa-ink)]/55"></p>
            <label class="mt-4 grid gap-2 text-sm font-semibold">Subject<input name="subject" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <label class="mt-4 grid gap-2 text-sm font-semibold">Message<textarea name="body" rows="9" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3"></textarea></label>
            <button class="mt-4 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Send email</button>
          </form>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Communication history</p>
            <div data-comms class="mt-4 grid gap-3"></div>
          </div>
        </section>

        <section data-panel="activity" class="mt-5 hidden grid gap-5">
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Client activity</p>
            <div data-activity class="mt-4 grid gap-3"></div>
          </div>
        </section>

        <section data-panel="data" class="mt-5 hidden grid gap-5">
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <p class="eyebrow text-[var(--koa-clay)]">Existing data audit</p>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/55">This is a read-only map of the existing record families used by this workspace. It is intentionally not a second database.</p>
            <div data-data-map class="mt-5 grid gap-3 md:grid-cols-2"></div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const app=document.querySelector('[data-app]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const message=document.querySelector('[data-message]');
    const clientRecordId=new URL(location.href).searchParams.get('id')||'';
    let record=null;
    let crmPayload=null;
    let session=null;
    let repairPreview=null;
    let damageSettings=null;
    let damageSettingsTenant=null;
    let quickBooksConnected=false;

    const money=(value)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(Number(value||0));
    const esc=(value)=>String(value??'').replace(/[&<>"']/g,(ch)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]));
    const when=(value)=>value?new Date(value).toLocaleString():'—';
    const localDateTimeInput=(value)=>{const date=new Date(value||'');if(Number.isNaN(date.getTime()))return String(value||'').slice(0,16);const local=new Date(date.getTime()-date.getTimezoneOffset()*60000);return local.toISOString().slice(0,16);};
    const hasAccess=(user)=>Boolean(user&&!user.accessBlocked&&(user.isAdmin||user.capabilities?.includes('sales.view')||user.capabilities?.includes('crm.view')||user.permissions?.includes('sales.view')||user.permissions?.includes('crm.view')));

    async function salesPost(body){
      const response=await fetch('/api/admin/quotes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(data.error||'Sales CRM request failed.');
      return data;
    }

    async function businessPost(body){
      const response=await fetch('/api/admin/crm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(data.error||'Business CRM request failed.');
      return data;
    }

    async function qboPost(body){
      const response=await fetch('/api/admin/quickbooks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(data.error||'QuickBooks request failed.');
      return data;
    }

    function card(label,value,detail=''){
      return '<div class="rounded-xl bg-[var(--koa-sand)]/55 p-4"><p class="text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">'+esc(label)+'</p><strong class="mt-1 block break-words text-lg text-[var(--koa-forest)]">'+esc(value)+'</strong>'+(detail?'<p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">'+esc(detail)+'</p>':'')+'</div>';
    }

    function sourceTruthCard(label,value,source,detail=''){
      const badgeClass=source==='QuickBooks'
        ? 'bg-sky-100 text-sky-800'
        : source==='CRM'
          ? 'bg-emerald-100 text-emerald-800'
          : 'bg-amber-100 text-amber-900';
      return '<div class="rounded-xl border border-[var(--koa-line)] p-4"><div class="flex flex-wrap items-center justify-between gap-2"><p class="text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">'+esc(label)+'</p><span class="rounded-full px-2.5 py-1 text-[.52rem] font-black uppercase tracking-[.06em] '+badgeClass+'">Source of truth · '+esc(source)+'</span></div><strong class="mt-3 block break-words text-lg text-[var(--koa-forest)]">'+esc(value)+'</strong>'+(detail?'<p class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/50">'+esc(detail)+'</p>':'')+'</div>';
    }

    function repairLines(lines){
      const rows=Array.isArray(lines)?lines:[];
      if(!rows.length)return '<p class="text-xs text-[var(--koa-ink)]/45">No financial lines.</p>';
      return '<div class="mt-2 grid gap-1">'+rows.map((line)=>{
        const description=line.description||line.Description||'Line item';
        const amount=line.amount??line.Amount??0;
        const taxCode=line.taxCode||line.SalesItemLineDetail?.TaxCodeRef?.value||'';
        return '<div class="flex flex-wrap justify-between gap-3 rounded-lg bg-white/70 px-3 py-2 text-xs"><span>'+esc(description)+(taxCode?' · tax '+esc(taxCode):'')+'</span><strong>'+money(amount)+'</strong></div>';
      }).join('')+'</div>';
    }

    function issueNames(issues){
      const rows=Array.isArray(issues)?issues:[];
      return rows.length?rows.map((issue)=>esc(issue.label||issue.code||'Accounting issue')).join(' · '):'None';
    }

    function renderRepairHistory(qbo){
      const rows=Array.isArray(qbo?.repairHistory)?qbo.repairHistory:[];
      const target=document.querySelector('[data-repair-history]');
      const count=document.querySelector('[data-repair-history-count]');
      if(count)count.textContent=rows.length+' repair'+(rows.length===1?'':'s');
      if(!target)return;
      if(!rows.length){
        target.innerHTML='<div class="rounded-xl bg-[var(--koa-sand)]/55 p-4 text-sm text-[var(--koa-ink)]/55">No approved accounting repairs have been recorded for this client.</div>';
        return;
      }
      target.innerHTML=rows.map((entry)=>{
        const before=entry.before||{};
        const after=entry.after||{};
        const resolved=entry.resolved===true||(entry.resolved==null&&after.reconciled===true);
        const documents=Array.isArray(entry.documents)&&entry.documents.length
          ? entry.documents
          : (entry.estimateDocNumber||entry.estimateId?[{type:'estimate',id:entry.estimateId,docNumber:entry.estimateDocNumber,beforeTotal:before.estimateTotal,afterTotal:after.estimateTotal}]:[]);
        const docHtml=documents.length?documents.map((doc)=>{
          const type=String(doc.type||'document').replace(/_/g,' ');
          const number=doc.docNumber?'#'+doc.docNumber:(doc.id||'No document number');
          return '<div class="rounded-xl bg-white p-3"><p class="text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]">'+esc(type)+' '+esc(number)+'</p><p class="mt-1 text-sm font-semibold text-[var(--koa-forest)]">'+money(doc.beforeTotal||0)+' → '+money(doc.afterTotal||0)+'</p>'+(doc.balance!=null?'<p class="mt-1 text-xs text-[var(--koa-ink)]/45">Balance after repair '+money(doc.balance)+'</p>':'')+'</div>';
        }).join(''):'<div class="rounded-xl bg-white p-3 text-xs text-[var(--koa-ink)]/45">No QuickBooks document reference was stored for this legacy repair entry.</div>';
        const badgeClass=resolved?'bg-emerald-100 text-emerald-800':'bg-amber-100 text-amber-900';
        const status=resolved?'Fully reconciled':'Remaining issues';
        return '<article class="rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-5"><div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><div class="flex flex-wrap items-center gap-2"><strong class="text-[var(--koa-forest)]">'+esc(entry.id||entry.previewId||'Accounting repair')+'</strong><span class="rounded-full px-2.5 py-1 text-[.52rem] font-black uppercase tracking-[.06em] '+badgeClass+'">'+status+'</span></div><p class="mt-1 text-xs text-[var(--koa-ink)]/45">Approved '+esc(when(entry.approvedAt))+' by '+esc(entry.approvedBy||'staff')+(entry.previewId?' · Preview '+esc(entry.previewId):'')+'</p></div><span class="text-xs font-semibold text-[var(--koa-ink)]/50">'+(Array.isArray(entry.changes)?entry.changes.length:0)+' approved change'+((Array.isArray(entry.changes)?entry.changes.length:0)===1?'':'s')+'</span></div><div class="mt-4 grid gap-3 sm:grid-cols-3"><div class="rounded-xl bg-white p-3"><p class="text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]">Estimate total</p><p class="mt-1 text-sm font-semibold">'+(before.estimateTotal==null?'—':money(before.estimateTotal))+' → '+(after.estimateTotal==null?'—':money(after.estimateTotal))+'</p></div><div class="rounded-xl bg-white p-3"><p class="text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]">Payments received</p><p class="mt-1 text-sm font-semibold">'+money(before.paymentsReceived||0)+' → '+money(after.paymentsReceived||0)+'</p></div><div class="rounded-xl bg-white p-3"><p class="text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]">Remaining balance</p><p class="mt-1 text-sm font-semibold">'+money(before.remainingBalance||0)+' → '+money(after.remainingBalance||0)+'</p></div></div><div class="mt-3 grid gap-3 md:grid-cols-2">'+docHtml+'</div><div class="mt-3 grid gap-2 text-xs"><p><strong class="text-[var(--koa-forest)]">Issues before:</strong> '+issueNames(before.issues)+'</p><p><strong class="text-[var(--koa-forest)]">Issues after:</strong> '+issueNames(entry.remainingIssues||after.issues)+'</p></div></article>';
      }).join('');
    }

    function renderRepairPreview(preview){
      repairPreview=preview||null;
      const panel=document.querySelector('[data-repair-panel]');
      if(!panel)return;
      panel.classList.remove('hidden');
      if(!preview){
        panel.innerHTML='<div class="rounded-xl bg-red-50 p-4 text-sm text-red-800">Repair preview could not be loaded.</div>';
        return;
      }
      if(preview.noChangesNeeded){
        panel.innerHTML='<div class="rounded-xl bg-emerald-50 p-4 text-sm font-semibold text-emerald-900">No repair is needed. The current CRM and QuickBooks accounting state is already reconciled.</div>';
        return;
      }

      const changes=Array.isArray(preview.changes)?preview.changes:[];
      const blocked=Array.isArray(preview.blockedIssues)?preview.blockedIssues:[];
      const changeHtml=changes.length?changes.map((change)=>'<article class="rounded-xl border border-[var(--koa-line)] bg-white p-4"><div class="flex flex-wrap items-center justify-between gap-2"><strong class="text-[var(--koa-forest)]">'+esc(change.target||'QuickBooks')+'</strong><span class="rounded-full bg-red-100 px-2.5 py-1 text-[.52rem] font-black uppercase tracking-[.06em] text-red-800">'+esc(change.type||'change')+'</span></div><div class="mt-4 grid gap-3 lg:grid-cols-2"><div class="rounded-xl bg-red-50 p-3"><p class="text-[.55rem] font-black uppercase tracking-[.07em] text-red-700">Before</p><p class="mt-1 text-sm font-bold">'+(change.before?.exists===false?'Not created':money(change.before?.total||0))+'</p>'+repairLines(change.before?.lines)+'</div><div class="rounded-xl bg-emerald-50 p-3"><p class="text-[.55rem] font-black uppercase tracking-[.07em] text-emerald-800">After approval</p><p class="mt-1 text-sm font-bold">'+money(change.after?.total||0)+'</p>'+repairLines(change.after?.lines)+(change.after?.taxHandling?'<p class="mt-2 text-xs leading-5 text-emerald-900">'+esc(change.after.taxHandling)+'</p>':'')+'</div></div></article>').join(''):'<div class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900">No safe QuickBooks write is proposed for the current mismatch.</div>';
      const blockedHtml=blocked.length?'<div class="rounded-xl border border-amber-200 bg-amber-50 p-4"><p class="text-xs font-black uppercase tracking-[.07em] text-amber-900">Protected / not automatically changed</p><div class="mt-2 grid gap-2">'+blocked.map((issue)=>'<div class="rounded-lg bg-white/60 p-3 text-sm text-amber-950"><p><strong>'+esc(issue.label||issue.code||'Issue')+'</strong> · '+(issue.expected!=null?'Expected '+(typeof issue.expected==='number'?money(issue.expected):esc(issue.expected))+' · ':'')+(issue.actual!=null?'Current '+(typeof issue.actual==='number'?money(issue.actual):esc(issue.actual)):'requires review')+'</p>'+(issue.protection?'<p class="mt-1 text-xs leading-5">'+esc(issue.protection)+'</p>':'')+'</div>').join('')+'</div></div>':'';
      const approvalHtml=preview.canApply?'<label class="flex items-start gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/55 p-4 text-sm"><input data-repair-approve type="checkbox" class="mt-1 h-4 w-4"><span><strong class="text-[var(--koa-forest)]">I approve the QuickBooks changes shown above.</strong><span class="mt-1 block text-xs leading-5 text-[var(--koa-ink)]/50">The server will validate that CRM and QuickBooks have not changed since this preview, refuse any invoice that is paid or partially paid, apply only the approved safe repairs, run Sync & Recheck, and write the before/after result to Accounting Repair History and Client Workspace Activity.</span></span></label><button data-repair-apply type="button" class="rounded-full bg-[var(--koa-clay)] px-5 py-3 text-xs font-black uppercase tracking-[.08em] text-white">Apply Approved Repair</button>':'<p class="rounded-xl bg-slate-100 p-4 text-sm text-slate-700">This preview cannot be applied automatically. Resolve the listed configuration or non-safe accounting issue first.</p>';
      panel.innerHTML='<div class="rounded-[1.25rem] border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">Approval required</p><h3 class="display mt-1 text-2xl">Accounting repair preview</h3></div><p class="text-xs text-[var(--koa-ink)]/45">Preview '+esc(preview.previewId||'')+' · expires '+esc(when(preview.expiresAt))+'</p></div><div class="mt-4 grid gap-3">'+changeHtml+blockedHtml+approvalHtml+'</div></div>';

      panel.querySelector('[data-repair-apply]')?.addEventListener('click',async()=>{
        const approved=Boolean(panel.querySelector('[data-repair-approve]')?.checked);
        if(!approved){
          message.textContent='Check the approval box before applying the accounting repair.';
          return;
        }
        const button=panel.querySelector('[data-repair-apply]');
        button.disabled=true;
        message.textContent='Applying approved QuickBooks repair and running Sync & Recheck…';
        try{
          const result=await qboPost({action:'apply-accounting-repair',previewId:preview.previewId,approved:true});
          message.textContent=result.resolved?'Accounting repair completed. CRM and QuickBooks are reconciled.':'Accounting repair completed. Remaining issues still need review.';
          repairPreview=null;
          await load('accounting');
        }catch(error){
          button.disabled=false;
          message.textContent=error.message||'Unable to apply the accounting repair.';
        }
      });
    }

    function activeTab(){
      return new URL(location.href).searchParams.get('tab')||'overview';
    }

    function activateTab(tab){
      const allowed=new Set(['overview','accounting','proposal','payments','operations','documents','communications','activity','data']);
      const next=allowed.has(tab)?tab:'overview';
      document.querySelectorAll('[data-panel]').forEach((panel)=>panel.classList.toggle('hidden',panel.dataset.panel!==next));
      document.querySelectorAll('[data-tab]').forEach((button)=>{
        const active=button.dataset.tab===next;
        button.classList.toggle('bg-[var(--koa-forest)]',active);
        button.classList.toggle('text-white',active);
      });
      const url=new URL(location.href);
      url.searchParams.set('tab',next);
      history.replaceState({},'',url);
    }

    function businessProject(){
      return (crmPayload?.projects||[]).find((row)=>row.id===record?.id||row.recordId===record?.id)||null;
    }

    function linkedRows(key){
      return (crmPayload?.[key]||[]).filter((row)=>row.recordId===record?.id);
    }

    function fillHeader(){
      document.querySelector('[data-name]').textContent=record.customer?.name||record.id;
      document.querySelector('[data-stage]').textContent=record.stage||record.status||'';
      document.querySelector('[data-meta]').textContent=[record.id,record.customer?.eventDate,record.packageId,record.customer?.email].filter(Boolean).join(' · ');
    }

    function renderOverview(){
      const form=document.querySelector('[data-client-form]');
      form.elements.name.value=record.customer?.name||'';
      form.elements.email.value=record.customer?.email||'';
      form.elements.phone.value=record.customer?.phone||'';
      form.elements.eventDate.value=String(record.customer?.eventDate||'').slice(0,10);
      form.elements.packageId.value=record.packageId||record.quote?.state?.startingPoint||'';
      form.elements.notes.value=record.customer?.notes||'';

      const proposal=record.proposal||{};
      const booking=record.bookingSummary||{};
      document.querySelector('[data-summary]').innerHTML=
        card('Contract value',money(proposal.total||0),proposal.status||'No proposal')+
        card('Paid',money(booking.paymentsReceived||0),booking.paymentStatus||'')+
        card('Remaining',money(booking.remainingBalance??proposal.total??0),'CRM booking balance')+
        card('Guest count',record.quote?.state?.guestCount||record.inquiry?.guestCount||'—')+
        card('Contract',record.booking?.contract?.status||'Not generated')+
        card('Owner',record.assignment?.name||businessProject()?.meta?.owner||'Unassigned',record.assignment?.email||'');

      document.querySelector('[data-source]').innerHTML=[
        ['Source',record.source||'—'],
        ['Business line',businessProject()?.businessLine||record.inquiry?.service||record.inquiry?.eventType||'—'],
        ['Quote ID',record.quoteId||'—'],
        ['Created',when(record.createdAt)],
        ['Updated',when(record.updatedAt)]
      ].map(([label,value])=>'<div class="flex justify-between gap-4 border-b border-[var(--koa-line)] py-2"><span class="text-[var(--koa-ink)]/45">'+esc(label)+'</span><strong class="break-all text-right">'+esc(value)+'</strong></div>').join('');
    }

    function normalizeDesc(value){
      return String(value||'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
    }

    function offsetDateString(value,days){
      const raw=String(value||'').slice(0,10);
      if(!raw)return '';
      const date=new Date(raw+'T12:00:00Z');
      if(Number.isNaN(date.getTime()))return '';
      date.setUTCDate(date.getUTCDate()+Number(days||0));
      return date.toISOString().slice(0,10);
    }

    function renderDamageDeposit(){
      const form=document.querySelector('[data-damage-deposit-form]');
      if(!form)return;
      const unavailable=document.querySelector('[data-damage-deposit-unavailable]');
      const badge=document.querySelector('[data-damage-deposit-status]');
      const settings=damageSettings||{};
      const tenantDefaults=damageSettingsTenant?.accounting?.damageDeposit||{};
      const existing=record.accounting?.damageDeposit||null;
      const rentalType=existing?.rentalType||tenantDefaults.defaultRentalType||'one-day';
      const defaultAmount=rentalType==='weekend'?Number(settings.weekendAmount||tenantDefaults.weekendAmount||0):Number(settings.oneDayAmount||tenantDefaults.oneDayAmount||0);
      const amount=Number(existing?.amount??defaultAmount);
      const dueDate=existing?.dueDate||offsetDateString(record.customer?.eventDate,-Number(settings.dueDaysBefore??tenantDefaults.dueDaysBefore??30));
      const refundDueDate=existing?.refundDueDate||offsetDateString(record.customer?.eventDate,Number(settings.refundWithinDays??tenantDefaults.refundWithinDays??14));
      const status=existing?.status||'not_invoiced';
      const invoiceBalance=Number(existing?.invoiceBalance??amount);
      const deduction=Number(existing?.deductionAmount||0);
      const refundAmount=Number(existing?.refundAmount??Math.max(0,amount-deduction));
      form.elements.rentalType.value=rentalType;
      form.elements.amount.value=money(amount);
      form.elements.dueDate.value=dueDate;
      form.elements.refundDueDate.value=refundDueDate;
      form.elements.deductionAmount.value=deduction;
      form.elements.deductionReason.value=existing?.deductionReason||'';

      const configured=Boolean(settings.enabled!==false&&settings.liabilityAccountId&&settings.itemId);
      const badgeMap={
        not_invoiced:['Not invoiced','bg-slate-100 text-slate-700'],
        invoiced:['Invoice open','bg-amber-100 text-amber-900'],
        paid:['Paid · refund pending','bg-sky-100 text-sky-800'],
        paid_with_pending_resolution:['Paid · review deductions','bg-sky-100 text-sky-800'],
        refunded:['Refunded','bg-emerald-100 text-emerald-800'],
        refunded_with_deduction:['Refunded with deduction','bg-emerald-100 text-emerald-800'],
      };
      const badgeData=badgeMap[status]||[String(status).replace(/_/g,' '),'bg-slate-100 text-slate-700'];
      if(badge){
        badge.className='rounded-full px-3 py-2 text-[.56rem] font-black uppercase tracking-[.07em] '+badgeData[1];
        badge.textContent=badgeData[0];
      }

      if(unavailable){
        unavailable.classList.toggle('hidden',configured&&quickBooksConnected);
        unavailable.textContent=!quickBooksConnected
          ? 'QuickBooks is not connected. Connect it from QuickBooks Setup before creating or resolving a refundable deposit.'
          : !configured
            ? 'Finish Refundable Damage Deposit setup in QuickBooks Admin: choose the liability account, refund bank account, and dedicated QuickBooks item.'
            : '';
      }

      document.querySelector('[data-damage-deposit-summary]').innerHTML=
        card('QuickBooks document',existing?.invoiceDocNumber?'#'+existing.invoiceDocNumber:(existing?.invoiceId||'Not created'),existing?.invoiceId?'Separate liability invoice':'Does not count toward event revenue')+
        card('Invoice balance',money(invoiceBalance),existing?.paidAt?'Paid '+when(existing.paidAt):'QuickBooks source of truth')+
        card('Planned refund',money(refundAmount),deduction>0?'Deduction '+money(deduction):'No deduction recorded')+
        card('Refund transaction',existing?.refundTransactionId||'Not posted',existing?.refundedAt?when(existing.refundedAt):'');

      const locked=Boolean(existing?.invoiceId);
      form.elements.rentalType.disabled=locked;
      const saveButton=document.querySelector('[data-damage-save]');
      const createButton=document.querySelector('[data-damage-create]');
      const syncButton=document.querySelector('[data-damage-sync]');
      const refundButton=document.querySelector('[data-damage-refund]');
      if(saveButton)saveButton.disabled=!quickBooksConnected;
      if(createButton){
        createButton.disabled=!configured||!quickBooksConnected||Boolean(existing?.invoiceId);
        createButton.textContent=existing?.invoiceId?'Deposit Invoice Created':'Create QuickBooks Deposit Invoice';
      }
      if(syncButton)syncButton.disabled=!quickBooksConnected||!existing?.invoiceId;
      if(refundButton)refundButton.disabled=!configured||!quickBooksConnected||!existing?.invoiceId||invoiceBalance>0.005||Boolean(existing?.refundTransactionId);
      const refundPanel=document.querySelector('[data-damage-refund-panel]');
      if(refundPanel)refundPanel.classList.toggle('opacity-50',Boolean(refundButton?.disabled));
    }

    function renderAccounting(){
      const proposal=record.proposal||{};
      const qbo=record.accounting?.quickbooks||{};
      const invoices=Array.isArray(qbo.invoices)?qbo.invoices:[];
      const difference=Number(qbo.estimateTotal||0)-Number(proposal.total||0);
      const reconciled=Math.abs(difference)<0.01;
      const issuedTotal=invoices.reduce((sum,invoice)=>sum+Number(invoice.total||invoice.amount||0),0);
      const paymentsReceived=invoices.reduce((sum,invoice)=>{
        const total=Number(invoice.total||invoice.amount||0);
        const balance=Number(invoice.balance??total);
        return sum+Math.max(0,total-balance);
      },0);
      const remainingBalance=Math.max(0,Number(proposal.total||0)-paymentsReceived);

      document.querySelector('[data-accounting-hero]').innerHTML='<div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between"><div><p class="eyebrow '+(reconciled?'text-[var(--koa-forest)]':'text-red-700')+'">'+(reconciled?'Reconciled':'Accounting reconciliation warning')+'</p><h2 class="display mt-2 text-4xl">'+money(proposal.total||0)+' CRM · '+money(qbo.estimateTotal||0)+' QuickBooks</h2><p class="mt-2 text-sm '+(reconciled?'text-[var(--koa-ink)]/55':'text-red-700')+'">Difference '+money(difference)+' · Estimate '+esc(qbo.estimateDocNumber?'#'+qbo.estimateDocNumber:'not linked')+'</p></div><div class="grid grid-cols-2 gap-2 text-sm">'+card('CRM subtotal',money(proposal.subtotal||0))+card('CRM tax',money(proposal.taxAmount||0),'CRM-calculated tax')+card('Discount',money(proposal.discountAmount||0))+card('QBO total',money(qbo.estimateTotal||0),'Controlled mirror of CRM proposal')+'</div></div>';

      document.querySelector('[data-source-truth]').innerHTML=
        sourceTruthCard('CRM tax',money(proposal.taxAmount||0),'CRM','CRM calculates proposal tax and sends it to QuickBooks as an explicit non-taxable line.')+
        sourceTruthCard('QuickBooks estimate',qbo.estimateId?money(qbo.estimateTotal||0):'Not linked','CRM','CRM proposal pricing controls the estimate; QuickBooks is the accounting mirror.')+
        sourceTruthCard('Invoices',invoices.length+' issued','QuickBooks','Issued invoice totals, document status and open invoice balances are controlled in QuickBooks. Issued total '+money(issuedTotal)+'.')+
        sourceTruthCard('Payments',money(paymentsReceived),'QuickBooks','Actual payment activity and paid invoice amounts come from QuickBooks.')+
        sourceTruthCard('Client balance',money(remainingBalance),'CRM + QuickBooks','CRM supplies the contract total; QuickBooks supplies payments. The workspace reconciles both.');

      const repairButton=document.querySelector('[data-repair-preview]');
      if(repairButton){
        repairButton.disabled=!record.proposal;
        repairButton.textContent=reconciled?'Preview Accounting Repair':'Repair Accounting Mismatch';
      }

      const crmLines=(proposal.lineItems||[]).map((line,index)=>({
        id:line.id||'crm-'+index,
        description:line.description||'CRM line '+(index+1),
        quantity:Number(line.quantity||1),
        unitPrice:Number(line.unitPrice||0),
        amount:Number(line.amount||0)
      }));
      const qboLines=(qbo.estimateLines||[]).map((line,index)=>({...line,id:line.id||'qbo-'+index}));
      const used=new Set();
      const rows=crmLines.map((line,index)=>{
        let match=qboLines.findIndex((candidate,qboIndex)=>!used.has(qboIndex)&&normalizeDesc(candidate.description)===normalizeDesc(line.description));
        if(match<0&&index<qboLines.length&&!used.has(index))match=index;
        const qboLine=match>=0?qboLines[match]:null;
        if(match>=0)used.add(match);
        return {crm:line,qbo:qboLine,delta:Number(qboLine?.amount||0)-Number(line.amount||0)};
      });
      qboLines.forEach((line,index)=>{
        if(!used.has(index))rows.push({crm:null,qbo:line,delta:Number(line.amount||0)});
      });

      if(!qbo.estimateLines?.length){
        document.querySelector('[data-line-diff]').innerHTML='<div class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900">Run Sync & Recheck to capture the current QuickBooks estimate line items. The next refresh will show the exact line differences.</div>';
      }else{
        document.querySelector('[data-line-diff]').innerHTML='<table class="min-w-[880px] w-full text-sm"><thead><tr class="border-b border-[var(--koa-line)] text-left text-[.58rem] uppercase tracking-[.08em] text-[var(--koa-ink)]/45"><th class="pb-3">Line</th><th class="pb-3">CRM qty × unit</th><th class="pb-3 text-right">CRM</th><th class="pb-3">QuickBooks qty × unit</th><th class="pb-3 text-right">QBO</th><th class="pb-3 text-right">Difference</th></tr></thead><tbody>'+rows.map((row)=>'<tr class="border-b border-[var(--koa-line)]/70"><td class="py-3 pr-4 font-semibold">'+esc(row.crm?.description||row.qbo?.description||'Unmatched line')+'</td><td class="py-3 pr-4">'+(row.crm?esc(row.crm.quantity)+' × '+money(row.crm.unitPrice):'—')+'</td><td class="py-3 pr-4 text-right">'+(row.crm?money(row.crm.amount):'—')+'</td><td class="py-3 pr-4">'+(row.qbo?esc(row.qbo.quantity||1)+' × '+money(row.qbo.unitPrice):'—')+'</td><td class="py-3 pr-4 text-right">'+(row.qbo?money(row.qbo.amount):'—')+'</td><td class="py-3 text-right font-bold '+(Math.abs(row.delta)>=0.01?'text-red-700':'text-[var(--koa-forest)]')+'">'+money(row.delta)+'</td></tr>').join('')+'</tbody></table>';
      }

      document.querySelector('[data-qbo-docs]').innerHTML=
        card('Customer',qbo.customerDisplayName||'Not linked',qbo.customerId?'QBO #'+qbo.customerId:'')+
        card('Estimate',qbo.estimateDocNumber?'#'+qbo.estimateDocNumber:'Not linked',money(qbo.estimateTotal||0)+' · CRM-controlled mirror')+
        invoices.map((invoice)=>{
          const total=Number(invoice.total||invoice.amount||0);
          const balance=Number(invoice.balance??total);
          const paid=Math.max(0,total-balance);
          const paymentState=paid<=0.005?'Unpaid':balance<=0.005?'Paid':'Partially paid';
          return card('Invoice '+(invoice.docNumber?'#'+invoice.docNumber:''),money(total),'QuickBooks source of truth · '+paymentState+' · Paid '+money(paid)+' · Balance '+money(balance)+' · '+(invoice.emailStatus||''));
        }).join('')+
        card('Last synced',when(qbo.lastSyncedAt||qbo.estimateLastSyncedAt));
      renderRepairHistory(qbo);
      renderDamageDeposit();
    }

    function lineEditor(line,index){
      return '<div data-line-row class="grid gap-2 rounded-xl border border-[var(--koa-line)] p-3 md:grid-cols-[1fr_90px_130px_130px_auto]"><input name="description" value="'+esc(line.description||'')+'" class="rounded-lg border border-[var(--koa-line)] px-3 py-2 text-sm" placeholder="Description"><input name="quantity" type="number" min=".01" step=".01" value="'+esc(line.quantity||1)+'" class="rounded-lg border border-[var(--koa-line)] px-3 py-2 text-sm"><input name="unitPrice" type="number" step=".01" value="'+esc(line.unitPrice||0)+'" class="rounded-lg border border-[var(--koa-line)] px-3 py-2 text-sm"><input name="amount" type="number" step=".01" value="'+esc(line.amount||0)+'" class="rounded-lg border border-[var(--koa-line)] px-3 py-2 text-sm"><button type="button" data-remove-line class="rounded-lg border border-red-200 px-3 py-2 text-xs font-black uppercase text-red-700">Remove</button><input type="hidden" name="id" value="'+esc(line.id||'line-'+index)+'"></div>';
    }

    function bindLineRows(){
      document.querySelectorAll('[data-remove-line]').forEach((button)=>{
        button.onclick=()=>button.closest('[data-line-row]')?.remove();
      });
    }

    function collectLines(){
      return [...document.querySelectorAll('[data-line-row]')].map((row,index)=>{
        const value=(name)=>row.querySelector('[name="'+name+'"]')?.value;
        const quantity=Math.max(0.01,Number(value('quantity')||1));
        const unitPrice=Number(value('unitPrice')||0);
        const amount=Number(value('amount')||quantity*unitPrice);
        return {id:value('id')||'line-'+(index+1),description:value('description')||'Line item',quantity,unitPrice,amount,custom:true};
      });
    }

    function renderProposal(){
      const proposal=record.proposal;
