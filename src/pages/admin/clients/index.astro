    function renderDocuments(){
      const contract=record.booking?.contract;
      const qbo=record.accounting?.quickbooks||{};
      const docs=[];
      if(contract)docs.push(['Venue agreement',contract.status||'pending','Generated '+when(contract.generatedAt)+(contract.signature?.signedAt?' · Client signed '+when(contract.signature.signedAt):'')]);
      if(qbo.estimateId)docs.push(['QuickBooks estimate',qbo.estimateDocNumber?'#'+qbo.estimateDocNumber:qbo.estimateId,money(qbo.estimateTotal||0)]);
      (qbo.invoices||[]).forEach((invoice)=>docs.push(['QuickBooks invoice',invoice.docNumber?'#'+invoice.docNumber:invoice.invoiceId,money(invoice.total||invoice.amount||0)]));
      document.querySelector('[data-documents]').innerHTML=docs.length?docs.map((doc)=>card(doc[0],doc[1],doc[2])).join(''):'<p class="text-sm text-[var(--koa-ink)]/50">No contract or accounting documents are linked on this record yet.</p>';

      const config=crmPayload?.integrations?.signwell||{};
      const signwell=record.booking?.contract?.signwell||{};
      const accepted=['accepted','booked'].includes(String(record.proposal?.status||''));
      const createDisabled=!config.configured||!accepted||Boolean(signwell.documentId);
      const retrieveDisabled=!config.configured||!signwell.documentId;
      const signedLink=signwell.signedPdfStored?'<a target="_blank" rel="noopener" href="/api/admin/crm?signwellPdf='+encodeURIComponent(record.id)+'" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-forest)]">Open signed PDF</a>':'';
      document.querySelector('[data-signwell]').innerHTML=
        card('Connection',config.configured?'Configured':'Needs configuration',config.testMode?'Test mode':'Production mode')+
        card('Document',signwell.documentId||'Not created',signwell.status||'not sent')+
        card('Signed PDF',signwell.signedPdfStored?'Stored':'Not stored',signwell.signedPdfStoredAt?when(signwell.signedPdfStoredAt):'')+
        '<div class="flex flex-wrap gap-2"><button data-signwell-create type="button" '+(createDisabled?'disabled':'')+' class="rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.06em] text-white disabled:cursor-not-allowed disabled:opacity-40">Create / send agreement</button><button data-signwell-pdf type="button" '+(retrieveDisabled?'disabled':'')+' class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.06em] text-[var(--koa-forest)] disabled:cursor-not-allowed disabled:opacity-40">Retrieve signed PDF</button>'+signedLink+'</div>'+
        (!accepted?'<p class="text-xs text-amber-800">The proposal must be accepted before SignWell can create the agreement.</p>':'')+
        (signwell.lastError?'<p class="text-xs text-red-700">'+esc(signwell.lastError)+'</p>':'');

      document.querySelector('[data-signwell-create]')?.addEventListener('click',async()=>{
        message.textContent='Creating SignWell agreement…';
        try{
          await businessPost({action:'create-signwell-agreement',recordId:record.id});
          message.textContent='SignWell agreement created.';
          await load('documents');
        }catch(error){
          message.textContent=error.message||'Unable to create SignWell agreement.';
        }
      });

      document.querySelector('[data-signwell-pdf]')?.addEventListener('click',async()=>{
        message.textContent='Retrieving completed SignWell PDF…';
        try{
          await businessPost({action:'retrieve-signwell-pdf',recordId:record.id});
          message.textContent='Signed PDF stored.';
          await load('documents');
        }catch(error){
          message.textContent=error.message||'Unable to retrieve signed PDF.';
        }
      });
    }

    function renderComms(){
      document.querySelector('[data-email-to]').textContent='To: '+(record.customer?.email||'No client email');
      const communicationEntries=Object.entries(record.communications||{}).map(([key,value])=>({
        title:key,
        status:value?.status||'unknown',
        detail:(value?.messageId?'Message '+value.messageId+' · ':'')+when(value?.sentAt||value?.updatedAt)
      }));
      const messages=linkedRows('messages').map((entry)=>({
        title:entry.subject||entry.type||'Client message',
        status:entry.status||'sent',
        detail:(entry.to||entry.recipient||record.customer?.email||'')+' · '+when(entry.createdAt||entry.sentAt)
      }));
      const combined=[...communicationEntries,...messages];
      document.querySelector('[data-comms]').innerHTML=combined.length?combined.map((entry)=>card(entry.title,entry.status,entry.detail)).join(''):'<p class="text-sm text-[var(--koa-ink)]/50">No communication history is stored for this client.</p>';
    }

    function renderActivity(){
      const salesTimeline=record.timeline||[];
      const businessTimeline=linkedRows('activity');
      const rows=[...salesTimeline,...businessTimeline].sort((a,b)=>String(b.createdAt||'').localeCompare(String(a.createdAt||'')));
      document.querySelector('[data-activity]').innerHTML=rows.length?rows.map((entry)=>'<div class="rounded-xl border border-[var(--koa-line)] p-4"><div class="flex flex-wrap items-center justify-between gap-2"><strong>'+esc(String(entry.type||'activity').replace(/_/g,' '))+'</strong><span class="text-xs text-[var(--koa-ink)]/45">'+esc(when(entry.createdAt))+'</span></div><p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58">'+esc(entry.detail||'')+'</p></div>').join(''):'<p class="text-sm text-[var(--koa-ink)]/50">No client activity is stored.</p>';
    }

    function renderData(){
      const project=businessProject();
      const families=[
        ['Client/contact',record.customer,'Sales CRM · record.customer'],
        ['Inquiry',record.inquiry,'Sales CRM · record.inquiry'],
        ['Saved quote',record.quote,'Sales CRM · record.quote'],
        ['Proposal + pricing',record.proposal,'Sales CRM · record.proposal'],
        ['Booking + contract',record.booking,'Sales CRM · record.booking'],
        ['Payment view',record.bookingSummary,'Sales CRM derived bookingSummary'],
        ['QuickBooks mirror',record.accounting?.quickbooks,'Sales CRM · record.accounting.quickbooks'],
        ['Communications',record.communications,'Sales CRM · record.communications'],
        ['Profitability',record.profitModel,'Sales CRM · record.profitModel'],
        ['Assignment',record.assignment,'Sales CRM · record.assignment'],
        ['Security/lead quality',record.security,'Sales CRM · record.security'],
        ['Business CRM project metadata',project?.meta,'Business CRM · projects'],
        ['Business CRM notes',linkedRows('notes'),'Business CRM · notes'],
        ['Business CRM tasks',linkedRows('tasks'),'Business CRM · tasks'],
        ['Appointments',linkedRows('appointments'),'Business CRM · appointments'],
        ['Workflow enrollments',linkedRows('enrollments'),'Business CRM · enrollments'],
        ['Client messages',linkedRows('messages'),'Business CRM · client messages'],
        ['SignWell',record.booking?.contract?.signwell,'Booking contract · SignWell state'],
        ['Activity timeline',[...(record.timeline||[]),...linkedRows('activity')],'Sales + Business CRM activity']
      ];
      document.querySelector('[data-data-map]').innerHTML=families.map(([label,value,source])=>{
        const present=Array.isArray(value)?value.length>0:value!=null&&(typeof value!=='object'||Object.keys(value).length>0);
        const detail=Array.isArray(value)?value.length+' linked record(s)':source;
        return '<div class="rounded-xl border border-[var(--koa-line)] p-4"><div class="flex items-center justify-between gap-3"><strong>'+esc(label)+'</strong><span class="rounded-full px-2 py-1 text-[.55rem] font-black uppercase '+(present?'bg-emerald-100 text-emerald-800':'bg-slate-100 text-slate-500')+'">'+(present?'Stored':'Not present')+'</span></div><p class="mt-2 text-xs text-[var(--koa-ink)]/45">'+esc(detail)+'</p></div>';
      }).join('');
    }

    function renderAll(){
      fillHeader();
      renderOverview();
      renderAccounting();
      renderProposal();
      renderPayments();
      renderOperations();
      renderDocuments();
      renderComms();
      renderActivity();
      renderData();
    }

    async function load(tab){
      session=await getAdminSession();
      if(!hasAccess(session)){
        unauthorized.classList.remove('hidden');
        return;
      }
      if(!clientRecordId){
        app.classList.remove('hidden');
        document.querySelector('[data-name]').textContent='Choose a client';
        message.textContent='This Client Workspace URL is missing a client record ID.';
        return;
      }

      const [salesResponse,businessResponse,damageResponse]=await Promise.all([
        fetch('/api/admin/quotes?q='+encodeURIComponent(clientRecordId),{cache:'no-store'}),
        fetch('/api/admin/crm',{cache:'no-store'}),
        fetch('/api/admin/quickbooks?view=damage-deposit-settings',{cache:'no-store'})
      ]);

      if(salesResponse.status===403){
        unauthorized.classList.remove('hidden');
        return;
      }
      if(!salesResponse.ok){
        app.classList.remove('hidden');
        message.textContent='Unable to load the Sales CRM record.';
        return;
      }

      const salesData=await salesResponse.json().catch(()=>({}));
      crmPayload=businessResponse.ok?await businessResponse.json().catch(()=>null):null;
      const damageData=damageResponse.ok?await damageResponse.json().catch(()=>null):null;
      damageSettings=damageData?.damageDepositSettings||null;
      damageSettingsTenant=damageData?.tenant||null;
      quickBooksConnected=Boolean(damageData?.connection?.connected);
      record=(salesData.records||[]).find((entry)=>entry.id===clientRecordId)||null;

      if(!record){
        app.classList.remove('hidden');
        document.querySelector('[data-name]').textContent='Client not found';
        message.textContent='No CRM record matched '+clientRecordId+'.';
        return;
      }

      app.classList.remove('hidden');
      renderAll();
      activateTab(tab||activeTab());
    }

    document.querySelectorAll('[data-tab]').forEach((button)=>{
      button.addEventListener('click',()=>activateTab(button.dataset.tab));
    });

    document.querySelector('[data-client-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const form=event.currentTarget;
      message.textContent='Saving client…';
      try{
        await salesPost({
          action:'update-client',
          recordId:record.id,
          customer:{
            name:form.elements.name.value,
            email:form.elements.email.value,
            phone:form.elements.phone.value,
            eventDate:form.elements.eventDate.value,
            notes:form.elements.notes.value
          },
          packageId:form.elements.packageId.value
        });
        message.textContent='Client saved.';
        await load('overview');
      }catch(error){
        message.textContent=error.message||'Unable to save client.';
      }
    });

    document.querySelector('[data-proposal-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      if(!record?.proposal)return;
      const form=event.currentTarget;
      message.textContent='Saving proposal…';
      try{
        await salesPost({
          action:'update-proposal',
          recordId:record.id,
          proposal:{
            lineItems:collectLines(),
            discountAmount:Number(form.elements.discountAmount.value||0),
            depositPercent:Number(form.elements.depositPercent.value||0),
            status:form.elements.status.value,
            notesToClient:form.elements.notesToClient.value,
            customer:record.customer,
            paymentSchedule:record.proposal.paymentSchedule
          }
        });
        message.textContent='Proposal saved and totals recalculated.';
        await load('proposal');
      }catch(error){
        message.textContent=error.message||'Unable to save proposal.';
      }
    });

    document.querySelector('[data-add-line]')?.addEventListener('click',()=>{
      const list=document.querySelector('[data-proposal-lines]');
      list.insertAdjacentHTML('beforeend',lineEditor({id:'custom-'+Date.now(),description:'',quantity:1,unitPrice:0,amount:0},list.children.length));
      bindLineRows();
    });

    document.querySelector('[data-add-custom]')?.addEventListener('click',()=>{
      const list=document.querySelector('[data-custom-fields]');
      list.insertAdjacentHTML('beforeend',customRow('',''));
      bindCustomRows();
    });

    document.querySelector('[data-project-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const form=event.currentTarget;
      const customFields={};
      document.querySelectorAll('[data-custom-row]').forEach((row)=>{
        const key=String(row.querySelector('[name="customKey"]')?.value||'').trim();
        const value=String(row.querySelector('[name="customValue"]')?.value||'').trim();
        if(key)customFields[key]=value;
      });
      message.textContent='Saving Business CRM project details…';
      try{
        await businessPost({
          action:'save-project',
          recordId:record.id,
          projectStatus:form.elements.projectStatus.value,
          owner:form.elements.owner.value,
          company:form.elements.company.value,
          address:form.elements.address.value,
          partnerName:form.elements.partnerName.value,
          sourceDetail:form.elements.sourceDetail.value,
          businessLine:form.elements.businessLine.value,
          projectType:form.elements.projectType.value,
          tags:String(form.elements.tags.value||'').split(/[,\n]/).map((value)=>value.trim()).filter(Boolean),
          customFields
        });
        message.textContent='Project details saved.';
        await load('operations');
      }catch(error){
        message.textContent=error.message||'Unable to save project details.';
      }
    });

    document.querySelector('[data-note-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const form=event.currentTarget;
      const body=String(form.elements.body.value||'').trim();
      if(!body)return;
      message.textContent='Adding note…';
      try{
        await businessPost({action:'add-note',recordId:record.id,body});
        form.reset();
        message.textContent='Note added.';
        await load('operations');
      }catch(error){
        message.textContent=error.message||'Unable to add note.';
      }
    });

    document.querySelector('[data-task-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const form=event.currentTarget;
      message.textContent='Adding task…';
      try{
        await businessPost({
          action:'add-task',
          recordId:record.id,
          title:form.elements.title.value,
          dueDate:form.elements.dueDate.value,
          assignee:form.elements.assignee.value,
          priority:form.elements.priority.value
        });
        form.reset();
        form.elements.priority.value='normal';
        message.textContent='Task added.';
        await load('operations');
      }catch(error){
        message.textContent=error.message||'Unable to add task.';
      }
    });

    document.querySelector('[data-appointment-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const form=event.currentTarget;
      message.textContent='Scheduling appointment…';
      try{
        await businessPost({
          action:'schedule-appointment',
          recordId:record.id,
          title:form.elements.title.value,
          startsAt:form.elements.startsAt.value,
          durationMinutes:Number(form.elements.durationMinutes.value||60),
          location:form.elements.location.value,
          notes:form.elements.notes.value
        });
        form.reset();
        form.elements.durationMinutes.value='60';
        message.textContent='Appointment scheduled.';
        await load('operations');
      }catch(error){
        message.textContent=error.message||'Unable to schedule appointment.';
      }
    });

    document.querySelector('[data-email-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const form=event.currentTarget;
      message.textContent='Sending client email…';
      try{
        const result=await businessPost({
          action:'send-client-email',
          recordId:record.id,
          subject:form.elements.subject.value,
          body:form.elements.body.value
        });
        form.reset();
        message.textContent='Email sent'+(result.messageId?' · '+result.messageId:'')+'.';
        await load('communications');
      }catch(error){
        message.textContent=error.message||'Unable to send email.';
      }
    });

    document.querySelector('[data-damage-deposit-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      if(!record)return;
      const form=event.currentTarget;
      message.textContent='Saving refundable damage-deposit details…';
      try{
        await qboPost({
          action:'update-damage-deposit',
          recordId:record.id,
          rentalType:form.elements.rentalType.value,
          deductionAmount:Number(form.elements.deductionAmount.value||0),
          deductionReason:form.elements.deductionReason.value,
        });
        message.textContent='Refundable damage-deposit details saved.';
        await load('accounting');
      }catch(error){
        message.textContent=error.message||'Unable to save refundable damage-deposit details.';
      }
    });

    document.querySelector('[data-damage-deposit-form]')?.elements?.rentalType?.addEventListener('change',(event)=>{
      if(record?.accounting?.damageDeposit?.invoiceId)return;
      const type=event.target.value;
      const form=document.querySelector('[data-damage-deposit-form]');
      if(form)form.elements.amount.value=money(type==='weekend'?damageSettings?.weekendAmount:damageSettings?.oneDayAmount);
    });

    document.querySelector('[data-damage-create]')?.addEventListener('click',async()=>{
      if(!record)return;
      message.textContent='Creating the separate refundable damage-deposit invoice in QuickBooks…';
      try{
        const form=document.querySelector('[data-damage-deposit-form]');
        await qboPost({
          action:'update-damage-deposit',
          recordId:record.id,
          rentalType:form?.elements?.rentalType?.value||'one-day',
          deductionAmount:Number(form?.elements?.deductionAmount?.value||0),
          deductionReason:form?.elements?.deductionReason?.value||'',
        });
        await qboPost({action:'create-damage-deposit-invoice',recordId:record.id});
        message.textContent='Refundable damage-deposit invoice created in QuickBooks as a separate liability.';
        await load('accounting');
      }catch(error){
        message.textContent=error.message||'Unable to create the refundable damage-deposit invoice.';
      }
    });

    document.querySelector('[data-damage-sync]')?.addEventListener('click',async()=>{
      if(!record)return;
      message.textContent='Refreshing refundable damage-deposit status from QuickBooks…';
      try{
        await qboPost({action:'sync-damage-deposit',recordId:record.id});
        message.textContent='Refundable damage-deposit status refreshed.';
        await load('accounting');
      }catch(error){
        message.textContent=error.message||'Unable to sync the refundable damage deposit.';
      }
    });

    document.querySelector('[data-damage-refund]')?.addEventListener('click',async()=>{
      if(!record)return;
      const approved=Boolean(document.querySelector('[data-damage-refund-approve]')?.checked);
      if(!approved){
        message.textContent='Approve the QuickBooks refund/deduction before posting it.';
        return;
      }
      const form=document.querySelector('[data-damage-deposit-form]');
      const deductionAmount=Number(form?.elements?.deductionAmount?.value||0);
      const deductionReason=String(form?.elements?.deductionReason?.value||'').trim();
      if(deductionAmount>0&&!deductionReason){
        message.textContent='Enter a deduction reason before retaining any part of the refundable deposit.';
        return;
      }
      message.textContent='Posting approved refundable damage-deposit resolution to QuickBooks…';
      try{
        await qboPost({
          action:'refund-damage-deposit',
          recordId:record.id,
          deductionAmount,
          deductionReason,
        });
        message.textContent='Refundable damage deposit resolved in QuickBooks.';
        await load('accounting');
      }catch(error){
        message.textContent=error.message||'Unable to resolve the refundable damage deposit.';
      }
    });

    async function sync(){
      if(!record)return;
      message.textContent='Refreshing QuickBooks estimate, invoices and payments…';
      try{
        const result=await qboPost({action:'sync-and-recheck',recordId:record.id});
        message.textContent=result.accountingRepairPreview
          ? 'QuickBooks refreshed. A safe Accounting Repair preview is ready for review.'
          : result.reconciliationResolved
            ? 'QuickBooks verified live. CRM and QuickBooks reconcile; the accounting review flag was cleared automatically.'
            : 'QuickBooks refreshed. Reconciliation recalculated.';
        await load('accounting');
        if(result.accountingRepairPreview){
          renderRepairPreview(result.accountingRepairPreview);
          document.querySelector('[data-repair-panel]')?.scrollIntoView({behavior:'smooth',block:'start'});
        }
      }catch(error){
        message.textContent=error.message||'Unable to sync QuickBooks.';
      }
    }

    async function previewRepair(){
      if(!record?.proposal)return;
      const button=document.querySelector('[data-repair-preview]');
      if(button)button.disabled=true;
      message.textContent='Building a live, read-only accounting repair preview…';
      try{
        const result=await qboPost({action:'preview-accounting-repair',recordId:record.id});
        renderRepairPreview(result.preview);
        message.textContent=result.preview?.noChangesNeeded?'No accounting repair is needed.':'Review the proposed QuickBooks changes below, then approve them if they are correct.';
      }catch(error){
        message.textContent=error.message||'Unable to preview the accounting repair.';
      }finally{
        if(button)button.disabled=false;
      }
    }

    document.querySelector('[data-sync]')?.addEventListener('click',sync);
    document.querySelector('[data-sync-2]')?.addEventListener('click',sync);
    document.querySelector('[data-repair-preview]')?.addEventListener('click',previewRepair);

    load().then(async()=>{
      const url=new URL(location.href);
      if(url.searchParams.get('repair')==='preview'&&record?.proposal){
        url.searchParams.delete('repair');
        history.replaceState({},'',url);
        await previewRepair();
        document.querySelector('[data-repair-panel]')?.scrollIntoView({behavior:'smooth',block:'start'});
      }
    });
  </script>
</BaseLayout>
