---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Staff Management" description="Manage Koa’s Events staff accounts, permissions, and audit history." canonical="https://koasevents.com/admin/staff/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-7xl">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Access Control</p>
          <h1 class="display mt-3 text-5xl">Staff Management</h1>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-[var(--koa-ink)]/58">Manage roles, individual operational permissions, account status, and access-change history without opening Netlify.</p>
        </div>
        <a href="/admin/" class="rounded-full bg-[var(--koa-ink)] px-4 py-2 text-xs font-black uppercase tracking-[.1em] text-white">Admin home</a>
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">This page requires a Koa’s administrator account.</div>

      <div data-app class="hidden grid gap-6">
        <section class="grid gap-4 lg:grid-cols-3">
          <article class="rounded-[1.4rem] bg-white p-6 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Sales Rep</p><h2 class="display mt-2 text-3xl">Sales work</h2><p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/58">Works leads, quotes, proposals, notes, tasks and appointments. Individual permissions can add selected operational powers without changing the base role.</p></article>
          <article class="rounded-[1.4rem] bg-[var(--koa-forest)] p-6 text-white shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-amber-light)]">Manager</p><h2 class="display mt-2 text-3xl">Operations control</h2><p class="mt-3 text-sm leading-6 text-white/68">Includes all operational permissions plus lead assignment and team performance reporting.</p></article>
          <article class="rounded-[1.4rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-amber-light)]">Administrator</p><h2 class="display mt-2 text-3xl">Technical control</h2><p class="mt-3 text-sm leading-6 text-white/68">Adds Staff Management, QuickBooks, Gallery, SEO, Security + Spam, and other technical administration. These powers are not individually delegable.</p></article>
        </section>

        <section class="grid gap-6 xl:grid-cols-[.7fr_1.3fr]">
          <form data-invite-form class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">New employee</p><h2 class="display mt-2 text-4xl">Invite staff member</h2>
            <div class="mt-5 grid gap-4">
              <label class="grid gap-2 text-sm font-semibold">Name<input name="name" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Email<input name="email" type="email" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Role<select name="role" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><option value="sales">Sales Rep</option><option value="manager">Manager</option></select></label>
              <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Create + send invite</button>
              <p data-invite-message class="text-sm leading-6 text-[var(--koa-ink)]/58"></p>
            </div>
          </form>

          <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div><p class="eyebrow text-[var(--koa-clay)]">Identity accounts</p><h2 class="display mt-2 text-4xl">Team access</h2></div>
              <button data-refresh type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Refresh</button>
            </div>
            <p class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/55">Sales Rep permissions below are additive. Managers already receive every operational permission automatically.</p>
            <p data-list-message class="mt-3 text-sm text-[var(--koa-ink)]/52"></p>
            <div data-user-list class="mt-5 grid gap-4"></div>
          </section>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">Audit history</p><h2 class="display mt-2 text-4xl">Staff + protected settings</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Role, permission, account-status, lead-owner, workflow/template, cleanup-policy, and profitability changes are recorded here.</p></div><span data-audit-count class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-black text-[var(--koa-forest)]">0 entries</span></div>
          <div data-audit-list class="mt-5 grid max-h-[720px] gap-3 overflow-y-auto"></div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getUser } from '@netlify/identity';
    const approvedAdminEmails=new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    const app=document.querySelector('[data-app]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const list=document.querySelector('[data-user-list]');
    const listMessage=document.querySelector('[data-list-message]');
    const inviteForm=document.querySelector('[data-invite-form]');
    const inviteMessage=document.querySelector('[data-invite-message]');
    const auditList=document.querySelector('[data-audit-list]');
    const auditCount=document.querySelector('[data-audit-count]');
    let capabilityDefinitions=[];

    function roles(user){const sources=[user?.roles,user?.appMetadata?.roles,user?.app_metadata?.roles];return sources.find(Array.isArray)||[];}
    function isAdmin(user){const email=String(user?.email||'').trim().toLowerCase();return approvedAdminEmails.has(email)||roles(user).map((r)=>String(r).toLowerCase()).includes('admin');}
    async function api(body){const options=body?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}:{cache:'no-store'};const response=await fetch('/api/admin/staff',options);const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Staff management request failed.');return data;}
    function roleLabel(role){return role==='manager'?'Manager':role==='sales'?'Sales Rep':role==='admin'?'Administrator':role==='deactivated'?'Deactivated':'No staff access';}
    function button(label,classes,handler){const b=document.createElement('button');b.type='button';b.className=classes;b.textContent=label;b.addEventListener('click',handler);return b;}

    function renderUsers(users){
      list.innerHTML='';
      if(!users.length){list.innerHTML='<p class="text-sm text-[var(--koa-ink)]/48">No Identity users found.</p>';return;}
      users.forEach((user)=>{
        const card=document.createElement('article');card.className='rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5';
        const head=document.createElement('div');head.className='flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between';
        const info=document.createElement('div');
        info.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">'+roleLabel(user.role)+'</p><h3 class="mt-1 text-base font-semibold text-[var(--koa-forest)]"></h3><p class="mt-1 text-xs text-[var(--koa-ink)]/48"></p>';
        info.querySelector('h3').textContent=user.name||user.email||'Unnamed user';
        info.querySelector('p:last-child').textContent=[user.email,user.lastSignInAt?'Last sign-in '+new Date(user.lastSignInAt).toLocaleString():'Never signed in'].filter(Boolean).join(' · ');
        const controls=document.createElement('div');controls.className='flex flex-wrap items-center gap-2';
        if(user.protected||user.role==='admin'){
          const badge=document.createElement('span');badge.className='rounded-full bg-[var(--koa-ink)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white';badge.textContent='Protected admin';controls.appendChild(badge);
        }else{
          const select=document.createElement('select');select.className='rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold';select.innerHTML='<option value="sales">Sales Rep</option><option value="manager">Manager</option>';select.value=user.role==='manager'?'manager':'sales';controls.appendChild(select);
          controls.appendChild(button('Save role','rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white',async()=>{try{listMessage.textContent='Saving role…';await api({action:user.role==='deactivated'?'reactivate':'set-role',userId:user.id,role:select.value});await load();}catch(err){listMessage.textContent=err.message;}}));
          if(user.role==='deactivated') controls.appendChild(button('Reactivate','rounded-full border border-emerald-200 bg-emerald-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-emerald-800',async()=>{try{await api({action:'reactivate',userId:user.id,role:select.value});await load();}catch(err){listMessage.textContent=err.message;}}));
          else controls.appendChild(button('Deactivate','rounded-full border border-amber-200 bg-amber-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-amber-800',async()=>{if(!confirm('Deactivate '+user.email+'?'))return;try{await api({action:'deactivate',userId:user.id});await load();}catch(err){listMessage.textContent=err.message;}}));
          controls.appendChild(button('Delete','rounded-full border border-red-200 bg-red-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-red-700',async()=>{if(!confirm('Permanently delete '+user.email+'?'))return;if(!confirm('Final confirmation: remove this Identity account?'))return;try{await api({action:'delete',userId:user.id});await load();}catch(err){listMessage.textContent=err.message;}}));
        }
        head.append(info,controls);card.appendChild(head);

        if(!user.protected&&user.role!=='admin'){
          const permissions=document.createElement('div');permissions.className='mt-5 border-t border-[var(--koa-line)] pt-4';
          const title=document.createElement('p');title.className='text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]';title.textContent=user.role==='manager'?'Operational permissions · included by Manager role':'Individual permissions';
          permissions.appendChild(title);
          const grid=document.createElement('div');grid.className='mt-3 grid gap-2 sm:grid-cols-2';
          capabilityDefinitions.forEach((cap)=>{
            const label=document.createElement('label');label.className='flex items-center gap-2 rounded-xl border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold';
            const checkbox=document.createElement('input');checkbox.type='checkbox';checkbox.value=cap.id;checkbox.checked=user.role==='manager'||(user.permissions||[]).includes(cap.id);checkbox.disabled=user.role==='manager'||user.role==='deactivated';
            label.append(checkbox,document.createTextNode(cap.label));grid.appendChild(label);
          });
          permissions.appendChild(grid);
          if(user.role!=='manager'&&user.role!=='deactivated') permissions.appendChild(button('Save individual permissions','mt-3 rounded-full border border-[var(--koa-line)] bg-white px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]',async()=>{const selected=[...grid.querySelectorAll('input:checked')].map((input)=>input.value);try{await api({action:'set-permissions',userId:user.id,permissions:selected});await load();}catch(err){listMessage.textContent=err.message;}}));
          card.appendChild(permissions);
        }
        list.appendChild(card);
      });
    }

    function renderAudit(rows){
      auditList.innerHTML='';auditCount.textContent=rows.length+' entr'+(rows.length===1?'y':'ies');
      rows.forEach((entry)=>{
        const card=document.createElement('article');card.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
        const action=String(entry.action||'activity').replaceAll('_',' ');
        card.append(
          Object.assign(document.createElement('p'),{className:'text-[.55rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]',textContent:action}),
          Object.assign(document.createElement('p'),{className:'mt-1 text-sm font-semibold text-[var(--koa-forest)]',textContent:entry.detail||''}),
          Object.assign(document.createElement('p'),{className:'mt-2 text-xs text-[var(--koa-ink)]/48',textContent:[entry.actor,entry.subjectEmail,entry.recordId,new Date(entry.createdAt).toLocaleString()].filter(Boolean).join(' · ')})
        );
        auditList.appendChild(card);
      });
      if(!rows.length)auditList.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No audited staff or protected-setting changes yet.</p>';
    }

    async function load(){
      try{
        listMessage.textContent='Loading staff…';
        const data=await api();capabilityDefinitions=data.capabilities||[];
        renderUsers(data.users||[]);renderAudit(data.audit||[]);
        listMessage.textContent=(data.users||[]).length+' account'+((data.users||[]).length===1?'':'s')+'.';
      }catch(err){listMessage.textContent=err.message;}
    }

    inviteForm?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(inviteForm);inviteMessage.textContent='Creating staff account…';try{const result=await api({action:'invite',name:data.get('name'),email:data.get('email'),role:data.get('role')});inviteMessage.textContent=result.inviteEmailSent?'Account created and invitation email sent.':'Account created, but email delivery failed. Temporary password: '+result.temporaryPassword;inviteForm.reset();await load();}catch(err){inviteMessage.textContent=err.message;}});
    document.querySelector('[data-refresh]')?.addEventListener('click',load);
    const user=await getUser();const ok=isAdmin(user);app?.classList.toggle('hidden',!ok);unauthorized?.classList.toggle('hidden',ok);if(ok)await load();
  </script>
</BaseLayout>
