---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s User Management" description="Manage Koa’s Events administrator and staff accounts." canonical="https://koasevents.com/admin/staff/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-7xl">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Access Control</p>
          <h1 class="display mt-3 text-5xl">User Management</h1>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-[var(--koa-ink)]/58">Create, deactivate, reactivate, remove, reset passwords, set passwords, assign roles, and control permissions without opening Netlify.</p>
        </div>
        
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8 shadow-[var(--shadow-soft)]">
        <p class="font-semibold text-[var(--koa-forest)]">Administrator access required.</p>
        <p class="mt-2 text-sm text-[var(--koa-ink)]/55">Sign in with a Koa’s Administrator account to manage users.</p>
      </div>

      <div data-app class="hidden grid gap-6">
        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Total accounts</p><p data-summary-total class="display mt-2 text-4xl">—</p></article>
          <article class="rounded-[1.3rem] bg-[var(--koa-forest)] p-5 text-white shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-amber-light)]">Active</p><p data-summary-active class="display mt-2 text-4xl">—</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Pending setup</p><p data-summary-pending class="display mt-2 text-4xl">—</p></article>
          <article class="rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Deactivated</p><p data-summary-deactivated class="display mt-2 text-4xl">—</p></article>
          <article class="rounded-[1.3rem] bg-amber-50 p-5 shadow-[var(--shadow-soft)]"><p class="eyebrow text-amber-800">Password attention</p><p data-summary-password class="display mt-2 text-4xl text-[var(--koa-forest)]">—</p></article>
        </section>

        <section class="grid gap-6 xl:grid-cols-[.72fr_1.28fr]">
          <form data-create-form class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">New user</p>
            <h2 class="display mt-2 text-4xl">Create account</h2>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/55">Choose whether the user receives a password-setup email or you set the initial password yourself.</p>

            <div class="mt-5 grid gap-4">
              <label class="grid gap-2 text-sm font-semibold">Name
                <input name="name" required autocomplete="name" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
              </label>
              <label class="grid gap-2 text-sm font-semibold">Job title
                <input name="jobTitle" maxlength="120" autocomplete="organization-title" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="Wedding & Events Manager" />
                <span class="text-xs font-normal leading-5 text-[var(--koa-ink)]/48">Used in personalized staff email signatures. If left blank, the staff role is used instead.</span>
              </label>
              <label class="grid gap-2 text-sm font-semibold">Email
                <input name="email" type="email" required autocomplete="email" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
              </label>
              <label class="grid gap-2 text-sm font-semibold">Role
                <select name="role" class="rounded-xl border border-[var(--koa-line)] px-4 py-3">
<option value="sales">Sales Rep</option>
                  <option value="manager">Manager</option>
                  <option value="event_coordinator">Event Coordinator</option>
                  <option value="vendor_manager">Vendor Manager</option>
                  <option value="content_editor">Content Editor</option>
                  <option value="accounting">Accounting</option>
                  <option value="read_only">Read Only</option>
                  <option value="admin">Administrator</option>
                </select>
              </label>

              <fieldset class="grid gap-2">
                <legend class="text-sm font-semibold">Account setup</legend>
                <label class="flex items-start gap-3 rounded-xl border border-[var(--koa-line)] p-3 text-sm">
                  <input type="radio" name="setupMode" value="email" checked class="mt-1" />
                  <span><strong class="block text-[var(--koa-forest)]">Send setup email</strong><span class="text-[var(--koa-ink)]/55">User receives a secure link and chooses their own password.</span></span>
                </label>
                <label class="flex items-start gap-3 rounded-xl border border-[var(--koa-line)] p-3 text-sm">
                  <input type="radio" name="setupMode" value="manual" class="mt-1" />
                  <span><strong class="block text-[var(--koa-forest)]">Set password now</strong><span class="text-[var(--koa-ink)]/55">Administrator chooses the initial password.</span></span>
                </label>
              </fieldset>

              <div data-create-password class="hidden grid gap-4">
                <label class="grid gap-2 text-sm font-semibold">Initial password
                  <input name="password" type="password" minlength="10" autocomplete="new-password" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
                </label>
                <label class="grid gap-2 text-sm font-semibold">Confirm password
                  <input name="confirmPassword" type="password" minlength="10" autocomplete="new-password" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
                </label>
              </div>

              <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Create account</button>
              <p data-create-message class="min-h-6 text-sm leading-6 text-[var(--koa-ink)]/58"></p>
            </div>
          </form>

          <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Accounts</p>
                <h2 class="display mt-2 text-4xl">Team access</h2>
              </div>
              <button data-refresh type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Refresh</button>
            </div>

            <div class="mt-5 grid gap-3 md:grid-cols-[1fr_auto_auto]">
              <input data-search type="search" placeholder="Search name or email…" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm" />
              <select data-role-filter class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-sm font-semibold">
                <option value="all">All roles</option>
                <option value="admin">Administrators</option>
                <option value="manager">Managers</option>
                <option value="sales">Sales Reps</option>
                <option value="event_coordinator">Event Coordinators</option>
                <option value="vendor_manager">Vendor Managers</option>
                <option value="content_editor">Content Editors</option>
                <option value="accounting">Accounting</option>
                <option value="read_only">Read Only</option>
                <option value="deactivated">Deactivated</option>
                <option value="none">No role</option>
              </select>
              <select data-status-filter class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-sm font-semibold">
                <option value="all">All statuses</option>
                <option value="active">Active</option>
                <option value="pending">Pending setup</option>
                <option value="deactivated">Deactivated</option>
              </select>
            </div>

            <p data-list-message class="mt-3 text-sm text-[var(--koa-ink)]/52"></p>
            <div data-user-list class="mt-5 grid gap-4"></div>
          </section>
        </section>

        <section class="grid gap-6 xl:grid-cols-[.78fr_1.22fr]">
          <form data-custom-role-form class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Custom roles</p>
            <h2 class="display mt-2 text-4xl">Build a role</h2>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/55">Create roles such as Wedding Lead or Bookkeeper and select the exact capabilities the role receives.</p>
            <input name="id" type="hidden" />
            <div class="mt-5 grid gap-4">
              <label class="grid gap-2 text-sm font-semibold">Role name<input name="name" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="Wedding Lead" /></label>
              <label class="grid gap-2 text-sm font-semibold">Description<textarea name="description" rows="3" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="What this role is for…"></textarea></label>
              <div data-custom-role-capabilities class="grid gap-2 sm:grid-cols-2"></div>
              <div class="flex flex-wrap gap-3">
                <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save custom role</button>
                <button data-clear-custom-role type="button" class="rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">New role</button>
              </div>
              <p data-custom-role-message class="text-sm text-[var(--koa-ink)]/55"></p>
            </div>
          </form>

          <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <div><p class="eyebrow text-[var(--koa-clay)]">Saved custom roles</p><h2 class="display mt-2 text-4xl">Role library</h2></div>
            <div data-custom-role-list class="mt-5 grid gap-3"></div>
          </section>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Role permissions</p>
            <h2 class="display mt-2 text-4xl">Page-by-page access matrix</h2>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/55">Each role has a locked baseline. Individual permissions can add access without weakening the role’s required permissions.</p>
          </div>
          <div data-role-matrix class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-4"></div>
        </section>

        <section class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
          <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
            <div>
              <p class="eyebrow text-[var(--koa-amber-light)]">Authentication policy</p>
              <h2 class="display mt-2 text-4xl">Password + session security</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-white/65">Control password expiration and whether passwords set by an Administrator must be changed by the user at their next sign-in.</p>
            </div>
            <form data-security-policy class="grid gap-3 rounded-xl bg-white/10 p-4 sm:grid-cols-[auto_auto_auto] sm:items-end">
              <label class="grid gap-2 text-xs font-bold uppercase tracking-[.08em] text-white/70">Expire passwords after
                <select name="passwordExpiryDays" class="rounded-lg border border-white/20 bg-white px-3 py-2 text-sm font-semibold text-[var(--koa-ink)]">
                  <option value="0">Never</option>
                  <option value="30">30 days</option>
                  <option value="60">60 days</option>
                  <option value="90">90 days</option>
                  <option value="180">180 days</option>
                  <option value="365">365 days</option>
                </select>
              </label>
              <label class="flex items-center gap-2 rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold"><input name="requireChangeOnAdminSet" type="checkbox" checked /> Require change after admin-set password</label>
              <button class="rounded-full bg-[var(--koa-amber-light)] px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-ink)]">Save policy</button>
              <p data-security-policy-message class="sm:col-span-3 text-xs text-white/70"></p>
            </form>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div><p class="eyebrow text-[var(--koa-clay)]">Authentication security</p><h2 class="display mt-2 text-4xl">Login history + active sessions</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Successful and failed sign-ins, suspicious-login flags, tracked devices, and session revocation.</p></div>
            <button data-refresh-auth-security type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Refresh security</button>
          </div>
          <div data-mfa-readiness class="mt-4 rounded-xl bg-[var(--koa-sand)] p-4 text-sm text-[var(--koa-ink)]/60"></div>
          <div class="mt-5 grid gap-6 xl:grid-cols-[.8fr_1.2fr]">
            <div data-security-user-list class="grid gap-3"></div>
            <div><div data-active-session-detail class="rounded-xl border border-[var(--koa-line)] p-4 text-sm text-[var(--koa-ink)]/55">Select a user to inspect active sessions and login history.</div></div>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Security audit</p>
              <h2 class="display mt-2 text-4xl">User activity</h2>
              <p class="mt-2 text-sm text-[var(--koa-ink)]/55">Account creation, role changes, permission edits, password actions, deactivation, reactivation, and deletion are recorded here.</p>
            </div>
            <span data-audit-count class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-black text-[var(--koa-forest)]">0 entries</span>
          </div>
          <div data-audit-list class="mt-5 grid max-h-[720px] gap-3 overflow-y-auto"></div>
        </section>
      </div>
    </div>
  </main>

  <dialog data-password-dialog class="w-[min(94vw,34rem)] rounded-[1.4rem] border-0 bg-white p-0 shadow-2xl backdrop:bg-black/40">
    <form data-password-form class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div><p class="eyebrow text-[var(--koa-clay)]">Administrator action</p><h2 class="display mt-2 text-3xl">Set password</h2></div>
        <button data-close-password type="button" class="text-2xl leading-none text-[var(--koa-ink)]/40">×</button>
      </div>
      <p data-password-user class="mt-3 text-sm text-[var(--koa-ink)]/55"></p>
      <input name="userId" type="hidden" />
      <div class="mt-5 grid gap-4">
        <label class="grid gap-2 text-sm font-semibold">New password
          <input name="password" type="password" minlength="10" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
        </label>
        <label class="grid gap-2 text-sm font-semibold">Confirm password
          <input name="confirmPassword" type="password" minlength="10" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
        </label>
        <p class="text-xs leading-5 text-[var(--koa-ink)]/48">Minimum 10 characters. The password itself is never recorded in the audit log.</p>
        <p data-password-message class="min-h-5 text-sm text-red-700"></p>
        <div class="flex flex-wrap gap-3">
          <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Set password</button>
          <button data-cancel-password type="button" class="rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Cancel</button>
        </div>
      </div>
    </form>
  </dialog>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const approvedAdminEmails = new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    const app = document.querySelector('[data-app]');
    const unauthorized = document.querySelector('[data-unauthorized]');
    const list = document.querySelector('[data-user-list]');
    const listMessage = document.querySelector('[data-list-message]');
    const createForm = document.querySelector('[data-create-form]');
    const createMessage = document.querySelector('[data-create-message]');
    const createPassword = document.querySelector('[data-create-password]');
    const auditList = document.querySelector('[data-audit-list]');
    const auditCount = document.querySelector('[data-audit-count]');
    const search = document.querySelector('[data-search]');
    const roleFilter = document.querySelector('[data-role-filter]');
    const statusFilter = document.querySelector('[data-status-filter]');
    const passwordDialog = document.querySelector('[data-password-dialog]');
    const passwordForm = document.querySelector('[data-password-form]');
    const passwordUser = document.querySelector('[data-password-user]');
    const passwordMessage = document.querySelector('[data-password-message]');

    let capabilityDefinitions = [];
    let roleDefinitions = [];
    let customRoleDefinitions = [];
    let securityPolicy = null;
    let allUsers = [];
    let authSecurityData = null;

    function roles(user) {
      const sources = [user?.roles,user?.appMetadata?.roles,user?.app_metadata?.roles];
      return sources.find(Array.isArray) || [];
    }

    function isAdmin(user) {
      const email = String(user?.email || '').trim().toLowerCase();
      return approvedAdminEmails.has(email) || roles(user).map((role) => String(role).toLowerCase()).includes('admin');
    }

    async function api(body) {
      const options = body
        ? {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}
        : {cache:'no-store'};
      const response = await fetch('/api/admin/staff', options);
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'User-management request failed.');
      return data;
    }

    async function customRoleApi(body) {
      const options=body?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}:{cache:'no-store'};
      const response=await fetch('/api/admin/custom-roles',options);
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(data.error||'Custom role request failed.');
      return data;
    }
    async function authSecurityApi(body,userId='') {
      const url='/api/admin/auth-security'+(userId?'?userId='+encodeURIComponent(userId):'');
      const options=body?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}:{cache:'no-store'};
      const response=await fetch(url,options);
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(data.error||'Authentication security request failed.');
      return data;
    }

    function roleLabel(role,user=null) {
      if(role==='custom'&&user?.roleLabel)return user.roleLabel;
      const found=roleDefinitions.find((row)=>row.id===role);
      if(found)return found.label;
      return role === 'deactivated' ? 'Deactivated' : role === 'none' ? 'No role' : String(role||'').replaceAll('_',' ').replace(/\b\w/g,(m)=>m.toUpperCase());
    }
    function roleOptionsHtml(selected='sales'){
      const built=roleDefinitions.map((role)=>'<option value="'+role.id+'"'+(role.id===selected?' selected':'')+'>'+role.label+'</option>');
      const custom=customRoleDefinitions.map((role)=>'<option value="custom:'+role.id+'"'+(('custom:'+role.id)===selected?' selected':'')+'>'+role.name+' (Custom)</option>');
      return [...built,...custom].join('');
    }

    function statusLabel(status) {
      return status === 'active' ? 'Active'
        : status === 'pending' ? 'Pending setup'
        : status === 'deactivated' ? 'Deactivated'
        : status;
    }

    function button(label, classes, handler) {
      const element = document.createElement('button');
      element.type = 'button';
      element.className = classes;
      element.textContent = label;
      element.addEventListener('click', handler);
      return element;
    }

    function setSummary(summary = {}) {
      document.querySelector('[data-summary-total]').textContent = String(summary.total ?? 0);
      document.querySelector('[data-summary-active]').textContent = String(summary.active ?? 0);
      document.querySelector('[data-summary-pending]').textContent = String(summary.pending ?? 0);
      document.querySelector('[data-summary-deactivated]').textContent = String(summary.deactivated ?? 0);
      document.querySelector('[data-summary-password]').textContent = String(summary.passwordAttention ?? 0);
    }

    function filteredUsers() {
      const term = String(search?.value || '').trim().toLowerCase();
      const role = String(roleFilter?.value || 'all');
      const status = String(statusFilter?.value || 'all');
      return allUsers.filter((user) => {
        const matchesTerm = !term || [user.name,user.jobTitle,user.email,user.role,user.status].some((value) => String(value || '').toLowerCase().includes(term));
        const matchesRole = role === 'all' || user.role === role;
        const matchesStatus = status === 'all' || user.status === status;
        return matchesTerm && matchesRole && matchesStatus;
      });
    }

    function renderUsers() {
      const users = filteredUsers();
      list.innerHTML = '';
      listMessage.textContent = users.length + ' account' + (users.length === 1 ? '' : 's') + ' shown.';

      if (!users.length) {
        list.innerHTML = '<p class="rounded-xl bg-[var(--koa-sand)] p-4 text-sm text-[var(--koa-ink)]/55">No accounts match these filters.</p>';
        return;
      }

      users.forEach((user) => {
        const card = document.createElement('article');
        card.className = 'rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5';

        const head = document.createElement('div');
        head.className = 'flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between';

        const info = document.createElement('div');
        const statusClass = user.status === 'active'
          ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
          : user.status === 'pending'
          ? 'bg-amber-50 text-amber-800 border-amber-200'
          : 'bg-red-50 text-red-700 border-red-200';

        info.innerHTML = '<div class="flex items-start gap-3"><div data-user-avatar class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[var(--koa-forest)] text-sm font-black text-white"></div><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><span class="text-[.56rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">'+roleLabel(user.role,user)+'</span><span class="rounded-full border px-2.5 py-1 text-[.52rem] font-black uppercase tracking-[.06em] '+statusClass+'">'+statusLabel(user.status)+'</span></div><h3 class="mt-2 text-base font-semibold text-[var(--koa-forest)]"></h3><p class="mt-1 text-xs text-[var(--koa-ink)]/48"></p></div></div>';
        const avatar=info.querySelector('[data-user-avatar]');
        if(user.photoUrl){avatar.innerHTML='<img src="'+user.photoUrl+'" alt="" class="h-full w-full object-cover" />';}else avatar.textContent=String(user.name||user.email||'K').trim().charAt(0).toUpperCase()||'K';
        info.querySelector('h3').textContent = user.name || user.email || 'Unnamed user';
        if(user.jobTitle){const title=document.createElement('p');title.className='mt-1 text-sm font-semibold text-[var(--koa-clay)]';title.textContent=user.jobTitle;info.querySelector('h3').after(title);}
        info.querySelector('p:last-child').textContent = [
          user.email,
          user.lastSignInAt ? 'Last sign-in '+new Date(user.lastSignInAt).toLocaleString() : 'Never signed in',
          user.security?.passwordExpiresAt ? 'Password expires '+new Date(user.security.passwordExpiresAt).toLocaleDateString() : '',
          user.createdAt ? 'Created '+new Date(user.createdAt).toLocaleDateString() : '',
        ].filter(Boolean).join(' · ');
        const securityFlags=document.createElement('div');securityFlags.className='mt-2 flex flex-wrap gap-2';
        if(user.security?.forcePasswordChange){securityFlags.innerHTML+='<span class="rounded-full bg-amber-100 px-2 py-1 text-[.52rem] font-black uppercase tracking-[.06em] text-amber-900">Change required</span>';}
        if(user.security?.passwordExpired){securityFlags.innerHTML+='<span class="rounded-full bg-red-100 px-2 py-1 text-[.52rem] font-black uppercase tracking-[.06em] text-red-800">Password expired</span>';}
        if(securityFlags.childNodes.length)info.appendChild(securityFlags);

        const controls = document.createElement('div');
        controls.className = 'flex max-w-2xl flex-wrap items-center gap-2';

        if (user.protected) {
          const badge = document.createElement('span');
          badge.className = 'rounded-full bg-[var(--koa-ink)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white';
          badge.textContent = 'Protected admin';
          controls.appendChild(badge);
        }

        if (user.status === 'deactivated') {
          const reactivateRole = document.createElement('select');
          reactivateRole.className = 'rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold';
          reactivateRole.innerHTML = roleOptionsHtml(user.customRoleId?'custom:'+user.customRoleId:'sales');
          controls.appendChild(reactivateRole);
          controls.appendChild(button('Reactivate','rounded-full border border-emerald-200 bg-emerald-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-emerald-800',async()=> {
            try {
              listMessage.textContent = 'Reactivating account…';
              if(String(reactivateRole.value).startsWith('custom:')){
                await api({action:'reactivate',userId:user.id,role:'read_only'});
                await customRoleApi({action:'assign',userId:user.id,roleId:String(reactivateRole.value).slice(7)});
              }else await api({action:'reactivate',userId:user.id,role:reactivateRole.value});
              await load();
            } catch (error) { listMessage.textContent = error.message; }
          }));
        } else if (!user.protected) {
          const roleSelect = document.createElement('select');
          roleSelect.className = 'rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold';
          const selectedRole=user.role==='custom'&&user.customRoleId?'custom:'+user.customRoleId:user.role;
          roleSelect.innerHTML = roleOptionsHtml(selectedRole);
          roleSelect.value = selectedRole;
          controls.appendChild(roleSelect);
          controls.appendChild(button('Save role','rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white',async()=> {
            if (roleSelect.value === 'admin' && user.role !== 'admin' && !confirm('Grant full Administrator access to '+user.email+'?')) return;
            try {
              listMessage.textContent = 'Saving role…';
              if(String(roleSelect.value).startsWith('custom:')) await customRoleApi({action:'assign',userId:user.id,roleId:String(roleSelect.value).slice(7)});
              else await api({action:'set-role',userId:user.id,role:roleSelect.value});
              await load();
            } catch (error) { listMessage.textContent = error.message; }
          }));
        }

        controls.appendChild(button(user.status === 'pending' ? 'Send setup email' : 'Reset password','rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]',async()=> {
          try {
            listMessage.textContent = 'Sending password email…';
            const result = await api({action:'reset-password',userId:user.id});
            listMessage.textContent = result.message || 'Password email sent.';
          } catch (error) { listMessage.textContent = error.message; }
        }));

        controls.appendChild(button('Set password','rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]',()=> {
          passwordForm.reset();
          passwordForm.elements.userId.value = user.id;
          passwordUser.textContent = 'Set a new password for '+user.email+'.';
          passwordMessage.textContent = '';
          passwordDialog.showModal();
        }));

        controls.appendChild(button(user.security?.forcePasswordChange?'Clear forced change':'Force password change','rounded-full border border-amber-200 bg-amber-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-amber-800',async()=> {
          try {
            listMessage.textContent='Updating password requirement…';
            await api({action:'force-password-change',userId:user.id,force:!user.security?.forcePasswordChange});
            await load();
          } catch(error){listMessage.textContent=error.message;}
        }));

        controls.appendChild(button('Sign out everywhere','rounded-full border border-red-200 bg-white px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-red-700',async()=> {
          if(!confirm('Sign '+user.email+' out of all existing Koa’s sessions?'))return;
          try {
            listMessage.textContent='Revoking sessions…';
            const result=await api({action:'revoke-sessions',userId:user.id});
            listMessage.textContent=result.message||'Sessions revoked.';
            await load();
          } catch(error){listMessage.textContent=error.message;}
        }));

        controls.appendChild(button('Edit name','rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]',async()=> {
          const name = prompt('Display name for '+user.email, user.name || '');
          if (name === null) return;
          try {
            listMessage.textContent = 'Updating name…';
            await api({action:'set-name',userId:user.id,name});
            await load();
          } catch (error) { listMessage.textContent = error.message; }
        }));

        controls.appendChild(button('Edit job title','rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]',async()=> {
          const jobTitle = prompt('Job title for '+user.email+' (leave blank to use the role in email signatures):', user.jobTitle || '');
          if (jobTitle === null) return;
          try {
            listMessage.textContent = 'Updating job title…';
            await api({action:'set-job-title',userId:user.id,jobTitle});
            await load();
          } catch (error) { listMessage.textContent = error.message; }
        }));

        if (!user.protected && user.status !== 'deactivated') {
          controls.appendChild(button('Deactivate','rounded-full border border-amber-200 bg-amber-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-amber-800',async()=> {
            if (!confirm('Deactivate '+user.email+'? They will lose access until reactivated.')) return;
            try {
              listMessage.textContent = 'Deactivating account…';
              await api({action:'deactivate',userId:user.id});
              await load();
            } catch (error) { listMessage.textContent = error.message; }
          }));
        }

        if (!user.protected) {
          controls.appendChild(button('Delete','rounded-full border border-red-200 bg-red-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-red-700',async()=> {
            if (!confirm('Permanently delete '+user.email+'?')) return;
            if (!confirm('Final confirmation: this removes the Identity account and cannot be undone.')) return;
            try {
              listMessage.textContent = 'Deleting account…';
              await api({action:'delete',userId:user.id});
              await load();
            } catch (error) { listMessage.textContent = error.message; }
          }));
        }

        head.append(info, controls);
        card.appendChild(head);

        if (!user.protected && !['admin','deactivated'].includes(user.role)) {
          const permissions = document.createElement('div');
          permissions.className = 'mt-5 border-t border-[var(--koa-line)] pt-4';
          const title = document.createElement('p');
          title.className = 'text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]';
          title.textContent = 'Page + action permissions · role defaults are locked';
          permissions.appendChild(title);

          const grid = document.createElement('div');
          grid.className = 'mt-3 grid gap-2 sm:grid-cols-2';
          capabilityDefinitions.forEach((capability) => {
            const label = document.createElement('label');
            label.className = 'flex items-center gap-2 rounded-xl border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold';
            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.value = capability.id;
            const defaults=new Set(roleDefinitions.find((role)=>role.id===user.role)?.capabilities||[]);
            checkbox.checked = defaults.has(capability.id) || (user.permissions || []).includes(capability.id);
            checkbox.disabled = defaults.has(capability.id);
            label.append(checkbox, document.createTextNode(capability.label));
            grid.appendChild(label);
          });
          permissions.appendChild(grid);

          if (user.role !== 'admin') {
            permissions.appendChild(button('Save additional permissions','mt-3 rounded-full border border-[var(--koa-line)] bg-white px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]',async()=> {
              const selected = [...grid.querySelectorAll('input:checked')].map((input) => input.value);
              try {
                listMessage.textContent = 'Saving permissions…';
                await api({action:'set-permissions',userId:user.id,permissions:selected});
                await load();
              } catch (error) { listMessage.textContent = error.message; }
            }));
          }
          card.appendChild(permissions);
        }

        list.appendChild(card);
      });
    }

    function renderCustomRoleBuilder() {
      const caps=document.querySelector('[data-custom-role-capabilities]');
      if(caps){
        caps.innerHTML='';
        capabilityDefinitions.forEach((cap)=>{
          const label=document.createElement('label');label.className='flex items-start gap-2 rounded-xl border border-[var(--koa-line)] p-3 text-xs font-semibold';
          const input=document.createElement('input');input.type='checkbox';input.value=cap.id;input.className='mt-0.5';
          label.append(input,document.createTextNode(cap.label));caps.appendChild(label);
        });
      }
      const list=document.querySelector('[data-custom-role-list]');if(!list)return;list.innerHTML='';
      customRoleDefinitions.forEach((role)=>{
        const card=document.createElement('article');card.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
        const top=document.createElement('div');top.className='flex items-start justify-between gap-3';
        const info=document.createElement('div');info.innerHTML='<strong class="text-[var(--koa-forest)]"></strong><p class="mt-1 text-xs text-[var(--koa-ink)]/50"></p>';info.querySelector('strong').textContent=role.name;info.querySelector('p').textContent=role.description||((role.capabilities||[]).length+' permissions');
        const actions=document.createElement('div');actions.className='flex gap-2';
        actions.appendChild(button('Edit','rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.55rem] font-black uppercase tracking-[.06em]',()=>{
          const form=document.querySelector('[data-custom-role-form]');form.elements.id.value=role.id;form.elements.name.value=role.name;form.elements.description.value=role.description||'';
          const selected=new Set(role.capabilities||[]);form.querySelectorAll('[data-custom-role-capabilities] input').forEach(input=>input.checked=selected.has(input.value));form.scrollIntoView({behavior:'smooth',block:'center'});
        }));
        actions.appendChild(button('Delete','rounded-full border border-red-200 px-3 py-2 text-[.55rem] font-black uppercase tracking-[.06em] text-red-700',async()=>{
          if(!confirm('Delete custom role '+role.name+'?'))return;
          try{await customRoleApi({action:'delete',roleId:role.id});await load();}catch(error){document.querySelector('[data-custom-role-message]').textContent=error.message;}
        }));
        top.append(info,actions);card.appendChild(top);list.appendChild(card);
      });
      if(!customRoleDefinitions.length)list.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No custom roles yet.</p>';
    }

    function renderRoleMatrix() {
      const container=document.querySelector('[data-role-matrix]');
      if(!container)return;
      const labels=new Map(capabilityDefinitions.map((cap)=>[cap.id,cap.label]));
      container.innerHTML='';
      [...roleDefinitions,...customRoleDefinitions.map(role=>({id:'custom:'+role.id,label:role.name,capabilities:role.capabilities}))].forEach((role)=>{
        const card=document.createElement('article');
        card.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
        const title=document.createElement('h3');title.className='text-base font-semibold text-[var(--koa-forest)]';title.textContent=role.label;
        const list=document.createElement('ul');list.className='mt-3 grid gap-1.5 text-xs leading-5 text-[var(--koa-ink)]/58';
        (role.capabilities||[]).forEach((capability)=>{
          const item=document.createElement('li');item.textContent='• '+(labels.get(capability)||capability);list.appendChild(item);
        });
        if(!(role.capabilities||[]).length){const item=document.createElement('li');item.textContent='No default access';list.appendChild(item);}
        card.append(title,list);container.appendChild(card);
      });
    }

    function renderAudit(rows) {
      auditList.innerHTML = '';
      auditCount.textContent = rows.length+' entr'+(rows.length === 1 ? 'y' : 'ies');

      rows.forEach((entry) => {
        const card = document.createElement('article');
        card.className = 'rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
        const action = String(entry.action || 'activity').replaceAll('_',' ');
        const actorValue=String(entry.actor||entry.subjectEmail||'').trim().toLowerCase();
        const actorUser=allUsers.find((user)=>[user.email,user.name].some((value)=>String(value||'').trim().toLowerCase()===actorValue))||allUsers.find((user)=>actorValue.includes(String(user.email||'').toLowerCase()));
        const row=document.createElement('div');row.className='flex items-start gap-3';
        const avatar=document.createElement('div');avatar.className='flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[var(--koa-forest)] text-xs font-black text-white';
        if(actorUser?.photoUrl)avatar.innerHTML='<img src="'+actorUser.photoUrl+'" alt="" class="h-full w-full object-cover" />';else avatar.textContent=String(actorUser?.name||entry.actor||'K').trim().charAt(0).toUpperCase()||'K';
        const body=document.createElement('div');body.className='min-w-0 flex-1';
        body.append(
          Object.assign(document.createElement('p'), {className:'text-[.55rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]',textContent:action}),
          Object.assign(document.createElement('p'), {className:'mt-1 text-sm font-semibold text-[var(--koa-forest)]',textContent:entry.detail || ''}),
          Object.assign(document.createElement('p'), {className:'mt-2 text-xs text-[var(--koa-ink)]/48',textContent:[actorUser?.name||entry.actor,entry.subjectEmail,entry.recordId,new Date(entry.createdAt).toLocaleString()].filter(Boolean).join(' · ')})
        );
        row.append(avatar,body);card.appendChild(row);
        auditList.appendChild(card);
      });

      if (!rows.length) {
        auditList.innerHTML = '<p class="text-sm text-[var(--koa-ink)]/45">No user-management activity has been recorded yet.</p>';
      }
    }

    async function load() {
      try {
        listMessage.textContent = 'Loading accounts…';
        const [data,customData] = await Promise.all([api(),customRoleApi()]);
        capabilityDefinitions = data.capabilities || [];
        roleDefinitions = data.roles || [];
        customRoleDefinitions = customData.roles || [];
        securityPolicy = data.policy || {};
        allUsers = data.users || [];
        setSummary(data.summary || {});
        const policyForm=document.querySelector('[data-security-policy]');
        if(policyForm){
          const days=String(securityPolicy.passwordExpiryDays ?? 180);
          if([...policyForm.elements.passwordExpiryDays.options].some((option)=>option.value===days))policyForm.elements.passwordExpiryDays.value=days;
          policyForm.elements.requireChangeOnAdminSet.checked=securityPolicy.requireChangeOnAdminSet!==false;
        }
        const createRoleSelect=createForm?.elements?.role;if(createRoleSelect)createRoleSelect.innerHTML=roleOptionsHtml(createRoleSelect.value||'sales');
        renderUsers();
        renderCustomRoleBuilder();
        renderRoleMatrix();
        renderAudit(data.audit || []);
      } catch (error) {
        listMessage.textContent = error.message;
      }
    }

    document.querySelector('[data-custom-role-form]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();const form=event.currentTarget;const message=document.querySelector('[data-custom-role-message]');
      const capabilities=[...form.querySelectorAll('[data-custom-role-capabilities] input:checked')].map(input=>input.value);
      if(message)message.textContent='Saving…';
      try{await customRoleApi({action:'save',role:{id:form.elements.id.value,name:form.elements.name.value,description:form.elements.description.value,capabilities}});form.reset();if(message)message.textContent='Custom role saved.';await load();}catch(error){if(message)message.textContent=error.message;}
    });
    document.querySelector('[data-clear-custom-role]')?.addEventListener('click',()=>document.querySelector('[data-custom-role-form]')?.reset());

    createForm?.querySelectorAll('input[name="setupMode"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        const manual = createForm.elements.setupMode.value === 'manual';
        createPassword.classList.toggle('hidden', !manual);
        createPassword.querySelectorAll('input').forEach((input) => input.required = manual);
      });
    });

    createForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(createForm);
      const setupMode = String(data.get('setupMode') || 'email');
      const password = String(data.get('password') || '');
      const confirmPassword = String(data.get('confirmPassword') || '');

      if (setupMode === 'manual' && password !== confirmPassword) {
        createMessage.textContent = 'The passwords do not match.';
        return;
      }

      const requestedRole=String(data.get('role')||'sales');
      if (requestedRole === 'admin' && !confirm('Create a new account with full Administrator access?')) return;

      createMessage.textContent = 'Creating account…';
      try {
        const result = await api({
          action:'create-user',
          name:data.get('name'),
          jobTitle:data.get('jobTitle'),
          email:data.get('email'),
          role:requestedRole.startsWith('custom:')?'read_only':requestedRole,
          setupMode,
          password: setupMode === 'manual' ? password : undefined,
        });
        if(requestedRole.startsWith('custom:'))await customRoleApi({action:'assign',userId:result.user.id,roleId:requestedRole.slice(7)});
        createMessage.textContent = result.message || 'Account created.';
        createForm.reset();
        createPassword.classList.add('hidden');
        createPassword.querySelectorAll('input').forEach((input) => input.required = false);
        await load();
      } catch (error) {
        createMessage.textContent = error.message;
      }
    });

    document.querySelector('[data-security-policy]')?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const form=event.currentTarget;
      const message=document.querySelector('[data-security-policy-message]');
      if(message)message.textContent='Saving…';
      try{
        const result=await api({action:'save-security-policy',passwordExpiryDays:Number(form.elements.passwordExpiryDays.value),requireChangeOnAdminSet:Boolean(form.elements.requireChangeOnAdminSet.checked)});
        securityPolicy=result.policy;
        if(message)message.textContent='Security policy saved.';
        await load();
      }catch(error){if(message)message.textContent=error.message;}
    });

    passwordForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(passwordForm);
      const password = String(data.get('password') || '');
      const confirmPassword = String(data.get('confirmPassword') || '');

      if (password !== confirmPassword) {
        passwordMessage.textContent = 'The passwords do not match.';
        return;
      }

      passwordMessage.textContent = 'Updating password…';
      try {
        await api({action:'set-password',userId:data.get('userId'),password});
        passwordDialog.close();
        listMessage.textContent = 'Password updated.';
        await load();
      } catch (error) {
        passwordMessage.textContent = error.message;
      }
    });

    async function loadAuthSecurity(){
      try{
        authSecurityData=await authSecurityApi();
        const mfa=document.querySelector('[data-mfa-readiness]');
        if(mfa)mfa.textContent='MFA readiness: policy/UI hooks are prepared, but Netlify Identity in the current integration does not expose supported MFA enrollment/verification controls, so MFA is not being presented as enforced.';
        const list=document.querySelector('[data-security-user-list]');list.innerHTML='';
        (authSecurityData.users||[]).forEach((user)=>{
          const card=document.createElement('button');card.type='button';card.className='rounded-xl border border-[var(--koa-line)] p-4 text-left';
          card.innerHTML='<strong class="block text-sm text-[var(--koa-forest)]"></strong><span class="mt-1 block text-xs text-[var(--koa-ink)]/50"></span>';
          card.querySelector('strong').textContent=user.name||user.email;card.querySelector('span').textContent=user.activeSessions+' active session'+(user.activeSessions===1?'':'s')+' · '+user.suspiciousEvents+' suspicious event'+(user.suspiciousEvents===1?'':'s');
          card.onclick=()=>showSecurityUser(user.id);list.appendChild(card);
        });
      }catch(error){document.querySelector('[data-mfa-readiness]').textContent=error.message;}
    }
    async function showSecurityUser(userId){
      const data=await authSecurityApi(null,userId);const box=document.querySelector('[data-active-session-detail]');box.innerHTML='';
      const h=document.createElement('div');h.innerHTML='<h3 class="text-lg font-semibold text-[var(--koa-forest)]"></h3><p class="mt-1 text-xs text-[var(--koa-ink)]/45"></p>';h.querySelector('h3').textContent=data.user.name||data.user.email;h.querySelector('p').textContent=data.user.email;box.appendChild(h);
      const sessionWrap=document.createElement('div');sessionWrap.className='mt-4 grid gap-2';
      (data.sessions||[]).forEach((session)=>{
        const row=document.createElement('article');row.className='rounded-xl border border-[var(--koa-line)] p-3';
        const info=document.createElement('div');info.innerHTML='<strong class="text-sm"></strong><p class="mt-1 text-xs text-[var(--koa-ink)]/48"></p>';info.querySelector('strong').textContent=session.device+(session.current?' · Current session':'');info.querySelector('p').textContent='Last seen '+new Date(session.lastSeenAt).toLocaleString()+(session.revokedAt?' · Revoked '+new Date(session.revokedAt).toLocaleString():'');
        row.appendChild(info);
        if(session.active&&!session.current)row.appendChild(button('Revoke session','mt-2 rounded-full border border-red-200 px-3 py-2 text-[.55rem] font-black uppercase tracking-[.06em] text-red-700',async()=>{await authSecurityApi({action:'revoke-session',userId,sessionId:session.id});await showSecurityUser(userId);await loadAuthSecurity();}));
        sessionWrap.appendChild(row);
      });
      if(!(data.sessions||[]).length)sessionWrap.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No tracked sessions yet.</p>';
      box.appendChild(sessionWrap);
      const history=document.createElement('div');history.className='mt-5 grid gap-2';history.innerHTML='<h4 class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Recent login history</h4>';
      (data.events||[]).slice(0,20).forEach((event)=>{const row=document.createElement('div');row.className='rounded-lg bg-[var(--koa-sand)] p-3 text-xs';row.textContent=new Date(event.createdAt).toLocaleString()+' · '+event.type.replaceAll('_',' ')+(event.device?' · '+event.device:'')+(event.reasons?.length?' · '+event.reasons.join('; '):'');history.appendChild(row);});box.appendChild(history);
    }
    document.querySelector('[data-refresh-auth-security]')?.addEventListener('click',loadAuthSecurity);

    document.querySelector('[data-close-password]')?.addEventListener('click', () => passwordDialog.close());
    document.querySelector('[data-cancel-password]')?.addEventListener('click', () => passwordDialog.close());
    document.querySelector('[data-refresh]')?.addEventListener('click', load);
    search?.addEventListener('input', renderUsers);
    roleFilter?.addEventListener('change', renderUsers);
    statusFilter?.addEventListener('change', renderUsers);

    const user = await getAdminSession();
    const ok = isAdmin(user);
    app?.classList.toggle('hidden', !ok);
    unauthorized?.classList.toggle('hidden', ok);
    if (ok) { await load(); await loadAuthSecurity(); }
  </script>
</BaseLayout>
