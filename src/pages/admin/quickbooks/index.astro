        }else{
          syncReconciliationDeviations.innerHTML='<div class="flex items-end justify-between gap-3"><div><p class="text-[.55rem] font-black uppercase tracking-[.07em] text-amber-900">Execution differences</p><p class="mt-1 text-xs text-[var(--koa-ink)]/50">Review each difference before treating the sync as fully reconciled.</p></div></div><div class="mt-2 grid gap-2">'+deviations.map((row)=>{
