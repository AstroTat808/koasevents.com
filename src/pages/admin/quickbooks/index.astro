    function readAutoRules(){
      return [...(autoRuleList()?.querySelectorAll('[data-auto-rule]')||[])].map((row,index)=>({
        id:row.dataset.ruleId||('rule-'+index),
        name:String(row.querySelector('[data-rule-name]')?.value||'Payment rule').trim(),
        category:row.querySelector('[data-rule-category]')?.value||'default',
        minLeadDays:row.querySelector('[data-rule-min]')?.value===''?null:Math.round(Number(row.querySelector('[data-rule-min]')?.value)*30.4375),
        maxLeadDays:row.querySelector('[data-rule-max]')?.value===''?null:Math.round(Number(row.querySelector('[data-rule-max]')?.value)*30.4375),
        minContractValue:row.querySelector('[data-rule-min-value]')?.value===''?null:Number(row.querySelector('[data-rule-min-value]')?.value),
        maxContractValue:row.querySelector('[data-rule-max-value]')?.value===''?null:Number(row.querySelector('[data-rule-max-value]')?.value),
        contractValueBasis:row.querySelector('[data-rule-value-basis]')?.value==='beforeGet'?'beforeGet':'afterGet',
        presetId:row.querySelector('[data-rule-preset]')?.value||'',
