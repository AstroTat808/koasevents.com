---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s QuickBooks Setup" description="Connect Koa’s Events CRM to QuickBooks Online." canonical="https://www.koasevents.com/admin/quickbooks/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-5xl">
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Accounting</p>
          <h1 class="display mt-3 text-5xl">QuickBooks Online</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">QuickBooks is Koa’s financial system of record for estimates, invoices and payments. The CRM keeps a synchronized accounting mirror—customer links, document numbers, line summaries, balances, payment references, statuses and sync timestamps—so staff can work from either system.</p>
        </div>
        
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8"><strong class="text-[var(--koa-forest)]">QuickBooks access required.</strong><p class="mt-2 text-sm text-[var(--koa-ink)]/58">You are signed in, but your role does not include QuickBooks access.</p></div>

      <div data-app class="hidden grid gap-6">
        <section class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Connection</p>
              <h2 data-company class="display mt-3 text-4xl">Not connected</h2>
              <p data-status class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/58"></p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button data-preview-two-way type="button" class="hidden rounded-full border border-[var(--koa-line)] bg-white px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Preview Sync</button>
              <button data-two-way-sync type="button" disabled class="hidden rounded-full bg-[var(--koa-clay)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white disabled:cursor-not-allowed disabled:opacity-40">Run Approved Sync</button>
              <a data-sync-history href="/admin/quickbooks/history/" class="hidden rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Sync History</a>
              <button data-connect type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Connect QuickBooks</button>
              <button data-disconnect type="button" class="hidden rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Disconnect</button>
            </div>
          </div>
          <div data-two-way-sync-panel class="mt-6 hidden rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 p-5">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Manual two-way synchronization</p>
                <p data-two-way-sync-status class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">Run Preview Sync before applying changes.</p>
                <p data-two-way-sync-detail class="mt-1 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/52">Preview is read-only for CRM and QuickBooks business data. Every proposed new CRM import must be explicitly approved, and ambiguous matches must be resolved, before Run Approved Sync is enabled.</p>
              </div>
              <div class="flex shrink-0 flex-wrap gap-2">
                <button data-export-preview-csv type="button" class="hidden rounded-full border border-[var(--koa-line)] bg-white px-4 py-2.5 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Export CSV</button>
                <button data-export-preview-pdf type="button" class="hidden rounded-full border border-[var(--koa-line)] bg-white px-4 py-2.5 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Export PDF</button>
                <a href="/admin/crm/" class="rounded-full border border-[var(--koa-line)] bg-white px-4 py-2.5 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Open CRM</a>
              </div>
            </div>

            <section data-suggestion-rules-panel class="mt-5 border-t border-[var(--koa-line)] pt-5">
              <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0">
                  <p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Suggested exclusion rules</p>
                  <h3 class="display mt-2 text-2xl text-[var(--koa-forest)]">Teach Preview Sync which system/test customers to flag</h3>
                  <p class="mt-1 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/52">Rules only create suggestions. They never exclude a QuickBooks customer automatically. Use exact-name or phrase matching against the customer name or QuickBooks notes, then choose the exclusion classification.</p>
                  <p data-suggestion-rule-meta class="mt-2 text-[.6rem] font-semibold text-[var(--koa-ink)]/45"></p>
                </div>
                <div class="flex shrink-0 flex-wrap gap-2">
                  <button data-add-suggestion-rule type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-[var(--koa-forest)]">Add rule</button>
                  <button data-reset-suggestion-reviews type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">Reset reviewed suggestions</button>
                  <button data-reset-suggestion-rules type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">Restore defaults</button>
                  <button data-save-suggestion-rules type="button" class="rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-white">Save rules</button>
                </div>
              </div>
              <div data-suggestion-rule-list class="mt-4 grid gap-2"></div>
              <p data-suggestion-rule-message class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/52"></p>
            </section>

            <div data-sync-preview class="mt-5 hidden border-t border-[var(--koa-line)] pt-5">
              <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-7">
                <article class="rounded-xl bg-white p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">New CRM imports</p><strong data-preview-new class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
                <article class="rounded-xl bg-white p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">Matched</p><strong data-preview-matched class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
                <article class="rounded-xl bg-white p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">Already linked</p><strong data-preview-linked class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
                <article class="rounded-xl bg-white p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">Excluded</p><strong data-preview-excluded class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
                <article class="rounded-xl bg-white p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">Suggested exclusion</p><strong data-preview-suggested-excluded class="display mt-2 block text-3xl text-amber-800">0</strong></article>
                <article class="rounded-xl bg-white p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">CRM → QBO actions</p><strong data-preview-outbound class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
                <article class="rounded-xl bg-white p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">Needs decision</p><strong data-preview-ambiguous class="display mt-2 block text-3xl text-[var(--koa-clay)]">0</strong></article>
              </div>

              <section data-preview-review-warning class="mt-4 hidden rounded-xl border border-amber-200 bg-amber-50 p-4">
                <strong data-preview-review-warning-title class="text-sm text-amber-950"></strong>
                <p data-preview-review-warning-detail class="mt-1 text-xs leading-5 text-amber-950/65"></p>
              </section>

              <div class="mt-4 grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,.8fr)_minmax(0,1fr)_auto] lg:items-end">
                <label class="grid min-w-0 gap-2 text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Preview customer filter
                  <select data-preview-filter class="min-w-0 rounded-xl border border-[var(--koa-line)] bg-white px-3 py-2.5 text-xs font-semibold normal-case tracking-normal text-[var(--koa-ink)]">
                    <option value="all">All customers</option>
                    <option value="new">New Imports</option>
                    <option value="auto">Auto-Matched</option>
                    <option value="approved">Staff-Approved</option>
                    <option value="invoices">Has Invoices</option>
                    <option value="payments">Has Payments</option>
                    <option value="balance">Has Open Balance</option>
                    <option value="decision">Needs Decision</option>
                    <option value="duplicates">Likely Duplicates / Review</option>
                    <option value="suggested">Suggested Exclusions</option>
                    <option value="excluded">Excluded from Sync</option>
                  </select>
                </label>
                <label class="grid min-w-0 gap-2 text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Exclusion reason
                  <select data-exclusion-reason-filter class="min-w-0 rounded-xl border border-[var(--koa-line)] bg-white px-3 py-2.5 text-xs font-semibold normal-case tracking-normal text-[var(--koa-ink)]">
                    <option value="all">All exclusion reasons</option>
                    <option value="quickbooks_test_customer">QuickBooks test customer</option>
                    <option value="square_system_customer">Square system customer</option>
                    <option value="system_customer">System / integration customer</option>
                    <option value="vendor_non_client">Vendor / non-client</option>
                    <option value="duplicate">Duplicate</option>
                    <option value="other">Other</option>
                  </select>
                </label>
                <label class="grid min-w-0 gap-2 text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Search preview
                  <input data-preview-search type="search" placeholder="Customer, email, CRM ID, QBO ID…" class="min-w-0 rounded-xl border border-[var(--koa-line)] bg-white px-3 py-2.5 text-xs font-semibold normal-case tracking-normal text-[var(--koa-ink)]" />
                </label>
                <span data-preview-filter-count class="pb-2 text-xs font-semibold text-[var(--koa-ink)]/48"></span>
              </div>

              <section data-exclusion-tools class="mt-4 hidden rounded-xl border border-slate-200 bg-slate-50 p-4">
                <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
                  <div class="min-w-0">
                    <strong class="text-sm text-slate-900">Exclusion cleanup</strong>
                    <p data-bulk-exclusion-detail class="mt-1 text-xs leading-5 text-slate-600"></p>
                    <div data-exclusion-report class="mt-3 flex flex-wrap gap-2"></div>
                    <button data-review-suggested-exclusions type="button" class="mt-3 hidden rounded-full bg-amber-800 px-4 py-2.5 text-[.54rem] font-black uppercase tracking-[.06em] text-white">Review suggested exclusions</button>
                  </div>
                  <div class="grid min-w-0 gap-2 sm:grid-cols-[minmax(0,14rem)_minmax(0,15rem)_auto_auto_auto] sm:items-end">
                    <label class="grid gap-1 text-[.5rem] font-black uppercase tracking-[.06em] text-slate-600">Bulk exclusion reason
                      <select data-bulk-exclusion-reason class="rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold normal-case tracking-normal text-slate-800">
                        <option value="suggested">Use each suggested reason</option>
                        <option value="quickbooks_test_customer">QuickBooks test customer</option>
                        <option value="square_system_customer">Square system customer</option>
                        <option value="system_customer">System / integration customer</option>
                        <option value="vendor_non_client">Vendor / non-client</option>
                        <option value="duplicate">Duplicate</option>
                        <option value="other">Other</option>
                      </select>
                    </label>
                    <label class="grid gap-1 text-[.5rem] font-black uppercase tracking-[.06em] text-slate-600">Optional note
                      <input data-bulk-exclusion-note type="text" maxlength="500" placeholder="Optional reason detail" class="rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold normal-case tracking-normal text-slate-800" />
                    </label>
                    <button data-bulk-exclude-suggested type="button" class="rounded-full border border-slate-300 bg-white px-3 py-2 text-[.52rem] font-black uppercase tracking-[.06em] text-slate-700">Select suggested shown</button>
                    <button data-bulk-exclude-clear type="button" class="rounded-full border border-slate-300 bg-white px-3 py-2 text-[.52rem] font-black uppercase tracking-[.06em] text-slate-700">Clear exclude selection</button>
                    <button data-bulk-exclude type="button" disabled class="rounded-full bg-slate-800 px-3 py-2 text-[.52rem] font-black uppercase tracking-[.06em] text-white disabled:cursor-not-allowed disabled:opacity-40">Exclude selected (0)</button>
                  </div>
                </div>
              </section>

              <section data-match-review class="mt-5 hidden rounded-xl border border-amber-200 bg-amber-50 p-4">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                  <div><p class="text-xs font-black uppercase tracking-[.08em] text-amber-900">Customer decisions required</p><p class="mt-1 text-xs leading-5 text-amber-950/65">New CRM imports require explicit approval. Ambiguous matches require you to choose the correct CRM client or approve a new import. Run Approved Sync remains disabled until every decision is resolved.</p></div>
                  <span data-match-review-count class="rounded-full bg-amber-900 px-3 py-2 text-[.55rem] font-black uppercase tracking-[.08em] text-white"></span>
                </div>
                <div data-match-review-list class="mt-4 grid gap-4"></div>
              </section>

              <div class="mt-5 grid min-w-0 gap-4 xl:grid-cols-2">
                <section class="min-w-0 rounded-xl border border-[var(--koa-line)] bg-white p-4">
                  <p class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">1 · Proposed CRM imports</p>
                  <p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">QuickBooks customers that do not yet have a confirmed CRM record. Only low-risk rows with no duplicate evidence can be bulk-approved; questionable rows stay individual-review only.</p>
                  <div data-bulk-review class="mt-3 hidden rounded-xl border border-emerald-200 bg-emerald-50 p-3">
                    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                      <div class="min-w-0">
                        <strong class="text-sm text-emerald-950">Bulk review · low-risk only</strong>
                        <p data-bulk-review-detail class="mt-1 text-xs leading-5 text-emerald-950/65"></p>
                      </div>
                      <div class="flex flex-wrap gap-2">
                        <button data-bulk-select-visible type="button" class="rounded-full border border-emerald-300 bg-white px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-emerald-900">Select low-risk shown</button>
                        <button data-bulk-clear type="button" class="rounded-full border border-emerald-300 bg-white px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-emerald-900">Clear</button>
                        <button data-bulk-approve type="button" disabled class="rounded-full bg-emerald-800 px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-white disabled:cursor-not-allowed disabled:opacity-40">Approve selected (0)</button>
                      </div>
                    </div>
                  </div>
                  <div data-preview-imports class="mt-3 grid max-h-[70vh] min-w-0 gap-2 overflow-y-auto pr-1"></div>
                </section>
                <section class="min-w-0 rounded-xl border border-[var(--koa-line)] bg-white p-4">
                  <p class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">2 · Existing CRM matches</p>
                  <p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">Customers already linked, auto-matched, or explicitly matched by staff.</p>
                  <div data-preview-matches class="mt-3 grid max-h-[70vh] min-w-0 gap-2 overflow-y-auto pr-1"></div>
                </section>
                <section class="min-w-0 rounded-xl border border-[var(--koa-line)] bg-white p-4 xl:col-span-2">
                  <p class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">3 · CRM → QuickBooks updates</p>
                  <p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48">Only CRM-origin customer and estimate fields shown here would be written to QuickBooks. Invoices and payments remain QuickBooks-owned.</p>
                  <div data-preview-outbound-list class="mt-3 grid min-w-0 gap-2 lg:grid-cols-2"></div>
                </section>
              </div>
              <p data-preview-generated class="mt-4 text-xs text-[var(--koa-ink)]/45"></p>
            </div>

            <section data-sync-reconciliation class="mt-5 hidden border-t border-[var(--koa-line)] pt-5">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Post-sync reconciliation</p>
                  <h3 class="display mt-2 text-3xl text-[var(--koa-forest)]">Prediction vs actual execution</h3>
                  <p data-sync-reconciliation-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/50"></p>
                </div>
                <span data-sync-reconciliation-status class="self-start rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.55rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]"></span>
              </div>
              <div data-sync-reconciliation-counts class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></div>
              <div data-sync-reconciliation-deviations class="mt-4 grid gap-2"></div>
            </section>
          </div>
          <div data-config-warning class="mt-6 hidden rounded-xl border border-[var(--koa-amber)]/35 bg-[var(--koa-amber-light)]/20 p-5">
            <p class="font-semibold text-[var(--koa-ink)]">Intuit app credentials are not configured on Netlify yet.</p>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/60">Add the two Intuit app credentials below, then return here and connect Koa’s QuickBooks company. The client secret is never entered into the browser.</p>
            <div class="mt-4 grid gap-2 font-mono text-xs text-[var(--koa-forest)]">
              <code>QUICKBOOKS_CLIENT_ID</code>
              <code>QUICKBOOKS_CLIENT_SECRET</code>
            </div>
            <p class="mt-4 text-xs leading-5 text-[var(--koa-ink)]/50">Registered Intuit redirect URI: <code data-redirect-uri></code></p>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Diagnostics</p>
              <h2 class="display mt-3 text-4xl">QuickBooks integration health</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Connection, webhook delivery, CRM synchronization and the most recent sandbox verification.</p>
            </div>
            <button data-refresh-diagnostics type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Refresh diagnostics</button>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Connection</p><strong data-diag-connection class="mt-2 block text-base text-[var(--koa-forest)]">Checking…</strong><p data-diag-company class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last webhook received</p><strong data-diag-webhook class="mt-2 block text-base text-[var(--koa-forest)]">None yet</strong><p data-diag-webhook-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last CRM sync</p><strong data-diag-sync class="mt-2 block text-base text-[var(--koa-forest)]">None yet</strong><p data-diag-sync-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last sandbox test</p><strong data-diag-test class="mt-2 block text-base text-[var(--koa-forest)]">Not run</strong><p data-diag-test-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
          </div>
          <div data-diag-webhook-check class="mt-4 rounded-xl border border-[var(--koa-line)] bg-white p-4 text-sm text-[var(--koa-ink)]/60"></div>
        </section>

        <section id="accounting-audit" data-accounting-audit class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Accounting reconciliation</p>
              <h2 class="display mt-3 text-4xl">CRM ↔ QuickBooks audit</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Flags clients only when the CRM proposal, QuickBooks estimate, milestone invoices, payments received, or remaining balances do not mathematically reconcile.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span data-audit-status class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Checking…</span>
              <button data-test-accounting-alert type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Test Accounting Alert</button>
              <button data-refresh-audit type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Reload audit</button>
            </div>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Clients checked</p><strong data-audit-clients class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Flagged</p><strong data-audit-flagged class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
