    function renderAutoRules(){
      const list=autoRuleList();if(!list)return;list.innerHTML='';
      [...(state?.depositSettings?.autoRules||[])].sort((a,b)=>Number(a.priority||0)-Number(b.priority||0)).forEach((rule)=>addAutoRuleRow(rule));
