    async function downloadPreviewAudit(format){
      const previewId=String(state?.manualSyncPreview?.previewId||'');
      if(!previewId)throw new Error('Run Preview Sync before exporting an audit.');
      const button=format==='pdf'?exportPreviewPdf:exportPreviewCsv;
      const original=button?.textContent||'Export';
      if(button){button.disabled=true;button.textContent='Exporting…';}
      try{
        const res=await fetch('/api/admin/quickbooks?view=preview-export&format='+encodeURIComponent(format)+'&previewId='+encodeURIComponent(previewId),{cache:'no-store'});
        if(!res.ok){
          const data=await res.json().catch(()=>({}));
          throw new Error(data.error||'Preview audit export failed.');
        }
        const blob=await res.blob();
        const disposition=String(res.headers.get('Content-Disposition')||'');
        const match=disposition.match(/filename="([^"]+)"/i);
        const filename=match?.[1]||('quickbooks-crm-preview-audit.'+format);
        const url=URL.createObjectURL(blob);
        const link=document.createElement('a');link.href=url;link.download=filename;document.body.appendChild(link);link.click();link.remove();
        setTimeout(()=>URL.revokeObjectURL(url),1000);
      }finally{
        if(button){button.disabled=false;button.textContent=original;}
      }
    }

    function executionSummaryFor(preview){
      if(preview?.executionSummary)return preview.executionSummary;
      const plans=Array.isArray(preview?.customerPlans)?preview.customerPlans:[];
      const outbound=Array.isArray(preview?.outbound)?preview.outbound:[];
      const writable=outbound.flatMap((row)=>(Array.isArray(row.actions)?row.actions:[]).map((action)=>({...action,recordId:row.recordId})));
      return {
        crmCustomersCreated:plans.filter((row)=>row.decision==='approved_new'&&row.action==='import_new').length,
        crmCustomersMatched:plans.filter((row)=>['linked','auto_match','approved_match'].includes(String(row.decision||''))&&row.action==='refresh_match').length,
        crmCustomersSkipped:plans.filter((row)=>row.decision==='new'||row.decision==='excluded'||String(row?.executionDisposition||'').startsWith('skip_')).length,
        crmCustomersSkippedUnapproved:plans.filter((row)=>row.decision==='new').length,
        crmCustomersSkippedCapacity:plans.filter((row)=>row.executionDisposition==='skip_capacity').length,
        crmCustomersExcluded:plans.filter((row)=>row.decision==='excluded'||row.executionDisposition==='excluded').length,
        crmCustomersBlockedDuplicates:plans.filter((row)=>row.decision==='ambiguous').length,
        quickBooksRecordsWritten:new Set(writable.filter((row)=>['create','update'].includes(String(row.action||''))).map((row)=>String(row.recordId||''))).size,
        quickBooksActionsWritten:writable.filter((row)=>['create','update'].includes(String(row.action||''))).length,
        quickBooksCustomerCreates:writable.filter((row)=>row.type==='customer'&&row.action==='create').length,
        quickBooksCustomerUpdates:writable.filter((row)=>row.type==='customer'&&row.action==='update').length,
        quickBooksEstimateCreates:writable.filter((row)=>row.type==='estimate'&&row.action==='create').length,
        quickBooksEstimateUpdates:writable.filter((row)=>row.type==='estimate'&&row.action==='update').length,
        quickBooksBlockedActions:writable.filter((row)=>row.action==='blocked').length,
        ready:Number(preview?.summary?.needsDecision||0)===0,
      };
    }

    function preflightValue(value){
      if(value===undefined||value===null||value==='')return '—';
      if(typeof value==='object')return JSON.stringify(value);
      return String(value);
    }

    function preflightFieldChangesHtml(changes){
