        rulePresetOptions(category).forEach((preset)=>{const option=document.createElement('option');option.value=preset.id;option.textContent=preset.label||preset.name;select.appendChild(option);});
        if([...select.options].some((option)=>option.value===current))select.value=current;
      };
      const handle=row.querySelector('[data-rule-drag]');
      handle.addEventListener('dragstart',(event)=>{draggingAutoRule=row;event.dataTransfer.effectAllowed='move';event.dataTransfer.setData('text/plain',rule.id||'rule');row.classList.add('opacity-45','ring-2','ring-[var(--koa-clay)]');});
