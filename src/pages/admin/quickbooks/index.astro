    function readTemplate(key){
      const list=templateList(key);
      const rows=[...(list?.querySelectorAll('[data-template-row]')||[])];
      return rows.map((row,index)=>({
        label:String(row.querySelector('[data-template-label]')?.value||'Payment').trim(),
        dueDaysBefore:Number(row.querySelector('[data-template-days]')?.value||0),
