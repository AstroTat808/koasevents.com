    async function saveMatch(customerId,decision,recordId='',reason='',reasonCode=''){
      const result=await api({action:'save-customer-match',customerId,decision,recordId,reason,reasonCode});
      return result;
    }

    function previewPlanMatchesFilter(plan){
      const value=String(previewFilter?.value||'all');
      const decision=String(plan?.decision||'');
      let matches=value==='all'?decision!=='excluded':true;
      if(value==='new')matches=['new','approved_new'].includes(decision);
      else if(value==='auto')matches=decision==='auto_match';
      else if(value==='approved')matches=['approved_match','approved_new'].includes(decision);
      else if(value==='invoices')matches=Number(plan?.financial?.invoices||0)>0;
      else if(value==='payments')matches=Number(plan?.financial?.payments||0)>0;
      else if(value==='balance')matches=Number(plan?.financial?.openBalance||0)>0.009;
      else if(value==='decision')matches=['new','ambiguous'].includes(decision);
      else if(value==='duplicates')matches=decision==='ambiguous'||(decision==='new'&&!plan?.bulkEligible)||['high','medium','review'].includes(String(plan?.duplicateRisk?.level||''));
      else if(value==='suggested')matches=unresolvedExclusionEligible(plan)&&Boolean(plan?.suggestedExclusion);
      else if(value==='excluded')matches=decision==='excluded';
      if(!matches)return false;

      const reasonFilter=String(exclusionReasonFilter?.value||'all');
      if(reasonFilter!=='all'&&value==='excluded'){
        if(String(plan?.exclusion?.reasonCode||'other')!==reasonFilter)return false;
      }
      if(reasonFilter!=='all'&&value==='suggested'){
        if(String(plan?.suggestedExclusion?.code||'')!==reasonFilter)return false;
      }

      const query=String(previewSearch?.value||'').trim().toLowerCase();
      if(!query)return true;
      const haystack=[
        plan?.customerId,plan?.qbo?.name,plan?.qbo?.email,plan?.qbo?.phone,plan?.qbo?.eventDate,
        plan?.matchedRecordId,plan?.predictedRecordId,plan?.decision,plan?.reason,plan?.duplicateRisk?.level,
        plan?.exclusion?.reasonCode,plan?.exclusion?.reasonLabel,plan?.exclusion?.reason,
        plan?.suggestedExclusion?.code,plan?.suggestedExclusion?.label,plan?.suggestedExclusion?.reason,
        ...(Array.isArray(plan?.suggestedExclusion?.evidence)?plan.suggestedExclusion.evidence:[]),
        ...(Array.isArray(plan?.duplicateRisk?.signals)?plan.duplicateRisk.signals:[]),
        ...(Array.isArray(plan?.candidates)?plan.candidates.flatMap((row)=>[row?.recordId,row?.name,row?.email,row?.phone,row?.reason]):[]),
        ...(Array.isArray(plan?.financial?.estimateDocs)?plan.financial.estimateDocs.map((row)=>row?.docNumber||row?.id):[]),
        ...(Array.isArray(plan?.financial?.invoiceDocs)?plan.financial.invoiceDocs.map((row)=>row?.docNumber||row?.id):[]),
      ].join(' ').toLowerCase();
      return haystack.includes(query);
    }

    function wirePreviewDecisionButtons(container){
      if(!container)return;
      container.querySelectorAll('[data-match-reset]').forEach((button)=>button.addEventListener('click',async()=>{
        button.disabled=true;button.textContent='Resetting…';
        try{
          bulkSelectedNew.delete(String(button.dataset.matchReset||''));
          bulkSelectedExclude.delete(String(button.dataset.matchReset||''));
          await saveMatch(button.dataset.matchReset,'clear','');
          await runPreviewSync();
        }catch(err){alert(err.message||'Unable to reset matching decision.');button.disabled=false;button.textContent='Reset decision';}
      }));
      container.querySelectorAll('[data-match-new]').forEach((button)=>button.addEventListener('click',async()=>{
        if(!confirm('Approve importing this QuickBooks customer as a new CRM client? Review the duplicate-risk evidence, invoices, payments and exact before/after values first.'))return;
        button.disabled=true;button.textContent='Approving…';
        try{
          const id=String(button.dataset.matchNew||'');
          bulkSelectedNew.delete(id);
          bulkSelectedExclude.delete(id);
          await saveMatch(id,'new','');
          await runPreviewSync();
        }catch(err){alert(err.message||'Unable to approve new CRM import.');button.disabled=false;button.textContent='Approve individually';}
      }));
      container.querySelectorAll('[data-match-exclude]').forEach((button)=>button.addEventListener('click',()=>{
        openExclusionDialogFor(button.dataset.matchExclude||'');
      }));
      container.querySelectorAll('[data-bulk-select]').forEach((input)=>input.addEventListener('change',()=>{
        const id=String(input.dataset.bulkSelect||'');
        if(input.checked){
          bulkSelectedNew.add(id);
          bulkSelectedExclude.delete(id);
        }else bulkSelectedNew.delete(id);
        renderSyncPreview();
      }));
      container.querySelectorAll('[data-exclude-select]').forEach((input)=>input.addEventListener('change',()=>{
        const id=String(input.dataset.excludeSelect||'');
        if(input.checked){
          bulkSelectedExclude.add(id);
          bulkSelectedNew.delete(id);
        }else bulkSelectedExclude.delete(id);
        renderSyncPreview();
      }));
    }

    function visibleBulkEligiblePlans(){
      const plans=Array.isArray(state?.manualSyncPreview?.customerPlans)?state.manualSyncPreview.customerPlans:[];
      return plans.filter(previewPlanMatchesFilter).filter((plan)=>String(plan?.decision||'')==='new'&&Boolean(plan?.bulkEligible));
    }

    async function approveBulkSelected(){
      const preview=state?.manualSyncPreview;
      const customerIds=[...bulkSelectedNew];
      if(!preview?.previewId)throw new Error('Run Preview Sync first.');
      if(!customerIds.length)throw new Error('Select at least one low-risk new customer.');
      const names=(Array.isArray(preview.customerPlans)?preview.customerPlans:[]).filter((plan)=>customerIds.includes(String(plan.customerId))).map((plan)=>plan?.qbo?.name||plan.customerId);
      if(!confirm('Approve '+customerIds.length+' low-risk QuickBooks customer'+(customerIds.length===1?'':'s')+' as new CRM clients?\n\n'+names.slice(0,8).join('\n')+(names.length>8?'\n…and '+(names.length-8)+' more':'')+'\n\nRows with duplicate evidence or missing reliable contact data cannot be bulk-approved.'))return;
      const original=bulkApprove?.textContent||'Approve selected';
      if(bulkApprove){bulkApprove.disabled=true;bulkApprove.textContent='Approving…';}
      try{
        await api({action:'bulk-approve-new-customers',previewId:preview.previewId,customerIds});
        bulkSelectedNew.clear();
        await runPreviewSync();
      }finally{
        if(bulkApprove)bulkApprove.textContent=original;
      }
    }

    function visibleSuggestedExclusionPlans(){
      const plans=Array.isArray(state?.manualSyncPreview?.customerPlans)?state.manualSyncPreview.customerPlans:[];
      return plans.filter(previewPlanMatchesFilter).filter((plan)=>unresolvedExclusionEligible(plan)&&Boolean(plan?.suggestedExclusion));
    }

    async function excludeBulkSelected(){
      const preview=state?.manualSyncPreview;
      const customerIds=[...bulkSelectedExclude];
      if(!preview?.previewId)throw new Error('Run Preview Sync first.');
      if(!customerIds.length)throw new Error('Select at least one unresolved customer to exclude.');
      const plans=Array.isArray(preview.customerPlans)?preview.customerPlans:[];
      const selectedPlans=plans.filter((plan)=>customerIds.includes(String(plan.customerId)));
      const reasonCode=String(bulkExclusionReason?.value||'suggested');
      if(reasonCode==='suggested'&&selectedPlans.some((plan)=>!plan?.suggestedExclusion?.code)){
        throw new Error('Use a specific exclusion reason when the selection includes customers without a Preview Sync suggestion.');
      }
      const reasonLabel=reasonCode==='suggested'
        ? 'each customer’s suggested reason'
        : exclusionReasonLabel(reasonCode);
      const names=selectedPlans.map((plan)=>plan?.qbo?.name||plan.customerId);
      if(!confirm('Exclude '+customerIds.length+' QuickBooks customer'+(customerIds.length===1?'':'s')+' from CRM synchronization using '+reasonLabel+'?\n\n'+names.slice(0,10).join('\n')+(names.length>10?'\n…and '+(names.length-10)+' more':'')+'\n\nNothing will be deleted or changed in QuickBooks. These exclusions can be restored later.'))return;
      const original=bulkExclude?.textContent||'Exclude selected';
      if(bulkExclude){bulkExclude.disabled=true;bulkExclude.textContent='Excluding…';}
      try{
        await api({
          action:'bulk-exclude-customers',
          previewId:preview.previewId,
          customerIds,
          reasonCode,
          reason:String(bulkExclusionNote?.value||'').trim(),
        });
        bulkSelectedExclude.clear();
        if(bulkExclusionNote)bulkExclusionNote.value='';
        await runPreviewSync();
      }finally{
        if(bulkExclude)bulkExclude.textContent=original;
      }
    }

    function outboundActionHtml(action){
      const before=action?.before==null?'':JSON.stringify(action.before,null,2);
      const after=action?.after==null?'':JSON.stringify(action.after,null,2);
      const title=[action?.type||'Update',action?.field||action?.action||'change'].filter(Boolean).join(' · ');
      return '<div class="min-w-0 rounded-lg border border-[var(--koa-line)] bg-white p-3"><strong class="block break-words text-xs text-[var(--koa-forest)]">'+esc(title)+'</strong>'+(action?.reason?'<p class="mt-1 break-words text-[.62rem] leading-5 text-[var(--koa-ink)]/48">'+esc(action.reason)+'</p>':'')+((before||after)?'<details class="mt-2 min-w-0"><summary class="cursor-pointer text-[.55rem] font-black uppercase tracking-[.06em] text-[var(--koa-clay)]">Exact before / after</summary><div class="mt-2 grid min-w-0 gap-2 lg:grid-cols-2"><div class="min-w-0 rounded-lg bg-red-50 p-2"><p class="text-[.5rem] font-black uppercase tracking-[.06em] text-red-800">Before</p><pre class="mt-1 max-h-56 min-w-0 overflow-auto whitespace-pre-wrap break-all text-[.62rem] leading-5 text-[var(--koa-ink)]/60">'+esc(before||'null')+'</pre></div><div class="min-w-0 rounded-lg bg-emerald-50 p-2"><p class="text-[.5rem] font-black uppercase tracking-[.06em] text-emerald-800">After</p><pre class="mt-1 max-h-56 min-w-0 overflow-auto whitespace-pre-wrap break-all text-[.62rem] leading-5 text-[var(--koa-ink)]/60">'+esc(after||'null')+'</pre></div></div></details>':'')+'</div>';
    }

    function renderSyncPreview(){
      const preview=state?.manualSyncPreview;
      if(!syncPreview)return;
      const valid=Boolean(preview?.previewId&&preview?.generatedAt&&Date.parse(preview.expiresAt||0)>Date.now());
      syncPreview.classList.toggle('hidden',!preview);
      exportPreviewCsv?.classList.toggle('hidden',!preview);
      exportPreviewPdf?.classList.toggle('hidden',!preview);
      const summary=preview?.summary||{};
      if(previewNew)previewNew.textContent=Number(summary.newImports||0);
      if(previewMatched)previewMatched.textContent=Number(summary.matched||0);
      if(previewLinked)previewLinked.textContent=Number(summary.linked||0);
      if(previewExcluded)previewExcluded.textContent=Number(summary.excludedCustomers||0);
      if(previewSuggestedExcluded)previewSuggestedExcluded.textContent=Number(summary.suggestedExclusions||0);
      if(reviewSuggestedExclusions){
        const suggestionCount=Number(summary.suggestedExclusions||0);
        reviewSuggestedExclusions.classList.toggle('hidden',!preview||suggestionCount===0);
        reviewSuggestedExclusions.textContent='Review suggested exclusions ('+suggestionCount+')';
        reviewSuggestedExclusions.disabled=suggestionCount===0;
        if(suggestionCount===0&&suggestedReviewDialog?.open)suggestedReviewDialog.close();
      }
      if(previewOutbound)previewOutbound.textContent=Number(summary.crmOutboundActions||0);
      if(previewAmbiguous)previewAmbiguous.textContent=Number(summary.needsDecision||0);
      if(previewGenerated)previewGenerated.textContent=preview?'Preview '+when(preview.generatedAt)+' · expires '+when(preview.expiresAt)+' · '+Number(summary.qboCustomers||0)+' QuickBooks customers · '+Number(summary.activeSyncCustomers??(Number(summary.qboCustomers||0)-Number(summary.excludedCustomers||0)))+' active for sync · '+Number(summary.excludedCustomers||0)+' excluded · '+Number(summary.suggestedExclusions||0)+' suggested exclusion'+(Number(summary.suggestedExclusions||0)===1?'':'s')+' · '+Number(summary.qboEstimates||0)+' estimates · '+Number(summary.qboInvoices||0)+' invoices · '+Number(summary.qboPayments||0)+' payments scanned · '+Number(summary.duplicateFlags||0)+' duplicate/review flag'+(Number(summary.duplicateFlags||0)===1?'':'s')+'.':'';

      const needsDecision=Number(summary.needsDecision||0);
      const unapprovedNew=Number(summary.unapprovedNewImports||0);
      const ambiguousCount=Number(summary.ambiguousMatches||0);
      const bulkEligibleCount=Number(summary.bulkEligibleNewImports||0);
