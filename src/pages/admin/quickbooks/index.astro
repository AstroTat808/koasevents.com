          '<label class="flex items-center gap-2 rounded-full border border-slate-300 bg-white px-2.5 py-1.5 text-[.52rem] font-black uppercase tracking-[.06em] text-slate-700"><input data-exclude-select="'+esc(plan.customerId)+'" type="checkbox" '+(bulkSelectedExclude.has(String(plan.customerId))?'checked':'')+' class="h-3.5 w-3.5" /> Select to exclude</label>'+
