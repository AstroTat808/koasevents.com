    }

    function openSyncConfirmation(){
      const preview=state?.manualSyncPreview;
      if(!preview?.previewId)throw new Error('Run Preview Sync first.');
      const expires=Date.parse(preview.expiresAt||0);
      if(!expires||expires<=Date.now())throw new Error('This Preview Sync has expired. Run Preview Sync again.');
      const summary=preview.summary||{};
      const execution=executionSummaryFor(preview);
      if(Number(summary.needsDecision||0)>0||!execution.ready){
        throw new Error('Resolve every proposed new import and duplicate match before opening the final sync confirmation.');
      }

      const plans=Array.isArray(preview.customerPlans)?preview.customerPlans:[];
      const outbound=Array.isArray(preview.outbound)?preview.outbound:[];
      const serverDetails=preview?.executionDetails||{};
      const fallbackCustomer=(predicate)=>plans.filter(predicate).map((row)=>({
        customerId:row?.customerId||'',
        name:row?.qbo?.name||'',
        recordId:row?.matchedRecordId||row?.predictedRecordId||'',
        decision:row?.decision||'',
        disposition:row?.executionDisposition||'',
        reason:row?.reason||'',
        exclusion:row?.exclusion||null,
        changes:[],
      }));
      const details={
        create:Array.isArray(serverDetails.create)?serverDetails.create:fallbackCustomer((row)=>row.executionDisposition==='create'),
        matchRefresh:Array.isArray(serverDetails.matchRefresh)?serverDetails.matchRefresh:fallbackCustomer((row)=>row.executionDisposition==='match_refresh'),
        skip:Array.isArray(serverDetails.skip)?serverDetails.skip:fallbackCustomer((row)=>String(row.executionDisposition||'').startsWith('skip_')||row.executionDisposition==='excluded'),
        blockedDuplicates:Array.isArray(serverDetails.blockedDuplicates)?serverDetails.blockedDuplicates:fallbackCustomer((row)=>row.executionDisposition==='blocked_duplicate'),
        quickBooksWrites:Array.isArray(serverDetails.quickBooksWrites)?serverDetails.quickBooksWrites:outbound,
      };

      if(syncConfirmMeta)syncConfirmMeta.textContent='Preview '+String(preview.previewId)+' · generated '+when(preview.generatedAt)+' · expires '+when(preview.expiresAt)+'. Expand any total below to see every affected customer and exact field change. These counts are bound to this preview ID.';
      if(syncConfirmSummary){
        syncConfirmSummary.className='grid gap-3';
        syncConfirmSummary.innerHTML=
          preflightExpandableCard('Create in CRM',execution.crmCustomersCreated,details.create.length+' approved new customer'+(details.create.length===1?'':'s'),preflightCustomerRowsHtml(details.create),'success')+
          preflightExpandableCard('Match / refresh',execution.crmCustomersMatched,details.matchRefresh.length+' existing CRM customer'+(details.matchRefresh.length===1?'':'s'),preflightCustomerRowsHtml(details.matchRefresh),'default')+
          preflightExpandableCard('Skip / exclude',execution.crmCustomersSkipped,Number(execution.crmCustomersExcluded||0)+' excluded · '+Number(execution.crmCustomersSkippedCapacity||0)+' capacity skip'+(Number(execution.crmCustomersSkippedCapacity||0)===1?'':'s')+' · '+Number(execution.crmCustomersSkippedUnapproved||0)+' unapproved',preflightCustomerRowsHtml(details.skip),'warning')+
          preflightExpandableCard('Blocked duplicates',execution.crmCustomersBlockedDuplicates,'Ambiguous duplicate matches',preflightCustomerRowsHtml(details.blockedDuplicates),execution.crmCustomersBlockedDuplicates?'danger':'success')+
          preflightExpandableCard('Write to QuickBooks',execution.quickBooksRecordsWritten,Number(execution.quickBooksActionsWritten||0)+' customer/estimate write action'+(Number(execution.quickBooksActionsWritten||0)===1?'':'s'),preflightQboRowsHtml(details.quickBooksWrites),'success');
      }
      if(syncConfirmDetails)syncConfirmDetails.innerHTML='<section class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/30 p-4"><strong class="text-sm text-[var(--koa-forest)]">QuickBooks write summary</strong><div class="mt-3 grid gap-2 sm:grid-cols-2 text-xs leading-5 text-[var(--koa-ink)]/60"><p><strong class="text-[var(--koa-forest)]">'+Number(execution.quickBooksCustomerCreates||0)+'</strong> customer create(s)</p><p><strong class="text-[var(--koa-forest)]">'+Number(execution.quickBooksCustomerUpdates||0)+'</strong> customer update(s)</p><p><strong class="text-[var(--koa-forest)]">'+Number(execution.quickBooksEstimateCreates||0)+'</strong> estimate create(s)</p><p><strong class="text-[var(--koa-forest)]">'+Number(execution.quickBooksEstimateUpdates||0)+'</strong> estimate update(s)</p><p><strong class="'+(Number(execution.quickBooksBlockedActions||0)?'text-amber-800':'text-[var(--koa-forest)]')+'">'+Number(execution.quickBooksBlockedActions||0)+'</strong> blocked outbound action(s)</p><p><strong class="text-[var(--koa-forest)]">'+Number(execution.crmCustomersExcluded||0)+'</strong> persistent sync exclusion(s)</p></div></section>';
      if(syncConfirmWarning)syncConfirmWarning.textContent='Excluded QuickBooks customers remain untouched in QuickBooks and are omitted from CRM import/matching until restored. Invoices and payments remain QuickBooks-owned. Run Approved Sync may create or update QuickBooks customers and issued estimates shown in this preview; it will not manufacture an invoice or payment.';
      if(syncConfirmExecute){
        syncConfirmExecute.disabled=false;
        syncConfirmExecute.textContent='Run approved sync now';
      }
      syncConfirmDialog?.showModal();
    }

    async function executeApprovedSync(){
      const original=twoWaySync?.textContent||'Run Approved Sync';
      const confirmOriginal=syncConfirmExecute?.textContent||'Run approved sync now';
      if(syncConfirmExecute){syncConfirmExecute.disabled=true;syncConfirmExecute.textContent='Starting sync…';}
      syncConfirmDialog?.close();
      if(twoWaySync){twoWaySync.disabled=true;twoWaySync.textContent='Syncing…';}
      if(twoWaySyncStatus)twoWaySyncStatus.textContent='Synchronizing QuickBooks and CRM…';
      if(twoWaySyncDetail)twoWaySyncDetail.textContent='Reading customers, estimates, invoices and payments, matching records, then applying safe outbound CRM customer and estimate updates.';
      try{
        const previewId=String(state?.manualSyncPreview?.previewId||'');
        if(!previewId)throw new Error('Run Preview Sync first.');
        const data=await api({action:'sync-two-way',previewId});
        state.manualSync=data.result||null;
        state.manualSyncPreview=null;
        state.accountingAudit=data.accountingAudit||state.accountingAudit;
        const result=data.result||{};
        if(twoWaySyncStatus)twoWaySyncStatus.textContent='Two-way sync completed '+when(result.completedAt)+'.';
        if(twoWaySyncDetail)twoWaySyncDetail.textContent=Number(result.crm?.created||0)+' imported · '+Number(result.crm?.matched||0)+' matched · '+Number(result.crm?.updated||0)+' CRM records refreshed · '+Number(result.qbo?.estimates||0)+' estimates · '+Number(result.qbo?.invoices||0)+' invoices · '+Number(result.qbo?.payments||0)+' payments · '+Number(result.changes?.length||0)+' recorded changes · '+Number(result.conflicts?.length||0)+' conflicts · '+Number(result.warnings?.length||0)+' warnings · reconciliation '+(String(result?.reconciliation?.status||'not recorded')==='matched'?'matched preview':Number(result?.reconciliation?.deviationCount||0)+' deviation(s)')+'.';
        renderSyncPreview();
        renderSyncReconciliation();
        renderAccountingAudit();
      }catch(err){
        if(twoWaySyncStatus)twoWaySyncStatus.textContent='Two-way sync did not complete.';
        if(twoWaySyncDetail)twoWaySyncDetail.textContent=err.message||'QuickBooks synchronization failed.';
        throw err;
      }finally{
        if(twoWaySync)twoWaySync.textContent=original;
        if(syncConfirmExecute)syncConfirmExecute.textContent=confirmOriginal;
        renderSyncPreview();
      }
    }

    async function load(){
      const user=await getAdminSession();if(!hasAdminAccess(user)){unauthorized.classList.remove('hidden');return;}
      app.classList.remove('hidden');
      const res=await fetch('/api/admin/quickbooks',{cache:'no-store'});
      if(!res.ok)return;state=await res.json();render();
      const params=new URLSearchParams(location.search);
      if(params.get('connected')==='1')status.textContent='QuickBooks connection completed.';
      if(params.get('qbo')==='error')status.textContent='QuickBooks connection did not complete. Check the Intuit app redirect URI and credentials.';
    }

    connect?.addEventListener('click',async()=>{status.textContent='Starting QuickBooks authorization…';try{const data=await api({action:'connect'});window.location.href=data.url;}catch(err){status.textContent=err.message||'Unable to start QuickBooks authorization.';}});
    disconnect?.addEventListener('click',async()=>{status.textContent='Disconnecting…';try{await api({action:'disconnect'});await load();}catch(err){status.textContent=err.message||'Unable to disconnect.';}});
    previewTwoWay?.addEventListener('click',runPreviewSync);
    addSuggestionRule?.addEventListener('click',()=>{
      state.suggestedExclusionRules=Array.isArray(state?.suggestedExclusionRules)?state.suggestedExclusionRules:[];
      state.suggestedExclusionRules.push({
        id:'custom-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,7),
        enabled:true,
        field:'name',
        operator:'exact',
        value:'',
        reasonCode:'system_customer',
      });
      renderSuggestedExclusionRules();
      suggestionRuleList?.querySelector('[data-suggestion-rule-row]:last-child [data-rule-value]')?.focus();
    });
    saveSuggestionRules?.addEventListener('click',()=>saveSuggestedExclusionRulesFromUi().catch((err)=>{
      if(suggestionRuleMessage)suggestionRuleMessage.textContent=err.message||'Unable to save suggested-exclusion rules.';
    }));
    resetSuggestionRules?.addEventListener('click',()=>restoreDefaultSuggestedExclusionRules().catch((err)=>{
      if(suggestionRuleMessage)suggestionRuleMessage.textContent=err.message||'Unable to restore default suggested-exclusion rules.';
    }));
    resetSuggestionReviews?.addEventListener('click',()=>resetReviewedSuggestedExclusions().catch((err)=>{
      if(suggestionRuleMessage)suggestionRuleMessage.textContent=err.message||'Unable to reset reviewed suggestions.';
    }));
    reviewSuggestedExclusions?.addEventListener('click',openSuggestedExclusionReview);
    suggestedReviewClose?.addEventListener('click',()=>{currentSuggestedReviewCustomerId='';suggestedReviewDialog?.close();});
    suggestedReviewKeep?.addEventListener('click',()=>keepCurrentSuggestedExclusionInReview().catch((err)=>alert(err.message||'Unable to keep this customer in normal review.')));
    suggestedReviewExclude?.addEventListener('click',()=>excludeCurrentSuggestedExclusion().catch((err)=>alert(err.message||'Unable to exclude this suggested customer.')));
    previewFilter?.addEventListener('change',renderSyncPreview);
    exclusionReasonFilter?.addEventListener('change',()=>{
      const reason=String(exclusionReasonFilter?.value||'all');
      const view=String(previewFilter?.value||'all');
      if(reason!=='all'&&!['excluded','suggested'].includes(view)&&previewFilter)previewFilter.value='excluded';
      renderSyncPreview();
    });
    previewSearch?.addEventListener('input',renderSyncPreview);
    bulkExclusionReason?.addEventListener('change',renderSyncPreview);
    bulkExcludeSuggested?.addEventListener('click',()=>{
      visibleSuggestedExclusionPlans().forEach((plan)=>{
        const id=String(plan.customerId||'');
        if(id){bulkSelectedExclude.add(id);bulkSelectedNew.delete(id);}
      });
      if(bulkExclusionReason)bulkExclusionReason.value='suggested';
      renderSyncPreview();
    });
    bulkExcludeClear?.addEventListener('click',()=>{bulkSelectedExclude.clear();renderSyncPreview();});
    bulkExclude?.addEventListener('click',()=>excludeBulkSelected().catch((err)=>alert(err.message||'Unable to bulk exclude selected customers.')));
    exclusionCancel?.addEventListener('click',()=>{pendingExclusionCustomerId='';exclusionDialog?.close();});
    exclusionForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const customerId=String(pendingExclusionCustomerId||'');
      if(!customerId)return;
      const reasonCode=String(exclusionReason?.value||'other');
      const note=String(exclusionNote?.value||'').trim();
      const original=exclusionSubmit?.textContent||'Exclude from sync';
      if(exclusionSubmit){exclusionSubmit.disabled=true;exclusionSubmit.textContent='Excluding…';}
      try{
        bulkSelectedExclude.delete(customerId);
        bulkSelectedNew.delete(customerId);
        await saveMatch(customerId,'exclude','',note,reasonCode);
        pendingExclusionCustomerId='';
        exclusionDialog?.close();
        await runPreviewSync();
      }catch(err){
        alert(err.message||'Unable to exclude this QuickBooks customer.');
      }finally{
        if(exclusionSubmit){exclusionSubmit.disabled=false;exclusionSubmit.textContent=original;}
      }
    });
    bulkSelectVisible?.addEventListener('click',()=>{
      visibleBulkEligiblePlans().forEach((plan)=>bulkSelectedNew.add(String(plan.customerId)));
      renderSyncPreview();
    });
    bulkClear?.addEventListener('click',()=>{bulkSelectedNew.clear();renderSyncPreview();});
    bulkApprove?.addEventListener('click',()=>approveBulkSelected().catch((err)=>alert(err.message||'Unable to bulk approve selected customers.')));
    exportPreviewCsv?.addEventListener('click',()=>downloadPreviewAudit('csv').catch((err)=>alert(err.message||'Unable to export CSV audit.')));
    exportPreviewPdf?.addEventListener('click',()=>downloadPreviewAudit('pdf').catch((err)=>alert(err.message||'Unable to export PDF audit.')));
    matchEvidenceClose?.addEventListener('click',()=>matchEvidenceDialog?.close());
    syncConfirmCancel?.addEventListener('click',()=>syncConfirmDialog?.close());
    syncConfirmExecute?.addEventListener('click',()=>executeApprovedSync().catch((err)=>alert(err.message||'QuickBooks synchronization failed.')));
    twoWaySync?.addEventListener('click',()=>{try{openSyncConfirmation();}catch(err){alert(err.message||'Unable to open sync confirmation.');}});
    refreshItems?.addEventListener('click',loadItems);
    itemSelect?.addEventListener('change',()=>{
      const selected=items.find((item)=>item.id===itemSelect.value);
      if(itemAccount)itemAccount.textContent=selected?.incomeAccountName?'Income account: '+selected.incomeAccountName:'';
    });
    refreshDiagnostics?.addEventListener('click',load);
    refreshAudit?.addEventListener('click',load);
    testAccountingAlert?.addEventListener('click',async()=>{
      testAccountingAlert.disabled=true;testAccountingAlert.textContent='Sending test…';
      try{
        const result=await api({action:'test-accounting-alert'});
        const channels=result?.result?.channels||[];
        const summary=channels.map((row)=>row.channel+': '+(row.sent?'sent':row.reason||row.error||('status '+(row.status||'')))).join(' · ');
        alert('Accounting alert test complete. '+summary);
      }catch(err){alert(err.message||'Unable to send accounting alert test.');}
      finally{testAccountingAlert.disabled=false;testAccountingAlert.textContent='Test Accounting Alert';}
    });
    document.querySelectorAll('[data-add-template]').forEach((button)=>button.addEventListener('click',()=>addTemplateRow(button.dataset.addTemplate,{label:'Payment',dueDaysBefore:30,percentOfRemaining:0})));
    document.querySelectorAll('[data-payment-preset]').forEach((button)=>button.addEventListener('click',()=>applyPaymentPreset(button.dataset.paymentPreset)));
    document.querySelector('[data-save-custom-preset]')?.addEventListener('click',async()=>{
      const name=String(customPresetName()?.value||'').trim();
      const category=String(customPresetCategory()?.value||'venueWedding');
      if(!name){if(customPresetMessage())customPresetMessage().textContent='Enter a preset name first.';return;}
      const field=depositFieldForCategory(category);
      const preset={
        id:'custom-'+Date.now().toString(36),
        name,
        category,
        depositPercent:Number(depositForm?.elements?.[field]?.value||0),
        milestones:readTemplate(category),
        createdAt:new Date().toISOString(),
        updatedAt:new Date().toISOString(),
      };
      state.depositSettings.customPresets=[...(state.depositSettings.customPresets||[]),preset];
      try{await persistPaymentSettings('Saved custom preset “'+name+'”.');customPresetName().value='';}
      catch(err){state.depositSettings.customPresets=(state.depositSettings.customPresets||[]).filter((item)=>item.id!==preset.id);if(customPresetMessage())customPresetMessage().textContent=err.message||'Unable to save custom preset.';}
    });
    document.querySelector('[data-add-auto-rule]')?.addEventListener('click',()=>addAutoRuleRow());
    document.querySelector('[data-run-rule-simulator]')?.addEventListener('click',simulatePaymentRule);
    compareSelectA()?.addEventListener('change',renderComparison);
    compareSelectB()?.addEventListener('change',renderComparison);
    depositForm?.querySelectorAll('input[name$="Percent"]').forEach((input)=>input.addEventListener('input',()=>{renderTemplateValidation();if(input.name==='venueWeddingPercent')renderWeddingPreview();}));
    weddingPreviewTotal()?.addEventListener('input',()=>{renderWeddingPreview();renderComparison();});
    weddingPreviewDate()?.addEventListener('input',()=>{renderWeddingPreview();renderComparison();});
    document.querySelectorAll('[data-close-catalog]').forEach((button)=>button.addEventListener('click',()=>catalogDialog?.close()));
    newCatalog?.addEventListener('click',()=>openCatalogItem());
    importCatalog?.addEventListener('click',async()=>{
      if(catalogMessage)catalogMessage.textContent='Importing active Service and Non-Inventory items from QuickBooks…';
      try{const data=await api({action:'import-qbo-items'});state.catalog=data.catalog||[];renderCatalog();if(catalogMessage)catalogMessage.textContent='Imported '+Number(data.importedCount||0)+' QuickBooks items.';}catch(err){if(catalogMessage)catalogMessage.textContent=err.message||'Unable to import QuickBooks items.';}
    });
    catalogForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const data=new FormData(catalogForm);
      if(catalogFormMessage)catalogFormMessage.textContent='Saving to CRM and QuickBooks…';
      try{
        const result=await api({action:'save-catalog-item',item:{id:data.get('id'),quickBooksItemId:data.get('quickBooksItemId'),name:data.get('name'),category:data.get('category'),unitLabel:data.get('unitLabel'),unitPrice:Number(data.get('unitPrice')||0),quickBooksType:data.get('quickBooksType'),getExempt:data.get('getExempt')==='on',description:data.get('description'),active:true}});
        state.catalog=result.catalog||[];
        renderCatalog();
        if(catalogFormMessage)catalogFormMessage.textContent='Saved and synchronized with QuickBooks.';
        setTimeout(()=>catalogDialog?.close(),500);
      }catch(err){if(catalogFormMessage)catalogFormMessage.textContent=err.message||'Unable to save catalog item.';}
    });
    getForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const data=new FormData(getForm);
      if(getMessage)getMessage.textContent='Saving tenant tax setting…';
      try{
        const result=await api({
          action:'save-get-settings',
          enabled:true,
          label:data.get('label'),
          statutoryRate:Number(data.get('statutoryRate')||0),
          customerRate:Number(data.get('customerRate')||0),
          maxPassOnRate:Number(data.get('maxPassOnRate')||0),
        });
        state.getSettings=result.getSettings;
        if(getMessage)getMessage.textContent='Saved. New CRM proposals can use '+Number(result.getSettings.customerRate||0).toFixed(3).replace(/0+$/,'').replace(/\.$/,'')+'% '+String(result.getSettings.label||'Tax')+'.';
      }catch(err){if(getMessage)getMessage.textContent=err.message||'Unable to save tax setting.';}
    });
    depositForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const validation=renderTemplateValidation();
      if(validation.errors.length){
        if(depositMessage)depositMessage.textContent='Fix the payment schedule errors above before saving.';
        validationBox()?.scrollIntoView({behavior:'smooth',block:'center'});
        return;
      }
      const rules=readAutoRules();
      const ruleErrors=[];
      rules.forEach((rule,index)=>{
        if(rule.minLeadDays!=null&&rule.maxLeadDays!=null&&rule.minLeadDays>rule.maxLeadDays)ruleErrors.push('Rule #'+(index+1)+' has a minimum lead time greater than its maximum.');
        if(rule.minContractValue!=null&&rule.maxContractValue!=null&&rule.minContractValue>rule.maxContractValue)ruleErrors.push('Rule #'+(index+1)+' has a minimum contract value greater than its maximum.');
        if(!rule.presetId)ruleErrors.push('Rule #'+(index+1)+' does not have a preset selected.');
      });
      if(ruleErrors.length){
        if(depositMessage)depositMessage.textContent=ruleErrors.join(' ');
        return;
      }
      if(validation.warnings.length&&!window.confirm('These payment schedules have '+validation.warnings.length+' warning'+(validation.warnings.length===1?'':'s')+'. Save them anyway?'))return;
      const data=new FormData(depositForm);if(depositMessage)depositMessage.textContent='Saving deposit defaults…';
      try{
        state.depositSettings.autoRules=readAutoRules();
        const result=await api(paymentSettingsPayload());
        state.depositSettings=result.depositSettings;if(depositMessage)depositMessage.textContent='Saved. New proposals will use these defaults and automatic selection rules.';
        renderTemplateValidation();
      }catch(err){if(depositMessage)depositMessage.textContent=err.message||'Unable to save deposit defaults.';}
    });
    cleanupProductionTest?.addEventListener('click',async()=>{
      if(!productionTestStatus)return;
      productionTestStatus.textContent='Validating and cleaning the previous controlled production test…';
      cleanupProductionTest.disabled=true;
      try{
        const data=await api({action:'cleanup-production-smoke-test'});
        const cleanup=data.cleanup||{};
        productionTestStatus.textContent='Cleanup complete: invoice '+String(cleanup.invoice||'')+', estimate '+String(cleanup.estimate||'')+', customer '+String(cleanup.customer||'')+'.';
        await load();
      }catch(err){
        productionTestStatus.textContent=err.message||'Production test cleanup failed.';
      }finally{
        cleanupProductionTest.disabled=false;
      }
    });

    runProductionLinkedTest?.addEventListener('click',async()=>{
      if(!productionLinkedStatus)return;
      productionLinkedStatus.textContent='Creating controlled CRM-linked production booking…';
      runProductionLinkedTest.disabled=true;
      try{
        const data=await api({action:'production-linked-booking-test'});
        const t=data.test||{};
        productionLinkedStatus.textContent='Created CRM '+String(t.recordId||'')+'. Waiting for Invoice/Payment webhooks…';
        if(productionLinkedDetail)productionLinkedDetail.textContent='Estimate '+String(t.estimateDocNumber||t.estimateId||'')+' · Invoice '+String(t.invoiceDocNumber||t.invoiceId||'')+' · Payment '+String(t.paymentId||'')+' · payment $'+Number(t.paymentAmount||0).toFixed(2)+' · nothing emailed.';
        setTimeout(()=>load(),5000);
      }catch(err){
        productionLinkedStatus.textContent=err.message||'CRM-linked production test failed.';
      }finally{
        runProductionLinkedTest.disabled=false;
      }
    });

    runProductionTest?.addEventListener('click',async()=>{
      if(!productionTestStatus)return;
      productionTestStatus.textContent='Creating controlled $1 production customer, estimate and invoice…';
      runProductionTest.disabled=true;
      try{
        const data=await api({action:'production-smoke-test'});
        const t=data.test||{};
        productionTestStatus.textContent='Passed: '+(t.customerName||'test customer')+' · estimate '+(t.estimateDocNumber||t.estimateId||'')+' · invoice '+(t.invoiceDocNumber||t.invoiceId||'')+'.';
        if(productionTestDetail)productionTestDetail.textContent='Invoice balance $'+Number(t.invoiceBalance||0).toFixed(2)+' · nothing emailed · no payment recorded.';
        await load();
      }catch(err){
        productionTestStatus.textContent=err.message||'Production test failed.';
      }finally{
        runProductionTest.disabled=false;
      }
    });

    runLinkedTest?.addEventListener('click',async()=>{
      if(!linkedTestMessage)return;
      linkedTestMessage.textContent='Creating CRM-linked sandbox booking, deposit invoice and payment…';
      runLinkedTest.disabled=true;
      try{
        const data=await api({action:'sandbox-linked-booking-test'});
        const t=data.test||{};
        linkedTestMessage.textContent='Created '+(t.recordId||'CRM test record')+' · invoice '+(t.invoiceDocNumber||t.invoiceId||'')+' · payment '+(t.paymentId||'')+'. Waiting for Intuit webhook to update Deposit Paid and booking status.';
        setTimeout(()=>load(),4000);
      }catch(err){
        linkedTestMessage.textContent=err.message||'CRM-linked sandbox test failed.';
      }finally{
        runLinkedTest.disabled=false;
      }
    });

    runSandboxTest?.addEventListener('click',async()=>{
      if(!sandboxTestMessage)return;
      sandboxTestMessage.textContent='Running customer → estimate → invoice → payment test…';
      runSandboxTest.disabled=true;
      try{
        const data=await api({action:'sandbox-smoke-test'});
        const t=data.test||{};
        sandboxTestMessage.textContent='Passed: customer '+(t.customerId||'')+', estimate '+(t.estimateDocNumber||t.estimateId||'')+', invoice '+(t.invoiceDocNumber||t.invoiceId||'')+', payment '+(t.paymentId||'')+', ending invoice balance $'+Number(t.invoiceBalanceAfterPayment||0).toFixed(2)+'. Webhook confirmation may arrive shortly.';
        await load();
      }catch(err){
        sandboxTestMessage.textContent=err.message||'Sandbox test failed.';
      }finally{
        runSandboxTest.disabled=false;
      }
    });
    itemForm?.addEventListener('submit',async(e)=>{e.preventDefault();const id=String(itemSelect?.value||'');const item=items.find((entry)=>entry.id===id);if(!item){itemMessage.textContent='Choose a QuickBooks item.';return;}itemMessage.textContent='Saving…';try{const data=await api({action:'set-service-item',itemId:item.id,itemName:item.name});state.settings=data.settings;itemMessage.textContent='Mapped to '+item.name+'.';}catch(err){itemMessage.textContent=err.message||'Unable to save mapping.';}});

    load();
  </script>
</BaseLayout>
