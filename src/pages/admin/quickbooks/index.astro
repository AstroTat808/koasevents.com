    function renderWeddingPreview(){
      const container=weddingPreview();if(!container)return;
      ensureWeddingPreviewDate();
      const total=Math.max(1,Number(weddingPreviewTotal()?.value||10000));
      const heading=weddingPreviewHeading();if(heading)heading.textContent=money(total)+' sample wedding';
      const depositPercent=Math.min(100,Math.max(0,Number(depositForm?.elements?.venueWeddingPercent?.value||0)));
      const deposit=roundPreviewMoney(total*depositPercent/100);
      const remaining=roundPreviewMoney(total-deposit);
      const eventDate=weddingPreviewDate()?.value||'';
      const rows=readTemplate('venueWedding');
      let allocated=0;
      const schedule=[{label:'Reservation deposit',due:'At booking',amount:deposit,detail:depositPercent.toFixed(1).replace(/\.0$/,'')+'% of contract total'}];
      rows.forEach((item,index)=>{
        const last=index===rows.length-1;
        const amount=last
          ? Math.max(0,roundPreviewMoney(remaining-allocated))
          : Math.min(Math.max(0,roundPreviewMoney(remaining-allocated)),Math.max(0,roundPreviewMoney(remaining*Math.min(100,Math.max(0,item.percentOfRemaining))/100)));
        allocated=roundPreviewMoney(allocated+amount);
        schedule.push({
          label:item.label||('Payment '+(index+1)),
          due:formatPreviewDate(dueDateFromEvent(eventDate,item.dueDaysBefore)),
          amount,
          detail:last?'Automatic remainder':Number(item.percentOfRemaining||0).toFixed(1).replace(/\.0$/,'')+'% of post-deposit balance',
        });
      });
      container.innerHTML='';
      schedule.forEach((item,index)=>{
        const card=document.createElement('article');
        card.className='grid gap-2 rounded-xl border border-[var(--koa-line)] bg-white p-4 sm:grid-cols-[1.2fr_.9fr_.7fr] sm:items-center';
        const left=document.createElement('div');
        const title=document.createElement('strong');title.className='text-sm text-[var(--koa-forest)]';title.textContent=(index+1)+'. '+item.label;
        const detail=document.createElement('p');detail.className='mt-1 text-xs text-[var(--koa-ink)]/45';detail.textContent=item.detail;
        left.append(title,detail);
        const due=document.createElement('p');due.className='text-sm font-semibold text-[var(--koa-ink)]/65';due.textContent=item.due;
        const amount=document.createElement('strong');amount.className='text-right text-lg text-[var(--koa-forest)]';amount.textContent=money(item.amount);
        card.append(left,due,amount);container.appendChild(card);
      });
      const totalScheduled=roundPreviewMoney(schedule.reduce((sum,item)=>sum+item.amount,0));
      const note=weddingPreviewNote();
      if(note)note.textContent='Preview total '+money(totalScheduled)+' · deposit '+money(deposit)+' · post-deposit balance '+money(remaining)+(eventDate?' · sample event '+formatPreviewDate(eventDate):'');
    }

