    function presetSchedulePreview(preset,total,eventDate){
      const depositPercent=Math.min(100,Math.max(0,Number(preset?.depositPercent||0)));
      const deposit=roundPreviewMoney(total*depositPercent/100);
      const remaining=roundPreviewMoney(total-deposit);
      const rows=Array.isArray(preset?.milestones)&&preset.milestones.length?preset.milestones:[{label:'Final balance',dueDaysBefore:0,percentOfRemaining:100}];
      let allocated=0;
      const schedule=[{label:'Reservation deposit',amount:deposit,due:'At booking'}];
      rows.forEach((item,index)=>{
        const last=index===rows.length-1;
        const amount=last?Math.max(0,roundPreviewMoney(remaining-allocated)):Math.min(Math.max(0,roundPreviewMoney(remaining-allocated)),Math.max(0,roundPreviewMoney(remaining*Math.min(100,Math.max(0,Number(item.percentOfRemaining||0)))/100)));
        allocated=roundPreviewMoney(allocated+amount);
        schedule.push({label:item.label||'Payment',amount,due:formatPreviewDate(dueDateFromEvent(eventDate,item.dueDaysBefore))});
      });
      return {depositPercent,deposit,remaining,schedule};
    }
