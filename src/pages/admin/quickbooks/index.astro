      if(previewReviewWarning)previewReviewWarning.classList.toggle('hidden',!preview||needsDecision===0);
      if(previewReviewWarningTitle)previewReviewWarningTitle.textContent=needsDecision===1?'1 customer decision must be reviewed before sync.':needsDecision+' customer decisions must be reviewed before sync.';
      if(previewReviewWarningDetail)previewReviewWarningDetail.textContent=[
        unapprovedNew?unapprovedNew+' proposed new CRM import'+(unapprovedNew===1?' requires':'s require')+' approval.':'',
        bulkEligibleCount?bulkEligibleCount+' low-risk import'+(bulkEligibleCount===1?' is':'s are')+' eligible for guarded bulk review.':'',
        individualCount?individualCount+' row'+(individualCount===1?' requires':'s require')+' individual review because of duplicate evidence or missing reliable contact data.':'',
        ambiguousCount?ambiguousCount+' possible duplicate match'+(ambiguousCount===1?' is':'es are')+' blocked until resolved.':'',
        Number(summary.suggestedExclusions||0)?Number(summary.suggestedExclusions||0)+' obvious system/test customer'+(Number(summary.suggestedExclusions||0)===1?' has':'s have')+' a suggested exclusion that still requires staff approval.':'',
        'Nothing unresolved can be imported or excluded automatically by Run Approved Sync.'
      ].filter(Boolean).join(' ');

      const plans=Array.isArray(preview?.customerPlans)?preview.customerPlans:[];
      const allBulkEligible=plans.filter((plan)=>String(plan?.decision||'')==='new'&&Boolean(plan?.bulkEligible));
      const allBulkEligibleIds=new Set(allBulkEligible.map((plan)=>String(plan.customerId)));
      [...bulkSelectedNew].forEach((id)=>{if(!allBulkEligibleIds.has(String(id)))bulkSelectedNew.delete(String(id));});
      const unresolvedIds=new Set(plans.filter(unresolvedExclusionEligible).map((plan)=>String(plan.customerId)));
      [...bulkSelectedExclude].forEach((id)=>{if(!unresolvedIds.has(String(id)))bulkSelectedExclude.delete(String(id));});

      const visiblePlans=plans.filter(previewPlanMatchesFilter);
      const imports=visiblePlans.filter((row)=>['new','approved_new','excluded'].includes(row.decision));
      const matches=visiblePlans.filter((row)=>['linked','auto_match','approved_match'].includes(row.decision));
      const reviewPlans=visiblePlans.filter((row)=>row.decision==='ambiguous'||(row.decision==='new'&&!row.bulkEligible));
      const visibleBulk=imports.filter((row)=>row.decision==='new'&&row.bulkEligible);

      if(previewFilterCount){
