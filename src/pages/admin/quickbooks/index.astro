    function preflightExpandableCard(label,value,detail,body,tone='default'){
      const toneClass=tone==='danger'?'border-red-200 bg-red-50 text-red-800':tone==='warning'?'border-amber-200 bg-amber-50 text-amber-900':tone==='success'?'border-emerald-200 bg-emerald-50 text-emerald-900':'border-[var(--koa-line)] bg-[var(--koa-sand)]/45 text-[var(--koa-forest)]';
