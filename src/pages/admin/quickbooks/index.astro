---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s QuickBooks Setup" description="Connect Koa’s Events CRM to QuickBooks Online." canonical="https://www.koasevents.com/admin/quickbooks/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-5xl">
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Accounting</p>
          <h1 class="display mt-3 text-5xl">QuickBooks Online</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">QuickBooks is Koa’s financial system of record for estimates, invoices and payments. The CRM stores only QuickBooks IDs, document numbers, balances and sync timestamps.</p>
        </div>
        <a href="/admin/" class="link-arrow">Admin home →</a>
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">Sign in with an administrator account at <a class="underline" href="/admin/">Koa’s Admin</a>.</div>

      <div data-app class="hidden grid gap-6">
        <section class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Connection</p>
              <h2 data-company class="display mt-3 text-4xl">Not connected</h2>
              <p data-status class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/58"></p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button data-connect type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Connect QuickBooks</button>
              <button data-disconnect type="button" class="hidden rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Disconnect</button>
            </div>
          </div>
          <div data-config-warning class="mt-6 hidden rounded-xl border border-[var(--koa-amber)]/35 bg-[var(--koa-amber-light)]/20 p-5">
            <p class="font-semibold text-[var(--koa-ink)]">Intuit app credentials are not configured on Netlify yet.</p>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/60">Add the two Intuit app credentials below, then return here and connect Koa’s QuickBooks company. The client secret is never entered into the browser.</p>
            <div class="mt-4 grid gap-2 font-mono text-xs text-[var(--koa-forest)]">
              <code>QUICKBOOKS_CLIENT_ID</code>
              <code>QUICKBOOKS_CLIENT_SECRET</code>
            </div>
            <p class="mt-4 text-xs leading-5 text-[var(--koa-ink)]/50">Registered Intuit redirect URI: <code data-redirect-uri></code></p>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Diagnostics</p>
              <h2 class="display mt-3 text-4xl">QuickBooks integration health</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Connection, webhook delivery, CRM synchronization and the most recent sandbox verification.</p>
            </div>
            <button data-refresh-diagnostics type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Refresh diagnostics</button>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Connection</p><strong data-diag-connection class="mt-2 block text-base text-[var(--koa-forest)]">Checking…</strong><p data-diag-company class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last webhook received</p><strong data-diag-webhook class="mt-2 block text-base text-[var(--koa-forest)]">None yet</strong><p data-diag-webhook-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last CRM sync</p><strong data-diag-sync class="mt-2 block text-base text-[var(--koa-forest)]">None yet</strong><p data-diag-sync-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last sandbox test</p><strong data-diag-test class="mt-2 block text-base text-[var(--koa-forest)]">Not run</strong><p data-diag-test-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
          </div>
          <div data-diag-webhook-check class="mt-4 rounded-xl border border-[var(--koa-line)] bg-white p-4 text-sm text-[var(--koa-ink)]/60"></div>
        </section>

        <section id="accounting-audit" data-accounting-audit class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Accounting reconciliation</p>
              <h2 class="display mt-3 text-4xl">CRM ↔ QuickBooks audit</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Flags clients only when the CRM proposal, QuickBooks estimate, milestone invoices, payments received, or remaining balances do not mathematically reconcile.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span data-audit-status class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Checking…</span>
              <button data-test-accounting-alert type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Test Accounting Alert</button>
              <button data-refresh-audit type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Reload audit</button>
            </div>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Clients checked</p><strong data-audit-clients class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Flagged</p><strong data-audit-flagged class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Payments received</p><strong data-audit-paid class="display mt-2 block text-3xl text-[var(--koa-forest)]">$0</strong></article>
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Remaining balance</p><strong data-audit-remaining class="display mt-2 block text-3xl text-[var(--koa-forest)]">$0</strong></article>
          </div>
          <div data-audit-list class="mt-5 grid gap-3"></div>
          <p data-audit-generated class="mt-3 text-xs text-[var(--koa-ink)]/45"></p>
        </section>

        <section data-item-section class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div><p class="eyebrow text-[var(--koa-clay)]">Accounting mapping</p><h2 class="display mt-3 text-4xl">Default Koa’s service item</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--koa-ink)]/58">Choose the QuickBooks Service or Non-Inventory item used on synchronized Koa’s estimate and invoice lines. Revenue account treatment stays controlled by that QuickBooks item.</p></div>
            <button data-refresh-items type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Refresh items</button>
          </div>
          <form data-item-form class="mt-6 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
            <label class="grid gap-2 text-sm font-semibold">QuickBooks item
              <select name="item" class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3"><option value="">Loading QuickBooks items…</option></select>
            </label>
            <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save mapping</button>
          </form>
          <p data-item-message class="mt-3 text-sm text-[var(--koa-ink)]/52"></p>
          <p data-item-account class="mt-1 text-xs text-[var(--koa-ink)]/45"></p>
          <div data-sandbox-test class="mt-6 hidden border-t border-[var(--koa-line)] pt-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="font-semibold text-[var(--koa-ink)]">Sandbox end-to-end test</p>
                <p class="mt-1 text-sm text-[var(--koa-ink)]/58">Creates a $25 test customer, estimate, invoice and payment in the connected QuickBooks sandbox.</p>
              </div>
              <button data-run-sandbox-test type="button" class="rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Run sandbox test</button>
            </div>
            <p data-sandbox-test-message class="mt-3 text-sm text-[var(--koa-ink)]/58"></p>

            <div class="mt-6 border-t border-[var(--koa-line)] pt-6">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="font-semibold text-[var(--koa-ink)]">CRM-linked booking test</p>
                  <p class="mt-1 text-sm text-[var(--koa-ink)]/58">Creates a clearly labeled test proposal in the CRM, issues its deposit invoice in QuickBooks, records a $25 payment, and waits for the webhook to move the CRM record to Booked with Deposit Paid.</p>
                </div>
                <button data-run-linked-test type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Run linked test</button>
              </div>
              <p data-linked-test-message class="mt-3 text-sm text-[var(--koa-ink)]/58"></p>
            </div>
          </div>
        </section>


        <section data-catalog-section class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">CRM catalog</p>
              <h2 class="display mt-3 text-4xl">Rentals, services, mileage + fees</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Manage client-facing catalog items here. Saving an item also creates or updates its matching QuickBooks Service or Non-Inventory item.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button data-import-catalog type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Import QBO items</button>
              <button data-new-catalog type="button" class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Add item</button>
            </div>
          </div>
          <div data-catalog-list class="mt-6 grid gap-3"></div>
          <p data-catalog-message class="mt-3 text-sm text-[var(--koa-ink)]/52"></p>
        </section>

        <section data-get-section class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <p class="eyebrow text-[var(--koa-clay)]">Hawaiʻi tax setting</p>
          <h2 class="display mt-3 text-4xl">General Excise Tax (GET)</h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Hawaiʻi County GET is 4.5%. If Koa’s passes GET on to the client, the maximum permitted pass-on rate is 4.712%. This setting controls the CRM proposal calculation; it is not labeled as sales tax.</p>
          <form data-get-form class="mt-6 grid gap-4 lg:grid-cols-[1fr_1fr_auto] lg:items-end">
            <label class="grid gap-2 text-sm font-semibold">Client GET rate %
              <input name="customerRate" type="number" value="4.712" readonly class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 text-[var(--koa-forest)]" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">Label
              <input name="label" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" value="Hawaiʻi GET" />
            </label>
            <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save GET setting</button>
          </form>
          <p class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/48">Statutory Hawaiʻi County rate: 4.5% · Maximum pass-through setting allowed here: 4.712%</p>
          <p data-get-message class="mt-2 text-sm text-[var(--koa-ink)]/52"></p>
        </section>

        <section data-deposit-section class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <p class="eyebrow text-[var(--koa-clay)]">Proposal defaults</p>
          <h2 class="display mt-3 text-4xl">Deposits + payment schedules</h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Set the default deposit and milestone timing used when a new proposal is created. Existing signed, invoiced, or paid bookings are not rewritten.</p>
          <form data-deposit-form class="mt-6 grid gap-5">
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <label class="grid gap-2 text-sm font-semibold">Venue wedding deposit %<input name="venueWeddingPercent" type="number" min="0" max="100" step="0.1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Mobile Bar deposit %<input name="mobileBarPercent" type="number" min="0" max="100" step="0.1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Private event deposit %<input name="privateEventPercent" type="number" min="0" max="100" step="0.1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">General fallback deposit %<input name="defaultPercent" type="number" min="0" max="100" step="0.1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            </div>
            <section class="rounded-xl border border-[var(--koa-line)] bg-white p-4">
              <div class="flex flex-col gap-2 lg:flex-row lg:items-end lg:justify-between">
                <div>
                  <p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Payment schedule presets</p>
                  <p class="mt-1 text-xs text-[var(--koa-ink)]/50">Apply a preset to the unsaved editor, then customize deposit %, milestone order, dates, or percentages before saving.</p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <button type="button" data-payment-preset="standardWedding" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Standard Wedding</button>
                  <button type="button" data-payment-preset="extendedWedding" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Extended Wedding</button>
                  <button type="button" data-payment-preset="microWedding" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Micro Wedding</button>
                  <button type="button" data-payment-preset="mobileBar" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Mobile Bar</button>
                  <button type="button" data-payment-preset="privateEvent" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Private Event</button>
                </div>
              </div>
              <p data-preset-message class="mt-3 text-xs text-[var(--koa-ink)]/48"></p>
            </section>

            <section class="rounded-xl border border-[var(--koa-line)] bg-white p-4">
              <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
                <div>
                  <p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Custom payment presets</p>
                  <p class="mt-1 text-xs text-[var(--koa-ink)]/50">Save any current category template with a reusable name such as “Koa Premium Wedding” or “Corporate Event.”</p>
                </div>
                <div class="grid gap-2 sm:grid-cols-[1fr_auto_auto]">
                  <input data-custom-preset-name placeholder="Preset name" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm" />
                  <select data-custom-preset-category class="rounded-xl border border-[var(--koa-line)] px-4 py-3 text-sm">
                    <option value="venueWedding">Venue Wedding</option>
                    <option value="mobileBar">Mobile Bar</option>
                    <option value="privateEvent">Private Event</option>
                    <option value="default">General fallback</option>
                  </select>
                  <button data-save-custom-preset type="button" class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-[.58rem] font-black uppercase tracking-[.09em] text-white">Save current as preset</button>
                </div>
              </div>
              <div data-custom-preset-list class="mt-4 grid gap-2 sm:grid-cols-2 xl:grid-cols-3"></div>
              <p data-custom-preset-message class="mt-3 text-xs text-[var(--koa-ink)]/48"></p>
            </section>

            <section class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/30 p-4">
              <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
                <div>
                  <p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Preset comparison</p>
                  <p class="mt-1 text-xs text-[var(--koa-ink)]/50">Compare two presets using the same contract total and event date before applying either one.</p>
                </div>
                <div class="grid gap-2 sm:grid-cols-2">
                  <select data-compare-a class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-sm"></select>
                  <select data-compare-b class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3 text-sm"></select>
                </div>
              </div>
              <div class="mt-4 grid gap-4 xl:grid-cols-2">
                <div data-compare-panel="a" class="rounded-xl border border-[var(--koa-line)] bg-white p-4"></div>
                <div data-compare-panel="b" class="rounded-xl border border-[var(--koa-line)] bg-white p-4"></div>
              </div>
            </section>

            <section class="rounded-xl border border-[var(--koa-line)] bg-white p-4">
              <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
                <div>
                  <p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Automatic preset selection</p>
                  <p class="mt-1 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/50">Rules run in priority order when a new proposal is created. Lead time is measured from proposal creation/booking date to event date. Existing proposals are never rewritten.</p>
                </div>
                <button data-add-auto-rule type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.58rem] font-black uppercase tracking-[.09em] text-[var(--koa-forest)]">Add rule +</button>
              </div>
              <div data-auto-rule-list class="mt-4 grid gap-3"></div>
            </section>

            <div class="grid gap-4 border-t border-[var(--koa-line)] pt-5 xl:grid-cols-2">
              <section class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4" data-template-card="venueWedding">
                <div class="flex items-end justify-between gap-3"><div><p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Venue Wedding</p><p class="mt-1 text-xs text-[var(--koa-ink)]/50">Post-deposit milestones</p></div><button type="button" data-add-template="venueWedding" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Add milestone +</button></div>
                <div data-template-list="venueWedding" class="mt-4 grid gap-3"></div>
              </section>
              <section class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4" data-template-card="mobileBar">
                <div class="flex items-end justify-between gap-3"><div><p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Mobile Bar</p><p class="mt-1 text-xs text-[var(--koa-ink)]/50">Post-deposit milestones</p></div><button type="button" data-add-template="mobileBar" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Add milestone +</button></div>
                <div data-template-list="mobileBar" class="mt-4 grid gap-3"></div>
              </section>
              <section class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4" data-template-card="privateEvent">
                <div class="flex items-end justify-between gap-3"><div><p class="text-xs font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Private Event</p><p class="mt-1 text-xs text-[var(--koa-ink)]/50">Post-deposit milestones</p></div><button type="button" data-add-template="privateEvent" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Add milestone +</button></div>
                <div data-template-list="privateEvent" class="mt-4 grid gap-3"></div>
              </section>
              <section class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4" data-template-card="default">
