      if(bulkReview)bulkReview.classList.toggle('hidden',allBulkEligible.length===0);
      if(bulkReviewDetail)bulkReviewDetail.textContent=allBulkEligible.length
        ? allBulkEligible.length+' low-risk new customer'+(allBulkEligible.length===1?' has':'s have')+' no CRM duplicate evidence and a reliable email or phone. '+visibleBulk.length+' are visible in the current filter; '+bulkSelectedNew.size+' selected.'
        : 'No customers currently qualify for bulk approval.';
      if(bulkApprove){
        bulkApprove.disabled=bulkSelectedNew.size===0;
        bulkApprove.textContent='Approve selected ('+bulkSelectedNew.size+')';
      }
      if(bulkSelectVisible)bulkSelectVisible.disabled=visibleBulk.length===0;

      const unresolvedPlans=plans.filter(unresolvedExclusionEligible);
      const visibleSuggested=visibleSuggestedExclusionPlans();
      if(exclusionTools)exclusionTools.classList.toggle('hidden',!preview||(!unresolvedPlans.length&&!Number(summary.excludedCustomers||0)));
      const selectedExclusionPlans=unresolvedPlans.filter((plan)=>bulkSelectedExclude.has(String(plan.customerId)));
      const usingSuggestedReasons=String(bulkExclusionReason?.value||'suggested')==='suggested';
      const suggestedReasonMismatch=usingSuggestedReasons&&selectedExclusionPlans.some((plan)=>!plan?.suggestedExclusion?.code);
      if(bulkExclusionDetail)bulkExclusionDetail.textContent=
        Number(summary.suggestedExclusions||0)+' suggested exclusion'+(Number(summary.suggestedExclusions||0)===1?'':'s')+' · '+
        bulkSelectedExclude.size+' selected for exclusion · '+
        Number(summary.excludedCustomers||0)+' already excluded. Preview suggestions never apply automatically.'+
        (suggestedReasonMismatch?' Choose a specific reason because at least one selected customer has no suggestion.':'');
      if(bulkExcludeSuggested)bulkExcludeSuggested.disabled=visibleSuggested.length===0;
      if(bulkExclude){
        bulkExclude.disabled=bulkSelectedExclude.size===0||suggestedReasonMismatch;
        bulkExclude.textContent='Exclude selected ('+bulkSelectedExclude.size+')';
      }
      if(exclusionReport){
        const report=Array.isArray(preview?.exclusionReport)?preview.exclusionReport:[];
        exclusionReport.innerHTML=report.length
          ? report.map((row)=>'<button type="button" data-exclusion-report-code="'+esc(row.code)+'" class="rounded-full border border-slate-300 bg-white px-2.5 py-1.5 text-[.52rem] font-black uppercase tracking-[.05em] text-slate-700">'+esc(row.label)+' · '+Number(row.count||0)+'</button>').join('')
          : '<span class="text-[.6rem] text-slate-500">No persistent exclusions yet.</span>';
        exclusionReport.querySelectorAll('[data-exclusion-report-code]').forEach((button)=>button.addEventListener('click',()=>{
          if(previewFilter)previewFilter.value='excluded';
          if(exclusionReasonFilter)exclusionReasonFilter.value=String(button.dataset.exclusionReportCode||'all');
          renderSyncPreview();
        }));
      }

      const outbound=Array.isArray(preview?.outbound)?preview.outbound:[];
      if(previewOutboundList)previewOutboundList.innerHTML=outbound.length?outbound.map((row)=>'<article class="min-w-0 rounded-lg bg-[var(--koa-sand)]/45 p-3"><strong class="block min-w-0 break-words text-sm text-[var(--koa-forest)]">'+esc(row.name||row.recordId)+'</strong><p class="mt-1 min-w-0 break-all text-[.62rem] font-bold text-[var(--koa-clay)]">CRM '+esc(row.recordId)+'</p><div class="mt-2 grid min-w-0 gap-2">'+(row.actions||[]).map(outboundActionHtml).join('')+'</div></article>').join(''):'<p class="text-xs text-[var(--koa-ink)]/45">No CRM-origin QuickBooks changes are planned.</p>';

      if(matchReview)matchReview.classList.toggle('hidden',reviewPlans.length===0);
      if(matchReviewCount)matchReviewCount.textContent=reviewPlans.length+' individual review'+(reviewPlans.length===1?'':'s');
      if(matchReviewList){
        matchReviewList.innerHTML=reviewPlans.map((plan)=>{
          const q=plan.qbo||{};
          const candidates=Array.isArray(plan.candidates)?plan.candidates:[];
          const noCandidate=String(plan.decision||'')==='new';
          const risk=plan?.duplicateRisk||{};
          const riskSignals=Array.isArray(risk.signals)?risk.signals.map(duplicateSignalLabel).filter(Boolean):[];
          const riskLine=(String(risk.level||'review')==='high'?'High duplicate risk':String(risk.level||'')==='medium'?'Medium duplicate risk':'Individual review')+(Number(risk.score||0)?' · score '+Number(risk.score||0):'')+(riskSignals.length?' · '+riskSignals.join(', '):'');
          const candidateHtml=candidates.map((candidate)=>{
            const signals=Array.isArray(candidate.signals)?candidate.signals.map(duplicateSignalLabel).filter(Boolean):[];
            const riskClass=String(candidate.riskLevel||'')==='high'?'bg-red-100 text-red-800':String(candidate.riskLevel||'')==='medium'?'bg-amber-100 text-amber-900':'bg-slate-100 text-slate-700';
            const linkedElsewhere=candidate.currentQuickBooksCustomerId&&String(candidate.currentQuickBooksCustomerId)!==String(plan.customerId);
            const actions='<div class="flex shrink-0 flex-wrap gap-2">'+matchEvidenceButtonHtml(plan,candidate,'Why matched?')+(linkedElsewhere?'<span class="rounded-full bg-slate-100 px-3 py-2 text-[.55rem] font-black uppercase tracking-[.07em] text-slate-600">Linked elsewhere</span>':'<button type="button" data-match-qbo="'+esc(plan.customerId)+'" data-match-record="'+esc(candidate.recordId)+'" class="rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-white">Use this CRM client</button>')+'</div>';
            return '<div class="min-w-0 rounded-xl border border-[var(--koa-line)] p-3"><div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><strong class="block min-w-0 break-words text-sm">'+esc(candidate.name||candidate.recordId)+'</strong><span class="rounded-full px-2 py-1 text-[.5rem] font-black uppercase tracking-[.06em] '+riskClass+'">'+esc(String(candidate.riskLevel||'review'))+' · '+Number(candidate.score||0)+'</span></div><p class="mt-1 min-w-0 break-all text-xs text-[var(--koa-ink)]/52">'+esc(candidate.email||'No email')+'</p><p class="mt-1 min-w-0 break-words text-xs text-[var(--koa-ink)]/52">'+esc(candidate.phone||'No phone')+'</p><p class="mt-1 min-w-0 break-words text-[.62rem] text-[var(--koa-ink)]/45">'+esc(candidate.eventDate||'No event date')+' · '+esc(candidate.stage||'')+'</p><p class="mt-2 min-w-0 break-words text-[.62rem] font-semibold leading-5 text-[var(--koa-clay)]">'+esc(candidate.reason||'Possible match')+'</p>'+(signals.length?'<p class="mt-1 min-w-0 break-words text-[.6rem] leading-5 text-[var(--koa-ink)]/45">Evidence: '+esc(signals.join(' · '))+'</p>':'')+'</div>'+actions+'</div></div>';
          }).join('');
          return '<article class="min-w-0 rounded-xl border border-amber-200 bg-white p-4"><div class="grid min-w-0 gap-4 lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)]"><div class="min-w-0 rounded-xl bg-amber-50 p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-amber-900">QuickBooks customer</p><strong class="mt-2 block min-w-0 break-words text-base">'+esc(q.name||plan.customerId)+'</strong><p class="mt-1 min-w-0 break-all text-xs text-[var(--koa-ink)]/55">'+esc(q.email||'No email')+'</p><p class="mt-1 min-w-0 break-words text-xs text-[var(--koa-ink)]/55">'+esc(q.phone||'No phone')+(q.eventDate?' · event '+esc(q.eventDate):'')+'</p><p class="mt-2 min-w-0 break-all text-[.62rem] font-bold text-[var(--koa-clay)]">QBO #'+esc(plan.customerId)+'</p><p class="mt-2 rounded-lg bg-white/70 px-2 py-1.5 text-[.62rem] font-semibold leading-5 text-amber-950">'+esc(riskLine)+'</p>'+exclusionSuggestionHtml(plan)+'<p class="mt-2 min-w-0 break-words text-xs leading-5 text-[var(--koa-ink)]/50">'+Number(plan.financial?.estimates||0)+' estimates · '+Number(plan.financial?.invoices||0)+' invoices · '+Number(plan.financial?.payments||0)+' payments · '+money(plan.financial?.invoiceTotal||0)+' invoiced · '+money(plan.financial?.openBalance||0)+' open</p><div class="mt-4 flex flex-wrap gap-2"><label class="flex items-center gap-2 rounded-full border border-slate-300 bg-white px-3 py-2 text-[.54rem] font-black uppercase tracking-[.06em] text-slate-700"><input data-exclude-select="'+esc(plan.customerId)+'" type="checkbox" '+(bulkSelectedExclude.has(String(plan.customerId))?'checked':'')+' class="h-3.5 w-3.5" /> Select to exclude</label><button type="button" data-match-new="'+esc(plan.customerId)+'" class="rounded-full bg-amber-900 px-3 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-white">Approve as new CRM client</button><button type="button" data-match-exclude="'+esc(plan.customerId)+'" class="rounded-full border border-slate-300 bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-slate-700">Exclude from sync</button></div></div><div class="min-w-0"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">'+(noCandidate?'Why this needs individual review':'Possible CRM matches')+'</p>'+(noCandidate?'<div class="mt-2 rounded-xl border border-[var(--koa-line)] p-3"><strong class="text-sm">Bulk approval is intentionally unavailable.</strong><p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/52">No reliable email or phone is available for this QuickBooks customer. Review the name, transaction history, invoices, payments and projected CRM record individually before approving a new import.</p></div>':'<div class="mt-2 grid min-w-0 gap-2">'+candidateHtml+'</div>')+'</div></div></article>';
        }).join('');

        matchReviewList.querySelectorAll('[data-match-qbo]').forEach((button)=>button.addEventListener('click',async()=>{
          button.disabled=true;button.textContent='Saving…';
          try{await saveMatch(button.dataset.matchQbo,'match',button.dataset.matchRecord);await runPreviewSync();}
          catch(err){alert(err.message||'Unable to save customer match.');button.disabled=false;button.textContent='Use this CRM client';}
        }));
        wirePreviewDecisionButtons(matchReviewList);
        wireMatchEvidenceButtons(matchReviewList);
      }

      if(twoWaySync)twoWaySync.disabled=!valid||needsDecision>0;
      if(twoWaySyncStatus&&preview){
        twoWaySyncStatus.textContent=needsDecision>0
          ? needsDecision+' customer decision'+(needsDecision===1?' needs':'s need')+' review before sync can run.'
          : valid?'Preview approved for execution. All customer decisions are resolved; review the audit, then run the sync.':'Preview expired. Run Preview Sync again.';
      }
    }

    async function runPreviewSync(){
      if(!previewTwoWay)return;
      const original=previewTwoWay.textContent;
      previewTwoWay.disabled=true;previewTwoWay.textContent='Previewing…';
      if(twoWaySync)twoWaySync.disabled=true;
      if(twoWaySyncStatus)twoWaySyncStatus.textContent='Building a read-only sync preview…';
      if(twoWaySyncDetail)twoWaySyncDetail.textContent='Scanning QuickBooks customers, estimates, invoices and payments and comparing them with CRM records. No customer, estimate, invoice or payment is being changed.';
      try{
        const data=await api({action:'preview-two-way'});
        state.manualSyncPreview=data.preview||null;
        if(data?.preview?.suggestedExclusionDismissalCount!=null){
          state.suggestedExclusionDismissalCount=Number(data.preview.suggestedExclusionDismissalCount||0);
          renderSuggestedExclusionRules();
        }
        renderSyncPreview();
        if(twoWaySyncDetail)twoWaySyncDetail.textContent='Review every planned import, match, invoice, payment, balance and outbound update below. Run Approved Sync stays disabled until every proposed new CRM import is explicitly approved and every ambiguous match is resolved.';
      }catch(err){
        if(twoWaySyncStatus)twoWaySyncStatus.textContent='Preview could not be generated.';
        if(twoWaySyncDetail)twoWaySyncDetail.textContent=err.message||'QuickBooks preview failed.';
      }finally{previewTwoWay.disabled=false;previewTwoWay.textContent=original;}
    }
    function renderAccountingAudit(){
      const audit=state?.accountingAudit||{};
      const rows=Array.isArray(audit.rows)?audit.rows:[];
      const flagged=rows.filter((row)=>!row.reconciled);
      if(auditClients)auditClients.textContent=String(Number(audit.clientCount||0));
      if(auditFlagged)auditFlagged.textContent=String(Number(audit.flaggedCount||0));
      if(auditPaid)auditPaid.textContent=money(audit.totalPaymentsReceived||0);
      if(auditRemaining)auditRemaining.textContent=money(audit.totalRemainingBalance||0);
      if(auditStatus){
        auditStatus.textContent=flagged.length?flagged.length+' need review':'Reconciled';
        auditStatus.className='rounded-full px-4 py-2 text-[.6rem] font-black uppercase tracking-[.1em] '+(flagged.length?'bg-red-50 text-red-700 border border-red-200':'bg-[var(--koa-sand)] text-[var(--koa-forest)]');
      }
      if(auditGenerated)auditGenerated.textContent=audit.generatedAt?'Audit generated '+when(audit.generatedAt)+'. Values reflect the latest CRM-stored QuickBooks synchronization.':'';
      if(!auditList)return;
      auditList.innerHTML='';
      if(!rows.length){
        auditList.innerHTML='<div class="rounded-xl border border-dashed border-[var(--koa-line)] p-5 text-sm text-[var(--koa-ink)]/55">No accepted/booked or QuickBooks-linked proposals are available to audit yet.</div>';
        return;
      }
      const visible=flagged.length?flagged:rows.slice(0,8);
      visible.forEach((row)=>{
        const card=document.createElement('article');
        card.className='rounded-xl border '+(row.reconciled?'border-[var(--koa-line)] bg-[var(--koa-ivory)]':'border-red-200 bg-red-50/55')+' p-4';
        const top=document.createElement('div');top.className='flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between';
        const left=document.createElement('div');
        const title=document.createElement('strong');title.className='text-sm text-[var(--koa-forest)]';title.textContent=row.clientName||row.recordId;
        const meta=document.createElement('p');meta.className='mt-1 text-xs text-[var(--koa-ink)]/50';meta.textContent=[row.recordId,row.eventDate,row.estimateDocNumber?'Estimate #'+row.estimateDocNumber:'No QBO estimate'].filter(Boolean).join(' · ');
        left.append(title,meta);
        const actions=document.createElement('div');actions.className='flex flex-wrap items-center gap-2';
        const link=document.createElement('a');link.href='/admin/quotes/?q='+encodeURIComponent(row.recordId);link.className='text-[.58rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]';link.textContent='Open client →';
        actions.appendChild(link);
        if(!row.reconciled){
          const recheck=document.createElement('button');recheck.type='button';recheck.className='rounded-full border border-red-200 bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-red-700';recheck.textContent='Sync & Recheck';
          recheck.addEventListener('click',async()=>{
            recheck.disabled=true;recheck.textContent='Syncing…';
            try{const result=await api({action:'sync-and-recheck',recordId:row.recordId});state.accountingAudit=result.accountingAudit||state.accountingAudit;renderAccountingAudit();}
            catch(err){recheck.disabled=false;recheck.textContent='Retry Sync & Recheck';alert(err.message||'Unable to sync and recheck this client.');}
          });
          actions.appendChild(recheck);
        }
        top.append(left,actions);card.appendChild(top);
        const totals=document.createElement('p');totals.className='mt-3 text-xs leading-5 text-[var(--koa-ink)]/58';
        totals.textContent='CRM '+money(row.proposalTotal)+' · QBO estimate '+auditValue(row.estimateTotal)+' · issued '+money(row.issuedTotal)+' · payments '+money(row.paymentsReceived)+' · remaining '+money(row.remainingBalance);
        card.appendChild(totals);
        if(row.reconciled){
          const ok=document.createElement('p');ok.className='mt-3 text-xs font-semibold text-[var(--koa-forest)]';ok.textContent='All stored accounting values reconcile.';
