      const entities=webhookEntities(state?.webhookReceipt);
      if(diagWebhook)diagWebhook.textContent=when(state?.webhookReceipt?.receivedAt);
      if(diagWebhookMeta)diagWebhookMeta.textContent=entities.length
        ? entities.map((entity)=>String(entity.name||'')+' '+String(entity.operation||'')).join(' · ')
        : 'No verified QuickBooks webhook receipt stored yet.';

      if(diagSync)diagSync.textContent=when(state?.webhookProcessed?.processedAt);
      if(diagSyncMeta)diagSyncMeta.textContent=state?.webhookProcessed?.processedAt
        ? String(state.webhookProcessed.status||'processed')+' · '+Number(state.webhookProcessed.affectedRecords?.length||0)+' CRM record(s) affected'
        : 'No webhook-driven CRM synchronization recorded yet.';

      const test=state?.smokeTest;
      if(diagTest)diagTest.textContent=test?.completedAt?when(test.completedAt):'Not run';
      if(diagTestMeta)diagTestMeta.textContent=test?.completedAt
        ? 'Status: '+String(test.status||'unknown')+' · Invoice '+String(test.invoiceDocNumber||test.invoiceId||'')+' · Payment '+String(test.paymentId||'')
        : 'Run the sandbox end-to-end test after mapping a service item.';

      const invoiceMatched=Boolean(test?.webhook?.invoiceMatched||state?.smokeWebhookMatch?.invoiceMatched);
      const paymentMatched=Boolean(test?.webhook?.paymentMatched||state?.smokeWebhookMatch?.paymentMatched);
      const verified=Boolean(test?.webhook?.verified||(invoiceMatched&&paymentMatched));
      if(diagWebhookCheck)diagWebhookCheck.textContent=!test?.completedAt
