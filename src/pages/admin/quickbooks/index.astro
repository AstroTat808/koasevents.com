      const comparisons=Array.isArray(reconciliation.countComparisons)?reconciliation.countComparisons:[];
      if(syncReconciliationCounts)syncReconciliationCounts.innerHTML=comparisons.length
        ? comparisons.map((row)=>'<article class="rounded-xl border '+(row?.matched?'border-emerald-200 bg-emerald-50':'border-amber-200 bg-amber-50')+' p-3"><p class="text-[.52rem] font-black uppercase tracking-[.06em] '+(row?.matched?'text-emerald-800':'text-amber-900')+'">'+esc(row?.label||row?.key||'Comparison')+'</p><div class="mt-2 flex items-end justify-between gap-3"><div><p class="text-[.5rem] font-black uppercase tracking-[.05em] text-[var(--koa-ink)]/40">Predicted</p><strong class="text-lg text-[var(--koa-forest)]">'+esc(reconciliationValue(row?.predicted))+'</strong></div><div class="text-right"><p class="text-[.5rem] font-black uppercase tracking-[.05em] text-[var(--koa-ink)]/40">Actual</p><strong class="text-lg '+(row?.matched?'text-emerald-800':'text-amber-900')+'">'+esc(reconciliationValue(row?.actual))+'</strong></div></div></article>').join('')
        : '<p class="text-xs text-[var(--koa-ink)]/45">No count comparisons were recorded for this sync.</p>';

      if(syncReconciliationDeviations){
