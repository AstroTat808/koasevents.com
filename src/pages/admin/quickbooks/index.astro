    function rangesOverlap(minA,maxA,minB,maxB){
      const loA=minA==null?Number.NEGATIVE_INFINITY:Number(minA);
      const hiA=maxA==null?Number.POSITIVE_INFINITY:Number(maxA);
      const loB=minB==null?Number.NEGATIVE_INFINITY:Number(minB);
      const hiB=maxB==null?Number.POSITIVE_INFINITY:Number(maxB);
      return Math.max(loA,loB)<=Math.min(hiA,hiB);
    }
    function detectRuleConflicts(rules=readAutoRules()){
      const active=rules.filter((rule)=>rule.active);
      const conflicts=[];
      for(let i=0;i<active.length;i+=1){
        for(let j=i+1;j<active.length;j+=1){
          const a=active[i],b=active[j];
          if(a.category!==b.category)continue;
          if(!rangesOverlap(a.minLeadDays,a.maxLeadDays,b.minLeadDays,b.maxLeadDays))continue;
          if(a.contractValueBasis===b.contractValueBasis){
            if(!rangesOverlap(a.minContractValue,a.maxContractValue,b.minContractValue,b.maxContractValue))continue;
          }else{
            const aHasValue=a.minContractValue!=null||a.maxContractValue!=null;
            const bHasValue=b.minContractValue!=null||b.maxContractValue!=null;
            if(aHasValue&&bHasValue){
              conflicts.push({a,b,indeterminateBasis:true});
              continue;
            }
          }
          conflicts.push({a,b,indeterminateBasis:false});
        }
      }
      return conflicts;
    }
    function renderRuleConflicts(){
      const list=ruleConflictList();const count=ruleConflictCount();if(!list||!count)return;
      const rules=readAutoRules();const conflicts=detectRuleConflicts(rules);
      count.textContent=conflicts.length+' conflict'+(conflicts.length===1?'':'s');
      list.innerHTML='';
      if(!conflicts.length){
        const ok=document.createElement('div');ok.className='rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-900';ok.textContent='No active-rule overlaps detected.';list.appendChild(ok);return;
      }
      conflicts.forEach(({a,b,indeterminateBasis})=>{
        const winner=rules.indexOf(a)<=rules.indexOf(b)?a:b;
        const loser=winner===a?b:a;
        const card=document.createElement('div');card.className='rounded-lg border border-amber-200 bg-amber-50 px-3 py-3 text-xs text-amber-950';
        const title=document.createElement('strong');title.textContent='“'+a.name+'” overlaps “'+b.name+'”.';
        const detail=document.createElement('div');detail.className='mt-1 leading-5';
        detail.textContent='Winner: “'+winner.name+'” because it appears above “'+loser.name+'” in priority order.'+(indeterminateBasis?' These rules use different tax bases, so overlap depends on the actual tax amount; the simulator will show the winner for a specific proposal.':'');
        card.append(title,detail);list.appendChild(card);
      });
    }
    function ruleLeadDays(bookingDate,eventDate){
      const start=Date.parse(String(bookingDate||'')+'T12:00:00');
      const end=Date.parse(String(eventDate||'')+'T12:00:00');
      if(!Number.isFinite(start)||!Number.isFinite(end))return null;
      return Math.max(0,Math.ceil((end-start)/86400000));
    }
    function simulatePaymentRule(){
      const category=String(ruleSimCategory()?.value||'venueWedding');
      const bookingDate=String(ruleSimBooking()?.value||'');
      const eventDate=String(ruleSimEvent()?.value||'');
      const afterGetValue=Math.max(0,Number(ruleSimValue()?.value||0));
      const getRate=Number(state?.getSettings?.customerRate||state?.tenant?.tax?.customerRate||0)/100;
      const beforeGetValue=getRate>0?afterGetValue/(1+getRate):afterGetValue;
      const leadDays=ruleLeadDays(bookingDate,eventDate);
      const rules=readAutoRules();
      const matched=rules.find((rule)=>{
        if(!rule.active||rule.category!==category)return false;
        if(leadDays==null){
          if(rule.minLeadDays!=null||rule.maxLeadDays!=null)return false;
        }else{
          if(rule.minLeadDays!=null&&leadDays<rule.minLeadDays)return false;
          if(rule.maxLeadDays!=null&&leadDays>rule.maxLeadDays)return false;
        }
        const contractValue=rule.contractValueBasis==='beforeGet'?beforeGetValue:afterGetValue;
        if(rule.minContractValue!=null&&contractValue<rule.minContractValue)return false;
        if(rule.maxContractValue!=null&&contractValue>rule.maxContractValue)return false;
        return true;
      });
      const result=ruleSimResult();if(!result)return;
      result.innerHTML='';
      if(!bookingDate||!eventDate){
        const message=document.createElement('strong');message.textContent='Enter both booking and event dates.';result.appendChild(message);return;
      }
      if(!matched){
        const message=document.createElement('strong');message.textContent='No rule matched.';
        const detail=document.createElement('div');detail.className='mt-1 text-xs text-[var(--koa-ink)]/50';detail.textContent='The category default payment template would be used.';
        result.append(message,detail);return;
      }
      const preset=presetById(matched.presetId);
      const months=leadDays==null?'—':(leadDays/30.4375).toFixed(1).replace(/\.0$/,'');
      const eyebrow=document.createElement('div');eyebrow.className='text-[.58rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]';eyebrow.textContent='Selected rule #'+((rules.indexOf(matched))+1);
      const heading=document.createElement('strong');heading.className='mt-1 block text-lg text-[var(--koa-forest)]';heading.textContent=matched.name;
      const presetLine=document.createElement('div');presetLine.className='mt-1 text-sm';presetLine.textContent='Preset: '+(preset?.label||preset?.name||matched.presetId);
      const winnerValue=matched.contractValueBasis==='beforeGet'?beforeGetValue:afterGetValue;
      const allMatches=rules.filter((rule)=>{
        if(!rule.active||rule.category!==category)return false;
        if(leadDays==null){if(rule.minLeadDays!=null||rule.maxLeadDays!=null)return false;}
        else{if(rule.minLeadDays!=null&&leadDays<rule.minLeadDays)return false;if(rule.maxLeadDays!=null&&leadDays>rule.maxLeadDays)return false;}
        const value=rule.contractValueBasis==='beforeGet'?beforeGetValue:afterGetValue;
        if(rule.minContractValue!=null&&value<rule.minContractValue)return false;
        if(rule.maxContractValue!=null&&value>rule.maxContractValue)return false;
        return true;
      });
      const detail=document.createElement('div');detail.className='mt-2 text-xs text-[var(--koa-ink)]/55';detail.textContent=months+' months ('+(leadDays??'—')+' days) lead time · '+money(winnerValue)+' '+(matched.contractValueBasis==='beforeGet'?'before tax':'after tax')+' contract value'+(allMatches.length>1?' · '+allMatches.length+' rules matched; this one wins by priority':'');
      result.append(eyebrow,heading,presetLine,detail);
    }

