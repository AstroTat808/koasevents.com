---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s QuickBooks Setup" description="Connect Koa’s Events CRM to QuickBooks Online." canonical="https://www.koasevents.com/admin/quickbooks/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-12">
    <div class="container-shell max-w-5xl">
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Accounting</p>
          <h1 class="display mt-3 text-5xl">QuickBooks Online</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">QuickBooks is Koa’s financial system of record for estimates, invoices and payments. The CRM stores only QuickBooks IDs, document numbers, balances and sync timestamps.</p>
        </div>
        <a href="/admin/" class="link-arrow">Admin home →</a>
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">Sign in with an administrator account at <a class="underline" href="/admin/">Koa’s Admin</a>.</div>

      <div data-app class="hidden grid gap-6">
        <section class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Connection</p>
              <h2 data-company class="display mt-3 text-4xl">Not connected</h2>
              <p data-status class="mt-3 text-sm leading-6 text-[var(--koa-ink)]/58"></p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button data-connect type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Connect QuickBooks</button>
              <button data-disconnect type="button" class="hidden rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Disconnect</button>
            </div>
          </div>
          <div data-config-warning class="mt-6 hidden rounded-xl border border-[var(--koa-amber)]/35 bg-[var(--koa-amber-light)]/20 p-5">
            <p class="font-semibold text-[var(--koa-ink)]">Intuit app credentials are not configured on Netlify yet.</p>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/60">Add the two Intuit app credentials below, then return here and connect Koa’s QuickBooks company. The client secret is never entered into the browser.</p>
            <div class="mt-4 grid gap-2 font-mono text-xs text-[var(--koa-forest)]">
              <code>QUICKBOOKS_CLIENT_ID</code>
              <code>QUICKBOOKS_CLIENT_SECRET</code>
            </div>
            <p class="mt-4 text-xs leading-5 text-[var(--koa-ink)]/50">Registered Intuit redirect URI: <code data-redirect-uri></code></p>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Diagnostics</p>
              <h2 class="display mt-3 text-4xl">QuickBooks integration health</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Connection, webhook delivery, CRM synchronization and the most recent sandbox verification.</p>
            </div>
            <button data-refresh-diagnostics type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Refresh diagnostics</button>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Connection</p><strong data-diag-connection class="mt-2 block text-base text-[var(--koa-forest)]">Checking…</strong><p data-diag-company class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last webhook received</p><strong data-diag-webhook class="mt-2 block text-base text-[var(--koa-forest)]">None yet</strong><p data-diag-webhook-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last CRM sync</p><strong data-diag-sync class="mt-2 block text-base text-[var(--koa-forest)]">None yet</strong><p data-diag-sync-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Last sandbox test</p><strong data-diag-test class="mt-2 block text-base text-[var(--koa-forest)]">Not run</strong><p data-diag-test-meta class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/48"></p></article>
          </div>
          <div data-diag-webhook-check class="mt-4 rounded-xl border border-[var(--koa-line)] bg-white p-4 text-sm text-[var(--koa-ink)]/60"></div>
        </section>

        <section id="accounting-audit" data-accounting-audit class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Accounting reconciliation</p>
              <h2 class="display mt-3 text-4xl">CRM ↔ QuickBooks audit</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Flags clients only when the CRM proposal, QuickBooks estimate, milestone invoices, payments received, or remaining balances do not mathematically reconcile.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span data-audit-status class="rounded-full border border-[var(--koa-line)] px-4 py-2 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Checking…</span>
              <button data-refresh-audit type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Reload audit</button>
            </div>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Clients checked</p><strong data-audit-clients class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Flagged</p><strong data-audit-flagged class="display mt-2 block text-3xl text-[var(--koa-forest)]">0</strong></article>
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Payments received</p><strong data-audit-paid class="display mt-2 block text-3xl text-[var(--koa-forest)]">$0</strong></article>
            <article class="rounded-xl bg-[var(--koa-sand)]/45 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Remaining balance</p><strong data-audit-remaining class="display mt-2 block text-3xl text-[var(--koa-forest)]">$0</strong></article>
          </div>
          <div data-audit-list class="mt-5 grid gap-3"></div>
          <p data-audit-generated class="mt-3 text-xs text-[var(--koa-ink)]/45"></p>
        </section>

        <section data-item-section class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div><p class="eyebrow text-[var(--koa-clay)]">Accounting mapping</p><h2 class="display mt-3 text-4xl">Default Koa’s service item</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--koa-ink)]/58">Choose the QuickBooks Service or Non-Inventory item used on synchronized Koa’s estimate and invoice lines. Revenue account treatment stays controlled by that QuickBooks item.</p></div>
            <button data-refresh-items type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Refresh items</button>
          </div>
          <form data-item-form class="mt-6 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
            <label class="grid gap-2 text-sm font-semibold">QuickBooks item
              <select name="item" class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3"><option value="">Loading QuickBooks items…</option></select>
            </label>
            <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save mapping</button>
          </form>
          <p data-item-message class="mt-3 text-sm text-[var(--koa-ink)]/52"></p>
          <p data-item-account class="mt-1 text-xs text-[var(--koa-ink)]/45"></p>
          <div data-sandbox-test class="mt-6 hidden border-t border-[var(--koa-line)] pt-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="font-semibold text-[var(--koa-ink)]">Sandbox end-to-end test</p>
                <p class="mt-1 text-sm text-[var(--koa-ink)]/58">Creates a $25 test customer, estimate, invoice and payment in the connected QuickBooks sandbox.</p>
              </div>
              <button data-run-sandbox-test type="button" class="rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Run sandbox test</button>
            </div>
            <p data-sandbox-test-message class="mt-3 text-sm text-[var(--koa-ink)]/58"></p>

            <div class="mt-6 border-t border-[var(--koa-line)] pt-6">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="font-semibold text-[var(--koa-ink)]">CRM-linked booking test</p>
                  <p class="mt-1 text-sm text-[var(--koa-ink)]/58">Creates a clearly labeled test proposal in the CRM, issues its deposit invoice in QuickBooks, records a $25 payment, and waits for the webhook to move the CRM record to Booked with Deposit Paid.</p>
                </div>
                <button data-run-linked-test type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Run linked test</button>
              </div>
              <p data-linked-test-message class="mt-3 text-sm text-[var(--koa-ink)]/58"></p>
            </div>
          </div>
        </section>


        <section data-catalog-section class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">CRM catalog</p>
              <h2 class="display mt-3 text-4xl">Rentals, services, mileage + fees</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Manage client-facing catalog items here. Saving an item also creates or updates its matching QuickBooks Service or Non-Inventory item.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button data-import-catalog type="button" class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Import QBO items</button>
              <button data-new-catalog type="button" class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Add item</button>
            </div>
          </div>
          <div data-catalog-list class="mt-6 grid gap-3"></div>
          <p data-catalog-message class="mt-3 text-sm text-[var(--koa-ink)]/52"></p>
        </section>

        <section data-get-section class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <p class="eyebrow text-[var(--koa-clay)]">Hawaiʻi tax setting</p>
          <h2 class="display mt-3 text-4xl">General Excise Tax (GET)</h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Hawaiʻi County GET is 4.5%. If Koa’s passes GET on to the client, the maximum permitted pass-on rate is 4.712%. This setting controls the CRM proposal calculation; it is not labeled as sales tax.</p>
          <form data-get-form class="mt-6 grid gap-4 lg:grid-cols-[1fr_1fr_auto] lg:items-end">
            <label class="grid gap-2 text-sm font-semibold">Client GET rate %
              <input name="customerRate" type="number" value="4.712" readonly class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 text-[var(--koa-forest)]" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">Label
              <input name="label" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" value="Hawaiʻi GET" />
            </label>
            <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save GET setting</button>
          </form>
          <p class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/48">Statutory Hawaiʻi County rate: 4.5% · Maximum pass-through setting allowed here: 4.712%</p>
          <p data-get-message class="mt-2 text-sm text-[var(--koa-ink)]/52"></p>
        </section>

        <section data-deposit-section class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <p class="eyebrow text-[var(--koa-clay)]">Proposal defaults</p>
          <h2 class="display mt-3 text-4xl">Deposits + payment schedules</h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Set the default deposit and milestone timing used when a new proposal is created. Existing signed, invoiced, or paid bookings are not rewritten.</p>
          <form data-deposit-form class="mt-6 grid gap-5">
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <label class="grid gap-2 text-sm font-semibold">Venue wedding deposit %<input name="venueWeddingPercent" type="number" min="0" max="100" step="0.1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Mobile Bar deposit %<input name="mobileBarPercent" type="number" min="0" max="100" step="0.1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Private event deposit %<input name="privateEventPercent" type="number" min="0" max="100" step="0.1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">General fallback deposit %<input name="defaultPercent" type="number" min="0" max="100" step="0.1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            </div>
            <div class="grid gap-4 border-t border-[var(--koa-line)] pt-5 sm:grid-cols-2 xl:grid-cols-5">
              <label class="grid gap-2 text-sm font-semibold">Wedding 2nd payment · days before event<input name="venueWeddingSecondDueDaysBefore" type="number" min="0" max="730" step="1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Wedding final · days before event<input name="venueWeddingFinalDueDaysBefore" type="number" min="0" max="730" step="1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Mobile Bar final · days before event<input name="mobileBarFinalDueDaysBefore" type="number" min="0" max="730" step="1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Private event final · days before event<input name="privateEventFinalDueDaysBefore" type="number" min="0" max="730" step="1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Fallback final · days before event<input name="defaultFinalDueDaysBefore" type="number" min="0" max="730" step="1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save deposit + schedule defaults</button>
              <p data-deposit-message class="text-sm text-[var(--koa-ink)]/52"></p>
            </div>
          </form>
        </section>

        <dialog data-catalog-dialog class="w-[min(94vw,760px)] rounded-[1.5rem] border-0 bg-white p-0 shadow-2xl backdrop:bg-black/40">
          <form data-catalog-form class="p-7 sm:p-8">
            <input type="hidden" name="id" />
            <input type="hidden" name="quickBooksItemId" />
            <div class="flex items-start justify-between gap-4">
              <div><p class="eyebrow text-[var(--koa-clay)]">Catalog item</p><h3 data-catalog-title class="display mt-3 text-4xl">Add item</h3></div>
              <button type="button" data-close-catalog class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-sm">×</button>
            </div>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Name<input name="name" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Category<select name="category" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><option value="service">Service</option><option value="rental">Rental</option><option value="mileage">Mileage</option><option value="fee">Fee</option></select></label>
              <label class="grid gap-2 text-sm font-semibold">Unit label<input name="unitLabel" value="each" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Unit price<input name="unitPrice" type="number" min="0" step="0.01" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">QuickBooks type<select name="quickBooksType" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"><option value="Service">Service</option><option value="NonInventory">Non-Inventory</option></select></label>
              <label class="flex items-center gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3 text-sm font-semibold"><input name="getExempt" type="checkbox" /> Exempt from Hawaiʻi GET</label>
              <label class="grid gap-2 text-sm font-semibold sm:col-span-2">Description<textarea name="description" rows="4" class="rounded-xl border border-[var(--koa-line)] px-4 py-3"></textarea></label>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
              <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Save item</button>
              <button type="button" data-close-catalog class="rounded-full border border-[var(--koa-line)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">Cancel</button>
            </div>
            <p data-catalog-form-message class="mt-4 text-sm text-[var(--koa-ink)]/58"></p>
          </form>
        </dialog>

        <section data-production-test class="hidden rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <p class="eyebrow text-[var(--koa-clay)]">Controlled production test</p>
          <h2 class="display mt-3 text-4xl">Verify the real QuickBooks company safely</h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Creates one clearly labeled $1 test customer, estimate and invoice. Nothing is emailed and no payment is recorded.</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p data-production-test-status class="text-sm font-semibold text-[var(--koa-ink)]">Ready after a production service item is mapped.</p>
              <p data-production-test-detail class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/50"></p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button data-cleanup-production-test type="button" class="rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Clean previous test</button>
              <button data-run-production-test type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Run $1 production test</button>
            </div>
          </div>

          <div class="mt-6 border-t border-[var(--koa-line)] pt-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="font-semibold text-[var(--koa-ink)]">CRM-linked production booking test</p>
                <p class="mt-1 text-sm text-[var(--koa-ink)]/58">Creates a clearly labeled CRM proposal, QuickBooks estimate, $1 deposit invoice and matching QuickBooks payment. Nothing is emailed. The webhook must move the CRM record to Booked and Deposit Paid.</p>
              </div>
              <button data-run-production-linked-test type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Run linked production test</button>
            </div>
            <p data-production-linked-status class="mt-3 text-sm font-semibold text-[var(--koa-ink)]"></p>
            <p data-production-linked-detail class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/50"></p>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-7 shadow-[var(--shadow-soft)]">
          <p class="eyebrow text-[var(--koa-clay)]">Production readiness</p>
          <h2 class="display mt-3 text-4xl">Switch Koa’s real company safely</h2>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Production credentials</p><strong data-prod-creds class="mt-2 block text-base text-[var(--koa-forest)]">Checking…</strong></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Production webhook</p><strong data-prod-webhook class="mt-2 block text-base text-[var(--koa-forest)]">Checking…</strong></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Production redirect</p><strong data-prod-redirect class="mt-2 block text-base text-[var(--koa-forest)]">Checking…</strong></article>
            <article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/35 p-4"><p class="text-[.58rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">Current environment</p><strong data-prod-environment class="mt-2 block text-base text-[var(--koa-forest)]">Checking…</strong></article>
          </div>
          <p class="mt-4 text-xs leading-5 text-[var(--koa-ink)]/50">Production credentials are stored separately so sandbox credentials can remain available for future testing.</p>
        </section>

        <section class="rounded-[1.5rem] bg-[var(--koa-ink)] p-7 text-white shadow-[var(--shadow-soft)]">
          <p class="eyebrow text-[var(--koa-amber-light)]">Workflow</p>
          <h2 class="display mt-3 text-4xl">What the integration does</h2>
          <div class="mt-6 grid gap-3 md:grid-cols-2">
            <article class="rounded-xl border border-white/10 bg-white/[.06] p-4"><strong>Proposal → QuickBooks Estimate</strong><p class="mt-2 text-sm leading-6 text-white/60">Create or update the estimate from the CRM, then email it using QuickBooks.</p></article>
            <article class="rounded-xl border border-white/10 bg-white/[.06] p-4"><strong>Accepted proposal → invoices</strong><p class="mt-2 text-sm leading-6 text-white/60">Create the deposit, second, or final invoice individually when Koa’s is ready to issue that milestone.</p></article>
            <article class="rounded-xl border border-white/10 bg-white/[.06] p-4"><strong>Payments remain in QuickBooks</strong><p class="mt-2 text-sm leading-6 text-white/60">Clients pay through the QuickBooks workflow Koa’s already uses. The website never processes or records a card payment.</p></article>
            <article class="rounded-xl border border-white/10 bg-white/[.06] p-4"><strong>CRM syncs balances</strong><p class="mt-2 text-sm leading-6 text-white/60">The CRM pulls invoice balance and email status from QuickBooks; the deposit reaching zero balance can complete the booking handoff.</p></article>
          </div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';
    const approvedAdminEmails=new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    const app=document.querySelector('[data-app]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const connect=document.querySelector('[data-connect]');
    const disconnect=document.querySelector('[data-disconnect]');
    const company=document.querySelector('[data-company]');
    const status=document.querySelector('[data-status]');
    const warning=document.querySelector('[data-config-warning]');
    const itemSection=document.querySelector('[data-item-section]');
    const catalogSection=document.querySelector('[data-catalog-section]');
    const catalogList=document.querySelector('[data-catalog-list]');
    const catalogMessage=document.querySelector('[data-catalog-message]');
    const importCatalog=document.querySelector('[data-import-catalog]');
    const newCatalog=document.querySelector('[data-new-catalog]');
    const catalogDialog=document.querySelector('[data-catalog-dialog]');
    const catalogForm=document.querySelector('[data-catalog-form]');
    const catalogTitle=document.querySelector('[data-catalog-title]');
    const catalogFormMessage=document.querySelector('[data-catalog-form-message]');
    const getSection=document.querySelector('[data-get-section]');
    const getForm=document.querySelector('[data-get-form]');
    const getMessage=document.querySelector('[data-get-message]');
    const depositSection=document.querySelector('[data-deposit-section]');
    const depositForm=document.querySelector('[data-deposit-form]');
    const depositMessage=document.querySelector('[data-deposit-message]');
    const itemForm=document.querySelector('[data-item-form]');
    const itemSelect=document.querySelector('[data-item-form] select[name="item"]');
    const itemMessage=document.querySelector('[data-item-message]');
    const itemAccount=document.querySelector('[data-item-account]');
    const refreshItems=document.querySelector('[data-refresh-items]');
    const sandboxTest=document.querySelector('[data-sandbox-test]');
    const runSandboxTest=document.querySelector('[data-run-sandbox-test]');
    const sandboxTestMessage=document.querySelector('[data-sandbox-test-message]');
    const runLinkedTest=document.querySelector('[data-run-linked-test]');
    const linkedTestMessage=document.querySelector('[data-linked-test-message]');
    const prodCreds=document.querySelector('[data-prod-creds]');
    const prodWebhook=document.querySelector('[data-prod-webhook]');
    const prodRedirect=document.querySelector('[data-prod-redirect]');
    const prodEnvironment=document.querySelector('[data-prod-environment]');
    const productionTest=document.querySelector('[data-production-test]');
    const runProductionTest=document.querySelector('[data-run-production-test]');
    const cleanupProductionTest=document.querySelector('[data-cleanup-production-test]');
    const productionTestStatus=document.querySelector('[data-production-test-status]');
    const productionTestDetail=document.querySelector('[data-production-test-detail]');
    const runProductionLinkedTest=document.querySelector('[data-run-production-linked-test]');
    const productionLinkedStatus=document.querySelector('[data-production-linked-status]');
    const productionLinkedDetail=document.querySelector('[data-production-linked-detail]');
    const refreshDiagnostics=document.querySelector('[data-refresh-diagnostics]');
    const diagConnection=document.querySelector('[data-diag-connection]');
    const diagCompany=document.querySelector('[data-diag-company]');
    const diagWebhook=document.querySelector('[data-diag-webhook]');
    const diagWebhookMeta=document.querySelector('[data-diag-webhook-meta]');
    const diagSync=document.querySelector('[data-diag-sync]');
    const diagSyncMeta=document.querySelector('[data-diag-sync-meta]');
    const diagTest=document.querySelector('[data-diag-test]');
    const diagTestMeta=document.querySelector('[data-diag-test-meta]');
    const diagWebhookCheck=document.querySelector('[data-diag-webhook-check]');
    const auditStatus=document.querySelector('[data-audit-status]');
    const auditClients=document.querySelector('[data-audit-clients]');
    const auditFlagged=document.querySelector('[data-audit-flagged]');
    const auditPaid=document.querySelector('[data-audit-paid]');
    const auditRemaining=document.querySelector('[data-audit-remaining]');
    const auditList=document.querySelector('[data-audit-list]');
    const auditGenerated=document.querySelector('[data-audit-generated]');
    const refreshAudit=document.querySelector('[data-refresh-audit]');
    let state=null;
    let items=[];

    function hasAdminAccess(user){const email=String(user?.email||'').trim().toLowerCase();const roles=user?.app_metadata?.roles||[];return approvedAdminEmails.has(email)||(Array.isArray(roles)&&roles.includes('admin'));}
    function when(value){if(!value)return 'None yet';const date=new Date(value);return Number.isNaN(date.getTime())?String(value):date.toLocaleString();}
    function webhookEntities(receipt){return (receipt?.notifications||[]).flatMap((notification)=>notification?.entities||[]);}
    async function api(body){const res=await fetch('/api/admin/quickbooks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const data=await res.json().catch(()=>({}));if(!res.ok)throw new Error(data.error||'QuickBooks request failed.');return data;}


    function openCatalogItem(item=null){
      if(!catalogForm||!catalogDialog)return;
      catalogForm.reset();
      catalogForm.elements.id.value=item?.id||'';
      catalogForm.elements.quickBooksItemId.value=item?.quickBooksItemId||'';
      catalogForm.elements.name.value=item?.name||'';
      catalogForm.elements.category.value=item?.category||'service';
      catalogForm.elements.unitLabel.value=item?.unitLabel||(item?.category==='mileage'?'mile':'each');
      catalogForm.elements.unitPrice.value=String(item?.unitPrice||0);
      catalogForm.elements.quickBooksType.value=item?.quickBooksType||(item?.category==='rental'?'NonInventory':'Service');
      catalogForm.elements.getExempt.checked=item?.getExempt===true;
      catalogForm.elements.description.value=item?.description||'';
      if(catalogTitle)catalogTitle.textContent=item?'Edit '+item.name:'Add catalog item';
      if(catalogFormMessage)catalogFormMessage.textContent=item?.quickBooksItemId?'QuickBooks item '+item.quickBooksItemId+' is linked.':'A matching QuickBooks item will be created when saved.';
      catalogDialog.showModal();
    }

    function renderCatalog(){
      if(!catalogList)return;
      catalogList.innerHTML='';
      const catalog=Array.isArray(state?.catalog)?state.catalog:[];
      if(!catalog.length){
        catalogList.innerHTML='<div class="rounded-xl border border-dashed border-[var(--koa-line)] p-5 text-sm text-[var(--koa-ink)]/55">No CRM catalog items yet. Import current QuickBooks items or add the first rental, service, mileage charge, or fee.</div>';
        return;
      }
      catalog.forEach((item)=>{
        const row=document.createElement('article');
        row.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
        row.innerHTML='<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><strong class="text-sm text-[var(--koa-forest)]"></strong><p class="mt-1 text-xs text-[var(--koa-ink)]/52"></p><p class="mt-1 text-xs text-[var(--koa-ink)]/45"></p></div><div class="flex flex-wrap gap-2"><button type="button" data-edit class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Edit</button><button type="button" data-archive class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Archive</button></div></div>';
        row.querySelector('strong').textContent=item.name+(item.active===false?' · archived':'');
        row.querySelectorAll('p')[0].textContent=(item.category||'service')+' · $'+Number(item.unitPrice||0).toFixed(2)+' / '+(item.unitLabel||'each')+(item.getExempt?' · GET exempt':' · GET taxable');
        row.querySelectorAll('p')[1].textContent='QBO '+(item.quickBooksType||'Service')+' #'+(item.quickBooksItemId||'not linked')+(item.incomeAccountName?' · '+item.incomeAccountName:'');
        row.querySelector('[data-edit]').addEventListener('click',()=>openCatalogItem(item));
        row.querySelector('[data-archive]').disabled=item.active===false;
        row.querySelector('[data-archive]').addEventListener('click',async()=>{
          if(!confirm('Archive '+item.name+' in the CRM? Its existing QuickBooks item and transactions will not be changed.'))return;
          if(catalogMessage)catalogMessage.textContent='Archiving '+item.name+'…';
          try{
            const data=await api({action:'archive-catalog-item',id:item.id});
            state.catalog=data.catalog||[];
            renderCatalog();
            if(catalogMessage)catalogMessage.textContent=item.name+' archived.';
          }catch(err){
            if(catalogMessage)catalogMessage.textContent=err.message||'Unable to archive item.';
          }
        });
        catalogList.appendChild(row);
      });
    }

    function money(value){return new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(Number(value||0));}
    function auditValue(value){return value==null?'—':money(value);}
    function renderAccountingAudit(){
      const audit=state?.accountingAudit||{};
      const rows=Array.isArray(audit.rows)?audit.rows:[];
      const flagged=rows.filter((row)=>!row.reconciled);
      if(auditClients)auditClients.textContent=String(Number(audit.clientCount||0));
      if(auditFlagged)auditFlagged.textContent=String(Number(audit.flaggedCount||0));
      if(auditPaid)auditPaid.textContent=money(audit.totalPaymentsReceived||0);
      if(auditRemaining)auditRemaining.textContent=money(audit.totalRemainingBalance||0);
      if(auditStatus){
        auditStatus.textContent=flagged.length?flagged.length+' need review':'Reconciled';
        auditStatus.className='rounded-full px-4 py-2 text-[.6rem] font-black uppercase tracking-[.1em] '+(flagged.length?'bg-red-50 text-red-700 border border-red-200':'bg-[var(--koa-sand)] text-[var(--koa-forest)]');
      }
      if(auditGenerated)auditGenerated.textContent=audit.generatedAt?'Audit generated '+when(audit.generatedAt)+'. Values reflect the latest CRM-stored QuickBooks synchronization.':'';
      if(!auditList)return;
      auditList.innerHTML='';
      if(!rows.length){
        auditList.innerHTML='<div class="rounded-xl border border-dashed border-[var(--koa-line)] p-5 text-sm text-[var(--koa-ink)]/55">No accepted/booked or QuickBooks-linked proposals are available to audit yet.</div>';
        return;
      }
      const visible=flagged.length?flagged:rows.slice(0,8);
      visible.forEach((row)=>{
        const card=document.createElement('article');
        card.className='rounded-xl border '+(row.reconciled?'border-[var(--koa-line)] bg-[var(--koa-ivory)]':'border-red-200 bg-red-50/55')+' p-4';
        const top=document.createElement('div');top.className='flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between';
        const left=document.createElement('div');
        const title=document.createElement('strong');title.className='text-sm text-[var(--koa-forest)]';title.textContent=row.clientName||row.recordId;
        const meta=document.createElement('p');meta.className='mt-1 text-xs text-[var(--koa-ink)]/50';meta.textContent=[row.recordId,row.eventDate,row.estimateDocNumber?'Estimate #'+row.estimateDocNumber:'No QBO estimate'].filter(Boolean).join(' · ');
        left.append(title,meta);
        const actions=document.createElement('div');actions.className='flex flex-wrap items-center gap-2';
        const link=document.createElement('a');link.href='/admin/quotes/?q='+encodeURIComponent(row.recordId);link.className='text-[.58rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]';link.textContent='Open client →';
        actions.appendChild(link);
        if(!row.reconciled){
          const recheck=document.createElement('button');recheck.type='button';recheck.className='rounded-full border border-red-200 bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-red-700';recheck.textContent='Sync & Recheck';
          recheck.addEventListener('click',async()=>{
            recheck.disabled=true;recheck.textContent='Syncing…';
            try{const result=await api({action:'sync-and-recheck',recordId:row.recordId});state.accountingAudit=result.accountingAudit||state.accountingAudit;renderAccountingAudit();}
            catch(err){recheck.disabled=false;recheck.textContent='Retry Sync & Recheck';alert(err.message||'Unable to sync and recheck this client.');}
          });
          actions.appendChild(recheck);
        }
        top.append(left,actions);card.appendChild(top);
        const totals=document.createElement('p');totals.className='mt-3 text-xs leading-5 text-[var(--koa-ink)]/58';
        totals.textContent='CRM '+money(row.proposalTotal)+' · QBO estimate '+auditValue(row.estimateTotal)+' · issued '+money(row.issuedTotal)+' · payments '+money(row.paymentsReceived)+' · remaining '+money(row.remainingBalance);
        card.appendChild(totals);
        if(row.reconciled){
          const ok=document.createElement('p');ok.className='mt-3 text-xs font-semibold text-[var(--koa-forest)]';ok.textContent='All stored accounting values reconcile.';
          card.appendChild(ok);
        }else{
          const issues=document.createElement('div');issues.className='mt-3 grid gap-2';
          (row.issues||[]).forEach((issue)=>{
            const item=document.createElement('div');item.className='rounded-lg border border-red-200 bg-white px-3 py-2 text-xs leading-5 text-red-800';
            item.textContent=issue.label+': expected '+auditValue(issue.expected)+', actual '+auditValue(issue.actual)+(issue.delta==null?'':' · difference '+money(issue.delta));
            issues.appendChild(item);
          });
          card.appendChild(issues);
        }
        auditList.appendChild(card);
      });
      if(!flagged.length&&rows.length>visible.length){
        const note=document.createElement('p');note.className='text-xs text-[var(--koa-ink)]/45';note.textContent='Showing the first '+visible.length+' reconciled clients.';
        auditList.appendChild(note);
      }
    }

    function renderDiagnostics(){
      const connected=Boolean(state?.connection?.connected);
      if(diagConnection)diagConnection.textContent=connected?'Connected':'Not connected';
      if(diagCompany)diagCompany.textContent=connected?(state.connection.companyName||'QuickBooks company connected')+' · '+String(state?.configuration?.environment||''):'OAuth connection required';

      const entities=webhookEntities(state?.webhookReceipt);
      if(diagWebhook)diagWebhook.textContent=when(state?.webhookReceipt?.receivedAt);
      if(diagWebhookMeta)diagWebhookMeta.textContent=entities.length
        ? entities.map((entity)=>String(entity.name||'')+' '+String(entity.operation||'')).join(' · ')
        : 'No verified QuickBooks webhook receipt stored yet.';

      if(diagSync)diagSync.textContent=when(state?.webhookProcessed?.processedAt);
      if(diagSyncMeta)diagSyncMeta.textContent=state?.webhookProcessed?.processedAt
        ? String(state.webhookProcessed.status||'processed')+' · '+Number(state.webhookProcessed.affectedRecords?.length||0)+' CRM record(s) affected'
        : 'No webhook-driven CRM synchronization recorded yet.';

      const test=state?.smokeTest;
      if(diagTest)diagTest.textContent=test?.completedAt?when(test.completedAt):'Not run';
      if(diagTestMeta)diagTestMeta.textContent=test?.completedAt
        ? 'Status: '+String(test.status||'unknown')+' · Invoice '+String(test.invoiceDocNumber||test.invoiceId||'')+' · Payment '+String(test.paymentId||'')
        : 'Run the sandbox end-to-end test after mapping a service item.';

      const invoiceMatched=Boolean(test?.webhook?.invoiceMatched||state?.smokeWebhookMatch?.invoiceMatched);
      const paymentMatched=Boolean(test?.webhook?.paymentMatched||state?.smokeWebhookMatch?.paymentMatched);
      const verified=Boolean(test?.webhook?.verified||(invoiceMatched&&paymentMatched));
      if(diagWebhookCheck)diagWebhookCheck.textContent=!test?.completedAt
        ? 'Sandbox webhook verification has not been attempted yet.'
        : verified
          ? 'Sandbox webhook verified: Intuit delivered matching Invoice and Payment events for the last successful test.'
          : 'Sandbox transaction passed, but matching webhook events are not yet fully verified. Invoice event: '+(invoiceMatched?'received':'not confirmed')+' · Payment event: '+(paymentMatched?'received':'not confirmed')+'.';
    }

    async function loadItems(){
      if(!state?.connection?.connected)return;
      itemMessage.textContent='Loading QuickBooks items…';
      try{
        const data=await api({action:'list-items'});items=data.items||[];
        if(!itemSelect)throw new Error('QuickBooks item selector is unavailable.');
        itemSelect.innerHTML='<option value="">Choose an item…</option>';
        items.forEach((item)=>{const option=document.createElement('option');option.value=item.id;option.textContent=item.name+' · '+item.type+(item.incomeAccountName?' · '+item.incomeAccountName:'');itemSelect.appendChild(option);});
        if(state.settings?.serviceItemId)itemSelect.value=state.settings.serviceItemId;
        itemMessage.textContent=items.length?items.length+' eligible QuickBooks items loaded.':'No active Service or Non-Inventory items found.';
        const selected=items.find((item)=>item.id===itemSelect.value);
        if(itemAccount)itemAccount.textContent=selected?.incomeAccountName?'Income account: '+selected.incomeAccountName:'';
      }catch(err){itemMessage.textContent=err.message||'Unable to load items.';}
    }

    function render(){
      const configured=Boolean(state?.configuration?.configured);
      const connected=Boolean(state?.connection?.connected);
      warning.classList.toggle('hidden',configured);
      warning.querySelector('[data-redirect-uri]').textContent=state?.configuration?.redirectUri||window.location.origin+'/.netlify/functions/quickbooks-callback';
      connect.classList.toggle('hidden',!configured||connected);
      disconnect.classList.toggle('hidden',!connected);
      itemSection.classList.toggle('hidden',!connected);
      catalogSection?.classList.toggle('hidden',!connected);
      getSection?.classList.toggle('hidden',!connected);
      depositSection?.classList.toggle('hidden',!connected);
      sandboxTest?.classList.toggle('hidden',!connected||state?.configuration?.environment!=='sandbox');
      productionTest?.classList.toggle('hidden',!connected||state?.configuration?.environment!=='production');
      company.textContent=connected?(state.connection.companyName||'QuickBooks company connected'):'Not connected';
      status.textContent=!configured
        ? 'Server credentials are required before OAuth can begin.'
        : connected
          ? 'Connected to realm '+state.connection.realmId+(state.connection.connectedAt?' · connected '+new Date(state.connection.connectedAt).toLocaleString():'')
          : 'Ready to connect Koa’s QuickBooks Online company.';
      if(prodCreds)prodCreds.textContent=state?.configuration?.productionCredentialsConfigured?'Configured':'Not configured';
      if(prodWebhook)prodWebhook.textContent=state?.configuration?.productionWebhookConfigured?'Configured':'Not configured';
      if(prodRedirect)prodRedirect.textContent=state?.configuration?.productionRedirectConfigured?'Configured':'Not configured';
      if(prodEnvironment)prodEnvironment.textContent=String(state?.configuration?.environment||'unknown').toUpperCase();
      if(productionTestStatus){
        const ptest=state?.productionTest;
        productionTestStatus.textContent=!ptest
          ? 'Ready after a production service item is mapped.'
          : 'Last test: '+String(ptest.status||'unknown')+' · '+(ptest.completedAt?when(ptest.completedAt):'');
        if(productionTestDetail)productionTestDetail.textContent=ptest
          ? 'Customer '+(ptest.customerName||ptest.customerId||'')+' · Estimate '+(ptest.estimateDocNumber||ptest.estimateId||'')+' · Invoice '+(ptest.invoiceDocNumber||ptest.invoiceId||'')+' · $'+Number(ptest.invoiceBalance||0).toFixed(2)+' open · emailed: '+(ptest.emailed?'Yes':'No')+(ptest.cleanup?.completedAt?' · cleanup completed '+when(ptest.cleanup.completedAt):'')
          : '';
      }
      if(productionLinkedStatus){
        const linked=state?.productionLinkedTest;
        productionLinkedStatus.textContent=!linked
          ? 'No CRM-linked production test has been run yet.'
          : linked.verified
            ? 'Verified: CRM record affected, Deposit Paid = Yes, balance $'+Number(linked.balanceDue||0).toFixed(2)+', stage '+String(linked.actualStage||'')+'.'
            : 'Waiting for production webhook verification.';
        if(productionLinkedDetail)productionLinkedDetail.textContent=linked
          ? 'CRM '+String(linked.recordId||'')+' · Estimate '+String(linked.estimateDocNumber||linked.estimateId||'')+' · Invoice '+String(linked.invoiceDocNumber||linked.invoiceId||'')+' · Payment '+String(linked.paymentId||'')+' · payment $'+Number(linked.paymentAmount||0).toFixed(2)+(linked.crmAffected?' · CRM affected':'')
          : '';
      }
      if(linkedTestMessage){
        const linked=state?.linkedTest;
        linkedTestMessage.textContent=!linked
          ? 'No CRM-linked sandbox booking test has been run yet.'
          : linked.verified
            ? 'Verified: '+linked.recordId+' moved to '+linked.actualStage+', Deposit Paid is '+(linked.depositPaid?'Yes':'No')+', and QuickBooks balance is $'+Number(linked.balanceDue||0).toFixed(2)+'.'
            : 'Waiting for webhook verification for '+linked.recordId+' · invoice '+(linked.invoiceDocNumber||linked.invoiceId||'')+' · payment '+(linked.paymentId||'')+'. Current stage: '+(linked.actualStage||'pending')+' · deposit paid: '+(linked.depositPaid?'Yes':'No')+'.';
      }
      if(getForm&&state?.getSettings){
        getForm.elements.customerRate.value='4.712';
        getForm.elements.label.value=state.getSettings.label||'Hawaiʻi GET';
      }
      if(depositForm&&state?.depositSettings){
        depositForm.elements.venueWeddingPercent.value=String(state.depositSettings.venueWeddingPercent ?? 10);
        depositForm.elements.mobileBarPercent.value=String(state.depositSettings.mobileBarPercent ?? 10);
        depositForm.elements.privateEventPercent.value=String(state.depositSettings.privateEventPercent ?? 10);
        depositForm.elements.defaultPercent.value=String(state.depositSettings.defaultPercent ?? 10);
        depositForm.elements.venueWeddingSecondDueDaysBefore.value=String(state.depositSettings.venueWeddingSecondDueDaysBefore ?? 90);
        depositForm.elements.venueWeddingFinalDueDaysBefore.value=String(state.depositSettings.venueWeddingFinalDueDaysBefore ?? 60);
        depositForm.elements.mobileBarFinalDueDaysBefore.value=String(state.depositSettings.mobileBarFinalDueDaysBefore ?? 14);
        depositForm.elements.privateEventFinalDueDaysBefore.value=String(state.depositSettings.privateEventFinalDueDaysBefore ?? 30);
        depositForm.elements.defaultFinalDueDaysBefore.value=String(state.depositSettings.defaultFinalDueDaysBefore ?? 30);
      }
      renderCatalog();
      renderDiagnostics();
      renderAccountingAudit();
      if(connected)loadItems();
    }

    async function load(){
      const user=await getAdminSession();if(!hasAdminAccess(user)){unauthorized.classList.remove('hidden');return;}
      app.classList.remove('hidden');
      const res=await fetch('/api/admin/quickbooks',{cache:'no-store'});
      if(!res.ok)return;state=await res.json();render();
      const params=new URLSearchParams(location.search);
      if(params.get('connected')==='1')status.textContent='QuickBooks connection completed.';
      if(params.get('qbo')==='error')status.textContent='QuickBooks connection did not complete. Check the Intuit app redirect URI and credentials.';
    }

    connect?.addEventListener('click',async()=>{status.textContent='Starting QuickBooks authorization…';try{const data=await api({action:'connect'});window.location.href=data.url;}catch(err){status.textContent=err.message||'Unable to start QuickBooks authorization.';}});
    disconnect?.addEventListener('click',async()=>{status.textContent='Disconnecting…';try{await api({action:'disconnect'});await load();}catch(err){status.textContent=err.message||'Unable to disconnect.';}});
    refreshItems?.addEventListener('click',loadItems);
    itemSelect?.addEventListener('change',()=>{
      const selected=items.find((item)=>item.id===itemSelect.value);
      if(itemAccount)itemAccount.textContent=selected?.incomeAccountName?'Income account: '+selected.incomeAccountName:'';
    });
    refreshDiagnostics?.addEventListener('click',load);
    refreshAudit?.addEventListener('click',load);
    document.querySelectorAll('[data-close-catalog]').forEach((button)=>button.addEventListener('click',()=>catalogDialog?.close()));
    newCatalog?.addEventListener('click',()=>openCatalogItem());
    importCatalog?.addEventListener('click',async()=>{
      if(catalogMessage)catalogMessage.textContent='Importing active Service and Non-Inventory items from QuickBooks…';
      try{const data=await api({action:'import-qbo-items'});state.catalog=data.catalog||[];renderCatalog();if(catalogMessage)catalogMessage.textContent='Imported '+Number(data.importedCount||0)+' QuickBooks items.';}catch(err){if(catalogMessage)catalogMessage.textContent=err.message||'Unable to import QuickBooks items.';}
    });
    catalogForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const data=new FormData(catalogForm);
      if(catalogFormMessage)catalogFormMessage.textContent='Saving to CRM and QuickBooks…';
      try{
        const result=await api({action:'save-catalog-item',item:{id:data.get('id'),quickBooksItemId:data.get('quickBooksItemId'),name:data.get('name'),category:data.get('category'),unitLabel:data.get('unitLabel'),unitPrice:Number(data.get('unitPrice')||0),quickBooksType:data.get('quickBooksType'),getExempt:data.get('getExempt')==='on',description:data.get('description'),active:true}});
        state.catalog=result.catalog||[];
        renderCatalog();
        if(catalogFormMessage)catalogFormMessage.textContent='Saved and synchronized with QuickBooks.';
        setTimeout(()=>catalogDialog?.close(),500);
      }catch(err){if(catalogFormMessage)catalogFormMessage.textContent=err.message||'Unable to save catalog item.';}
    });
    getForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const data=new FormData(getForm);
      if(getMessage)getMessage.textContent='Saving Hawaiʻi GET setting…';
      try{
        const result=await api({action:'save-get-settings',enabled:true,label:data.get('label'),customerRate:4.712});
        state.getSettings=result.getSettings;
        if(getMessage)getMessage.textContent='Saved. New CRM proposals can use '+Number(result.getSettings.customerRate||0).toFixed(3).replace(/0+$/,'').replace(/\.$/,'')+'% '+String(result.getSettings.label||'Hawaiʻi GET')+'.';
      }catch(err){if(getMessage)getMessage.textContent=err.message||'Unable to save GET setting.';}
    });
    depositForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();const data=new FormData(depositForm);if(depositMessage)depositMessage.textContent='Saving deposit defaults…';
      try{
        const result=await api({action:'save-deposit-settings',venueWeddingPercent:Number(data.get('venueWeddingPercent')||0),mobileBarPercent:Number(data.get('mobileBarPercent')||0),privateEventPercent:Number(data.get('privateEventPercent')||0),defaultPercent:Number(data.get('defaultPercent')||0),venueWeddingSecondDueDaysBefore:Number(data.get('venueWeddingSecondDueDaysBefore')||0),venueWeddingFinalDueDaysBefore:Number(data.get('venueWeddingFinalDueDaysBefore')||0),mobileBarFinalDueDaysBefore:Number(data.get('mobileBarFinalDueDaysBefore')||0),privateEventFinalDueDaysBefore:Number(data.get('privateEventFinalDueDaysBefore')||0),defaultFinalDueDaysBefore:Number(data.get('defaultFinalDueDaysBefore')||0)});
        state.depositSettings=result.depositSettings;if(depositMessage)depositMessage.textContent='Saved. New proposals will use these defaults by event category.';
      }catch(err){if(depositMessage)depositMessage.textContent=err.message||'Unable to save deposit defaults.';}
    });
    cleanupProductionTest?.addEventListener('click',async()=>{
      if(!productionTestStatus)return;
      productionTestStatus.textContent='Validating and cleaning the previous controlled production test…';
      cleanupProductionTest.disabled=true;
      try{
        const data=await api({action:'cleanup-production-smoke-test'});
        const cleanup=data.cleanup||{};
        productionTestStatus.textContent='Cleanup complete: invoice '+String(cleanup.invoice||'')+', estimate '+String(cleanup.estimate||'')+', customer '+String(cleanup.customer||'')+'.';
        await load();
      }catch(err){
        productionTestStatus.textContent=err.message||'Production test cleanup failed.';
      }finally{
        cleanupProductionTest.disabled=false;
      }
    });

    runProductionLinkedTest?.addEventListener('click',async()=>{
      if(!productionLinkedStatus)return;
      productionLinkedStatus.textContent='Creating controlled CRM-linked production booking…';
      runProductionLinkedTest.disabled=true;
      try{
        const data=await api({action:'production-linked-booking-test'});
        const t=data.test||{};
        productionLinkedStatus.textContent='Created CRM '+String(t.recordId||'')+'. Waiting for Invoice/Payment webhooks…';
        if(productionLinkedDetail)productionLinkedDetail.textContent='Estimate '+String(t.estimateDocNumber||t.estimateId||'')+' · Invoice '+String(t.invoiceDocNumber||t.invoiceId||'')+' · Payment '+String(t.paymentId||'')+' · payment $'+Number(t.paymentAmount||0).toFixed(2)+' · nothing emailed.';
        setTimeout(()=>load(),5000);
      }catch(err){
        productionLinkedStatus.textContent=err.message||'CRM-linked production test failed.';
      }finally{
        runProductionLinkedTest.disabled=false;
      }
    });

    runProductionTest?.addEventListener('click',async()=>{
      if(!productionTestStatus)return;
      productionTestStatus.textContent='Creating controlled $1 production customer, estimate and invoice…';
      runProductionTest.disabled=true;
      try{
        const data=await api({action:'production-smoke-test'});
        const t=data.test||{};
        productionTestStatus.textContent='Passed: '+(t.customerName||'test customer')+' · estimate '+(t.estimateDocNumber||t.estimateId||'')+' · invoice '+(t.invoiceDocNumber||t.invoiceId||'')+'.';
        if(productionTestDetail)productionTestDetail.textContent='Invoice balance $'+Number(t.invoiceBalance||0).toFixed(2)+' · nothing emailed · no payment recorded.';
        await load();
      }catch(err){
        productionTestStatus.textContent=err.message||'Production test failed.';
      }finally{
        runProductionTest.disabled=false;
      }
    });

    runLinkedTest?.addEventListener('click',async()=>{
      if(!linkedTestMessage)return;
      linkedTestMessage.textContent='Creating CRM-linked sandbox booking, deposit invoice and payment…';
      runLinkedTest.disabled=true;
      try{
        const data=await api({action:'sandbox-linked-booking-test'});
        const t=data.test||{};
        linkedTestMessage.textContent='Created '+(t.recordId||'CRM test record')+' · invoice '+(t.invoiceDocNumber||t.invoiceId||'')+' · payment '+(t.paymentId||'')+'. Waiting for Intuit webhook to update Deposit Paid and booking status.';
        setTimeout(()=>load(),4000);
      }catch(err){
        linkedTestMessage.textContent=err.message||'CRM-linked sandbox test failed.';
      }finally{
        runLinkedTest.disabled=false;
      }
    });

    runSandboxTest?.addEventListener('click',async()=>{
      if(!sandboxTestMessage)return;
      sandboxTestMessage.textContent='Running customer → estimate → invoice → payment test…';
      runSandboxTest.disabled=true;
      try{
        const data=await api({action:'sandbox-smoke-test'});
        const t=data.test||{};
        sandboxTestMessage.textContent='Passed: customer '+(t.customerId||'')+', estimate '+(t.estimateDocNumber||t.estimateId||'')+', invoice '+(t.invoiceDocNumber||t.invoiceId||'')+', payment '+(t.paymentId||'')+', ending invoice balance $'+Number(t.invoiceBalanceAfterPayment||0).toFixed(2)+'. Webhook confirmation may arrive shortly.';
        await load();
      }catch(err){
        sandboxTestMessage.textContent=err.message||'Sandbox test failed.';
      }finally{
        runSandboxTest.disabled=false;
      }
    });
    itemForm?.addEventListener('submit',async(e)=>{e.preventDefault();const id=String(itemSelect?.value||'');const item=items.find((entry)=>entry.id===id);if(!item){itemMessage.textContent='Choose a QuickBooks item.';return;}itemMessage.textContent='Saving…';try{const data=await api({action:'set-service-item',itemId:item.id,itemName:item.name});state.settings=data.settings;itemMessage.textContent='Mapped to '+item.name+'.';}catch(err){itemMessage.textContent=err.message||'Unable to save mapping.';}});

    load();
  </script>
</BaseLayout>
