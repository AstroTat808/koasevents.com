    function validatePaymentTemplates(){
      const errors=[];
      const warnings=[];
      const labels={venueWedding:'Venue Wedding',mobileBar:'Mobile Bar',privateEvent:'Private Event',default:'General fallback'};
      const depositFields={venueWedding:'venueWeddingPercent',mobileBar:'mobileBarPercent',privateEvent:'privateEventPercent',default:'defaultPercent'};
      templateKeys.forEach((key)=>{
        const rows=readTemplate(key);
        const label=labels[key]||key;
        const deposit=Number(depositForm?.elements?.[depositFields[key]]?.value||0);
        if(!Number.isFinite(deposit)||deposit<0||deposit>100)errors.push(label+': deposit percentage must be between 0% and 100%.');
        else if(deposit===0)warnings.push(label+': 0% deposit is unusual.');
        else if(deposit>50)warnings.push(label+': deposit above 50% is unusual ('+deposit+'%).');
        if(!rows.length){errors.push(label+': at least one post-deposit milestone is required.');return;}
        let priorDays=null;
        let configuredPercent=0;
        rows.forEach((row,index)=>{
          const rowLabel=String(row.label||'').trim()||('Milestone '+(index+1));
          const days=Number(row.dueDaysBefore);
          const last=index===rows.length-1;
          if(!String(row.label||'').trim())errors.push(label+': milestone '+(index+1)+' needs a label.');
          if(!Number.isFinite(days))errors.push(label+' · '+rowLabel+': days before event must be a number.');
          else{
            if(days<0)errors.push(label+' · '+rowLabel+': payment is scheduled after the event ('+Math.abs(days)+' day'+(Math.abs(days)===1?'':'s')+' after).');
            if(days>730)errors.push(label+' · '+rowLabel+': due date is more than 730 days before the event.');
            if(days===0)warnings.push(label+' · '+rowLabel+': payment is due on the event date.');
            if(priorDays!=null&&days>priorDays)warnings.push(label+': '+rowLabel+' is out of chronological order because '+days+' days before the event comes earlier than the milestone above it ('+priorDays+' days).');
            if(priorDays!=null&&days===priorDays)warnings.push(label+': two milestones are due on the same day ('+days+' days before the event).');
            priorDays=days;
          }
          if(!last){
            const pct=Number(row.percentOfRemaining);
            if(!Number.isFinite(pct)||pct<0||pct>100)errors.push(label+' · '+rowLabel+': percentage must be between 0% and 100%.');
            else{
              configuredPercent+=pct;
              if(pct===0)warnings.push(label+' · '+rowLabel+': 0% creates a $0 milestone.');
              else if(pct<5)warnings.push(label+' · '+rowLabel+': '+pct+'% is an unusually small milestone.');
              else if(pct>75)warnings.push(label+' · '+rowLabel+': '+pct+'% is an unusually large milestone.');
            }
          }
        });
        if(configuredPercent>=100)warnings.push(label+': configured milestones use '+configuredPercent+'% before the automatic final remainder, so the final milestone may be $0.');
      });
      return {errors:[...new Set(errors)],warnings:[...new Set(warnings)]};
    }
