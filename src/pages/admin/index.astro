---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Admin" description="Koa’s Events content administration." canonical="https://koasevents.com/admin/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-16">
    <div class="container-shell max-w-3xl">
      <div class="rounded-[1.6rem] bg-white p-8 shadow-[var(--shadow-soft)]">
        <p class="eyebrow text-[var(--koa-clay)]">Koa’s Events</p>
        <h1 class="display mt-4 text-5xl">Content Admin</h1>
        <div data-auth-panel class="mt-8">
          <form data-invite-form class="hidden grid gap-4">
            <div class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="eyebrow text-[var(--koa-clay)]">Accept your invitation</p>
              <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/62">Create the password you’ll use to sign in to Koa’s Content Admin.</p>
            </div>
            <label class="grid gap-2 text-sm font-semibold">New password<input name="password" type="password" minlength="8" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <label class="grid gap-2 text-sm font-semibold">Confirm password<input name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Create account</button>
            <p data-invite-error class="hidden text-sm text-red-700"></p>
          </form>

          <form data-login-form class="grid gap-4">
            <label class="grid gap-2 text-sm font-semibold">Email<input name="email" type="email" autocomplete="email" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <label class="grid gap-2 text-sm font-semibold">Password<input name="password" type="password" autocomplete="current-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Sign in</button>
            <p data-auth-error class="hidden text-sm text-red-700"></p>
          </form>

          <div data-role-warning class="hidden rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] p-5">
            <p class="font-semibold text-[var(--koa-ink)]">This account is signed in but is not approved for Content Admin.</p>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58">Use one of the approved Koa’s administrator accounts, then sign in again.</p>
            <button data-logout-warning class="mt-4 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">Sign out</button>
          </div>

          <div data-admin-links class="hidden grid gap-4 sm:grid-cols-2">
            <a data-health-warning href="/admin/health/" class="hidden rounded-[1.3rem] border border-red-300 bg-red-50 p-5 text-red-950 sm:col-span-2">
              <span class="text-[.58rem] font-black uppercase tracking-[.1em] text-red-700">System health warning</span>
              <strong data-health-warning-title class="mt-2 block text-lg">A protected Koa’s service needs attention.</strong>
              <span data-health-warning-detail class="mt-1 block text-sm text-red-900/70">Open System Health for details.</span>
            </a>
            <a href="/admin/staff/" class="rounded-[1.3rem] bg-[var(--koa-amber-light)] p-6 text-[var(--koa-ink)] sm:col-span-2"><span class="display text-3xl">Staff Management</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/60">Invite employees, assign Sales Rep or Manager access, deactivate accounts, and review permissions.</span></a>
            <a href="/admin/health/" class="rounded-[1.3rem] border border-emerald-200 bg-emerald-50 p-6 text-[var(--koa-forest)] sm:col-span-2"><span class="display text-3xl">System Health</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/60">Check protected page startup, CRM/admin APIs, response status, and latency from one read-only dashboard.</span></a>
            <a href="/admin/crm/" class="rounded-[1.3rem] bg-[var(--koa-ink)] p-6 text-white sm:col-span-2"><span class="display text-3xl">Business CRM</span><span class="mt-2 block text-sm text-white/70">Unified client workspace for contacts, projects, tasks, appointments, workflows, templates, client links, payments and activity history.</span></a>
            <a href="/admin/quotes/" class="rounded-[1.3rem] bg-[var(--koa-clay)] p-6 text-white sm:col-span-2"><span class="display text-3xl">Sales CRM</span><span class="mt-2 block text-sm text-white/70">Manage inquiries, proposals, QuickBooks estimates and invoices, contracts, bookings and conversion analytics.</span></a>
            <a href="/admin/quotes/#mobile-bar" class="rounded-[1.3rem] bg-[var(--koa-forest)] p-6 text-white"><span class="display text-3xl">Mobile Bar CRM</span><span class="mt-2 block text-sm text-white/65">Open the dedicated Mobile Bar pipeline, calculator details, follow-ups, filters and package reporting.</span></a>
            <a href="/admin/events/" class="rounded-[1.3rem] bg-[var(--koa-forest)] p-6 text-white"><span class="display text-3xl">Event Ops</span><span class="mt-2 block text-sm text-white/65">Run booked events: vendors, insurance, floor plans, questionnaires, timelines, checklists and event-day tasks.</span></a>
            <a href="/admin/calendar/" class="rounded-[1.3rem] bg-[var(--koa-clay)] p-6 text-white"><span class="display text-3xl">Master Calendar</span><span class="mt-2 block text-sm text-white/70">See every event, deadline, vendor arrival, staffing assignment and scheduling conflict across all bookings.</span></a>
            <a href="/admin/quickbooks/" class="rounded-[1.3rem] bg-[var(--koa-ink)] p-6 text-white"><span class="display text-3xl">QuickBooks</span><span class="mt-2 block text-sm text-white/65">Connect QuickBooks Online and map the accounting item used for Koa’s estimates and invoices.</span></a>
            <a href="/admin/security/" class="rounded-[1.3rem] bg-[var(--koa-ink)] p-6 text-white"><span class="display text-3xl">Security + Spam</span><span class="mt-2 block text-sm text-white/65">Review blocked attempts, suspicious inquiry flags, rate limits, and legitimate inquiry volume.</span></a><a href="/admin/seo/" class="rounded-[1.3rem] bg-[var(--koa-forest)] p-6 text-white"><span class="display text-3xl">Local SEO</span><span class="mt-2 block text-sm text-white/65">Track Google Business Profile performance, Search Console rankings, citations and GBP publishing history.</span></a>
            <a href="/admin/blog/" class="rounded-[1.3rem] bg-white p-6 text-[var(--koa-forest)] shadow-sm"><span class="display text-3xl">Blog</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/55">Create, edit, publish and delete journal entries.</span></a>
            <a href="/admin/vendors/" class="rounded-[1.3rem] bg-[var(--koa-amber-light)] p-6 text-[var(--koa-ink)]"><span class="display text-3xl">Vendor CRM</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/60">Manage marketplace profiles, Preferred Partners, insurance, verified reviews, internal performance and gallery attribution.</span></a>
            <a href="/admin/gallery/" class="rounded-[1.3rem] bg-white p-6 text-[var(--koa-forest)] shadow-sm"><span class="display text-3xl">Gallery</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/55">Upload, remove and hide gallery photography.</span></a>
            <button data-logout class="text-left text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">Sign out</button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script>
    import { acceptInvite, getUser, handleAuthCallback, login, logout } from '@netlify/identity';

    const loginForm = document.querySelector('[data-login-form]');
    const inviteForm = document.querySelector('[data-invite-form]');
    const links = document.querySelector('[data-admin-links]');
    const roleWarning = document.querySelector('[data-role-warning]');
    const authError = document.querySelector('[data-auth-error]');
    const inviteError = document.querySelector('[data-invite-error]');
    let inviteToken = '';

    const approvedAdminEmails = new Set(['chris@sibel.org','koasadmin@koasevents.com']);

    function hasAdminAccess(user) {
      const email = String(user?.email || '').trim().toLowerCase();
      const roleSources = [user?.roles, user?.appMetadata?.roles, user?.app_metadata?.roles];
      const roles = roleSources.find(Array.isArray) || [];
      return approvedAdminEmails.has(email) || roles.map((role) => String(role || '').toLowerCase()).includes('admin');
    }

    async function updateHealthWarning(isAdmin) {
      const warning=document.querySelector('[data-health-warning]');
      if(!warning||!isAdmin){warning?.classList.add('hidden');return;}
      try{
        const response=await fetch('/api/admin/health',{cache:'no-store'});
        if(!response.ok)return;
        const data=await response.json();const current=data.current;
        const unhealthy=current?.overall==='unhealthy';
        warning.classList.toggle('hidden',!unhealthy);
        if(unhealthy){
          const names=(current.checks||[]).filter((row)=>!row.ok).map((row)=>row.name);
          document.querySelector('[data-health-warning-title]').textContent=current.failed+' health check'+(current.failed===1?'':'s')+' failing';
          document.querySelector('[data-health-warning-detail]').textContent=(names.slice(0,4).join(', ')||'Protected system issue detected')+(names.length>4?' +'+(names.length-4)+' more':'')+' · checked '+new Date(current.checkedAt).toLocaleString();
        }
      }catch{}
    }

    function showAuthState(user) {
      const isAdmin = Boolean(user) && hasAdminAccess(user);
      loginForm?.classList.toggle('hidden', Boolean(user) || Boolean(inviteToken));
      inviteForm?.classList.toggle('hidden', !inviteToken);
      links?.classList.toggle('hidden', !isAdmin);
      roleWarning?.classList.toggle('hidden', !user || isAdmin);
      updateHealthWarning(isAdmin);
    }

    async function initialize() {
      try {
        const result = await handleAuthCallback();

        if (result?.type === 'invite' && result.token) {
          inviteToken = result.token;
          showAuthState(null);
          return;
        }

        const user = await getUser();
        showAuthState(user);
      } catch (err) {
        if (authError) {
          authError.textContent = err instanceof Error ? err.message : 'Unable to process the sign-in link.';
          authError.classList.remove('hidden');
        }
        showAuthState(await getUser());
      }
    }

    inviteForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(inviteForm);
      const password = String(data.get('password') || '');
      const confirmPassword = String(data.get('confirmPassword') || '');

      if (password !== confirmPassword) {
        if (inviteError) {
          inviteError.textContent = 'The passwords do not match.';
          inviteError.classList.remove('hidden');
        }
        return;
      }

      try {
        const user = await acceptInvite(inviteToken, password);
        inviteToken = '';
        history.replaceState(null, '', '/admin/');
        if (inviteError) inviteError.classList.add('hidden');
        showAuthState(user);
      } catch (err) {
        if (inviteError) {
          inviteError.textContent = err instanceof Error ? err.message : 'Unable to accept the invitation.';
          inviteError.classList.remove('hidden');
        }
      }
    });

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(loginForm);
      try {
        const user = await login(String(data.get('email')), String(data.get('password')));
        if (authError) authError.classList.add('hidden');
        showAuthState(user);
      } catch (err) {
        if (authError) {
          authError.textContent = err instanceof Error ? err.message : 'Unable to sign in.';
          authError.classList.remove('hidden');
        }
      }
    });

    async function signOut() {
      await logout();
      showAuthState(null);
    }

    document.querySelector('[data-logout]')?.addEventListener('click', signOut);
    document.querySelector('[data-logout-warning]')?.addEventListener('click', signOut);

    initialize();
  </script>
</BaseLayout>
