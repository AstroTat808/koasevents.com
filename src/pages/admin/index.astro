---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Koa’s Admin" description="Koa’s Events content administration." canonical="https://www.koasevents.com/admin/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-16">
    <div class="container-shell max-w-3xl">
      <div class="rounded-[1.6rem] bg-white p-8 shadow-[var(--shadow-soft)]">
        <p class="eyebrow text-[var(--koa-clay)]">Koa’s Events</p>
        <h1 class="display mt-4 text-5xl">Content Admin</h1>
        <div data-auth-panel class="mt-8">
          <form data-login-form class="grid gap-4">
            <label class="grid gap-2 text-sm font-semibold">Email<input name="email" type="email" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <label class="grid gap-2 text-sm font-semibold">Password<input name="password" type="password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Sign in</button>
            <p data-auth-error class="hidden text-sm text-red-700"></p>
          </form>
          <div data-admin-links class="hidden grid gap-4 sm:grid-cols-2">
            <a href="/admin/blog/" class="rounded-[1.3rem] bg-[var(--koa-forest)] p-6 text-white"><span class="display text-3xl">Blog</span><span class="mt-2 block text-sm text-white/65">Create, edit, publish and delete journal entries.</span></a>
            <a href="/admin/gallery/" class="rounded-[1.3rem] bg-[var(--koa-ink)] p-6 text-white"><span class="display text-3xl">Gallery</span><span class="mt-2 block text-sm text-white/65">Upload, remove and hide gallery photography.</span></a>
            <button data-logout class="text-left text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">Sign out</button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script>
    import { getUser, handleAuthCallback, login, logout } from '@netlify/identity';
    const form = document.querySelector('[data-login-form]');
    const links = document.querySelector('[data-admin-links]');
    const error = document.querySelector('[data-auth-error]');

    async function render() {
      await handleAuthCallback();
      const user = await getUser();
      form?.classList.toggle('hidden', Boolean(user));
      links?.classList.toggle('hidden', !user);
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      try {
        await login(String(data.get('email')), String(data.get('password')));
        if (error) error.classList.add('hidden');
        await render();
      } catch (err) {
        if (error) {
          error.textContent = err instanceof Error ? err.message : 'Unable to sign in.';
          error.classList.remove('hidden');
        }
      }
    });

    document.querySelector('[data-logout]')?.addEventListener('click', async () => {
      await logout();
      await render();
    });

    render();
  </script>
</BaseLayout>
