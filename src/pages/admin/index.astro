---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Admin" description="Koa’s Events content administration." canonical="https://koasevents.com/admin/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-16">
    <div class="container-shell max-w-5xl">
      <div class="rounded-[1.6rem] bg-white p-8 shadow-[var(--shadow-soft)]">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Koa’s Events</p>
            <h1 class="display mt-4 text-5xl">Content Admin</h1>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span data-admin-role-badge class="hidden rounded-full border border-[var(--koa-line)] bg-[var(--koa-sand)] px-3 py-2 text-[.62rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]"></span>
            <button data-admin-layout-edit type="button" class="hidden rounded-full border border-[var(--koa-line)] bg-white px-4 py-2.5 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Customize layout</button>
          </div>
        </div>
        <div data-auth-panel class="mt-8">
          <div data-session-expired-message class="mb-5 hidden rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-950">
            <p class="text-xs font-black uppercase tracking-[.1em] text-amber-800">Session expired</p>
            <p class="mt-1 text-sm font-semibold">Your session expired — please sign in again.</p>
            <p data-session-return-message class="mt-1 text-xs leading-5 text-amber-900/70">After sign-in, you’ll return to the admin page you were using.</p>
          </div>
          <form data-invite-form class="hidden grid gap-4">
            <div class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="eyebrow text-[var(--koa-clay)]">Accept your invitation</p>
              <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/62">Create the password you’ll use to sign in to Koa’s Content Admin.</p>
            </div>
            <label class="grid gap-2 text-sm font-semibold">Administrator email<input data-invite-email name="email" type="email" autocomplete="email" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="chris@sibel.org" /><span class="text-xs font-normal leading-5 text-[var(--koa-ink)]/48">If this is an older invitation, Koa’s will use this email to repair the approved administrator account and send a fresh secure reset link.</span></label>
            <label class="grid gap-2 text-sm font-semibold">New password<input name="password" type="password" minlength="8" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <label class="grid gap-2 text-sm font-semibold">Confirm password<input name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Create account</button>
            <p data-invite-error class="hidden text-sm text-red-700"></p>
          </form>

          <form data-login-form class="grid gap-4">
            <label class="grid gap-2 text-sm font-semibold">Email<input name="email" type="email" autocomplete="email" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <label class="grid gap-2 text-sm font-semibold">Password
              <span class="relative block"><input data-login-password name="password" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-[var(--koa-line)] px-4 py-3 pr-24" /><button data-toggle-login-password type="button" class="absolute inset-y-0 right-3 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Show</button></span>
            </label>
            <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Sign in</button>
            <p data-auth-error class="hidden text-sm text-red-700"></p>
            <div class="flex flex-wrap gap-4"><button data-show-recovery-request type="button" class="text-left text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Forgot password?</button><button data-show-bootstrap type="button" class="text-left text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Create or repair an approved admin account</button></div>
          </form>

          <form data-recovery-request-form class="hidden mt-5 grid gap-4 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] p-5">
            <div><p class="eyebrow text-[var(--koa-clay)]">Reset password</p><p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/62">Enter your account email and Koa’s will send a secure password reset link.</p></div>
            <label class="grid gap-2 text-sm font-semibold">Email<input name="email" type="email" autocomplete="email" required class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3" /></label>
            <div class="flex flex-wrap gap-3"><button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Send reset link</button><button data-hide-recovery-request type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Back</button></div>
            <p data-recovery-request-message class="text-sm leading-6 text-[var(--koa-ink)]/62"></p>
          </form>

          <form data-bootstrap-form class="hidden mt-5 grid gap-4 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] p-5">
            <div><p class="eyebrow text-[var(--koa-clay)]">Administrator setup</p><p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/62">Use this only for an approved Koa’s administrator email. The account will be created or repaired and a secure password-setup email will be sent.</p></div>
            <label class="grid gap-2 text-sm font-semibold">Approved admin email<input name="email" type="email" autocomplete="email" required class="rounded-xl border border-[var(--koa-line)] bg-white px-4 py-3" /></label>
            <div class="flex flex-wrap gap-3">
              <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Create / repair account</button>
              <button data-hide-bootstrap type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Back to sign in</button>
            </div>
            <p data-bootstrap-message class="text-sm leading-6 text-[var(--koa-ink)]/62"></p>
          </form>

          <form data-recovery-form class="hidden grid gap-4">
            <div class="rounded-xl bg-[var(--koa-sand)] p-4">
              <p class="eyebrow text-[var(--koa-clay)]">Set a new password</p>
              <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/62">Enter a new password for your Koa’s administrator account.</p>
            </div>
            <label class="grid gap-2 text-sm font-semibold">New password<input name="password" type="password" minlength="8" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <label class="grid gap-2 text-sm font-semibold">Confirm password<input name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Save new password</button>
            <p data-recovery-error class="hidden text-sm text-red-700"></p>
          </form>

          <div data-role-warning class="hidden rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] p-5">
            <p class="font-semibold text-[var(--koa-ink)]">This account does not currently have access to the Admin workspace.</p>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58">Admin Home appears automatically when the account has at least one workspace module permission.</p>
            <button data-logout-warning class="mt-4 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">Sign out</button>
          </div>

          <div data-admin-links class="hidden grid gap-8">
            <a data-health-warning href="/admin/health/" class="hidden rounded-[1.3rem] border border-red-300 bg-red-50 p-5 text-red-950">
              <span class="text-[.58rem] font-black uppercase tracking-[.1em] text-red-700">System health warning</span>
              <strong data-health-warning-title class="mt-2 block text-lg">A protected Koa’s service needs attention.</strong>
              <span data-health-warning-detail class="mt-1 block text-sm text-red-900/70">Open System Health for details.</span>
            </a>

            <section data-admin-layout-editor class="hidden rounded-[1.3rem] border border-[var(--koa-line)] bg-[var(--koa-sand)] p-5">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="eyebrow text-[var(--koa-clay)]">Admin Home layout</p>
                  <h2 class="display mt-1 text-3xl text-[var(--koa-forest)]">Customize Admin Home</h2>
                  <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--koa-ink)]/55">Drag sections and modules into place, or use the Up/Down buttons. Drag handles use pointer controls so they work with a mouse, touch, Apple Pencil, and iPad.</p>
                </div>
                <span data-admin-layout-message class="text-xs font-semibold text-[var(--koa-ink)]/50"></span>
              </div>
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/45">Save as</span>
                <button data-admin-layout-scope="personal" type="button" class="rounded-full border border-[var(--koa-forest)] bg-[var(--koa-forest)] px-4 py-2.5 text-[.58rem] font-black uppercase tracking-[.08em] text-white">My Layout</button>
                <button data-admin-layout-scope="company" type="button" class="hidden rounded-full border border-[var(--koa-line)] bg-white px-4 py-2.5 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Company Default</button>
                <span data-admin-layout-scope-help class="text-xs leading-5 text-[var(--koa-ink)]/50">Only your account will use this order.</span>
              </div>
              <div data-admin-layout-editor-sections class="mt-5 grid gap-4"></div>
              <div class="mt-5 flex flex-wrap gap-2">
                <button data-admin-layout-save type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-[.58rem] font-black uppercase tracking-[.08em] text-white">Save My Layout</button>
                <button data-admin-layout-reset type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-5 py-3 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Reset order</button>
                <button data-admin-layout-cancel type="button" class="rounded-full border border-[var(--koa-line)] px-5 py-3 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Cancel</button>
              </div>
            </section>

            <section data-admin-section data-section-id="sales" class="grid gap-3">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Sales</p>
                <p class="mt-1 text-sm text-[var(--koa-ink)]/50">Client relationships, inquiries, proposals, email, and pricing.</p>
              </div>
              <div data-admin-module-grid class="grid gap-4 sm:grid-cols-2">
                <a data-admin-module data-module-id="business-crm" data-capability="crm.view" href="/admin/crm/" class="rounded-[1.3rem] bg-[var(--koa-ink)] p-6 text-white"><span class="display text-3xl">Business CRM</span><span class="mt-2 block text-sm text-white/70">Unified client workspace for contacts, projects, tasks, appointments, workflows, templates, client links, payments and activity history.</span></a>
                <a data-admin-module data-module-id="sales-crm" data-capability="sales.view" href="/admin/quotes/" class="rounded-[1.3rem] bg-[var(--koa-clay)] p-6 text-white"><span class="display text-3xl">Sales CRM</span><span class="mt-2 block text-sm text-white/70">Manage inquiries, proposals, QuickBooks estimates and invoices, contracts, bookings and conversion analytics.</span></a>
                <a data-admin-module data-module-id="email" data-capability="email.view" href="/admin/email/" class="rounded-[1.3rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-6 text-[var(--koa-forest)]"><span class="display text-3xl">Email</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/60">Control email recipients and routing, reusable recipient groups, sender identities, test routes, and review delivery activity.</span></a>
                <a data-admin-module data-module-id="wedding-profitability" data-capability="sales.profit_settings" href="/admin/profitability/" class="rounded-[1.3rem] bg-[var(--koa-amber-light)] p-6 text-[var(--koa-ink)]"><span class="display text-3xl">Wedding Profitability</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/60">Enter package and add-on costs, target margins, recommended sell prices, and actual event economics in one management dashboard.</span></a>
                <a data-admin-module data-module-id="mobile-bar-crm" data-capability="sales.view" href="/admin/quotes/#mobile-bar" class="rounded-[1.3rem] bg-[var(--koa-forest)] p-6 text-white sm:col-span-2"><span class="display text-3xl">Mobile Bar CRM</span><span class="mt-2 block text-sm text-white/65">Open the dedicated Mobile Bar pipeline, calculator details, follow-ups, filters and package reporting.</span></a>
              </div>
            </section>

            <section data-admin-section data-section-id="operations" class="grid gap-3">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Operations</p>
                <p class="mt-1 text-sm text-[var(--koa-ink)]/50">Events, schedules, vendors, and compliance.</p>
              </div>
              <div data-admin-module-grid class="grid gap-4 sm:grid-cols-2">
                <a data-admin-module data-module-id="event-ops" data-capability="events.view" href="/admin/events/" class="rounded-[1.3rem] bg-[var(--koa-forest)] p-6 text-white"><span class="display text-3xl">Event Ops</span><span class="mt-2 block text-sm text-white/65">Run booked events: vendors, insurance, floor plans, questionnaires, timelines, checklists and event-day tasks.</span></a>
                <a data-admin-module data-module-id="calendar" data-capability="calendar.view" href="/admin/calendar/" class="rounded-[1.3rem] bg-[var(--koa-clay)] p-6 text-white"><span class="display text-3xl">Master Calendar</span><span class="mt-2 block text-sm text-white/70">See every event, deadline, vendor arrival, staffing assignment and scheduling conflict across all bookings.</span></a>
                <a data-admin-module data-module-id="vendor-crm" data-capability="vendors.view" href="/admin/vendors/" class="rounded-[1.3rem] bg-[var(--koa-amber-light)] p-6 text-[var(--koa-ink)]"><span class="display text-3xl">Vendor CRM</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/60">Manage marketplace profiles, Preferred Partners, insurance, verified reviews, internal performance and gallery attribution.</span></a>
                <a data-admin-module data-module-id="insurance" data-capability="insurance.view" href="/admin/insurance/" class="rounded-[1.3rem] border border-red-200 bg-red-50 p-6 text-red-950"><span class="display text-3xl">Insurance Compliance</span><span class="mt-2 block text-sm text-red-900/65">See missing, pending, rejected, expiring and expired vendor certificates and every upcoming event affected.</span></a>
              </div>
            </section>

            <section data-admin-section data-section-id="accounting" class="grid gap-3">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Accounting</p>
                <p class="mt-1 text-sm text-[var(--koa-ink)]/50">Accounting connections and financial workflows.</p>
              </div>
              <div data-admin-module-grid class="grid gap-4 sm:grid-cols-2">
                <a data-admin-module data-module-id="quickbooks" data-capability="quickbooks.view" href="/admin/quickbooks/" class="rounded-[1.3rem] bg-[var(--koa-ink)] p-6 text-white sm:col-span-2"><span class="display text-3xl">QuickBooks</span><span class="mt-2 block text-sm text-white/65">Connect QuickBooks Online and map the accounting item used for Koa’s estimates and invoices.</span></a>
              </div>
            </section>

            <section data-admin-section data-section-id="content" class="grid gap-3">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Content</p>
                <p class="mt-1 text-sm text-[var(--koa-ink)]/50">Website content, search visibility, galleries, and email presentation.</p>
              </div>
              <div data-admin-module-grid class="grid gap-4 sm:grid-cols-2">
                <a data-admin-module data-module-id="email-preview" data-capability="email.view" href="/admin/email-preview/" class="rounded-[1.3rem] bg-white p-6 text-[var(--koa-forest)] shadow-sm"><span class="display text-3xl">Email Preview</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/55">Preview automated and staff-sent emails in desktop/mobile layouts and switch between Koa’s Events and Koa’s Mobile Bar branding.</span></a>
                <a data-admin-module data-module-id="seo" data-capability="seo.view" href="/admin/seo/" class="rounded-[1.3rem] bg-[var(--koa-forest)] p-6 text-white"><span class="display text-3xl">Local SEO</span><span class="mt-2 block text-sm text-white/65">Track Google Business Profile performance, Search Console rankings, citations and GBP publishing history.</span></a>
                <a data-admin-module data-module-id="blog" data-capability="blog.view" href="/admin/blog/" class="rounded-[1.3rem] bg-white p-6 text-[var(--koa-forest)] shadow-sm"><span class="display text-3xl">Blog</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/55">Create, edit, publish and delete journal entries.</span></a>
                <a data-admin-module data-module-id="gallery" data-capability="gallery.view" href="/admin/gallery/" class="rounded-[1.3rem] bg-white p-6 text-[var(--koa-forest)] shadow-sm"><span class="display text-3xl">Gallery</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/55">Upload, remove and hide gallery photography.</span></a>
              </div>
            </section>

            <section data-admin-section data-section-id="administration" class="grid gap-3">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Administration</p>
                <p class="mt-1 text-sm text-[var(--koa-ink)]/50">Users, reliability, and workspace security.</p>
              </div>
              <div data-admin-module-grid class="grid gap-4 sm:grid-cols-2">
                <a data-admin-module data-module-id="user-management" data-capability="users.manage" href="/admin/staff/" class="rounded-[1.3rem] bg-[var(--koa-amber-light)] p-6 text-[var(--koa-ink)]"><span class="display text-3xl">User Management</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/60">Create users, assign roles and permissions, deactivate or remove accounts, reset or set passwords, and review security activity.</span></a>
                <a data-admin-module data-module-id="system-health" data-capability="health.view" href="/admin/health/" class="rounded-[1.3rem] border border-emerald-200 bg-emerald-50 p-6 text-[var(--koa-forest)]"><span class="display text-3xl">System Health</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/60">Check protected page startup, CRM/admin APIs, response status, and latency from one read-only dashboard.</span></a>
                <a data-admin-module data-module-id="security" data-capability="security.view" href="/admin/security/" class="rounded-[1.3rem] bg-[var(--koa-ink)] p-6 text-white sm:col-span-2"><span class="display text-3xl">Security + Spam</span><span class="mt-2 block text-sm text-white/65">Review blocked attempts, suspicious inquiry flags, rate limits, and legitimate inquiry volume.</span></a>
              </div>
            </section>

            <button data-logout class="text-left text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">Sign out</button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script>
    import { acceptInvite, getUser, handleAuthCallback, login, logout, recoverPassword, requestPasswordRecovery, updateUser } from '@netlify/identity';
    import { getAdminSession } from '../../lib/admin-session';

    const loginForm = document.querySelector('[data-login-form]');
    const inviteForm = document.querySelector('[data-invite-form]');
    const links = document.querySelector('[data-admin-links]');
    const roleWarning = document.querySelector('[data-role-warning]');
    const authError = document.querySelector('[data-auth-error]');
    const inviteError = document.querySelector('[data-invite-error]');
    const bootstrapForm = document.querySelector('[data-bootstrap-form]');
    const bootstrapMessage = document.querySelector('[data-bootstrap-message]');
    const recoveryForm = document.querySelector('[data-recovery-form]');
    const recoveryError = document.querySelector('[data-recovery-error]');
    const recoveryRequestForm = document.querySelector('[data-recovery-request-form]');
    const recoveryRequestMessage = document.querySelector('[data-recovery-request-message]');
    let inviteToken = '';
    let inviteEmail = '';
    let recoveryMode = false;
    let recoveryToken = '';

    const sessionExpiredMessage = document.querySelector('[data-session-expired-message]');
    const sessionReturnMessage = document.querySelector('[data-session-return-message]');
    const loginQuery = new URLSearchParams(window.location.search);
    const loginReason = String(loginQuery.get('reason') || '');
    const requestedReturnTo = safeAdminReturnTo(loginQuery.get('returnTo'));

    const approvedAdminEmails = new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    const roleBadge=document.querySelector('[data-admin-role-badge]');
    const layoutEditButton=document.querySelector('[data-admin-layout-edit]');
    const layoutEditor=document.querySelector('[data-admin-layout-editor]');
    const layoutEditorSections=document.querySelector('[data-admin-layout-editor-sections]');
    const layoutMessage=document.querySelector('[data-admin-layout-message]');
    const layoutScopeHelp=document.querySelector('[data-admin-layout-scope-help]');
    const layoutSaveButton=document.querySelector('[data-admin-layout-save]');
    const layoutScopeButtons=[...(document.querySelectorAll('[data-admin-layout-scope]')||[])];

    const ADMIN_HOME_DEFAULT_LAYOUT={
      sectionOrder:['sales','operations','accounting','content','administration'],
      moduleOrder:{
        sales:['business-crm','sales-crm','email','wedding-profitability','mobile-bar-crm'],
        operations:['event-ops','calendar','vendor-crm','insurance'],
        accounting:['quickbooks'],
        content:['email-preview','seo','blog','gallery'],
        administration:['user-management','system-health','security'],
      },
    };
    const ADMIN_HOME_SECTION_LABELS={
      sales:'Sales',
      operations:'Operations',
      accounting:'Accounting',
      content:'Content',
      administration:'Administration',
    };
    const ADMIN_HOME_MODULE_LABELS={
      'business-crm':'Business CRM',
      'sales-crm':'Sales CRM',
      email:'Email',
      'wedding-profitability':'Wedding Profitability',
      'mobile-bar-crm':'Mobile Bar CRM',
      'event-ops':'Event Ops',
      calendar:'Master Calendar',
      'vendor-crm':'Vendor CRM',
      insurance:'Insurance Compliance',
      quickbooks:'QuickBooks',
      'email-preview':'Email Preview',
      seo:'Local SEO',
      blog:'Blog',
      gallery:'Gallery',
      'user-management':'User Management',
      'system-health':'System Health',
      security:'Security + Spam',
    };
    let savedAdminHomeLayout=structuredClone(ADMIN_HOME_DEFAULT_LAYOUT);
    let personalAdminHomeLayout=null;
    let companyAdminHomeLayout=structuredClone(ADMIN_HOME_DEFAULT_LAYOUT);
    let currentAdminHomeLayoutScope='personal';
    let canManageCompanyAdminHomeLayout=false;

    function safeAdminReturnTo(value) {
      const raw = String(value || '').trim();
      if (!raw) return '';
      try {
        const url = new URL(raw, window.location.origin);
        if (url.origin !== window.location.origin) return '';
        if (!url.pathname.startsWith('/admin/')) return '';
        if (url.pathname === '/admin/' && !url.search && !url.hash) return '';
        return url.pathname + url.search + url.hash;
      } catch {
        return '';
      }
    }

    function showSessionExpiredNotice() {
      const visible = loginReason === 'session_expired' && !inviteToken && !recoveryMode;
      sessionExpiredMessage?.classList.toggle('hidden', !visible);
      if (visible && sessionReturnMessage) {
        sessionReturnMessage.textContent = requestedReturnTo
          ? 'After sign-in, you’ll return to '+requestedReturnTo.split('?')[0]+'.'
          : 'After sign-in, you’ll return to the Koa’s admin workspace.';
      }
    }

    function returnAfterLogin(user) {
      if (!user || !requestedReturnTo) return false;
      window.location.replace(requestedReturnTo);
      return true;
    }

    function canonicalizeAuthUrl() {
      const hostname = String(window.location.hostname || '').toLowerCase();
      if (!hostname.endsWith('.netlify.app')) return false;
      const target = new URL('/admin/', 'https://koasevents.com');
      target.search = window.location.search;
      target.hash = window.location.hash;
      window.location.replace(target.toString());
      return true;
    }

    function emailFromToken(token) {
      try {
        const payload = String(token || '').split('.')[1] || '';
        const normalized = payload.replace(/-/g, '+').replace(/_/g, '/');
        const decoded = JSON.parse(atob(normalized.padEnd(Math.ceil(normalized.length / 4) * 4, '=')));
        return String(decoded?.email || decoded?.user_email || decoded?.sub || '').trim().toLowerCase();
      } catch {
        return '';
      }
    }

    async function repairApprovedAdminInvite(email) {
      const normalized = String(email || '').trim().toLowerCase();
      if (!approvedAdminEmails.has(normalized)) return null;
      const response = await fetch('/api/admin/bootstrap', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({email: normalized}),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Administrator account repair failed.');
      return result;
    }

    function hasAdminAccess(user) {
      const email = String(user?.email || '').trim().toLowerCase();
      const roleSources = [user?.roles, user?.appMetadata?.roles, user?.app_metadata?.roles];
      const roles = roleSources.find(Array.isArray) || [];
      return approvedAdminEmails.has(email) || roles.map((role) => String(role || '').toLowerCase()).includes('admin');
    }

    function roleLabel(role) {
      const labels={
        admin:'Administrator',
        manager:'Manager',
        sales:'Sales Rep',
        event_coordinator:'Event Coordinator',
        vendor_manager:'Vendor Manager',
        content_editor:'Content Editor',
        accounting:'Accounting',
        read_only:'Read Only',
        custom:'Custom Role',
      };
      return labels[role]||String(role||'Staff').replaceAll('_',' ');
    }

    function normalizeOrder(value,allowed) {
      const allowedSet=new Set(allowed);
      const requested=Array.isArray(value)?value.map(String).filter((item)=>allowedSet.has(item)):[];
      return [...new Set([...requested,...allowed])];
    }

    function normalizeAdminHomeLayout(value) {
      const sectionOrder=normalizeOrder(value?.sectionOrder,ADMIN_HOME_DEFAULT_LAYOUT.sectionOrder);
      const moduleOrder={};
      for(const sectionId of ADMIN_HOME_DEFAULT_LAYOUT.sectionOrder){
        moduleOrder[sectionId]=normalizeOrder(
          value?.moduleOrder?.[sectionId],
          ADMIN_HOME_DEFAULT_LAYOUT.moduleOrder[sectionId],
        );
      }
      return {sectionOrder,moduleOrder};
    }

    function applyAdminHomeLayout(value) {
      if(!(links instanceof HTMLElement))return;
      const layout=normalizeAdminHomeLayout(value);
      const signOut=links.querySelector('[data-logout]');
      for(const sectionId of layout.sectionOrder){
        const section=links.querySelector('[data-admin-section][data-section-id="'+sectionId+'"]');
        if(!(section instanceof HTMLElement))continue;
        if(signOut)links.insertBefore(section,signOut);
        else links.appendChild(section);
        const grid=section.querySelector('[data-admin-module-grid]');
        if(!(grid instanceof HTMLElement))continue;
        for(const moduleId of layout.moduleOrder[sectionId]||[]){
          const module=grid.querySelector('[data-admin-module][data-module-id="'+moduleId+'"]');
          if(module)grid.appendChild(module);
        }
      }
    }

    function readAdminHomeLayout() {
      const sectionOrder=[];
      const moduleOrder={};
      links?.querySelectorAll('[data-admin-section]').forEach((section)=>{
        if(!(section instanceof HTMLElement))return;
        const sectionId=String(section.dataset.sectionId||'');
        if(!sectionId)return;
        sectionOrder.push(sectionId);
        moduleOrder[sectionId]=[...section.querySelectorAll('[data-admin-module]')]
          .map((node)=>node instanceof HTMLElement?String(node.dataset.moduleId||''):'')
          .filter(Boolean);
      });
      return normalizeAdminHomeLayout({sectionOrder,moduleOrder});
    }

    function visibleSections() {
      return [...(links?.querySelectorAll('[data-admin-section]')||[])]
        .filter((node)=>node instanceof HTMLElement&&!node.classList.contains('hidden'));
    }

    function visibleModules(section) {
      return [...section.querySelectorAll('[data-admin-module]')]
        .filter((node)=>node instanceof HTMLElement&&!node.classList.contains('hidden'));
    }

    function moveNodeAmongVisible(nodes,node,direction) {
      const index=nodes.indexOf(node);
      const target=nodes[index+direction];
      if(index<0||!target)return false;
      if(direction<0)target.before(node);
      else target.after(node);
      return true;
    }

    function smallMoveButton(label,disabled,onClick) {
      const button=document.createElement('button');
      button.type='button';
      button.textContent=label;
      button.disabled=disabled;
      button.className='rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.54rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)] disabled:cursor-not-allowed disabled:opacity-35';
      button.addEventListener('click',onClick);
      return button;
    }

    function renderLayoutEditor() {
      if(!(layoutEditorSections instanceof HTMLElement))return;
      layoutEditorSections.innerHTML='';
      const sections=visibleSections();
      sections.forEach((section,sectionIndex)=>{
        const sectionId=String(section.dataset.sectionId||'');
        const card=document.createElement('div');
        card.className='rounded-xl border border-[var(--koa-line)] bg-white p-4';

        const head=document.createElement('div');
        head.className='flex flex-wrap items-center justify-between gap-3';
        const title=document.createElement('strong');
        title.className='text-sm font-black uppercase tracking-[.08em] text-[var(--koa-clay)]';
        title.textContent=ADMIN_HOME_SECTION_LABELS[sectionId]||sectionId;
        const sectionControls=document.createElement('div');
        sectionControls.className='flex gap-2';
        sectionControls.append(
          smallMoveButton('↑ Up',sectionIndex===0,()=>{
            if(moveNodeAmongVisible(visibleSections(),section,-1))renderLayoutEditor();
          }),
          smallMoveButton('↓ Down',sectionIndex===sections.length-1,()=>{
            if(moveNodeAmongVisible(visibleSections(),section,1))renderLayoutEditor();
          }),
        );
        head.append(title,sectionControls);
        card.appendChild(head);

        const list=document.createElement('div');
        list.className='mt-3 grid gap-2';
        const modules=visibleModules(section);
        modules.forEach((module,moduleIndex)=>{
          const moduleId=String(module.dataset.moduleId||'');
          const row=document.createElement('div');
          row.className='flex items-center justify-between gap-3 rounded-lg bg-[var(--koa-ivory)] px-3 py-2';
          const label=document.createElement('span');
          label.className='text-sm font-semibold text-[var(--koa-forest)]';
          label.textContent=ADMIN_HOME_MODULE_LABELS[moduleId]||moduleId;
          const controls=document.createElement('div');
          controls.className='flex shrink-0 gap-1.5';
          controls.append(
            smallMoveButton('↑',moduleIndex===0,()=>{
              if(moveNodeAmongVisible(visibleModules(section),module,-1))renderLayoutEditor();
            }),
            smallMoveButton('↓',moduleIndex===modules.length-1,()=>{
              if(moveNodeAmongVisible(visibleModules(section),module,1))renderLayoutEditor();
            }),
          );
          row.append(label,controls);
          list.appendChild(row);
        });
        card.appendChild(list);
        layoutEditorSections.appendChild(card);
      });
    }

    async function loadAdminHomePreferences() {
      try{
        const response=await fetch('/api/account/profile',{cache:'no-store'});
        if(!response.ok)throw new Error('Unable to load Admin Home preferences.');
        const profile=await response.json();
        savedAdminHomeLayout=normalizeAdminHomeLayout(profile?.adminHomeLayout);
      }catch{
        savedAdminHomeLayout=normalizeAdminHomeLayout(ADMIN_HOME_DEFAULT_LAYOUT);
      }
      applyAdminHomeLayout(savedAdminHomeLayout);
    }

    async function saveAdminHomeLayout() {
      const layout=readAdminHomeLayout();
      if(layoutMessage)layoutMessage.textContent='Saving…';
      try{
        const response=await fetch('/api/account/profile',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'save-admin-home-layout',layout}),
        });
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Unable to save Admin Home layout.');
        savedAdminHomeLayout=normalizeAdminHomeLayout(data.adminHomeLayout||layout);
        applyAdminHomeLayout(savedAdminHomeLayout);
        if(layoutMessage)layoutMessage.textContent='Saved for this account.';
        layoutEditor?.classList.add('hidden');
        layoutEditButton?.setAttribute('aria-expanded','false');
      }catch(error){
        if(layoutMessage)layoutMessage.textContent=error instanceof Error?error.message:'Unable to save Admin Home layout.';
      }
    }

    function updateAdminIdentity(session,user) {
      if(!(roleBadge instanceof HTMLElement))return;
      const rawName=String(session?.displayName||session?.email||user?.email||'Staff').trim();
      const shortName=(rawName.includes('@')?rawName.split('@')[0]:rawName.split(/\s+/)[0])||'Staff';
      const role=roleLabel(session?.role||(hasAdminAccess(user)?'admin':'staff'));
      roleBadge.textContent=shortName+' · '+role;
      roleBadge.classList.remove('hidden');
    }

    async function updateHealthWarning(canViewHealth) {
      const warning=document.querySelector('[data-health-warning]');
      if(!warning||!canViewHealth){warning?.classList.add('hidden');return;}
      try{
        const response=await fetch('/api/admin/health',{cache:'no-store'});
        if(!response.ok)return;
        const data=await response.json();const current=data.current;
        const unhealthy=current?.overall==='unhealthy';
        warning.classList.toggle('hidden',!unhealthy);
        if(unhealthy){
          const names=(current.checks||[]).filter((row)=>!row.ok).map((row)=>row.name);
          document.querySelector('[data-health-warning-title]').textContent=current.failed+' health check'+(current.failed===1?'':'s')+' failing';
          document.querySelector('[data-health-warning-detail]').textContent=(names.slice(0,4).join(', ')||'Protected system issue detected')+(names.length>4?' +'+(names.length-4)+' more':'')+' · checked '+new Date(current.checkedAt).toLocaleString();
        }
      }catch{}
    }

    function filterAdminModules(capabilities, showAll=false) {
      const allowedCapabilities=capabilities instanceof Set?capabilities:new Set(capabilities||[]);
      links?.querySelectorAll('[data-admin-module]').forEach((node)=>{
        if(!(node instanceof HTMLElement))return;
        const required=String(node.dataset.capability||'');
        const allowed=showAll||!required||allowedCapabilities.has(required);
        node.classList.toggle('hidden',!allowed);
      });
      links?.querySelectorAll('[data-admin-section]').forEach((section)=>{
        if(!(section instanceof HTMLElement))return;
        const hasVisibleModule=[...section.querySelectorAll('[data-admin-module]')]
          .some((node)=>node instanceof HTMLElement&&!node.classList.contains('hidden'));
        section.classList.toggle('hidden',!hasVisibleModule);
      });
    }

    async function hydrateDashboardAccess(user) {
      const session=await getAdminSession();
      const fallbackAdmin=Boolean(user)&&hasAdminAccess(user);
      const capabilities=new Set(session?.capabilities||session?.permissions||[]);
      const canViewDashboard=Boolean(
        session&&!session.accessBlocked&&capabilities.has('admin.dashboard.view')
      )||(!session&&fallbackAdmin);

      if(canViewDashboard){
        filterAdminModules(capabilities,!session&&fallbackAdmin);
        await loadAdminHomePreferences();
        updateAdminIdentity(session,user);
        layoutEditButton?.classList.remove('hidden');
        layoutEditButton?.setAttribute('aria-expanded','false');
        links?.classList.remove('hidden');
        roleWarning?.classList.add('hidden');
      }else{
        links?.classList.add('hidden');
        roleWarning?.classList.toggle('hidden',!user);
        roleBadge?.classList.add('hidden');
        layoutEditButton?.classList.add('hidden');
        layoutEditor?.classList.add('hidden');
      }

      const canViewHealth=canViewDashboard&&((!session&&fallbackAdmin)||capabilities.has('health.view'));
      updateHealthWarning(canViewHealth);
    }

    function showAuthState(user) {
      loginForm?.classList.toggle('hidden', Boolean(user) || Boolean(inviteToken) || recoveryMode);
      inviteForm?.classList.toggle('hidden', !inviteToken);
      recoveryForm?.classList.toggle('hidden', !recoveryMode);
      if (user || inviteToken || recoveryMode) {
        bootstrapForm?.classList.add('hidden');
        recoveryRequestForm?.classList.add('hidden');
      }

      links?.classList.add('hidden');
      roleWarning?.classList.add('hidden');
      roleBadge?.classList.add('hidden');
      layoutEditButton?.classList.add('hidden');
      layoutEditor?.classList.add('hidden');

      if(!user){
        updateHealthWarning(false);
        return;
      }

      void hydrateDashboardAccess(user);
    }

    async function initialize() {
      if (canonicalizeAuthUrl()) return;
      showSessionExpiredNotice();

      const hashParams = new URLSearchParams(String(window.location.hash || '').replace(/^#/, ''));
      const directRecoveryToken = String(hashParams.get('recovery_token') || '').trim();
      if (directRecoveryToken) {
        recoveryToken = directRecoveryToken;
        recoveryMode = true;
        if (authError) authError.classList.add('hidden');
        showAuthState(null);
        return;
      }

      try {
        const result = await handleAuthCallback();

        if (result?.type === 'invite' && result.token) {
          inviteToken = result.token;
          inviteEmail = emailFromToken(result.token);
          const inviteEmailInput = document.querySelector('[data-invite-email]');
          if (inviteEmailInput && inviteEmail) inviteEmailInput.value = inviteEmail;
          showAuthState(null);
          return;
        }

        if (result?.type === 'recovery') {
          recoveryMode = true;
          showAuthState(result.user || await getUser());
          return;
        }

        const user = await getUser();
        if (returnAfterLogin(user)) return;
        showAuthState(user);
      } catch (err) {
        if (authError) {
          authError.textContent = err instanceof Error ? err.message : 'Unable to process the sign-in link.';
          authError.classList.remove('hidden');
        }
        showAuthState(await getUser());
      }
    }

    inviteForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(inviteForm);
      const submittedEmail = String(data.get('email') || inviteEmail || '').trim().toLowerCase();
      const password = String(data.get('password') || '');
      const confirmPassword = String(data.get('confirmPassword') || '');

      if (password !== confirmPassword) {
        if (inviteError) {
          inviteError.textContent = 'The passwords do not match.';
          inviteError.classList.remove('hidden');
        }
        return;
      }

      try {
        const submitButton = inviteForm.querySelector('button[type="submit"], button:not([type])');
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Creating account…';
        }
        const user = await acceptInvite(inviteToken, password);
        inviteToken = '';
        inviteEmail = '';
        history.replaceState(null, '', '/admin/');
        if (inviteError) inviteError.classList.add('hidden');
        showAuthState(user);
      } catch (err) {
        const raw = err instanceof Error ? err.message : '';
        const status = Number(err?.status || err?.cause?.status || 0);
        const staleInvite = status === 404 || /user not found|expired|invalid.*token|invite/i.test(raw);
        const approvedEmail = approvedAdminEmails.has(submittedEmail)
          ? submittedEmail
          : (approvedAdminEmails.has(inviteEmail) ? inviteEmail : '');
        if (staleInvite && approvedEmail) {
          try {
            await repairApprovedAdminInvite(approvedEmail);
            inviteToken = '';
            history.replaceState(null, '', '/admin/');
            if (inviteError) {
              inviteError.textContent = 'This invitation link was stale. The approved administrator account has been repaired and a new secure password-setup email was sent to ' + approvedEmail + '. Use the newest email link.';
              inviteError.classList.remove('hidden');
            }
            return;
          } catch (repairError) {
            if (inviteError) {
              inviteError.textContent = repairError instanceof Error ? repairError.message : 'Unable to repair this administrator invitation.';
              inviteError.classList.remove('hidden');
            }
            return;
          }
        }
        if (inviteError) {
          if (staleInvite && !approvedEmail) {
            inviteError.textContent = 'This invitation is stale. Enter one of the approved administrator emails above (chris@sibel.org or koasadmin@koasevents.com), then press Create account again. Koa’s will repair the account and send a fresh secure password-reset link.';
          } else {
            inviteError.textContent = raw || 'Unable to accept the invitation.';
          }
          inviteError.classList.remove('hidden');
        }
      } finally {
        const submitButton = inviteForm.querySelector('button[type="submit"], button:not([type])');
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Create account';
        }
      }
    });

    layoutEditButton?.addEventListener('click',()=>{
      if(!(layoutEditor instanceof HTMLElement))return;
      const opening=layoutEditor.classList.contains('hidden');
      if(opening){
        renderLayoutEditor();
        if(layoutMessage)layoutMessage.textContent='';
      }
      layoutEditor.classList.toggle('hidden',!opening);
      layoutEditButton.setAttribute('aria-expanded',opening?'true':'false');
    });

    document.querySelector('[data-admin-layout-save]')?.addEventListener('click',()=>{void saveAdminHomeLayout();});
    document.querySelector('[data-admin-layout-reset]')?.addEventListener('click',()=>{
      applyAdminHomeLayout(ADMIN_HOME_DEFAULT_LAYOUT);
      renderLayoutEditor();
      if(layoutMessage)layoutMessage.textContent='Default order loaded. Press Save layout to keep it.';
    });
    document.querySelector('[data-admin-layout-cancel]')?.addEventListener('click',()=>{
      applyAdminHomeLayout(savedAdminHomeLayout);
      layoutEditor?.classList.add('hidden');
      layoutEditButton?.setAttribute('aria-expanded','false');
      if(layoutMessage)layoutMessage.textContent='';
    });

    document.querySelector('[data-toggle-login-password]')?.addEventListener('click',()=>{
      const input=document.querySelector('[data-login-password]');
      const button=document.querySelector('[data-toggle-login-password]');
      if(!input||!button)return;
      const showing=input.type==='text';
      input.type=showing?'password':'text';
      button.textContent=showing?'Show':'Hide';
    });

    document.querySelector('[data-show-recovery-request]')?.addEventListener('click',()=>{
      loginForm?.classList.add('hidden');
      bootstrapForm?.classList.add('hidden');
      recoveryRequestForm?.classList.remove('hidden');
      recoveryRequestMessage.textContent='';
    });
    document.querySelector('[data-hide-recovery-request]')?.addEventListener('click',()=>{
      recoveryRequestForm?.classList.add('hidden');
      loginForm?.classList.remove('hidden');
    });
    recoveryRequestForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const data=new FormData(recoveryRequestForm);
      const email=String(data.get('email')||'').trim().toLowerCase();
      recoveryRequestMessage.textContent='Sending reset link…';
      try{
        await requestPasswordRecovery(email);
        recoveryRequestMessage.textContent='If an account exists for that email, a secure password reset link has been sent.';
      }catch(err){
        recoveryRequestMessage.textContent=err instanceof Error?err.message:'Unable to send the password reset link.';
      }
    });

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(loginForm);
      const email = String(data.get('email') || '').trim().toLowerCase();
      try {
        const user = await login(email, String(data.get('password')));
        await fetch('/api/auth/record',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'success',email})}).catch(()=>null);
        if (authError) authError.classList.add('hidden');
        if (returnAfterLogin(user)) return;
        showAuthState(user);
      } catch (err) {
        await fetch('/api/auth/record',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'failure',email})}).catch(()=>null);
        if (authError) {
          const status = Number(err?.status || err?.cause?.status || 0);
          const raw = err instanceof Error ? err.message : '';
          if (status === 404 || /user not found/i.test(raw)) {
            authError.textContent = 'No account exists for that email. If this should be a Koa’s administrator, use “Create or repair an approved admin account” below.';
          } else if (status === 401 || /invalid|credentials|password/i.test(raw)) {
            authError.textContent = 'That account exists, but the email/password combination is incorrect.';
          } else if (status === 403) {
            authError.textContent = 'This account cannot sign in here. An administrator may need to enable or repair its access.';
          } else {
            authError.textContent = raw || 'Unable to sign in.';
          }
          authError.classList.remove('hidden');
        }
      }
    });

    document.querySelector('[data-show-bootstrap]')?.addEventListener('click', () => {
      loginForm?.classList.add('hidden');
      bootstrapForm?.classList.remove('hidden');
      if (bootstrapMessage) bootstrapMessage.textContent = '';
    });

    document.querySelector('[data-hide-bootstrap]')?.addEventListener('click', () => {
      bootstrapForm?.classList.add('hidden');
      loginForm?.classList.remove('hidden');
    });

    bootstrapForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(bootstrapForm);
      if (bootstrapMessage) bootstrapMessage.textContent = 'Preparing administrator account…';
      try {
        const response = await fetch('/api/admin/bootstrap', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({email: String(data.get('email') || '')}),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Administrator setup failed.');
        if (bootstrapMessage) bootstrapMessage.textContent = result.message || 'Check your email for the password setup link.';
      } catch (err) {
        if (bootstrapMessage) bootstrapMessage.textContent = err instanceof Error ? err.message : 'Administrator setup failed.';
      }
    });

    recoveryForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(recoveryForm);
      const password = String(data.get('password') || '');
      const confirmPassword = String(data.get('confirmPassword') || '');
      if (password !== confirmPassword) {
        if (recoveryError) {
          recoveryError.textContent = 'The passwords do not match.';
          recoveryError.classList.remove('hidden');
        }
        return;
      }
      try {
        let user = null;
        if (recoveryToken) {
          const recoveredUser = await recoverPassword(recoveryToken, password);
          const email = String(recoveredUser?.email || '').trim().toLowerCase();
          if (!email) throw new Error('Password updated, but the administrator session could not be established. Sign in with the new password.');
          user = await login(email, password);
        } else {
          await updateUser({ password });
          const currentUser = await getUser();
          const email = String(currentUser?.email || '').trim().toLowerCase();
          user = email ? await login(email, password) : currentUser;
        }
        recoveryToken = '';
        recoveryMode = false;
        history.replaceState(null, '', '/admin/');
        if (recoveryError) recoveryError.classList.add('hidden');
        showAuthState(user || await getUser());
        window.location.assign('/admin/');
      } catch (err) {
        if (recoveryError) {
          recoveryError.textContent = err instanceof Error ? err.message : 'Unable to update the password.';
          recoveryError.classList.remove('hidden');
        }
      }
    });

    async function signOut() {
      await logout();
      showAuthState(null);
    }

    document.querySelector('[data-logout]')?.addEventListener('click', signOut);
    document.querySelector('[data-logout-warning]')?.addEventListener('click', signOut);

    initialize();
  </script>
</BaseLayout>
