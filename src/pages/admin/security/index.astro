---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Security & Spam" description="Review Koa’s Events inquiry security, spam screening, and blocked attempts." canonical="https://www.koasevents.com/admin/security/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-10">
    <div class="container-shell">
      <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Admin · Security</p>
          <h1 class="display mt-3 text-5xl">Security + Spam</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Monitor Turnstile failures, rate limiting, suspicious inquiries, repeated-message patterns, and legitimate inquiry volume. Network identifiers are one-way fingerprints rather than stored IP addresses.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <label class="flex items-center gap-2 rounded-full border border-[var(--koa-line)] bg-white px-4 py-2.5 text-xs font-bold text-[var(--koa-forest)]">
            Range
            <select data-range class="bg-transparent font-black outline-none">
              <option value="1">24 hours</option>
              <option value="7">7 days</option>
              <option value="30" selected>30 days</option>
              <option value="90">90 days</option>
            </select>
          </label>
          <a href="/admin/quotes/" class="rounded-full border border-[var(--koa-line)] bg-white px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Sales CRM</a>
          <a href="/admin/" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Admin home</a>
        </div>
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8 shadow-[var(--shadow-soft)]">Sign in with an administrator account at <a class="underline" href="/admin/">Koa’s Admin</a>.</div>

      <div data-app class="hidden grid gap-6">
        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
          <article class="rounded-[1.35rem] bg-[var(--koa-forest)] p-5 text-white shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-amber-light)]">Accepted</p>
            <p data-accepted class="display mt-3 text-4xl">0</p>
            <p class="mt-2 text-xs text-white/60">Clean + flagged inquiries allowed into CRM.</p>
          </article>
          <article class="rounded-[1.35rem] bg-white p-5 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Blocked</p>
            <p data-blocked class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p>
            <p class="mt-2 text-xs text-[var(--koa-ink)]/50">Turnstile, rate-limit, honeypot, or risk-screen blocks.</p>
          </article>
          <article class="rounded-[1.35rem] bg-white p-5 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Flagged</p>
            <p data-flagged class="display mt-3 text-4xl text-[var(--koa-forest)]">0</p>
            <p class="mt-2 text-xs text-[var(--koa-ink)]/50">Accepted inquiries requiring review.</p>
          </article>
          <article class="rounded-[1.35rem] bg-white p-5 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Block rate</p>
            <p data-block-rate class="display mt-3 text-4xl text-[var(--koa-forest)]">0%</p>
            <p class="mt-2 text-xs text-[var(--koa-ink)]/50">Share of recorded security decisions blocked.</p>
          </article>
          <article class="rounded-[1.35rem] bg-white p-5 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Flag rate</p>
            <p data-flag-rate class="display mt-3 text-4xl text-[var(--koa-forest)]">0%</p>
            <p class="mt-2 text-xs text-[var(--koa-ink)]/50">Share of accepted inquiries marked for review.</p>
          </article>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Cloudflare Turnstile</p>
              <h2 class="display mt-2 text-3xl">Siteverify status</h2>
              <p class="mt-2 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/48">Shows whether the public widget key and server secret are configured, plus real server-side Siteverify successes, failures, and Cloudflare error codes.</p>
            </div>
            <span data-turnstile-overall class="rounded-full bg-[var(--koa-sand)] px-4 py-2 text-xs font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">Loading…</span>
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
            <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Site key</p><p data-turnstile-sitekey class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Server secret</p><p data-turnstile-secret class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Last success</p><p data-turnstile-success class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">—</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Failed validations</p><p data-turnstile-failures class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">0</p></article>
            <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Successful validations</p><p data-turnstile-successes class="mt-2 text-sm font-semibold text-[var(--koa-forest)]">0</p></article>
          </div>
          <div class="mt-5">
            <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Cloudflare / validation error codes</p>
            <div data-turnstile-errors class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-3"></div>
          </div>
        </section>

        <section class="grid gap-6 xl:grid-cols-[1.15fr_.85fr]">
          <article class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div><p class="eyebrow text-[var(--koa-clay)]">Volume</p><h2 class="display mt-2 text-3xl">Daily security decisions</h2></div>
              <p data-generated class="text-xs text-[var(--koa-ink)]/45"></p>
            </div>
            <div class="mt-5 overflow-x-auto">
              <table class="w-full min-w-[620px] text-left text-sm">
                <thead class="border-b border-[var(--koa-line)] text-[.62rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">
                  <tr><th class="py-3 pr-4">Date</th><th class="py-3 pr-4">Accepted</th><th class="py-3 pr-4">Flagged</th><th class="py-3 pr-4">Blocked</th><th class="py-3">Total</th></tr>
                </thead>
                <tbody data-daily></tbody>
              </table>
            </div>
          </article>

          <div class="grid gap-6">
            <article class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
              <p class="eyebrow text-[var(--koa-clay)]">Signals</p>
              <h2 class="display mt-2 text-3xl">Top reasons</h2>
              <div data-reasons class="mt-5 grid gap-2"></div>
            </article>
            <article class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
              <p class="eyebrow text-[var(--koa-clay)]">Sources</p>
              <h2 class="display mt-2 text-3xl">Repeated networks</h2>
              <p class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/45">Fingerprints are irreversible short hashes; raw IP addresses are not displayed or retained here.</p>
              <div data-sources class="mt-5 grid gap-2"></div>
            </article>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Review queue</p>
              <h2 class="display mt-2 text-3xl">Blocked + flagged attempts</h2>
            </div>
            <p data-status class="text-xs text-[var(--koa-ink)]/45">Loading…</p>
          </div>

          <div class="mt-5 overflow-x-auto">
            <table class="w-full min-w-[980px] text-left text-sm">
              <thead class="border-b border-[var(--koa-line)] text-[.62rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">
                <tr>
                  <th class="py-3 pr-4">When</th>
                  <th class="py-3 pr-4">Decision</th>
                  <th class="py-3 pr-4">Risk</th>
                  <th class="py-3 pr-4">Contact</th>
                  <th class="py-3 pr-4">Network</th>
                  <th class="py-3 pr-4">Reason</th>
                  <th class="py-3 pr-4">CRM</th>
                  <th class="py-3">Admin action</th>
                </tr>
              </thead>
              <tbody data-incidents></tbody>
            </table>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Blocklist</p>
            <h2 class="display mt-2 text-3xl">Active + recent blocks</h2>
            <p class="mt-2 max-w-3xl text-xs leading-5 text-[var(--koa-ink)]/45">Manual email/domain blocks and automatic email/network escalation appear here. Expired entries remain visible for audit history and can be removed.</p>
          </div>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full min-w-[820px] text-left text-sm">
              <thead class="border-b border-[var(--koa-line)] text-[.62rem] font-black uppercase tracking-[.1em] text-[var(--koa-ink)]/45">
                <tr><th class="py-3 pr-4">Target</th><th class="py-3 pr-4">Label</th><th class="py-3 pr-4">Source</th><th class="py-3 pr-4">Status</th><th class="py-3 pr-4">Reason</th><th class="py-3">Action</th></tr>
              </thead>
              <tbody data-blocklist></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const approvedAdminEmails = new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    const app = document.querySelector('[data-app]');
    const unauthorized = document.querySelector('[data-unauthorized]');
    const range = document.querySelector('[data-range]');
    const status = document.querySelector('[data-status]');

    function hasAdminAccess(user) {
      const email = String(user?.email || '').trim().toLowerCase();
      const roles = user?.app_metadata?.roles || [];
      return approvedAdminEmails.has(email) || (Array.isArray(roles) && roles.includes('admin'));
    }

    function setText(selector, value) {
      const element = document.querySelector(selector);
      if (element) element.textContent = String(value);
    }

    function label(value) {
      return String(value || '')
        .replace(/_/g, ' ')
        .replace(/\b\w/g, (char) => char.toUpperCase());
    }

    function badge(disposition) {
      const span = document.createElement('span');
      span.className = disposition === 'blocked'
        ? 'inline-flex rounded-full bg-red-50 px-2.5 py-1 text-[.62rem] font-black uppercase tracking-[.08em] text-red-700'
        : 'inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-[.62rem] font-black uppercase tracking-[.08em] text-amber-800';
      span.textContent = disposition;
      return span;
    }

    function emptyRow(message, colspan) {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = colspan;
      td.className = 'py-8 text-center text-sm text-[var(--koa-ink)]/45';
      td.textContent = message;
      tr.appendChild(td);
      return tr;
    }

    function renderTurnstile(turnstile) {
      const siteKey=Boolean(turnstile?.siteKeyConfigured);
      const secret=Boolean(turnstile?.secretConfigured);
      const lastSuccess=turnstile?.lastSuccess;
      const failures=Number(turnstile?.totals?.failed||0);
      const successes=Number(turnstile?.totals?.successful||0);
      const overall=document.querySelector('[data-turnstile-overall]');
      const configured=siteKey&&secret;
      const healthy=configured&&Boolean(lastSuccess);
      if(overall){
        overall.textContent=healthy?'Verified':configured?'Configured · awaiting success':'Configuration needed';
        overall.className='rounded-full px-4 py-2 text-xs font-black uppercase tracking-[.08em] '+(healthy?'bg-emerald-100 text-emerald-800':configured?'bg-amber-100 text-amber-800':'bg-red-100 text-red-800');
      }
      setText('[data-turnstile-sitekey]',siteKey?'Configured':'Missing');
      setText('[data-turnstile-secret]',secret?'Configured':'Missing');
      setText('[data-turnstile-success]',lastSuccess?.createdAt?new Date(lastSuccess.createdAt).toLocaleString():'No successful validation recorded');
      setText('[data-turnstile-failures]',failures);
      setText('[data-turnstile-successes]',successes);
      const errors=document.querySelector('[data-turnstile-errors]');
      errors.innerHTML='';
      (turnstile?.errorCodes||[]).forEach((row)=>{
        const card=document.createElement('div');
        card.className='rounded-xl border border-red-100 bg-red-50 p-3';
        card.innerHTML='<div class="flex items-center justify-between gap-3"><code class="text-xs font-semibold text-red-900"></code><strong class="text-sm text-red-900"></strong></div><p class="mt-1 text-[.68rem] text-red-900/55"></p>';
        card.querySelector('code').textContent=row.code;
        card.querySelector('strong').textContent=String(row.count);
        card.querySelector('p').textContent=row.lastSeenAt?'Last seen '+new Date(row.lastSeenAt).toLocaleString():'';
        errors.appendChild(card);
      });
      if(!(turnstile?.errorCodes||[]).length)errors.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No Turnstile validation error codes in this range.</p>';
    }

    function renderDaily(rows) {
      const body = document.querySelector('[data-daily]');
      if (!body) return;
      body.replaceChildren();
      const visible = (rows || []).slice(-14).reverse();
      if (!visible.length) {
        body.appendChild(emptyRow('No security activity in this range.', 5));
        return;
      }
      visible.forEach((row) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-[var(--koa-line)]/70';
        [row.date, row.accepted, row.flagged, row.blocked, row.accepted + row.blocked].forEach((value, index) => {
          const td = document.createElement('td');
          td.className = 'py-3 pr-4 ' + (index === 0 ? 'font-semibold' : '');
          td.textContent = String(value);
          tr.appendChild(td);
        });
        body.appendChild(tr);
      });
    }

    function renderReasons(rows) {
      const box = document.querySelector('[data-reasons]');
      if (!box) return;
      box.replaceChildren();
      if (!(rows || []).length) {
        const p = document.createElement('p');
        p.className = 'text-sm text-[var(--koa-ink)]/45';
        p.textContent = 'No suspicious signals recorded.';
        box.appendChild(p);
        return;
      }
      rows.slice(0, 10).forEach((row) => {
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between gap-3 rounded-xl bg-[var(--koa-sand)] px-4 py-3';
        const name = document.createElement('span');
        name.className = 'text-sm font-semibold';
        name.textContent = label(row.label);
        const count = document.createElement('span');
        count.className = 'rounded-full bg-white px-2.5 py-1 text-xs font-black text-[var(--koa-forest)]';
        count.textContent = String(row.count);
        div.append(name, count);
        box.appendChild(div);
      });
    }

    function renderSources(rows) {
      const box = document.querySelector('[data-sources]');
      if (!box) return;
      box.replaceChildren();
      if (!(rows || []).length) {
        const p = document.createElement('p');
        p.className = 'text-sm text-[var(--koa-ink)]/45';
        p.textContent = 'No repeated network activity in this range.';
        box.appendChild(p);
        return;
      }
      rows.forEach((row) => {
        const div = document.createElement('div');
        div.className = 'grid grid-cols-[1fr_auto] gap-3 rounded-xl bg-[var(--koa-sand)] px-4 py-3';
        const left = document.createElement('div');
        const title = document.createElement('p');
        title.className = 'font-mono text-xs font-bold text-[var(--koa-forest)]';
        title.textContent = row.fingerprint;
        const meta = document.createElement('p');
        meta.className = 'mt-1 text-xs text-[var(--koa-ink)]/48';
        meta.textContent = row.count + ' attempts · ' + row.blocked + ' blocked · ' + row.flagged + ' flagged';
        left.append(title, meta);
        const count = document.createElement('span');
        count.className = 'self-center rounded-full bg-white px-2.5 py-1 text-xs font-black';
        count.textContent = String(row.count);
        div.append(left, count);
        box.appendChild(div);
      });
    }

    function smallButton(labelText, handler, tone = 'default') {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = tone === 'danger'
        ? 'rounded-full border border-red-200 bg-red-50 px-2.5 py-1.5 text-[.55rem] font-black uppercase tracking-[.07em] text-red-700'
        : tone === 'good'
          ? 'rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1.5 text-[.55rem] font-black uppercase tracking-[.07em] text-emerald-800'
          : 'rounded-full border border-[var(--koa-line)] bg-white px-2.5 py-1.5 text-[.55rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]';
      button.textContent = labelText;
      button.addEventListener('click', handler);
      return button;
    }

    async function securityAction(body) {
      const response = await fetch('/api/admin/security', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Security action failed.');
      return result;
    }

    async function reviewIncident(row, verdict) {
      if (verdict === 'confirmed_spam' && !confirm('Mark this incident as confirmed spam? This will count toward automatic escalation.')) return;
      try {
        if (status) status.textContent = 'Saving review…';
        await securityAction({ action: 'review', incidentId: row.id, verdict });
        await load();
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : 'Unable to save review.';
      }
    }

    async function blockIncident(row, target) {
      const targetLabel = target === 'email' ? row.emailPreview : row.emailDomain;
      if (!targetLabel) return;
      const duration = prompt('Block ' + targetLabel + ' for 24h, 7d, or permanent?', '24h');
      if (!duration || !['24h','7d','permanent'].includes(duration)) return;
      if (!confirm('Block ' + targetLabel + ' for ' + duration + '?')) return;
      try {
        if (status) status.textContent = 'Creating block…';
        await securityAction({ action: 'block', incidentId: row.id, target, duration });
        await load();
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : 'Unable to create block.';
      }
    }

    function renderIncidents(rows) {
      const body = document.querySelector('[data-incidents]');
      if (!body) return;
      body.replaceChildren();
      if (!(rows || []).length) {
        body.appendChild(emptyRow('No blocked or flagged attempts in this range.', 8));
        return;
      }

      rows.forEach((row) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-[var(--koa-line)]/70 align-top';

        const when = document.createElement('td');
        when.className = 'py-4 pr-4 whitespace-nowrap text-xs';
        when.textContent = new Date(row.createdAt).toLocaleString();

        const decision = document.createElement('td');
        decision.className = 'py-4 pr-4';
        decision.appendChild(badge(row.disposition));
        if (row.review?.verdict) {
          const review = document.createElement('p');
          review.className = 'mt-2 text-[.58rem] font-black uppercase tracking-[.06em] ' + (row.review.verdict === 'not_spam' ? 'text-emerald-700' : 'text-red-700');
          review.textContent = row.review.verdict === 'not_spam' ? 'Marked not spam' : 'Confirmed spam';
          decision.appendChild(review);
        }

        const risk = document.createElement('td');
        risk.className = 'py-4 pr-4 font-black text-[var(--koa-forest)]';
        risk.textContent = String(row.riskScore);

        const contact = document.createElement('td');
        contact.className = 'py-4 pr-4 text-xs leading-5';
        contact.textContent = [row.emailPreview, row.phonePreview].filter(Boolean).join(' · ') || '—';

        const source = document.createElement('td');
        source.className = 'py-4 pr-4 font-mono text-xs';
        source.textContent = row.sourceFingerprint || '—';

        const reason = document.createElement('td');
        reason.className = 'max-w-md py-4 pr-4 text-xs leading-5';
        reason.textContent = (row.reasons || []).join(' · ') || label(row.category);

        const crm = document.createElement('td');
        crm.className = 'py-4 pr-4 text-xs';
        if (row.recordId) {
          const link = document.createElement('a');
          link.href = '/admin/quotes/?q=' + encodeURIComponent(row.recordId);
          link.className = 'font-black text-[var(--koa-clay)] underline';
          link.textContent = row.recordId;
          crm.appendChild(link);
        } else {
          crm.textContent = 'Blocked before CRM';
        }

        const actions = document.createElement('td');
        actions.className = 'py-4';
        const actionBox = document.createElement('div');
        actionBox.className = 'flex min-w-[220px] flex-wrap gap-2';
        actionBox.append(
          smallButton('Not spam', () => reviewIncident(row, 'not_spam'), 'good'),
          smallButton('Confirmed spam', () => reviewIncident(row, 'confirmed_spam'), 'danger')
        );
        if (row.emailFingerprint) actionBox.appendChild(smallButton('Block email', () => blockIncident(row, 'email')));
        if (row.emailDomain) actionBox.appendChild(smallButton('Block domain', () => blockIncident(row, 'domain'), 'danger'));
        actions.appendChild(actionBox);

        tr.append(when, decision, risk, contact, source, reason, crm, actions);
        body.appendChild(tr);
      });
    }

    function renderBlocklist(rows) {
      const body = document.querySelector('[data-blocklist]');
      if (!body) return;
      body.replaceChildren();
      if (!(rows || []).length) {
        body.appendChild(emptyRow('No blocklist entries yet.', 6));
        return;
      }

      rows.forEach((row) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-[var(--koa-line)]/70 align-top';

        const target = document.createElement('td');
        target.className = 'py-4 pr-4 text-xs font-black uppercase tracking-[.06em]';
        target.textContent = row.target;

        const labelCell = document.createElement('td');
        labelCell.className = 'py-4 pr-4 text-xs';
        labelCell.textContent = row.label || '—';

        const sourceCell = document.createElement('td');
        sourceCell.className = 'py-4 pr-4 text-xs';
        sourceCell.textContent = row.source;

        const state = document.createElement('td');
        state.className = 'py-4 pr-4 text-xs';
        state.textContent = row.active
          ? row.permanent ? 'Permanent' : 'Until ' + new Date(row.expiresAt).toLocaleString()
          : 'Expired';

        const reason = document.createElement('td');
        reason.className = 'max-w-lg py-4 pr-4 text-xs leading-5';
        reason.textContent = row.reason || '—';

        const action = document.createElement('td');
        action.className = 'py-4';
        if (row.active) {
          action.appendChild(smallButton('Unblock', async () => {
            if (!confirm('Remove this block?')) return;
            try {
              if (status) status.textContent = 'Removing block…';
              await securityAction({ action: 'unblock', blockId: row.id });
              await load();
            } catch (error) {
              if (status) status.textContent = error instanceof Error ? error.message : 'Unable to remove block.';
            }
          }, 'good'));
        } else {
          action.textContent = '—';
        }

        tr.append(target, labelCell, sourceCell, state, reason, action);
        body.appendChild(tr);
      });
    }

    async function load() {
      if (status) status.textContent = 'Loading…';
      const days = String(range?.value || '30');
      const response = await fetch('/api/admin/security?days=' + encodeURIComponent(days), { cache: 'no-store' });
      if (response.status === 401) {
        app?.classList.add('hidden');
        unauthorized?.classList.remove('hidden');
        return;
      }
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        if (status) status.textContent = payload.error || 'Unable to load security data.';
        return;
      }

      const totals = payload.totals || {};
      setText('[data-accepted]', totals.accepted || 0);
      setText('[data-blocked]', totals.blocked || 0);
      setText('[data-flagged]', totals.flagged || 0);
      setText('[data-block-rate]', (totals.blockRate || 0) + '%');
      setText('[data-flag-rate]', (totals.flagRate || 0) + '%');
      setText('[data-generated]', 'Updated ' + new Date(payload.generatedAt).toLocaleString());
      if (status) status.textContent = (payload.recent || []).length + ' incidents shown';

      renderTurnstile(payload.turnstile || {});
      renderDaily(payload.daily || []);
      renderReasons(payload.topReasons || []);
      renderSources(payload.topSources || []);
      renderIncidents(payload.recent || []);
      renderBlocklist(payload.blocklist || []);
    }

    async function initialize() {
      const user = await getAdminSession();
      if (!hasAdminAccess(user)) {
        unauthorized?.classList.remove('hidden');
        return;
      }
      app?.classList.remove('hidden');
      await load();
    }

    range?.addEventListener('change', load);
    initialize();
  </script>
</BaseLayout>
