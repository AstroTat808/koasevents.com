---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Event Ops" description="Manage booked-event production, documents, vendors, timelines and event-day tasks." canonical="https://www.koasevents.com/admin/events/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-10">
    <div class="container-shell">
      <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Staff Workspace · Operations</p>
          <h1 class="display mt-3 text-5xl">Event Ops</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Turn booked events into production plans: documents, vendors, questionnaires, layouts, run-of-show, readiness, final guest count and event-day assignments.</p>
        </div>
      </div>

      <div data-unauthorized class="hidden rounded-[1.4rem] bg-white p-8">Sign in with an authorized staff account at <a class="underline" href="/staff/">Koa’s Staff Workspace</a>.</div>

      <div data-app class="hidden grid gap-6 xl:grid-cols-[340px_1fr]">
        <aside class="rounded-[1.5rem] bg-[var(--koa-ink)] p-5 text-white shadow-[var(--shadow-soft)] xl:sticky xl:top-5 xl:self-start">
          <div class="flex items-end justify-between gap-3">
            <div><p class="eyebrow text-[var(--koa-amber-light)]">Booked events</p><h2 class="display mt-2 text-3xl">Production queue</h2></div>
            <span data-event-count class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-white/70">0</span>
          </div>
          <form data-search-form class="mt-5">
            <input data-search type="search" placeholder="Search client or date…" class="w-full rounded-full border border-white/10 bg-white/[.08] px-4 py-3 text-sm text-white placeholder:text-white/38" />
          </form>
          <div data-event-list class="mt-5 grid max-h-[70vh] gap-2 overflow-y-auto pr-1"></div>
        </aside>

        <section data-empty class="rounded-[1.5rem] bg-white p-8 shadow-[var(--shadow-soft)]">
          <p class="eyebrow text-[var(--koa-clay)]">Event production</p>
          <h2 class="display mt-3 text-4xl">Choose a booked event.</h2>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-[var(--koa-ink)]/58">Each booked event gets its own operational workspace, separate from QuickBooks and the sales record.</p>
        </section>

        <section data-detail class="hidden grid gap-6">
          <header class="rounded-[1.6rem] bg-[var(--koa-forest)] p-7 text-white shadow-[var(--shadow-soft)]">
            <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <p class="eyebrow text-[var(--koa-amber-light)]">Booked event</p>
                <h2 data-title class="display mt-3 text-5xl"></h2>
                <p data-meta class="mt-3 text-sm text-white/65"></p>
              </div>
              <div class="flex flex-wrap gap-2">
                <span data-readiness class="rounded-full border border-white/15 bg-white/[.07] px-4 py-2 text-[.6rem] font-black uppercase tracking-[.1em]"></span>
                <a data-crm-link class="rounded-full bg-white px-4 py-2 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]" href="/admin/quotes/">Open CRM</a>
              </div>
            </div>
          </header>

          <nav data-tabs class="flex gap-2 overflow-x-auto rounded-[1.2rem] bg-white p-2 shadow-[var(--shadow-soft)]">
            <button data-tab="overview" class="tab-button">Overview</button>
            <button data-tab="documents" class="tab-button">Documents</button>
            <button data-tab="vendors" class="tab-button">Vendors</button>
            <button data-tab="vendor-ops" class="tab-button">Vendor Ops</button>
            <button data-tab="questionnaire" class="tab-button">Questionnaire</button>
            <button data-tab="timeline" class="tab-button">Run of show</button>
            <button data-tab="checklist" class="tab-button">Checklist</button>
            <button data-tab="tasks" class="tab-button">Event day</button>
          </nav>

          <div data-panel="overview" class="panel rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="grid gap-5 lg:grid-cols-3">
              <form data-overview-form class="grid gap-4 lg:col-span-2">
                <div class="grid gap-4 sm:grid-cols-2">
                  <label class="grid gap-2 text-sm font-semibold">Planning status
                    <select name="status" class="rounded-xl border border-[var(--koa-line)] px-4 py-3">
                      <option value="planning">Planning</option><option value="ready">Ready</option><option value="event_day">Event day</option><option value="complete">Complete</option>
                    </select>
                  </label>
                  <label class="grid gap-2 text-sm font-semibold">Final guest count
                    <input name="finalGuestCount" type="number" min="0" max="1000" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
                  </label>
                </div>
                <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                  <label class="grid gap-2 text-sm font-semibold">Venue / area
                    <input name="venueArea" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="Koa’s Events" />
                  </label>
                  <label class="grid gap-2 text-sm font-semibold">Setup start
                    <input name="setupStart" type="time" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
                  </label>
                  <label class="grid gap-2 text-sm font-semibold">Guest arrival
                    <input name="guestArrival" type="time" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
                  </label>
                  <label class="grid gap-2 text-sm font-semibold">Event start
                    <input name="eventStart" type="time" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
                  </label>
                  <label class="grid gap-2 text-sm font-semibold">Event end
                    <input name="eventEnd" type="time" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
                  </label>
                  <label class="grid gap-2 text-sm font-semibold">Teardown complete
                    <input name="teardownEnd" type="time" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" />
                  </label>
                </div>
                <label class="grid gap-2 text-sm font-semibold">Operations notes
                  <textarea name="notes" rows="8" class="rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="Parking, access, rentals, VIP details, special handling, open decisions…"></textarea>
                </label>
                <div class="flex flex-wrap gap-3">
                  <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save overview</button>
                  <span data-save-message class="self-center text-xs text-[var(--koa-ink)]/50"></span>
                </div>
              </form>

              <div class="grid gap-3">
                <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="eyebrow text-[var(--koa-clay)]">Guest count</p><p data-summary-guests class="display mt-2 text-3xl text-[var(--koa-forest)]">0</p></article>
                <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="eyebrow text-[var(--koa-clay)]">Checklist</p><p data-summary-checklist class="display mt-2 text-3xl text-[var(--koa-forest)]">0%</p></article>
                <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="eyebrow text-[var(--koa-clay)]">Vendor insurance</p><p data-summary-insurance class="display mt-2 text-3xl text-[var(--koa-forest)]">0/0</p></article>
                <article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="eyebrow text-[var(--koa-clay)]">Documents</p><p data-summary-documents class="display mt-2 text-3xl text-[var(--koa-forest)]">0</p></article><article class="rounded-xl bg-[var(--koa-sand)] p-4"><p class="eyebrow text-[var(--koa-clay)]">Google review request</p><p data-summary-review class="display mt-2 text-2xl text-[var(--koa-forest)]">Not sent</p></article>
              </div>
            </div>
          </div>

          <div data-panel="documents" class="panel hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
              <div><p class="eyebrow text-[var(--koa-clay)]">Files</p><h3 class="display mt-2 text-4xl">Insurance, floor plans + event documents</h3></div>
              <p class="max-w-md text-xs leading-5 text-[var(--koa-ink)]/45">PDF, JPG, PNG, WEBP, DOCX and XLSX; up to 20 MB each.</p>
            </div>
            <form data-upload-form class="mt-6 grid gap-3 rounded-xl bg-[var(--koa-sand)] p-4 lg:grid-cols-[1fr_11rem_1fr_auto] lg:items-end">
              <label class="grid gap-2 text-xs font-semibold">File<input name="file" type="file" required class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2" /></label>
              <label class="grid gap-2 text-xs font-semibold">Category<select name="category" class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"><option value="insurance">Insurance</option><option value="floor_plan">Floor plan</option><option value="vendor">Vendor</option><option value="questionnaire">Questionnaire</option><option value="other">Other</option></select></label>
              <label class="grid gap-2 text-xs font-semibold">Label<input name="label" class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2" placeholder="Certificate of insurance, final floor plan…" /></label>
              <button class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Upload</button>
            </form>
            <p data-upload-message class="mt-3 text-xs text-[var(--koa-ink)]/52"></p>
            <div data-documents class="mt-5 grid gap-3"></div>
          </div>

          <div data-panel="vendors" class="panel hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex items-end justify-between gap-4"><div><p class="eyebrow text-[var(--koa-clay)]">Vendors</p><h3 class="display mt-2 text-4xl">Vendor plan + contacts + insurance</h3></div><button type="button" data-add-vendor class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Add vendor</button></div>
            <div class="mt-6 rounded-xl bg-[var(--koa-sand)] p-4"><div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow text-[var(--koa-clay)]">Event Team checklist</p><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Set what this specific wedding requires. Couples will see Required, Recommended, Optional, or Not Needed in their Vendor Marketplace. <span data-vendor-plan-mode class="font-semibold text-[var(--koa-forest)]"></span></p></div><div class="flex flex-wrap gap-2"><button data-apply-vendor-suggestions type="button" class="rounded-full border border-[var(--koa-forest)] bg-white px-4 py-2.5 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Apply smart suggestions</button><button data-save-vendor-requirements type="button" class="rounded-full bg-[var(--koa-clay)] px-4 py-2.5 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Save vendor plan</button></div></div><div data-vendor-suggestions class="mt-4 rounded-xl border border-[var(--koa-line)] bg-white p-4"></div><div data-vendor-requirements class="mt-4 grid gap-2"></div></div>
            <div data-vendors class="mt-6 grid gap-3"></div>
            <button data-save-vendors class="mt-5 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save vendors</button>
          </div>

          <div data-panel="vendor-ops" class="panel hidden grid gap-6">
            <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div><p class="eyebrow text-[var(--koa-clay)]">Vendor readiness</p><h3 class="display mt-2 text-4xl">Deadlines + conflicts</h3><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Automatic checks for insurance, Event Brief acknowledgment, arrival times, load-in overlap, and setup collisions.</p></div>
                <div data-vendor-op-counts class="text-sm text-[var(--koa-ink)]/55"></div>
              </div>
              <div data-vendor-conflicts class="mt-5 grid gap-2"></div>
              <div data-vendor-deadlines class="mt-5 grid gap-2 md:grid-cols-2"></div>
            </section>

            <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
              <div><p class="eyebrow text-[var(--koa-clay)]">Event Briefs</p><h3 class="display mt-2 text-4xl">Vendor-specific arrival + venue instructions</h3><p class="mt-2 text-sm text-[var(--koa-ink)]/55">Each vendor receives only their own access details, setup responsibilities and applicable Koa’s rules.</p></div>
              <div data-vendor-briefs class="mt-5 grid gap-4"></div>
              <button data-save-briefs class="mt-5 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save Event Brief details</button>
            </section>

            <section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"><div><p class="eyebrow text-[var(--koa-clay)]">Floor plan + setup ownership</p><h3 class="display mt-2 text-4xl">Who provides, delivers, sets up + removes each item</h3></div><button data-add-setup type="button" class="rounded-full border border-[var(--koa-forest)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Add setup item</button></div>
              <div data-setup-items class="mt-5 grid gap-3"></div>
              <button data-save-setup class="mt-5 rounded-full bg-[var(--koa-clay)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save setup ownership</button>
            </section>
          </div>

          <div data-panel="questionnaire" class="panel hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div><p class="eyebrow text-[var(--koa-clay)]">Planning questionnaire</p><h3 class="display mt-2 text-4xl">Open decisions + client answers</h3></div>
            <div data-questionnaire class="mt-6 grid gap-3"></div>
            <button data-save-questionnaire class="mt-5 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save questionnaire</button>
          </div>

          <div data-panel="timeline" class="panel hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex items-end justify-between gap-4"><div><p class="eyebrow text-[var(--koa-clay)]">Run of show</p><h3 class="display mt-2 text-4xl">Production timeline</h3></div><button type="button" data-add-timeline class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Add timeline item</button></div>
            <div data-timeline class="mt-6 grid gap-3"></div>
            <button data-save-timeline class="mt-5 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save run of show</button>
          </div>

          <div data-panel="checklist" class="panel hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div><p class="eyebrow text-[var(--koa-clay)]">Readiness</p><h3 class="display mt-2 text-4xl">Before, during + after checklist</h3></div>
            <div data-checklist class="mt-6 grid gap-5"></div>
            <button data-save-checklist class="mt-5 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save checklist</button>
          </div>

          <div data-panel="tasks" class="panel hidden rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] sm:p-7">
            <div class="flex items-end justify-between gap-4"><div><p class="eyebrow text-[var(--koa-clay)]">Event day</p><h3 class="display mt-2 text-4xl">Assignments + live task board</h3></div><button type="button" data-add-task class="rounded-full bg-[var(--koa-forest)] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Add task</button></div>
            <div data-tasks class="mt-6 grid gap-3"></div>
            <button data-save-tasks class="mt-5 rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save event-day board</button>
          </div>
        </section>
      </div>
    </div>
  </main>

  <style>
    .tab-button{white-space:nowrap;border-radius:9999px;padding:.7rem 1rem;font-size:.62rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:var(--koa-forest)}
    .tab-button.is-active{background:var(--koa-forest);color:white}
  </style>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const approvedAdminEmails=new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    const app=document.querySelector('[data-app]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const empty=document.querySelector('[data-empty]');
    const detail=document.querySelector('[data-detail]');
    const eventList=document.querySelector('[data-event-list]');
    const eventCount=document.querySelector('[data-event-count]');
    const searchForm=document.querySelector('[data-search-form]');
    const search=document.querySelector('[data-search]');
    const overviewForm=document.querySelector('[data-overview-form]');
    const saveMessage=document.querySelector('[data-save-message]');
    const uploadForm=document.querySelector('[data-upload-form]');
    const uploadMessage=document.querySelector('[data-upload-message]');
    const documentsEl=document.querySelector('[data-documents]');
    const vendorsEl=document.querySelector('[data-vendors]');
    const vendorRequirementsEl=document.querySelector('[data-vendor-requirements]');
    const vendorSuggestionsEl=document.querySelector('[data-vendor-suggestions]');
    const questionnaireEl=document.querySelector('[data-questionnaire]');
    const timelineEl=document.querySelector('[data-timeline]');
    const checklistEl=document.querySelector('[data-checklist]');
    const tasksEl=document.querySelector('[data-tasks]');
    const vendorBriefsEl=document.querySelector('[data-vendor-briefs]');
    const setupItemsEl=document.querySelector('[data-setup-items]');
    const vendorConflictsEl=document.querySelector('[data-vendor-conflicts]');
    const vendorDeadlinesEl=document.querySelector('[data-vendor-deadlines]');

    let payload={events:[],staff:[]};
    let selected=null;
    let activeTab='overview';
    let managerAccess=false;

    function userRoles(user){const sources=[user?.roles,user?.appMetadata?.roles,user?.app_metadata?.roles];return (sources.find(Array.isArray)||[]).map((role)=>String(role||'').toLowerCase());}
    function hasAdminAccess(user){const email=String(user?.email||'').trim().toLowerCase();const roles=userRoles(user);return approvedAdminEmails.has(email)||roles.some((role)=>['admin','staff','sales','manager'].includes(role));}
    function hasManagerAccess(user){const email=String(user?.email||'').trim().toLowerCase();const roles=userRoles(user);const meta=user?.appMetadata||user?.app_metadata||{};const permissions=Array.isArray(meta.permissions)?meta.permissions.map((p)=>String(p||'').toLowerCase()):[];return approvedAdminEmails.has(email)||roles.includes('admin')||roles.includes('manager')||permissions.includes('event_ops.manage');}
    function applyRoleUi(){
      if(managerAccess)return;
      overviewForm?.querySelectorAll('input,select,textarea,button').forEach((el)=>el.disabled=true);
      uploadForm?.classList.add('hidden');
      ['[data-add-vendor]','[data-save-vendors]','[data-save-vendor-requirements]','[data-apply-vendor-suggestions]','[data-save-briefs]','[data-add-setup]','[data-save-setup]','[data-save-questionnaire]','[data-add-timeline]','[data-save-timeline]','[data-save-checklist]','[data-add-task]','[data-save-tasks]'].forEach((selector)=>document.querySelector(selector)?.classList.add('hidden'));
    }
    function text(tag,cls,value){const el=document.createElement(tag);if(cls)el.className=cls;el.textContent=value;return el;}
    function dateLabel(value){if(!value)return 'Date TBD';return new Intl.DateTimeFormat('en-US',{dateStyle:'medium'}).format(new Date(value.length===10?value+'T12:00:00':value));}
    function packageLabel(id){return id==='signature-wedding'?'Signature Wedding Experience':id?String(id).replaceAll('-',' ').replace(/\b\w/g,(m)=>m.toUpperCase()):'Custom';}
    function uid(prefix='ROW'){return prefix+'-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,7);}
    function escapeHtml(v){return String(v??'').replace(/[&<>"']/g,(ch)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));}
    function staffMatch(value){
      const raw=String(value||'').trim().toLowerCase();if(!raw)return null;
      return (payload.staff||[]).find((s)=>[s.name,s.email,s.jobTitle,s.roleLabel].some((v)=>String(v||'').trim().toLowerCase()===raw))
        || (payload.staff||[]).find((s)=>raw.includes(String(s.email||'').toLowerCase())||raw.includes(String(s.name||'').toLowerCase()));
    }
    function sameDateLoad(staff,date){
      if(!staff||!date)return null;
      return (staff.dateLoad||[]).find((row)=>row.date===String(date).slice(0,10))||null;
    }
    function loadWarning(staff,date){
      const load=sameDateLoad(staff,date);
      if(!load)return '';
      if(load.heavy)return staff.name+' already has '+load.responsibilityCount+' responsibilit'+(load.responsibilityCount===1?'y':'ies')+' across '+load.eventCount+' event'+(load.eventCount===1?'':'s')+' on '+date+'.';
      if(load.responsibilityCount>=3)return staff.name+' already has '+load.responsibilityCount+' responsibilities on '+date+'.';
      return '';
    }
    function ownerControl(value=''){
      const wrap=document.createElement('div');wrap.className='relative flex items-start gap-2';wrap.dataset.ownerWrap='';
      const avatar=document.createElement('span');avatar.className='mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[var(--koa-forest)] text-[.62rem] font-black text-white';avatar.dataset.ownerAvatar='';
      const fieldWrap=document.createElement('div');fieldWrap.className='relative min-w-0 flex-1';
      const hidden=document.createElement('input');hidden.type='hidden';hidden.dataset.owner='';
      const input=document.createElement('input');input.type='search';input.autocomplete='off';input.className='field min-w-0';input.placeholder='Search staff';
      const menu=document.createElement('div');menu.className='absolute left-0 right-0 top-[calc(100%+.3rem)] z-50 hidden max-h-80 overflow-y-auto rounded-xl border border-[var(--koa-line)] bg-white p-2 shadow-xl';
      const warning=document.createElement('p');warning.className='mt-1 hidden rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-2 text-[.66rem] font-semibold leading-4 text-amber-900';
      const eventDate=String(selected?.record?.customer?.eventDate||'').slice(0,10);
      const initial=staffMatch(value);hidden.value=initial?.email||String(value||'').trim();input.value=initial?.name||'';if(value&&!initial)input.placeholder='Previous: '+String(value).slice(0,60);
      const updateAvatar=(staff)=>{
        avatar.innerHTML='';
        if(staff?.photoUrl){const img=document.createElement('img');img.src=staff.photoUrl;img.alt='';img.className='h-full w-full object-cover';avatar.appendChild(img);}
        else avatar.textContent=String(staff?.name||'—').trim().charAt(0).toUpperCase()||'—';
        avatar.title=staff?(staff.name+(staff.jobTitle?' · '+staff.jobTitle:'')):'Unassigned';
      };
      const showWarning=(staff)=>{
        const message=loadWarning(staff,eventDate);
        warning.textContent=message;
        warning.classList.toggle('hidden',!message);
        input.classList.toggle('border-amber-400',Boolean(message));
      };
      const renderOptions=()=>{
        const q=String(input.value||'').trim().toLowerCase();
        const rows=(payload.staff||[]).filter((s)=>!q||[s.name,s.email,s.jobTitle,s.roleLabel].some((v)=>String(v||'').toLowerCase().includes(q))).slice(0,30);
        menu.innerHTML='<button type="button" data-clear class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-left text-xs font-bold text-[var(--koa-ink)]/55 hover:bg-[var(--koa-sand)]"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--koa-sand)]">—</span><span>Unassigned</span></button>'
          +rows.map((s)=>{
            const load=sameDateLoad(s,eventDate);
            const badge=load&&load.heavy?'<span class="ml-auto shrink-0 rounded-full bg-amber-100 px-2 py-1 text-[.5rem] font-black uppercase tracking-[.05em] text-amber-900">'+load.responsibilityCount+' same-day</span>':load&&load.responsibilityCount>=3?'<span class="ml-auto shrink-0 rounded-full bg-[var(--koa-sand)] px-2 py-1 text-[.5rem] font-black uppercase tracking-[.05em] text-[var(--koa-clay)]">'+load.responsibilityCount+' same-day</span>':'';
            return '<button type="button" data-email="'+escapeHtml(s.email)+'" class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-left hover:bg-[var(--koa-sand)]">'+(s.photoUrl?'<img src="'+escapeHtml(s.photoUrl)+'" alt="" class="h-9 w-9 shrink-0 rounded-full object-cover">':'<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--koa-forest)] text-[.62rem] font-black text-white">'+escapeHtml(String(s.name||'K').charAt(0).toUpperCase())+'</span>')+'<span class="min-w-0"><strong class="block truncate text-sm text-[var(--koa-forest)]">'+escapeHtml(s.name)+'</strong><span class="block truncate text-xs text-[var(--koa-ink)]/50">'+escapeHtml(s.jobTitle||s.roleLabel||'Staff')+' · '+Number(s.workload?.totalOpenAssignments||0)+' open</span></span>'+badge+'</button>';
          }).join('');
        menu.classList.remove('hidden');
        menu.querySelector('[data-clear]')?.addEventListener('click',()=>{hidden.value='';input.value='';updateAvatar(null);showWarning(null);menu.classList.add('hidden');});
        menu.querySelectorAll('[data-email]').forEach((button)=>button.addEventListener('click',()=>{
          const staff=(payload.staff||[]).find((s)=>s.email===button.dataset.email);if(!staff)return;
          hidden.value=staff.email;input.value=staff.name;updateAvatar(staff);showWarning(staff);menu.classList.add('hidden');
        }));
      };
      input.addEventListener('focus',renderOptions);
      input.addEventListener('input',()=>{hidden.value='';updateAvatar(null);showWarning(null);renderOptions();});
      input.addEventListener('keydown',(event)=>{if(event.key==='Escape')menu.classList.add('hidden');});
      input.addEventListener('blur',()=>setTimeout(()=>menu.classList.add('hidden'),160));
      updateAvatar(initial);showWarning(initial);fieldWrap.append(hidden,input,menu,warning);wrap.append(avatar,fieldWrap);return wrap;
    }

    async function api(body){
      const res=await fetch('/api/admin/events',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      const data=await res.json().catch(()=>({}));
      if(!res.ok)throw new Error(data.error||'Unable to save event operations.');
      return data;
    }

    function showTab(name){
      activeTab=name;
      document.querySelectorAll('[data-tab]').forEach((button)=>button.classList.toggle('is-active',button.dataset.tab===name));
      document.querySelectorAll('[data-panel]').forEach((panel)=>panel.classList.toggle('hidden',panel.dataset.panel!==name));
    }

    function completion(){
      if(!selected)return 0;
      const rows=selected.ops.checklist||[];
      if(!rows.length)return 0;
      return Math.round(rows.filter((row)=>row.status==='complete'||row.status==='not_applicable').length/rows.length*100);
    }


    function mobilePriorityTab(entry){
      if(window.innerWidth>=768)return 'overview';
      const ops=entry?.ops||{};
      const openTasks=(ops.tasks||[]).filter((task)=>String(task?.status||'not_started')!=='complete');
      if(String(ops.status||'planning')==='event_day'&&openTasks.length)return 'tasks';

      const checklist=ops.checklist||[];
      const checklistDone=checklist.length
        ? Math.round(checklist.filter((row)=>row.status==='complete'||row.status==='not_applicable').length/checklist.length*100)
        : 100;
      if(checklistDone<100)return 'checklist';

      const vendors=ops.vendors||[];
      if(vendors.some((vendor)=>String(vendor?.insuranceStatus||'').toLowerCase()!=='approved'))return 'vendor-ops';

      const questionnaire=ops.questionnaire||[];
      if(questionnaire.some((row)=>String(row?.status||'open')==='open'))return 'questionnaire';

      if(openTasks.length)return 'tasks';
      return 'overview';
    }

    function renderSummary(){
      if(!selected)return;
      document.querySelector('[data-summary-guests]').textContent=String(selected.ops.finalGuestCount||0);
      document.querySelector('[data-summary-checklist]').textContent=completion()+'%';
      const vendors=selected.ops.vendors||[];
      document.querySelector('[data-summary-insurance]').textContent=vendors.filter((v)=>v.insuranceStatus==='approved').length+'/'+vendors.length;
      document.querySelector('[data-summary-documents]').textContent=String((selected.ops.documents||[]).length);
      const reviewStatus=String(selected.record?.communications?.reviewRequest?.status||'').toLowerCase();
      document.querySelector('[data-summary-review]').textContent=reviewStatus==='delivered'?'Delivered':reviewStatus==='bounced'?'Bounced':reviewStatus==='failed'?'Failed':reviewStatus==='sent'?'Email sent':'Not sent';
      document.querySelector('[data-readiness]').textContent=(selected.ops.status||'planning').replaceAll('_',' ')+' · '+completion()+'% checklist';
    }

    function renderEventList(){
      eventList.innerHTML='';
