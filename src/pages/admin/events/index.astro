      row.querySelector('[data-time]').value=v.time||'';row.querySelector('[data-label]').value=v.label||'';row.querySelector('[data-location]').value=v.location||'';row.querySelector('[data-notes]').value=v.notes||'';row.querySelector('[data-remove]').addEventListener('click',()=>row.remove());return row;
    }
    function renderTimeline(){timelineEl.innerHTML='';(selected?.ops.timeline||[]).forEach((v)=>timelineEl.appendChild(timelineRow(v)));if(!(selected?.ops.timeline||[]).length)timelineEl.appendChild(text('p','text-sm text-[var(--koa-ink)]/45','No run-of-show items yet.'));}
    function collectTimeline(){return [...timelineEl.children].filter((r)=>r.dataset?.id).map((r)=>({id:r.dataset.id,time:r.querySelector('[data-time]').value,label:r.querySelector('[data-label]').value,owner:r.querySelector('[data-owner]').value,location:r.querySelector('[data-location]').value,notes:r.querySelector('[data-notes]').value}));}

    function renderChecklist(){
      checklistEl.innerHTML='';
      const labels={before:'Before event',event_day:'Event day',after:'After event'};
      ['before','event_day','after'].forEach((phase)=>{
        const wrap=document.createElement('section');wrap.appendChild(text('h4','display text-2xl text-[var(--koa-forest)]',labels[phase]));
        const list=document.createElement('div');list.className='mt-3 grid gap-2';
        (selected?.ops.checklist||[]).filter((item)=>item.phase===phase).forEach((item)=>{
          const row=document.createElement('div');row.className='grid gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 lg:grid-cols-[1fr_10rem_10rem_11rem] lg:items-center';row.dataset.id=item.id;row.dataset.phase=item.phase;row.dataset.text=item.text;
          row.append(text('p','text-sm font-semibold',item.text));
          const due=document.createElement('input');due.type='date';due.className='field';due.dataset.due='';due.value=item.dueDate||'';
          const owner=ownerControl(item.owner||'');
          const status=document.createElement('select');status.className='field';status.dataset.status='';status.innerHTML='<option value="not_started">Not started</option><option value="in_progress">In progress</option><option value="complete">Complete</option><option value="not_applicable">N/A</option>';status.value=item.status||'not_started';
          row.append(due,owner,status);list.appendChild(row);
        });
        wrap.appendChild(list);checklistEl.appendChild(wrap);
      });
    }
    function collectChecklist(){return [...checklistEl.querySelectorAll('[data-id]')].map((r)=>({id:r.dataset.id,text:r.dataset.text,dueDate:r.querySelector('[data-due]').value,owner:r.querySelector('[data-owner]').value,status:r.querySelector('[data-status]').value,phase:r.dataset.phase}));}

    function taskRow(v={}){
      const row=document.createElement('div');row.className='grid gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 lg:grid-cols-[8rem_1.3fr_1fr_11rem_auto]';row.dataset.id=v.id||uid('T');
      row.innerHTML='<input data-time type="time" class="field"><input data-task class="field" placeholder="Task"><span data-owner-slot></span><select data-status class="field"><option value="not_started">Not started</option><option value="in_progress">In progress</option><option value="complete">Complete</option><option value="blocked">Blocked</option></select><button type="button" data-remove class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-xs">×</button><textarea data-notes rows="2" class="field lg:col-span-4" placeholder="Notes"></textarea>';
      row.querySelector('[data-owner-slot]').replaceWith(ownerControl(v.owner||''));
      row.querySelector('[data-time]').value=v.time||'';row.querySelector('[data-task]').value=v.task||'';row.querySelector('[data-status]').value=v.status||'not_started';row.querySelector('[data-notes]').value=v.notes||'';row.querySelector('[data-remove]').addEventListener('click',()=>row.remove());return row;
    }
    function renderTasks(){tasksEl.innerHTML='';(selected?.ops.tasks||[]).forEach((v)=>tasksEl.appendChild(taskRow(v)));}
    function collectTasks(){return [...tasksEl.children].filter((r)=>r.dataset?.id).map((r)=>({id:r.dataset.id,time:r.querySelector('[data-time]').value,task:r.querySelector('[data-task]').value,owner:r.querySelector('[data-owner]').value,status:r.querySelector('[data-status]').value,notes:r.querySelector('[data-notes]').value}));}

    function formatBytes(bytes){const n=Number(bytes||0);if(n<1024)return n+' B';if(n<1048576)return (n/1024).toFixed(1)+' KB';return (n/1048576).toFixed(1)+' MB';}
    function renderDocuments(){
      documentsEl.innerHTML='';
      (selected?.ops.documents||[]).forEach((doc)=>{
        const row=document.createElement('article');row.className='flex flex-col gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 sm:flex-row sm:items-center sm:justify-between';
        const left=document.createElement('div');left.append(text('p','text-[.55rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]',String(doc.category||'other').replaceAll('_',' ')),text('h4','mt-1 text-sm font-semibold',doc.label||doc.name),text('p','mt-1 text-xs text-[var(--koa-ink)]/45',doc.name+' · '+formatBytes(doc.size)+' · '+dateLabel(doc.uploadedAt)));
        const actions=document.createElement('div');actions.className='flex gap-2';
        const open=document.createElement('button');open.type='button';open.className='rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]';open.textContent='Open';open.addEventListener('click',()=>openDocument(doc));
        const del=document.createElement('button');del.type='button';del.className='rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]';del.textContent='Remove';del.addEventListener('click',()=>deleteDocument(doc));
        actions.append(open);if(managerAccess)actions.append(del);row.append(left,actions);documentsEl.appendChild(row);
      });
      if(!(selected?.ops.documents||[]).length)documentsEl.appendChild(text('p','text-sm text-[var(--koa-ink)]/45','No event documents uploaded yet.'));
    }

    async function openDocument(doc){
      const res=await fetch('/api/admin/events/documents/'+encodeURIComponent(selected.record.id)+'/'+encodeURIComponent(doc.id));
      if(!res.ok){if(uploadMessage)uploadMessage.textContent='Unable to open document.';return;}
      const blob=await res.blob();const url=URL.createObjectURL(blob);window.open(url,'_blank','noopener,noreferrer');window.setTimeout(()=>URL.revokeObjectURL(url),60000);
    }
    async function deleteDocument(doc){
      const res=await fetch('/api/admin/events/documents/'+encodeURIComponent(selected.record.id)+'/'+encodeURIComponent(doc.id),{method:'DELETE'});
      const data=await res.json().catch(()=>({}));if(!res.ok){if(uploadMessage)uploadMessage.textContent=data.error||'Unable to remove document.';return;}
      selected.ops.documents=data.documents||[];renderDocuments();renderSummary();
    }

    async function saveSection(action,data){
      const result=await api({action,recordId:selected.record.id,...data});selected.ops=result.ops;if(Array.isArray(result.vendorSuggestions))selected.vendorSuggestions=result.vendorSuggestions;if(result.vendorOperations)selected.vendorOperations=result.vendorOperations;renderSummary();return result;
    }

    async function load(q=''){
      const user=await getAdminSession();if(!hasAdminAccess(user)){unauthorized.classList.remove('hidden');return;}
      managerAccess=hasManagerAccess(user);applyRoleUi();
      app.classList.remove('hidden');
      const res=await fetch('/api/admin/events'+(q?'?q='+encodeURIComponent(q):''),{cache:'no-store'});
      if(!res.ok)return;
      payload=await res.json();
      try{
        const staffResponse=await fetch('/api/staff/directory',{cache:'no-store'});
        if(staffResponse.ok){const directory=await staffResponse.json();payload.staff=directory.staff||[];}
      }catch{}
      if(selected){const refreshed=(payload.events||[]).find((e)=>e.record.id===selected.record.id);if(refreshed)selected=refreshed;else selected=null;}
      if(!selected){
        const requested=new URLSearchParams(window.location.search).get('record')||'';
        if(requested)selected=(payload.events||[]).find((e)=>e.record.id===requested)||null;
      }
      renderEventList();
      if(selected)selectEvent(selected);
      else if(payload.events?.length)selectEvent(payload.events[0]);
    }

    document.querySelectorAll('[data-tab]').forEach((button)=>button.addEventListener('click',()=>showTab(button.dataset.tab)));
    document.querySelector('[data-summary-checklist]')?.closest('article')?.addEventListener('click',()=>showTab('checklist'));
    document.querySelector('[data-summary-insurance]')?.closest('article')?.addEventListener('click',()=>showTab('vendor-ops'));
    document.querySelector('[data-summary-documents]')?.closest('article')?.addEventListener('click',()=>showTab('documents'));
    document.querySelector('[data-summary-guests]')?.closest('article')?.addEventListener('click',()=>showTab('overview'));
    overviewForm?.addEventListener('submit',async(e)=>{e.preventDefault();saveMessage.textContent='Saving…';try{await saveSection('save-overview',{status:overviewForm.elements.status.value,finalGuestCount:Number(overviewForm.elements.finalGuestCount.value||0),venueArea:overviewForm.elements.venueArea.value,setupStart:overviewForm.elements.setupStart.value,guestArrival:overviewForm.elements.guestArrival.value,eventStart:overviewForm.elements.eventStart.value,eventEnd:overviewForm.elements.eventEnd.value,teardownEnd:overviewForm.elements.teardownEnd.value,notes:overviewForm.elements.notes.value});saveMessage.textContent='Saved.';renderVendorRequirements();renderVendorSuggestions();}catch(err){saveMessage.textContent=err.message||'Unable to save.';}});
    document.querySelector('[data-add-vendor]')?.addEventListener('click',()=>{if(vendorsEl.querySelector('p'))vendorsEl.innerHTML='';vendorsEl.appendChild(vendorRow());});
    document.querySelector('[data-save-vendors]')?.addEventListener('click',async()=>{await saveSection('save-vendors',{vendors:collectVendors()});renderVendors();renderVendorOperations();renderSummary();});
    document.querySelector('[data-save-vendor-requirements]')?.addEventListener('click',async()=>{await saveSection('save-vendor-requirements',{vendorRequirements:collectVendorRequirements()});renderVendorRequirements();renderVendorSuggestions();});
    document.querySelector('[data-apply-vendor-suggestions]')?.addEventListener('click',async()=>{if(!selected)return;const result=await saveSection('apply-vendor-suggestions',{});selected.ops=result.ops;renderVendorRequirements();await load(String(search?.value||'').trim());});
    document.querySelector('[data-save-briefs]')?.addEventListener('click',async()=>{const result=await saveSection('save-vendor-brief-details',{vendors:collectBriefs()});selected.vendorOperations=result.vendorOperations;renderVendorOperations();});
    document.querySelector('[data-add-setup]')?.addEventListener('click',()=>{if(setupItemsEl.querySelector('p'))setupItemsEl.innerHTML='';setupItemsEl.appendChild(setupRow());});
    document.querySelector('[data-save-setup]')?.addEventListener('click',async()=>{const result=await saveSection('save-setup-items',{setupItems:collectSetupItems()});selected.vendorOperations=result.vendorOperations;renderVendorOperations();});
    document.querySelector('[data-save-questionnaire]')?.addEventListener('click',async()=>{await saveSection('save-questionnaire',{questionnaire:collectQuestionnaire()});renderQuestionnaire();renderVendorRequirements();renderVendorSuggestions();});
    document.querySelector('[data-add-timeline]')?.addEventListener('click',()=>{if(timelineEl.querySelector('p'))timelineEl.innerHTML='';timelineEl.appendChild(timelineRow());});
    document.querySelector('[data-save-timeline]')?.addEventListener('click',async()=>{await saveSection('save-timeline',{timeline:collectTimeline()});renderTimeline();});
    document.querySelector('[data-save-checklist]')?.addEventListener('click',async()=>{await saveSection('save-checklist',{checklist:collectChecklist()});renderChecklist();renderSummary();});
    document.querySelector('[data-add-task]')?.addEventListener('click',()=>tasksEl.appendChild(taskRow()));
    document.querySelector('[data-save-tasks]')?.addEventListener('click',async()=>{await saveSection('save-tasks',{tasks:collectTasks()});renderTasks();});

    uploadForm?.addEventListener('submit',async(e)=>{
      e.preventDefault();if(!selected)return;uploadMessage.textContent='Uploading…';const form=new FormData(uploadForm);
      const res=await fetch('/api/admin/events/documents/'+encodeURIComponent(selected.record.id),{method:'POST',body:form});
      const data=await res.json().catch(()=>({}));if(!res.ok){uploadMessage.textContent=data.error||'Upload failed.';return;}
      selected.ops.documents=data.documents||[];uploadMessage.textContent='Uploaded.';uploadForm.reset();renderDocuments();renderSummary();
    });

    searchForm?.addEventListener('submit',(e)=>{e.preventDefault();load(String(search.value||'').trim());});

    const style=document.createElement('style');style.textContent='.field{min-height:2.7rem;border:1px solid var(--koa-line);border-radius:.65rem;background:white;padding:.65rem .75rem;font-size:.82rem;width:100%}';document.head.appendChild(style);
    showTab('overview');load();
  </script>
</BaseLayout>
