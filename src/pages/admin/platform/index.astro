---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="VenueLoom Super Admin" description="Platform administration for VenueLoom organizations.">
  <main class="min-h-screen bg-stone-100 py-8">
    <div class="mx-auto grid w-[min(96vw,96rem)] gap-6">
      <header class="rounded-3xl bg-stone-950 p-7 text-white shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-xs font-black uppercase tracking-[.16em] text-stone-400">VenueLoom platform</p>
            <h1 class="mt-2 text-4xl font-black">Super Admin</h1>
            <p class="mt-3 max-w-4xl text-sm leading-6 text-stone-300">Organization, subscription, health, domain, integration and migration oversight. Support sessions are read-only, reason-required, time-limited and auditable.</p>
          </div>
          <div class="flex flex-wrap gap-2 text-xs font-black">
            <a href="/admin/" class="rounded-full border border-white/20 px-4 py-2.5">Admin home</a>
            <a href="/admin/organization/" class="rounded-full border border-white/20 px-4 py-2.5">Organization Settings</a>
            <a href="/admin/platform/migrations/" class="rounded-full border border-white/20 px-4 py-2.5">Migration Dashboard</a>
          </div>
        </div>
      </header>

      <section data-loading class="rounded-3xl bg-white p-7 shadow-sm"><p class="text-sm text-stone-600">Loading platform state…</p></section>
      <section data-denied class="hidden rounded-3xl bg-white p-7 shadow-sm"><h2 class="text-2xl font-black">Super Admin access required</h2><p data-denied-message class="mt-2 text-sm text-stone-600"></p></section>

      <div data-app class="hidden grid gap-6">
        <section data-support-banner class="hidden rounded-3xl border-2 border-amber-300 bg-amber-50 p-5">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div><p class="text-xs font-black uppercase tracking-[.12em] text-amber-800">Read-only support mode</p><h2 data-support-title class="mt-1 text-xl font-black text-stone-900"></h2><p data-support-meta class="mt-1 text-sm text-stone-700"></p></div>
            <button data-exit-support class="rounded-full bg-stone-900 px-5 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Exit support mode</button>
          </div>
        </section>

        <section data-summary class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5"></section>

        <section class="rounded-3xl bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div><p class="text-xs font-black uppercase tracking-[.14em] text-stone-500">Organizations</p><h2 class="mt-2 text-2xl font-black">Tenant fleet</h2></div>
            <div class="flex flex-wrap gap-2"><input data-search placeholder="Search organization…" class="min-w-64 rounded-full border border-stone-300 px-4 py-2.5 text-sm"><button data-refresh class="rounded-full border border-stone-300 px-4 py-2.5 text-xs font-black uppercase tracking-[.08em]">Refresh</button><button data-create-sandbox class="rounded-full border border-stone-300 px-4 py-2.5 text-xs font-black uppercase tracking-[.08em]">Ensure Tenant #2 sandbox</button><button data-run-sandbox-isolation class="rounded-full bg-stone-900 px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Run leakage test</button><button data-run-sandbox-onboarding class="rounded-full bg-emerald-800 px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Run onboarding E2E</button></div>
          </div>
          <p data-message class="mt-3 text-sm text-stone-600"></p>
          <div data-organizations class="mt-5 grid gap-3"></div>
        </section>

        <section data-detail class="hidden rounded-3xl bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div><p class="text-xs font-black uppercase tracking-[.14em] text-stone-500">Tenant detail</p><h2 data-detail-title class="mt-2 text-2xl font-black"></h2></div>
            <button data-close-detail class="rounded-full border border-stone-300 px-4 py-2 text-xs font-black uppercase tracking-[.08em]">Close</button>
          </div>
          <div data-detail-grid class="mt-5 grid gap-4 xl:grid-cols-2"></div>
        </section>

        <section class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-xs font-black uppercase tracking-[.14em] text-stone-500">Support audit</p>
          <h2 class="mt-2 text-2xl font-black">Recent read-only support sessions</h2>
          <div data-support-history class="mt-5 grid gap-2"></div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const $=(s)=>document.querySelector(s);
    let state=null;
    let activeSupportToken='';
    const esc=(v)=>String(v??'').replace(/[&<>"']/g,(ch)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    const fmt=(v)=>v?new Date(v).toLocaleString():'—';
    const pill=(label,good=true)=>'<span class="rounded-full px-2 py-1 text-[.62rem] font-black uppercase tracking-[.05em] '+(good?'bg-emerald-100 text-emerald-800':'bg-amber-100 text-amber-800')+'">'+esc(label)+'</span>';

    async function api(path='',options={}){
      const response=await fetch('/api/admin/platform'+path,{cache:'no-store',...options,headers:{'Content-Type':'application/json',...(options.headers||{})}});
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw Object.assign(new Error(data.error||'Platform request failed.'),{data,status:response.status});
      return data;
    }

    function summaryCard(value,label){
      return '<article class="rounded-2xl bg-white p-5 shadow-sm"><strong class="text-3xl text-stone-900">'+esc(value)+'</strong><p class="mt-1 text-xs font-semibold text-stone-500">'+esc(label)+'</p></article>';
    }

    function render(){
      if(!state)return;
      const s=state.summary||{};
      $('[data-summary]').innerHTML=[
        [s.organizations||0,'Organizations'],
        [s.active||0,'Active'],
        [s.trial||0,'Trial'],
        [s.attention||0,'Needs attention'],
        [s.subscriptionsActive||0,'Active subscriptions'],
      ].map(([v,l])=>summaryCard(v,l)).join('');

      const q=String($('[data-search]').value||'').toLowerCase();
      const rows=(state.organizations||[]).filter((row)=>!q||[row.displayName,row.slug,row.status].join(' ').toLowerCase().includes(q));
      $('[data-organizations]').innerHTML=rows.map((row)=>{
        const health=row.health?.healthy===true?pill('healthy',true):row.health?.healthy===false?pill((row.health.failed||0)+' failed',false):pill('no health sample',false);
        const subscription=row.subscription?.status||'not_configured';
        const domains=(row.domainSummary?.verified||0)+'/'+(row.domainSummary?.total||0)+' verified';
        const integrationReady=(row.integrations||[]).filter((i)=>i.configured).length;
        return '<article class="grid gap-4 rounded-2xl border border-stone-200 p-5 xl:grid-cols-[1.4fr_.8fr_.8fr_.8fr_auto] xl:items-center">'
          +'<div><div class="flex flex-wrap items-center gap-2"><strong class="text-lg text-stone-900">'+esc(row.displayName)+'</strong>'+pill(row.status,!['past_due','suspended','canceled'].includes(row.status))+health+'</div><p class="mt-1 text-xs text-stone-500">'+esc(row.slug)+' · '+(row.legacyCompatibility?'Koa compatibility storage':'tenant-native storage')+'</p></div>'
          +'<div><p class="text-[.65rem] font-black uppercase text-stone-400">Subscription</p><p class="mt-1 text-sm font-semibold">'+esc(subscription)+'</p></div>'
          +'<div><p class="text-[.65rem] font-black uppercase text-stone-400">Domains</p><p class="mt-1 text-sm font-semibold">'+esc(domains)+'</p></div>'
          +'<div><p class="text-[.65rem] font-black uppercase text-stone-400">Integrations</p><p class="mt-1 text-sm font-semibold">'+integrationReady+'/'+((row.integrations||[]).length)+' configured</p></div>'
          +'<div class="flex flex-wrap gap-2"><button data-detail-id="'+esc(row.id)+'" class="rounded-full border border-stone-300 px-3 py-2 text-xs font-black">Details</button><button data-support-id="'+esc(row.id)+'" class="rounded-full bg-stone-900 px-3 py-2 text-xs font-black text-white">Support mode</button></div>'
          +'</article>';
      }).join('')||'<p class="text-sm text-stone-500">No organizations match.</p>';

      $('[data-support-history]').innerHTML=(state.supportSessions||[]).slice(0,20).map((row)=>'<div class="flex flex-col gap-2 rounded-xl bg-stone-100 px-4 py-3 text-xs sm:flex-row sm:items-center sm:justify-between"><div><strong>'+esc(row.tenantId)+'</strong> · '+esc(row.adminEmail)+'<p class="mt-1 text-stone-500">'+esc(row.reason)+'</p></div><span class="font-bold">'+(row.active?'active':'ended')+' · '+fmt(row.createdAt)+'</span></div>').join('')||'<p class="text-sm text-stone-500">No support sessions yet.</p>';

      document.querySelectorAll('[data-detail-id]').forEach((button)=>button.addEventListener('click',()=>loadDetail(button.dataset.detailId)));
      document.querySelectorAll('[data-support-id]').forEach((button)=>button.addEventListener('click',()=>startSupport(button.dataset.supportId)));
    }

    async function loadDetail(id,supportToken=''){
      $('[data-message]').textContent='Loading tenant detail…';
      try{
        const data=await api(supportToken?'?support='+encodeURIComponent(supportToken):'?tenant='+encodeURIComponent(id));
        const row=data.organization;
        $('[data-detail]').classList.remove('hidden');
        $('[data-detail-title]').textContent=row.displayName;
        const migration=data.migrationAudit?.summary||{};
        const integrations=(row.integrations||[]).map((i)=>'<div class="flex items-center justify-between rounded-xl bg-stone-100 px-3 py-2 text-xs"><span class="capitalize">'+esc(i.provider)+'</span>'+pill(i.configured?'configured':i.status,i.configured)+'</div>').join('');
        const domains=(row.domains||[]).map((d)=>'<div class="rounded-xl bg-stone-100 px-3 py-2 text-xs"><strong>'+esc(d.hostname)+'</strong><span class="ml-2 text-stone-500">'+esc(d.kind)+' · '+esc(d.status)+'</span></div>').join('');
        const isolation=data.isolationTest;
        const onboarding=data.onboardingTest;
        $('[data-detail-grid]').innerHTML=
          '<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Platform status</h3><div class="mt-3 grid gap-2 text-sm"><p><strong>Status:</strong> '+esc(row.status)+'</p><p><strong>Health:</strong> '+(row.health?.healthy===true?'Healthy':row.health?.healthy===false?(row.health.failed+' checks failed'):'No sample')+'</p><p><strong>Last health check:</strong> '+fmt(row.health?.checkedAt)+'</p><p><strong>Subscription:</strong> '+esc(row.subscription?.status||'not configured')+'</p><p><strong>Migration:</strong> '+esc(row.migrationStatus)+'</p><p><strong>Legacy retirement:</strong> '+(migration.safeToRetireLegacy===true?'Safe':row.legacyCompatibility?'Blocked / not yet proven':'Not applicable')+'</p></div></article>'
          +'<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Storage migration</h3><div class="mt-3 grid gap-2 text-sm"><p><strong>Legacy objects:</strong> '+esc(migration.legacyObjects??'—')+'</p><p><strong>Canonical objects:</strong> '+esc(migration.canonicalObjects??'—')+'</p><p><strong>Missing canonical:</strong> '+esc(migration.missingCanonical??'—')+'</p><p><strong>Checksum mismatches:</strong> '+esc(migration.fullChecksumMismatches??migration.criticalMismatches??'—')+'</p><p><a class="font-bold underline" href="/admin/platform/migrations/?tenant='+encodeURIComponent(row.id)+'">Open migration dashboard</a></p></div></article>'
          +'<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Tenant isolation test</h3><div class="mt-3 grid gap-2 text-sm"><p><strong>Result:</strong> '+(isolation?pill(isolation.pass?'pass':'fail',Boolean(isolation.pass)):'Not run')+'</p><p><strong>Last run:</strong> '+fmt(isolation?.completedAt)+'</p><p><strong>Koa unchanged:</strong> '+(isolation?String(isolation.koaInventoryUnchanged===true):'—')+'</p><p><strong>Surfaces:</strong> '+esc(isolation?.surfaces?.length??'—')+'</p></div></article>'
          +'<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Onboarding E2E</h3><div class="mt-3 grid gap-2 text-sm"><p><strong>Result:</strong> '+(onboarding?pill(onboarding.pass?'pass':'fail',Boolean(onboarding.pass)):'Not run')+'</p><p><strong>Last run:</strong> '+fmt(onboarding?.completedAt)+'</p><p><strong>Steps:</strong> '+esc(onboarding?.steps?.length??'—')+'</p><p><strong>External safety:</strong> reserved-domain / stub integrations / synthetic Stripe only</p></div></article>'
          +'<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Domains</h3><div class="mt-3 grid gap-2">'+(domains||'<p class="text-sm text-stone-500">No domains configured.</p>')+'</div></article>'
          +'<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Integrations</h3><div class="mt-3 grid gap-2">'+integrations+'</div></article>';
        $('[data-message]').textContent='';
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function startSupport(tenantId){
      const reason=prompt('Reason for entering read-only support mode for '+tenantId+':');
      if(!reason)return;
      $('[data-message]').textContent='Starting audited support session…';
      try{
        const data=await api('',{method:'POST',body:JSON.stringify({action:'create-support-session',tenantId,reason,ttlMinutes:15})});
        activeSupportToken=data.supportToken;
        $('[data-support-banner]').classList.remove('hidden');
        $('[data-support-title]').textContent='Supporting '+tenantId;
        $('[data-support-meta]').textContent='Read-only · expires '+fmt(data.session.expiresAt)+' · Reason: '+data.session.reason;
        await loadDetail(tenantId,activeSupportToken);
        await load();
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function exitSupport(){
      if(!activeSupportToken)return;
      try{await api('',{method:'POST',body:JSON.stringify({action:'end-support-session',supportToken:activeSupportToken})});}catch{}
      activeSupportToken='';
      $('[data-support-banner]').classList.add('hidden');
      $('[data-detail]').classList.add('hidden');
      await load();
    }

    async function createSandbox(){
      if(!confirm('Ensure the dedicated Tenant #2 sandbox exists? It uses tenant-native storage, a reserved .invalid domain, disabled network integrations, and synthetic Stripe IDs.'))return;
      $('[data-message]').textContent='Ensuring isolated Tenant #2 sandbox…';
      try{
        const data=await api('',{method:'POST',body:JSON.stringify({action:'create-sandbox-tenant'})});
        $('[data-message]').textContent='Tenant #2 sandbox ready: '+data.organization.displayName+' ('+data.organization.slug+').';
        await load();
        await loadDetail(data.organization.id);
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function runSandboxIsolation(){
      $('[data-message]').textContent='Running cross-tenant leakage probes against Koa…';
      try{
        const data=await api('',{method:'POST',body:JSON.stringify({action:'run-tenant-isolation-test',tenantId:'vl-sandbox-tenant-2'})});
        $('[data-message]').textContent=(data.report.pass?'PASS':'FAIL')+' · '+data.report.surfaces.length+' storage surfaces · Koa inventory unchanged: '+String(data.report.koaInventoryUnchanged)+'.';
        await load();
        await loadDetail('vl-sandbox-tenant-2');
      }catch(error){
        const report=error.data?.report;
        $('[data-message]').textContent=(report?'FAIL · ':'')+(error.message||'Isolation test failed.');
        if(report)await loadDetail('vl-sandbox-tenant-2');
      }
    }

    async function runSandboxOnboarding(){
      if(!confirm('Run the full safe Tenant #2 onboarding journey? External DNS, integrations and Stripe use synthetic non-network test stubs; no live billing or Koa integrations are touched.'))return;
      $('[data-message]').textContent='Running Tenant #2 onboarding end to end…';
      try{
        const data=await api('',{method:'POST',body:JSON.stringify({action:'run-tenant-onboarding-test'})});
        $('[data-message]').textContent=(data.report.pass?'PASS':'FAIL')+' · '+data.report.steps.length+' onboarding steps · Koa inventory unchanged: '+String(data.report.koaInventoryUnchanged)+'.';
        await load();
        await loadDetail(data.report.tenantId);
      }catch(error){
        const report=error.data?.report;
        $('[data-message]').textContent=(report?'FAIL · ':'')+(error.message||'Onboarding test failed.');
        if(report)await loadDetail(report.tenantId||'vl-sandbox-tenant-2');
      }
    }

    async function load(){
      try{
        const session=await getAdminSession();
        $('[data-loading]').classList.add('hidden');
        if(!session){throw new Error('Sign in with a VenueLoom Super Admin account.');}
        state=await api();
        $('[data-denied]').classList.add('hidden');
        $('[data-app]').classList.remove('hidden');
        render();
      }catch(error){
        $('[data-app]').classList.add('hidden');
        $('[data-denied]').classList.remove('hidden');
        $('[data-denied-message]').textContent=error.message;
      }
    }

    $('[data-search]')?.addEventListener('input',render);
    $('[data-refresh]')?.addEventListener('click',load);
    $('[data-create-sandbox]')?.addEventListener('click',createSandbox);
    $('[data-run-sandbox-isolation]')?.addEventListener('click',runSandboxIsolation);
    $('[data-run-sandbox-onboarding]')?.addEventListener('click',runSandboxOnboarding);
    $('[data-close-detail]')?.addEventListener('click',()=> $('[data-detail]').classList.add('hidden'));
    $('[data-exit-support]')?.addEventListener('click',exitSupport);
    load();
  </script>
</BaseLayout>
