---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="VenueLoom Super Admin" description="Platform administration for VenueLoom organizations.">
  <main class="min-h-screen bg-stone-100 py-8">
    <div class="mx-auto grid w-[min(96vw,96rem)] gap-6">
      <header class="rounded-3xl bg-stone-950 p-7 text-white shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-xs font-black uppercase tracking-[.16em] text-stone-400">VenueLoom platform</p>
            <h1 class="mt-2 text-4xl font-black">Super Admin</h1>
            <p class="mt-3 max-w-4xl text-sm leading-6 text-stone-300">Organization, subscription, health, domain, integration, entitlement, migration and usage oversight. Support sessions are read-only, reason-required, time-limited and auditable.</p>
          </div>
          <div class="flex flex-wrap gap-2 text-xs font-black">
            <a href="/admin/" class="rounded-full border border-white/20 px-4 py-2.5">Admin home</a>
            <a href="/admin/organization/" class="rounded-full border border-white/20 px-4 py-2.5">Organization Settings</a>
          </div>
        </div>
      </header>

      <section data-loading class="rounded-3xl bg-white p-7 shadow-sm"><p class="text-sm text-stone-600">Loading platform state…</p></section>
      <section data-denied class="hidden rounded-3xl bg-white p-7 shadow-sm"><h2 class="text-2xl font-black">Super Admin access required</h2><p data-denied-message class="mt-2 text-sm text-stone-600"></p></section>

      <div data-app class="hidden grid gap-6">
        <section data-support-banner class="hidden rounded-3xl border-2 border-amber-300 bg-amber-50 p-5">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div><p class="text-xs font-black uppercase tracking-[.12em] text-amber-800">Read-only support mode</p><h2 data-support-title class="mt-1 text-xl font-black text-stone-900"></h2><p data-support-meta class="mt-1 text-sm text-stone-700"></p></div>
            <button data-exit-support class="rounded-full bg-stone-900 px-5 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Exit support mode</button>
          </div>
        </section>

        <section data-summary class="grid gap-3 sm:grid-cols-2 xl:grid-cols-6"></section>

        <section class="rounded-3xl bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div><p class="text-xs font-black uppercase tracking-[.14em] text-stone-500">Organizations</p><h2 class="mt-2 text-2xl font-black">Tenant fleet</h2></div>
            <div class="flex flex-wrap gap-2"><input data-search placeholder="Search organization…" class="min-w-64 rounded-full border border-stone-300 px-4 py-2.5 text-sm"><button data-refresh class="rounded-full border border-stone-300 px-4 py-2.5 text-xs font-black uppercase tracking-[.08em]">Refresh</button><button data-usage-button class="rounded-full border border-stone-300 px-4 py-2.5 text-xs font-black uppercase tracking-[.08em]">Usage metrics</button><a href="/api/admin/platform?view=support-audit.csv" class="rounded-full border border-stone-300 px-4 py-2.5 text-xs font-black uppercase tracking-[.08em]">Export audit CSV</a><button data-create-sandbox class="rounded-full bg-stone-900 px-4 py-2.5 text-xs font-black uppercase tracking-[.08em] text-white">Create safe sandbox tenant</button></div>
          </div>
          <p data-message class="mt-3 text-sm text-stone-600"></p>
          <div data-organizations class="mt-5 grid gap-3"></div>
        </section>

        <section data-usage class="hidden rounded-3xl bg-white p-6 shadow-sm">
          <div class="flex items-end justify-between gap-3">
            <div><p class="text-xs font-black uppercase tracking-[.14em] text-stone-500">Platform usage</p><h2 class="mt-2 text-2xl font-black">Tenant footprint</h2></div>
            <button data-close-usage class="rounded-full border border-stone-300 px-4 py-2 text-xs font-black uppercase tracking-[.08em]">Close</button>
          </div>
          <div data-usage-summary class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-6"></div>
          <div data-usage-rows class="mt-5 grid gap-2"></div>
        </section>

        <section data-detail class="hidden rounded-3xl bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div><p class="text-xs font-black uppercase tracking-[.14em] text-stone-500">Tenant detail</p><h2 data-detail-title class="mt-2 text-2xl font-black"></h2></div>
            <button data-close-detail class="rounded-full border border-stone-300 px-4 py-2 text-xs font-black uppercase tracking-[.08em]">Close</button>
          </div>
          <p data-detail-message class="mt-3 text-sm text-stone-600"></p>
          <div data-detail-grid class="mt-5 grid gap-4 xl:grid-cols-2"></div>
        </section>

        <section class="rounded-3xl bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div><p class="text-xs font-black uppercase tracking-[.14em] text-stone-500">Support audit</p><h2 class="mt-2 text-2xl font-black">Recent read-only support sessions</h2></div>
            <a href="/api/admin/platform?view=support-audit.csv" class="rounded-full border border-stone-300 px-4 py-2 text-xs font-black uppercase tracking-[.08em]">Download full audit</a>
          </div>
          <div data-support-history class="mt-5 grid gap-2"></div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const $=(s)=>document.querySelector(s);
    let state=null;
    let activeSupportToken='';
    let currentDetailTenant='';
    let currentDetail=null;
    const esc=(v)=>String(v??'').replace(/[&<>"']/g,(ch)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    const fmt=(v)=>v?new Date(v).toLocaleString():'—';
    const shortHash=(v)=>v?String(v).slice(0,12)+'…':'—';
    const pill=(label,good=true)=>'<span class="rounded-full px-2 py-1 text-[.62rem] font-black uppercase tracking-[.05em] '+(good?'bg-emerald-100 text-emerald-800':'bg-amber-100 text-amber-800')+'">'+esc(label)+'</span>';
    const statusPill=(status)=>'<span class="rounded-full px-2 py-1 text-[.62rem] font-black uppercase tracking-[.05em] '+(status==='green'?'bg-emerald-100 text-emerald-800':status==='red'?'bg-rose-100 text-rose-800':'bg-amber-100 text-amber-800')+'">'+esc(status)+'</span>';

    async function api(path='',options={}

    async function post(payload){
      return api('',{method:'POST',body:JSON.stringify(payload)});
    }){
      const response=await fetch('/api/admin/platform'+path,{cache:'no-store',...options,headers:{'Content-Type':'application/json',...(options.headers||{})}});
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw Object.assign(new Error(data.error||'Platform request failed.'),{data,status:response.status});
      return data;
    }

    function summaryCard(value,label){
      return '<article class="rounded-2xl bg-white p-5 shadow-sm"><strong class="text-3xl text-stone-900">'+esc(value)+'</strong><p class="mt-1 text-xs font-semibold text-stone-500">'+esc(label)+'</p></article>';
    }

    function render(){
      if(!state)return;
      const s=state.summary||{};
      $('[data-summary]').innerHTML=[
        [s.organizations||0,'Organizations'],
        [s.active||0,'Active'],
        [s.trial||0,'Trial'],
        [s.suspended||0,'Suspended'],
        [s.attention||0,'Needs attention'],
        [s.subscriptionsActive||0,'Active subscriptions'],
      ].map(([v,l])=>summaryCard(v,l)).join('');

      const q=String($('[data-search]').value||'').toLowerCase();
      const rows=(state.organizations||[]).filter((row)=>!q||[row.displayName,row.slug,row.status].join(' ').toLowerCase().includes(q));
      $('[data-organizations]').innerHTML=rows.map((row)=>{
        const health=row.health?.healthy===true?pill('healthy',true):row.health?.healthy===false?pill((row.health.failed||0)+' failed',false):pill('no health sample',false);
        const subscription=row.subscription?.status||'not_configured';
        const domains=(row.domainSummary?.verified||0)+'/'+(row.domainSummary?.total||0)+' verified';
        const integrationReady=(row.integrations||[]).filter((i)=>i.configured).length;
        const sandbox=row.isSandbox?pill('sandbox',true):'';
        return '<article class="grid gap-4 rounded-2xl border border-stone-200 p-5 xl:grid-cols-[1.4fr_.8fr_.8fr_.8fr_auto] xl:items-center">'
          +'<div><div class="flex flex-wrap items-center gap-2"><strong class="text-lg text-stone-900">'+esc(row.displayName)+'</strong>'+pill(row.status,!['past_due','suspended','canceled'].includes(row.status))+health+sandbox+'</div><p class="mt-1 text-xs text-stone-500">'+esc(row.slug)+' · '+(row.legacyCompatibility?'Koa compatibility storage':'tenant-native storage')+'</p></div>'
          +'<div><p class="text-[.65rem] font-black uppercase text-stone-400">Subscription</p><p class="mt-1 text-sm font-semibold">'+esc(subscription)+'</p></div>'
          +'<div><p class="text-[.65rem] font-black uppercase text-stone-400">Domains</p><p class="mt-1 text-sm font-semibold">'+esc(domains)+'</p></div>'
          +'<div><p class="text-[.65rem] font-black uppercase text-stone-400">Integrations</p><p class="mt-1 text-sm font-semibold">'+integrationReady+'/'+((row.integrations||[]).length)+' configured</p></div>'
          +'<div class="flex flex-wrap gap-2"><button data-detail-id="'+esc(row.id)+'" class="rounded-full border border-stone-300 px-3 py-2 text-xs font-black">Details</button><button data-support-id="'+esc(row.id)+'" class="rounded-full bg-stone-900 px-3 py-2 text-xs font-black text-white">Support mode</button></div>'
          +'</article>';
      }).join('')||'<p class="text-sm text-stone-500">No organizations match.</p>';

      $('[data-support-history]').innerHTML=(state.supportSessions||[]).slice(0,20).map((row)=>'<div class="flex flex-col gap-2 rounded-xl bg-stone-100 px-4 py-3 text-xs sm:flex-row sm:items-center sm:justify-between"><div><strong>'+esc(row.tenantId)+'</strong> · '+esc(row.adminEmail)+'<p class="mt-1 text-stone-500">'+esc(row.reason)+'</p></div><span class="font-bold">'+(row.active?'active':'ended')+' · '+fmt(row.createdAt)+'</span></div>').join('')||'<p class="text-sm text-stone-500">No support sessions yet.</p>';

      document.querySelectorAll('[data-detail-id]').forEach((button)=>button.addEventListener('click',()=>loadDetail(button.dataset.detailId)));
      document.querySelectorAll('[data-support-id]').forEach((button)=>button.addEventListener('click',()=>startSupport(button.dataset.supportId)));
    }

    function entitlementHtml(row,readOnly){
          const defs=state?.entitlements||[];
          return defs.map((key)=>{
            const checked=row.featureFlags?.[key]===true?'checked':'';
            const disabled=readOnly?'disabled':'';
            return '<label class="flex items-center gap-2 rounded-xl bg-stone-100 px-3 py-2 text-xs font-semibold"><input data-entitlement="'+esc(key)+'" type="checkbox" '+checked+' '+disabled+'> '+esc(key.replaceAll('_',' '))+'</label>';
          }).join('');
        }

    function deletionHtml(row,data,readOnly){
          const request=row.deletionRequest;
          const blockers=data.deletionBlockers||[];
          if(readOnly)return '<p class="text-sm text-stone-500">Deletion controls are unavailable in read-only support mode.</p>';
          let body='';
          if(blockers.length)body+='<div class="rounded-xl bg-amber-50 p-3 text-xs text-amber-900"><strong>Deletion blocked:</strong><ul class="mt-1 list-disc pl-5">'+blockers.map((b)=>'<li>'+esc(b)+'</li>').join('')+'</ul></div>';
          if(request&&!request.canceledAt&&!request.completedAt){
            body+='<div class="mt-3 rounded-xl bg-stone-100 p-3 text-xs"><strong>Deletion requested</strong><p class="mt-1">Eligible: '+fmt(request.eligibleAt)+'</p><p class="mt-1">'+esc(request.reason)+'</p></div>'
              +'<div class="mt-3 flex flex-wrap gap-2"><button data-cancel-deletion class="rounded-full border border-stone-300 px-3 py-2 text-xs font-black">Cancel deletion</button><button data-finalize-deletion class="rounded-full bg-red-700 px-3 py-2 text-xs font-black text-white">Finalize after hold</button></div>';
          }else{
            body+='<button data-request-deletion class="mt-3 rounded-full border border-red-300 px-3 py-2 text-xs font-black text-red-800">Request deletion</button>';
          }
          return body;
        }

    async function loadDetail(id,supportToken=''){
      $('[data-message]').textContent='Loading tenant detail…';
      try{
        const data=await api(supportToken?'?support='+encodeURIComponent(supportToken):'?tenant='+encodeURIComponent(id));
        const row=data.organization;
        const readOnly=Boolean(supportToken);
        currentDetailTenant=row.id;
        currentDetail={id,supportToken,row,data};
        $('[data-detail]').classList.remove('hidden');
        $('[data-detail-title]').textContent=row.displayName;
        const migration=data.migrationAudit?.summary||{};
        const migrationDomains=data.migrationAudit?.domains||[];
        const integrations=(row.integrations||[]).map((i)=>'<div class="flex items-center justify-between rounded-xl bg-stone-100 px-3 py-2 text-xs"><span class="capitalize">'+esc(i.provider)+'</span>'+pill(i.configured?'configured':i.status,i.configured)+'</div>').join('');
        const domains=(row.domains||[]).map((d)=>'<div class="rounded-xl bg-stone-100 px-3 py-2 text-xs"><strong>'+esc(d.hostname)+'</strong><span class="ml-2 text-stone-500">'+esc(d.kind)+' · '+esc(d.status)+'</span></div>').join('');
        const migrationRows=migrationDomains.map((m)=>{
          const missing=(m.missingCanonical||[]).slice(0,12);
          const mismatches=(m.checksumMismatches||[]).slice(0,12);
          const details=[...missing.map((key)=>'Missing: '+key),...mismatches.map((row)=>'Checksum: '+row.key)];
          return '<tr class="border-t border-stone-200 align-top"><td class="px-3 py-3 font-semibold">'+esc(m.domain)+'</td><td class="px-3 py-3">'+esc(m.legacyStore||'—')+'</td><td class="px-3 py-3 text-right">'+esc(m.legacyCount??0)+'</td><td class="px-3 py-3 text-right">'+esc(m.mirroredCount??0)+'</td><td class="px-3 py-3 text-right">'+esc(m.missingCanonicalCount??0)+'</td><td class="px-3 py-3 text-right">'+esc(m.checksumMismatchCount??0)+'</td><td class="px-3 py-3 font-mono text-[.65rem]">'+esc(shortHash(m.legacyChecksum))+'</td><td class="px-3 py-3 font-mono text-[.65rem]">'+esc(shortHash(m.canonicalMirrorChecksum))+'</td><td class="px-3 py-3">'+pill(m.retirementStatus|| (m.safeToRetireLegacy?'safe':'blocked'),m.safeToRetireLegacy===true)+(m.safeToRetireAsOf?'<p class="mt-1 whitespace-nowrap text-[.62rem] text-stone-500">as of '+esc(fmt(m.safeToRetireAsOf))+'</p>':'')+'</td><td class="px-3 py-3 text-[.65rem] text-stone-600">'+esc((m.blockers||[]).join(' · ')||'None')+(details.length?'<details class="mt-2"><summary class="cursor-pointer font-bold">Show mismatch keys</summary><div class="mt-1 grid gap-1 font-mono">'+details.map((row)=>'<span>'+esc(row)+'</span>').join('')+'</div></details>':'')+'</td></tr>';
        }).join('');
        const leakage=data.sandboxQa?.leakage;
        const onboarding=data.sandboxQa?.onboarding;
        const qaHistory=data.sandboxQa?.history||[];
        const readiness=data.readiness;
        const isSandbox=String(row.slug||'').startsWith('vl-sandbox-');
        const leakageRows=(leakage?.surfaces||[]).map((s)=>'<tr class="border-t border-stone-200"><td class="px-3 py-2 font-semibold">'+esc(s.label)+'</td><td class="px-3 py-2">'+pill(s.passed?'green':'red',s.passed)+'</td><td class="px-3 py-2">'+esc(s.sandboxWrite?'Sandbox write isolated':'Sandbox write failed')+'</td><td class="px-3 py-2">'+esc(s.koaCannotReadSandbox?'Koa cannot read sandbox':'Koa read sandbox data')+'</td><td class="px-3 py-2">'+esc(s.sandboxCannotReadKoa?'Sandbox cannot read Koa':'Sandbox read Koa data')+'</td><td class="px-3 py-2 text-rose-700">'+esc(s.failure||'')+'</td></tr>').join('');
        const onboardingRows=(onboarding?.steps||[]).map((s)=>'<tr class="border-t border-stone-200"><td class="px-3 py-2 font-semibold">'+esc(s.id)+'</td><td class="px-3 py-2">'+pill(s.passed?'green':'red',s.passed)+'</td><td class="px-3 py-2">'+esc(s.detail||'')+'</td></tr>').join('');
        const historyRows=qaHistory.slice(0,30).map((h)=>'<div class="flex flex-col gap-1 rounded-xl bg-stone-100 px-3 py-2 text-xs sm:flex-row sm:items-center sm:justify-between"><div><strong>'+esc(h.kind||'qa')+'</strong>'+(h.stage?' · '+esc(h.stage):'')+'<p class="text-stone-500">'+esc(h.runId||'')+'</p></div><div class="text-right"><span class="font-bold">'+(h.summary?.clean?'clean':'review')+'</span><p class="text-stone-500">'+fmt(h.generatedAt||h.archivedAt)+'</p></div></div>').join('');
        const stageOptions=['organization','branding','venue','tax','catalog','team','domain','integrations','templates','stripe','test-proposal','activation'].map((s)=>'<option value="'+esc(s)+'">'+esc(s)+'</option>').join('');
        const readinessRows=(readiness?.criteria||[]).map((item)=>'<div class="grid gap-2 rounded-xl border border-stone-200 px-4 py-3 sm:grid-cols-[auto_1fr] sm:items-start"><div>'+statusPill(item.status)+'</div><div><strong class="text-sm">'+esc(item.label)+'</strong><p class="mt-1 text-xs leading-5 text-stone-600">'+esc(item.detail)+'</p></div></div>').join('');
        const gateStatus=readiness?.ready?'green':(readiness?.summary?.red>0?'red':'yellow');
        const gateCard=isSandbox?'<article class="rounded-2xl border-2 '+(readiness?.ready?'border-emerald-300 bg-emerald-50':'border-stone-300 bg-white')+' p-5 xl:col-span-2"><div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-xs font-black uppercase tracking-[.12em] text-stone-500">Production onboarding gate</p><h3 class="mt-1 text-xl font-black">Tenant ready for real onboarding</h3><p class="mt-2 text-sm font-semibold">'+(readiness?.ready?'UNLOCKED — all seven readiness controls are green.':'LOCKED — every readiness control must be green before a real second tenant can onboard.')+'</p></div>'+statusPill(gateStatus)+'</div><div class="mt-4 grid gap-2">'+(readinessRows||'<p class="text-sm text-stone-500">Readiness has not been evaluated.</p>')+'</div><p class="mt-4 text-xs text-stone-500">'+esc((readiness?.summary?.green||0)+'/'+(readiness?.summary?.total||7)+' green · '+(readiness?.summary?.yellow||0)+' yellow · '+(readiness?.summary?.red||0)+' red')+'</p></article>':'';
        const qaActions=isSandbox&&!supportToken?'<div class="mt-4 grid gap-3"><div class="flex flex-wrap gap-2"><button data-run-leakage class="rounded-full bg-stone-900 px-4 py-2 text-xs font-black text-white">Run leakage test</button><button data-run-onboarding class="rounded-full border border-stone-300 px-4 py-2 text-xs font-black">Run onboarding QA</button><select data-onboarding-stage class="rounded-full border border-stone-300 px-4 py-2 text-xs font-bold">'+stageOptions+'</select><button data-run-stage class="rounded-full border border-stone-300 px-4 py-2 text-xs font-black">Rerun selected stage</button></div><div class="flex flex-wrap gap-2 border-t border-stone-200 pt-3"><button data-reset-sandbox class="rounded-full border border-amber-400 bg-amber-50 px-4 py-2 text-xs font-black text-amber-900">Reset sandbox data</button><button data-delete-sandbox class="rounded-full border border-rose-400 bg-rose-50 px-4 py-2 text-xs font-black text-rose-800">Delete sandbox tenant</button></div></div>':'';
        const qaCard=isSandbox?'<article class="rounded-2xl border border-stone-200 p-5 xl:col-span-2"><h3 class="font-black">Tenant #2 validation</h3><div class="mt-3 grid gap-3 sm:grid-cols-2"><div class="rounded-xl bg-stone-100 p-4"><p class="text-xs font-black uppercase text-stone-500">Cross-tenant leakage</p><p class="mt-1 text-sm font-semibold">'+(leakage?(leakage.summary?.clean?'Clean · ':'Failed · ')+(leakage.summary?.passed||0)+'/'+(leakage.summary?.surfaces||0)+' surfaces':'Not run')+'</p><p class="mt-1 text-xs text-stone-500">'+(leakage?fmt(leakage.generatedAt):'')+'</p></div><div class="rounded-xl bg-stone-100 p-4"><p class="text-xs font-black uppercase text-stone-500">Onboarding journey</p><p class="mt-1 text-sm font-semibold">'+(onboarding?(onboarding.summary?.clean?'Clean · ':'Failed · ')+(onboarding.summary?.passed||0)+'/'+(onboarding.summary?.steps||0)+' steps':'Not run')+'</p><p class="mt-1 text-xs text-stone-500">'+(onboarding?fmt(onboarding.generatedAt):'')+'</p></div></div>'+qaActions+'<div class="mt-5 overflow-x-auto"><h4 class="font-black">Leakage surfaces</h4><table class="mt-2 min-w-[900px] w-full text-xs"><thead class="bg-stone-100 text-left"><tr><th class="px-3 py-2">Surface</th><th class="px-3 py-2">Result</th><th class="px-3 py-2">Sandbox write</th><th class="px-3 py-2">Koa → sandbox</th><th class="px-3 py-2">Sandbox → Koa</th><th class="px-3 py-2">Failure</th></tr></thead><tbody>'+(leakageRows||'<tr><td class="px-3 py-3 text-stone-500" colspan="6">Leakage test has not run.</td></tr>')+'</tbody></table><p class="mt-2 text-xs font-semibold">'+(leakage?.scheduledJobs?.passed?'Scheduled-job namespaces are isolated.':'Scheduled-job isolation not yet proven.')+'</p></div><div class="mt-5 overflow-x-auto"><h4 class="font-black">Onboarding stages</h4><table class="mt-2 min-w-[680px] w-full text-xs"><thead class="bg-stone-100 text-left"><tr><th class="px-3 py-2">Stage</th><th class="px-3 py-2">Result</th><th class="px-3 py-2">Detail</th></tr></thead><tbody>'+(onboardingRows||'<tr><td class="px-3 py-3 text-stone-500" colspan="3">Onboarding QA has not run.</td></tr>')+'</tbody></table></div><div class="mt-5"><h4 class="font-black">Historical QA reports</h4><p class="mt-1 text-xs text-stone-500">Preserved in the platform control plane even after a sandbox reset or deletion.</p><div class="mt-2 grid gap-2">'+(historyRows||'<p class="text-xs text-stone-500">No archived QA runs yet.</p>')+'</div></div></article>':'';
        const statusButton=row.id==='koa-events'||readOnly?'':('<button data-status-toggle class="rounded-full border border-stone-300 px-3 py-2 text-xs font-black">'+(row.status==='suspended'?'Reactivate tenant':'Suspend tenant')+'</button>');
        const planButton=readOnly?'':'<button data-plan-change class="rounded-full border border-stone-300 px-3 py-2 text-xs font-black">Change plan</button>';
        const entitlementCard='<article class="rounded-2xl border border-stone-200 p-5 xl:col-span-2"><div class="flex items-end justify-between gap-3"><div><h3 class="font-black">Feature entitlements</h3><p class="mt-1 text-xs text-stone-500">Controls which VenueLoom modules this organization may use.</p></div>'+(readOnly?'':'<button data-save-entitlements class="rounded-full bg-stone-900 px-3 py-2 text-xs font-black text-white">Save entitlements</button>')+'</div><div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">'+entitlementHtml(row,readOnly)+'</div></article>';
        const deletionCard='<article class="rounded-2xl border border-red-200 p-5 xl:col-span-2"><h3 class="font-black text-red-900">Organization deletion safeguards</h3><p class="mt-1 text-xs text-stone-500">Minimum 24-hour cooling-off period. Koa Tenant #1 is permanently excluded. Active billing, verified domains, and connected integrations block deletion.</p><div class="mt-3">'+deletionHtml(row,data,readOnly)+'</div></article>';
        $('[data-detail-grid]').innerHTML=
          '<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Platform status</h3><div class="mt-3 grid gap-2 text-sm"><p><strong>Status:</strong> '+esc(row.status)+'</p><p><strong>Health:</strong> '+(row.health?.healthy===true?'Healthy':row.health?.healthy===false?(row.health.failed+' checks failed'):'No sample')+'</p><p><strong>Last health check:</strong> '+fmt(row.health?.checkedAt)+'</p><p><strong>Subscription:</strong> '+esc(row.subscription?.status||'not configured')+'</p><p><strong>Plan:</strong> '+esc(row.subscription?.plan||'—')+' / '+esc(row.subscription?.interval||'monthly')+' / '+esc(row.subscription?.seats||1)+' seat(s)</p><p><strong>Migration:</strong> '+esc(row.migrationStatus)+'</p><p><strong>Legacy retirement:</strong> '+(migration.safeToRetireLegacy===true?'Safe':row.legacyCompatibility?'Blocked / not yet proven':'Not applicable')+'</p></div><div class="mt-4 flex flex-wrap gap-2">'+statusButton+planButton+'</div></article>'
          +'<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Storage migration summary</h3><div class="mt-3 grid gap-2 text-sm"><p><strong>Legacy objects:</strong> '+esc(migration.legacyObjects??'—')+'</p><p><strong>Mirrored objects:</strong> '+esc(migration.mirroredObjects??'—')+'</p><p><strong>Canonical objects:</strong> '+esc(migration.canonicalObjects??'—')+'</p><p><strong>Missing canonical:</strong> '+esc(migration.missingCanonical??'—')+'</p><p><strong>Checksum mismatches:</strong> '+esc(migration.checksumMismatches??'—')+'</p><p><strong>Critical mismatches:</strong> '+esc(migration.criticalMismatches??'—')+'</p></div></article>'
          +gateCard
          +qaCard
          +'<article class="overflow-hidden rounded-2xl border border-stone-200 xl:col-span-2"><div class="p-5"><h3 class="font-black">Legacy Blob migration dashboard</h3><p class="mt-1 text-xs text-stone-500">Full normalized object checksums are compared per legacy store. A store is safe to retire only when every legacy object is mirrored and every checksum/critical fingerprint matches.</p></div><div class="overflow-x-auto"><table class="min-w-[1050px] w-full text-xs"><thead class="bg-stone-100 text-left"><tr><th class="px-3 py-2">Domain</th><th class="px-3 py-2">Legacy store</th><th class="px-3 py-2 text-right">Legacy</th><th class="px-3 py-2 text-right">Mirrored</th><th class="px-3 py-2 text-right">Missing</th><th class="px-3 py-2 text-right">Mismatch</th><th class="px-3 py-2">Legacy checksum</th><th class="px-3 py-2">Mirror checksum</th><th class="px-3 py-2">Retire</th><th class="px-3 py-2">Remaining blockers</th></tr></thead><tbody>'+migrationRows+'</tbody></table></div></article>'
          +'<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Domains</h3><div class="mt-3 grid gap-2">'+(domains||'<p class="text-sm text-stone-500">No domains configured.</p>')+'</div></article>'
          +'<article class="rounded-2xl border border-stone-200 p-5"><h3 class="font-black">Integrations</h3><div class="mt-3 grid gap-2">'+integrations+'</div></article>'
          +entitlementCard
          +deletionCard;
        $('[data-run-leakage]')?.addEventListener('click',()=>runSandboxQa('run-sandbox-leakage-test'));
        $('[data-run-onboarding]')?.addEventListener('click',()=>runSandboxQa('run-sandbox-onboarding-test'));
        $('[data-run-stage]')?.addEventListener('click',()=>runSandboxStage());
        $('[data-reset-sandbox]')?.addEventListener('click',()=>resetSandbox());
        $('[data-delete-sandbox]')?.addEventListener('click',()=>deleteSandbox());
        $('[data-save-entitlements]')?.addEventListener('click',()=>saveEntitlements(row.id));
        $('[data-status-toggle]')?.addEventListener('click',()=>toggleStatus(row));
        $('[data-plan-change]')?.addEventListener('click',()=>changePlan(row));
        $('[data-request-deletion]')?.addEventListener('click',()=>requestDeletion(row));
        $('[data-cancel-deletion]')?.addEventListener('click',()=>cancelDeletion(row));
        $('[data-finalize-deletion]')?.addEventListener('click',()=>finalizeDeletion(row));
        $('[data-message]').textContent='';
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function saveEntitlements(tenantId){
          const featureFlags={};
          document.querySelectorAll('[data-entitlement]').forEach((input)=>featureFlags[input.dataset.entitlement]=input.checked===true);
          $('[data-detail-message]').textContent='Saving entitlements…';
          try{
            await post({action:'save-entitlements',tenantId,featureFlags});
            $('[data-detail-message]').textContent='Feature entitlements saved.';
            await load();
            await loadDetail(tenantId);
          }catch(error){$('[data-detail-message]').textContent=error.message;}
        }

    async function toggleStatus(row){
          const next=row.status==='suspended'?'active':'suspended';
          const reason=prompt((next==='suspended'?'Reason for suspending ':'Reason for reactivating ')+row.displayName+':');
          if(!reason)return;
          const confirmSlug=prompt('Type the organization slug to confirm: '+row.slug);
          if(confirmSlug!==row.slug){$('[data-detail-message]').textContent='Slug confirmation did not match.';return;}
          try{
            await post({action:'set-tenant-status',tenantId:row.id,status:next,reason,confirmSlug});
            await load();
            await loadDetail(row.id);
          }catch(error){$('[data-detail-message]').textContent=error.message;}
        }

    async function changePlan(row){
          const plan=prompt('Plan key:',row.subscription?.plan||'');
          if(!plan)return;
          const interval=prompt('Billing interval: monthly or annual',row.subscription?.interval||'monthly');
          if(!['monthly','annual'].includes(interval)){return;}
          const seats=Number(prompt('Seats:',String(row.subscription?.seats||1)));
          if(!Number.isFinite(seats)||seats<1)return;
          const confirmSlug=prompt('Type the organization slug to confirm the billing change: '+row.slug);
          if(confirmSlug!==row.slug){$('[data-detail-message]').textContent='Slug confirmation did not match.';return;}
          try{
            $('[data-detail-message]').textContent='Updating plan…';
            const data=await post({action:'update-plan',tenantId:row.id,plan,interval,seats,confirmSlug});
            $('[data-detail-message]').textContent=data.stripe?.stripeUpdated?'Stripe subscription and VenueLoom plan updated.':'VenueLoom plan updated; no Stripe subscription was attached.';
            await load();
            await loadDetail(row.id);
          }catch(error){$('[data-detail-message]').textContent=error.message;}
        }

    async function requestDeletion(row){
          const reason=prompt('Reason for requesting deletion of '+row.displayName+':');
          if(!reason)return;
          const confirmSlug=prompt('Type the organization slug exactly: '+row.slug);
          if(confirmSlug!==row.slug)return;
          try{
            const data=await post({action:'request-deletion',tenantId:row.id,reason,confirmSlug});
            $('[data-detail-message]').textContent='Deletion requested. Earliest final deletion: '+fmt(data.request.eligibleAt);
            await load();
            await loadDetail(row.id);
          }catch(error){
            const blockers=error.data?.blockers;
            $('[data-detail-message]').textContent=blockers?.length?blockers.join(' '):error.message;
          }
        }

    async function cancelDeletion(row){
          if(!confirm('Cancel the deletion request for '+row.displayName+'?'))return;
          try{
            await post({action:'cancel-deletion',tenantId:row.id});
            await load();
            await loadDetail(row.id);
          }catch(error){$('[data-detail-message]').textContent=error.message;}
        }

    async function finalizeDeletion(row){
          const confirmSlug=prompt('Type the organization slug: '+row.slug);
          if(confirmSlug!==row.slug)return;
          const confirmText=prompt('Final destructive confirmation. Type exactly: DELETE '+row.slug);
          if(confirmText!=='DELETE '+row.slug)return;
          if(!confirm('This permanently deletes tenant-native VenueLoom data for '+row.displayName+'. Continue?'))return;
          try{
            await post({action:'finalize-deletion',tenantId:row.id,confirmSlug,confirmText});
            $('[data-detail]').classList.add('hidden');
            $('[data-message]').textContent='Organization deleted after all safeguards passed.';
            await load();
          }catch(error){
            $('[data-detail-message]').textContent=error.data?.eligibleAt?'Cooling-off period ends '+fmt(error.data.eligibleAt):error.message;
          }
        }

    async function startSupport(tenantId){
      const reason=prompt('Reason for entering read-only support mode for '+tenantId+':');
      if(!reason)return;
      $('[data-message]').textContent='Starting audited support session…';
      try{
        const data=await api('',{method:'POST',body:JSON.stringify({action:'create-support-session',tenantId,reason,ttlMinutes:15})});
        activeSupportToken=data.supportToken;
        $('[data-support-banner]').classList.remove('hidden');
        $('[data-support-title]').textContent='Supporting '+tenantId;
        $('[data-support-meta]').textContent='Read-only · expires '+fmt(data.session.expiresAt)+' · Reason: '+data.session.reason;
        await loadDetail(tenantId,activeSupportToken);
        await load();
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function exitSupport(){
      if(!activeSupportToken)return;
      try{await api('',{method:'POST',body:JSON.stringify({action:'end-support-session',supportToken:activeSupportToken})});}catch{}
      activeSupportToken='';
      $('[data-support-banner]').classList.add('hidden');
      $('[data-detail]').classList.add('hidden');
      await load();
    }

    async function runSandboxQa(action){
      if(!currentDetailTenant)return;
      $('[data-message]').textContent=action==='run-sandbox-leakage-test'?'Running full Tenant #2 leakage test…':'Running Tenant #2 onboarding journey…';
      try{
        const data=await api('',{method:'POST',body:JSON.stringify({action,tenantId:currentDetailTenant})});
        const report=data.leakageTest||data.onboardingTest;
        $('[data-message]').textContent=report?.summary?.clean?'Validation passed cleanly.':'Validation completed with failures. Review the tenant detail.';
        await loadDetail(currentDetailTenant);
        await load();
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function runSandboxStage(){
      if(!currentDetailTenant)return;
      const stage=$('[data-onboarding-stage]')?.value;
      if(!stage)return;
      $('[data-message]').textContent='Rerunning sandbox onboarding stage: '+stage+'…';
      try{
        const data=await api('',{method:'POST',body:JSON.stringify({action:'run-sandbox-onboarding-stage',tenantId:currentDetailTenant,stage})});
        const report=data.onboardingStageTest;
        $('[data-message]').textContent=report?.summary?.clean?'Stage passed: '+stage+'.':'Stage needs review: '+stage+'.';
        await loadDetail(currentDetailTenant);
        await load();
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function resetSandbox(){
      if(!currentDetailTenant)return;
      if(!confirm('Reset this sandbox? Tenant-scoped test data and synthetic memberships will be deleted. Historical QA reports will be preserved.'))return;
      $('[data-message]').textContent='Resetting sandbox tenant…';
      try{
        await api('',{method:'POST',body:JSON.stringify({action:'reset-sandbox-tenant',tenantId:currentDetailTenant})});
        $('[data-message]').textContent='Sandbox reset completed. Historical QA reports were preserved.';
        await load();
        await loadDetail(currentDetailTenant);
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function deleteSandbox(){
      if(!currentDetailTenant)return;
      if(!confirm('Delete this sandbox tenant? Tenant data, synthetic memberships, and the active control-plane organization will be removed. Historical QA reports will be retained.'))return;
      $('[data-message]').textContent='Deleting sandbox tenant…';
      try{
        await api('',{method:'POST',body:JSON.stringify({action:'delete-sandbox-tenant',tenantId:currentDetailTenant})});
        $('[data-detail]').classList.add('hidden');
        currentDetailTenant='';
        $('[data-message]').textContent='Sandbox tenant deleted. Historical QA reports remain archived in the platform control plane.';
        await load();
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function createSandbox(){
      if(!confirm('Create a tenant-native sandbox and immediately run the cross-tenant leakage test plus the safe end-to-end onboarding QA? External providers, DNS and Stripe charges stay simulated/off.'))return;
      $('[data-message]').textContent='Creating isolated sandbox tenant…';
      try{
        const data=await api('',{method:'POST',body:JSON.stringify({action:'create-sandbox-tenant',runChecks:true})});
        const leak=data.leakageTest?.summary;
        const onboard=data.onboardingTest?.summary;
        $('[data-message]').textContent='Created '+data.organization.displayName+' ('+data.organization.slug+'). Leakage '+(leak?.clean?'clean':'needs review')+'; onboarding '+(onboard?.clean?'clean':'needs review')+'. No Koa writes, DNS changes, provider connections, emails, or Stripe charges were performed.';
        await load();
        await loadDetail(data.organization.id);
      }catch(error){$('[data-message]').textContent=error.message;}
    }

    async function loadUsage(){
          $('[data-usage]').classList.remove('hidden');
          $('[data-usage-rows]').innerHTML='<p class="text-sm text-stone-500">Calculating tenant storage footprint…</p>';
          try{
            const usage=await api('?view=usage');
            const t=usage.totals||{};
            $('[data-usage-summary]').innerHTML=[
              [t.canonicalObjects||0,'Canonical objects'],
              [t.memberships||0,'Memberships'],
              [t.seats||0,'Configured seats'],
              [t.verifiedDomains||0,'Verified domains'],
              [t.connectedIntegrations||0,'Connected integrations'],
              [t.supportSessions||0,'Support sessions'],
            ].map(([v,l])=>summaryCard(v,l)).join('');
            $('[data-usage-rows]').innerHTML=(usage.organizations||[]).map((row)=>'<div class="grid gap-2 rounded-xl bg-stone-100 px-4 py-3 text-xs sm:grid-cols-[1.5fr_repeat(5,.7fr)]"><strong>'+esc(row.displayName)+'</strong><span>'+esc(row.canonicalObjects)+' objects</span><span>'+esc(row.memberships)+' users</span><span>'+esc(row.seats)+' seats</span><span>'+esc(row.verifiedDomains)+' domains</span><span>'+esc(row.connectedIntegrations)+' integrations</span></div>').join('');
          }catch(error){$('[data-usage-rows]').innerHTML='<p class="text-sm text-red-700">'+esc(error.message)+'</p>';}
        }

    async function load(){
      try{
        const session=await getAdminSession();
        $('[data-loading]').classList.add('hidden');
        if(!session){throw new Error('Sign in with a VenueLoom Super Admin account.');}
        state=await api();
        $('[data-denied]').classList.add('hidden');
        $('[data-app]').classList.remove('hidden');
        render();
      }catch(error){
        $('[data-app]').classList.add('hidden');
        $('[data-denied]').classList.remove('hidden');
        $('[data-denied-message]').textContent=error.message;
      }
    }

    $('[data-search]')?.addEventListener('input',render);
    $('[data-refresh]')?.addEventListener('click',load);
    $('[data-usage-button]')?.addEventListener('click',loadUsage);
    $('[data-close-usage]')?.addEventListener('click',()=> $('[data-usage]').classList.add('hidden'));
    $('[data-create-sandbox]')?.addEventListener('click',createSandbox);
    $('[data-close-detail]')?.addEventListener('click',()=> $('[data-detail]').classList.add('hidden'));
    $('[data-exit-support]')?.addEventListener('click',exitSupport);
    load();
  </script>
</BaseLayout>
