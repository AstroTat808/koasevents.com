    function addLine(line={id:'',description:'',quantity:1,unitPrice:0,custom:false,catalogItemId:'',quickBooksItemId:'',category:'',unitLabel:'',getExempt:false}) {
      const row=document.createElement('div'); row.className='grid gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 lg:grid-cols-[2fr_.55fr_.8fr_auto_auto] lg:items-end';
      row.innerHTML='<label class="grid gap-1 text-xs font-semibold">Description<input data-line-description class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><label class="grid gap-1 text-xs font-semibold">Qty<input data-line-quantity type="number" min="1" step="1" class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><label class="grid gap-1 text-xs font-semibold">Unit price<input data-line-price type="number" min="0" step="0.01" class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><label class="flex items-center gap-2 rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2 text-xs font-semibold"><input data-line-get-exempt type="checkbox"> GET exempt</label><button type="button" data-remove-line class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-xs">Remove</button>';
      row.dataset.lineId=line.id||'line-'+Date.now();
      row.dataset.custom=String(Boolean(line.custom));
      row.dataset.catalogItemId=line.catalogItemId||'';
      row.dataset.quickBooksItemId=line.quickBooksItemId||'';
      row.dataset.category=line.category||'';
      row.dataset.unitLabel=line.unitLabel||'';
      row.querySelector('[data-line-get-exempt]').checked=line.getExempt===true;
      row.querySelector('[data-line-description]').value=line.description||'';
      row.querySelector('[data-line-quantity]').value=String(line.quantity||1);
      row.querySelector('[data-line-price]').value=String(line.unitPrice||0);
      row.querySelector('[data-remove-line]').addEventListener('click',()=>{row.remove();recalcEditor();});
      row.querySelectorAll('input').forEach((input)=>input.addEventListener('input',recalcEditor));
      row.querySelector('[data-line-get-exempt]').addEventListener('change',recalcEditor);
