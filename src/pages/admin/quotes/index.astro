    function proposalLines() {
      return [...lineItems.children].map((row)=>{
        const unitPrice=Number(row.querySelector('[data-line-price]').value||0);
        return {id:row.dataset.lineId||'',description:row.querySelector('[data-line-description]').value,quantity:Number(row.querySelector('[data-line-quantity]').value||1),unitPrice,custom:row.dataset.custom==='true' && unitPrice<=0,catalogItemId:row.dataset.catalogItemId||'',quickBooksItemId:row.dataset.quickBooksItemId||'',category:row.dataset.category||'',unitLabel:row.dataset.unitLabel||'',getExempt:row.querySelector('[data-line-get-exempt]').checked};
      });
    }
    function proposalPayments() {
      return [...paymentItems.children].map((row)=>({label:row.querySelector('[data-payment-label]').value,dueDate:row.querySelector('[data-payment-date]').value,amount:Number(row.querySelector('[data-payment-amount]').value||0)}));
    }
    function recalcEditor() {
      const lines=proposalLines();
      const subtotal=lines.reduce((sum,line)=>sum+(line.quantity*line.unitPrice),0);
      const discount=Math.min(subtotal,Number(proposalForm.elements.discountAmount.value||0));
      const taxableGross=lines.filter((line)=>!line.getExempt).reduce((sum,line)=>sum+(line.quantity*line.unitPrice),0);
      const taxableAfterDiscount=subtotal>0?Math.max(0,taxableGross-(discount*taxableGross/subtotal)):0;
      const taxRate=4.712;
      proposalForm.elements.taxRate.value='4.712';
      editorTotal.textContent=money((subtotal-discount)+(taxableAfterDiscount*taxRate/100));
    }

    function openProposal(record) {
      editingRecord=record; proposalForm.reset(); lineItems.innerHTML=''; paymentItems.innerHTML='';
      proposalForm.elements.recordId.value=record.id;
      proposalForm.elements.status.value=record.proposal?.status||'draft';
      proposalForm.elements.expirationDate.value=record.proposal?.expirationDate||'';
      proposalForm.elements.eventDate.value=record.customer?.eventDate||'';
      proposalForm.elements.name.value=record.customer?.name||'';
      proposalForm.elements.email.value=record.customer?.email||'';
      proposalForm.elements.phone.value=record.customer?.phone||'';
      proposalForm.elements.notes.value=record.customer?.notes||'';
      proposalForm.elements.discountAmount.value=String(record.proposal?.discountAmount||0);
      proposalForm.elements.taxRate.value='4.712';
      proposalForm.elements.depositAmount.value=String(record.proposal?.depositAmount||0);
      proposalForm.elements.notesToClient.value=record.proposal?.notesToClient||'';
      (record.proposal?.lineItems||[]).forEach(addLine); if(!(record.proposal?.lineItems||[]).length)addLine();
      (record.proposal?.paymentSchedule||[]).forEach(addPayment); if(!(record.proposal?.paymentSchedule||[]).length)addPayment();
      proposalTitle.textContent=record.id+' · '+packageLabel(recordPackage(record));
      const canOpen=record.proposal?.publicToken && record.proposal?.status!=='draft';
      proposalLinkWrap.classList.toggle('hidden',!canOpen);
      copyClientLink?.classList.toggle('hidden',!canOpen);
      if(canOpen) proposalLink.href='/proposal/?token='+encodeURIComponent(record.proposal.publicToken);
      const accepted=record.proposal?.acceptance;
      acceptanceInfo.classList.toggle('hidden',!accepted);
      if(accepted) acceptanceInfo.textContent='Accepted by '+accepted.name+' on '+dateTime(accepted.acceptedAt)+'.';
      renderQboProposal(record);
      proposalMessage.textContent=''; recalcEditor(); proposalDialog.showModal();
    }

    function printProposal(record) {
      const p=record.proposal||{}; const lines=(p.lineItems||[]).map((line)=>'<tr><td>'+escapeHtml(line.description)+(line.getExempt?' <small>(GET exempt)</small>':'')+'</td><td>'+Number(line.quantity||1)+'</td><td>'+money(line.unitPrice)+'</td><td>'+money(line.amount)+'</td></tr>').join('');
      const payments=(p.paymentSchedule||[]).map((item)=>'<li>'+escapeHtml(item.label)+' — '+(item.dueDate?escapeHtml(item.dueDate):'Date TBD')+' — '+money(item.amount)+'</li>').join('');
      const received=Number(record.bookingSummary?.paymentsReceived||record.bookingSummary?.paid||0);
      const remaining=Math.max(0,Number(p.total||0)-received);
      const w=window.open('','_blank'); if(!w)return; w.opener=null;
      w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>'+escapeHtml(record.id)+'</title><style>body{font-family:Arial,sans-serif;color:#173D30;margin:48px;line-height:1.5}h1,h2{font-family:Georgia,serif}header{border-bottom:2px solid #173D30;padding-bottom:20px;margin-bottom:28px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:12px}.box{border:1px solid #ddd8cc;border-radius:12px;padding:16px}table{width:100%;border-collapse:collapse;margin-top:16px}th,td{text-align:left;padding:10px;border-bottom:1px solid #ddd8cc}.total{font-size:28px;font-weight:700}.muted{color:#666}@media print{button{display:none}}</style></head><body><header><p>Koa’s Events · Proposal</p><h1>'+escapeHtml(record.id)+'</h1><p class="muted">Status: '+escapeHtml(p.status||record.status)+'</p></header><section class="meta"><div class="box"><strong>Client</strong><br>'+escapeHtml(record.customer?.name||'TBD')+'<br>'+escapeHtml(record.customer?.email||'')+'<br>'+escapeHtml(record.customer?.phone||'')+'</div><div class="box"><strong>Event</strong><br>'+escapeHtml(record.customer?.eventDate||'Date TBD')+'<br>'+escapeHtml(packageLabel(recordPackage(record)))+'</div></section><h2>Pricing</h2><table><thead><tr><th>Item</th><th>Qty</th><th>Unit</th><th>Amount</th></tr></thead><tbody>'+lines+'</tbody></table><p>Subtotal: '+money(p.subtotal)+'</p><p>Discount: -'+money(p.discountAmount)+'</p><p>Hawaiʻi GET (4.712%): '+money(p.taxAmount)+'</p><p class="total">Total: '+money(p.total)+'</p><p>Deposit: '+money(p.depositAmount)+'</p><p>Payments Received: '+money(received)+'</p><p><strong>Remaining Balance: '+money(remaining)+'</strong></p><h2>Payment schedule</h2><ul>'+payments+'</ul><h2>Notes</h2><p>'+escapeHtml(p.notesToClient||'')+'</p><button onclick="window.print()">Print / Save PDF</button></body></html>');
      w.document.close();
    }
    function escapeHtml(value){return String(value??'').replace(/[&<>"']/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));}

    async function load(query='') {
      const user=await getUser(); if(!hasAdminAccess(user)){unauthorized?.classList.remove('hidden');return;}
      managerAccess=hasManagerAccess(user); applyRoleUi();
      ui?.classList.remove('hidden'); if(message)message.textContent='Loading…';
      const [response,qboResponse]=await Promise.all([
        fetch('/api/admin/quotes'+(query?'?q='+encodeURIComponent(query):''),{cache:'no-store'}),
        fetch('/api/admin/quickbooks',{cache:'no-store'})
      ]);
      if(response.status===401){ui?.classList.add('hidden');unauthorized?.classList.remove('hidden');return;}
      if(!response.ok){if(message)message.textContent='Unable to load CRM data.';return;}
      payload=await response.json();
      qboState=qboResponse.ok?await qboResponse.json():null;
      if(catalogPicker){
        const current=catalogPicker.value;
        catalogPicker.innerHTML='<option value="">Add from catalog…</option>';
        (qboState?.catalog||[]).filter((item)=>item.active!==false).forEach((item)=>{
          const option=document.createElement('option');
          option.value=item.id;
          option.textContent=item.name+' · '+money(item.unitPrice)+' / '+(item.unitLabel||'each');
          catalogPicker.appendChild(option);
        });
        catalogPicker.value=current;
      }
      const liveIds=new Set((payload.records||[]).map((record)=>record.id));
      [...selectedRecordIds].forEach((id)=>{if(!liveIds.has(id))selectedRecordIds.delete(id);});
      updateSelectionUi();
      if(message)message.textContent=(payload.records||[]).length+' CRM records · '+(payload.quotes||[]).length+' saved quotes shown.';
      renderStats();renderWorkQueue();renderUnansweredLeads();renderFunnel();renderMobileBar();renderPipeline();renderLostLeads();renderPaymentDashboard();renderBookedDashboard();renderReviewDashboard();renderQuotes();renderTrash();
    }

    searchForm?.addEventListener('submit',(event)=>{event.preventDefault();load(String(searchInput?.value||'').trim());});
    [mobileFilterStage,mobileFilterPackage,mobileFilterQuote,mobileFilterFollowup,mobileFilterMargin,mobileSort].forEach((control)=>control?.addEventListener('change',renderMobileBar));
    mobileProfitScope?.addEventListener('change',renderProfitabilityDashboard);
    mobileProfitPeriod?.addEventListener('change',()=>{
      const range=profitabilityDateRange();
      if(range.period==='custom'){
        const today=new Date();
        if(mobileProfitFrom&&!mobileProfitFrom.value)mobileProfitFrom.value=today.getFullYear()+'-01-01';
        if(mobileProfitTo&&!mobileProfitTo.value)mobileProfitTo.value=localDateKey(today);
      }
      renderProfitabilityDashboard();
    });
    [mobileProfitFrom,mobileProfitTo].forEach((control)=>control?.addEventListener('change',renderProfitabilityDashboard));
    mobileProfitGoalForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      const target=Math.max(0,Number(mobileProfitGoalInput?.value||0));
      if(mobileProfitGoalMessage)mobileProfitGoalMessage.textContent='Saving monthly gross-profit target…';
      try{
        const result=await api({action:'update-mobile-bar-profit-settings',settings:{monthlyGrossProfitTarget:target}});
        payload.mobileBarProfitSettings=result.settings||{monthlyGrossProfitTarget:target};
        if(mobileProfitGoalMessage)mobileProfitGoalMessage.textContent='Monthly gross-profit target saved.';
        renderMobileProfitGoalProjection();
      }catch(error){
        if(mobileProfitGoalMessage)mobileProfitGoalMessage.textContent=error?.message||'Unable to save profit goal.';
      }
    });
    document.querySelectorAll('[data-close-convert]').forEach((button)=>button.addEventListener('click',()=>convertDialog.close()));
    document.querySelectorAll('[data-close-proposal]').forEach((button)=>button.addEventListener('click',()=>proposalDialog.close()));
    document.querySelectorAll('[data-close-profit]').forEach((button)=>button.addEventListener('click',()=>profitDialog?.close()));
    profitForm?.querySelectorAll('input,textarea').forEach((input)=>input.addEventListener('input',recalcProfitDialog));
    profitForm?.elements.costMode?.addEventListener('change',recalcProfitDialog);
    document.querySelector('[data-add-line]')?.addEventListener('click',()=>addLine());
    catalogPicker?.addEventListener('change',()=>{
      const item=(qboState?.catalog||[]).find((entry)=>entry.id===catalogPicker.value);
      if(!item)return;
      addLine({id:'catalog-'+item.id+'-'+Date.now(),description:item.description||item.name,quantity:1,unitPrice:Number(item.unitPrice||0),custom:false,catalogItemId:item.id,quickBooksItemId:item.quickBooksItemId||'',category:item.category||'service',unitLabel:item.unitLabel||'each',getExempt:item.getExempt===true});
      catalogPicker.value='';
      recalcEditor();
    });
    document.querySelector('[data-add-payment]')?.addEventListener('click',()=>addPayment());
    proposalForm?.querySelectorAll('[name="discountAmount"]').forEach((input)=>input.addEventListener('input',recalcEditor));

    convertForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();const data=new FormData(convertForm);convertMessage.textContent='Creating…';
      try{
        const result=await api({action:'convert',quoteId:data.get('quoteId'),kind:data.get('kind'),customer:{name:data.get('name'),email:data.get('email'),phone:data.get('phone'),eventDate:data.get('eventDate'),notes:data.get('notes')}});
        convertMessage.textContent=(result.reused?'Existing record opened: ':'Created ')+result.record.id+'.'; setTimeout(()=>convertDialog.close(),500); await load(String(searchInput?.value||'').trim());
        if(result.record.kind==='proposal') openProposal(result.record);
      }catch(error){convertMessage.textContent=error.message||'Unable to create record.';}
    });

    profitForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      if(!profitRecord)return;
      if(profitMessage)profitMessage.textContent='Saving cost model…';
      try{
        const result=await api({action:'update-profit-model',recordId:profitRecord.id,profitModel:formProfitOverrides()});
        profitRecord=result.record||profitRecord;
        if(profitMessage)profitMessage.textContent='Saved.';
        recalcProfitDialog();
        await load(String(searchInput?.value||'').trim());
      }catch(error){if(profitMessage)profitMessage.textContent=error?.message||'Unable to save cost model.';}
    });

    proposalForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();proposalMessage.textContent='Saving…';const data=new FormData(proposalForm);
      try{
        const result=await api({action:'update-proposal',recordId:data.get('recordId'),proposal:{status:data.get('status'),expirationDate:data.get('expirationDate'),discountAmount:Number(data.get('discountAmount')||0),taxRate:4.712,depositAmount:Number(data.get('depositAmount')||0),notesToClient:data.get('notesToClient'),lineItems:proposalLines(),paymentSchedule:proposalPayments(),customer:{name:data.get('name'),email:data.get('email'),phone:data.get('phone'),eventDate:data.get('eventDate'),notes:data.get('notes')}}});
        editingRecord=result.record;proposalMessage.textContent='Saved.';await load(String(searchInput?.value||'').trim());openProposal(result.record);
      }catch(error){proposalMessage.textContent=error.message||'Unable to save proposal.';}
    });

    document.querySelectorAll('[data-close-activity]').forEach((button)=>button.addEventListener('click',()=>activityDialog?.close()));
    document.querySelectorAll('[data-close-booking]').forEach((button)=>button.addEventListener('click',()=>bookingDialog?.close()));

    qboSyncEstimateButton?.addEventListener('click',async()=>{
      if(!editingRecord||!quickBooksReady())return;
      if(proposalMessage)proposalMessage.textContent='Synchronizing QuickBooks estimate…';
      try{const refreshed=await runQuickBooks('sync-estimate',editingRecord);editingRecord=refreshed;openProposal(refreshed);}catch(error){if(proposalMessage)proposalMessage.textContent=error.message||'Unable to sync QuickBooks estimate.';}
    });

    qboSendEstimateButton?.addEventListener('click',async()=>{
      if(!editingRecord||!quickBooksReady())return;
      if(proposalMessage)proposalMessage.textContent='Emailing estimate from QuickBooks…';
      try{const refreshed=await runQuickBooks('send-estimate',editingRecord);editingRecord=refreshed;openProposal(refreshed);}catch(error){if(proposalMessage)proposalMessage.textContent=error.message||'Unable to email QuickBooks estimate.';}
    });

    qboSyncStatusButton?.addEventListener('click',async()=>{
      if(!bookingRecord||!qboState?.connection?.connected)return;
      if(bookingMessage)bookingMessage.textContent='Synchronizing QuickBooks balances…';
      try{const refreshed=await runQuickBooks('sync-status',bookingRecord);bookingRecord=refreshed;openBooking(refreshed);}catch(error){if(bookingMessage)bookingMessage.textContent=error.message||'Unable to sync QuickBooks.';}
    });

    countersignButton?.addEventListener('click',async()=>{
      if(!bookingRecord)return;
      const name=String(countersignName?.value||'').trim();
      if(name.length<2){if(bookingMessage)bookingMessage.textContent='Enter the authorized Koa’s signer name.';return;}
      if(bookingMessage)bookingMessage.textContent='Recording Koa’s countersignature…';
      try{
        await api({action:'countersign-contract',recordId:bookingRecord.id,name});
        await load(String(searchInput?.value||'').trim());
        const refreshed=(payload.records||[]).find((entry)=>entry.id===bookingRecord.id);
        if(refreshed)openBooking(refreshed);
      }catch(error){if(bookingMessage)bookingMessage.textContent=error.message||'Unable to countersign the agreement.';}
    });

    activityForm?.addEventListener('submit',async(event)=>{
      event.preventDefault(); const data=new FormData(activityForm); if(activityMessage)activityMessage.textContent='Saving…';
      try{
        await api({action:'log-activity',recordId:data.get('recordId'),type:data.get('type'),detail:data.get('detail')});
        activityForm.elements.detail.value='';
        await load(String(searchInput?.value||'').trim());
        const refreshed=(payload.records||[]).find((entry)=>entry.id===data.get('recordId'));
        if(refreshed)openActivity(refreshed);
      }catch(error){if(activityMessage)activityMessage.textContent=error.message||'Unable to save activity.';}
    });

    copyClientLink?.addEventListener('click',async()=>{
      if(!editingRecord?.proposal?.publicToken)return;
      const url=window.location.origin+'/proposal/?token='+encodeURIComponent(editingRecord.proposal.publicToken);
      try{
        await navigator.clipboard.writeText(url);
        copyClientLink.textContent='Copied ✓';
        window.setTimeout(()=>copyClientLink.textContent='Copy client link',1200);
      }catch{
        proposalMessage.textContent='Client link: '+url;
      }
    });
    document.querySelector('[data-print-proposal]')?.addEventListener('click',()=>{if(editingRecord)printProposal(editingRecord);});

    clearSelectionButton?.addEventListener('click',()=>{
      selectedRecordIds.clear();
      updateSelectionUi();
      renderPipeline();
      renderMobileBar();
    });

    bulkLostButton?.addEventListener('click',async()=>{
      const ids=[...selectedRecordIds];
      if(!ids.length)return;
      if(!confirm('Mark '+ids.length+' selected CRM record'+(ids.length===1?'':'s')+' as lost?'))return;
      try{
        const result=await api({action:'bulk-lost',recordIds:ids});
        selectedRecordIds.clear();
        await load(String(searchInput?.value||'').trim());
        if(message)message.textContent=(result.updated||[]).length+' record(s) marked lost'+((result.skipped||[]).length?' · '+result.skipped.length+' skipped':'')+'.';
      }catch(error){if(message)message.textContent=error?.message||'Unable to mark selected records lost.';}
    });

    bulkTrashButton?.addEventListener('click',async()=>{
      const ids=[...selectedRecordIds];
      if(!ids.length)return;
      if(!confirm('Move '+ids.length+' selected CRM record'+(ids.length===1?'':'s')+' to Trash for 30 days?'))return;
      try{
        const result=await api({action:'bulk-trash',recordIds:ids});
        selectedRecordIds.clear();
        await load(String(searchInput?.value||'').trim());
        if(message)message.textContent=(result.moved||[]).length+' record(s) moved to Trash'+((result.skipped||[]).length?' · '+result.skipped.length+' skipped':'')+'.';
      }catch(error){if(message)message.textContent=error?.message||'Unable to move selected records to Trash.';}
    });

    const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
    if (searchInput && initialQuery) searchInput.value = initialQuery;
    updateSelectionUi();
    load(initialQuery);
  </script>
</BaseLayout>
