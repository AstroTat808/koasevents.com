        head.append(text('span','text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]','Website calculator'),text('strong','display text-2xl text-[var(--koa-forest)]',money(record.inquiry.estimatedTotal)));
        estimate.appendChild(head);
        const meta=[record.inquiry.serviceHours?record.inquiry.serviceHours+' hr':'',record.inquiry.bartenderCount?record.inquiry.bartenderCount+' bartenders':'',record.inquiry.oneWayMiles?record.inquiry.oneWayMiles+' mi one-way':'',record.inquiry.glasswareCount?record.inquiry.glasswareCount+' glassware':''].filter(Boolean).join(' · ');
        if(meta) estimate.appendChild(text('p','mt-2 text-[.66rem] leading-5 text-[var(--koa-ink)]/52',meta));
        if(Array.isArray(record.inquiry.customAddOns)&&record.inquiry.customAddOns.length) estimate.appendChild(text('p','mt-2 text-[.66rem] font-semibold text-[var(--koa-clay)]','Custom add-ons · '+record.inquiry.customAddOns.join(', ')));
        if(Array.isArray(record.inquiry.estimateLineItems)&&record.inquiry.estimateLineItems.length){
          const details=document.createElement('details');details.className='mt-3 border-t border-[var(--koa-line)] pt-3';
          const summary=document.createElement('summary');summary.className='cursor-pointer text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]';summary.textContent='Calculator breakdown';
          details.appendChild(summary);
          const list=document.createElement('div');list.className='mt-2 grid gap-1.5';
          record.inquiry.estimateLineItems.forEach((line)=>{
            const row=document.createElement('div');row.className='flex justify-between gap-4 text-[.66rem] text-[var(--koa-ink)]/58';
            row.append(text('span','',line.description||line.id||'Item'),text('strong','shrink-0',money(line.amount||0)));list.appendChild(row);
          });
          details.appendChild(list);estimate.appendChild(details);
        }
        article.appendChild(estimate);
      }

      appendCommunicationStatus(article,record);

      const tasks=mobileFollowups(record);
      const taskBox=document.createElement('div');taskBox.className='mt-4';
      taskBox.appendChild(text('p','text-[.54rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]','Follow-up'));
      if(tasks.length){
        tasks.slice(0,3).forEach((task)=>{
          const row=document.createElement('div');row.className='mt-2 rounded-lg border border-[var(--koa-line)] px-3 py-2';
          row.append(text('strong','text-xs text-[var(--koa-forest)]',task.title||'Follow-up due'),text('p','mt-1 text-[.66rem] leading-5 text-[var(--koa-ink)]/52',task.detail||''));
          taskBox.appendChild(row);
        });
      } else taskBox.appendChild(text('p','mt-2 text-xs text-[var(--koa-ink)]/42','No follow-up task currently due.'));
      article.appendChild(taskBox);

      const actions=document.createElement('div');actions.className='mt-4 flex flex-wrap gap-2';
      const small='rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]';
      const primary='rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-white';
      const plan=workflowPlan(record);
      if(plan.run && record.stage!=='booked') actions.append(actionButton(plan.label,primary,plan.run));
