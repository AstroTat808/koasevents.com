          item.append(head,track);mobileProfitAddons.appendChild(item);
        });
        if(!addons.length)mobileProfitAddons.appendChild(text('p','text-sm text-white/45','Priced enhancements with configured direct-cost ratios will appear here.'));
      }
      renderMobileProfitGoalProjection();
