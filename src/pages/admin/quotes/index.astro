  <script>
    import { getUser } from '@netlify/identity';

    const ui = document.querySelector('[data-admin-ui]');
    const unauthorized = document.querySelector('[data-unauthorized]');
    const pipeline = document.querySelector('[data-pipeline]');
    const workQueue = document.querySelector('[data-work-queue]');
    const workCount = document.querySelector('[data-work-count]');
    const unansweredLeads = document.querySelector('[data-unanswered-leads]');
    const unansweredCount = document.querySelector('[data-unanswered-count]');
    const quoteList = document.querySelector('[data-quote-list]');
    const bookedDashboard = document.querySelector('[data-booked-dashboard]');
    const funnelBody = document.querySelector('[data-funnel]');
    const message = document.querySelector('[data-message]');
    const selectedCount = document.querySelector('[data-selected-count]');
    const bulkLostButton = document.querySelector('[data-bulk-lost]');
    const bulkTrashButton = document.querySelector('[data-bulk-trash]');
    const clearSelectionButton = document.querySelector('[data-clear-selection]');
    const trashList = document.querySelector('[data-trash-list]');
    const trashCount = document.querySelector('[data-trash-count]');
    const lostList = document.querySelector('[data-lost-list]');
    const lostCount = document.querySelector('[data-lost-count]');
    const searchForm = document.querySelector('[data-search-form]');
    const searchInput = document.querySelector('[data-search-input]');
    const mobileRecords = document.querySelector('[data-mobile-records]');
    const mobileReport = document.querySelector('[data-mobile-report]');
    const mobileCount = document.querySelector('[data-mobile-count]');
    const mobileFilterStage = document.querySelector('[data-mobile-filter-stage]');
    const mobileFilterPackage = document.querySelector('[data-mobile-filter-package]');
    const mobileFilterQuote = document.querySelector('[data-mobile-filter-quote]');
    const mobileFilterFollowup = document.querySelector('[data-mobile-filter-followup]');
    const mobileSort = document.querySelector('[data-mobile-sort]');
    const mobileForecast = document.querySelector('[data-mobile-forecast]');
    const mobileConversion = document.querySelector('[data-mobile-conversion]');
    const mobilePackagePopularity = document.querySelector('[data-mobile-package-popularity]');
    const mobileLeadSources = document.querySelector('[data-mobile-lead-sources]');
    const mobileUpcoming = document.querySelector('[data-mobile-upcoming]');
    const mobileStaffing = document.querySelector('[data-mobile-staffing]');

    const convertDialog = document.querySelector('[data-convert-dialog]');
    const convertForm = document.querySelector('[data-convert-form]');
    const convertTitle = document.querySelector('[data-convert-title]');
    const convertSummary = document.querySelector('[data-convert-summary]');
    const convertMessage = document.querySelector('[data-convert-message]');

    const proposalDialog = document.querySelector('[data-proposal-dialog]');
    const proposalForm = document.querySelector('[data-proposal-form]');
    const proposalTitle = document.querySelector('[data-proposal-title]');
    const proposalMessage = document.querySelector('[data-proposal-message]');
    const lineItems = document.querySelector('[data-line-items]');
    const paymentItems = document.querySelector('[data-payment-items]');
    const editorTotal = document.querySelector('[data-editor-total]');
    const proposalLink = document.querySelector('[data-proposal-link]');
    const proposalLinkWrap = document.querySelector('[data-proposal-link-wrap]');
    const acceptanceInfo = document.querySelector('[data-acceptance-info]');
    const copyClientLink = document.querySelector('[data-copy-client-link]');
    const qboProposalStatus = document.querySelector('[data-qbo-proposal-status]');
    const qboSyncEstimateButton = document.querySelector('[data-qbo-sync-estimate]');
    const qboSendEstimateButton = document.querySelector('[data-qbo-send-estimate]');

    const activityDialog = document.querySelector('[data-activity-dialog]');
    const activityForm = document.querySelector('[data-activity-form]');
    const activityList = document.querySelector('[data-activity-list]');
    const activityTitle = document.querySelector('[data-activity-title]');
    const activityMeta = document.querySelector('[data-activity-meta]');
    const activityMessage = document.querySelector('[data-activity-message]');

    const bookingDialog = document.querySelector('[data-booking-dialog]');
    const bookingTitle = document.querySelector('[data-booking-title]');
    const bookingMeta = document.querySelector('[data-booking-meta]');
    const bookingPayments = document.querySelector('[data-booking-payments]');
    const bookingMessage = document.querySelector('[data-booking-message]');
    const bookingClientLink = document.querySelector('[data-booking-client-link]');
    const planningClientLink = document.querySelector('[data-planning-client-link]');
    const countersignPanel = document.querySelector('[data-countersign-panel]');
    const countersignCopy = document.querySelector('[data-countersign-copy]');
    const countersignFormWrap = document.querySelector('[data-countersign-form-wrap]');
    const countersignName = document.querySelector('[data-countersign-name]');
    const countersignButton = document.querySelector('[data-countersign]');
    const qboSyncStatusButton = document.querySelector('[data-qbo-sync-status]');
    const eventOpsLink = document.querySelector('[data-event-ops-link]');

    const approvedAdminEmails = new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    let payload = { quotes: [], analytics: {}, funnel: [], mobileBarAnalytics: {}, conversions: {}, records: [], trash: [] };
    const selectedRecordIds = new Set();
    let editingRecord = null;
    let activityRecord = null;
    let bookingRecord = null;
    let qboState = null;

    const packageNames = {
      'signature-wedding': 'Signature Wedding Experience',
      hibiscus: 'Hibiscus',
      orchid: 'Orchid',
      gardenia: 'Gardenia',
      'mobile-oahu': 'Mobile Bar · Oahu',
      'mobile-maui': 'Mobile Bar · Maui',
      'mobile-big-island': 'Mobile Bar · Big Island',
      'mobile-custom': 'Mobile Bar · Custom',
      'ala-carte': 'Legacy custom quote',
      unspecified: 'Unspecified',
    };
    const stageLabels = { inquiry: 'Inquiries', lead: 'Leads', proposal: 'Proposals', booked: 'Booked' };

    function hasAdminAccess(user) {
      const email = String(user?.email || '').trim().toLowerCase();
      const roles = user?.app_metadata?.roles || [];
      return approvedAdminEmails.has(email) || (Array.isArray(roles) && roles.includes('admin'));
    }
    function money(value) { return new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(Number(value||0)); }
    function dateTime(value) { return value ? new Intl.DateTimeFormat('en-US',{dateStyle:'medium',timeStyle:'short'}).format(new Date(value)) : ''; }
    function text(tag,className,content) { const el=document.createElement(tag); if(className)el.className=className; el.textContent=content; return el; }
    function packageLabel(id) { return packageNames[id] || id || 'Custom / not selected'; }
    function percent(value) { return value == null ? '—' : Math.round(value*100) + '%'; }

    function renderStats() {
      const records = payload.records || [];
      document.querySelector('[data-stat-inquiries]').textContent = String(records.filter((r)=>r.stage==='inquiry').length);
      document.querySelector('[data-stat-leads]').textContent = String(records.filter((r)=>r.stage==='lead').length);
      document.querySelector('[data-stat-proposals]').textContent = String(records.filter((r)=>r.stage==='proposal').length);
      document.querySelector('[data-stat-booked]').textContent = String(records.filter((r)=>r.stage==='booked').length);
      document.querySelector('[data-stat-value]').textContent = money(payload.analytics?.estimatedPipelineValue || 0);
    }

    function renderFunnel() {
      funnelBody.innerHTML='';
      (payload.funnel || []).forEach((row)=>{
        const tr=document.createElement('tr'); tr.className='border-b border-[var(--koa-line)]';
        const values=[
          packageLabel(row.packageId),
          row.views,
          row.saves,
          row.leads,
          row.proposals,
          row.booked,
          'view→save '+percent(row.viewToSave)+' · save→lead '+percent(row.saveToLead)+' · lead→proposal '+percent(row.leadToProposal)+' · proposal→booked '+percent(row.proposalToBooked)
        ];
        values.forEach((value,index)=>{const td=document.createElement('td');td.className='py-4 pr-4 '+(index===0?'font-semibold':'');td.textContent=String(value);tr.appendChild(td);});
        funnelBody.appendChild(tr);
      });
    }

    function recordPackage(record) {
      return record.packageId || record.quote?.state?.startingPoint || record.inquiry?.venuePackage || record.inquiry?.mobileBarPackage || '';
    }

    function actionButton(label, className, handler) {
      const button=document.createElement('button'); button.type='button'; button.className=className; button.textContent=label; button.addEventListener('click',handler); return button;
    }

    async function api(body) {
      const response=await fetch('/api/admin/quotes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      const result=await response.json().catch(()=>({}));
      if(!response.ok) throw new Error(result.error || 'Request failed.');
      return result;
    }

    function updateSelectionUi() {
      if(selectedCount) selectedCount.textContent=selectedRecordIds.size+' selected';
      const disabled=!selectedRecordIds.size;
      [bulkLostButton,bulkTrashButton,clearSelectionButton].forEach((button)=>{
        if(button) {
          button.disabled=disabled;
          button.classList.toggle('opacity-40',disabled);
          button.classList.toggle('cursor-not-allowed',disabled);
        }
      });
    }

    function toggleSelected(recordId, checked) {
      if(checked) selectedRecordIds.add(recordId);
      else selectedRecordIds.delete(recordId);
      updateSelectionUi();
    }

    async function deleteCrmRecord(record) {
      if(!['inquiry','lead'].includes(record.kind) || ['proposal','booked'].includes(record.stage)) return;
      const name=record.customer?.name || record.id;
      if(!confirm('Move '+record.kind+' '+name+' to Trash?\n\nYou can restore it for 30 days. Proposals and booked records are protected.')) return;
      try {
        if(message) message.textContent='Moving '+record.id+' to Trash…';
        await api({action:'delete-record',recordId:record.id});
        selectedRecordIds.delete(record.id);
        await load(String(searchInput?.value||'').trim());
        if(message) message.textContent='Moved '+record.id+' to Trash.';
      } catch(error) {
        if(message) message.textContent=error?.message || 'Unable to move CRM record to Trash.';
      }
    }

    async function qboApi(body) {
      const response=await fetch('/api/admin/quickbooks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      const result=await response.json().catch(()=>({}));
      if(!response.ok) throw new Error(result.error || 'QuickBooks request failed.');
      return result;
    }

    function quickBooksReady() {
      return Boolean(qboState?.connection?.connected && qboState?.settings?.serviceItemId);
    }

    function renderQboProposal(record) {
      const qb=record?.accounting?.quickbooks||{};
      const connected=Boolean(qboState?.connection?.connected);
      const mapped=Boolean(qboState?.settings?.serviceItemId);
      if(qboProposalStatus) {
        qboProposalStatus.textContent=!connected
          ? 'QuickBooks is not connected. Complete QBO Setup before creating estimates.'
          : !mapped
            ? 'QuickBooks is connected, but the default Koa’s service item has not been mapped.'
            : qb.estimateId
              ? 'QuickBooks estimate '+(qb.estimateDocNumber?'#'+qb.estimateDocNumber:qb.estimateId)+' · '+money(qb.estimateTotal||record.proposal?.total||0)+(qb.estimateEmailStatus?' · '+qb.estimateEmailStatus:'')
              : 'Ready to create the QuickBooks estimate from this proposal.';
      }
      if(qboSyncEstimateButton) qboSyncEstimateButton.disabled=!connected||!mapped;
      if(qboSendEstimateButton) qboSendEstimateButton.disabled=!connected||!mapped||!qb.estimateId;
      qboSyncEstimateButton?.classList.toggle('opacity-40',!connected||!mapped);
      qboSendEstimateButton?.classList.toggle('opacity-40',!connected||!mapped||!qb.estimateId);
    }

    async function runQuickBooks(action, record, extra={}) {
      const result=await qboApi({action,recordId:record.id,...extra});
      await load(String(searchInput?.value||'').trim());
      return (payload.records||[]).find((entry)=>entry.id===record.id) || result.record || record;
    }

    async function promote(record, kind, openCreated=false) {
      const result=await api({action:'promote',recordId:record.id,kind});
      await load(String(searchInput?.value||'').trim());
      if(openCreated && result.record?.kind==='proposal') openProposal(result.record);
      return result;
    }

    async function markBooked(record) {
      if(!confirm('Mark '+record.id+' as booked?')) return;
      await api({action:'mark-booked',recordId:record.id});
      await load(String(searchInput?.value||'').trim());
    }

    function workflowPlan(record) {
      const proposalStatus=record.proposal?.status || record.status;
      if(record.stage==='booked') return {label:'Booked',reason:'Event is booked.',priority:99,run:null};
      if(record.stage==='inquiry') return {label:'Qualify lead',reason:'Review the inquiry and advance qualified clients.',priority:2,run:()=>promote(record,'lead')};
      if(record.stage==='lead') return {label:'Build proposal',reason:'Qualified lead is ready for pricing and scope.',priority:4,run:()=>promote(record,'proposal',true)};
      if(record.kind==='proposal' && proposalStatus==='accepted') {
        const summary=record.bookingSummary;
        if(summary?.contractStatus==='signed') return {label:'Manage deposit',reason:'Agreement is signed. Issue or sync the QuickBooks reservation-deposit invoice.',priority:1,run:()=>openBooking(record)};
        return {label:'Open booking',reason:'Proposal accepted. Send the booking agreement and collect signature + deposit.',priority:1,run:()=>openBooking(record)};
      }
      if(record.kind==='proposal' && proposalStatus==='viewed') return {label:'Review + follow up',reason:'Client has viewed the proposal.',priority:3,run:()=>openProposal(record)};
      if(record.kind==='proposal' && proposalStatus==='draft') return {label:'Finalize proposal',reason:'Draft needs final pricing before sharing.',priority:5,run:()=>openProposal(record)};
      if(record.kind==='proposal' && proposalStatus==='sent') return {label:'Open proposal',reason:'Proposal was sent and is awaiting client action.',priority:6,run:()=>openProposal(record)};
      if(record.kind==='proposal') return {label:'Review proposal',reason:'Proposal needs review.',priority:7,run:()=>openProposal(record)};
      return {label:'Review',reason:'Review this record.',priority:8,run:null};
    }

    function relativeAge(value) {
      const time=new Date(value||0).getTime();
      if(!time)return '';
      const hours=Math.max(0,Math.round((Date.now()-time)/3600000));
      if(hours<24)return hours<=1?'Updated recently':hours+'h since update';
      const days=Math.round(hours/24);
      return days+'d since update';
    }

    async function logActivity(record,type,detail='') {
      return await api({action:'log-activity',recordId:record.id,type,detail});
    }

    function logAndOpen(record,type,href) {
      window.location.href=href;
    }

    function activityLabel(type) {
      const labels={
        quote_saved:'Quote saved', inquiry:'Inquiry received', lead:'Lead created', proposal:'Proposal created',
        proposal_sent:'Proposal sent', proposal_viewed:'Proposal viewed', proposal_accepted:'Proposal accepted',
        proposal_declined:'Proposal declined', contract_generated:'Contract generated', contract_viewed:'Contract viewed',
        contract_signed:'Client signed contract', contract_countersigned:'Koa’s countersigned contract',
        quickbooks_estimate_synced:'QBO estimate synced', quickbooks_estimate_sent:'QBO estimate emailed',
        quickbooks_invoice_created:'QBO invoice created', quickbooks_invoice_sent:'QBO invoice emailed',
        quickbooks_status_synced:'QBO status synced', client_planning_updated:'Client planning updated',
        client_document_uploaded:'Client planning document uploaded', client_document_removed:'Client planning document removed',
        event_ops_updated:'Event Ops updated', booked:'Event booked', call:'Call', email:'Email',
        meeting:'Meeting', note:'Note', responded:'Response completed',
        discovery_call_requested:'Discovery Call requested',
        lead_notification_sent:'Team lead email sent', lead_notification_failed:'Team lead email failed',
        client_confirmation_sent:'Client confirmation sent', client_confirmation_failed:'Client confirmation failed',
        lead_response_reminder_sent:'Response reminder sent', lead_response_reminder_failed:'Response reminder failed',
        client_follow_up_sent:'24-hour client follow-up sent', client_follow_up_failed:'24-hour client follow-up failed',
        review_request_sent:'Google review request sent', review_request_failed:'Google review request failed',
        email_sent:'Email sent', email_delivered:'Email delivered', email_bounced:'Email bounced', email_failed:'Email failed'
      };
      return labels[type]||String(type||'Activity').replaceAll('_',' ');
    }

    function emailStatusLabel(status) {
      const normalized=String(status||'').toLowerCase();
      if(normalized==='delivered')return 'Delivered';
      if(normalized==='bounced')return 'Bounced';
      if(normalized==='failed')return 'Failed';
      if(normalized==='sent')return 'Email sent';
      return 'Pending';
    }

    function emailStatusClass(status) {
      const normalized=String(status||'').toLowerCase();
      if(normalized==='delivered')return 'border border-emerald-200 bg-emerald-50 text-emerald-800';
      if(normalized==='bounced'||normalized==='failed')return 'border border-red-200 bg-red-50 text-red-700';
      if(normalized==='sent')return 'border border-blue-200 bg-blue-50 text-blue-800';
      return 'border border-amber-200 bg-amber-50 text-amber-800';
    }

    function appendCommunicationStatus(container,record) {
      const communications=record.communications||{};
      const items=[
        ['Client confirmation',communications.clientConfirmation],
        ['Team notification',communications.internalNotification],
        ['Discovery confirmation',communications.discoveryConfirmation],
        ['Response reminder',communications.responseReminder],
        ['24-hour follow-up',communications.clientFollowUp],
        ['Google review request',communications.reviewRequest]
      ].filter(([,entry])=>entry&&entry.status);

      if(!items.length)return;
      const wrap=document.createElement('div');
      wrap.className='mt-3 flex flex-wrap gap-2';
      items.forEach(([label,entry])=>{
        const badge=text(
          'span',
          'w-fit rounded-full px-3 py-1.5 text-[.54rem] font-black uppercase tracking-[.07em] '+emailStatusClass(entry.status),
          label+' · '+emailStatusLabel(entry.status)
        );
        if(entry.updatedAt)badge.title=label+' updated '+dateTime(entry.updatedAt);
        wrap.appendChild(badge);
      });
      container.appendChild(wrap);
    }

    function hasResponseActivity(record) {
      const responseTypes=new Set(['email','call','meeting','responded','proposal_sent','quickbooks_estimate_sent']);
      return (record.timeline||[]).some((event)=>responseTypes.has(String(event.type||'')));
    }

