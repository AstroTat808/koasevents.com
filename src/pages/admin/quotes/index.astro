    activityForm?.addEventListener('submit',async(event)=>{
      event.preventDefault(); const data=new FormData(activityForm); if(activityMessage)activityMessage.textContent='Saving…';
      try{
        await api({action:'log-activity',recordId:data.get('recordId'),type:data.get('type'),detail:data.get('detail')});
        activityForm.elements.detail.value='';
        await load(String(searchInput?.value||'').trim());
        const refreshed=(payload.records||[]).find((entry)=>entry.id===data.get('recordId'));
        if(refreshed)openActivity(refreshed);
      }catch(error){if(activityMessage)activityMessage.textContent=error.message||'Unable to save activity.';}
