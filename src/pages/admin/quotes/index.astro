    function syncProfitFormCosts(values) {
      if(!profitForm)return;
      ['iceCost','mixersCost','garnishesCost','cupsCost','suppliesCost','travelCost','addOnCost','gratuityCost','otherDirectCosts'].forEach((key)=>{
        if(values[key]!=null)profitForm.elements[key].value=String(Math.round(Number(values[key])*100)/100);
      });
      const auto=values.costMode==='auto';
      profitForm.querySelectorAll('[data-auto-cost-field]').forEach((input)=>{
        input.readOnly=auto;
        input.classList.toggle('bg-[var(--koa-sand)]/45',auto);
        input.classList.toggle('text-[var(--koa-ink)]/60',auto);
      });
      if(profitModeCopy)profitModeCopy.textContent=auto
        ? 'Automatic mode is recalculating these costs from the current quote. Switch to Manual actual-cost override after you have invoices or event-specific cost information.'
        : 'Manual mode uses the actual direct costs you enter below. Switch back to Automatic operating estimate at any time.';
    }

    function recalcProfitDialog() {
      if(!profitRecord||!profitForm)return;
      let overrides=formProfitOverrides();
      let values=profitValues(profitRecord,overrides);
      if(values.costMode==='auto'){
        syncProfitFormCosts(values);
        overrides=formProfitOverrides();
        values=profitValues(profitRecord,overrides);
      } else syncProfitFormCosts(values);
      const health=marginHealth(values.margin);
      if(profitRevenue)profitRevenue.textContent=money(values.revenue);
      if(profitDirect)profitDirect.textContent=money(values.directCosts);
      if(profitDollars)profitDollars.textContent=money(values.profit);
      if(profitMargin)profitMargin.textContent=(Number.isFinite(values.margin)?values.margin:0).toFixed(1)+'%';
      if(profitMarginCard)profitMarginCard.className='rounded-xl border p-4 '+health.box;
      if(profitHealthCard)profitHealthCard.className='rounded-xl border p-4 '+health.box;
      if(profitHealth)profitHealth.textContent=health.label;
      if(profitHealthCopy)profitHealthCopy.textContent=health.copy;
      renderPriceRecommendations(profitPriceRecommendations,values,{record:profitRecord});
      if(profitBartenderWages)profitBartenderWages.textContent=money(values.bartenderWages);
      if(profitLaborMeta)profitLaborMeta.textContent=values.bartenders+' bartender'+(values.bartenders===1?'':'s')+' × '+values.hours+' hr × '+money(values.bartenderWageRate)+'/hr';
      if(profitBreakdown){
        profitBreakdown.innerHTML='';
        [
