        if(!hasResponseActivity(record)) {
          actions.append(actionButton('Mark responded',small,()=>markResponded(record)));
        }
        actions.append(actionButton('Delete','rounded-full border border-red-200 bg-red-50 px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-red-700',()=>deleteCrmRecord(record)));
      }
      addQuickLinks(actions,record,small);
      article.appendChild(actions);
      return article;
    }

    function filteredMobileRecords() {
      let records=(payload.records||[]).filter(isMobileBarRecord);
      const stage=String(mobileFilterStage?.value||'all');
      const pkg=String(mobileFilterPackage?.value||'all');
      const quote=String(mobileFilterQuote?.value||'all');
      const follow=String(mobileFilterFollowup?.value||'all');
      if(stage!=='all') records=records.filter((r)=>r.stage===stage);
      if(pkg!=='all') records=records.filter((r)=>recordPackage(r)===pkg);
      if(quote!=='all') records=records.filter((r)=>mobileQuoteStatus(r)===quote);
      if(follow==='due') records=records.filter((r)=>mobileFollowups(r).length);
      if(follow==='clear') records=records.filter((r)=>!mobileFollowups(r).length);
      const sort=String(mobileSort?.value||'recent');
      records=[...records].sort((a,b)=>{
        if(sort==='event-date') return String(a.customer?.eventDate||'9999').localeCompare(String(b.customer?.eventDate||'9999'));
        if(sort==='estimate-high') return Number(b.inquiry?.estimatedTotal||b.proposal?.total||0)-Number(a.inquiry?.estimatedTotal||a.proposal?.total||0);
        if(sort==='followup') return (mobileFollowups(a)[0]?.priority||99)-(mobileFollowups(b)[0]?.priority||99);
        return new Date(b.updatedAt||b.createdAt||0).getTime()-new Date(a.updatedAt||a.createdAt||0).getTime();
      });
      return records;
    }

    function monthLabel(value) {
      if(!/^\d{4}-\d{2}$/.test(String(value||''))) return String(value||'');
      return new Intl.DateTimeFormat('en-US',{month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(value+'-01T00:00:00Z'));
    }

    function renderMetric(container,label,value,detail='') {
      const card=document.createElement('article');card.className='rounded-xl border border-white/10 bg-black/10 p-3';
      card.append(text('p','text-[.52rem] font-black uppercase tracking-[.09em] text-white/48',label),text('strong','display mt-1 block text-2xl text-white',value));
      if(detail) card.appendChild(text('p','mt-1 text-[.62rem] leading-5 text-white/45',detail));
      container.appendChild(card);
    }

    function renderBarRow(container,label,value,maxValue,meta='') {
      const row=document.createElement('div');row.className='grid gap-2';
      const head=document.createElement('div');head.className='flex items-center justify-between gap-4 text-xs';
      head.append(text('span','font-semibold text-white/80',label),text('span','shrink-0 text-white/55',meta||String(value)));
      const track=document.createElement('div');track.className='h-2 overflow-hidden rounded-full bg-black/20';
      const bar=document.createElement('div');bar.className='h-full rounded-full bg-[var(--koa-amber-light)]';
      bar.style.width=(maxValue>0?Math.max(3,Math.min(100,(Number(value||0)/maxValue)*100)):0)+'%';
      track.appendChild(bar);row.append(head,track);container.appendChild(row);
    }

    function renderMobileAnalytics() {
      const analytics=payload.mobileBarAnalytics||{};
      const conversions=analytics.conversions||{};
      if(mobileConversion){
        mobileConversion.innerHTML='';
        renderMetric(mobileConversion,'Inquiry → lead',percent(conversions.inquiryToLead),'Qualification rate');
        renderMetric(mobileConversion,'Lead → proposal',percent(conversions.leadToProposal),'Proposal creation');
        renderMetric(mobileConversion,'Proposal → booked',percent(conversions.proposalToBooked),'Close rate');
        renderMetric(mobileConversion,'Inquiry → booked',percent(conversions.inquiryToBooked),'End-to-end');
        renderMetric(mobileConversion,'Avg booking',money(analytics.averageBookingValue||0),'Booked Mobile Bar records');
        renderMetric(mobileConversion,'Booked revenue',money(analytics.bookedRevenue||0),'CRM booked value');
      }

      const forecast=Array.isArray(analytics.monthlyForecast)?analytics.monthlyForecast:[];
      if(mobileForecast){
        mobileForecast.innerHTML='';
        const maxForecast=Math.max(1,...forecast.map((row)=>Number(row.forecastRevenue||0)));
        forecast.forEach((row)=>{
          const article=document.createElement('article');article.className='rounded-xl border border-white/10 bg-black/10 p-3';
          const top=document.createElement('div');top.className='flex items-start justify-between gap-4';
          const left=document.createElement('div');left.append(text('strong','text-sm text-white',monthLabel(row.month)),text('p','mt-1 text-[.62rem] text-white/45',row.eventCount+' event'+(row.eventCount===1?'':'s')));
          const right=document.createElement('div');right.className='text-right';right.append(text('strong','display text-xl text-white',money(row.forecastRevenue)),text('p','mt-1 text-[.58rem] uppercase tracking-[.08em] text-white/45','forecast'));
          top.append(left,right);
          const track=document.createElement('div');track.className='mt-3 h-2 overflow-hidden rounded-full bg-black/20';
          const bar=document.createElement('div');bar.className='h-full rounded-full bg-[var(--koa-amber-light)]';bar.style.width=Math.max(2,Math.min(100,Number(row.forecastRevenue||0)/maxForecast*100))+'%';track.appendChild(bar);
          const detail=text('p','mt-2 text-[.62rem] leading-5 text-white/48','Booked '+money(row.bookedRevenue)+' · weighted open pipeline '+money(row.weightedPipeline)+' · gross pipeline '+money(row.grossPipeline));
          article.append(top,track,detail);mobileForecast.appendChild(article);
        });
        if(!forecast.length) mobileForecast.appendChild(text('p','text-sm text-white/45','No forecast months available yet.'));
      }

      const popularity=Array.isArray(analytics.packagePopularity)?analytics.packagePopularity:[];
      if(mobilePackagePopularity){
        mobilePackagePopularity.innerHTML='';
        const max=Math.max(1,...popularity.map((row)=>Number(row.inquiries||row.active||0)));
        popularity.forEach((row)=>renderBarRow(mobilePackagePopularity,packageLabel(row.packageId),Number(row.inquiries||0),max,(row.inquiries||0)+' inquiries · '+(row.booked||0)+' booked'));
        if(!popularity.some((row)=>row.inquiries||row.active)) mobilePackagePopularity.appendChild(text('p','text-sm text-white/45','Package interest will appear as Mobile Bar inquiries arrive.'));
      }

      const sources=Array.isArray(analytics.leadSources)?analytics.leadSources:[];
      if(mobileLeadSources){
        mobileLeadSources.innerHTML='';
        const max=Math.max(1,...sources.map((row)=>Number(row.count||0)));
        sources.forEach((row)=>renderBarRow(mobileLeadSources,row.source,Number(row.count||0),max,String(row.count||0)));
        if(!sources.length) mobileLeadSources.appendChild(text('p','text-sm text-white/45','Lead-source reporting will populate from inquiry attribution.'));
      }

      const upcoming=Array.isArray(analytics.upcomingEvents)?analytics.upcomingEvents:[];
      if(mobileUpcoming){
        mobileUpcoming.innerHTML='';
        upcoming.slice(0,10).forEach((event)=>{
          const article=document.createElement('article');article.className='rounded-xl border border-white/10 bg-black/10 p-4';
          article.append(
            text('p','text-[.52rem] font-black uppercase tracking-[.1em] text-[var(--koa-amber-light)]',event.eventDate||'Date TBD'),
            text('strong','mt-1 block text-sm text-white',event.customerName||'Client name TBD'),
            text('p','mt-1 text-[.64rem] leading-5 text-white/50',[packageLabel(event.packageId),event.stage,event.quoteStatus].filter(Boolean).join(' · ')),
            text('p','mt-2 text-[.68rem] font-semibold text-white/75',money(event.value||0)+' · '+event.bartenders+' bartender'+(event.bartenders===1?'':'s')+' · '+event.serviceHours+' hr')
          );
          if(event.eventLocation) article.appendChild(text('p','mt-1 text-[.62rem] leading-5 text-white/42',event.eventLocation));
          mobileUpcoming.appendChild(article);
        });
        if(!upcoming.length) mobileUpcoming.appendChild(text('p','text-sm text-white/45','No upcoming Mobile Bar events or opportunities have dates yet.'));
      }

      if(mobileStaffing){
        mobileStaffing.innerHTML='';
        forecast.forEach((row)=>{
          const line=document.createElement('div');line.className='flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-black/10 px-3 py-3';
          const left=document.createElement('div');left.append(text('strong','text-xs text-white',monthLabel(row.month)),text('p','mt-1 text-[.6rem] text-white/42',row.eventCount+' dated event'+(row.eventCount===1?'':'s')));
          const right=document.createElement('div');right.className='text-right';right.append(text('strong','text-sm text-white',row.bartenderShifts+' bartender shifts'),text('p','mt-1 text-[.6rem] text-white/45',row.bartenderHours+' bartender-hours'));
          line.append(left,right);mobileStaffing.appendChild(line);
        });
        if(!forecast.length) mobileStaffing.appendChild(text('p','text-sm text-white/45','Staffing demand will populate from dated opportunities.'));
      }
    }

    function renderMobileBar() {
      const all=(payload.records||[]).filter(isMobileBarRecord);
      const shown=filteredMobileRecords();
      if(mobileCount) mobileCount.textContent=shown.length+' of '+all.length+' records';
      const open=all.filter((r)=>r.stage!=='booked'&&r.stage!=='lost'&&r.stage!=='converted').length;
      const booked=all.filter((r)=>r.stage==='booked').length;
      const followups=all.reduce((sum,r)=>sum+mobileFollowups(r).length,0);
      const estimates=all.map((r)=>Number(r.inquiry?.estimatedTotal||0)).filter((v)=>v>0);
      const value=estimates.reduce((sum,v)=>sum+v,0);
      textContent('[data-mobile-stat-open]',String(open));
      textContent('[data-mobile-stat-booked]',String(booked));
      textContent('[data-mobile-stat-followups]',String(followups));
      textContent('[data-mobile-stat-value]',money(value));
      textContent('[data-mobile-stat-average]',money(estimates.length?value/estimates.length:0));
      textContent('[data-mobile-stat-custom]',String(all.filter((r)=>Array.isArray(r.inquiry?.customAddOns)&&r.inquiry.customAddOns.length).length));

      if(mobileRecords){
        mobileRecords.innerHTML='';
        shown.slice(0,100).forEach((record)=>mobileRecords.appendChild(renderMobileCard(record)));
        if(!shown.length) mobileRecords.appendChild(text('p','rounded-xl border border-white/10 bg-white/[.05] p-5 text-sm text-white/55','No Mobile Bar records match these filters.'));
      }

      renderMobileAnalytics();

      if(mobileReport){
        mobileReport.innerHTML='';
        ['mobile-oahu','mobile-maui','mobile-big-island','mobile-custom'].forEach((packageId)=>{
          const rows=all.filter((r)=>recordPackage(r)===packageId);
          const estimates=rows.map((r)=>Number(r.inquiry?.estimatedTotal||0)).filter((v)=>v>0);
          const tr=document.createElement('tr');tr.className='border-b border-white/10';
          const values=[
            packageLabel(packageId),
            rows.filter((r)=>r.stage==='inquiry').length,
            rows.filter((r)=>r.stage==='lead').length,
            rows.filter((r)=>r.stage==='proposal').length,
            rows.filter((r)=>r.stage==='booked').length,
            money(estimates.length?estimates.reduce((s,v)=>s+v,0)/estimates.length:0),
            rows.reduce((sum,r)=>sum+mobileFollowups(r).length,0)
          ];
          values.forEach((value,index)=>{const td=document.createElement('td');td.className='py-3 pr-4 '+(index===0?'font-semibold text-white':'text-white/72');td.textContent=String(value);tr.appendChild(td);});
          mobileReport.appendChild(tr);
        });
