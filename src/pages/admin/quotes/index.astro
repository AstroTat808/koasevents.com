    function hawaiiToday() {
      const parts=new Intl.DateTimeFormat('en-US',{timeZone:'Pacific/Honolulu',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());
      const values=Object.fromEntries(parts.map((part)=>[part.type,part.value]));
      return values.year+'-'+values.month+'-'+values.day;
    }

    function dayNumber(value) {
      const raw=String(value||'').slice(0,10);
      if(!/^\d{4}-\d{2}-\d{2}$/.test(raw))return null;
      const stamp=Date.parse(raw+'T00:00:00Z');
      return Number.isFinite(stamp)?Math.floor(stamp/86400000):null;
    }

    function reviewAgeDays(eventDate) {
      const eventDay=dayNumber(eventDate);
      const today=dayNumber(hawaiiToday());
      return eventDay===null||today===null?null:today-eventDay;
    }

    function reviewScheduledDate(eventDate) {
      const day=dayNumber(eventDate);
      if(day===null)return '';
      return new Date((day+1)*86400000).toISOString().slice(0,10);
    }

    function reviewStatus(record) {
      return String(record?.communications?.reviewRequest?.status||'').toLowerCase();
    }

    function reviewCard(record,mode) {
      const status=reviewStatus(record);
      const card=document.createElement('article');
      card.className='rounded-xl border border-white/10 bg-black/10 p-4';
      const title=record.customer?.name||'Client name TBD';
      const eventDate=record.customer?.eventDate||'';
      const scheduled=reviewScheduledDate(eventDate);
      const meta=[eventDate?'Event '+eventDate:'Date TBD',packageLabel(recordPackage(record)),record.customer?.email||''].filter(Boolean).join(' · ');
      card.append(
        text('h4','font-semibold text-white',title),
        text('p','mt-1 text-xs leading-5 text-white/52',meta)
      );

      let detail='';
      if(mode==='upcoming') detail=scheduled?'Scheduled review request: '+scheduled:'Scheduled after event';
      else if(mode==='eligible') detail='Eligible now · next automation run can send this request';
      else if(mode==='delivered') detail='Delivered'+(record.communications?.reviewRequest?.updatedAt?' · '+dateTime(record.communications.reviewRequest.updatedAt):'');
      else detail=(status==='bounced'?'Bounced':'Failed')+(record.communications?.reviewRequest?.updatedAt?' · '+dateTime(record.communications.reviewRequest.updatedAt):'');

      card.appendChild(text('p','mt-3 text-xs font-bold '+(mode==='failed'?'text-red-100':'text-[var(--koa-amber-light)]'),detail));

      const actions=document.createElement('div');actions.className='mt-3 flex flex-wrap gap-2';
      const link=document.createElement('a');link.href='/admin/events/?record='+encodeURIComponent(record.id);link.className='rounded-full border border-white/15 px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-white';link.textContent='Event Ops';actions.appendChild(link);
      if(record.customer?.email){
        const mail=document.createElement('a');mail.href='mailto:'+encodeURIComponent(record.customer.email);mail.className='rounded-full border border-white/15 px-3 py-2 text-[.56rem] font-black uppercase tracking-[.08em] text-white';mail.textContent='Email client';actions.appendChild(mail);
      }
      card.appendChild(actions);
      return card;
    }

    function renderReviewBucket(container,rows,mode,emptyCopy) {
      if(!container)return;
      container.innerHTML='';
      rows.slice(0,25).forEach((record)=>container.appendChild(reviewCard(record,mode)));
      if(!rows.length)container.appendChild(text('p','text-sm text-white/45',emptyCopy));
      if(rows.length>25)container.appendChild(text('p','text-xs text-white/40','Showing 25 of '+rows.length+' records.'));
    }

    function renderReviewDashboard() {
      const booked=(payload.records||[]).filter((record)=>record.stage==='booked'&&record.kind==='proposal'&&record.customer?.email&&record.customer?.eventDate);
      const upcoming=booked.filter((record)=>{
        const age=reviewAgeDays(record.customer.eventDate);
        return age!==null&&age<1&&!reviewStatus(record);
      }).sort((a,b)=>String(a.customer?.eventDate||'').localeCompare(String(b.customer?.eventDate||'')));

      const eligible=booked.filter((record)=>{
        const age=reviewAgeDays(record.customer.eventDate);
        return age!==null&&age>=1&&age<=14&&!reviewStatus(record);
      }).sort((a,b)=>String(a.customer?.eventDate||'').localeCompare(String(b.customer?.eventDate||'')));

      const delivered=booked.filter((record)=>reviewStatus(record)==='delivered')
        .sort((a,b)=>String(b.communications?.reviewRequest?.updatedAt||'').localeCompare(String(a.communications?.reviewRequest?.updatedAt||'')));

      const failed=booked.filter((record)=>['failed','bounced'].includes(reviewStatus(record)))
        .sort((a,b)=>String(b.communications?.reviewRequest?.updatedAt||'').localeCompare(String(a.communications?.reviewRequest?.updatedAt||'')));

      if(reviewStatUpcoming)reviewStatUpcoming.textContent=String(upcoming.length);
      if(reviewStatEligible)reviewStatEligible.textContent=String(eligible.length);
      if(reviewStatDelivered)reviewStatDelivered.textContent=String(delivered.length);
      if(reviewStatFailed)reviewStatFailed.textContent=String(failed.length);

      renderReviewBucket(reviewUpcoming,upcoming,'upcoming','No future booked events are waiting for review scheduling.');
      renderReviewBucket(reviewEligible,eligible,'eligible','No past clients are currently waiting for a review request.');
      renderReviewBucket(reviewDelivered,delivered,'delivered','No delivered review requests yet.');
      renderReviewBucket(reviewFailed,failed,'failed','No failed or bounced review requests.');
    }

    function qboInvoiceDueIndicator(payments) {
      const today=dayNumber(hawaiiToday());
      if(today===null)return null;
      const rows=(payments||[])
        .filter((item)=>item.invoiceId&&item.status!=='paid'&&item.dueDate&&Number(item.balance||0)>0)
        .map((item)=>({item,due:dayNumber(item.dueDate)}))
        .filter((entry)=>entry.due!==null)
        .map((entry)=>({...entry,days:entry.due-today}))
        .sort((a,b)=>a.days-b.days);
      if(!rows.length)return null;

      const next=rows[0];
      if(next.days<0) {
        const late=Math.abs(next.days);
        return {
          kind:'overdue',
          label:'Overdue · '+late+' day'+(late===1?'':'s'),
          detail:(next.item.docNumber?'Invoice #'+next.item.docNumber:'QuickBooks invoice')+' · '+money(next.item.balance)+' remaining · due '+next.item.dueDate
        };
      }
      if(next.days===0) {
        return {
          kind:'today',
          label:'Due today',
          detail:(next.item.docNumber?'Invoice #'+next.item.docNumber:'QuickBooks invoice')+' · '+money(next.item.balance)+' remaining'
        };
      }
      if(next.days<=14) {
        return {
          kind:'soon',
          label:'Due soon · '+next.days+' day'+(next.days===1?'':'s'),
          detail:(next.item.docNumber?'Invoice #'+next.item.docNumber:'QuickBooks invoice')+' · '+money(next.item.balance)+' remaining · due '+next.item.dueDate
        };
      }
      return null;
    }

    function renderPaymentDashboard() {
      const booked=(payload.records||[]).filter((record)=>record.stage==='booked'&&record.bookingSummary);
      const today=dayNumber(hawaiiToday());
      const month=hawaiiToday().slice(0,7);
      let totalOutstanding=0;
      let overdue=0;
      let due7=0;
      let due30=0;
      let paidMonth=0;
      let invoiceCount=0;

      booked.forEach((record)=>{
        const payments=record.bookingSummary?.payments||[];
        payments.forEach((payment)=>{
          if(!payment.invoiceId)return;
          invoiceCount+=1;
          const balance=Math.max(0,Number(payment.balance||0));
          totalOutstanding+=balance;
          const due=dayNumber(payment.dueDate);
          if(balance>0&&today!==null&&due!==null){
            const days=due-today;
            if(days<0)overdue+=balance;
            else if(days<=7)due7+=balance;
            if(days>=0&&days<=30)due30+=balance;
          }
          const paidAt=String(payment.paidAt||'');
          if(payment.status==='paid'&&paidAt.slice(0,7)===month){
            paidMonth+=Math.max(0,Number(payment.amount||0));
          }
        });
      });

      if(payTotalOutstanding)payTotalOutstanding.textContent=money(totalOutstanding);
      if(payOverdue)payOverdue.textContent=money(overdue);
      if(payDue7)payDue7.textContent=money(due7);
      if(payDue30)payDue30.textContent=money(due30);
      if(payPaidMonth)payPaidMonth.textContent=money(paidMonth);
      if(payDashboardMeta)payDashboardMeta.textContent=invoiceCount+' issued QuickBooks invoice'+(invoiceCount===1?'':'s')+' represented across '+booked.length+' booked client'+(booked.length===1?'':'s')+'.';
    }

    function renderBookedDashboard() {
      if(!bookedDashboard)return;
      bookedDashboard.innerHTML='';
      const rows=(payload.records||[])
        .filter((record)=>record.stage==='booked')
        .sort((a,b)=>{
          const aIndicator=qboInvoiceDueIndicator(a.bookingSummary?.payments||[]);
          const bIndicator=qboInvoiceDueIndicator(b.bookingSummary?.payments||[]);
          const rank=(indicator)=>{
            if(!indicator)return 3;
            if(indicator.kind==='overdue')return 0;
            if(indicator.kind==='today')return 1;
            if(indicator.kind==='soon')return 2;
            return 3;
          };
          const priority=rank(aIndicator)-rank(bIndicator);
          if(priority!==0)return priority;
          return String(a.customer?.eventDate||'9999').localeCompare(String(b.customer?.eventDate||'9999'));
        });

      rows.forEach((record)=>{
        const summary=record.bookingSummary||{};
        const payments=summary.payments||[];
        const nextPayment=payments
          .filter((item)=>item.status!=='paid')
          .sort((a,b)=>String(a.dueDate||'9999').localeCompare(String(b.dueDate||'9999')))[0];

        const card=document.createElement('article'); card.className='rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5';
        card.append(
          text('p','text-[.55rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]','Booked · '+(summary.contractStatus==='signed'?'Agreement signed':'Agreement pending')),
          text('h3','display mt-2 text-3xl text-[var(--koa-forest)]',record.customer?.name||'Client name TBD'),
          text('p','mt-2 text-sm text-[var(--koa-ink)]/55',[record.customer?.eventDate?new Date(record.customer.eventDate+'T12:00:00').toLocaleDateString():'' ,packageLabel(recordPackage(record))].filter(Boolean).join(' · '))
        );
        const statusWrap=document.createElement('div'); statusWrap.className='mt-4 flex flex-wrap items-center gap-2';
        const paymentStatus=String(summary.paymentStatus||'Balance Due');
        const statusClass=paymentStatus==='Paid in Full'
          ? 'bg-[var(--koa-forest)] text-white'
          : paymentStatus==='Paid'
            ? 'bg-[var(--koa-sand)] text-[var(--koa-forest)]'
            : paymentStatus==='Partially Paid'
              ? 'bg-[var(--koa-amber-light)] text-[var(--koa-forest)]'
              : 'border border-[var(--koa-line)] text-[var(--koa-clay)]';
        statusWrap.append(
          text('span','rounded-full px-3 py-2 text-[.55rem] font-black uppercase tracking-[.09em] '+statusClass,paymentStatus),
          text('span','text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/42',summary.depositPaid?'Deposit paid':'Deposit pending')
        );
        const dueIndicator=qboInvoiceDueIndicator(payments);
        if(dueIndicator) {
          const dueClass=dueIndicator.kind==='overdue'
            ? 'bg-red-100 text-red-800'
            : dueIndicator.kind==='today'
              ? 'bg-orange-100 text-orange-800'
              : 'bg-[var(--koa-amber-light)] text-[var(--koa-forest)]';
          statusWrap.appendChild(text('span','rounded-full px-3 py-2 text-[.55rem] font-black uppercase tracking-[.09em] '+dueClass,dueIndicator.label));
        }
        card.appendChild(statusWrap);
        if(dueIndicator) {
          card.appendChild(text('p','mt-2 text-xs font-semibold leading-5 '+(dueIndicator.kind==='overdue'?'text-red-700':'text-[var(--koa-clay)]'),dueIndicator.detail));
        }

        const finances=document.createElement('div'); finances.className='mt-3 grid grid-cols-3 gap-3';
        const paidBox=document.createElement('div'); paidBox.className='rounded-xl bg-white p-3'; paidBox.append(text('p','text-[.52rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]','Paid'),text('p','mt-1 font-bold text-[var(--koa-forest)]',money(summary.paid||0)));
        const qboDueBox=document.createElement('div'); qboDueBox.className='rounded-xl bg-white p-3'; qboDueBox.append(text('p','text-[.52rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]','QBO balance'),text('p','mt-1 font-bold text-[var(--koa-forest)]',money(summary.qboBalanceDue||0)));
        const dueBox=document.createElement('div'); dueBox.className='rounded-xl bg-white p-3'; dueBox.append(text('p','text-[.52rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]','Contract balance'),text('p','mt-1 font-bold text-[var(--koa-forest)]',money(summary.outstanding||0)));
        finances.append(paidBox,qboDueBox,dueBox); card.appendChild(finances);
        if(nextPayment) card.appendChild(text('p','mt-3 text-xs leading-5 text-[var(--koa-ink)]/55','Next: '+nextPayment.label+' · '+money(nextPayment.amount)+(nextPayment.dueDate?' · due '+nextPayment.dueDate:'')));

        const actions=document.createElement('div'); actions.className='mt-4 flex flex-wrap gap-2';
        const primary='rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white';
        const small='rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]';
        actions.append(actionButton('Manage booking',primary,()=>openBooking(record)));
        const ops=document.createElement('a');ops.href='/admin/events/?record='+encodeURIComponent(record.id);ops.className=small;ops.textContent='Event Ops';actions.appendChild(ops);
        addQuickLinks(actions,record,small);
        card.appendChild(actions);
        bookedDashboard.appendChild(card);
      });
      if(!rows.length) bookedDashboard.appendChild(text('p','text-sm text-[var(--koa-ink)]/45','No booked events yet.'));
    }

    function openBooking(record) {
      bookingRecord=record;
      const summary=record.bookingSummary||{};
      if(bookingTitle) bookingTitle.textContent=record.customer?.name||record.id;
      if(bookingMeta) bookingMeta.textContent=[record.id,record.customer?.eventDate,packageLabel(recordPackage(record))].filter(Boolean).join(' · ');
      textContent('[data-booking-contract]',summary.contractStatus==='signed'?(summary.signedAt?'Signed '+dateTime(summary.signedAt):'Signed'):'Awaiting signature');
      textContent('[data-booking-paid]',money(summary.paid||0));
      textContent('[data-booking-outstanding]',money(summary.outstanding||0));
      textContent('[data-booking-subtotal]',money(summary.subtotal||record.proposal?.subtotal||0));
      textContent('[data-booking-get]',money(summary.taxAmount||record.proposal?.taxAmount||0));
      textContent('[data-booking-deposit]',money(summary.depositAmount||record.proposal?.depositAmount||0));
      textContent('[data-booking-payments-received]',money(summary.paymentsReceived||summary.paid||0));
      textContent('[data-booking-remaining]',money(summary.remainingBalance??summary.outstanding??record.proposal?.total||0));
      if(bookingClientLink) bookingClientLink.href=summary.bookingUrl||'#';
      if(planningClientLink) {
        planningClientLink.href=record.proposal?.publicToken?'/planning/?token='+encodeURIComponent(record.proposal.publicToken):'#';
        planningClientLink.classList.toggle('hidden',record.stage!=='booked'||!record.proposal?.publicToken);
      }
      if(eventOpsLink) {
        eventOpsLink.href='/admin/events/?record='+encodeURIComponent(record.id);
        eventOpsLink.classList.toggle('hidden',record.stage!=='booked');
      }
      if(qboSyncStatusButton) {
        qboSyncStatusButton.disabled=!qboState?.connection?.connected;
        qboSyncStatusButton.classList.toggle('opacity-40',!qboState?.connection?.connected);
      }
      if(bookingMessage) bookingMessage.textContent=!qboState?.connection?.connected
        ? 'QuickBooks is not connected. Use QBO Setup before issuing invoices.'
        : 'Invoice balances shown here come from the last QuickBooks synchronization.';

      const clientSigned = summary.contractStatus === 'signed';
      const koaSigned = Boolean(summary.koaSignedAt);
      countersignPanel?.classList.toggle('hidden', !clientSigned);
      countersignFormWrap?.classList.toggle('hidden', !clientSigned || koaSigned);
      if(countersignCopy) {
        countersignCopy.textContent = !clientSigned
          ? 'The client must sign before Koa’s can countersign.'
          : koaSigned
            ? 'Countersigned by ' + (summary.koaSigner || 'Koa’s Events') + (summary.koaSignedAt ? ' on ' + dateTime(summary.koaSignedAt) : '') + '.'
            : 'The client signature is complete. Add Koa’s authorized countersignature to fully execute the agreement.';
      }
      if(countersignName && !koaSigned) countersignName.value='';

      if(bookingPayments) {
        bookingPayments.innerHTML='';
        (summary.payments||[]).forEach((payment)=>{
          const row=document.createElement('article'); row.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
          const top=document.createElement('div'); top.className='flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between';
          const left=document.createElement('div');
          left.append(
            text('strong','text-sm text-[var(--koa-forest)]',payment.label),
            text('p','mt-1 text-xs text-[var(--koa-ink)]/48',(payment.dueDate?'Due '+payment.dueDate:'Due date TBD')+' · '+money(payment.amount))
          );
          if(payment.invoiceId) {
            left.appendChild(text('p','mt-2 text-xs text-[var(--koa-ink)]/55','QuickBooks invoice '+(payment.docNumber?'#'+payment.docNumber:payment.invoiceId)+' · '+(payment.status==='paid'?'Paid':money(payment.balance)+' remaining')+(payment.emailStatus?' · '+payment.emailStatus:'')));
          } else {
            left.appendChild(text('p','mt-2 text-xs text-[var(--koa-ink)]/45','No QuickBooks invoice issued yet.'));
          }

          const badge=text('span','w-fit rounded-full '+(payment.status==='paid'?'bg-[var(--koa-sand)] text-[var(--koa-forest)]':'border border-[var(--koa-line)] text-[var(--koa-clay)]')+' px-3 py-2 text-[.55rem] font-black uppercase tracking-[.09em]',payment.status==='paid'?'Paid':payment.status==='open'?'Open in QBO':'Not invoiced');
          top.append(left,badge); row.appendChild(top);

          const controls=document.createElement('div'); controls.className='mt-4 flex flex-wrap gap-2';
          if(!quickBooksReady()) {
            const setup=document.createElement('a');setup.href='/admin/quickbooks/';setup.className='rounded-full border border-[var(--koa-line)] px-3 py-2.5 text-[.56rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]';setup.textContent='Complete QBO setup';controls.appendChild(setup);
          } else if(!payment.invoiceId) {
            controls.append(actionButton('Create QBO invoice','rounded-full bg-[var(--koa-forest)] px-3 py-2.5 text-[.56rem] font-black uppercase tracking-[.08em] text-white',async()=>{
              if(bookingMessage)bookingMessage.textContent='Creating QuickBooks invoice…';
              try{const refreshed=await runQuickBooks('create-invoice',record,{paymentId:payment.id});openBooking(refreshed);}catch(error){if(bookingMessage)bookingMessage.textContent=error.message||'Unable to create QuickBooks invoice.';}
            }));
          } else {
            controls.append(actionButton('Email invoice from QBO','rounded-full bg-[var(--koa-forest)] px-3 py-2.5 text-[.56rem] font-black uppercase tracking-[.08em] text-white',async()=>{
              if(bookingMessage)bookingMessage.textContent='Sending QuickBooks invoice…';
              try{const refreshed=await runQuickBooks('send-invoice',record,{paymentId:payment.id});openBooking(refreshed);}catch(error){if(bookingMessage)bookingMessage.textContent=error.message||'Unable to send QuickBooks invoice.';}
            }));
          }
          row.appendChild(controls);
          bookingPayments.appendChild(row);
        });
      }
      if(bookingDialog && !bookingDialog.open) bookingDialog.showModal();
    }

    function textContent(selector,value){const el=document.querySelector(selector);if(el)el.textContent=value;}

    function isMobileBarRecord(record) {
      const id=recordPackage(record);
      return String(id||'').startsWith('mobile-') || record.inquiry?.service==='mobile-bar';
    }

    function mobileQuoteStatus(record) {
      if(record.kind==='proposal') return record.proposal?.status || record.status || 'draft';
      if(record.stage==='booked') return 'booked';
      if(record.inquiry?.estimatedTotal) return 'website-estimate';
      return 'unquoted';
    }

    function mobileFollowups(record) {
      return Array.isArray(record.reminders) ? record.reminders : [];
    }

    function mobileRevenue(record) {
      const proposalTotal=Number(record.proposal?.total||0);
      const estimate=Number(record.inquiry?.estimatedTotal||0);
      if(proposalTotal>0)return proposalTotal;
      if(estimate>0)return estimate;
      const lines=Array.isArray(record.inquiry?.estimateLineItems)?record.inquiry.estimateLineItems:[];
      return lines.reduce((sum,line)=>sum+Number(line?.amount||0),0);
    }

    function quoteLines(record) {
      const proposalLines=Array.isArray(record.proposal?.lineItems)?record.proposal.lineItems:[];
      const inquiryLines=Array.isArray(record.inquiry?.estimateLineItems)?record.inquiry.estimateLineItems:[];
      return proposalLines.length?proposalLines:inquiryLines;
    }

    function quotedGratuity(record) {
      return quoteLines(record).filter((line)=>String(line?.id||'')==='gratuity' || /gratuity/i.test(String(line?.description||''))).reduce((sum,line)=>sum+Number(line?.amount||0),0);
    }

    function automaticCostEstimate(record, bartenderWageRate=40) {
      const revenue=mobileRevenue(record);
      const packageId=recordPackage(record);
      const rate=autoCostRates[packageId]||autoCostRates['mobile-custom'];
      const guests=Math.max(1,Number(record?.inquiry?.guestCount||100));
      const hours=Math.max(0,Number(record?.inquiry?.serviceHours||4));
      const bartenders=Math.max(1,Number(record?.inquiry?.bartenderCount||1));
      const oneWayMiles=Math.max(0,Number(record?.inquiry?.oneWayMiles||0));
      const glasswareCount=Math.max(0,Number(record?.inquiry?.glasswareCount||0));
      const cupGuests=Math.max(0,guests-Math.min(guests,glasswareCount));
      const bartenderWages=hours*bartenders*Math.max(0,Number(bartenderWageRate||40));
      const iceCost=Math.max(25,guests*rate.ice);
      const mixersCost=Math.max(35,guests*rate.mixers);
      const garnishesCost=Math.max(20,guests*rate.garnishes);
      const cupsCost=cupGuests>0?Math.max(15,cupGuests*rate.cups):0;
      const suppliesCost=Math.max(25,guests*rate.supplies);
      const travelCost=oneWayMiles>0?(oneWayMiles*2*1.10)+15+(oneWayMiles>60?50:0):0;
      const addOnCost=quoteLines(record).reduce((sum,line)=>{
        const id=String(line?.id||'');
        const ratio=addOnCostRatios[id]||0;
        return sum+(Number(line?.amount||0)*ratio);
      },0);
      const gratuityCost=quotedGratuity(record);
      const otherDirectCosts=revenue>0?Math.max(25,revenue*.02):0;
      return {bartenderWages,iceCost,mixersCost,garnishesCost,cupsCost,suppliesCost,travelCost,addOnCost,gratuityCost,otherDirectCosts};
    }

    function recordCostMode(record) {
      return record?.profitModel?.costMode || (record?.profitModel ? 'manual' : 'auto');
    }

    function profitValues(record, overrides={}) {
      const model={...(record?.profitModel||{}),...overrides};
      const revenue=mobileRevenue(record);
      const hours=Math.max(0,Number(record?.inquiry?.serviceHours||4));
      const bartenders=Math.max(1,Number(record?.inquiry?.bartenderCount||1));
      const bartenderWageRate=Math.max(0,Number(model.bartenderWageRate ?? 40));
      const costMode=model.costMode || recordCostMode(record);
      const auto=automaticCostEstimate(record,bartenderWageRate);
      const pick=(key)=>costMode==='auto'?Number(auto[key]||0):Math.max(0,Number(model[key]||0));
      const bartenderWages=auto.bartenderWages;
      const iceCost=pick('iceCost');
      const mixersCost=pick('mixersCost');
      const garnishesCost=pick('garnishesCost');
      const cupsCost=pick('cupsCost');
      const suppliesCost=pick('suppliesCost');
      const travelCost=pick('travelCost');
      const addOnCost=pick('addOnCost');
      const gratuityCost=pick('gratuityCost');
      const otherDirectCosts=pick('otherDirectCosts');
      const directCosts=bartenderWages+iceCost+mixersCost+garnishesCost+cupsCost+suppliesCost+travelCost+addOnCost+gratuityCost+otherDirectCosts;
      const profit=revenue-directCosts;
      const margin=revenue>0?(profit/revenue)*100:0;
      return {costMode,revenue,hours,bartenders,bartenderWageRate,bartenderWages,iceCost,mixersCost,garnishesCost,cupsCost,suppliesCost,travelCost,addOnCost,gratuityCost,otherDirectCosts,directCosts,profit,margin};
    }

    function marginHealth(margin) {
      const value=Number(margin||0);
      if(value>=marginThresholds.green)return {key:'green',label:'Highly profitable',copy:'50%+ margin',box:'border-emerald-200 bg-emerald-50 text-emerald-800',pill:'bg-emerald-100 text-emerald-800'};
      if(value>=marginThresholds.yellow)return {key:'yellow',label:'Acceptable',copy:'35–49.9% margin',box:'border-amber-200 bg-amber-50 text-amber-900',pill:'bg-amber-100 text-amber-900'};
      return {key:'red',label:'Low margin',copy:'Under 35% margin',box:'border-red-200 bg-red-50 text-red-800',pill:'bg-red-100 text-red-800'};
    }

    function recommendedPriceForValues(values,targetMarginPercent) {
      const target=Math.max(0,Math.min(.9,Number(targetMarginPercent||0)/100));
      if(!values||!Number.isFinite(values.directCosts)||target<=0)return null;
      let price=0;
      if(values.costMode==='auto'){
        const fixedCosts=Math.max(0,Number(values.directCosts||0)-Number(values.otherDirectCosts||0));
        const minReservePrice=(fixedCosts+25)/(1-target);
        price=(minReservePrice*.02<=25+.0001)
          ? minReservePrice
          : fixedCosts/(.98-target);
      } else {
        price=Number(values.directCosts||0)/(1-target);
      }
      price=Math.max(Number(values.revenue||0),price);
      price=Math.ceil(price*100)/100;
      const reserve=values.costMode==='auto'?Math.max(25,price*.02):Number(values.otherDirectCosts||0);
      const targetCosts=values.costMode==='auto'
        ? Math.max(0,Number(values.directCosts||0)-Number(values.otherDirectCosts||0))+reserve
        : Number(values.directCosts||0);
      const targetProfit=price-targetCosts;
      return {
        targetMargin:targetMarginPercent,
        price,
        increase:Math.max(0,price-Number(values.revenue||0)),
        targetCosts,
        targetProfit
      };
    }

    function canApplyRecommendedPrice(record) {
      return Boolean(
        record?.kind==='proposal' &&
        record?.proposal &&
        !['accepted','booked'].includes(String(record.proposal.status||'')) &&
        record?.stage!=='booked'
      );
    }

    async function applyRecommendedPrice(record,target,rec) {
      if(!canApplyRecommendedPrice(record)||!rec)return;
      const name=record.customer?.name||record.id;
      if(!confirm('Apply the '+target+'% margin target to '+name+'?\n\nThis preserves every existing proposal line and adds/updates one Margin target adjustment line. The payment schedule will be rebalanced to the new total of '+money(rec.price)+'.'))return;
      const reopenProfit=Boolean(profitDialog?.open&&profitRecord?.id===record.id);
      if(reopenProfit)profitDialog.close();
      try{
        if(message)message.textContent='Applying '+target+'% target price to '+record.id+'…';
        const result=await api({
          action:'apply-mobile-bar-margin-target',
          recordId:record.id,
          targetMargin:target,
          targetTotal:rec.price
        });
        await load(String(searchInput?.value||'').trim());
        const refreshed=(payload.records||[]).find((entry)=>entry.id===record.id)||result.record;
        if(reopenProfit&&refreshed){
          openProfitModel(refreshed);
          if(profitMessage)profitMessage.textContent='Applied '+target+'% target price. Proposal total is now '+money(result.targetTotal||refreshed.proposal?.total)+'. Sync the QuickBooks estimate if one already exists.';
        }
        if(message)message.textContent='Applied '+target+'% target price to '+record.id+' · '+money(result.targetTotal||rec.price)+'.';
      }catch(error){
        if(message)message.textContent=error?.message||'Unable to apply recommended price.';
        if(reopenProfit&&record)openProfitModel(record);
      }
    }

    function renderPriceRecommendations(container,values,{compact=false,record=null}={}) {
      if(!container)return;
      container.innerHTML='';
      const lowMargin=Number(values?.margin||0)<marginThresholds.yellow;
      container.classList.toggle('hidden',!lowMargin);
      if(!lowMargin)return;

      const title=text('p',compact?'text-[.56rem] font-black uppercase tracking-[.09em]':'text-[.62rem] font-black uppercase tracking-[.09em] text-red-800','Recommended price');
      const copy=text('p',compact?'mt-1 text-[.64rem] leading-5 opacity-70':'mt-1 text-xs leading-5 text-red-700','Minimum selling price on the current cost basis to reach each target margin.');
      container.append(title,copy);

      const grid=document.createElement('div');
      grid.className=compact?'mt-3 grid grid-cols-3 gap-2':'mt-4 grid gap-3 sm:grid-cols-3';
      [40,50,60].forEach((target)=>{
        const rec=recommendedPriceForValues(values,target);
        if(!rec)return;
        const card=document.createElement('div');
        card.className=compact
          ? 'rounded-lg border border-red-200/80 bg-white/65 p-2.5 text-[var(--koa-ink)]'
          : 'rounded-xl border border-red-200 bg-white p-3 text-[var(--koa-ink)]';
        card.append(
          text('p','text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]',target+'% margin'),
          text('strong',compact?'mt-1 block text-base text-[var(--koa-forest)]':'display mt-1 block text-2xl text-[var(--koa-forest)]',money(rec.price)),
          text('p','mt-1 text-[.58rem] leading-4 text-[var(--koa-ink)]/48','+'+money(rec.increase)+' vs. current')
        );
        if(canApplyRecommendedPrice(record)){
          const button=document.createElement('button');
          button.type='button';
          button.className=compact
            ? 'mt-2 w-full rounded-full bg-[var(--koa-forest)] px-2 py-2 text-[.5rem] font-black uppercase tracking-[.06em] text-white'
            : 'mt-3 w-full rounded-full bg-[var(--koa-forest)] px-3 py-2.5 text-[.56rem] font-black uppercase tracking-[.08em] text-white';
          button.textContent='Apply '+target+'%';
          button.addEventListener('click',()=>applyRecommendedPrice(record,target,rec));
          card.appendChild(button);
        }
        grid.appendChild(card);
      });
      container.appendChild(grid);
      if(record?.kind==='proposal'&&!canApplyRecommendedPrice(record)){
        container.appendChild(text('p',compact?'mt-2 text-[.58rem] leading-4 opacity-65':'mt-3 text-xs leading-5 text-red-700','Accepted and booked proposals are locked from one-click repricing.'));
      }
    }

    function localDateKey(date) {
      const y=date.getFullYear();
      const m=String(date.getMonth()+1).padStart(2,'0');
      const d=String(date.getDate()).padStart(2,'0');
      return y+'-'+m+'-'+d;
    }

    function formatDateKey(value) {
      if(!value)return '';
      const parsed=new Date(value+'T12:00:00');
      if(Number.isNaN(parsed.getTime()))return value;
      return new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric'}).format(parsed);
    }

    function profitabilityDateRange() {
      const today=new Date();
      const todayKey=localDateKey(today);
      const period=String(mobileProfitPeriod?.value||'ytd');
      if(period==='all')return {period,start:'',end:'',label:'All-time performance'};
      if(period==='custom'){
        const start=String(mobileProfitFrom?.value||'');
        const end=String(mobileProfitTo?.value||'');
        const label=start&&end?formatDateKey(start)+' – '+formatDateKey(end):'Custom date range';
        return {period,start,end,label};
      }
      if(period==='trailing12'){
        const startDate=new Date(today.getFullYear()-1,today.getMonth(),today.getDate()+1);
        const start=localDateKey(startDate);
        return {period,start,end:todayKey,label:'Trailing 12 months · '+formatDateKey(start)+' – '+formatDateKey(todayKey)};
      }
      const start=today.getFullYear()+'-01-01';
      return {period:'ytd',start,end:todayKey,label:'Year to date · '+formatDateKey(start)+' – '+formatDateKey(todayKey)};
    }

    function recordEventDate(record) {
      const raw=String(record?.customer?.eventDate||record?.inquiry?.eventDate||'').trim();
      return /^\d{4}-\d{2}-\d{2}/.test(raw)?raw.slice(0,10):'';
    }

    function profitabilityRecords() {
      const scope=String(mobileProfitScope?.value||'booked');
      const range=profitabilityDateRange();
      return (payload.records||[])
        .filter(isMobileBarRecord)
        .filter((record)=>record.stage!=='lost'&&mobileRevenue(record)>0)
        .filter((record)=>scope==='all'||record.stage==='booked')
        .filter((record)=>{
          if(!range.start&&!range.end)return true;
          const eventDate=recordEventDate(record);
          if(!eventDate)return false;
          if(range.start&&eventDate<range.start)return false;
          if(range.end&&eventDate>range.end)return false;
          return true;
        });
    }

    function mobileEventMonth(record) {
      const raw=recordEventDate(record);
      return raw?raw.slice(0,7):'';
    }

    function mobileProfitProbability(record) {
      if(record.stage==='booked')return 1;
      if(record.kind==='proposal'){
        const status=String(record.proposal?.status||record.status||'');
        if(status==='accepted')return .95;
        if(status==='viewed')return .75;
        if(status==='sent')return .65;
        if(status==='draft')return .50;
        return .45;
      }
      if(record.stage==='lead')return .30;
      return .15;
    }

    function renderMobileProfitGoalProjection() {
      const allMobile=(payload.records||[])
        .filter(isMobileBarRecord)
        .filter((record)=>!['converted','lost'].includes(record.stage)&&mobileRevenue(record)>0);
      const now=new Date();
      const currentMonth=localDateKey(new Date(now.getFullYear(),now.getMonth(),1)).slice(0,7);
      const monthRows=allMobile.filter((record)=>mobileEventMonth(record)===currentMonth);
      const bookedRows=monthRows.filter((record)=>record.stage==='booked');
      const openRows=monthRows.filter((record)=>record.stage!=='booked');
      const bookedProfit=bookedRows.reduce((sum,record)=>sum+Number(profitValues(record).profit||0),0);
      const projectedOpenProfit=openRows.reduce((sum,record)=>{
        const profit=Number(profitValues(record).profit||0);
        return sum+(profit*mobileProfitProbability(record));
      },0);
      const projectedProfit=bookedProfit+projectedOpenProfit;
      const historicalBooked=allMobile.filter((record)=>record.stage==='booked').map((record)=>Number(profitValues(record).profit||0));
      const avgBookedProfit=historicalBooked.length?historicalBooked.reduce((sum,value)=>sum+value,0)/historicalBooked.length:0;
      const target=Math.max(0,Number(payload.mobileBarProfitSettings?.monthlyGrossProfitTarget||0));
      const delta=projectedProfit-target;
      const bookingsNeeded=target>0&&delta<0&&avgBookedProfit>0?Math.ceil(Math.abs(delta)/avgBookedProfit):target>0&&delta>=0?0:null;

      if(mobileProfitGoalTitle)mobileProfitGoalTitle.textContent=monthLabel(currentMonth)+' gross-profit goal';
      if(mobileProfitGoalInput&&document.activeElement!==mobileProfitGoalInput)mobileProfitGoalInput.value=target?String(Math.round(target*100)/100):'';
      if(mobileGoalTarget)mobileGoalTarget.textContent=target?money(target):'Not set';
      if(mobileGoalBooked)mobileGoalBooked.textContent=money(bookedProfit);
      if(mobileGoalProjected)mobileGoalProjected.textContent=money(projectedProfit);
      if(mobileGoalAverage)mobileGoalAverage.textContent=historicalBooked.length?money(avgBookedProfit):'—';
      if(mobileGoalGap){
        mobileGoalGap.textContent=target?((delta>=0?'+':'−')+money(Math.abs(delta))):'—';
      }
      if(mobileGoalGapCopy){
        mobileGoalGapCopy.textContent=!target?'Set a monthly goal to compare.':delta>=0?'Projected ahead of target.':'Projected below target.';
      }
      if(mobileGoalGapCard){
        mobileGoalGapCard.className='rounded-lg border p-3 '+(!target?'border-white/10 bg-black/10':delta>=0?'border-emerald-300/30 bg-emerald-400/10':'border-red-300/30 bg-red-400/10');
      }
      if(mobileGoalBookings)mobileGoalBookings.textContent=bookingsNeeded==null?'—':String(bookingsNeeded);
      if(mobileGoalBookingsCopy){
        mobileGoalBookingsCopy.textContent=!target
          ? 'Set a goal first.'
          : bookingsNeeded===0
            ? 'Projected target reached.'
            : avgBookedProfit>0
              ? 'At '+money(avgBookedProfit)+' average booked profit.'
              : 'More booked history is needed.';
      }
      if(mobileGoalProgress){
        const pct=target>0?Math.max(0,Math.min(100,(projectedProfit/target)*100)):0;
        mobileGoalProgress.style.width=pct+'%';
        mobileGoalProgress.className='h-full rounded-full '+(target>0&&projectedProfit>=target?'bg-emerald-300':'bg-[var(--koa-amber-light)]');
      }
    }

    function weightedMargin(rows) {
      const revenue=rows.reduce((sum,row)=>sum+Number(row.values.revenue||0),0);
      const profit=rows.reduce((sum,row)=>sum+Number(row.values.profit||0),0);
      return revenue>0?(profit/revenue)*100:0;
    }

    function profitHealthBarClass(margin) {
      const key=marginHealth(margin).key;
      return key==='green'?'bg-emerald-300':key==='yellow'?'bg-amber-300':'bg-red-300';
    }

    function renderProfitabilityDashboard() {
      const range=profitabilityDateRange();
      if(mobileProfitCustomRange)mobileProfitCustomRange.classList.toggle('hidden',range.period!=='custom');
      if(mobileProfitPeriodLabel)mobileProfitPeriodLabel.textContent=range.label;
      const records=profitabilityRecords();
      const rows=records.map((record)=>({record,values:profitValues(record)}));
      const revenue=rows.reduce((sum,row)=>sum+Number(row.values.revenue||0),0);
      const grossProfit=rows.reduce((sum,row)=>sum+Number(row.values.profit||0),0);
      const directCosts=rows.reduce((sum,row)=>sum+Number(row.values.directCosts||0),0);
      const guests=rows.reduce((sum,row)=>sum+Math.max(0,Number(row.record?.inquiry?.guestCount||0)),0);
      const margin=revenue>0?(grossProfit/revenue)*100:0;
      if(mobileProfitRevenue)mobileProfitRevenue.textContent=money(revenue);
      if(mobileProfitRevenueMeta)mobileProfitRevenueMeta.textContent=rows.length+' priced record'+(rows.length===1?'':'s');
      if(mobileProfitGross)mobileProfitGross.textContent=money(grossProfit);
      if(mobileProfitMargin)mobileProfitMargin.textContent=(Number.isFinite(margin)?margin:0).toFixed(1)+'%';
      if(mobileProfitCostGuest)mobileProfitCostGuest.textContent=money(guests>0?directCosts/guests:0);
      if(mobileProfitCostGuestMeta)mobileProfitCostGuestMeta.textContent=guests+' guest'+(guests===1?'':'s')+' represented';

      const monthlyMap=new Map();
      rows.forEach((row)=>{
        const month=mobileEventMonth(row.record);
        if(!month)return;
        const existing=monthlyMap.get(month)||{month,rows:[],revenue:0,profit:0,costs:0,guests:0};
        existing.rows.push(row);
        existing.revenue+=Number(row.values.revenue||0);
        existing.profit+=Number(row.values.profit||0);
        existing.costs+=Number(row.values.directCosts||0);
        existing.guests+=Math.max(0,Number(row.record?.inquiry?.guestCount||0));
        monthlyMap.set(month,existing);
      });
      const months=[...monthlyMap.values()].sort((a,b)=>a.month.localeCompare(b.month));
      months.forEach((month)=>{month.margin=month.revenue>0?(month.profit/month.revenue)*100:0;});

      if(mobileProfitMonthly){
        mobileProfitMonthly.innerHTML='';
        const maxRevenue=Math.max(1,...months.map((month)=>month.revenue));
        months.forEach((month)=>{
          const item=document.createElement('article');item.className='rounded-lg border border-white/10 bg-black/10 p-3';
          const head=document.createElement('div');head.className='flex items-start justify-between gap-4';
          const left=document.createElement('div');left.append(text('strong','text-sm text-white',monthLabel(month.month)),text('p','mt-1 text-[.6rem] text-white/42',month.rows.length+' priced event'+(month.rows.length===1?'':'s')));
          const right=document.createElement('div');right.className='text-right';right.append(text('strong','text-sm text-white',money(month.revenue)),text('p','mt-1 text-[.6rem] text-emerald-200',money(month.profit)+' profit'));
          head.append(left,right);
          const track=document.createElement('div');track.className='mt-3 h-2 overflow-hidden rounded-full bg-black/20';
          const bar=document.createElement('div');bar.className='h-full rounded-full bg-[var(--koa-amber-light)]';bar.style.width=Math.max(2,(month.revenue/maxRevenue)*100)+'%';track.appendChild(bar);
          item.append(head,track,text('p','mt-2 text-[.6rem] text-white/45',month.margin.toFixed(1)+'% margin · '+money(month.guests?month.costs/month.guests:0)+' cost/guest'));
          mobileProfitMonthly.appendChild(item);
        });
        if(!months.length)mobileProfitMonthly.appendChild(text('p','text-sm text-white/45','No dated priced Mobile Bar records in this scope yet.'));
      }

      if(mobileProfitTrend){
        mobileProfitTrend.innerHTML='';
        const maxMargin=Math.max(60,...months.map((month)=>month.margin));
        months.forEach((month)=>{
          const item=document.createElement('div');item.className='grid gap-2';
          const head=document.createElement('div');head.className='flex items-center justify-between gap-3 text-xs';
          head.append(text('span','font-semibold text-white/75',monthLabel(month.month)),text('strong','text-white',month.margin.toFixed(1)+'%'));
          const track=document.createElement('div');track.className='h-2 overflow-hidden rounded-full bg-black/20';
          const bar=document.createElement('div');bar.className='h-full rounded-full '+profitHealthBarClass(month.margin);bar.style.width=Math.max(2,Math.min(100,(month.margin/maxMargin)*100))+'%';track.appendChild(bar);
          item.append(head,track);mobileProfitTrend.appendChild(item);
        });
        if(!months.length)mobileProfitTrend.appendChild(text('p','text-sm text-white/45','Margin trend will appear once dated priced events are available.'));
      }

      const packageMap=new Map();
      rows.forEach((row)=>{
        const id=recordPackage(row.record)||'mobile-custom';
        const group=packageMap.get(id)||{id,count:0,revenue:0,profit:0,costs:0};
        group.count+=1;group.revenue+=row.values.revenue;group.profit+=row.values.profit;group.costs+=row.values.directCosts;
        packageMap.set(id,group);
      });
      const packages=[...packageMap.values()].map((group)=>({...group,margin:group.revenue>0?(group.profit/group.revenue)*100:0})).sort((a,b)=>b.profit-a.profit);
      if(mobileProfitPackages){
        mobileProfitPackages.innerHTML='';
        const maxProfit=Math.max(1,...packages.map((group)=>Math.max(0,group.profit)));
        packages.forEach((group,index)=>{
          const item=document.createElement('div');item.className='grid gap-2';
          const head=document.createElement('div');head.className='flex items-start justify-between gap-4';
          const left=document.createElement('div');left.append(text('p','text-[.52rem] font-black uppercase tracking-[.08em] text-[var(--koa-amber-light)]','#'+(index+1)),text('strong','mt-1 block text-sm text-white',packageLabel(group.id)));
          const right=document.createElement('div');right.className='text-right';right.append(text('strong','text-sm text-white',money(group.profit)),text('p','mt-1 text-[.6rem] text-white/45',group.margin.toFixed(1)+'% · '+group.count+' record'+(group.count===1?'':'s')));
          head.append(left,right);
          const track=document.createElement('div');track.className='h-2 overflow-hidden rounded-full bg-black/20';
          const bar=document.createElement('div');bar.className='h-full rounded-full bg-emerald-300';bar.style.width=Math.max(2,(Math.max(0,group.profit)/maxProfit)*100)+'%';track.appendChild(bar);
          item.append(head,track);mobileProfitPackages.appendChild(item);
        });
        if(!packages.length)mobileProfitPackages.appendChild(text('p','text-sm text-white/45','Package profitability will populate from priced records.'));
      }

      const addonMap=new Map();
      rows.forEach((row)=>{
        quoteLines(row.record).forEach((line)=>{
          const id=String(line?.id||'');
          if(!(id in addOnCostRatios))return;
          const amount=Math.max(0,Number(line?.amount||0));
          if(amount<=0)return;
          const ratio=Number(addOnCostRatios[id]||0);
          const group=addonMap.get(id)||{id,label:String(line?.description||id),count:0,revenue:0,cost:0,profit:0};
          group.count+=1;group.revenue+=amount;group.cost+=amount*ratio;group.profit+=amount*(1-ratio);
          if(line?.description)group.label=String(line.description);
          addonMap.set(id,group);
        });
      });
      const addons=[...addonMap.values()].map((group)=>({...group,margin:group.revenue>0?(group.profit/group.revenue)*100:0})).sort((a,b)=>b.profit-a.profit);
      if(mobileProfitAddons){
        mobileProfitAddons.innerHTML='';
