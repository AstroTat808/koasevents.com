    function userRoles(user) {
      const sources=[user?.roles,user?.appMetadata?.roles,user?.app_metadata?.roles];
      return (sources.find(Array.isArray)||[]).map((role)=>String(role||'').toLowerCase());
    }
    function hasAdminAccess(user) {
      const email = String(user?.email || '').trim().toLowerCase();
      const roles = userRoles(user);
      return approvedAdminEmails.has(email) || roles.some((role) => ['admin','staff','sales','manager'].includes(role));
    }
    function hasManagerAccess(user) {
      const email = String(user?.email || '').trim().toLowerCase();
      const roles = userRoles(user);
      return approvedAdminEmails.has(email) || roles.includes('admin') || roles.includes('manager');
