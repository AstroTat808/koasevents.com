    function activityLabel(type) {
      const labels={
        quote_saved:'Quote saved', inquiry:'Inquiry received', lead:'Lead created', proposal:'Proposal created',
        proposal_sent:'Proposal sent', proposal_viewed:'Proposal viewed', proposal_accepted:'Proposal accepted',
        proposal_declined:'Proposal declined', contract_generated:'Contract generated', contract_viewed:'Contract viewed',
        contract_signed:'Client signed contract', contract_countersigned:'Koa’s countersigned contract',
        quickbooks_estimate_synced:'QBO estimate synced', quickbooks_estimate_sent:'QBO estimate emailed',
        quickbooks_invoice_created:'QBO invoice created', quickbooks_invoice_sent:'QBO invoice emailed',
        quickbooks_status_synced:'QBO status synced', client_planning_updated:'Client planning updated',
        client_document_uploaded:'Client planning document uploaded', client_document_removed:'Client planning document removed',
        event_ops_updated:'Event Ops updated', booked:'Event booked', call:'Call', email:'Email',
        meeting:'Meeting', note:'Note', responded:'Response completed',
        discovery_call_requested:'Discovery Call requested',
        lead_notification_sent:'Team lead email sent', lead_notification_failed:'Team lead email failed',
        client_confirmation_sent:'Client confirmation sent', client_confirmation_failed:'Client confirmation failed',
