    function openConvert(quote,kind) {
      convertForm.reset(); convertForm.elements.quoteId.value=quote.id; convertForm.elements.kind.value=kind;
      convertTitle.textContent=kind==='proposal'?'Create proposal draft':'Create lead';
      convertSummary.textContent='Quote '+quote.id+' · '+packageLabel(quote.state?.startingPoint)+' · '+(quote.state?.guestCount||0)+' guests · '+money(quote.state?.estimatedStartingTotal||0);
      convertMessage.textContent=''; convertDialog.showModal();
    }

    function renderQuotes() {
      quoteList.innerHTML='';
      const quotes=payload.quotes||[];
      if(!quotes.length){quoteList.appendChild(text('p','text-sm text-[var(--koa-ink)]/48','No matching saved quotes.'));return;}
      quotes.slice(0,100).forEach((quote)=>{
        const article=document.createElement('article'); article.className='rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5';
        article.append(text('p','font-mono text-xs font-bold text-[var(--koa-clay)]',quote.id),text('h3','display mt-2 text-3xl',packageLabel(quote.state?.startingPoint)),text('p','mt-2 text-sm text-[var(--koa-ink)]/55',(quote.state?.guestCount||0)+' guests · '+money(quote.state?.estimatedStartingTotal||0)));

        const conversions=payload.conversions?.[quote.id]||[];
        const proposal=conversions.find((record)=>record.kind==='proposal' && record.stage!=='lost');
        const lead=conversions.find((record)=>record.kind==='lead' && record.stage!=='lost');
        const inquiry=conversions.find((record)=>record.kind==='inquiry' && record.stage!=='lost');
        const status=document.createElement('p');
        status.className='mt-3 text-xs font-semibold text-[var(--koa-forest)]';
        status.textContent=proposal?'Proposal exists · '+proposal.id:lead?'Lead exists · '+lead.id:inquiry?'Inquiry received · '+inquiry.id:'Not yet connected to CRM';
        article.appendChild(status);

        const actions=document.createElement('div'); actions.className='mt-4 flex flex-wrap gap-2';
        const small='rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]';
        const primary='rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white';
        const open=document.createElement('a'); open.href='/catalog/?quote='+encodeURIComponent(quote.id); open.target='_blank'; open.rel='noreferrer'; open.className=small; open.textContent='Open quote';
        actions.appendChild(open);
        if(proposal) actions.append(actionButton('Open proposal',primary,()=>openProposal(proposal)));
        else if(lead) actions.append(actionButton('Build proposal',primary,()=>promote(lead,'proposal',true)));
        else if(inquiry) actions.append(actionButton('Qualify lead',primary,()=>promote(inquiry,'lead')));
        else actions.append(actionButton('Create lead',primary,()=>openConvert(quote,'lead')));
        actions.append(actionButton('Delete quote','rounded-full border border-red-200 bg-red-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-red-700',async()=>{
          if(!confirm('Permanently delete saved quote '+quote.id+'?\n\nQuotes attached to proposals or booked records are protected and cannot be deleted.')) return;
          try{
            if(message) message.textContent='Deleting saved quote '+quote.id+'…';
            await api({action:'delete-quote',quoteId:quote.id});
            await load(String(searchInput?.value||'').trim());
            if(message) message.textContent='Deleted saved quote '+quote.id+'.';
          }catch(error){if(message)message.textContent=error?.message||'Unable to delete saved quote.';}
        }));
        article.appendChild(actions); quoteList.appendChild(article);
      });
    }

    function renderTrash() {
      if(!trashList)return;
      trashList.innerHTML='';
      const rows=payload.trash||[];
      if(trashCount) trashCount.textContent=rows.length+(rows.length===1?' record':' records');
      if(!rows.length){
        trashList.appendChild(text('p','text-sm text-[var(--koa-ink)]/48','Trash is empty.'));
        return;
      }
      rows.forEach((entry)=>{
        const card=document.createElement('article');
        card.className='rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5';
        const daysLeft=Math.max(0,Math.ceil((new Date(entry.expiresAt).getTime()-Date.now())/86400000));
        card.append(
          text('p','text-[.55rem] font-black uppercase tracking-[.1em] text-[var(--koa-clay)]',entry.kind+' · Trash'),
          text('h3','mt-2 text-sm font-semibold text-[var(--koa-forest)]',entry.customerName||entry.id),
          text('p','mt-1 font-mono text-[.62rem] text-[var(--koa-ink)]/42',entry.id),
          text('p','mt-2 text-xs leading-5 text-[var(--koa-ink)]/55',[entry.eventDate,packageLabel(entry.packageId),entry.customerEmail].filter(Boolean).join(' · ')),
          text('p','mt-2 text-[.66rem] font-bold text-[var(--koa-clay)]','Purges in '+daysLeft+' day'+(daysLeft===1?'':'s'))
        );
        const actions=document.createElement('div');actions.className='mt-4 flex flex-wrap gap-2';
        actions.append(
          actionButton('Restore','rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white',async()=>{
            try{
              await api({action:'restore-record',recordId:entry.id});
              await load(String(searchInput?.value||'').trim());
              if(message)message.textContent='Restored '+entry.id+'.';
            }catch(error){if(message)message.textContent=error?.message||'Unable to restore record.';}
          }),
          actionButton('Delete permanently','rounded-full border border-red-200 bg-red-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-red-700',async()=>{
            if(!confirm('Permanently delete '+entry.id+'? This cannot be undone.')) return;
            if(!confirm('Final confirmation: permanently delete this CRM record now?')) return;
            try{
              await api({action:'permanent-delete-record',recordId:entry.id});
              await load(String(searchInput?.value||'').trim());
              if(message)message.textContent='Permanently deleted '+entry.id+'.';
            }catch(error){if(message)message.textContent=error?.message||'Unable to permanently delete record.';}
          })
        );
        card.appendChild(actions);trashList.appendChild(card);
      });
    }

    function addLine(line={id:'',description:'',quantity:1,unitPrice:0,custom:false}) {
      const row=document.createElement('div'); row.className='grid gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 lg:grid-cols-[2fr_.55fr_.8fr_auto] lg:items-end';
      row.innerHTML='<label class="grid gap-1 text-xs font-semibold">Description<input data-line-description class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><label class="grid gap-1 text-xs font-semibold">Qty<input data-line-quantity type="number" min="1" step="1" class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><label class="grid gap-1 text-xs font-semibold">Unit price<input data-line-price type="number" min="0" step="0.01" class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><button type="button" data-remove-line class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-xs">Remove</button>';
      row.dataset.lineId=line.id||'line-'+Date.now();
      row.dataset.custom=String(Boolean(line.custom));
      row.querySelector('[data-line-description]').value=line.description||'';
      row.querySelector('[data-line-quantity]').value=String(line.quantity||1);
      row.querySelector('[data-line-price]').value=String(line.unitPrice||0);
      row.querySelector('[data-remove-line]').addEventListener('click',()=>{row.remove();recalcEditor();});
      row.querySelectorAll('input').forEach((input)=>input.addEventListener('input',recalcEditor));
      lineItems.appendChild(row);
    }

    function addPayment(item={label:'Payment',dueDate:'',amount:0}) {
      const row=document.createElement('div'); row.className='grid gap-3 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4 lg:grid-cols-[1.5fr_1fr_1fr_auto] lg:items-end';
      row.innerHTML='<label class="grid gap-1 text-xs font-semibold">Label<input data-payment-label class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><label class="grid gap-1 text-xs font-semibold">Due date<input data-payment-date type="date" class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><label class="grid gap-1 text-xs font-semibold">Amount<input data-payment-amount type="number" min="0" step="0.01" class="rounded-lg border border-[var(--koa-line)] bg-white px-3 py-2"></label><button type="button" data-remove-payment class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-xs">Remove</button>';
      row.querySelector('[data-payment-label]').value=item.label||'Payment';
      row.querySelector('[data-payment-date]').value=item.dueDate||'';
      row.querySelector('[data-payment-amount]').value=String(item.amount||0);
      row.querySelector('[data-remove-payment]').addEventListener('click',()=>row.remove());
      paymentItems.appendChild(row);
    }

    function proposalLines() {
      return [...lineItems.children].map((row)=>{
        const unitPrice=Number(row.querySelector('[data-line-price]').value||0);
        return {id:row.dataset.lineId||'',description:row.querySelector('[data-line-description]').value,quantity:Number(row.querySelector('[data-line-quantity]').value||1),unitPrice,custom:row.dataset.custom==='true' && unitPrice<=0};
      });
    }
    function proposalPayments() {
      return [...paymentItems.children].map((row)=>({label:row.querySelector('[data-payment-label]').value,dueDate:row.querySelector('[data-payment-date]').value,amount:Number(row.querySelector('[data-payment-amount]').value||0)}));
    }
    function recalcEditor() {
      const subtotal=proposalLines().reduce((sum,line)=>sum+(line.quantity*line.unitPrice),0);
      const discount=Number(proposalForm.elements.discountAmount.value||0);
      const taxRate=Number(proposalForm.elements.taxRate.value||0);
      const taxable=Math.max(0,subtotal-discount);
      editorTotal.textContent=money(taxable+(taxable*taxRate/100));
    }

    function openProposal(record) {
      editingRecord=record; proposalForm.reset(); lineItems.innerHTML=''; paymentItems.innerHTML='';
      proposalForm.elements.recordId.value=record.id;
      proposalForm.elements.status.value=record.proposal?.status||'draft';
      proposalForm.elements.expirationDate.value=record.proposal?.expirationDate||'';
      proposalForm.elements.eventDate.value=record.customer?.eventDate||'';
      proposalForm.elements.name.value=record.customer?.name||'';
      proposalForm.elements.email.value=record.customer?.email||'';
      proposalForm.elements.phone.value=record.customer?.phone||'';
      proposalForm.elements.notes.value=record.customer?.notes||'';
      proposalForm.elements.discountAmount.value=String(record.proposal?.discountAmount||0);
      proposalForm.elements.taxRate.value=String(record.proposal?.taxRate||0);
      proposalForm.elements.depositAmount.value=String(record.proposal?.depositAmount||0);
      proposalForm.elements.notesToClient.value=record.proposal?.notesToClient||'';
      (record.proposal?.lineItems||[]).forEach(addLine); if(!(record.proposal?.lineItems||[]).length)addLine();
      (record.proposal?.paymentSchedule||[]).forEach(addPayment); if(!(record.proposal?.paymentSchedule||[]).length)addPayment();
      proposalTitle.textContent=record.id+' · '+packageLabel(recordPackage(record));
      const canOpen=record.proposal?.publicToken && record.proposal?.status!=='draft';
      proposalLinkWrap.classList.toggle('hidden',!canOpen);
      copyClientLink?.classList.toggle('hidden',!canOpen);
      if(canOpen) proposalLink.href='/proposal/?token='+encodeURIComponent(record.proposal.publicToken);
      const accepted=record.proposal?.acceptance;
      acceptanceInfo.classList.toggle('hidden',!accepted);
      if(accepted) acceptanceInfo.textContent='Accepted by '+accepted.name+' on '+dateTime(accepted.acceptedAt)+'.';
      renderQboProposal(record);
      proposalMessage.textContent=''; recalcEditor(); proposalDialog.showModal();
    }

    function printProposal(record) {
      const p=record.proposal||{}; const lines=(p.lineItems||[]).map((line)=>'<tr><td>'+escapeHtml(line.description)+'</td><td>'+Number(line.quantity||1)+'</td><td>'+money(line.unitPrice)+'</td><td>'+money(line.amount)+'</td></tr>').join('');
      const payments=(p.paymentSchedule||[]).map((item)=>'<li>'+escapeHtml(item.label)+' — '+(item.dueDate?escapeHtml(item.dueDate):'Date TBD')+' — '+money(item.amount)+'</li>').join('');
      const w=window.open('','_blank'); if(!w)return; w.opener=null;
      w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>'+escapeHtml(record.id)+'</title><style>body{font-family:Arial,sans-serif;color:#173D30;margin:48px;line-height:1.5}h1,h2{font-family:Georgia,serif}header{border-bottom:2px solid #173D30;padding-bottom:20px;margin-bottom:28px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:12px}.box{border:1px solid #ddd8cc;border-radius:12px;padding:16px}table{width:100%;border-collapse:collapse;margin-top:16px}th,td{text-align:left;padding:10px;border-bottom:1px solid #ddd8cc}.total{font-size:28px;font-weight:700}.muted{color:#666}@media print{button{display:none}}</style></head><body><header><p>Koa’s Events · Proposal</p><h1>'+escapeHtml(record.id)+'</h1><p class="muted">Status: '+escapeHtml(p.status||record.status)+'</p></header><section class="meta"><div class="box"><strong>Client</strong><br>'+escapeHtml(record.customer?.name||'TBD')+'<br>'+escapeHtml(record.customer?.email||'')+'<br>'+escapeHtml(record.customer?.phone||'')+'</div><div class="box"><strong>Event</strong><br>'+escapeHtml(record.customer?.eventDate||'Date TBD')+'<br>'+escapeHtml(packageLabel(recordPackage(record)))+'</div></section><h2>Pricing</h2><table><thead><tr><th>Item</th><th>Qty</th><th>Unit</th><th>Amount</th></tr></thead><tbody>'+lines+'</tbody></table><p>Subtotal: '+money(p.subtotal)+'</p><p>Discount: -'+money(p.discountAmount)+'</p><p>Tax ('+Number(p.taxRate||0)+'%): '+money(p.taxAmount)+'</p><p class="total">Total: '+money(p.total)+'</p><p>Deposit: '+money(p.depositAmount)+'</p><h2>Payment schedule</h2><ul>'+payments+'</ul><h2>Notes</h2><p>'+escapeHtml(p.notesToClient||'')+'</p><button onclick="window.print()">Print / Save PDF</button></body></html>');
      w.document.close();
    }
    function escapeHtml(value){return String(value??'').replace(/[&<>"']/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));}

    async function load(query='') {
      const user=await getUser(); if(!hasAdminAccess(user)){unauthorized?.classList.remove('hidden');return;}
      ui?.classList.remove('hidden'); if(message)message.textContent='Loading…';
      const [response,qboResponse]=await Promise.all([
        fetch('/api/admin/quotes'+(query?'?q='+encodeURIComponent(query):''),{cache:'no-store'}),
        fetch('/api/admin/quickbooks',{cache:'no-store'})
      ]);
      if(response.status===401){ui?.classList.add('hidden');unauthorized?.classList.remove('hidden');return;}
      if(!response.ok){if(message)message.textContent='Unable to load CRM data.';return;}
      payload=await response.json();
      qboState=qboResponse.ok?await qboResponse.json():null;
      const liveIds=new Set((payload.records||[]).map((record)=>record.id));
      [...selectedRecordIds].forEach((id)=>{if(!liveIds.has(id))selectedRecordIds.delete(id);});
      updateSelectionUi();
      if(message)message.textContent=(payload.records||[]).length+' CRM records · '+(payload.quotes||[]).length+' saved quotes shown.';
      renderStats();renderWorkQueue();renderUnansweredLeads();renderFunnel();renderMobileBar();renderPipeline();renderLostLeads();renderBookedDashboard();renderQuotes();renderTrash();
    }

    searchForm?.addEventListener('submit',(event)=>{event.preventDefault();load(String(searchInput?.value||'').trim());});
    [mobileFilterStage,mobileFilterPackage,mobileFilterQuote,mobileFilterFollowup,mobileSort].forEach((control)=>control?.addEventListener('change',renderMobileBar));
    document.querySelectorAll('[data-close-convert]').forEach((button)=>button.addEventListener('click',()=>convertDialog.close()));
    document.querySelectorAll('[data-close-proposal]').forEach((button)=>button.addEventListener('click',()=>proposalDialog.close()));
    document.querySelector('[data-add-line]')?.addEventListener('click',()=>addLine());
    document.querySelector('[data-add-payment]')?.addEventListener('click',()=>addPayment());
    proposalForm?.querySelectorAll('[name="discountAmount"],[name="taxRate"]').forEach((input)=>input.addEventListener('input',recalcEditor));

    convertForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();const data=new FormData(convertForm);convertMessage.textContent='Creating…';
      try{
        const result=await api({action:'convert',quoteId:data.get('quoteId'),kind:data.get('kind'),customer:{name:data.get('name'),email:data.get('email'),phone:data.get('phone'),eventDate:data.get('eventDate'),notes:data.get('notes')}});
        convertMessage.textContent=(result.reused?'Existing record opened: ':'Created ')+result.record.id+'.'; setTimeout(()=>convertDialog.close(),500); await load(String(searchInput?.value||'').trim());
        if(result.record.kind==='proposal') openProposal(result.record);
      }catch(error){convertMessage.textContent=error.message||'Unable to create record.';}
    });

    proposalForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();proposalMessage.textContent='Saving…';const data=new FormData(proposalForm);
      try{
        const result=await api({action:'update-proposal',recordId:data.get('recordId'),proposal:{status:data.get('status'),expirationDate:data.get('expirationDate'),discountAmount:Number(data.get('discountAmount')||0),taxRate:Number(data.get('taxRate')||0),depositAmount:Number(data.get('depositAmount')||0),notesToClient:data.get('notesToClient'),lineItems:proposalLines(),paymentSchedule:proposalPayments(),customer:{name:data.get('name'),email:data.get('email'),phone:data.get('phone'),eventDate:data.get('eventDate'),notes:data.get('notes')}}});
        editingRecord=result.record;proposalMessage.textContent='Saved.';await load(String(searchInput?.value||'').trim());openProposal(result.record);
      }catch(error){proposalMessage.textContent=error.message||'Unable to save proposal.';}
    });

    document.querySelectorAll('[data-close-activity]').forEach((button)=>button.addEventListener('click',()=>activityDialog?.close()));
    document.querySelectorAll('[data-close-booking]').forEach((button)=>button.addEventListener('click',()=>bookingDialog?.close()));

    qboSyncEstimateButton?.addEventListener('click',async()=>{
      if(!editingRecord||!quickBooksReady())return;
      if(proposalMessage)proposalMessage.textContent='Synchronizing QuickBooks estimate…';
      try{const refreshed=await runQuickBooks('sync-estimate',editingRecord);editingRecord=refreshed;openProposal(refreshed);}catch(error){if(proposalMessage)proposalMessage.textContent=error.message||'Unable to sync QuickBooks estimate.';}
    });

    qboSendEstimateButton?.addEventListener('click',async()=>{
      if(!editingRecord||!quickBooksReady())return;
      if(proposalMessage)proposalMessage.textContent='Emailing estimate from QuickBooks…';
      try{const refreshed=await runQuickBooks('send-estimate',editingRecord);editingRecord=refreshed;openProposal(refreshed);}catch(error){if(proposalMessage)proposalMessage.textContent=error.message||'Unable to email QuickBooks estimate.';}
    });

    qboSyncStatusButton?.addEventListener('click',async()=>{
      if(!bookingRecord||!qboState?.connection?.connected)return;
      if(bookingMessage)bookingMessage.textContent='Synchronizing QuickBooks balances…';
      try{const refreshed=await runQuickBooks('sync-status',bookingRecord);bookingRecord=refreshed;openBooking(refreshed);}catch(error){if(bookingMessage)bookingMessage.textContent=error.message||'Unable to sync QuickBooks.';}
    });

    countersignButton?.addEventListener('click',async()=>{
      if(!bookingRecord)return;
      const name=String(countersignName?.value||'').trim();
      if(name.length<2){if(bookingMessage)bookingMessage.textContent='Enter the authorized Koa’s signer name.';return;}
