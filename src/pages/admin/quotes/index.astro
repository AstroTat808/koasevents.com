    function openProfitModel(record) {
      if(!profitDialog||!profitForm)return;
      profitRecord=record;
      const model=record.profitModel||{};
      const costMode=recordCostMode(record);
      profitForm.elements.recordId.value=record.id;
      profitForm.elements.costMode.value=costMode;
      profitForm.elements.bartenderWageRate.value=String(model.bartenderWageRate ?? 40);
      const initial=costMode==='auto'?profitValues(record,{costMode,bartenderWageRate:Number(model.bartenderWageRate??40)}):profitValues(record,{...model,costMode});
      ['iceCost','mixersCost','garnishesCost','cupsCost','suppliesCost','travelCost','addOnCost','gratuityCost','otherDirectCosts'].forEach((key)=>{
        profitForm.elements[key].value=String(Math.round(Number(initial[key]||0)*100)/100);
      });
      profitForm.elements.notes.value=String(model.notes||'');
      if(profitTitle)profitTitle.textContent=(record.customer?.name||record.id)+' · margin';
      if(profitMeta)profitMeta.textContent=[packageLabel(recordPackage(record)),record.customer?.eventDate,record.inquiry?.guestCount?record.inquiry.guestCount+' guests':''].filter(Boolean).join(' · ');
      if(profitMessage)profitMessage.textContent=costMode==='auto'?'Automatic operating estimate loaded.':'Saved manual actual-cost model loaded.';
      recalcProfitDialog();
      profitDialog.showModal();
    }
