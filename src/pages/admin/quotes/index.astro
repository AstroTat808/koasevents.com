    function responseWaitSince(record) {
      const values=[record.createdAt];
      (record.timeline||[]).forEach((event)=>{
        if(event?.createdAt && ['inquiry','lead'].includes(String(event.type||''))) values.push(event.createdAt);
      });
      const times=values.map((value)=>new Date(value||0).getTime()).filter((value)=>Number.isFinite(value)&&value>0);
      return times.length ? Math.min(...times) : new Date(record.createdAt||0).getTime();
    }

    function hstBusinessHoursBetween(startMs,endMs=Date.now()) {
      if(!Number.isFinite(startMs)||endMs<=startMs)return 0;
      const offset=-10*60*60*1000;
      const localStart=startMs+offset;
      const localEnd=endMs+offset;
      const firstDay=Math.floor(localStart/86400000)*86400000;
      const lastDay=Math.floor(localEnd/86400000)*86400000;
      let total=0;
      for(let dayMs=firstDay;dayMs<=lastDay;dayMs+=86400000){
        const day=new Date(dayMs).getUTCDay();
        if(day===0||day===6)continue;
        const open=dayMs+9*3600000;
        const close=dayMs+17*3600000;
        const from=Math.max(localStart,open);
        const to=Math.min(localEnd,close);
        if(to>from)total+=to-from;
      }
      return total/3600000;
    }

    function waitingLabel(startMs) {
      const wall=Math.max(0,(Date.now()-startMs)/3600000);
      const business=hstBusinessHoursBetween(startMs);
      if(wall<24)return Math.max(0,Math.floor(wall))+'h elapsed · '+business.toFixed(business<10?1:0)+' business hr';
      const days=Math.floor(wall/24);
      const hours=Math.floor(wall%24);
      return days+'d '+hours+'h elapsed · '+business.toFixed(business<10?1:0)+' business hr';
    }

    function renderUnansweredLeads() {
      if(!unansweredLeads)return;
      unansweredLeads.innerHTML='';
      const rows=(payload.records||[])
        .filter((record)=>['inquiry','lead'].includes(record.kind)&&['inquiry','lead'].includes(record.stage)&&!hasResponseActivity(record))
        .map((record)=>({record,startMs:responseWaitSince(record)}))
        .sort((a,b)=>a.startMs-b.startMs);

      if(unansweredCount)unansweredCount.textContent=rows.length+(rows.length===1?' waiting':' waiting');

      rows.forEach(({record,startMs})=>{
        const card=document.createElement('article');
        card.className='rounded-[1.2rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5';
        const business=hstBusinessHoursBetween(startMs);
        const overdue=business>=4;
        card.append(
          text('p','text-[.54rem] font-black uppercase tracking-[.1em] '+(overdue?'text-red-700':'text-[var(--koa-clay)]'),overdue?'Response SLA due':'Waiting for first response'),
          text('h3','mt-2 text-base font-semibold text-[var(--koa-forest)]',record.customer?.name||'Client name TBD'),
          text('p','mt-1 text-xs leading-5 text-[var(--koa-ink)]/50',[record.customer?.eventDate,packageLabel(recordPackage(record)),record.customer?.email].filter(Boolean).join(' · ')),
          text('p','mt-3 text-xs font-bold '+(overdue?'text-red-700':'text-[var(--koa-ink)]/60'),waitingLabel(startMs))
        );

        appendCommunicationStatus(card,record);

