    copyClientLink?.addEventListener('click',async()=>{
      if(!editingRecord?.proposal?.publicToken)return;
      const url=window.location.origin+'/proposal/?token='+encodeURIComponent(editingRecord.proposal.publicToken);
      try{
        await navigator.clipboard.writeText(url);
        copyClientLink.textContent='Copied ✓';
        window.setTimeout(()=>copyClientLink.textContent='Copy client link',1200);
      }catch{
        proposalMessage.textContent='Client link: '+url;
      }
