    document.querySelector('[data-print-proposal]')?.addEventListener('click',()=>{if(editingRecord)printProposal(editingRecord);});

    clearSelectionButton?.addEventListener('click',()=>{
      selectedRecordIds.clear();
      updateSelectionUi();
      renderPipeline();
      renderMobileBar();
    });

    bulkLostButton?.addEventListener('click',async()=>{
      const ids=[...selectedRecordIds];
      if(!ids.length)return;
      if(!confirm('Mark '+ids.length+' selected CRM record'+(ids.length===1?'':'s')+' as lost?'))return;
      try{
        const result=await api({action:'bulk-lost',recordIds:ids});
        selectedRecordIds.clear();
        await load(String(searchInput?.value||'').trim());
        if(message)message.textContent=(result.updated||[]).length+' record(s) marked lost'+((result.skipped||[]).length?' · '+result.skipped.length+' skipped':'')+'.';
      }catch(error){if(message)message.textContent=error?.message||'Unable to mark selected records lost.';}
    });

    bulkTrashButton?.addEventListener('click',async()=>{
      const ids=[...selectedRecordIds];
      if(!ids.length)return;
      if(!confirm('Move '+ids.length+' selected CRM record'+(ids.length===1?'':'s')+' to Trash for 30 days?'))return;
      try{
        const result=await api({action:'bulk-trash',recordIds:ids});
        selectedRecordIds.clear();
        await load(String(searchInput?.value||'').trim());
        if(message)message.textContent=(result.moved||[]).length+' record(s) moved to Trash'+((result.skipped||[]).length?' · '+result.skipped.length+' skipped':'')+'.';
      }catch(error){if(message)message.textContent=error?.message||'Unable to move selected records to Trash.';}
    });

    const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
    if (searchInput && initialQuery) searchInput.value = initialQuery;
    updateSelectionUi();
    load(initialQuery);
  </script>
</BaseLayout>
