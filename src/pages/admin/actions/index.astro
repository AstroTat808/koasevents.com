---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout noindex title="Action Center | Koa’s Events" description="One prioritized inbox for operational items that need attention across Koa’s admin." canonical="https://koasevents.com/admin/actions/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-8">
    <div class="container-shell max-w-5xl">
      <header class="rounded-[1.5rem] bg-[var(--koa-ink)] p-6 text-white shadow-[var(--shadow-soft)]">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow text-[var(--koa-amber-light)]">Operations inbox</p>
            <h1 class="display mt-2 text-5xl">Action Center</h1>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-white/62">Prioritized work across CRM, Sales, QuickBooks, System Health, vendor insurance, and staff security—with safe one-tap actions for routine fixes.</p>
          </div>
          <button data-refresh type="button" class="rounded-full border border-white/20 bg-white/[.06] px-4 py-3 text-[.6rem] font-black uppercase tracking-[.08em] text-white">Refresh</button>
        </div>
      </header>

      <section data-unauthorized class="mt-5 hidden rounded-[1.3rem] bg-white p-6 shadow-[var(--shadow-soft)]">
        <h2 class="display text-3xl text-[var(--koa-forest)]">Workspace access required</h2>
      </section>

      <div data-app class="mt-5 hidden grid gap-5">
        <section class="grid grid-cols-3 gap-2">
          <article class="rounded-xl border border-red-200 bg-red-50 p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-red-700">Critical</p><strong data-count-urgent class="display mt-2 block text-3xl text-red-900">0</strong></article>
          <article class="rounded-xl border border-amber-200 bg-amber-50 p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-amber-800">Warning</p><strong data-count-upcoming class="display mt-2 block text-3xl text-amber-900">0</strong></article>
          <article class="rounded-xl border border-sky-200 bg-sky-50 p-4"><p class="text-[.54rem] font-black uppercase tracking-[.08em] text-sky-800">Info</p><strong data-count-info class="display mt-2 block text-3xl text-sky-900">0</strong></article>
        </section>

        <section class="rounded-[1.3rem] bg-white p-4 shadow-[var(--shadow-soft)]">
          <div class="grid gap-4 lg:grid-cols-[auto_1fr_auto] lg:items-end">
            <div>
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Assignment</p>
              <div class="mt-2 inline-flex rounded-full bg-[var(--koa-sand)] p-1">
                <button data-scope="mine" type="button" class="action-scope">Mine <span data-mine-count></span></button>
                <button data-scope="everyone" type="button" class="action-scope is-active">Everyone</button>
              </div>
            </div>
            <div>
              <p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Filter</p>
              <div class="mt-2 flex gap-2 overflow-x-auto pb-1" data-filters>
                <button data-filter="all" class="action-filter is-active" type="button">All</button>
                <button data-filter="urgent" class="action-filter" type="button">Critical</button>
                <button data-filter="unansweredLeads" class="action-filter" type="button">Sales</button>
                <button data-filter="overdueTasks" class="action-filter" type="button">CRM</button>
                <button data-filter="accountingMismatches" class="action-filter" type="button">Accounting</button>
                <button data-filter="healthWarnings" class="action-filter" type="button">Health</button>
                <button data-filter="vendorInsurance" class="action-filter" type="button">Vendors</button>
                <button data-filter="securityWarnings" class="action-filter" type="button">Staff / Security</button>
              </div>
            </div>
            <label class="grid gap-2 text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Sort
              <select data-sort class="min-h-11 rounded-xl border border-[var(--koa-line)] bg-white px-3 text-sm font-semibold normal-case tracking-normal text-[var(--koa-forest)]">
                <option value="priority">Priority first</option>
                <option value="oldest">Oldest first</option>
                <option value="newest">Newest first</option>
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <p data-preference-status class="text-xs text-[var(--koa-ink)]/42"></p>
            <button data-staff-filter-clear type="button" class="hidden rounded-full border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-3 py-2 text-[.56rem] font-black uppercase tracking-[.06em] text-[var(--koa-forest)]"></button>
          </div>
        </section>

        <section class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div><p class="eyebrow text-[var(--koa-clay)]">Team workload</p><h2 class="display mt-2 text-4xl">Action workload by staff</h2><p class="mt-2 text-sm text-[var(--koa-ink)]/50">Active assignments, overdue deadlines, completed items from the last 7 days, and first-response SLAs approaching within one business hour.</p></div>
            <span data-unassigned class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-black text-[var(--koa-forest)]">0 unassigned</span>
          </div>
          <div data-team-dashboard class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-3"></div>
        </section>

        <section data-inbox-section class="rounded-[1.5rem] bg-white p-5 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div><p class="eyebrow text-[var(--koa-clay)]">Prioritized inbox</p><h2 class="display mt-2 text-4xl">What needs action now</h2></div>
            <span data-total class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-black text-[var(--koa-forest)]">0 items</span>
          </div>
          <div data-bulk-bar class="mt-4 hidden rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-3">
            <div class="flex flex-wrap items-center gap-2">
              <strong data-selected-count class="mr-auto text-sm text-[var(--koa-forest)]">0 selected</strong>
              <button data-select-visible type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Select visible safe</button>
              <button data-clear-selection type="button" class="rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]">Clear</button>
              <button data-run-selected-type="complete_crm_task" type="button" class="hidden rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-white">Complete all selected CRM tasks</button>
              <button data-run-selected-type="mark_lead_responded" type="button" class="hidden rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-white">Mark all selected leads responded</button>
              <button data-run-selected-type="recheck_quickbooks" type="button" class="hidden rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-white">Sync & recheck selected QuickBooks</button>
              <button data-run-selected-type="rerun_health" type="button" class="hidden rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.56rem] font-black uppercase tracking-[.07em] text-white">Re-run System Health</button>
            </div>
            <p data-bulk-status class="mt-2 text-xs text-[var(--koa-ink)]/50"></p>
          </div>
          <div data-list class="mt-5 grid gap-3"></div>
        </section>
      </div>
    </div>
  </main>

  <style>
    .action-filter,.action-scope{flex:0 0 auto;min-height:2.55rem;border:1px solid var(--koa-line);border-radius:9999px;background:white;padding:.6rem .8rem;color:var(--koa-forest);font-size:.58rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
    .action-filter.is-active,.action-scope.is-active{border-color:var(--koa-forest);background:var(--koa-forest);color:white}
    .action-scope{border-color:transparent;background:transparent}
  </style>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const app=document.querySelector('[data-app]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const list=document.querySelector('[data-list]');
    const total=document.querySelector('[data-total]');
    const refresh=document.querySelector('[data-refresh]');
    const sortSelect=document.querySelector('[data-sort]');
    const preferenceStatus=document.querySelector('[data-preference-status]');
    const teamDashboard=document.querySelector('[data-team-dashboard]');
    const unassigned=document.querySelector('[data-unassigned]');
    const bulkBar=document.querySelector('[data-bulk-bar]');
    const selectedCount=document.querySelector('[data-selected-count]');
    const bulkStatus=document.querySelector('[data-bulk-status]');
    const staffFilterClear=document.querySelector('[data-staff-filter-clear]');
    const inboxSection=document.querySelector('[data-inbox-section]');
    let payload={alerts:[],severityCounts:{urgent:0,upcoming:0,info:0},total:0,mineCount:0};
    let filter='all';
    let sort='priority';
    let scope='everyone';
    let session=null;
    let capabilities=new Set();
    let staffFilter='';
    let staffFilterName='';
    const selectedAlerts=new Set();

    const categoryLabel={
      overdueTasks:'CRM task',
      unansweredLeads:'Sales response',
      accountingMismatches:'Accounting',
      healthWarnings:'System Health',
      vendorInsurance:'Vendor insurance',
      securityWarnings:'Staff / Security',
    };

    function escapeHtml(value){
      return String(value??'').replace(/[&<>"']/g,(ch)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    }

    function timeLabel(value){
      const ms=Date.parse(String(value||''));
      if(!Number.isFinite(ms))return '';
      return new Intl.DateTimeFormat('en-US',{timeZone:'Pacific/Honolulu',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(new Date(ms));
    }

    function durationLabel(ms){
      const value=Math.max(0,Number(ms||0));
      const minutes=Math.floor(value/60000);
      const days=Math.floor(minutes/1440);
      const hours=Math.floor((minutes%1440)/60);
      const mins=minutes%60;
      if(days)return days+'d '+hours+'h';
      if(hours)return hours+'h '+mins+'m';
      return Math.max(1,mins)+'m';
    }

    function deadlineCopy(alert){
      const dueMs=Date.parse(String(alert?.dueAt||''));
      const now=Date.now();
      const ageMs=Math.max(0,now-(Date.parse(String(alert?.firstAppearedAt||''))||now));
      const bits=['Open '+durationLabel(ageMs)];
      if(Number.isFinite(dueMs)){
        if(alert?.deadlineKind==='sla'){
          bits.push(dueMs<=now?'SLA overdue '+durationLabel(now-dueMs):'SLA due in '+durationLabel(dueMs-now));
        }else if(alert?.deadlineKind==='task'){
          bits.push('Due '+timeLabel(alert.dueAt)+(dueMs<=now?' · overdue '+durationLabel(now-dueMs):''));
        }else if(alert?.deadlineKind==='event'){
          bits.push(dueMs<=now?'Event date reached':'Event in '+durationLabel(dueMs-now));
        }
      }
      return bits;
    }

    function syncControls(){
      document.querySelectorAll('[data-filter]').forEach((node)=>node.classList.toggle('is-active',node.dataset.filter===filter));
      document.querySelectorAll('[data-scope]').forEach((node)=>node.classList.toggle('is-active',node.dataset.scope===scope));
      if(sortSelect instanceof HTMLSelectElement)sortSelect.value=sort;
    }

    async function savePreferences(){
      if(preferenceStatus)preferenceStatus.textContent='Saving view…';
      try{
        const response=await fetch('/api/account/profile',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:'save-action-center-preferences',preferences:{filter,sort,scope}}),
        });
        if(!response.ok)throw new Error('Unable to save Action Center preferences.');
        if(preferenceStatus)preferenceStatus.textContent='View saved for this account.';
      }catch(error){
        if(preferenceStatus)preferenceStatus.textContent=error instanceof Error?error.message:'Unable to save view.';
      }
    }

    async function loadPreferences(){
      try{
        const response=await fetch('/api/account/profile',{cache:'no-store'});
        if(!response.ok)return;
        const profile=await response.json();
        const prefs=profile?.actionCenterPreferences||{};
        filter=String(prefs.filter||'all');
        sort=String(prefs.sort||'priority');
        scope=String(prefs.scope||'everyone');
      }catch{}
      syncControls();
    }

    async function action(actionName,extra={}){
      const response=await fetch('/api/admin/workspace-alerts',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:actionName,...extra})});
      if(!response.ok)return false;
      await load();
      window.dispatchEvent(new Event('koa:workspace-alerts-refresh'));
      return true;
    }

    async function openAlert(alert){
      if(alert?.isNew&&alert?.occurrenceId){
        try{await fetch('/api/admin/workspace-alerts',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'mark-seen',occurrenceIds:[alert.occurrenceId]})});}catch{}
      }
      window.location.assign(alert?.href||'/admin/');
    }

    function canRunQuickAction(alert){
      const required=String(alert?.quickAction?.capability||'');
      return Boolean(alert?.quickAction?.type)&&(!required||capabilities.has(required));
    }

    async function runQuickAction(alert,button,status){
      const quick=alert?.quickAction||{};
      let url='',body={};
      if(quick.type==='complete_crm_task'){
        url='/api/admin/crm';body={action:'toggle-task',taskId:quick.resourceId};
      }else if(quick.type==='mark_lead_responded'){
        url='/api/admin/quotes';body={action:'log-activity',recordId:quick.resourceId,type:'responded',detail:'Lead marked responded from Action Center.'};
      }else if(quick.type==='recheck_quickbooks'){
        url='/api/admin/quickbooks';body={action:'sync-and-recheck',recordId:quick.resourceId};
      }else if(quick.type==='rerun_health'){
        url='/api/admin/health';body={};
      }else return;

      const previous=button.textContent;
      button.disabled=true;
      button.textContent='Working…';
      if(status)status.textContent='';
      try{
        const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(data.error||'Action failed.');
        if(status)status.textContent=quick.type==='rerun_health'?'Health checks completed.':'Action completed.';
        await load();
        window.dispatchEvent(new Event('koa:workspace-alerts-refresh'));
      }catch(error){
        if(status)status.textContent=error instanceof Error?error.message:'Action failed.';
        button.disabled=false;
        button.textContent=previous;
      }
    }

    async function runSelectedType(type,button){
      const alerts=(payload?.alerts||[]).filter((row)=>selectedAlerts.has(row.occurrenceId)&&canRunQuickAction(row)&&row.quickAction?.type===type);
      if(!alerts.length)return;
      const previous=button.textContent;
      button.disabled=true;
      button.textContent='Working…';
      if(bulkStatus)bulkStatus.textContent='Running '+alerts.length+' '+(alerts.length===1?'action':'actions')+'…';
      try{
        if(type==='complete_crm_task'){
          const taskIds=alerts.map(row=>row.quickAction.resourceId).filter(Boolean);
          const response=await fetch('/api/admin/crm',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'complete-tasks',taskIds})});
          const data=await response.json().catch(()=>({}));
          if(!response.ok)throw new Error(data.error||'Unable to complete selected CRM tasks.');
        }else if(type==='mark_lead_responded'){
          for(const alert of alerts){
            const response=await fetch('/api/admin/quotes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'log-activity',recordId:alert.quickAction.resourceId,type:'responded',detail:'Lead marked responded from Action Center bulk action.'})});
            const data=await response.json().catch(()=>({}));
            if(!response.ok)throw new Error(data.error||'Unable to mark a selected lead responded.');
          }
        }else if(type==='recheck_quickbooks'){
          for(const alert of alerts){
            const response=await fetch('/api/admin/quickbooks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'sync-and-recheck',recordId:alert.quickAction.resourceId})});
            const data=await response.json().catch(()=>({}));
            if(!response.ok)throw new Error(data.error||'Unable to recheck a selected QuickBooks item.');
          }
        }else if(type==='rerun_health'){
          const response=await fetch('/api/admin/health',{method:'POST'});
          const data=await response.json().catch(()=>({}));
          if(!response.ok)throw new Error(data.error||'Unable to re-run System Health.');
        }

        alerts.forEach((alert)=>selectedAlerts.delete(alert.occurrenceId));
        if(bulkStatus){
          const labels={
            complete_crm_task:'Selected CRM tasks completed.',
            mark_lead_responded:'Selected leads marked responded.',
            recheck_quickbooks:'Selected QuickBooks items synced and rechecked.',
            rerun_health:'System Health checks completed.',
          };
          bulkStatus.textContent=labels[type]||'Selected action completed.';
        }
        await load();
        window.dispatchEvent(new Event('koa:workspace-alerts-refresh'));
      }catch(error){
        if(bulkStatus)bulkStatus.textContent=error instanceof Error?error.message:'Bulk action failed.';
      }finally{
        button.disabled=false;
        button.textContent=previous;
        updateBulkBar();
      }
    }

    function updateBulkBar(){
      const selected=(payload?.alerts||[]).filter((row)=>selectedAlerts.has(row.occurrenceId)&&canRunQuickAction(row));
      const count=selected.length;
      if(selectedCount)selectedCount.textContent=count+' selected';
      bulkBar?.classList.toggle('hidden',count===0);
      const labels={
        complete_crm_task:'Complete all selected CRM tasks',
        mark_lead_responded:'Mark all selected leads responded',
        recheck_quickbooks:'Sync & recheck selected QuickBooks',
        rerun_health:'Re-run System Health',
      };
      document.querySelectorAll('[data-run-selected-type]').forEach((button)=>{
        if(!(button instanceof HTMLButtonElement))return;
        const type=String(button.dataset.runSelectedType||'');
        const typeCount=selected.filter((row)=>row.quickAction?.type===type).length;
        button.classList.toggle('hidden',typeCount===0);
        button.disabled=typeCount===0;
        button.textContent=(labels[type]||'Run selected')+(type==='rerun_health'?'':(' ('+typeCount+')'));
      });
    }

    function rowsForView(){
      const scoped=(payload?.alerts||[]).filter((row)=>{
        if(staffFilter)return String(row?.assigneeEmail||'').toLowerCase()===staffFilter.toLowerCase();
        return scope==='everyone'||row.assignedToMe;
      });
      const mineCount=(payload?.alerts||[]).filter((row)=>row.assignedToMe).length;
      const mineNode=document.querySelector('[data-mine-count]');
      if(mineNode)mineNode.textContent='('+mineCount+')';

      const counts={
        urgent:scoped.filter((row)=>row.severity==='urgent').length,
        upcoming:scoped.filter((row)=>row.severity==='upcoming').length,
        info:scoped.filter((row)=>row.severity==='info').length,
      };
      document.querySelector('[data-count-urgent]').textContent=String(counts.urgent);
      document.querySelector('[data-count-upcoming]').textContent=String(counts.upcoming);
      document.querySelector('[data-count-info]').textContent=String(counts.info);

      const filtered=scoped.filter((row)=>filter==='all'||(filter==='urgent'?row.severity==='urgent':row.category===filter));
      const severityRank={urgent:0,upcoming:1,info:2};
      return [...filtered].sort((a,b)=>{
        const atA=Date.parse(a.firstAppearedAt||a.lastSeenAt||'')||0;
        const atB=Date.parse(b.firstAppearedAt||b.lastSeenAt||'')||0;
        if(sort==='oldest')return atA-atB;
        if(sort==='newest')return atB-atA;
        return (severityRank[a.severity]??9)-(severityRank[b.severity]??9)
          ||Number(Boolean(b.isNew))-Number(Boolean(a.isNew))
          ||atA-atB;
      });
    }

    function renderTeamDashboard(){
      if(unassigned)unassigned.textContent=Number(payload?.unassignedCount||0)+' unassigned';
      if(!teamDashboard)return;
      teamDashboard.innerHTML='';
      const rows=Array.isArray(payload?.teamDashboard)?payload.teamDashboard:[];
      rows.forEach((row)=>{
        const card=document.createElement('button');
        card.type='button';
        const active=staffFilter&&String(row.email||'').toLowerCase()===staffFilter.toLowerCase();
        card.className='w-full rounded-xl border p-4 text-left transition '+(
          active?'border-[var(--koa-forest)] bg-white ring-2 ring-[var(--koa-forest)] ring-offset-2':
          Number(row.overdue||0)>0?'border-red-200 bg-red-50':
          Number(row.approachingSla||0)>0?'border-amber-200 bg-amber-50':'border-[var(--koa-line)] bg-[var(--koa-ivory)]'
        );
        card.setAttribute('aria-pressed',active?'true':'false');
        card.setAttribute('aria-label',(active?'Clear ':'Filter Action Center to ')+(row.name||row.email));
        card.innerHTML='<div class="flex items-start justify-between gap-3"><div><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Staff workload'+(active?' · Filtered':'')+'</p><h3 class="mt-1 text-sm font-semibold text-[var(--koa-forest)]">'+escapeHtml(row.name||row.email)+'</h3><p class="mt-1 text-[.62rem] text-[var(--koa-ink)]/45">'+escapeHtml(row.email||'')+'</p></div><span class="rounded-full bg-white/80 px-2.5 py-1 text-[.54rem] font-black uppercase tracking-[.06em] text-[var(--koa-forest)]">'+Number(row.assigned||0)+' active</span></div><div class="mt-4 grid grid-cols-3 gap-2 text-center"><div class="rounded-lg bg-white/70 p-2"><strong class="block text-lg text-red-800">'+Number(row.overdue||0)+'</strong><span class="text-[.52rem] font-black uppercase tracking-[.06em] text-[var(--koa-ink)]/45">Overdue</span></div><div class="rounded-lg bg-white/70 p-2"><strong class="block text-lg text-emerald-800">'+Number(row.completedThisWeek||0)+'</strong><span class="text-[.52rem] font-black uppercase tracking-[.06em] text-[var(--koa-ink)]/45">Done 7d</span></div><div class="rounded-lg bg-white/70 p-2"><strong class="block text-lg text-amber-800">'+Number(row.approachingSla||0)+'</strong><span class="text-[.52rem] font-black uppercase tracking-[.06em] text-[var(--koa-ink)]/45">SLA soon</span></div></div>';
        card.addEventListener('click',()=>{
          const email=String(row.email||'').toLowerCase();
          if(staffFilter===email){
            staffFilter='';
            staffFilterName='';
          }else{
            staffFilter=email;
            staffFilterName=String(row.name||row.email||'Staff member');
            scope='everyone';
          }
          selectedAlerts.clear();
          render();
          inboxSection?.scrollIntoView({behavior:'smooth',block:'start'});
        });
        teamDashboard.appendChild(card);
      });
      if(!rows.length)teamDashboard.innerHTML='<p class="text-sm text-[var(--koa-ink)]/45">No assigned workload is available yet.</p>';
    }

    function render(){
      syncControls();
      renderTeamDashboard();
      if(staffFilterClear instanceof HTMLButtonElement){
        staffFilterClear.classList.toggle('hidden',!staffFilter);
        staffFilterClear.textContent=staffFilter?'Showing '+staffFilterName+' · Clear':'';
      }
      const rows=rowsForView();
      total.textContent=rows.length+' item'+(rows.length===1?'':'s');
      list.innerHTML='';
      for(const alert of rows){
        const card=document.createElement('article');
        const urgent=alert.severity==='urgent';
        const upcoming=alert.severity==='upcoming';
        card.className='rounded-[1.1rem] border p-4 '+(urgent?'border-red-200 bg-red-50':upcoming?'border-amber-200 bg-amber-50':'border-sky-200 bg-sky-50');
        const assignment=alert.assigneeEmail
          ? '<p class="mt-2 text-[.62rem] font-bold text-[var(--koa-clay)]">Assigned to '+escapeHtml(alert.assigneeName||alert.assigneeEmail)+(alert.assignedToMe?' · Mine':'')+'</p>'
          : '<p class="mt-2 text-[.62rem] text-[var(--koa-ink)]/38">Shared / unassigned item</p>';
        const deadlineBits=deadlineCopy(alert);
        card.innerHTML='<div class="flex items-start justify-between gap-3"><div><p class="text-[.54rem] font-black uppercase tracking-[.08em] '+(urgent?'text-red-700':upcoming?'text-amber-800':'text-sky-800')+'">'+escapeHtml(categoryLabel[alert.category]||alert.category)+(alert.isNew?' · New':'')+'</p><h3 class="mt-1 text-sm font-semibold text-[var(--koa-forest)]">'+escapeHtml(alert.title||'Action item')+'</h3></div><span class="shrink-0 rounded-full bg-white/80 px-2.5 py-1 text-[.54rem] font-black uppercase tracking-[.06em]">'+(urgent?'Critical':upcoming?'Warning':'Info')+'</span></div><p class="mt-2 text-xs font-semibold text-[var(--koa-ink)]/60">'+escapeHtml(alert.context||'')+'</p><p class="mt-2 text-xs leading-5 text-[var(--koa-ink)]/58">'+escapeHtml(alert.detail||'')+'</p>'+assignment+'<div class="mt-3 flex flex-wrap gap-2">'+deadlineBits.map((bit,index)=>'<span class="rounded-full '+(alert.deadlineState==='overdue'&&index>0?'bg-red-100 text-red-800':alert.deadlineState==='approaching'&&index>0?'bg-amber-100 text-amber-900':'bg-white/80 text-[var(--koa-ink)]/55')+' px-2.5 py-1 text-[.58rem] font-bold">'+escapeHtml(bit)+'</span>').join('')+'</div>';
        const status=document.createElement('p');status.className='mt-3 text-xs font-semibold text-[var(--koa-ink)]/55';
        const actions=document.createElement('div');actions.className='mt-4 flex flex-wrap gap-2';

        if(canRunQuickAction(alert)){
          const select=document.createElement('label');
          select.className='inline-flex min-h-9 cursor-pointer items-center gap-2 rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.56rem] font-black uppercase tracking-[.06em] text-[var(--koa-forest)]';
          const checkbox=document.createElement('input');
          checkbox.type='checkbox';
          checkbox.checked=selectedAlerts.has(alert.occurrenceId);
          checkbox.addEventListener('change',()=>{
            if(checkbox.checked)selectedAlerts.add(alert.occurrenceId);
            else selectedAlerts.delete(alert.occurrenceId);
            updateBulkBar();
          });
          const labelText=document.createElement('span');labelText.textContent='Select';
          select.append(checkbox,labelText);
          actions.appendChild(select);
        }

        if(canRunQuickAction(alert)){
          const quick=document.createElement('button');
          quick.type='button';
          quick.className='rounded-full bg-[var(--koa-forest)] px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-white';
          quick.textContent=alert.quickAction.label||'Run action';
          quick.addEventListener('click',()=>void runQuickAction(alert,quick,status));
          actions.appendChild(quick);
        }

        const open=document.createElement('button');open.type='button';open.className='rounded-full border border-[var(--koa-line)] bg-white px-4 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]';open.textContent='Open';open.addEventListener('click',()=>void openAlert(alert));actions.appendChild(open);
        if(alert.isNew){const seen=document.createElement('button');seen.type='button';seen.className='rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.58rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]';seen.textContent='Mark seen';seen.addEventListener('click',()=>void action('mark-seen',{occurrenceIds:[alert.occurrenceId]}));actions.appendChild(seen);}
        const snooze=document.createElement('button');snooze.type='button';snooze.className='rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.58rem] font-black uppercase tracking-[.07em] text-[var(--koa-forest)]';snooze.textContent='Tomorrow';snooze.addEventListener('click',()=>void action('snooze',{occurrenceId:alert.occurrenceId,preset:'tomorrow'}));actions.appendChild(snooze);
        const dismiss=document.createElement('button');dismiss.type='button';dismiss.className='rounded-full border border-[var(--koa-line)] bg-white px-3 py-2 text-[.58rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]';dismiss.textContent='Dismiss';dismiss.addEventListener('click',()=>void action('dismiss',{occurrenceId:alert.occurrenceId}));actions.appendChild(dismiss);
        card.append(status,actions);list.appendChild(card);
      }
      updateBulkBar();
      if(!rows.length){
        const copy=scope==='mine'
          ? 'Nothing currently assigned specifically to you matches this view. Switch to Everyone to see shared and unassigned items.'
          : 'Nothing in this view currently needs attention.';
        list.innerHTML='<div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">'+escapeHtml(copy)+'</div>';
      }
    }

    async function load(){
      refresh.disabled=true;
      try{
        const response=await fetch('/api/admin/workspace-alerts',{cache:'no-store'});
        if(response.status===401||response.status===403){app?.classList.add('hidden');unauthorized?.classList.remove('hidden');return;}
        if(!response.ok)throw new Error('Unable to load Action Center.');
        payload=await response.json();
        render();
      }finally{refresh.disabled=false;}
    }

    document.querySelectorAll('[data-filter]').forEach((button)=>button.addEventListener('click',()=>{
      filter=button.dataset.filter||'all';
      render();
      void savePreferences();
    }));
    document.querySelectorAll('[data-scope]').forEach((button)=>button.addEventListener('click',()=>{
      staffFilter='';
      staffFilterName='';
      selectedAlerts.clear();
      scope=button.dataset.scope||'everyone';
      render();
      void savePreferences();
    }));
    sortSelect?.addEventListener('change',()=>{
      sort=sortSelect.value||'priority';
      render();
      void savePreferences();
    });
    document.querySelector('[data-select-visible]')?.addEventListener('click',()=>{
      rowsForView().filter(canRunQuickAction).forEach((row)=>selectedAlerts.add(row.occurrenceId));
      render();
    });
    document.querySelector('[data-clear-selection]')?.addEventListener('click',()=>{selectedAlerts.clear();render();});
    document.querySelectorAll('[data-run-selected-type]').forEach((button)=>button.addEventListener('click',()=>{
      if(button instanceof HTMLButtonElement)void runSelectedType(String(button.dataset.runSelectedType||''),button);
    }));
    staffFilterClear?.addEventListener('click',()=>{
      staffFilter='';
      staffFilterName='';
      selectedAlerts.clear();
      render();
    });
    refresh?.addEventListener('click',()=>void load());

    session=await getAdminSession();
    const ok=Boolean(session&&!session.accessBlocked);
    capabilities=new Set(session?.capabilities||session?.permissions||[]);
    app?.classList.toggle('hidden',!ok);
    unauthorized?.classList.toggle('hidden',ok);
    if(ok){
      await loadPreferences();
      await load();
    }
  </script>
</BaseLayout>
