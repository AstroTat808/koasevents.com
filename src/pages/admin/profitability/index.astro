---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { businessRules } from '../../../data/businessRules';

const costFields = [
  ['laborSetup','Labor / setup'],['flowers','Flowers'],['cake','Cake'],['mobileBar','Mobile Bar'],
  ['cleaning','Cleaning'],['cottage','Cottage'],['rentalsInventory','Rentals / inventory'],
  ['coordination','Coordination'],['photoBooth','Photo booth'],['lightingAv','Lighting / AV'],
  ['parkingStaffing','Parking / staffing'],['otherDirect','Other direct cost'],
] as const;

const packageMeta = businessRules.venueWeddingPackages.map((p) => ({
  id: p.name === 'Plumeria' ? 'signature-wedding' : p.name.toLowerCase(),
  name: p.publicName,
  price: p.price,
}));
---
<BaseLayout noindex title="Wedding Profitability | Koa’s Events" description="Wedding package, add-on, CRM and realized profitability controls for Koa’s Events." canonical="https://koasevents.com/admin/profitability/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-8">
    <div class="container-shell max-w-[96rem]">
      <section data-loading class="rounded-[1.6rem] bg-white p-7 shadow-[var(--shadow-soft)]">
        <p class="eyebrow text-[var(--koa-clay)]">Koa’s Events</p>
        <h1 class="display mt-3 text-5xl">Wedding profitability</h1>
        <p class="mt-3 text-sm text-[var(--koa-ink)]/55">Loading CRM-linked wedding economics…</p>
      </section>

      <section data-unauthorized class="hidden rounded-[1.6rem] bg-white p-7 shadow-[var(--shadow-soft)]">
        <h1 class="display text-4xl text-[var(--koa-forest)]">Profitability access required</h1>
        <p class="mt-3 text-sm text-[var(--koa-ink)]/60">This workspace requires the Sales Profit Settings permission.</p>
      </section>

      <div data-app class="hidden grid gap-6">
        <header class="rounded-[1.8rem] bg-[var(--koa-forest)] p-7 text-white shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-amber-light)]">Sales CRM + finance</p>
              <h1 class="display mt-3 text-5xl">Wedding profitability</h1>
              <p class="mt-3 max-w-4xl text-sm leading-6 text-white/68">Booked weddings flow in from Sales CRM automatically. CRM controls the package, guest count, add-ons and booked revenue; this workspace adds actual event costs, realized margin, approved add-on pricing and package performance.</p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href="/admin/quotes/" class="rounded-full border border-white/25 px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Sales CRM</a>
              <a href="/catalog/" class="rounded-full border border-white/25 px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Public catalog</a>
              <button data-reset type="button" class="rounded-full border border-white/25 px-4 py-3 text-[.6rem] font-black uppercase tracking-[.1em] text-white">Reset planning assumptions</button>
            </div>
          </div>
          <p data-updated class="mt-4 text-xs text-white/48"></p>
        </header>

        <section data-summary class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"></section>

        <section class="rounded-[1.6rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Package performance</p>
              <h2 class="display mt-2 text-4xl text-[var(--koa-forest)]">Measure demand, conversion and realized economics by collection.</h2>
              <p class="mt-2 max-w-4xl text-sm leading-6 text-[var(--koa-ink)]/58">Inquiry and proposal counts come from Sales CRM. Booked value comes from booked proposals. Gross margin and realized profit only use weddings where actual direct costs have been entered.</p>
            </div>
            <p data-crm-sync class="text-xs font-semibold text-[var(--koa-ink)]/50"></p>
          </div>
          <div data-leaders class="mt-5 grid gap-3 md:grid-cols-2"></div>
          <div class="mt-6 overflow-x-auto">
            <table class="min-w-[1150px] w-full border-separate border-spacing-y-2 text-sm">
              <thead><tr class="text-left text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">
                <th class="px-3">Package</th><th class="px-3">Inquiries</th><th class="px-3">Proposals</th><th class="px-3">Bookings</th>
                <th class="px-3">Inquiry → booking</th><th class="px-3">Proposal → booking</th><th class="px-3">Avg contract</th>
                <th class="px-3">Booked revenue</th><th class="px-3">Cost-complete events</th><th class="px-3">Realized profit</th><th class="px-3">Gross margin</th>
              </tr></thead>
              <tbody data-performance></tbody>
            </table>
          </div>
        </section>

        <section class="rounded-[1.6rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Package economics</p>
              <h2 class="display mt-2 text-4xl text-[var(--koa-forest)]">Plan margin before you sell it.</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--koa-ink)]/58">Replace the starting assumptions with actual Koa’s direct costs. Use loaded labor cost rather than wage-only cost. Gross margin = (price − direct cost) ÷ price.</p>
            </div>
            <button data-save-packages type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save package costs</button>
          </div>
          <p data-package-message class="mt-3 text-xs text-[var(--koa-ink)]/50"></p>
          <div data-packages class="mt-6 grid gap-5"></div>
        </section>

        <section class="rounded-[1.6rem] bg-white p-6 shadow-[var(--shadow-soft)]">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="eyebrow text-[var(--koa-clay)]">Profitable add-ons</p>
              <h2 class="display mt-2 text-4xl text-[var(--koa-forest)]">Approve once. Publish pricing everywhere.</h2>
              <p class="mt-2 max-w-4xl text-sm leading-6 text-[var(--koa-ink)]/58">Enter direct cost and target margin, then approve the recommended price. Approval publishes that price to the public catalog/quote builder and reprices matching draft proposals. Sent, viewed, accepted and booked proposals are never silently repriced.</p>
            </div>
            <button data-save-addons type="button" class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save working assumptions</button>
          </div>
          <p data-addon-message class="mt-3 text-xs text-[var(--koa-ink)]/50"></p>
          <div class="mt-6 overflow-x-auto">
            <table class="min-w-[1320px] w-full border-separate border-spacing-y-2 text-sm">
              <thead><tr class="text-left text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">
                <th class="px-3">Add-on</th><th class="px-3">Direct cost</th><th class="px-3">Target margin</th><th class="px-3">Recommended</th>
                <th class="px-3">Working price</th><th class="px-3">Actual margin</th><th class="px-3">Published status</th><th class="px-3">Action</th><th class="px-3">Unit / note</th>
              </tr></thead>
              <tbody data-addons></tbody>
            </table>
          </div>
        </section>

        <section class="grid gap-6 xl:grid-cols-[.95fr_1.05fr]">
          <section class="rounded-[1.6rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <p class="eyebrow text-[var(--koa-clay)]">Actual event economics</p>
            <h2 class="display mt-2 text-4xl text-[var(--koa-forest)]">Add actual costs to CRM-booked weddings.</h2>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58">When a wedding is booked in Sales CRM it appears here automatically. CRM-synced booking facts are locked here; enter the real costs after the event to complete realized profit and margin.</p>
            <form data-event-form class="mt-5 grid gap-4">
              <input name="id" type="hidden" />
              <input name="crmRecordId" type="hidden" />
              <div data-crm-event-note class="hidden rounded-xl bg-emerald-50 p-4 text-xs font-semibold leading-5 text-emerald-800">CRM-linked booking. Name, date, package, guest count, add-ons and revenue stay synchronized from Sales CRM.</div>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-semibold">Event / couple name<input name="eventName" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3 disabled:bg-[var(--koa-sand)] disabled:text-[var(--koa-ink)]/55" /></label>
                <label class="grid gap-2 text-sm font-semibold">Event date<input name="eventDate" type="date" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 disabled:bg-[var(--koa-sand)] disabled:text-[var(--koa-ink)]/55" /></label>
                <label class="grid gap-2 text-sm font-semibold">Package<select name="packageId" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3 disabled:bg-[var(--koa-sand)] disabled:text-[var(--koa-ink)]/55">
                  <option value="">Choose package</option>
                  {packageMeta.map((p)=><option value={p.id}>{p.name}</option>)}
                </select></label>
                <label class="grid gap-2 text-sm font-semibold">Package base price<input name="packagePrice" type="number" min="0" step="0.01" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 disabled:bg-[var(--koa-sand)] disabled:text-[var(--koa-ink)]/55" /></label>
                <label class="grid gap-2 text-sm font-semibold">Booked revenue<input name="revenue" type="number" min="0" step="0.01" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3 disabled:bg-[var(--koa-sand)] disabled:text-[var(--koa-ink)]/55" /></label>
                <label class="grid gap-2 text-sm font-semibold">Guest count<input name="guestCount" type="number" min="0" step="1" class="rounded-xl border border-[var(--koa-line)] px-4 py-3 disabled:bg-[var(--koa-sand)] disabled:text-[var(--koa-ink)]/55" /></label>
                <label class="grid gap-2 text-sm font-semibold">Booked add-ons<input name="addOnsSummary" readonly class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] px-4 py-3 text-[var(--koa-ink)]/60" /></label>
              </div>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {costFields.map(([key,label])=><label class="grid gap-2 text-xs font-semibold">{label}<input data-event-cost={key} name={key} type="number" min="0" step="0.01" value="0" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5" /></label>)}
              </div>
              <label class="grid gap-2 text-sm font-semibold">Cost notes<textarea name="notes" class="min-h-24 rounded-xl border border-[var(--koa-line)] px-4 py-3" placeholder="Vendor overage, overtime, unusual cleanup, staffing changes…"></textarea></label>
              <div class="rounded-xl bg-[var(--koa-sand)]/55 p-4">
                <div class="grid gap-3 sm:grid-cols-3">
                  <div><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Direct cost</p><strong data-event-total class="display mt-1 block text-2xl text-[var(--koa-forest)]">$0</strong></div>
                  <div><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Gross profit</p><strong data-event-profit class="display mt-1 block text-2xl text-[var(--koa-forest)]">$0</strong></div>
                  <div><p class="text-[.55rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Gross margin</p><strong data-event-margin class="display mt-1 block text-2xl text-[var(--koa-forest)]">0%</strong></div>
                </div>
              </div>
              <div class="flex flex-wrap gap-3">
                <button class="rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save actual costs</button>
                <button data-event-cancel type="button" class="hidden rounded-full border border-[var(--koa-line)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-forest)]">Cancel edit</button>
              </div>
              <p data-event-message class="text-xs text-[var(--koa-ink)]/50"></p>
            </form>
          </section>

          <section class="rounded-[1.6rem] bg-white p-6 shadow-[var(--shadow-soft)]">
            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">Realized results</p>
                <h2 class="display mt-2 text-4xl text-[var(--koa-forest)]">Booked wedding cost queue</h2>
              </div>
              <span data-event-count class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-bold text-[var(--koa-forest)]">0 events</span>
            </div>
            <div data-events class="mt-5 grid gap-3"></div>
          </section>
        </section>

        <section class="rounded-[1.6rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-6">
          <p class="eyebrow text-[var(--koa-clay)]">Management rule</p>
          <h2 class="display mt-2 text-3xl text-[var(--koa-forest)]">Do not treat owned inventory or owner labor as free.</h2>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-[var(--koa-ink)]/60">For owned furniture and décor, include handling, setup, cleaning, storage, breakage and replacement reserve. For labor performed by owners or salaried staff, assign an internal loaded hourly cost. This keeps package and add-on margins comparable.</p>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { getAdminSession } from '../../../lib/admin-session';

    const costFields=[
      ['laborSetup','Labor / setup'],['flowers','Flowers'],['cake','Cake'],['mobileBar','Mobile Bar'],
      ['cleaning','Cleaning'],['cottage','Cottage'],['rentalsInventory','Rentals / inventory'],
      ['coordination','Coordination'],['photoBooth','Photo booth'],['lightingAv','Lighting / AV'],
      ['parkingStaffing','Parking / staffing'],['otherDirect','Other direct cost'],
    ];

    const loading=document.querySelector('[data-loading]');
    const unauthorized=document.querySelector('[data-unauthorized]');
    const app=document.querySelector('[data-app]');
    const packageEl=document.querySelector('[data-packages]');
    const addonEl=document.querySelector('[data-addons]');
    const summaryEl=document.querySelector('[data-summary]');
    const performanceEl=document.querySelector('[data-performance]');
    const leadersEl=document.querySelector('[data-leaders]');
    const crmSyncEl=document.querySelector('[data-crm-sync]');
    const updatedEl=document.querySelector('[data-updated]');
    const packageMessage=document.querySelector('[data-package-message]');
    const addonMessage=document.querySelector('[data-addon-message]');
    const eventForm=document.querySelector('[data-event-form]');
    const eventMessage=document.querySelector('[data-event-message]');
    const eventList=document.querySelector('[data-events]');
    const eventCount=document.querySelector('[data-event-count]');
    const eventCancel=document.querySelector('[data-event-cancel]');
    const crmEventNote=document.querySelector('[data-crm-event-note]');
    let state={packages:[],addOns:[],events:[],performance:[],leaders:{},crmSync:{},updatedAt:'',updatedBy:''};

    const money=(value)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(Number(value||0));
    const pct=(value)=>value==null?'—':new Intl.NumberFormat('en-US',{style:'percent',maximumFractionDigits:1}).format(Number(value||0));
    const esc=(value)=>String(value??'').replace(/[&<>"']/g,(ch)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    const clampNum=(value,min=0,max=10000000)=>{const n=Number(value);return Number.isFinite(n)?Math.min(max,Math.max(min,n)):min;};
    const sumCosts=(costs)=>costFields.reduce((sum,[key])=>sum+clampNum(costs?.[key]),0);
    const gp=(price,cost)=>clampNum(price)-clampNum(cost);
    const gm=(price,cost)=>clampNum(price)>0?gp(price,cost)/clampNum(price):0;
    const recommended=(cost,target,increment)=>{const c=clampNum(cost),m=Math.min(.9,Math.max(.05,Number(target)||0)),step=Math.max(1,Number(increment)||1);return c>0?Math.ceil((c/(1-m))/step)*step:0;};
    const date=(value)=>value?new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric'}).format(new Date(value+'T12:00:00')):'Date not set';
    const dt=(value)=>value?new Intl.DateTimeFormat('en-US',{dateStyle:'medium',timeStyle:'short'}).format(new Date(value)):'';
    const addOnSummary=(rows)=>Array.isArray(rows)&&rows.length?rows.map(r=>(Number(r.quantity||1)>1?Number(r.quantity)+'× ':'')+String(r.description||'Add-on')).join(' · '):'None recorded';

    async function api(body){
      const res=await fetch('/api/admin/profitability',body?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}:{cache:'no-store'});
      const data=await res.json().catch(()=>({}));
      if(!res.ok)throw new Error(data.error||'Profitability request failed.');
      return data;
    }

    function card(label,value,detail=''){
      const el=document.createElement('article');
      el.className='rounded-[1.3rem] bg-white p-5 shadow-[var(--shadow-soft)]';
      el.innerHTML='<p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">'+esc(label)+'</p><strong class="display mt-2 block text-3xl text-[var(--koa-forest)]">'+esc(value)+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/48">'+esc(detail)+'</p>';
      return el;
    }

    function renderSummary(){
      summaryEl.innerHTML='';
      const totals=state.packages.reduce((a,p)=>{const cost=sumCosts(p.costs);a.price+=Number(p.price||0);a.profit+=gp(p.price,cost);return a;},{price:0,profit:0});
      const completed=state.events.filter(e=>sumCosts(e.costs)>0);
      const actual=completed.reduce((a,e)=>{a.revenue+=Number(e.revenue||0);a.cost+=sumCosts(e.costs);return a;},{revenue:0,cost:0});
      summaryEl.append(
        card('CRM booked weddings',String(state.crmSync?.bookedWeddingCount||0),'Automatically synchronized into the actual-cost queue'),
        card('Modeled package margin',pct(totals.price?totals.profit/totals.price:0),money(totals.profit)+' modeled gross profit across the ladder'),
        card('Cost-complete weddings',String(completed.length),completed.length?money(actual.revenue-actual.cost)+' realized gross profit':'Enter actual costs after each event'),
        card('Realized weighted margin',actual.revenue?pct((actual.revenue-actual.cost)/actual.revenue):'—',actual.revenue?money(actual.revenue)+' cost-complete revenue':'No cost-complete weddings yet')
      );
    }

    function renderPerformance(){
      performanceEl.innerHTML='';
      (state.performance||[]).forEach(row=>{
        const tr=document.createElement('tr');
        tr.className='bg-[var(--koa-ivory)]';
        tr.innerHTML=
          '<td class="rounded-l-xl px-3 py-3"><strong class="text-[var(--koa-forest)]">'+esc(row.packageName)+'</strong></td>'+
          '<td class="px-3 py-3">'+Number(row.inquiries||0)+'</td>'+
          '<td class="px-3 py-3">'+Number(row.proposals||0)+'</td>'+
          '<td class="px-3 py-3 font-bold">'+Number(row.bookings||0)+'</td>'+
          '<td class="px-3 py-3">'+pct(row.conversionRate)+'</td>'+
          '<td class="px-3 py-3">'+pct(row.proposalConversionRate)+'</td>'+
          '<td class="px-3 py-3">'+(row.averageContractValue==null?'—':money(row.averageContractValue))+'</td>'+
          '<td class="px-3 py-3">'+money(row.bookedRevenue)+'</td>'+
          '<td class="px-3 py-3">'+Number(row.actualCostEvents||0)+'</td>'+
          '<td class="px-3 py-3 font-bold">'+(Number(row.actualCostEvents||0)?money(row.realizedProfit):'—')+'</td>'+
          '<td class="rounded-r-xl px-3 py-3">'+(Number(row.actualCostEvents||0)?pct(row.grossMargin):'—')+'</td>';
        performanceEl.appendChild(tr);
      });
      crmSyncEl.textContent=(state.crmSync?.bookedWeddingCount||0)+' booked wedding'+((state.crmSync?.bookedWeddingCount||0)===1?'':'s')+' synced from Sales CRM';

      const popular=state.performance?.find(row=>row.packageId===state.leaders?.mostPopular);
      const profitable=state.performance?.find(row=>row.packageId===state.leaders?.mostProfitable);
      const popularDetail=popular
        ? popular.packageName+' · '+popular.bookings+' bookings'
        : 'Building evidence · '+Number(state.leaders?.totalBookings||0)+' / '+Number(state.leaders?.bookingThreshold||5)+' bookings required before naming a leader.';
      const profitDetail=profitable
        ? profitable.packageName+' · '+money(profitable.realizedProfit)+' realized gross profit'
        : 'Building evidence · '+Number(state.leaders?.totalActualCostEvents||0)+' / '+Number(state.leaders?.actualCostThreshold||5)+' cost-complete weddings required before naming a leader.';
      leadersEl.innerHTML=
        '<article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 p-4"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Most popular evidence</p><strong class="mt-2 block text-lg text-[var(--koa-forest)]">'+esc(popular?popular.packageName:'Not enough data yet')+'</strong><p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/55">'+esc(popularDetail)+'</p></article>'+
        '<article class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 p-4"><p class="text-[.56rem] font-black uppercase tracking-[.09em] text-[var(--koa-clay)]">Most profitable evidence</p><strong class="mt-2 block text-lg text-[var(--koa-forest)]">'+esc(profitable?profitable.packageName:'Not enough data yet')+'</strong><p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/55">'+esc(profitDetail)+'</p></article>';
    }

    function costInputs(costs,prefix){
      return costFields.map(([key,label])=>'<label class="grid gap-1 text-[.68rem] font-semibold text-[var(--koa-ink)]/65">'+esc(label)+'<input data-cost-key="'+key+'" name="'+prefix+'-'+key+'" type="number" min="0" step="0.01" value="'+Number(costs?.[key]||0)+'" class="rounded-lg border border-[var(--koa-line)] px-3 py-2 text-sm" /></label>').join('');
    }

    function renderPackages(){
      packageEl.innerHTML='';
      state.packages.forEach(p=>{
        const cost=sumCosts(p.costs),m=gm(p.price,cost),gap=m-Number(p.targetMargin||0);
        const article=document.createElement('article');
        article.dataset.packageId=p.id;
        article.className='rounded-[1.35rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-5';
        article.innerHTML=
          '<div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">'+
            '<div><p class="eyebrow text-[var(--koa-clay)]">'+esc(p.id)+'</p><h3 class="display mt-2 text-3xl text-[var(--koa-forest)]">'+esc(p.name)+'</h3><p class="mt-1 text-xs text-[var(--koa-ink)]/50">'+Number(p.includedGuests||0)+' included guests</p></div>'+
            '<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">'+
              '<div><p class="text-[.52rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Price</p><strong class="text-lg">'+money(p.price)+'</strong></div>'+
              '<div><p class="text-[.52rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Direct cost</p><strong data-package-cost class="text-lg">'+money(cost)+'</strong></div>'+
              '<div><p class="text-[.52rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Gross profit</p><strong data-package-profit class="text-lg">'+money(gp(p.price,cost))+'</strong></div>'+
              '<div><p class="text-[.52rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Margin</p><strong data-package-margin class="text-lg '+(gap>=0?'text-emerald-700':'text-red-700')+'">'+pct(m)+'</strong></div>'+
            '</div>'+
          '</div>'+
          '<div class="mt-5 grid gap-4 xl:grid-cols-[220px_1fr]">'+
            '<div class="grid content-start gap-3">'+
              '<label class="grid gap-1 text-sm font-semibold">Package price<input data-package-price type="number" min="0" step="1" value="'+Number(p.price||0)+'" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5" /></label>'+
              '<label class="grid gap-1 text-sm font-semibold">Target margin<input data-package-target type="number" min="5" max="90" step=".5" value="'+(Number(p.targetMargin||0)*100)+'" class="rounded-xl border border-[var(--koa-line)] px-3 py-2.5" /></label>'+
              '<p data-package-status class="rounded-xl '+(gap>=0?'bg-emerald-50 text-emerald-800':'bg-red-50 text-red-800')+' p-3 text-xs font-semibold">'+(gap>=0?'On target · '+pct(gap)+' above target':'Below target · '+pct(Math.abs(gap))+' gap')+'</p>'+
            '</div>'+
            '<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">'+costInputs(p.costs,p.id)+'</div>'+
          '</div>';
        packageEl.appendChild(article);
      });
      packageEl.querySelectorAll('input').forEach(input=>input.addEventListener('input',updatePackagePreview));
    }

    function collectPackages(){
      return state.packages.map(p=>{
        const root=packageEl.querySelector('[data-package-id="'+p.id+'"]');
        const costs={};
        root.querySelectorAll('[data-cost-key]').forEach(input=>costs[input.dataset.costKey]=clampNum(input.value));
        return {...p,price:clampNum(root.querySelector('[data-package-price]').value),targetMargin:clampNum(root.querySelector('[data-package-target]').value,5,90)/100,costs};
      });
    }

    function updatePackagePreview(){
      state.packages=collectPackages();
      renderSummary();
      state.packages.forEach(p=>{
        const root=packageEl.querySelector('[data-package-id="'+p.id+'"]'); if(!root)return;
        const cost=sumCosts(p.costs),m=gm(p.price,cost),gap=m-p.targetMargin;
        root.querySelector('[data-package-cost]').textContent=money(cost);
        root.querySelector('[data-package-profit]').textContent=money(gp(p.price,cost));
        const marginEl=root.querySelector('[data-package-margin]'); marginEl.textContent=pct(m); marginEl.className='text-lg '+(gap>=0?'text-emerald-700':'text-red-700');
        const status=root.querySelector('[data-package-status]'); status.textContent=gap>=0?'On target · '+pct(gap)+' above target':'Below target · '+pct(Math.abs(gap))+' gap'; status.className='rounded-xl '+(gap>=0?'bg-emerald-50 text-emerald-800':'bg-red-50 text-red-800')+' p-3 text-xs font-semibold';
      });
    }

    function renderAddOns(){
      addonEl.innerHTML='';
      state.addOns.forEach(a=>{
        const rec=recommended(a.directCost,a.targetMargin,a.priceIncrement),actualMargin=gm(a.sellPrice,a.directCost);
        const tr=document.createElement('tr');
        tr.dataset.addonId=a.id; tr.className='bg-[var(--koa-ivory)]';
        const published=a.approved&&Number(a.sellPrice)>0;
        tr.innerHTML=
          '<td class="rounded-l-xl px-3 py-3"><strong class="text-[var(--koa-forest)]">'+esc(a.name)+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/45">'+esc(a.category)+' · '+esc(a.catalogItemId||'')+'</p></td>'+
          '<td class="px-3 py-3"><input data-addon-cost type="number" min="0" step=".01" value="'+Number(a.directCost||0)+'" class="w-28 rounded-lg border border-[var(--koa-line)] px-3 py-2" /></td>'+
          '<td class="px-3 py-3"><input data-addon-target type="number" min="5" max="90" step=".5" value="'+(Number(a.targetMargin||0)*100)+'" class="w-24 rounded-lg border border-[var(--koa-line)] px-3 py-2" /></td>'+
          '<td class="px-3 py-3"><strong data-addon-recommended class="text-[var(--koa-forest)]">'+(Number(a.directCost||0)>0?money(rec):'Enter cost')+'</strong><p class="mt-1 text-[.62rem] text-[var(--koa-ink)]/45">Round '+money(a.priceIncrement||1)+'</p></td>'+
          '<td class="px-3 py-3"><input data-addon-price type="number" min="0" step=".01" value="'+Number(a.sellPrice||0)+'" class="w-28 rounded-lg border border-[var(--koa-line)] px-3 py-2" /></td>'+
          '<td class="px-3 py-3"><strong data-addon-margin class="'+(Number(a.directCost||0)>0&&actualMargin>=a.targetMargin?'text-emerald-700':'text-red-700')+'">'+(Number(a.directCost||0)>0?pct(actualMargin):'Cost needed')+'</strong></td>'+
          '<td class="px-3 py-3">'+(published?'<span class="rounded-full bg-emerald-50 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-emerald-800">Published '+money(a.sellPrice)+'</span><p class="mt-1 text-[.6rem] text-[var(--koa-ink)]/40">'+esc(a.approvedAt?dt(a.approvedAt):'')+'</p>':'<span class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/55">Working only</span>')+'</td>'+
          '<td class="px-3 py-3"><button data-approve-addon="'+esc(a.id)+'" type="button" class="rounded-full bg-[var(--koa-forest)] px-3 py-2 text-[.55rem] font-black uppercase tracking-[.08em] text-white">'+(published?'Republish recommended':'Approve recommended')+'</button>'+(published?'<button data-unpublish-addon="'+esc(a.id)+'" type="button" class="mt-2 block text-[.55rem] font-black uppercase tracking-[.08em] text-red-700">Unpublish</button>':'')+'</td>'+
          '<td class="rounded-r-xl px-3 py-3"><p class="font-semibold">'+esc(a.unit)+'</p><p class="mt-1 max-w-sm text-xs leading-5 text-[var(--koa-ink)]/50">'+esc(a.note)+'</p></td>';
        addonEl.appendChild(tr);
      });
      addonEl.querySelectorAll('input').forEach(input=>input.addEventListener('input',updateAddOnPreview));
      addonEl.querySelectorAll('[data-approve-addon]').forEach(button=>button.addEventListener('click',()=>approveAddOn(button.dataset.approveAddon)));
      addonEl.querySelectorAll('[data-unpublish-addon]').forEach(button=>button.addEventListener('click',()=>unpublishAddOn(button.dataset.unpublishAddon)));
    }

    function collectAddOns(){
      return state.addOns.map(a=>{
        const root=addonEl.querySelector('[data-addon-id="'+a.id+'"]');
        return {...a,directCost:clampNum(root.querySelector('[data-addon-cost]').value),targetMargin:clampNum(root.querySelector('[data-addon-target]').value,5,90)/100,sellPrice:clampNum(root.querySelector('[data-addon-price]').value)};
      });
    }

    function updateAddOnPreview(){
      state.addOns=collectAddOns();
      state.addOns.forEach(a=>{
        const root=addonEl.querySelector('[data-addon-id="'+a.id+'"]'),rec=recommended(a.directCost,a.targetMargin,a.priceIncrement),m=gm(a.sellPrice,a.directCost);
        root.querySelector('[data-addon-recommended]').textContent=a.directCost>0?money(rec):'Enter cost';
        const marginEl=root.querySelector('[data-addon-margin]'); marginEl.textContent=a.directCost>0?pct(m):'Cost needed'; marginEl.className=a.directCost>0&&m>=a.targetMargin?'text-emerald-700':'text-red-700';
      });
    }

    async function approveAddOn(id){
      try{
        state.addOns=collectAddOns();
        addonMessage.textContent='Saving assumptions before approval…';
        state=await api({action:'save-addons',addOns:state.addOns});
        addonMessage.textContent='Publishing recommended price…';
        const data=await api({action:'approve-addon-price',id});
        state=data;
        const changed=data.approved?.updatedDraftProposals||0;
        addonMessage.textContent='Published '+money(data.approved?.price||0)+' to the catalog and quote builder'+(changed?' · '+changed+' draft proposal'+(changed===1?'':'s')+' repriced.':'.');
        renderAll();
      }catch(err){addonMessage.textContent=err.message||'Approval failed.';}
    }

    async function unpublishAddOn(id){
      if(!confirm('Unpublish this approved add-on price? Existing proposals will not be changed.'))return;
      try{state=await api({action:'unpublish-addon-price',id});addonMessage.textContent='Price unpublished from the catalog/quote builder.';renderAll();}catch(err){addonMessage.textContent=err.message||'Unpublish failed.';}
    }

    function eventCostsFromForm(){const costs={};costFields.forEach(([key])=>costs[key]=clampNum(eventForm.elements[key].value));return costs;}
    function updateEventPreview(){
      const revenue=clampNum(eventForm.elements.revenue.value),cost=sumCosts(eventCostsFromForm());
      document.querySelector('[data-event-total]').textContent=money(cost);
      document.querySelector('[data-event-profit]').textContent=money(gp(revenue,cost));
      document.querySelector('[data-event-margin]').textContent=revenue?pct(gm(revenue,cost)):'—';
    }

    function setCrmLock(on){
      ['eventName','eventDate','packageId','packagePrice','revenue','guestCount'].forEach(name=>{eventForm.elements[name].disabled=Boolean(on);});
      crmEventNote.classList.toggle('hidden',!on);
    }

    function resetEventForm(){
      eventForm.reset();eventForm.elements.id.value='';eventForm.elements.crmRecordId.value='';eventForm.elements.packagePrice.value='0';eventForm.elements.guestCount.value='0';eventForm.elements.addOnsSummary.value='';costFields.forEach(([key])=>eventForm.elements[key].value='0');setCrmLock(false);eventCancel.classList.add('hidden');eventMessage.textContent='';updateEventPreview();
    }

    function editEvent(row){
      if(!row)return;
      eventForm.elements.id.value=row.id;
      eventForm.elements.crmRecordId.value=row.crmRecordId||'';
      eventForm.elements.eventName.value=row.eventName||'';
      eventForm.elements.eventDate.value=row.eventDate||'';
      eventForm.elements.packageId.value=row.packageId||'';
      eventForm.elements.packagePrice.value=Number(row.packagePrice||0);
      eventForm.elements.revenue.value=Number(row.revenue||0);
      eventForm.elements.guestCount.value=Number(row.guestCount||0);
      eventForm.elements.addOnsSummary.value=addOnSummary(row.addOns);
      eventForm.elements.notes.value=row.notes||'';
      costFields.forEach(([key])=>eventForm.elements[key].value=Number(row.costs?.[key]||0));
      setCrmLock(Boolean(row.crmSynced));eventCancel.classList.remove('hidden');updateEventPreview();eventForm.scrollIntoView({behavior:'smooth',block:'start'});
    }

    function renderEvents(){
      eventList.innerHTML=''; eventCount.textContent=state.events.length+' '+(state.events.length===1?'event':'events');
      if(!state.events.length){eventList.innerHTML='<p class="rounded-xl bg-[var(--koa-sand)]/45 p-5 text-sm text-[var(--koa-ink)]/55">No booked weddings or manual actual-event records yet.</p>';return;}
      state.events.forEach(e=>{
        const cost=sumCosts(e.costs),complete=cost>0,m=gm(e.revenue,cost),p=state.packages.find(x=>x.id===e.packageId);
        const article=document.createElement('article'); article.className='rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-4';
        article.innerHTML=
          '<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><div class="flex flex-wrap items-center gap-2"><p class="eyebrow text-[var(--koa-clay)]">'+esc(p?.name||e.packageId)+'</p>'+(e.crmSynced?'<span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[.52rem] font-black uppercase tracking-[.08em] text-emerald-800">CRM synced</span>':'<span class="rounded-full bg-[var(--koa-sand)] px-2.5 py-1 text-[.52rem] font-black uppercase tracking-[.08em] text-[var(--koa-ink)]/55">Manual</span>')+'</div><h3 class="mt-1 text-lg font-bold text-[var(--koa-forest)]">'+esc(e.eventName)+'</h3><p class="mt-1 text-xs text-[var(--koa-ink)]/45">'+esc(date(e.eventDate))+' · '+Number(e.guestCount||0)+' guests</p><p class="mt-2 max-w-xl text-xs leading-5 text-[var(--koa-ink)]/50">'+esc(addOnSummary(e.addOns))+'</p></div>'+
          '<div class="text-left sm:text-right"><strong class="display text-2xl '+(complete?'text-[var(--koa-forest)]':'text-[var(--koa-clay)]')+'">'+(complete?pct(m):'Costs needed')+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/50">'+money(e.packagePrice)+' package · '+money(e.revenue)+' booked revenue · '+(complete?money(cost)+' cost · '+money(gp(e.revenue,cost))+' profit':'actual costs not entered')+'</p></div></div>'+
          '<div class="mt-3 flex flex-wrap gap-2"><button data-edit-event="'+esc(e.id)+'" type="button" class="rounded-full border border-[var(--koa-line)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-forest)]">'+(complete?'Edit actual costs':'Enter actual costs')+'</button>'+(!e.crmSynced?'<button data-delete-event="'+esc(e.id)+'" type="button" class="rounded-full border border-red-200 px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-red-700">Delete</button>':'')+'</div>';
        eventList.appendChild(article);
      });
      eventList.querySelectorAll('[data-edit-event]').forEach(b=>b.addEventListener('click',()=>editEvent(state.events.find(e=>e.id===b.dataset.editEvent))));
      eventList.querySelectorAll('[data-delete-event]').forEach(b=>b.addEventListener('click',async()=>{const row=state.events.find(e=>e.id===b.dataset.deleteEvent);if(!row||!confirm('Delete actual-cost record for '+row.eventName+'?'))return;try{state=await api({action:'delete-event',id:row.id});renderAll();}catch(err){eventMessage.textContent=err.message||'Delete failed.';}}));
    }

    function renderAll(){
      renderSummary();renderPerformance();renderPackages();renderAddOns();renderEvents();
      updatedEl.textContent=state.updatedAt?'Planning/pricing settings last saved '+dt(state.updatedAt)+(state.updatedBy?' by '+state.updatedBy:''):'Using starting planning assumptions; save changes to persist them.';
    }

    document.querySelector('[data-save-packages]')?.addEventListener('click',async()=>{try{packageMessage.textContent='Saving…';state.packages=collectPackages();state=await api({action:'save-packages',packages:state.packages});packageMessage.textContent='Package economics saved.';renderAll();}catch(err){packageMessage.textContent=err.message||'Save failed.';}});
    document.querySelector('[data-save-addons]')?.addEventListener('click',async()=>{try{addonMessage.textContent='Saving…';state.addOns=collectAddOns();state=await api({action:'save-addons',addOns:state.addOns});addonMessage.textContent='Working assumptions saved. Edited published rows are automatically unpublished until re-approved.';renderAll();}catch(err){addonMessage.textContent=err.message||'Save failed.';}});
    document.querySelector('[data-reset]')?.addEventListener('click',async()=>{if(!confirm('Reset package and add-on planning assumptions to defaults? Actual-event cost history will be kept.'))return;try{state=await api({action:'reset-planning-assumptions'});renderAll();}catch(err){packageMessage.textContent=err.message||'Reset failed.';}});

    eventForm?.addEventListener('input',updateEventPreview);
    eventForm?.addEventListener('submit',async(event)=>{
      event.preventDefault();
      try{
        eventMessage.textContent='Saving actual costs…';
        const current=state.events.find(e=>e.id===eventForm.elements.id.value);
        const payload={
          id:eventForm.elements.id.value,
          crmRecordId:eventForm.elements.crmRecordId.value,
          crmSynced:Boolean(current?.crmSynced),
          eventName:eventForm.elements.eventName.value,
          eventDate:eventForm.elements.eventDate.value,
          packageId:eventForm.elements.packageId.value,
          packagePrice:clampNum(eventForm.elements.packagePrice.value),
          revenue:clampNum(eventForm.elements.revenue.value),
          guestCount:clampNum(eventForm.elements.guestCount.value,0,500),
          addOns:current?.addOns||[],
          costs:eventCostsFromForm(),
          notes:eventForm.elements.notes.value,
        };
        state=await api({action:'upsert-event',event:payload});resetEventForm();renderAll();eventMessage.textContent='Actual costs saved.';
      }catch(err){eventMessage.textContent=err.message||'Save failed.';}
    });
    eventCancel?.addEventListener('click',resetEventForm);

    (async()=>{
      const session=await getAdminSession();
      loading?.classList.add('hidden');
      if(!session||!session.capabilities?.includes('sales.profit_settings')){unauthorized?.classList.remove('hidden');return;}
      app?.classList.remove('hidden');
      try{state=await api();renderAll();resetEventForm();}catch(err){unauthorized?.classList.remove('hidden');app?.classList.add('hidden');unauthorized.querySelector('p')?.append(' '+(err.message||''));}
    })();
  </script>
</BaseLayout>
