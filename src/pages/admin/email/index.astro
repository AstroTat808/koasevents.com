    function comparisonHtml(metric,unit=''){
      const state=String(metric?.state||'no_prior_data');
      if(state==='no_prior_data')return '<p class="mt-1 text-[.6rem] font-semibold text-[var(--koa-ink)]/40">No prior-period data</p>';
      const delta=Number(metric?.delta||0);
      const previous=Number(metric?.previous||0);
      const arrow=delta>0?'↑':delta<0?'↓':'→';
      const tone=state==='improved'?'text-emerald-700':state==='worsened'?'text-red-700':'text-[var(--koa-ink)]/45';
      const label=state==='improved'?'improved':state==='worsened'?'worsened':'unchanged';
      const magnitude=Math.abs(delta);
      const deltaText=unit==='pts'?magnitude.toFixed(1)+' pts':String(Number.isInteger(magnitude)?magnitude:magnitude.toFixed(1));
      const previousText=unit==='pts'?previous.toFixed(1)+'%':String(previous);
      return '<p class="mt-1 text-[.6rem] font-black '+tone+'">'+arrow+' '+deltaText+' · '+label+'</p><p class="text-[.56rem] text-[var(--koa-ink)]/38">Previous: '+esc(previousText)+'</p>';
    }
