    async function fetchAllRetainedActivity(onProgress){
      const all:any[]=[];
      const seen=new Set<string>();
      const seenCursors=new Set<string>();
      let after='';
      let hasMore=true;
      let pages=0;
      while(hasMore){
        const response=await fetch('/api/admin/email-activity?limit=100'+(after?'&after='+encodeURIComponent(after):''),{cache:'no-store'});
        const result=await response.json().catch(()=>({}));
        if(!response.ok)throw new Error(result.error||'Unable to load retained history.');
        const rows=Array.isArray(result.rows)?result.rows:[];
        for(const row of rows){
          const id=String(row?.emailId||'');
          if(id&&!seen.has(id)){seen.add(id);all.push(row);}
        }
        hasMore=Boolean(result.hasMore);
        const next=String(result.nextAfter||'');
        pages+=1;
        if(typeof onProgress==='function')onProgress(all.length,pages);
        if(!rows.length||!next||seenCursors.has(next)){hasMore=false;break;}
        seenCursors.add(next);
        after=next;
        if(pages>=1000)throw new Error('Retained email history exceeded the 100,000-message export safety limit.');
      }
      return {rows:all,complete:!hasMore,pages};
    }
