    function downloadActivityCsv(rows,scope){
      const headers=['When','Recipient','Subject','Email Type','Route','Status','From','Resend Message ID'];
      const body=rows.map((row)=>[
        row.createdAt?new Date(row.createdAt).toISOString():'',
        row.recipient||'',
        row.subject||'',
        row.emailType||'',
        row.route||'',
        row.status||'',
        row.from||'',
        row.resendMessageId||row.emailId||'',
      ].map(csvCell).join(','));
      const csv='\uFEFF'+[headers.map(csvCell).join(','),...body].join('\r\n');
      const blob=new Blob([csv],{type:'text/csv;charset=utf-8'});
      const href=URL.createObjectURL(blob);
      const link=document.createElement('a');
      link.href=href;
      link.download='koa-email-activity-'+scope+'-'+localDateInputValue(new Date())+'.csv';
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(()=>URL.revokeObjectURL(href),1000);
    }
