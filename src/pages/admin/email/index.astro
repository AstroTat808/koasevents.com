    function activityDateBoundary(value,endOfDay=false){
      const raw=String(value||'').trim();
      if(!raw)return null;
      const date=new Date(raw+(endOfDay?'T23:59:59.999':'T00:00:00'));
      const time=date.getTime();
      return Number.isFinite(time)?time:null;
    }
    function filteredActivityRows(rows){
      const recipient=activityRecipientFilter instanceof HTMLInputElement?activityRecipientFilter.value.trim().toLowerCase():'';
      const emailType=activityTypeFilter instanceof HTMLSelectElement?activityTypeFilter.value:'';
      const statusFilter=activityStatusFilter instanceof HTMLSelectElement?activityStatusFilter.value:'';
      const start=activityStartFilter instanceof HTMLInputElement?activityDateBoundary(activityStartFilter.value):null;
      const end=activityEndFilter instanceof HTMLInputElement?activityDateBoundary(activityEndFilter.value,true):null;
      const messageId=activityIdFilter instanceof HTMLInputElement?activityIdFilter.value.trim().toLowerCase():'';
      return rows.filter((row)=>{
        if(recipient&&!String(row?.recipient||'').toLowerCase().includes(recipient))return false;
        if(emailType&&String(row?.emailType||'Other')!==emailType)return false;
        if(statusFilter==='sent'&&!Boolean(row?.sent))return false;
        if(statusFilter==='failed'&&Boolean(row?.sent))return false;
        if(messageId&&!String(row?.resendMessageId||row?.emailId||'').toLowerCase().includes(messageId))return false;
        if(activityPreset==='client'&&!['client-confirmation','client-follow-up','review-request'].includes(String(row?.route||'')))return false;
        if(activityPreset==='vendor'&&!['vendor-event-brief','vendor-insurance-reminder'].includes(String(row?.route||'')))return false;
        if(activityPreset==='internal'&&!['lead-notification','lead-response-reminder','security-alert','email-preview'].includes(String(row?.route||'')))return false;
        const createdAt=Date.parse(String(row?.createdAt||''));
        if(start!=null&&(!Number.isFinite(createdAt)||createdAt<start))return false;
        if(end!=null&&(!Number.isFinite(createdAt)||createdAt>end))return false;
        return true;
      });
    }
