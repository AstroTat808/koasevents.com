    :global(html[data-theme="dark"]) .release-kpi-good { color:#91e6b9 }
    :global(html[data-theme="dark"]) .release-status-pill[data-state=passed] { color:#91e6b9 }
    :global(html[data-theme="dark"]) .release-status-pill[data-state=failed],
    :global(html[data-theme="dark"]) .release-status-pill[data-state=blocked] { color:#ffb0b2 }
    :global(html[data-theme="dark"]) .release-status-pill[data-state=pending] { color:#f1c584 }
    :global(html[data-theme="dark"]) .release-evidence-error {color:#ffa9a9}
    :global(html[data-theme="dark"]) .release-hero-action {color:#153528}
    @media(max-width:900px){.release-pr-quad,.release-evidence-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:600px){.release-check-list,.release-pr-quad,.release-evidence-grid{grid-template-columns:1fr}.release-hero{border-radius:1.25rem}.release-pr-card{padding:1rem}.release-pr-header{gap:.7rem}}
    @media(prefers-reduced-motion:reduce){.release-hero-link,.release-hero-action,.release-pr-card{transition:none}}
