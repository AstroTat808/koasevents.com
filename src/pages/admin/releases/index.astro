    .release-tile-foot{display:block;color:color-mix(in srgb,var(--koa-text) 55%,transparent);font-size:.71rem;margin-top:.72rem;line-height:1.5}
    .release-status-pill{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:999px;padding:.46rem .85rem;background:var(--koa-surface-2);border:1px solid var(--koa-line);color:var(--koa-text);font-size:.6rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
    .release-status-pill[data-state=passed]{background:color-mix(in srgb,#239169 12%,var(--koa-surface));border-color:rgba(35,145,105,.35);color:#1c8659}
    .release-status-pill[data-state=failed],.release-status-pill[data-state=blocked]{background:color-mix(in srgb,#bf4b51 10%,var(--koa-surface));border-color:rgba(191,75,81,.4);color:#b43742}
    .release-status-pill[data-state=pending]{background:color-mix(in srgb,#daa65c 12%,var(--koa-surface));border-color:rgba(196,140,65,.34);color:#986f2f}
    .release-pages-label{font-size:.72rem;font-weight:800;color:var(--koa-accent-text)}
    .release-page-button{border:1px solid var(--koa-line);border-radius:999px;padding:.7rem 1rem;font-size:.67rem;font-weight:900;color:var(--koa-text-strong);background:var(--koa-surface)}
    .release-page-button:disabled{opacity:.35;cursor:not-allowed}
    .release-pr-card{background:var(--koa-surface);border:1px solid var(--koa-line);border-radius:1.25rem;padding:1.25rem;min-width:0;transition:border-color .2s,transform .2s}
    .release-pr-card:hover{border-color:color-mix(in srgb,var(--koa-clay) 44%,var(--koa-line))}
    .release-pr-header{display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-start;justify-content:space-between}
    .release-pr-eyebrow{display:flex;flex-wrap:wrap;gap:.55rem;color:var(--koa-accent-text);font-size:.65rem;letter-spacing:.09em;font-weight:900;text-transform:uppercase}
    .release-pr-title{font-weight:700;font-size:clamp(1rem,2vw,1.25rem);color:var(--koa-text-strong);letter-spacing:-.025em;line-height:1.3;margin-top:.5rem}
    .release-pr-title-link:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
    .release-pr-subtitle{margin-top:.55rem;font:600 .68rem/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;color:color-mix(in srgb,var(--koa-text) 53%,transparent);overflow-wrap:anywhere}
    .release-pr-quad,.release-evidence-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-top:1rem}
    .release-data-point{min-width:0;border-radius:.78rem;border:1px solid var(--koa-line);background:var(--koa-surface-2);padding:1rem}
    .release-data-point-value{display:block;font-size:.9rem;font-weight:850;color:var(--koa-text-strong);margin-top:.55rem;line-height:1.5;overflow-wrap:anywhere}
    .release-data-point-caption{display:block;font-size:.67rem;color:color-mix(in srgb,var(--koa-text) 58%,transparent);margin-top:.35rem;line-height:1.5;overflow-wrap:anywhere}
    .release-pr-footer{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem;margin-top:1rem}
