    .release-external-disabled{color:var(--koa-text);opacity:.4;font-size:.68rem}
    .release-pr-details{width:100%;margin-top:.55rem;border-top:1px solid var(--koa-line);padding-top:.8rem}
    .release-pr-details-summary{font-size:.68rem;font-weight:900;text-transform:uppercase;letter-spacing:.09em;color:var(--koa-accent-text);cursor:pointer}
    .release-evidence-body{padding-top:1rem}
