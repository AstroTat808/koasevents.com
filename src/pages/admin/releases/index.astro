    .release-check-item{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;min-width:0;padding:.65rem;border:1px solid var(--koa-line);border-radius:.75rem}
    .release-check-title{font-size:.72rem;font-weight:700;color:var(--koa-text-strong)}
