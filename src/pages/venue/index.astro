---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { businessRules } from '../../data/businessRules';
import { media } from '../../data/media';

const packages = businessRules.venueWeddingPackages;
const schema = {
  '@context':'https://schema.org','@type':'EventVenue',name:"Koa's Events",url:'https://www.koasevents.com/venue/',
  telephone:businessRules.contact.phone,email:businessRules.contact.email,maximumAttendeeCapacity:businessRules.venue.maximumOccupancy.value,
  address:{'@type':'PostalAddress',streetAddress:'11-3334 Hibiscus St',addressLocality:'Mountain View',addressRegion:'HI',postalCode:'96771',addressCountry:'US'}
};
---
<BaseLayout title="Koa’s Events Venue | Weddings & Private Events on Hawaiʻi Island" description="Explore Koa’s Events in Mountain View, Hawaiʻi: a private tropical event venue for weddings, celebrations, retreats and corporate gatherings for up to 100 guests." canonical="https://www.koasevents.com/venue/">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="relative min-h-[88svh] overflow-hidden bg-[var(--koa-ink)] text-white">
  <ResponsiveImage {...media.venueWide} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority />
  <div class="hero-shade absolute inset-0"></div><Header/>
  <div class="container-shell relative z-10 flex min-h-[88svh] items-end pb-16 pt-40 lg:pb-24"><div class="max-w-4xl"><p class="eyebrow text-white/65">The venue · Mountain View, Hawaiʻi</p><h1 class="display mt-5 text-6xl leading-[.9] sm:text-7xl lg:text-[6.8rem]">A private island setting with room to make it yours.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/78 sm:text-lg">Four tropical acres, an open-air pavilion and space for celebrations of up to {businessRules.venue.maximumOccupancy.value} guests.</p><div class="mt-9 flex flex-wrap gap-3"><a href="/inquire/?service=venue" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Check your date</a><a href="/gallery/" class="rounded-full border border-white/45 px-6 py-3.5 text-xs font-black uppercase tracking-[.12em]">See real Koa’s photos</a></div></div></div>
</section>

<section class="py-24 lg:py-36"><div class="container-shell grid gap-14 lg:grid-cols-[.72fr_1.28fr] lg:gap-24">
  <div><p class="eyebrow text-[var(--koa-clay)]">The estate</p><h2 class="display mt-5 text-5xl leading-[.98] sm:text-6xl">Not a ballroom. Not a resort corridor. A place with its own rhythm.</h2><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/67">Koa’s gives hosts a more private, nature-forward way to gather in Mountain View. The property can support intimate celebrations and larger events up to the approved venue maximum, while package inventory and rentals scale separately.</p></div>
  <div class="relative min-h-[42rem]"><div class="absolute right-0 top-0 h-[34rem] w-[78%] overflow-hidden rounded-[2rem]"><ResponsiveImage {...media.venueAtmosphere} width={1200} height={1400} sizes="(min-width:1024px) 48vw, 90vw" class="h-full w-full object-cover" /></div><div class="absolute bottom-0 left-0 grid w-[58%] gap-5 rounded-[1.4rem] bg-[var(--koa-sand)] p-7 shadow-xl"><div><p class="eyebrow text-[var(--koa-clay)]">Capacity</p><p class="display mt-1 text-4xl">{businessRules.venue.maximumOccupancy.value} guests</p></div><div><p class="eyebrow text-[var(--koa-clay)]">Pavilion</p><p class="display mt-1 text-4xl">{businessRules.venue.pavilionSqFt.value.toLocaleString()} sq. ft.</p></div></div></div>
</div></section>

<section class="bg-[var(--koa-forest)] py-24 text-white lg:py-32"><div class="container-shell">
  <div class="grid gap-10 lg:grid-cols-[.78fr_1.22fr] lg:items-end"><div><p class="eyebrow text-[var(--koa-amber-light)]">Move through the property</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A venue should support the whole event, not just the ceremony.</h2></div><p class="max-w-xl text-sm leading-7 text-white/62 lg:justify-self-end">Arrival, getting ready, ceremony, reception, bar service, weather planning and the end of the night all shape how the property feels.</p></div>
  <div class="mt-14 grid gap-4 lg:grid-cols-3">
    {[
      ['Arrival + gathering','A private Mountain View setting that gives guests a clear sense of arrival and hosts room to shape the flow.',media.weddingPortrait],
      ['Open-air celebration','The pavilion provides a covered center for dining, dancing, entertainment and weather-aware planning.',media.receptionTable],
      ['After dark','Lighting, music and hospitality shift the property into a warmer evening atmosphere without losing the island setting.',media.eveningReception]
    ].map(([title,copy,image],i)=><article class="overflow-hidden rounded-[1.5rem] border border-white/12 bg-white/[.045]"><div class="relative h-72"><ResponsiveImage {...image} width={900} height={650} sizes="(min-width:1024px) 33vw, 100vw" class="h-full w-full object-cover" /></div><div class="p-7"><p class="eyebrow text-[var(--koa-amber-light)]">0{i+1}</p><h3 class="display mt-3 text-3xl">{title}</h3><p class="mt-3 text-sm leading-6 text-white/64">{copy}</p></div></article>)}
  </div>
</div></section>

<section class="koa-grain bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell">
  <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-end"><div><p class="eyebrow text-[var(--koa-clay)]">Wedding collections</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Different starting points, one venue maximum.</h2></div><p class="max-w-xl text-sm leading-7 text-[var(--koa-ink)]/62 lg:justify-self-end">Included furniture and services vary by package; the venue itself is approved for up to {businessRules.venue.maximumOccupancy.value} persons.</p></div>
  <div class="mt-14 grid gap-4 md:grid-cols-2 xl:grid-cols-4">{packages.map((item,index)=><a href="/venue/packages/" class="card-lift rounded-[1.4rem] border border-[var(--koa-line)] bg-[var(--koa-ivory)] p-6"><span class="eyebrow text-[var(--koa-clay)]">0{index+1}</span><p class="mt-8 text-[.62rem] font-bold uppercase tracking-[.14em] text-[var(--koa-forest)]">{item.position}</p><h3 class="display mt-2 text-4xl">{item.name}</h3><p class="mt-2 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">From {'$'+item.price.toLocaleString()}</p><p class="mt-5 text-sm leading-6 text-[var(--koa-ink)]/62">{item.access}</p><span class="link-arrow mt-7">See package →</span></a>)}</div>
</div></section>

<section class="py-24 lg:py-32"><div class="container-shell grid gap-14 lg:grid-cols-[1.1fr_.9fr] lg:items-center lg:gap-20"><div class="relative min-h-[36rem] overflow-hidden rounded-[2rem]"><ResponsiveImage {...media.rusticTableDetail} width={1200} height={1100} sizes="(min-width:1024px) 55vw, 100vw" class="absolute inset-0 h-full w-full object-cover" /></div><div><p class="eyebrow text-[var(--koa-clay)]">Plan with clarity</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Know the important rules before you fall in love with the date.</h2><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">Insurance, vendor requirements, alcohol rules, setup timing and music cutoff are all part of the planning conversation. We surface them early because clarity makes better events.</p><div class="mt-8 flex flex-wrap gap-5"><a href="/venue/faq/" class="link-arrow">Venue FAQ →</a><a href="/inquire/?service=venue" class="link-arrow">Check availability →</a></div></div></div></section>
</main><Footer/></BaseLayout>