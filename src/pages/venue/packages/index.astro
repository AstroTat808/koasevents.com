---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import PackageCapacityComparison from '../../../components/PackageCapacityComparison.astro';
import { businessRules } from '../../../data/businessRules';
import { koaMarketingMedia } from '../../../data/media';

const packages = businessRules.venueWeddingPackages;
const hero = koaMarketingMedia.ceremonyLiveSunset;
---
<BaseLayout title="Big Island Wedding Venue Packages | Koa’s Events" description="Compare Koa’s Big Island wedding venue packages, starting prices, access and included inventory for celebrations in Mountain View, East Hawaiʻi." canonical="https://koasevents.com/venue/packages/">
<main>
<section class="relative min-h-[68svh] overflow-hidden bg-[var(--koa-ink)] text-white"><ResponsiveImage {...hero} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover opacity-90" priority /><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[68svh] items-end pb-16 pt-40"><div class="max-w-4xl"><p class="eyebrow text-white/60">Big Island wedding packages · Mountain View</p><h1 class="display mt-5 text-6xl leading-[.94] sm:text-7xl">Wedding venue packages with clear starting prices and room to personalize.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/80">The venue maximum is {businessRules.venue.maximumOccupancy.value} persons. Each package includes a different base level of access, furniture and services; added rentals can expand a configuration up to that venue maximum.</p></div></div></section>

<section class="bg-[var(--koa-sand)] py-16 lg:py-20">
  <div class="container-shell grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-center lg:gap-20">
    <div><p class="eyebrow text-[var(--koa-clay)]">What couples are comparing</p><h2 class="display mt-4 text-4xl leading-[1] sm:text-5xl">Compare the starting point, then build the wedding around your priorities.</h2></div>
    <div><p class="text-sm leading-7 text-[var(--koa-ink)]/64">Couples searching for Big Island wedding packages often need three answers first: the starting price, how much access time is included, and what furniture or services come with the package. The four collections below make those differences visible before you request a proposal.</p><div class="mt-6 flex flex-wrap gap-5"><a href="/weddings/" class="link-arrow text-[var(--koa-forest)]">Explore the wedding venue →</a><a href="/east-hawaii-wedding-venue/" class="link-arrow text-[var(--koa-forest)]">East Hawaiʻi venue guide →</a></div></div>
  </div>
</section>

<section class="py-20 lg:py-28"><div class="container-shell"><div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">{packages.map((p,i)=><a href={'#'+p.name.toLowerCase()} class="card-lift rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-6"><span class="eyebrow text-[var(--koa-clay)]">0{i+1}</span><p class="mt-7 text-xs font-bold uppercase tracking-[.14em] text-[var(--koa-forest)]">{p.position}</p><h2 class="display mt-2 text-4xl">{p.publicName}</h2><p class="mt-2 text-sm font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">From {'$'+p.price.toLocaleString()}</p><p class="mt-5 text-sm leading-6 text-[var(--koa-ink)]/62">{p.access}</p><PackageCapacityComparison furnitureCoverage={p.includedFurnitureCoverage} compact /></a>)}</div></div></section>

{packages.map((p,index)=>(
<section id={p.name.toLowerCase()} class:list={['py-24 lg:py-32', index % 2 === 0 ? 'bg-[var(--koa-sand)]' : 'bg-[var(--koa-ivory)]']}>
<div class="container-shell grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">0{index+1} · {p.position}</p><h2 class="display mt-5 text-6xl leading-[.95]">{p.publicName}</h2><p class="mt-3 text-sm font-black uppercase tracking-[.13em] text-[var(--koa-forest)]">Starting at {'$'+p.price.toLocaleString()}</p><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">{p.baseConfiguration}</p><PackageCapacityComparison furnitureCoverage={p.includedFurnitureCoverage} /><div class="mt-7 rounded-2xl border border-[var(--koa-line)] bg-white/60 p-5"><p class="eyebrow text-[var(--koa-clay)]">Access</p><p class="mt-2 text-sm leading-6">{p.access}</p><p class="eyebrow mt-5 text-[var(--koa-clay)]">Included furniture / inventory</p><p class="mt-2 text-sm leading-6">{p.includedInventory}</p></div></div><div><p class="eyebrow text-[var(--koa-clay)]">What’s included</p><ul class="mt-6 grid gap-3 sm:grid-cols-2">{p.includes.map(item=><li class="rounded-2xl border border-[var(--koa-line)] bg-white p-4 text-sm leading-6">{item}</li>)}</ul><div class="mt-8 grid gap-4 lg:grid-cols-2"><div class="rounded-2xl border border-[var(--koa-line)] bg-white/70 p-5"><p class="eyebrow text-[var(--koa-clay)]">Package limits</p><ul class="mt-4 grid gap-3">{p.limits.map(item=><li class="flex gap-3 text-sm leading-6 text-[var(--koa-ink)]/68"><span class="text-[var(--koa-clay)]">—</span><span>{item}</span></li>)}</ul></div><div class="rounded-2xl border border-[var(--koa-line)] bg-white/70 p-5"><p class="eyebrow text-[var(--koa-clay)]">Available upgrades</p><ul class="mt-4 grid gap-3">{p.addOnRules.map(item=><li class="flex gap-3 text-sm leading-6 text-[var(--koa-ink)]/68"><span class="text-[var(--koa-clay)]">—</span><span>{item}</span></li>)}</ul></div></div><p class="mt-6 text-sm leading-6 text-[var(--koa-ink)]/60">Final availability, quantities, vendor-provided items, service hours and upgrades are confirmed in the event proposal/agreement.</p><a href={'/inquire/?service=venue&package='+p.name.toLowerCase()} class="mt-8 inline-flex rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Ask about {p.publicName}</a></div></div>
</section>
))}

<section class="bg-[var(--koa-ink)] py-20 text-white"><div class="container-shell grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end"><div><p class="eyebrow text-white/45">Not seeing your exact combination?</p><h2 class="display mt-4 max-w-3xl text-5xl leading-[1] sm:text-6xl">Build a custom event around the pieces you actually need.</h2></div><a href="/inquire/?service=venue" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Request a custom quote</a></div></section>
</main><Footer/></BaseLayout>
