---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { businessRules } from '../../../data/businessRules';

const packages = businessRules.venueWeddingPackages;
const hero='/media/editorial/garden-wedding-moment.jpg';
---
<BaseLayout title="Wedding Packages | Koa’s Events" description="Compare Gardenia, Orchid, Hibiscus and Plumeria wedding packages at Koa’s Events in Mountain View, Hawaiʻi. Venue maximum: 100 guests." canonical="https://www.koasevents.com/venue/packages/">
<main>
<section class="relative min-h-[68svh] overflow-hidden bg-[var(--koa-ink)] text-white"><img src={hero} alt="Romantic outdoor wedding moment in a lush garden" class="absolute inset-0 h-full w-full object-cover opacity-90" fetchpriority="high"/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[68svh] items-end pb-16 pt-40"><div class="max-w-4xl"><p class="eyebrow text-white/60">Wedding packages</p><h1 class="display mt-5 text-6xl leading-[.94] sm:text-7xl">Four ways to start. Plenty of room to personalize.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/80">The venue maximum is {businessRules.venue.maximumOccupancy.value} persons. Each package includes a different base level of access, furniture and services; added rentals can expand a configuration up to that venue maximum.</p></div></div></section>

<section class="py-20 lg:py-28"><div class="container-shell"><div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">{packages.map((p,i)=><a href={'#'+p.name.toLowerCase()} class="card-lift rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-6"><span class="eyebrow text-[var(--koa-clay)]">0{i+1}</span><p class="mt-7 text-xs font-bold uppercase tracking-[.14em] text-[var(--koa-forest)]">{p.position}</p><h2 class="display mt-2 text-4xl">{p.name}</h2><p class="mt-2 text-sm font-black uppercase tracking-[.12em] text-[var(--koa-clay)]">From {'$'+p.price.toLocaleString()}</p><p class="mt-5 text-sm leading-6 text-[var(--koa-ink)]/62">{p.access}</p></a>)}</div></div></section>

{packages.map((p,index)=>(
<section id={p.name.toLowerCase()} class:list={['py-24 lg:py-32', index % 2 === 0 ? 'bg-[var(--koa-sand)]' : 'bg-[var(--koa-ivory)]']}>
<div class="container-shell grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">0{index+1} · {p.position}</p><h2 class="display mt-5 text-6xl leading-[.95]">{p.name}</h2><p class="mt-3 text-sm font-black uppercase tracking-[.13em] text-[var(--koa-forest)]">Starting at {'$'+p.price.toLocaleString()}</p><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">{p.baseConfiguration}</p><div class="mt-7 rounded-2xl border border-[var(--koa-line)] bg-white/60 p-5"><p class="eyebrow text-[var(--koa-clay)]">Access</p><p class="mt-2 text-sm leading-6">{p.access}</p><p class="eyebrow mt-5 text-[var(--koa-clay)]">Included furniture / inventory</p><p class="mt-2 text-sm leading-6">{p.includedInventory}</p></div></div><div><p class="eyebrow text-[var(--koa-clay)]">Included in the current published package</p><ul class="mt-6 grid gap-3 sm:grid-cols-2">{p.includes.map(item=><li class="rounded-2xl border border-[var(--koa-line)] bg-white p-4 text-sm leading-6">{item}</li>)}</ul><p class="mt-6 text-sm leading-6 text-[var(--koa-ink)]/60">Package inclusions are the current published scope. Final availability, quantities, vendor-provided items and upgrades are confirmed in the event proposal/agreement.</p><a href={'/inquire/?service=venue&package='+p.name.toLowerCase()} class="mt-8 inline-flex rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Ask about {p.name}</a></div></div>
</section>
))}

<section class="bg-[var(--koa-ink)] py-20 text-white"><div class="container-shell grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end"><div><p class="eyebrow text-white/45">Not seeing your exact combination?</p><h2 class="display mt-4 max-w-3xl text-5xl leading-[1] sm:text-6xl">Build a custom event around the pieces you actually need.</h2></div><a href="/inquire/?service=venue" class="rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Request a custom quote</a></div></section>
</main><Footer/></BaseLayout>
