---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { media, koaMarketingMedia } from '../../data/media';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

const stayDetails = [
  { image: koaMarketingMedia.bridalSuiteWeddingReady, label: 'Bridal suite' },
  { image: koaMarketingMedia.bridalLoungeWeddingReady, label: 'Getting-ready lounge' },
  { image: koaMarketingMedia.cottageKitchenetteStyled, label: 'Kitchenette' },
  { image: koaMarketingMedia.cottageLoftSuite, label: 'Loft retreat' },
  { image: koaMarketingMedia.cottagePorchDining, label: 'Covered porch' },
  { image: koaMarketingMedia.guestBathroomStyled, label: 'Guest bath' },
];
---
<BaseLayout title="Mountain View Hawaiʻi Cottage Stay | Koa’s Events" description="Request a direct stay at Koa’s in Mountain View, Hawaiʻi, including wedding-weekend and independent stay inquiries." canonical="https://www.koasevents.com/stay/">
<main>
<section class="relative min-h-[80svh] overflow-hidden bg-[var(--koa-ink)] text-white md:min-h-[82svh]"><ResponsiveImage {...koaMarketingMedia.cottageExteriorEvents} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[80svh] items-end pb-14 pt-32 md:min-h-[82svh] md:pt-40 lg:pb-24"><div class="max-w-4xl"><p class="eyebrow text-white/65">Stay at Koa’s · Mountain View</p><h1 class="display mt-5 text-6xl leading-[.9] sm:text-7xl lg:text-[6.5rem]">Stay close. Stay awhile.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/78 sm:text-lg">Koa’s accepts direct stay requests for the cottage/property experience in Mountain View. Wedding-weekend stays can also be coordinated with select wedding collections.</p><a href="#stay-request" class="mt-9 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Request stay dates</a></div></div></section>
<section class="py-24 lg:py-36"><div class="container-shell grid gap-14 lg:grid-cols-[.82fr_1.18fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">Book direct with Koa’s</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A direct booking relationship from the start.</h2><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">Stay requests begin directly with Koa’s rather than a third-party marketplace. We confirm dates, availability and stay details personally so the booking relationship starts with the people hosting you.</p><div class="mt-8 flex flex-wrap gap-5"><a href="#stay-request" class="link-arrow">Request dates →</a><a href="/weddings/" class="link-arrow">Wedding weekends →</a></div></div><div class="relative h-[24rem] overflow-hidden rounded-[1.6rem] sm:h-[30rem] lg:h-[38rem] lg:rounded-[2rem]"><ResponsiveImage {...koaMarketingMedia.bridalSuiteWeddingReady} width={1200} height={1200} sizes="(min-width:1024px) 50vw,100vw" class="absolute inset-0 h-full w-full object-cover"/></div></div></section>
<section class="bg-[var(--koa-sand)] py-24 lg:py-32">
  <div class="container-shell">
    <div class="grid gap-10 lg:grid-cols-[.76fr_1.24fr] lg:items-end">
      <div>
        <p class="eyebrow text-[var(--koa-clay)]">Inside the cottage</p>
        <h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">A comfortable home base for the wedding weekend.</h2>
        <p class="mt-6 max-w-xl text-sm leading-7 text-[var(--koa-ink)]/62">The cottage gives couples and guests a quieter place to get ready, reset and stay close to the property. Styling shown here is illustrative and may vary by stay or event.</p>
      </div>
      <div class="relative h-[22rem] overflow-hidden rounded-[1.6rem] sm:h-[28rem] lg:h-[32rem] lg:rounded-[2rem]">
        <ResponsiveImage {...koaMarketingMedia.cottageExteriorEvents} width={1200} height={900} sizes="(min-width:1024px) 54vw,100vw" class="absolute inset-0 h-full w-full object-cover"/>
      </div>
    </div>
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {stayDetails.map((item)=><figure class="group overflow-hidden rounded-[1.35rem] bg-[var(--koa-ivory)]">
        <div class="relative h-64 overflow-hidden sm:h-72"><ResponsiveImage {...item.image} width={900} height={900} sizes="(min-width:1024px) 33vw,50vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]"/></div>
        <figcaption class="px-5 py-4 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">{item.label}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
<section class="bg-[var(--koa-sand)] py-20 lg:py-24"><div class="container-shell grid gap-4 lg:grid-cols-3">{[['Wedding weekends','Coordinate a stay with the wedding experience when the selected collection includes cottage access.'],['Direct stays','Request independent stay dates directly through Koa’s rather than beginning on a marketplace.'],['Mountain View base','Use Koa’s as a quiet Mountain View home base while exploring the Hilo/Volcano side of Hawaiʻi Island.']].map(([t,c],i)=><article class="rounded-[1.4rem] bg-[var(--koa-ivory)] p-7"><p class="eyebrow text-[var(--koa-clay)]">0{i+1}</p><h2 class="display mt-8 text-4xl">{t}</h2><p class="mt-4 text-sm leading-6 text-[var(--koa-ink)]/64">{c}</p></article>)}</div></section>
<section id="stay-request" class="py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">Direct stay request</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Tell us when you’d like to stay.</h2><p class="mt-6 text-sm leading-7 text-[var(--koa-ink)]/62">Rates, occupancy limits, minimum stays and final lodging policies will be confirmed in the direct booking response until the live booking engine is launched.</p></div>
<form name="koa-stay-inquiry" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="min-w-0 overflow-hidden rounded-[1.5rem] border border-[var(--koa-line)] bg-white p-4 shadow-[var(--shadow-soft)] sm:p-7" data-stay-form><input type="hidden" name="form-name" value="koa-stay-inquiry"/>
          <input type="hidden" name="subject" data-remove-prefix value="New Stay at Koa’s Inquiry" /><p class="hidden"><label>Don’t fill this out: <input name="bot-field"/></label></p><div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-2 text-sm font-semibold">Name<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="name" required/></label><label class="grid gap-2 text-sm font-semibold">Email<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="email" name="email" required/></label><label class="grid gap-2 text-sm font-semibold">Arrival<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="date" name="arrival" required/></label><label class="grid gap-2 text-sm font-semibold">Departure<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="date" name="departure" required/></label><label class="grid gap-2 text-sm font-semibold">Number of guests<input class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" type="number" min="1" name="guests" required/></label><label class="grid gap-2 text-sm font-semibold">Stay type<select class="rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="stayType"><option>Independent stay</option><option>Wedding weekend</option><option>Event-related stay</option></select></label><label class="grid gap-2 text-sm font-semibold sm:col-span-2">Anything we should know?<textarea class="min-h-28 rounded-xl border border-[var(--koa-line)] bg-[var(--koa-ivory)] px-4 py-3" name="notes"></textarea></label>
          {turnstileSiteKey && (
            <div class="sm:col-span-2 rounded-2xl border border-[var(--koa-line)] bg-[var(--koa-sand)]/45 p-4">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="stay_inquiry" data-theme="light" data-size="flexible"></div>
            </div>
          )}
          <p class="hidden sm:col-span-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" role="alert" data-submit-error></p>
          <button class="sm:col-span-2 rounded-full bg-[var(--koa-forest)] px-6 py-4 text-xs font-black uppercase tracking-[.13em] text-white disabled:cursor-not-allowed disabled:opacity-60" type="submit">Request stay availability</button></div></form></div></section>
</main><Footer/>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline define:vars={{ turnstileSiteKey }}>
  const stayForm = document.querySelector('[data-stay-form]');
  stayForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (stayForm.dataset.submitting === '1') return;

    const submitButton = stayForm.querySelector('button[type="submit"]');
    const errorBox = stayForm.querySelector('[data-submit-error]');
    const data = new FormData(stayForm);
    const turnstileToken = String(data.get('cf-turnstile-response') || '');

    if (turnstileSiteKey && !turnstileToken) {
      if (errorBox) {
        errorBox.textContent = 'Complete the security check before requesting stay availability.';
        errorBox.classList.remove('hidden');
      }
      return;
    }

    stayForm.dataset.submitting = '1';
    if (submitButton) submitButton.disabled = true;
    if (errorBox) errorBox.classList.add('hidden');

    try {
      const response = await fetch('/api/crm/inquiries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Koa-Inquiry-Capture': '1' },
        body: JSON.stringify({
          formName: 'koa-stay-inquiry',
          honeypot: data.get('bot-field'),
          turnstileToken,
          customer: {
            name: data.get('name'),
            email: data.get('email'),
            phone: '',
            eventDate: data.get('arrival'),
            notes: data.get('notes'),
          },
          inquiry: {
            service: 'stay',
            eventType: 'Stay',
            guestCount: data.get('guests'),
            priorities: data.get('notes'),
            arrival: data.get('arrival'),
            departure: data.get('departure'),
            stayType: data.get('stayType'),
          },
        }),
        keepalive: true,
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload?.ok !== true) {
        throw new Error(payload?.error || 'We could not save your stay request. Please try again.');
      }

      if (turnstileSiteKey && !payload?.turnstileProof) {
        throw new Error('Security verification could not be completed. Please try again.');
      }
      if (payload?.turnstileProof) {
        let proofInput = stayForm.querySelector('[name="koa-turnstile-proof"]');
        if (!proofInput) {
          proofInput = document.createElement('input');
          proofInput.type = 'hidden';
          proofInput.name = 'koa-turnstile-proof';
          stayForm.appendChild(proofInput);
        }
        proofInput.value = payload.turnstileProof;
      }
      stayForm.querySelector('[name="cf-turnstile-response"]')?.remove();

      if (payload?.notificationConfigured || payload?.deduplicated) {
        window.location.assign('/thank-you/');
        return;
      }

      stayForm.submit();
    } catch (error) {
      stayForm.dataset.submitting = '0';
      if (submitButton) submitButton.disabled = false;
      if (errorBox) {
        errorBox.textContent = error instanceof Error ? error.message : 'We could not save your stay request. Please try again.';
        errorBox.classList.remove('hidden');
      }
      if (window.turnstile?.reset) window.turnstile.reset();
    }
  });
</script>
</BaseLayout>