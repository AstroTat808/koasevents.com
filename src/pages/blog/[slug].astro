---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { wixBlogPosts } from '../../data/wixBlogPosts';
import { koaMarketingGallery } from '../../data/media';

export function getStaticPaths() {
  return wixBlogPosts
    .filter((post) => post.status === 'published')
    .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const allPosts = wixBlogPosts.filter((item) => item.status === 'published');
const related = allPosts
  .filter((item) => item.slug !== post.slug)
  .map((item) => ({
    ...item,
    score:
      (item.category === post.category ? 4 : 0) +
      item.tags.filter((tag) => post.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.score - a.score || b.publishedAt.localeCompare(a.publishedAt))
  .slice(0, 3);

const canonical = `https://www.koasevents.com/blog/${post.slug}/`;
const publishedLabel = new Date(post.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedLabel = new Date(post.updatedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryLinks = {
  'Hawaiʻi Weddings': '/weddings/',
  'Mobile Bar': '/mobile-bar/',
  'Wedding Planning': '/wedding-inquiry/',
  'Bachelorette Parties': '/private-events/',
  'Budget Weddings': '/venue/packages/',
};
const primaryCtaHref = categoryLinks[post.category] || '/inquire/';
const primaryCtaLabel =
  post.category === 'Mobile Bar' ? 'Explore Koa’s Mobile Bar' :
  post.category === 'Bachelorette Parties' ? 'Plan a private celebration' :
  post.category === 'Budget Weddings' ? 'Explore venue packages' :
  post.category === 'Hawaiʻi Weddings' ? 'Explore weddings at Koa’s' :
  'Start planning your event';

const galleryCategoryMap: Record<string, string[]> = {
  'Hawaiʻi Weddings': ['Ceremony', 'Reception', 'Venue'],
  'Mobile Bar': ['Mobile Bar', 'Reception', 'Enhancements'],
  'Wedding Planning': ['Ceremony', 'Reception', 'Venue'],
  'Bachelorette Parties': ['Hospitality', 'Stay', 'Enhancements', 'Mobile Bar'],
  'Budget Weddings': ['Reception', 'Ceremony', 'Venue'],
};

const usedArticleImages = new Set([
  post.featuredImage,
  ...(post.images || []).map((image) => image.src),
]);

const relatedGalleryCategories = galleryCategoryMap[post.category] || ['Venue', 'Ceremony', 'Reception'];
const relatedGalleryBuckets = relatedGalleryCategories.map((category) =>
  koaMarketingGallery.filter((image) => image.category === category && !usedArticleImages.has(image.src))
);
const relatedGallery = [];
for (let row = 0; relatedGallery.length < 6; row += 1) {
  let added = false;
  for (const bucket of relatedGalleryBuckets) {
    const image = bucket[row];
    if (!image || relatedGallery.some((candidate) => candidate.src === image.src)) continue;
    relatedGallery.push(image);
    added = true;
    if (relatedGallery.length === 6) break;
  }
  if (!added) break;
}

const lightboxSeed = [
  { src: post.featuredImage, alt: post.title },
  ...(post.images || [])
    .filter((image) => image.src !== post.featuredImage)
    .map((image) => ({ src: image.src, alt: image.alt })),
  ...relatedGallery.map((image) => ({ src: image.src, alt: image.alt })),
].filter((image, index, list) => list.findIndex((candidate) => candidate.src === image.src) === index);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.metaDescription,
  image: new URL(post.featuredImage, 'https://www.koasevents.com').href,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  author: {
    '@type': 'Person',
    name: post.author,
  },
  publisher: {
    '@type': 'Organization',
    name: "Koa's Events",
    url: 'https://www.koasevents.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.koasevents.com/brand/koa-mark.png',
    },
  },
  mainEntityOfPage: canonical,
  articleSection: post.category,
  keywords: post.tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.koasevents.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.koasevents.com/blog/' },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
  ],
};
---
<BaseLayout
  title={post.seoTitle}
  description={post.metaDescription}
  canonical={canonical}
  socialImage={post.featuredImage}
  socialImageAlt={post.title}
  ogType="article"
>
  <Header overlay={false} />
  <main>
    <article>
      <header class="koa-grain bg-[var(--koa-sand)] py-16 lg:py-24">
        <div class="container-shell max-w-5xl">
          <nav aria-label="Breadcrumb" class="mb-8 text-xs font-bold uppercase tracking-[.13em] text-[var(--koa-ink)]/50">
            <a href="/" class="hover:text-[var(--koa-forest)]">Home</a>
            <span aria-hidden="true"> / </span>
            <a href="/blog/" class="hover:text-[var(--koa-forest)]">Journal</a>
            <span aria-hidden="true"> / </span>
            <span>{post.category}</span>
          </nav>
          <p class="eyebrow text-[var(--koa-clay)]">{post.category}</p>
          <h1 class="display mt-5 max-w-5xl text-5xl leading-[.98] sm:text-6xl lg:text-7xl">{post.title}</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-[var(--koa-ink)]/68">{post.metaDescription}</p>
          <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--koa-ink)]/55">
            <span>By {post.author}</span>
            <span>Published {publishedLabel}</span>
            {post.updatedAt !== post.publishedAt && <span>Updated {updatedLabel}</span>}
          </div>
        </div>
      </header>

      <div class="container-shell py-10 lg:py-16">
        <button
          type="button"
          data-blog-lightbox-src={post.featuredImage}
          data-blog-lightbox-alt={post.title}
          class="group mx-auto block w-full max-w-5xl cursor-zoom-in overflow-hidden rounded-[2rem] bg-[var(--koa-sand)] text-left"
          aria-label="Open featured image"
        >
          <img
            src={post.featuredImage}
            alt={post.title}
            width="1600"
            height="900"
            fetchpriority="high"
            decoding="async"
            class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.01]"
          />
        </button>
      </div>

      <div class="container-shell pb-20 lg:pb-28">
        <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_17rem]">
          <div>
            {post.bodyHtml ? (
              <div class="blog-prose" set:html={post.bodyHtml} />
            ) : (
              <div class="blog-prose">
                {post.body.split(/\n\s*\n/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
              </div>
            )}

            <section class="mt-14 rounded-[1.7rem] bg-[var(--koa-forest)] p-8 text-white lg:p-10" aria-labelledby="blog-cta">
              <p class="eyebrow text-white/65">Plan with Koa’s</p>
              <h2 id="blog-cta" class="display mt-4 text-4xl">Turn the ideas into a celebration that feels like you.</h2>
              <p class="mt-4 max-w-2xl leading-7 text-white/78">Explore Koa’s Events services, venue options, and planning resources for celebrations on Hawaiʻi Island.</p>
              <div class="mt-7 flex flex-wrap gap-3">
                <a href={primaryCtaHref} class="rounded-full bg-white px-6 py-3 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">{primaryCtaLabel}</a>
                <a href="/inquire/" class="rounded-full border border-white/35 px-6 py-3 text-xs font-black uppercase tracking-[.12em] text-white">Check availability</a>
              </div>
            </section>
          </div>

          <aside class="lg:sticky lg:top-28 lg:self-start">
            <div class="rounded-[1.4rem] border border-[var(--koa-line)] p-6">
              <p class="eyebrow text-[var(--koa-clay)]">Article topics</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {post.tags.map((tag) => <a href={`/blog/?q=${encodeURIComponent(tag)}`} class="rounded-full bg-[var(--koa-sand)] px-3 py-2 text-xs font-semibold">{tag}</a>)}
              </div>
              <div class="mt-7 border-t border-[var(--koa-line)] pt-6">
                <p class="text-sm font-bold">Explore Koa’s</p>
                <div class="mt-3 grid gap-2 text-sm">
                  <a class="link-arrow" href="/weddings/">Weddings →</a>
                  <a class="link-arrow" href="/venue/">Venue →</a>
                  <a class="link-arrow" href="/mobile-bar/">Mobile Bar →</a>
                  <a class="link-arrow" href="/gallery/">Gallery →</a>
                </div>
              </div>
            </div>
          </aside>
        </div>

        {relatedGallery.length > 0 && (
          <section class="mx-auto mt-20 max-w-6xl" aria-labelledby="related-gallery">
            <div class="flex flex-wrap items-end justify-between gap-5">
              <div>
                <p class="eyebrow text-[var(--koa-clay)]">From the Koa’s gallery</p>
                <h2 id="related-gallery" class="display mt-4 text-4xl sm:text-5xl">Related gallery</h2>
                <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--koa-ink)]/58">More real Koa’s spaces, details, and event moments connected to this article.</p>
              </div>
              <a href="/gallery/" class="link-arrow">Explore the full gallery →</a>
            </div>
            <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {relatedGallery.map((image, index) => (
                <button
                  type="button"
                  data-blog-lightbox-src={image.src}
                  data-blog-lightbox-alt={image.alt}
                  class:list={[
                    'group relative overflow-hidden rounded-[1.3rem] bg-[var(--koa-sand)] text-left',
                    index === 0 ? 'sm:col-span-2 lg:col-span-2' : '',
                  ]}
                  aria-label={`Open gallery image: ${image.alt}`}
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      'w-full object-cover transition duration-500 group-hover:scale-[1.02]',
                      index === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]',
                    ]}
                  />
                  <span class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></span>
                  <span class="absolute bottom-4 left-4 max-w-[80%] text-left text-xs font-semibold leading-5 text-white/92">{image.alt}</span>
                  <span class="absolute bottom-4 right-4 grid size-9 place-items-center rounded-full border border-white/30 bg-black/20 text-lg text-white backdrop-blur">+</span>
                </button>
              ))}
            </div>
          </section>
        )}

        {related.length > 0 && (
          <section class="mx-auto mt-20 max-w-6xl" aria-labelledby="related-posts">
            <p class="eyebrow text-[var(--koa-clay)]">Keep reading</p>
            <h2 id="related-posts" class="display mt-4 text-4xl sm:text-5xl">Related planning notes</h2>
            <div class="mt-8 grid gap-5 md:grid-cols-3">
              {related.map((item) => (
                <a href={`/blog/${item.slug}/`} class="group overflow-hidden rounded-[1.4rem] border border-[var(--koa-line)] bg-white">
                  <img src={item.featuredImage} alt="" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.02]" />
                  <div class="p-5">
                    <p class="eyebrow text-[var(--koa-clay)]">{item.category}</p>
                    <h3 class="display mt-3 text-2xl leading-[1.05]">{item.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </article>
  </main>
  <Footer />

  <dialog id="blog-lightbox" class="m-auto h-[92svh] w-[94vw] max-w-7xl overflow-hidden rounded-[1.3rem] border border-white/15 bg-[rgba(6,23,18,.96)] p-0 text-white backdrop:bg-black/80">
    <div class="relative flex h-full items-center justify-center p-4 sm:p-8">
      <button type="button" data-blog-lightbox-close class="absolute right-4 top-4 z-20 grid size-11 place-items-center rounded-full border border-white/25 bg-black/25 text-xl backdrop-blur" aria-label="Close image">×</button>
      <button type="button" data-blog-lightbox-prev class="absolute left-4 z-20 grid size-11 place-items-center rounded-full border border-white/25 bg-black/25 text-xl backdrop-blur" aria-label="Previous image">←</button>
      <figure class="flex max-h-full max-w-full flex-col items-center gap-4">
        <img data-blog-lightbox-image src="" alt="" class="max-h-[78svh] max-w-full rounded-lg object-contain" />
        <figcaption data-blog-lightbox-caption class="max-w-3xl text-center text-sm leading-6 text-white/72"></figcaption>
      </figure>
      <button type="button" data-blog-lightbox-next class="absolute right-4 z-20 grid size-11 place-items-center rounded-full border border-white/25 bg-black/25 text-xl backdrop-blur" aria-label="Next image">→</button>
    </div>
  </dialog>

  <script is:inline define:vars={{ lightboxSeed }}>
    (() => {
      const dialog = document.getElementById('blog-lightbox');
      const image = dialog?.querySelector('[data-blog-lightbox-image]');
      const caption = dialog?.querySelector('[data-blog-lightbox-caption]');
      if (!dialog || !(image instanceof HTMLImageElement)) return;

      const items = Array.isArray(lightboxSeed) ? [...lightboxSeed] : [];
      let current = 0;

      function register(src, alt = '') {
        if (!src) return -1;
        const existing = items.findIndex((item) => item.src === src);
        if (existing >= 0) return existing;
        items.push({ src, alt });
        return items.length - 1;
      }

      function show(index) {
        if (!items.length) return;
        current = (index + items.length) % items.length;
        image.src = items[current].src;
        image.alt = items[current].alt || '';
        if (caption) caption.textContent = items[current].alt || '';
        if (!dialog.open) dialog.showModal();
      }

      document.querySelectorAll('[data-blog-lightbox-src]').forEach((trigger) => {
        const src = trigger.getAttribute('data-blog-lightbox-src') || '';
        const alt = trigger.getAttribute('data-blog-lightbox-alt') || '';
        const index = register(src, alt);
        trigger.addEventListener('click', () => show(index));
      });

      document.querySelectorAll('.blog-prose img').forEach((articleImage) => {
        if (!(articleImage instanceof HTMLImageElement)) return;
        const index = register(articleImage.getAttribute('src') || articleImage.src, articleImage.alt || '');
        articleImage.classList.add('blog-lightbox-image');
        articleImage.setAttribute('role', 'button');
        articleImage.setAttribute('tabindex', '0');
        articleImage.setAttribute('aria-label', articleImage.alt ? 'Open image: ' + articleImage.alt : 'Open article image');
        articleImage.addEventListener('click', () => show(index));
        articleImage.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            show(index);
          }
        });
      });

      dialog.querySelector('[data-blog-lightbox-close]')?.addEventListener('click', () => dialog.close());
      dialog.querySelector('[data-blog-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('[data-blog-lightbox-next]')?.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      document.addEventListener('keydown', (event) => {
        if (!dialog.open) return;
        if (event.key === 'ArrowLeft') show(current - 1);
        if (event.key === 'ArrowRight') show(current + 1);
        if (event.key === 'Escape') dialog.close();
      });
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>

<style>
  .blog-prose {
    color: color-mix(in srgb, var(--koa-ink) 78%, transparent);
    font-size: 1.05rem;
    line-height: 1.85;
  }
  .blog-prose :global(h2) {
    color: var(--koa-ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.05;
    margin: 2.5rem 0 1rem;
  }
  .blog-prose :global(h3) {
    color: var(--koa-ink);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    line-height: 1.1;
    margin: 2rem 0 .8rem;
  }
  .blog-prose :global(p) { margin: 1rem 0; }
  .blog-prose :global(ul),
  .blog-prose :global(ol) { margin: 1rem 0; padding-left: 1.4rem; }
  .blog-prose :global(li) { margin: .35rem 0; }
  .blog-prose :global(a) { color: var(--koa-forest); text-decoration: underline; text-underline-offset: .2em; }
  .blog-prose :global(img) {
    border-radius: 1.2rem;
    display: block;
    height: auto;
    margin: 2rem 0;
    max-height: 46rem;
    object-fit: cover;
    width: 100%;
  }
  .blog-prose :global(img.blog-lightbox-image) {
    cursor: zoom-in;
    transition: transform .35s ease, opacity .35s ease;
  }
  .blog-prose :global(img.blog-lightbox-image:hover) {
    opacity: .96;
    transform: scale(1.005);
  }
  .blog-prose :global(img.blog-lightbox-image:focus-visible) {
    outline: 3px solid var(--koa-clay);
    outline-offset: 4px;
  }
  .blog-prose :global(blockquote) {
    border-left: 3px solid var(--koa-clay);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.4;
    margin: 2rem 0;
    padding-left: 1.25rem;
  }
</style>
