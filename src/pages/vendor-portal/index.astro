---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Vendor Portal | Koa’s Events" description="Manage your Koa’s vendor profile, insurance and availability requests." canonical="https://koasevents.com/vendor-portal/">
<main class="min-h-screen bg-[var(--koa-sand)] py-10"><div class="container-shell max-w-5xl">
<section data-loading class="rounded-[1.6rem] bg-white p-8"><h1 class="display text-5xl">Loading vendor portal…</h1></section>
<section data-error class="hidden rounded-[1.6rem] bg-white p-8"><h1 class="display text-5xl">Vendor portal unavailable</h1><p data-error-copy class="mt-3 text-sm"></p></section>
<div data-app class="hidden grid gap-6">
<header class="rounded-[1.8rem] bg-[var(--koa-forest)] p-8 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Koa’s Vendor Network</p><h1 data-title class="display mt-3 text-5xl"></h1><p class="mt-3 max-w-3xl text-sm text-white/65">Keep your public marketplace information current, submit insurance updates, and respond to availability requests. Koa’s controls partner tier, verification, reviews and internal performance records.</p></header>
<section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Availability requests</p><div data-requests class="mt-4 grid gap-3"></div></section>
<section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Public profile</p><form data-profile class="mt-4 grid gap-4"><div class="grid gap-3 md:grid-cols-2"><label class="label">Legal name<input name="legalName" class="field"></label><label class="label">Contact name<input name="contactName" class="field"></label><label class="label">Email<input name="email" type="email" class="field"></label><label class="label">Phone<input name="phone" class="field"></label><label class="label">Website<input name="website" class="field"></label><label class="label">Instagram<input name="instagram" class="field"></label><label class="label">Starting price<input name="startingPrice" class="field"></label><label class="label">Usual response time<input name="responseTime" class="field"></label></div><label class="label">Headline<input name="headline" class="field"></label><label class="label">Description<textarea name="description" rows="5" class="field"></textarea></label><div class="grid gap-3 md:grid-cols-3"><label class="label">Service areas<input name="serviceAreas" class="field"></label><label class="label">Specialties<input name="specialties" class="field"></label><label class="label">Styles<input name="styles" class="field"></label></div><div class="grid gap-3 md:grid-cols-2"><label class="label">Pricing notes<textarea name="priceNotes" rows="3" class="field"></textarea></label><label class="label">Travel fees<textarea name="travelFees" rows="3" class="field"></textarea></label></div><button class="w-fit rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Save profile</button><p data-profile-msg class="text-xs"></p></form></section>
<section class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)]"><p class="eyebrow text-[var(--koa-clay)]">Insurance</p><form data-insurance class="mt-4 grid gap-4 md:grid-cols-2"><label class="label">Carrier<input name="carrier" class="field"></label><label class="label">Policy number<input name="policyNumber" class="field"></label><label class="label">Expiration<input name="expiresAt" type="date" class="field"></label><label class="label">Certificate URL<input name="certificateUrl" class="field" placeholder="Secure file/link URL"></label><label class="flex items-center gap-2 text-sm font-semibold md:col-span-2"><input name="additionalInsured" type="checkbox"> Koa’s is listed as additional insured</label><button class="w-fit rounded-full bg-[var(--koa-clay)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Submit insurance update</button><p data-insurance-msg class="text-xs"></p></form></section>
</div></div></main>
<style>.field{min-height:2.8rem;width:100%;border:1px solid var(--koa-line);border-radius:.7rem;background:white;padding:.7rem .8rem;font-size:.82rem}.label{display:grid;gap:.4rem;font-size:.75rem;font-weight:700}</style>
<script>
const token=new URLSearchParams(location.search).get('token')||'';let data=null;const profile=document.querySelector('[data-profile]'),insurance=document.querySelector('[data-insurance]');
function split(v){return String(v||'').split(',').map(x=>x.trim()).filter(Boolean)}
async function api(body){const r=await fetch('/api/vendor-portal/'+encodeURIComponent(token),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Unable to save.');return d}
function fill(){const v=data.vendor;document.querySelector('[data-title]').textContent=v.name;for(const n of ['legalName','contactName','email','phone','website','instagram','startingPrice','responseTime','headline','description','priceNotes','travelFees'])if(profile.elements[n])profile.elements[n].value=v[n]||'';profile.elements.serviceAreas.value=(v.serviceAreas||[]).join(', ');profile.elements.specialties.value=(v.specialties||[]).join(', ');profile.elements.styles.value=(v.styles||[]).join(', ');insurance.elements.carrier.value=v.insurance?.carrier||'';insurance.elements.policyNumber.value=v.insurance?.policyNumber||'';insurance.elements.expiresAt.value=v.insurance?.expiresAt||'';insurance.elements.certificateUrl.value=v.insurance?.certificateUrl||'';insurance.elements.additionalInsured.checked=Boolean(v.insurance?.additionalInsured);renderRequests()}
function renderRequests(){const box=document.querySelector('[data-requests]');box.innerHTML='';const rows=data.requests.filter(r=>r.type==='availability');rows.forEach(r=>{const card=document.createElement('article');card.className='rounded-xl border border-[var(--koa-line)] p-4';card.innerHTML='<strong>'+r.clientName+'</strong><p class="mt-1 text-xs text-[var(--koa-ink)]/50">'+(r.eventDate||'Event date TBD')+' · '+String(r.status).replaceAll('_',' ')+'</p><p class="mt-2 text-sm">'+(r.message||'No additional note.')+'</p>';if(r.status==='requested'){const controls=document.createElement('div');controls.className='mt-3 flex flex-wrap gap-2';for(const [status,label] of [['available','Available'],['possibly_available','Possibly available'],['unavailable','Unavailable']]){const b=document.createElement('button');b.type='button';b.className='rounded-full border border-[var(--koa-line)] px-3 py-2 text-xs';b.textContent=label;b.onclick=async()=>{await api({action:'respond-availability',requestId:r.id,status});await load()};controls.appendChild(b)}card.appendChild(controls)}box.appendChild(card)});if(!rows.length)box.textContent='No availability requests yet.'}
profile.onsubmit=async e=>{e.preventDefault();const f=profile.elements,m=document.querySelector('[data-profile-msg]');m.textContent='Saving…';try{await api({action:'save-profile',legalName:f.legalName.value,contactName:f.contactName.value,email:f.email.value,phone:f.phone.value,website:f.website.value,instagram:f.instagram.value,startingPrice:f.startingPrice.value,responseTime:f.responseTime.value,headline:f.headline.value,description:f.description.value,serviceAreas:split(f.serviceAreas.value),specialties:split(f.specialties.value),styles:split(f.styles.value),priceNotes:f.priceNotes.value,travelFees:f.travelFees.value});m.textContent='Saved.'}catch(err){m.textContent=err.message}}
insurance.onsubmit=async e=>{e.preventDefault();const f=insurance.elements,m=document.querySelector('[data-insurance-msg]');m.textContent='Submitting…';try{await api({action:'save-insurance',carrier:f.carrier.value,policyNumber:f.policyNumber.value,expiresAt:f.expiresAt.value,certificateUrl:f.certificateUrl.value,additionalInsured:f.additionalInsured.checked});m.textContent='Submitted to Koa’s for review.'}catch(err){m.textContent=err.message}}
async function load(){if(!token){document.querySelector('[data-loading]').classList.add('hidden');document.querySelector('[data-error]').classList.remove('hidden');document.querySelector('[data-error-copy]').textContent='This link is missing its secure vendor token.';return}const r=await fetch('/api/vendor-portal/'+encodeURIComponent(token),{cache:'no-store'});const d=await r.json().catch(()=>({}));document.querySelector('[data-loading]').classList.add('hidden');if(!r.ok){document.querySelector('[data-error]').classList.remove('hidden');document.querySelector('[data-error-copy]').textContent=d.error||'Unable to load vendor portal.';return}data=d;document.querySelector('[data-app]').classList.remove('hidden');fill()}load();
</script>
</BaseLayout>