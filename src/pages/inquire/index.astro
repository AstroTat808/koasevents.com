---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const requestedService = Astro.url.searchParams.get('service');
const requestedPackage = Astro.url.searchParams.get('package');

const serviceLabel =
  requestedService === 'venue'
    ? 'Venue'
    : requestedService === 'mobile-bar'
      ? 'Mobile Bar'
      : requestedService === 'both'
        ? 'Venue + Mobile Bar'
        : 'Your event';
---
<BaseLayout
  title="Check Availability | Koa’s Events"
  description="Start planning your Koa’s Events venue rental, mobile bar service, or combined event experience on Hawaiʻi Island."
  canonical="https://www.koasevents.com/inquire/"
>
  <Header overlay={false} />
  <main>
    <section class="py-20 lg:py-28">
      <div class="container-shell grid gap-14 lg:grid-cols-[.9fr_1.1fr] lg:gap-24">
        <div>
          <p class="eyebrow text-[var(--koa-clay)]">Check availability</p>
          <h1 class="display mt-5 text-6xl leading-[.95] sm:text-7xl">Tell us what you’re gathering for.</h1>
          <p class="mt-7 max-w-xl text-base leading-7 text-[var(--koa-ink)]/68">The redesigned conditional inquiry form is the next conversion build. This route is already in place so every new page has one consistent destination.</p>
        </div>
        <div class="rounded-[1.8rem] bg-[var(--koa-forest)] p-7 text-white sm:p-10">
          <p class="eyebrow text-white/48">Selected path</p>
          <p class="display mt-4 text-4xl">{serviceLabel}</p>
          {requestedPackage && <p class="mt-2 text-sm text-white/62">Package interest: {requestedPackage}</p>}
          <div class="mt-8 border-t border-white/16 pt-7">
            <p class="text-sm leading-6 text-white/66">Until the new form is connected, send the date, event type, guest count and location (for Mobile Bar) and we’ll continue from there.</p>
            <a class="display mt-6 block break-all text-3xl hover:underline" href="mailto:aloha@koasevents.com">aloha@koasevents.com</a>
            <a class="mt-3 block text-lg text-white/80 hover:text-white" href="tel:+18448085627">844-808-KOAS</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
