---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { media, koaMarketingMedia } from '../../data/media';
const occasions=['Birthdays','Baby showers','Graduations','Anniversaries','Family reunions','Retreats','Celebrations of life','Just-because gatherings'];
---
<BaseLayout title="Private Events on Hawaiʻi Island | Koa’s Events" description="Host birthdays, showers, graduations, reunions, retreats and milestone celebrations at Koa’s Events or bring Koa’s Mobile Bar to you." canonical="https://www.koasevents.com/private-events/">
<main>
<section class="relative min-h-[80svh] overflow-hidden bg-[var(--koa-ink)] text-white md:min-h-[84svh]"><ResponsiveImage {...koaMarketingMedia.tropicalDinnerTable} width={1900} height={1250} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" priority/><div class="hero-shade absolute inset-0"></div><Header/><div class="container-shell relative z-10 flex min-h-[80svh] items-end pb-14 pt-32 md:min-h-[84svh] md:pt-40 lg:pb-24"><div class="max-w-4xl"><p class="eyebrow text-white/65">Private celebrations</p><h1 class="display mt-5 text-6xl leading-[.9] sm:text-7xl lg:text-[6.6rem]">Make the occasion feel like an occasion.</h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/78 sm:text-lg">Host at Koa’s, bring the Mobile Bar to your location, or combine the pieces you need for a celebration that feels thoughtful without becoming overproduced.</p><a href="/inquire/?service=venue" class="mt-9 inline-flex rounded-full bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-[var(--koa-ink)]">Plan a private event</a></div></div></section>

<section class="py-24 lg:py-36"><div class="container-shell grid gap-14 lg:grid-cols-[.78fr_1.22fr] lg:items-center lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">Reasons to gather</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">The best private events feel personal, not packaged.</h2><p class="mt-7 text-base leading-7 text-[var(--koa-ink)]/68">We start with the occasion, guest count, timing and feeling you want—then shape the venue or bar service around that instead of handing you a wedding template. The pavilion works as a blank canvas for themes, palettes and styling from your own creative team, Koa’s optional rental catalog, or a mix of both.</p></div><div class="grid gap-3 sm:grid-cols-2">{occasions.map((x,i)=><div class="flex items-center gap-4 rounded-[1.2rem] border border-[var(--koa-line)] bg-white p-5"><span class="display text-2xl text-[var(--koa-clay)]">0{i+1}</span><span class="text-sm font-semibold">{x}</span></div>)}</div></div></section>

<section class="bg-[var(--koa-sand)] py-24 lg:py-32"><div class="container-shell grid gap-4 lg:grid-cols-12">
<div class="relative h-[25rem] overflow-hidden rounded-[1.6rem] sm:h-[30rem] lg:col-span-7 lg:h-[35rem]"><ResponsiveImage {...koaMarketingMedia.pavilionReceptionWide} width={1200} height={1000} sizes="(min-width:1024px) 58vw,100vw" class="absolute inset-0 h-full w-full object-cover"/><div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-7 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Host here</p><h2 class="display mt-3 text-4xl">Use the property as the canvas.</h2><a href="/inquire/?service=venue" class="link-arrow mt-5 text-white">Check venue availability →</a></div></div>
<div class="grid gap-4 lg:col-span-5"><div class="rounded-[1.6rem] bg-[var(--koa-forest)] p-7 text-white"><p class="eyebrow text-[var(--koa-amber-light)]">Bring us to you</p><h2 class="display mt-5 text-4xl">Mobile Bar</h2><p class="mt-4 text-sm leading-6 text-white/65">Professional dry-bar service for celebrations throughout Hawaiʻi Island.</p><a href="/inquire/?service=mobile-bar" class="link-arrow mt-7 text-white">Get a bar quote →</a></div><div class="relative h-[16rem] overflow-hidden rounded-[1.6rem] sm:h-[18rem] lg:h-[20rem]"><ResponsiveImage {...koaMarketingMedia.mobileBarCouplePortrait} width={900} height={650} sizes="(min-width:1024px) 38vw,100vw" class="absolute inset-0 h-full w-full object-cover"/></div></div>
</div></section>

<section class="py-24 lg:py-32"><div class="container-shell grid gap-12 lg:grid-cols-[.78fr_1.22fr] lg:gap-24"><div><p class="eyebrow text-[var(--koa-clay)]">A better inquiry</p><h2 class="display mt-5 text-5xl leading-[1] sm:text-6xl">Tell us the date, guest count and feeling you want.</h2></div><div><p class="text-base leading-7 text-[var(--koa-ink)]/68">Private events vary too much for one package chart to be useful. We qualify the event first—occasion, timing, guest count, location, budget and beverage needs—then recommend the most sensible configuration.</p><a href="/inquire/" class="link-arrow mt-8">Start your inquiry →</a></div></div></section>
</main><Footer/></BaseLayout>