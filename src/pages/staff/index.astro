---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Koa’s Staff Workspace" description="Operational workspace for Koa’s Events sales and event staff." canonical="https://koasevents.com/staff/">
  <main class="min-h-screen bg-[var(--koa-sand)] py-14">
    <div class="container-shell max-w-5xl">
      <section class="rounded-[1.8rem] bg-white p-7 shadow-[var(--shadow-soft)] sm:p-10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow text-[var(--koa-clay)]">Koa’s Events</p>
            <h1 class="display mt-3 text-5xl">Staff Workspace</h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-[var(--koa-ink)]/58">Sales, client management, content and event operations in one protected workspace. Technical administration is not available here.</p>
          </div>
          <button data-logout class="hidden rounded-full border border-[var(--koa-line)] px-4 py-2 text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Sign out</button>
        </div>

        <div data-auth-panel class="mt-8">
          <form data-login-form class="grid max-w-md gap-4">
            <label class="grid gap-2 text-sm font-semibold">Email<input name="email" type="email" autocomplete="email" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <label class="grid gap-2 text-sm font-semibold">Password<input name="password" type="password" autocomplete="current-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
            <button class="rounded-full bg-[var(--koa-forest)] px-6 py-3.5 text-xs font-black uppercase tracking-[.12em] text-white">Sign in</button>
            <p data-auth-error class="hidden text-sm text-red-700"></p>
          </form>

          <div data-role-warning class="hidden rounded-xl border border-[var(--koa-line)] bg-[var(--koa-sand)] p-5">
            <p class="font-semibold text-[var(--koa-ink)]">This account does not have staff workspace access.</p>
            <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58">Assign the account one of these Identity roles: <strong>staff</strong>, <strong>sales</strong>, or <strong>manager</strong>.</p>
          </div>

          <div data-staff-ui class="hidden">
            <a data-health-warning href="/admin/health/" class="mb-5 hidden rounded-[1.2rem] border border-red-300 bg-red-50 p-5 text-red-950">
              <span class="text-[.58rem] font-black uppercase tracking-[.1em] text-red-700">System health warning</span>
              <strong data-health-warning-title class="mt-2 block text-lg">A protected Koa’s service needs attention.</strong>
              <span data-health-warning-detail class="mt-1 block text-sm text-red-900/70">Managers/admins can open System Health for details.</span>
            </a>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <a href="/admin/crm/" class="rounded-[1.35rem] bg-[var(--koa-ink)] p-6 text-white"><span class="display text-3xl">Business CRM</span><span class="mt-2 block text-sm text-white/68">Clients, projects, tasks, appointments, workflows, templates, payments and activity.</span></a>
              <a href="/admin/quotes/" class="rounded-[1.35rem] bg-[var(--koa-clay)] p-6 text-white"><span class="display text-3xl">Sales CRM</span><span class="mt-2 block text-sm text-white/72">Inquiries, proposals, bookings, follow-ups, quote records and conversion reporting.</span></a>
              <a href="/admin/quotes/#mobile-bar" class="rounded-[1.35rem] bg-[var(--koa-forest)] p-6 text-white"><span class="display text-3xl">Mobile Bar CRM</span><span class="mt-2 block text-sm text-white/68">Dedicated Mobile Bar pipeline, pricing details, follow-ups and reporting.</span></a>
              <a href="/admin/blog/" class="rounded-[1.35rem] border border-[var(--koa-line)] bg-white p-6 text-[var(--koa-forest)] shadow-sm"><span class="display text-3xl">Blog</span><span class="mt-2 block text-sm text-[var(--koa-ink)]/55">Create, edit, publish and manage Koa’s journal content.</span></a>
              <a href="/admin/events/" class="rounded-[1.35rem] bg-[var(--koa-forest)] p-6 text-white"><span class="display text-3xl">Event Ops</span><span class="mt-2 block text-sm text-white/68">Documents, vendors, questionnaires, timelines, checklists and event-day tasks.</span></a>
              <a href="/admin/calendar/" class="rounded-[1.35rem] bg-[var(--koa-clay)] p-6 text-white"><span class="display text-3xl">Master Calendar</span><span class="mt-2 block text-sm text-white/72">Events, deadlines, staffing assignments, vendor arrivals and conflict detection.</span></a>
            </div>

            <form data-password-form class="mt-7 grid gap-3 rounded-[1.2rem] border border-[var(--koa-line)] bg-white p-5 sm:max-w-xl">
              <div><p class="text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Account security</p><h2 class="display mt-2 text-3xl">Change password</h2></div>
              <label class="grid gap-2 text-sm font-semibold">New password<input name="password" type="password" minlength="10" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <label class="grid gap-2 text-sm font-semibold">Confirm password<input name="confirmPassword" type="password" minlength="10" autocomplete="new-password" required class="rounded-xl border border-[var(--koa-line)] px-4 py-3" /></label>
              <button class="w-fit rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.1em] text-white">Update password</button>
              <p data-password-message class="text-sm text-[var(--koa-ink)]/58"></p>
            </form>

            <div class="mt-7 rounded-[1.2rem] bg-[var(--koa-sand)] p-5">
              <p class="text-xs font-black uppercase tracking-[.1em] text-[var(--koa-clay)]">Protected technical administration</p>
              <p class="mt-2 text-sm leading-6 text-[var(--koa-ink)]/58">QuickBooks connection/settings, Gallery administration, SEO tools, Security + Spam controls, and other technical configuration remain administrator-only.</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    import { getUser, login, logout, updateUser } from '@netlify/identity';

    const approvedAdminEmails = new Set(['chris@sibel.org','koasadmin@koasevents.com']);
    const allowedRoles = new Set(['admin','staff','sales','manager']);
    const loginForm = document.querySelector('[data-login-form]');
    const staffUi = document.querySelector('[data-staff-ui]');
    const roleWarning = document.querySelector('[data-role-warning]');
    const authError = document.querySelector('[data-auth-error]');
    const logoutButton = document.querySelector('[data-logout]');

    function hasStaffAccess(user) {
      const email = String(user?.email || '').trim().toLowerCase();
      const roleSources = [user?.roles, user?.appMetadata?.roles, user?.app_metadata?.roles];
      const roles = roleSources.find(Array.isArray) || [];
      return approvedAdminEmails.has(email) || roles.some((role) => allowedRoles.has(String(role || '').toLowerCase()));
    }

    async function updateHealthWarning(access) {
      const warning=document.querySelector('[data-health-warning]');
      if(!warning||!access){warning?.classList.add('hidden');return;}
      try{
        const response=await fetch('/api/admin/health',{cache:'no-store'});
        if(!response.ok)return;
        const data=await response.json();const current=data.current;
        const unhealthy=current?.overall==='unhealthy';
        warning.classList.toggle('hidden',!unhealthy);
        if(unhealthy){
          const names=(current.checks||[]).filter((row)=>!row.ok).map((row)=>row.name);
          document.querySelector('[data-health-warning-title]').textContent=current.failed+' health check'+(current.failed===1?'':'s')+' failing';
          document.querySelector('[data-health-warning-detail]').textContent=(names.slice(0,4).join(', ')||'Protected system issue detected')+(names.length>4?' +'+(names.length-4)+' more':'')+' · checked '+new Date(current.checkedAt).toLocaleString();
        }
      }catch{}
    }

    function show(user) {
      const access = Boolean(user) && hasStaffAccess(user);
      loginForm?.classList.toggle('hidden', Boolean(user));
      staffUi?.classList.toggle('hidden', !access);
      roleWarning?.classList.toggle('hidden', !user || access);
      logoutButton?.classList.toggle('hidden', !user);
      updateHealthWarning(access);
    }

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(loginForm);
      try {
        const user = await login(String(data.get('email') || ''), String(data.get('password') || ''));
        authError?.classList.add('hidden');
        show(user);
      } catch (err) {
        if (authError) {
          authError.textContent = err instanceof Error ? err.message : 'Unable to sign in.';
          authError.classList.remove('hidden');
        }
      }
    });

    document.querySelector('[data-password-form]')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const data = new FormData(form);
      const password = String(data.get('password') || '');
      const confirmPassword = String(data.get('confirmPassword') || '');
      const message = document.querySelector('[data-password-message]');
      if (password !== confirmPassword) {
        if (message) message.textContent = 'The passwords do not match.';
        return;
      }
      try {
        await updateUser({ password });
        form.reset();
        if (message) message.textContent = 'Password updated.';
      } catch (err) {
        if (message) message.textContent = err instanceof Error ? err.message : 'Unable to update password.';
      }
    });

    logoutButton?.addEventListener('click', async () => {
      await logout();
      show(null);
    });

    show(await getUser());
  </script>
</BaseLayout>
