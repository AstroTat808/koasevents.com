---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  socialImage = '/media/koa/pavilion-sunset-wide.webp',
  socialImageAlt = "Koa's Events pavilion and tropical grounds on Hawaiʻi Island",
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.koasevents.com');
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL(socialImage, siteUrl).href;
const logoUrl = new URL('/brand/koa-mark.png', siteUrl).href;
const organizationId = new URL('/#organization', siteUrl).href;
const websiteId = new URL('/#website', siteUrl).href;
const robotsContent = noindex
  ? 'noindex, nofollow, noarchive'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: "Koa's Events",
      url: new URL('/', siteUrl).href,
      logo: {
        '@type': 'ImageObject',
        url: logoUrl,
      },
      email: 'aloha@koasevents.com',
      telephone: '+1-844-808-5627',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '11-3334 Hibiscus St',
        addressLocality: 'Mountain View',
        addressRegion: 'HI',
        postalCode: '96771',
        addressCountry: 'US',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Hawaiʻi Island, Hawaii',
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', siteUrl).href,
      name: "Koa's Events",
      publisher: { '@id': organizationId },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl + '#webpage',
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': organizationId },
      inLanguage: 'en-US',
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/png" href="/brand/koa-mark.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Koa's Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <meta name="theme-color" content="#173d30" />
    <script type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
  </head>
  <body>
    <script is:inline>
      (() => {
        const hash = window.location.hash || '';
        const isIdentityCallback = /^#(?:invite_token|recovery_token|confirmation_token|access_token|error=)/.test(hash);
        const onAdmin = window.location.pathname === '/admin/' || window.location.pathname === '/admin';
        if (isIdentityCallback && !onAdmin) {
          window.location.replace('/admin/' + hash);
        }
      })();
    </script>
    <slot />
    <script is:inline>
      (() => {
        const normalizeAssetPath = (value) => {
          if (!value) return '';
          try {
            return new URL(value, window.location.origin).pathname;
          } catch {
            return String(value).split('?')[0].split('#')[0];
          }
        };

        const clamp = (value, fallback = 50) => {
          const number = Number(value);
          return Number.isFinite(number) ? Math.max(0, Math.min(100, number)) : fallback;
        };

        const applyFocalPoints = (root, focalMap) => {
          const scope = root?.querySelectorAll ? root : document;
          const images = [];

          if (root instanceof HTMLImageElement) images.push(root);
          if (root instanceof Element && root.matches?.('[data-koa-focal-src]') && !(root instanceof HTMLImageElement)) {
            const src = root.getAttribute('data-koa-focal-src');
            const focal = focalMap.get(normalizeAssetPath(src));
            if (focal && !root.hasAttribute('data-koa-focal-ignore')) {
              root.style.backgroundPosition = focal.x + '% ' + focal.y + '%';
            }
          }

          scope.querySelectorAll('img[src], img[data-koa-focal-src]').forEach((img) => images.push(img));

          images.forEach((img) => {
            if (img.hasAttribute('data-koa-focal-ignore')) return;
            const declared = img.getAttribute('data-koa-focal-src') || img.getAttribute('src') || img.currentSrc;
            const focal = focalMap.get(normalizeAssetPath(declared));
            if (!focal) return;
            img.style.objectPosition = focal.x + '% ' + focal.y + '%';
            img.dataset.koaFocalApplied = 'true';
          });

          scope.querySelectorAll('[data-koa-focal-src]:not(img)').forEach((element) => {
            if (element.hasAttribute('data-koa-focal-ignore')) return;
            const focal = focalMap.get(normalizeAssetPath(element.getAttribute('data-koa-focal-src')));
            if (!focal) return;
            element.style.backgroundPosition = focal.x + '% ' + focal.y + '%';
          });
        };

        fetch('/api/gallery')
          .then((response) => response.ok ? response.json() : null)
          .then((gallery) => {
            if (!gallery?.curatedEdits) return;

            const focalMap = new Map();
            Object.entries(gallery.curatedEdits).forEach(([src, edit]) => {
              if (!edit || (edit.focalX == null && edit.focalY == null)) return;
              focalMap.set(normalizeAssetPath(src), {
                x: clamp(edit.focalX),
                y: clamp(edit.focalY),
              });
            });

            if (!focalMap.size) return;
            window.__koaGalleryFocalPoints = focalMap;
            applyFocalPoints(document, focalMap);

            const observer = new MutationObserver((mutations) => {
              mutations.forEach((mutation) => {
                mutation.addedNodes.forEach((node) => {
                  if (node instanceof Element) applyFocalPoints(node, focalMap);
                });

                if (mutation.type === 'attributes' && mutation.target instanceof Element) {
                  applyFocalPoints(mutation.target, focalMap);
                }
              });
            });

            observer.observe(document.documentElement, {
              childList: true,
              subtree: true,
              attributes: true,
              attributeFilter: ['src', 'data-koa-focal-src'],
            });
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
