---
import '../styles/global.css';
import { businessRules } from '../data/businessRules';
import StaffUtilityNav from '../components/StaffUtilityNav.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: 'website' | 'article';
  breadcrumbTitle?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  socialImage = '/media/koa/pavilion-sunset-wide.webp',
  socialImageAlt = "Koa's Events pavilion and tropical grounds on Hawaiʻi Island",
  ogType = 'website',
  breadcrumbTitle,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://koasevents.com');
const canonicalObject = new URL(canonical ?? Astro.url.pathname, siteUrl);
canonicalObject.protocol = 'https:';
canonicalObject.port = '';
if (canonicalObject.hostname === 'www.koasevents.com') canonicalObject.hostname = 'koasevents.com';
const canonicalUrl = canonicalObject.href;
const canonicalPath = canonicalObject.pathname;
const socialImageUrl = new URL(socialImage, siteUrl).href;
const logoUrl = new URL('/brand/koa-mark.png', siteUrl).href;
const businessImageUrl = new URL('/media/koa/pavilion-sunset-wide.webp', siteUrl).href;
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(businessRules.contact.venueAddress);
const organizationId = new URL('/#organization', siteUrl).href;
const websiteId = new URL('/#website', siteUrl).href;
const robotsContent = noindex
  ? 'noindex, nofollow, noarchive'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const buildCommit = String(process.env.COMMIT_REF || '').trim();
const deployId = String(process.env.DEPLOY_ID || '').trim();
const buildTime = new Date().toISOString();
const showWorkspaceNav = canonicalPath === '/staff/' || canonicalPath.startsWith('/admin/');

const breadcrumbLabelMap: Record<string, string> = {
  about: 'About',
  weddings: 'Weddings',
  'east-hawaii-wedding-venue': 'East Hawaiʻi Wedding Venue',
  'signature-wedding': 'Signature Wedding',
  venue: 'Venue',
  packages: 'Wedding Venue Packages',
  faq: 'FAQ',
  'mobile-bar': 'Mobile Bar',
  'private-events': 'Private Events',
  'corporate-events': 'Corporate Events',
  stay: 'Stay',
  gallery: 'Gallery',
  catalog: 'Event Rentals',
  contact: 'Contact',
  blog: 'Blog',
  inquire: 'Inquire',
  'wedding-inquiry': 'Wedding Inquiry',
  privacy: 'Privacy Policy',
  terms: 'Terms of Use',
};

const pathSegments = canonicalPath.split('/').filter(Boolean);
const breadcrumbSchema = !noindex && pathSegments.length > 0
  ? {
      '@type': 'BreadcrumbList',
      '@id': canonicalUrl + '#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL('/', siteUrl).href,
        },
        ...pathSegments.map((segment, index) => ({
          '@type': 'ListItem',
          position: index + 2,
          name: index === pathSegments.length - 1 && breadcrumbTitle
            ? breadcrumbTitle
            : (breadcrumbLabelMap[segment] || segment.replaceAll('-', ' ')),
          item: new URL('/' + pathSegments.slice(0, index + 1).join('/') + '/', siteUrl).href,
        })),
      ],
    }
  : null;

const serviceDefinitions: Record<string, { name: string; serviceType: string; description: string }> = {
  '/weddings/': {
    name: "Koa's Events Wedding Venue Service",
    serviceType: 'Wedding venue rental',
    description: 'Private rainforest wedding venue service in Mountain View, Hawaiʻi for celebrations of up to 100 guests.',
  },
  '/east-hawaii-wedding-venue/': {
    name: "Koa's East Hawaiʻi Wedding Venue",
    serviceType: 'East Hawaiʻi wedding venue rental',
    description: 'Private Mountain View wedding venue serving couples comparing Hilo, Volcano and East Hawaiʻi wedding locations.',
  },
  '/signature-wedding/': {
    name: "The Koa's Signature Wedding Experience",
    serviceType: 'Wedding venue and wedding weekend service',
    description: 'A premium private rainforest wedding weekend experience at Koa’s Events in Mountain View, Hawaiʻi.',
  },
  '/venue/': {
    name: "Koa's Events Venue Rental",
    serviceType: 'Event venue rental',
    description: 'Private event venue rental in Mountain View, Hawaiʻi with flexible wedding and celebration configurations.',
  },
  '/venue/packages/': {
    name: "Koa's Events Wedding Venue Packages",
    serviceType: 'Wedding venue rental',
    description: 'Wedding venue packages and starting configurations for celebrations at Koa’s Events in Mountain View, Hawaiʻi.',
  },
  '/mobile-bar/': {
    name: "Koa's Mobile Bar",
    serviceType: 'Mobile bar and bartending service',
    description: 'Professional dry-bar and bartender service for weddings, private events and corporate gatherings across Hawaiʻi Island.',
  },
  '/private-events/': {
    name: "Koa's Private Event Services",
    serviceType: 'Private event venue and mobile bar service',
    description: 'Venue and mobile bar services for birthdays, showers, reunions, retreats and milestone celebrations on Hawaiʻi Island.',
  },
  '/corporate-events/': {
    name: "Koa's Corporate Event Services",
    serviceType: 'Corporate event venue and mobile bar service',
    description: 'Venue and beverage-service planning for retreats, client events, workshops and company celebrations on Hawaiʻi Island.',
  },
  '/stay/': {
    name: "Stay at Koa's",
    serviceType: 'Direct cottage stay service',
    description: 'Direct cottage stay requests in Mountain View, Hawaiʻi, including wedding-weekend and independent stays.',
  },
  '/catalog/': {
    name: "Koa's Event Rental Service",
    serviceType: 'Event rental service',
    description: 'Event rental inventory and add-ons available for Koa’s Events celebrations on Hawaiʻi Island.',
  },
};

const serviceDefinition = serviceDefinitions[canonicalPath];
const signaturePackage = businessRules.venueWeddingPackages.find((item) => item.name === 'Plumeria');
const serviceOffers =
  canonicalPath === '/signature-wedding/' && signaturePackage
    ? [{
        '@type': 'Offer',
        name: signaturePackage.publicName,
        price: String(signaturePackage.price),
        priceCurrency: 'USD',
        url: canonicalUrl,
      }]
    : canonicalPath === '/venue/packages/'
      ? businessRules.venueWeddingPackages.map((item) => ({
          '@type': 'Offer',
          name: item.publicName,
          price: String(item.price),
          priceCurrency: 'USD',
          url: new URL('/venue/packages/#' + item.name.toLowerCase(), siteUrl).href,
        }))
      : canonicalPath === '/mobile-bar/'
        ? businessRules.mobileBar.packages.map((item) => ({
            '@type': 'Offer',
            name: item.name,
            price: String(item.price),
            priceCurrency: 'USD',
            url: new URL('/mobile-bar/#packages', siteUrl).href,
          }))
        : undefined;

const serviceSchema = serviceDefinition
  ? {
      '@type': 'Service',
      '@id': canonicalUrl + '#service',
      url: canonicalUrl,
      name: serviceDefinition.name,
      serviceType: serviceDefinition.serviceType,
      description: serviceDefinition.description,
      provider: { '@id': organizationId },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Hawaiʻi Island, Hawaii',
      },
      ...(serviceOffers ? { offers: serviceOffers } : {}),
    }
  : null;

const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'EventVenue'],
      '@id': organizationId,
      name: "Koa's Events",
      legalName: "Koa's Events LLC",
      url: new URL('/', siteUrl).href,
      description: 'A private wedding and event venue in Mountain View, Hawaiʻi, with mobile bar service available across Hawaiʻi Island.',
      logo: {
        '@type': 'ImageObject',
        url: logoUrl,
      },
      image: businessImageUrl,
      email: 'aloha@koasevents.com',
      telephone: '+1-844-808-5627',
      hasMap: directionsUrl,
      maximumAttendeeCapacity: businessRules.venue.maximumOccupancy.value,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '11-3330 Hibiscus St',
        addressLocality: 'Mountain View',
        addressRegion: 'HI',
        postalCode: '96771',
        addressCountry: 'US',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Hawaiʻi Island, Hawaii',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: '+1-844-808-5627',
        email: 'aloha@koasevents.com',
        availableLanguage: 'English',
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', siteUrl).href,
      name: "Koa's Events",
      publisher: { '@id': organizationId },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl + '#webpage',
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': organizationId },
      inLanguage: 'en-US',
    },
    ...(serviceSchema ? [serviceSchema] : []),
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ],
};---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {buildCommit && <meta name="koa-build-commit" content={buildCommit} />}
    {deployId && <meta name="koa-deploy-id" content={deployId} />}
    <meta name="koa-build-time" content={buildTime} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/png" href="/brand/koa-mark.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Koa's Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <meta name="theme-color" content="#173d30" />
    <script type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
  </head>
  <body>
    <script is:inline>
      (() => {
        const hash = window.location.hash || '';
        const isIdentityCallback = /^#(?:invite_token|recovery_token|confirmation_token|access_token|error=)/.test(hash);
        const onAdmin = window.location.pathname === '/admin/' || window.location.pathname === '/admin';
        if (isIdentityCallback && !onAdmin) {
          window.location.replace('/admin/' + hash);
        }
      })();
    </script>
    {showWorkspaceNav && <StaffUtilityNav />}
    <slot />
    <script is:inline>
      (() => {
        const normalizeAssetPath = (value) => {
          if (!value) return '';
          try {
            const url = new URL(value, window.location.origin);

            // ResponsiveImage is served through Netlify Image CDN. Decode the original
            // asset so focal points still match even if data-koa-focal-src is absent.
            if (url.pathname === '/.netlify/images') {
              const original = url.searchParams.get('url');
              if (original) return new URL(original, window.location.origin).pathname;
            }

            return url.pathname;
          } catch {
            return String(value).split('?')[0].split('#')[0];
          }
        };

        const clamp = (value, fallback = 50) => {
          const number = Number(value);
          return Number.isFinite(number) ? Math.max(0, Math.min(100, number)) : fallback;
        };

        const focalForImage = (img, focalMap) => {
          const candidates = [
            img.getAttribute('data-koa-focal-src'),
            img.getAttribute('src'),
            img.currentSrc,
          ];

          for (const candidate of candidates) {
            const focal = focalMap.get(normalizeAssetPath(candidate));
            if (focal) return focal;
          }
          return null;
        };

        const applyFocalPoints = (root, focalMap) => {
          const scope = root?.querySelectorAll ? root : document;
          const images = [];

          if (root instanceof HTMLImageElement) images.push(root);
          scope.querySelectorAll('img[src], img[data-koa-focal-src]').forEach((img) => images.push(img));

          images.forEach((img) => {
            if (img.hasAttribute('data-koa-focal-ignore')) return;
            const focal = focalForImage(img, focalMap);
            if (!focal) return;

            // Inline object-position intentionally wins over utility classes such as
            // object-top, so one crop adjustment is honored everywhere this asset appears.
            img.style.objectPosition = focal.x + '% ' + focal.y + '%';
            img.dataset.koaFocalApplied = 'true';
          });

          const backgroundElements = [];
          if (root instanceof Element && root.matches?.('[data-koa-focal-src]:not(img)')) backgroundElements.push(root);
          scope.querySelectorAll('[data-koa-focal-src]:not(img)').forEach((element) => backgroundElements.push(element));

          backgroundElements.forEach((element) => {
            if (element.hasAttribute('data-koa-focal-ignore')) return;
            const focal = focalMap.get(normalizeAssetPath(element.getAttribute('data-koa-focal-src')));
            if (!focal) return;
            element.style.backgroundPosition = focal.x + '% ' + focal.y + '%';
            element.dataset.koaFocalApplied = 'true';
          });
        };

        fetch('/api/gallery', { cache: 'no-store', headers: { Accept: 'application/json' } })
          .then((response) => response.ok ? response.json() : null)
          .then((gallery) => {
            if (!gallery) return;

            const focalMap = new Map();

            Object.entries(gallery.curatedEdits || {}).forEach(([src, edit]) => {
              if (!edit || (edit.focalX == null && edit.focalY == null)) return;
              focalMap.set(normalizeAssetPath(src), {
                x: clamp(edit.focalX),
                y: clamp(edit.focalY),
              });
            });

            (Array.isArray(gallery.uploads) ? gallery.uploads : []).forEach((item) => {
              if (!item?.src || (item.focalX == null && item.focalY == null)) return;
              focalMap.set(normalizeAssetPath(item.src), {
                x: clamp(item.focalX),
                y: clamp(item.focalY),
              });
            });

            if (!focalMap.size) return;
            window.__koaGalleryFocalPoints = focalMap;
            window.__koaApplyGalleryFocalPoints = (root = document) => applyFocalPoints(root, focalMap);
            applyFocalPoints(document, focalMap);

            const observer = new MutationObserver((mutations) => {
              mutations.forEach((mutation) => {
                mutation.addedNodes.forEach((node) => {
                  if (node instanceof Element) applyFocalPoints(node, focalMap);
                });

                if (mutation.type === 'attributes' && mutation.target instanceof Element) {
                  applyFocalPoints(mutation.target, focalMap);
                }
              });
            });

            observer.observe(document.documentElement, {
              childList: true,
              subtree: true,
              attributes: true,
              attributeFilter: ['src', 'srcset', 'data-koa-focal-src'],
            });
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
