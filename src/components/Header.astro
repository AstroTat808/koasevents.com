---
interface Props { overlay?: boolean; }
const { overlay = true } = Astro.props;

const nav = [
  { label: 'Venue', href: '/venue/' },
  { label: 'Mobile Bar', href: '/mobile-bar/' },
  { label: 'Weddings', href: '/weddings/' },
  { label: 'Private Events', href: '/private-events/' },
  { label: 'Corporate', href: '/corporate-events/' },
  { label: 'Gallery', href: '/gallery/' },
];

const position = overlay
  ? 'absolute inset-x-0 top-0 z-50'
  : 'relative z-50 bg-[var(--koa-ivory)] pb-4';
---
<header class:list={['site-header', position]}>
  <div class="container-shell pt-4 sm:pt-5">
    <div class="site-nav-shell">
      <a href="/" class="site-brand" aria-label="Koa's Events home">
        <span class="brand-medallion">
          <img src="/brand/koa-mark.png" width="52" height="52" alt="" />
        </span>
        <span class="min-w-0">
          <span class="site-brand-name block truncate">Koa’s Events</span>
          <span class="site-brand-meta">Hawaiʻi Island · Venue + Mobile Bar</span>
        </span>
      </a>

      <nav class="hidden items-center gap-5 xl:flex" aria-label="Primary navigation">
        {nav.map((item) => <a class="site-nav-link" href={item.href}>{item.label}</a>)}
      </nav>

      <div class="flex items-center gap-2">
        <a href="/inquire/" class="site-nav-cta hidden sm:inline-flex">Check availability</a>
        <details class="group relative xl:hidden">
          <summary class="site-menu-trigger">
            <span class="site-menu-lines" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>Menu</span>
          </summary>
          <div class="site-menu-panel fixed inset-x-3 top-[6.35rem] z-[70] max-h-[calc(100svh-7rem)] overflow-auto rounded-[1.35rem] p-4 sm:absolute sm:inset-x-auto sm:right-0 sm:top-auto sm:mt-3 sm:w-80">
            <div class="mb-3 flex items-center gap-3 border-b border-[var(--koa-line)] pb-4">
              <span class="brand-medallion !h-12 !w-12"><img src="/brand/koa-mark.png" width="42" height="42" alt="" /></span>
              <div>
                <p class="display text-2xl text-[var(--koa-forest)]">Koa’s Events</p>
                <p class="mt-1 text-[0.58rem] font-bold uppercase tracking-[.17em] text-[var(--koa-clay)]">Gather beautifully.</p>
              </div>
            </div>
            {nav.map((item) => <a class="block rounded-xl px-4 py-3 text-base font-semibold text-[var(--koa-ink)]/78 hover:bg-[var(--koa-sand)] hover:text-[var(--koa-forest)]" href={item.href}>{item.label}</a>)}
            <div class="mt-3 grid gap-2 border-t border-[var(--koa-line)] pt-4">
              <a class="site-nav-cta w-full" href="/inquire/">Check availability</a>
              <a class="rounded-full border border-[var(--koa-line)] px-4 py-3 text-center text-sm font-semibold text-[var(--koa-forest)]" href="tel:+18448085627">844-808-KOAS</a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
