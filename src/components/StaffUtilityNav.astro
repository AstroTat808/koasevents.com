</style>

<script>
  import { logout } from '@netlify/identity';
  import { getAdminSession } from '../lib/admin-session';

  const nav = document.querySelector('[data-workspace-nav]');
  const links = nav?.querySelector('[data-workspace-links]');
  const toggle = nav?.querySelector('[data-workspace-toggle]');

  function normalizedPath(value) {
    const path = String(value || '/').split('?')[0].split('#')[0];
    return path.endsWith('/') ? path : path + '/';
  }

  function roleLabel(role) {
    const labels = {
      admin: 'Administrator',
      manager: 'Manager',
      sales: 'Sales Rep',
      event_coordinator: 'Event Coordinator',
      vendor_manager: 'Vendor Manager',
      content_editor: 'Content Editor',
      accounting: 'Accounting',
      read_only: 'Read Only',
      custom: 'Custom Role',
    };
    return labels[role] || String(role || 'Staff').replaceAll('_', ' ');
  }

  function badgeText(value) {
    const count = Math.max(0, Number(value || 0));
    return count > 99 ? '99+' : String(count);
  }

  function highestSeverity(alerts) {
    const rows = Array.isArray(alerts) ? alerts : [];
    if (rows.some((row) => row?.severity === 'urgent')) return 'urgent';
    if (rows.some((row) => row?.severity === 'upcoming')) return 'upcoming';
    return rows.length ? 'info' : '';
  }

  function setMenu(open, persist = true) {
    if (!(links instanceof HTMLElement) || !(toggle instanceof HTMLElement)) return;
    links.dataset.open = open ? 'true' : 'false';
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    nav?.querySelector('[data-workspace-more-toggle]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
    const chevron = toggle.querySelector('[data-workspace-chevron]');
    if (chevron) chevron.textContent = '⌄';
    if (persist) {
      try { window.localStorage.setItem('koa-workspace-nav-open', open ? '1' : '0'); } catch {}
    }
  }

  let accountSecurityLoaded=false;

  function setAccountPanel(open) {
    const panel=nav?.querySelector('[data-workspace-account-panel]');
    const button=nav?.querySelector('[data-workspace-account-toggle]');
    if(!(panel instanceof HTMLElement)||!(button instanceof HTMLElement))return;
    panel.dataset.open=open?'true':'false';
    button.setAttribute('aria-expanded',open?'true':'false');
    if(open){
      setMenu(false);
      setAlertCenter(false);
      void loadAccountSecurity();
    }
  }

  async function accountSecurityAction(action,payload={}) {
    const response=await fetch('/api/account/security',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({action,...payload}),
    });
    const data=await response.json().catch(()=>({}));
    if(!response.ok)throw new Error(data.error||'Account security update failed.');
    return data;
  }

  function renderTrustedDevices(data) {
    const list=nav?.querySelector('[data-workspace-trusted-devices]');
    const count=nav?.querySelector('[data-workspace-trusted-count]');
    const current=nav?.querySelector('[data-workspace-current-device]');
    const currentDetail=nav?.querySelector('[data-workspace-current-device-detail]');
    const trustButton=nav?.querySelector('[data-workspace-trust-current]');
    if(count)count.textContent=String((data?.trustedDevices||[]).length);
    if(current)current.textContent=data?.currentDevice?.trusted
      ?(data.currentDevice.name||'This browser')+' · Trusted'
      :'Not trusted';
    if(currentDetail)currentDetail.textContent=data?.currentDevice?.device||'Current browser';
    if(trustButton instanceof HTMLButtonElement){
      trustButton.disabled=Boolean(data?.currentDevice?.trusted);
      trustButton.textContent=data?.currentDevice?.trusted?'Browser trusted':'Trust this browser';
    }
    if(!(list instanceof HTMLElement))return;
    list.innerHTML='';
    const devices=Array.isArray(data?.trustedDevices)?data.trustedDevices:[];
    devices.forEach((device)=>{
      const row=document.createElement('article');
      row.className='workspace-account-device';

      const header=document.createElement('div');
      header.className='flex items-start justify-between gap-3';
      const meta=document.createElement('div');
      meta.className='min-w-0';
      const title=document.createElement('p');
      title.className='text-xs font-semibold text-[var(--koa-forest)]';
      title.textContent=(device.device||'Browser')+(device.current?' · This browser':'');
      const detail=document.createElement('p');
      detail.className='mt-1 text-[.66rem] leading-4 text-[var(--koa-ink)]/45';
      detail.textContent=device.trustedAt?'Trusted '+new Date(device.trustedAt).toLocaleString():'Trusted device';
      meta.append(title,detail);
      header.appendChild(meta);
      row.appendChild(header);

      const input=document.createElement('input');
      input.type='text';
      input.maxLength=120;
      input.value=String(device.name||device.device||'Trusted device');
      input.setAttribute('aria-label','Friendly name for '+String(device.device||'trusted device'));
      input.className='mt-3';
      row.appendChild(input);

      const actions=document.createElement('div');
      actions.className='mt-2 flex flex-wrap gap-2';
      const save=document.createElement('button');
      save.type='button';
      save.className='workspace-account-device-action';
      save.textContent='Save name';
      save.addEventListener('click',async()=>{
        const message=nav?.querySelector('[data-workspace-account-message]');
        if(message)message.textContent='Saving device name…';
        try{
          await accountSecurityAction('rename-trusted-device',{deviceId:device.id,name:input.value});
          accountSecurityLoaded=false;
          await loadAccountSecurity();
          if(message)message.textContent='Device name saved.';
        }catch(error){
          if(message)message.textContent=error instanceof Error?error.message:'Unable to rename device.';
        }
      });

      const revoke=document.createElement('button');
      revoke.type='button';
      revoke.className='workspace-account-device-action';
      revoke.dataset.danger='true';
      revoke.textContent='Revoke trust';
      revoke.addEventListener('click',async()=>{
        if(!confirm('Revoke trusted-device status from '+String(device.name||device.device||'this device')+'?'))return;
        const message=nav?.querySelector('[data-workspace-account-message]');
        if(message)message.textContent='Revoking trust…';
        try{
          await accountSecurityAction('revoke-trusted-device',{deviceId:device.id});
          accountSecurityLoaded=false;
          await loadAccountSecurity();
          if(message)message.textContent='Trusted-device status revoked.';
        }catch(error){
          if(message)message.textContent=error instanceof Error?error.message:'Unable to revoke trust.';
        }
      });
      actions.append(save,revoke);
      row.appendChild(actions);
      list.appendChild(row);
    });
    if(!devices.length){
      const empty=document.createElement('p');
      empty.className='rounded-xl border border-dashed border-[var(--koa-line)] p-3 text-xs text-[var(--koa-ink)]/45';
      empty.textContent='No trusted browsers yet.';
      list.appendChild(empty);
    }
  }

  async function loadAccountSecurity() {
    if(accountSecurityLoaded)return;
    const message=nav?.querySelector('[data-workspace-account-message]');
    if(message)message.textContent='Loading trusted devices…';
    try{
      const response=await fetch('/api/account/security',{cache:'no-store'});
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(data.error||'Unable to load account security.');
      renderTrustedDevices(data);
      accountSecurityLoaded=true;
      if(message)message.textContent='';
    }catch(error){
      if(message)message.textContent=error instanceof Error?error.message:'Unable to load account security.';
    }
  }

