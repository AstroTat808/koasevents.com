---
const isAdminWorkspace = Astro.url.pathname.startsWith('/admin/');
---

<nav
  data-workspace-nav
  class="hidden sticky top-0 z-50 border-b border-[var(--koa-line)] bg-white/95 shadow-sm backdrop-blur"
  aria-label="Koa’s workspace navigation"
>
  <div class="container-shell py-2.5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-2">
        <button
          data-workspace-toggle
          type="button"
          class="workspace-menu-button"
          aria-expanded="false"
          aria-controls="koa-workspace-links"
        >
          <span>Workspace</span>
          <span data-workspace-chevron aria-hidden="true">⌄</span>
        </button>
        <button
          data-workspace-alert-toggle-mobile
          type="button"
          class="hidden workspace-mobile-alert md:hidden"
          aria-expanded="false"
          aria-controls="koa-workspace-alert-center"
          aria-label="Open workspace alerts"
        >
          <span data-workspace-total class="workspace-total-badge"></span>
        </button>

        <span
          data-workspace-role
          class="hidden shrink-0 rounded-full bg-[var(--koa-sand)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)] sm:inline-flex"
        ></span>
      </div>

      <div class="flex min-w-0 items-center gap-2">
        <button
          data-workspace-account-toggle
          type="button"
          class="workspace-account-toggle"
          aria-expanded="false"
          aria-controls="koa-workspace-account-panel"
        >
          <span data-workspace-user class="hidden max-w-[10rem] truncate sm:inline"></span>
          <span class="sm:hidden">Account</span>
          <span data-workspace-account-chevron aria-hidden="true">⌄</span>
        </button>
        <a data-workspace-action-summary href="/admin/actions/" class="hidden workspace-desktop-actions md:inline-flex" aria-label="Open Action Center">
          <span class="workspace-desktop-actions-label">Actions</span>
          <span data-action-critical class="workspace-desktop-action-chip" data-severity="urgent">C 0</span>
          <span data-action-warning class="workspace-desktop-action-chip" data-severity="upcoming">W 0</span>
          <span data-action-new class="workspace-desktop-action-chip" data-severity="new">N 0</span>
        </a>
        <button data-workspace-alert-toggle type="button" class="hidden workspace-desktop-alert md:inline-flex" aria-expanded="false" aria-controls="koa-workspace-alert-center"></button>
        <button data-workspace-logout type="button" class="workspace-signout">Sign out</button>
      </div>
    </div>

    <section
      id="koa-workspace-account-panel"
      data-workspace-account-panel
      data-open="false"
      class="workspace-account-panel"
      aria-label="My account and trusted devices"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="workspace-group-title">My account</p>
          <h2 class="display text-2xl text-[var(--koa-forest)]">Trusted browsers</h2>
          <p class="mt-1 text-xs leading-5 text-[var(--koa-ink)]/55">Trust this exact browser, give trusted devices friendly names, or revoke trust without opening User Management.</p>
        </div>
        <button data-workspace-account-close type="button" class="workspace-alert-close">Close</button>
      </div>

      <div class="mt-4 rounded-xl bg-[var(--koa-sand)] p-3">
        <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">This browser</p>
        <p data-workspace-current-device class="mt-1 text-sm font-semibold text-[var(--koa-forest)]">Checking…</p>
        <p data-workspace-current-device-detail class="mt-1 text-xs text-[var(--koa-ink)]/55"></p>
        <button data-workspace-trust-current type="button" class="workspace-account-primary mt-3">Trust this browser</button>
      </div>

      <div class="mt-4">
        <div class="flex items-center justify-between gap-3">
          <p class="text-[.54rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)]">Trusted devices</p>
          <span data-workspace-trusted-count class="text-xs font-semibold text-[var(--koa-ink)]/45">0</span>
        </div>
        <div data-workspace-trusted-devices class="mt-2 grid gap-2"></div>
      </div>
      <p data-workspace-account-message class="mt-3 min-h-[1.1rem] text-xs text-[var(--koa-ink)]/55"></p>
    </section>

    <section id="koa-workspace-alert-center" data-workspace-alert-center data-open="false" class="workspace-alert-center" aria-label="Workspace alerts">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="workspace-group-title">Alert Center</p>
          <h2 class="display text-2xl text-[var(--koa-forest)]">Items needing attention</h2>
          <p data-workspace-alert-summary class="mt-1 text-xs text-[var(--koa-ink)]/55"></p>
        </div>
        <button data-workspace-alert-close type="button" class="workspace-alert-close">Close</button>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <button data-alert-tab="active" type="button" class="workspace-alert-tab" aria-pressed="true">Active <span data-alert-tab-count="active"></span></button>
        <button data-alert-tab="snoozed" type="button" class="workspace-alert-tab" aria-pressed="false">Snoozed <span data-alert-tab-count="snoozed"></span></button>
        <button data-alert-tab="dismissed" type="button" class="workspace-alert-tab" aria-pressed="false">Dismissed <span data-alert-tab-count="dismissed"></span></button>
        <button data-alert-tab="history" type="button" class="workspace-alert-tab" aria-pressed="false">History</button>
      </div>

      <div data-workspace-alert-list class="mt-4 grid gap-2"></div>
    </section>

    <div
      id="koa-workspace-links"
      data-workspace-links
      data-open="false"
      class="workspace-links grid-cols-1 gap-3 rounded-[1rem] bg-white md:grid-cols-2 lg:grid-cols-6"
    >
      <section data-mobile-nav-settings class="workspace-mobile-nav-settings">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="workspace-group-title">Mobile navigation</p>
            <p class="px-1 text-xs leading-5 text-[var(--koa-ink)]/55">Choose the four modules shown next to More on this account.</p>
          </div>
          <button data-mobile-nav-edit type="button" class="workspace-alert-action">Customize</button>
        </div>
        <div data-mobile-nav-editor class="mt-3 hidden">
          <div data-mobile-nav-selects class="grid gap-2"></div>
          <div class="mt-3 flex items-center gap-2">
            <button data-mobile-nav-save type="button" class="workspace-alert-action">Save</button>
            <span data-mobile-nav-message class="text-xs text-[var(--koa-ink)]/50"></span>
          </div>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Home</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="admin.dashboard.view" href="/admin/" class="workspace-nav-link">Admin Home</a>
          <a data-workspace-link href="/admin/actions/" class="workspace-nav-link">
            <span>Action Center</span><span data-link-alert="actionCenter" class="hidden workspace-link-badge"></span>
          </a>
          <a data-workspace-link href="/staff/" class="workspace-nav-link workspace-nav-home">Staff Home</a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Sales</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="crm.view" href="/admin/crm/" class="workspace-nav-link">
            <span>Business CRM</span><span data-link-alert="overdueTasks" class="hidden workspace-link-badge"></span>
          </a>
          <a data-workspace-link data-capability="sales.view" href="/admin/quotes/" class="workspace-nav-link">Sales CRM</a>
          <a data-workspace-link data-capability="email.view" href="/admin/email/" class="workspace-nav-link">Email</a>
          <a data-workspace-link data-capability="sales.profit_settings" href="/admin/profitability/" class="workspace-nav-link">Wedding Profitability</a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Operations</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="events.view" href="/admin/events/" class="workspace-nav-link">Event Ops</a>
          <a data-workspace-link data-capability="calendar.view" href="/admin/calendar/" class="workspace-nav-link">Master Calendar</a>
          <a data-workspace-link data-capability="vendors.view" href="/admin/vendors/" class="workspace-nav-link">Vendor CRM</a>
          <a data-workspace-link data-capability="insurance.view" href="/admin/insurance/" class="workspace-nav-link">
            <span>Insurance</span><span data-link-alert="vendorInsurance" class="hidden workspace-link-badge"></span>
          </a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Content</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="blog.view" href="/admin/blog/" class="workspace-nav-link">Blog</a>
          <a data-workspace-link data-capability="gallery.view" href="/admin/gallery/" class="workspace-nav-link">Gallery</a>
          <a data-workspace-link data-capability="seo.view" href="/admin/seo/" class="workspace-nav-link">Local SEO</a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Accounting</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="quickbooks.view" href="/admin/quickbooks/" class="workspace-nav-link">
            <span>QuickBooks</span><span data-link-alert="accountingMismatches" class="hidden workspace-link-badge"></span>
          </a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Administration</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="security.view" href="/admin/security/" class="workspace-nav-link">Security</a>
          <a data-workspace-link data-capability="health.view" href="/admin/health/" class="workspace-nav-link">
            <span>System Health</span><span data-link-alert="healthWarnings" class="hidden workspace-link-badge"></span>
          </a>
          <a data-workspace-link data-capability="users.manage" href="/admin/staff/" class="workspace-nav-link">User Management</a>
        </div>
      </section>
    </div>
  </div>

</nav>

{isAdminWorkspace && (
  <div data-workspace-bottom-nav class="workspace-bottom-nav" aria-label="Mobile admin navigation">
    {[0,1,2,3].map((slot)=>(
      <a data-workspace-bottom-slot={slot} href="/admin/" class="workspace-bottom-item" aria-label="Admin module">
        <span class="workspace-bottom-icon-wrap">
          <svg data-mobile-slot-icon viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.75 12 3l9 7.75v9.5a.75.75 0 0 1-.75.75h-5.5v-6.5h-5.5V21h-5.5a.75.75 0 0 1-.75-.75z"/></svg>
          <span data-mobile-slot-badge class="workspace-bottom-badge hidden"></span>
        </span>
        <span data-mobile-slot-label>Home</span>
      </a>
    ))}
    <button data-workspace-more-toggle type="button" class="workspace-bottom-item" aria-expanded="false" aria-controls="koa-workspace-links" aria-label="More admin modules">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h.01M12 7h.01M19 7h.01M5 12h.01M12 12h.01M19 12h.01M5 17h.01M12 17h.01M19 17h.01"/></svg>
      <span>More</span>
    </button>
  </div>
)}

<style>
  .workspace-menu-button,
  .workspace-mobile-alert,
  .workspace-account-toggle,
  .workspace-signout,
  .workspace-nav-link {
    border: 1px solid var(--koa-line);
    border-radius: 9999px;
    font-size: .6rem;
    font-weight: 900;
    letter-spacing: .08em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .workspace-menu-button {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    background: var(--koa-forest);
    border-color: var(--koa-forest);
    color: white;
    padding: .7rem .9rem;
  }

  .workspace-mobile-alert {
    align-items: center;
    justify-content: center;
    min-width: 2.35rem;
    min-height: 2.35rem;
    border-color: color-mix(in srgb, var(--koa-clay) 35%, var(--koa-line));
    background: white;
    color: var(--koa-clay);
    padding: .45rem;
  }

  .workspace-signout {
    flex: 0 0 auto;
    background: white;
    color: var(--koa-clay);
    padding: .55rem .75rem;
  }

  .workspace-account-toggle {
    display: inline-flex;
    min-height: 2.2rem;
    max-width: 13rem;
    align-items: center;
    gap: .42rem;
    background: white;
    color: var(--koa-forest);
    padding: .55rem .72rem;
  }

  .workspace-account-toggle[aria-expanded="true"] {
    border-color: var(--koa-forest);
    background: var(--koa-sand);
  }

  .workspace-account-toggle [data-workspace-account-chevron] {
    display: inline-block;
    transition: transform 180ms ease;
  }

  .workspace-account-toggle[aria-expanded="true"] [data-workspace-account-chevron] {
    transform: rotate(180deg);
  }

  [data-workspace-nav] > .container-shell {
    position: relative;
  }

  .workspace-account-panel {
    display: none;
    position: absolute;
    top: calc(100% + .35rem);
    right: .5rem;
    z-index: 85;
    width: min(34rem, calc(100vw - 2rem));
    max-height: min(72vh, 42rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--koa-line);
    border-radius: 1rem;
    background: white;
    padding: 1rem;
    box-shadow: 0 20px 60px rgba(7,30,23,.24);
  }

  .workspace-account-panel[data-open="true"] {
    display: block;
  }

  .workspace-account-primary {
    min-height: 2.55rem;
    border: 1px solid var(--koa-forest);
    border-radius: .72rem;
    background: var(--koa-forest);
    padding: .62rem .85rem;
    color: white;
    font-size: .58rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .workspace-account-primary:disabled {
    cursor: default;
    opacity: .6;
  }

  .workspace-account-device {
    border: 1px solid var(--koa-line);
    border-radius: .8rem;
    background: white;
    padding: .75rem;
  }

  .workspace-account-device input {
    min-height: 2.5rem;
    width: 100%;
    border: 1px solid var(--koa-line);
    border-radius: .65rem;
    background: white;
    padding: .55rem .65rem;
    color: var(--koa-forest);
    font-size: .78rem;
    font-weight: 700;
  }

  .workspace-account-device-action {
    min-height: 2.35rem;
    border: 1px solid var(--koa-line);
    border-radius: 999px;
    background: white;
    padding: .5rem .7rem;
    color: var(--koa-forest);
    font-size: .52rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .workspace-account-device-action[data-danger="true"] {
    border-color: rgb(254 202 202);
    color: rgb(185 28 28);
  }

  .workspace-links {
    display: grid;
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    padding: 0 .75rem;
    border: 0 solid var(--koa-line);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-.35rem) scale(.995);
    box-shadow: none;
    transition:
      max-height 240ms cubic-bezier(.22, 1, .36, 1),
      margin-top 220ms ease,
      padding 220ms ease,
      border-width 180ms ease,
      opacity 160ms ease,
      transform 220ms cubic-bezier(.22, 1, .36, 1),
      box-shadow 180ms ease,
      visibility 0s linear 240ms;
    will-change: max-height, opacity, transform;
  }

  .workspace-links[data-open="true"] {
    max-height: 72vh;
    margin-top: .5rem;
    overflow-y: auto;
    padding: .75rem;
    border-width: 1px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    box-shadow: var(--shadow-soft);
    transition:
      max-height 260ms cubic-bezier(.22, 1, .36, 1),
      margin-top 220ms ease,
      padding 220ms ease,
      border-width 180ms ease,
      opacity 180ms ease,
      transform 240ms cubic-bezier(.22, 1, .36, 1),
      box-shadow 200ms ease,
      visibility 0s linear 0s;
  }

  .workspace-menu-button [data-workspace-chevron] {
    display: inline-block;
    transform-origin: center;
    transition: transform 200ms cubic-bezier(.22, 1, .36, 1);
  }

  .workspace-menu-button[aria-expanded="true"] [data-workspace-chevron] {
    transform: rotate(180deg);
  }

  .workspace-group {
    min-width: 0;
    border-radius: .85rem;
    background: color-mix(in srgb, var(--koa-sand) 42%, white);
    padding: .65rem;
    opacity: 0;
    transform: translateY(-.2rem);
    transition:
      opacity 150ms ease,
      transform 190ms cubic-bezier(.22, 1, .36, 1);
  }

  .workspace-links[data-open="true"] .workspace-group {
    opacity: 1;
    transform: translateY(0);
  }

  .workspace-links[data-open="true"] .workspace-group:nth-child(1) { transition-delay: 20ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(2) { transition-delay: 35ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(3) { transition-delay: 50ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(4) { transition-delay: 65ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(5) { transition-delay: 80ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(6) { transition-delay: 95ms; }

  .workspace-group-title {
    padding: 0 .3rem .45rem;
    color: var(--koa-clay);
    font-size: .52rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .workspace-group-links {
    display: grid;
    gap: .35rem;
  }

  .workspace-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    background: white;
    padding: .68rem .75rem;
    color: var(--koa-forest);
  }

  .workspace-nav-link:hover,
  .workspace-signout:hover {
    border-color: color-mix(in srgb, var(--koa-forest) 45%, var(--koa-line));
    background: var(--koa-sand);
  }

  .workspace-nav-home {
    background: var(--koa-forest);
    border-color: var(--koa-forest);
    color: white;
  }

  .workspace-nav-link[aria-current="page"] {
    background: var(--koa-clay);
    border-color: var(--koa-clay);
    color: white;
  }

  .workspace-total-badge,
  .workspace-link-badge,
  .workspace-desktop-alert {
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    font-weight: 900;
    letter-spacing: 0;
  }

  .workspace-total-badge {
    min-width: 1.15rem;
    height: 1.15rem;
    background: white;
    color: var(--koa-clay);
    padding: 0 .3rem;
    font-size: .58rem;
  }

  .workspace-link-badge {
    min-width: 1.15rem;
    height: 1.15rem;
    background: var(--koa-clay);
    color: white;
    padding: 0 .3rem;
    font-size: .55rem;
  }

  .workspace-link-badge[data-severity="urgent"],
  .workspace-total-badge[data-severity="urgent"] {
    background: rgb(185 28 28);
    color: white;
  }

  .workspace-link-badge[data-severity="upcoming"],
  .workspace-total-badge[data-severity="upcoming"] {
    background: rgb(180 83 9);
    color: white;
  }

  .workspace-link-badge[data-severity="info"],
  .workspace-total-badge[data-severity="info"] {
    background: rgb(29 78 216);
    color: white;
  }

  .workspace-nav-link[aria-current="page"] .workspace-link-badge {
    background: white;
    color: var(--koa-clay);
  }

  .workspace-desktop-actions {
    min-height: 2.2rem;
    align-items: center;
    gap: .3rem;
    border: 1px solid color-mix(in srgb, var(--koa-forest) 24%, var(--koa-line));
    border-radius: 9999px;
    background: white;
    padding: .32rem .42rem .32rem .62rem;
    color: var(--koa-forest);
    text-decoration: none;
  }

  .workspace-desktop-actions[aria-current="page"] {
    border-color: var(--koa-forest);
    background: color-mix(in srgb, var(--koa-forest) 8%, white);
  }

  .workspace-desktop-actions-label {
    font-size: .55rem;
    font-weight: 900;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .workspace-desktop-action-chip {
    display: inline-flex;
    min-width: 1.7rem;
    height: 1.35rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    padding: 0 .36rem;
    font-size: .52rem;
    font-weight: 900;
    letter-spacing: .02em;
  }

  .workspace-desktop-action-chip[data-severity="urgent"] { background: rgb(254 226 226); color: rgb(185 28 28); }
  .workspace-desktop-action-chip[data-severity="upcoming"] { background: rgb(254 243 199); color: rgb(180 83 9); }
  .workspace-desktop-action-chip[data-severity="new"] { background: rgb(219 234 254); color: rgb(29 78 216); }

  .workspace-desktop-alert {
    border: 1px solid color-mix(in srgb, var(--koa-clay) 35%, var(--koa-line));
    background: color-mix(in srgb, var(--koa-clay) 10%, white);
    color: var(--koa-clay);
    padding: .52rem .7rem;
    font-size: .58rem;
    text-transform: uppercase;
  }

  .workspace-alert-center {
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    border: 0 solid var(--koa-line);
    border-radius: 1rem;
    background: white;
    padding: 0 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-.3rem) scale(.997);
    box-shadow: none;
    transition:
      max-height 240ms cubic-bezier(.22, 1, .36, 1),
      margin-top 220ms ease,
      padding 220ms ease,
      border-width 180ms ease,
      opacity 160ms ease,
      transform 220ms cubic-bezier(.22, 1, .36, 1),
      box-shadow 180ms ease,
      visibility 0s linear 240ms;
    will-change: max-height, opacity, transform;
  }

  .workspace-alert-center[data-open="true"] {
    max-height: 72vh;
    margin-top: .7rem;
    overflow-y: auto;
    border-width: 1px;
    padding: 1rem;
    opacity: 1;
