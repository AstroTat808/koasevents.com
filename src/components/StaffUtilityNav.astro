---
const isAdminWorkspace = Astro.url.pathname.startsWith('/admin/');
---

<nav
  data-workspace-nav
  class="hidden sticky top-0 z-50 border-b border-[var(--koa-line)] bg-white/95 shadow-sm backdrop-blur"
  aria-label="Koa’s workspace navigation"
>
  <div class="container-shell py-2.5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-2">
        <button
          data-workspace-toggle
          type="button"
          class="workspace-menu-button"
          aria-expanded="false"
          aria-controls="koa-workspace-links"
        >
          <span>Workspace</span>
          <span data-workspace-chevron aria-hidden="true">⌄</span>
        </button>
        <button
          data-workspace-alert-toggle-mobile
          type="button"
          class="hidden workspace-mobile-alert md:hidden"
          aria-expanded="false"
          aria-controls="koa-workspace-alert-center"
          aria-label="Open workspace alerts"
        >
          <span data-workspace-total class="workspace-total-badge"></span>
        </button>

        <span
          data-workspace-role
          class="hidden shrink-0 rounded-full bg-[var(--koa-sand)] px-3 py-2 text-[.58rem] font-black uppercase tracking-[.08em] text-[var(--koa-clay)] sm:inline-flex"
        ></span>
      </div>

      <div class="flex min-w-0 items-center gap-2">
        <span data-workspace-user class="truncate text-xs font-semibold text-[var(--koa-ink)]/65"></span>
        <button data-workspace-alert-toggle type="button" class="hidden workspace-desktop-alert md:inline-flex" aria-expanded="false" aria-controls="koa-workspace-alert-center"></button>
        <button data-workspace-logout type="button" class="workspace-signout">Sign out</button>
      </div>
    </div>

    <section id="koa-workspace-alert-center" data-workspace-alert-center data-open="false" class="workspace-alert-center" aria-label="Workspace alerts">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="workspace-group-title">Alert Center</p>
          <h2 class="display text-2xl text-[var(--koa-forest)]">Items needing attention</h2>
          <p data-workspace-alert-summary class="mt-1 text-xs text-[var(--koa-ink)]/55"></p>
        </div>
        <button data-workspace-alert-close type="button" class="workspace-alert-close">Close</button>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <button data-alert-tab="active" type="button" class="workspace-alert-tab" aria-pressed="true">Active <span data-alert-tab-count="active"></span></button>
        <button data-alert-tab="snoozed" type="button" class="workspace-alert-tab" aria-pressed="false">Snoozed <span data-alert-tab-count="snoozed"></span></button>
        <button data-alert-tab="dismissed" type="button" class="workspace-alert-tab" aria-pressed="false">Dismissed <span data-alert-tab-count="dismissed"></span></button>
        <button data-alert-tab="history" type="button" class="workspace-alert-tab" aria-pressed="false">History</button>
      </div>

      <div data-workspace-alert-list class="mt-4 grid gap-2"></div>
    </section>

    <div
      id="koa-workspace-links"
      data-workspace-links
      data-open="false"
      class="workspace-links grid-cols-1 gap-3 rounded-[1rem] bg-white md:grid-cols-2 lg:grid-cols-6"
    >
      <section data-mobile-nav-settings class="workspace-mobile-nav-settings">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="workspace-group-title">Mobile navigation</p>
            <p class="px-1 text-xs leading-5 text-[var(--koa-ink)]/55">Choose the four modules shown next to More on this account.</p>
          </div>
          <button data-mobile-nav-edit type="button" class="workspace-alert-action">Customize</button>
        </div>
        <div data-mobile-nav-editor class="mt-3 hidden">
          <div data-mobile-nav-selects class="grid gap-2"></div>
          <div class="mt-3 flex items-center gap-2">
            <button data-mobile-nav-save type="button" class="workspace-alert-action">Save</button>
            <span data-mobile-nav-message class="text-xs text-[var(--koa-ink)]/50"></span>
          </div>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Home</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="admin.dashboard.view" href="/admin/" class="workspace-nav-link">Admin Home</a>
          <a data-workspace-link href="/admin/actions/" class="workspace-nav-link">
            <span>Action Center</span><span data-link-alert="actionCenter" class="hidden workspace-link-badge"></span>
          </a>
          <a data-workspace-link href="/staff/" class="workspace-nav-link workspace-nav-home">Staff Home</a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Sales</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="crm.view" href="/admin/crm/" class="workspace-nav-link">
            <span>Business CRM</span><span data-link-alert="overdueTasks" class="hidden workspace-link-badge"></span>
          </a>
          <a data-workspace-link data-capability="sales.view" href="/admin/quotes/" class="workspace-nav-link">Sales CRM</a>
          <a data-workspace-link data-capability="sales.profit_settings" href="/admin/profitability/" class="workspace-nav-link">Wedding Profitability</a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Operations</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="events.view" href="/admin/events/" class="workspace-nav-link">Event Ops</a>
          <a data-workspace-link data-capability="calendar.view" href="/admin/calendar/" class="workspace-nav-link">Master Calendar</a>
          <a data-workspace-link data-capability="vendors.view" href="/admin/vendors/" class="workspace-nav-link">Vendor CRM</a>
          <a data-workspace-link data-capability="insurance.view" href="/admin/insurance/" class="workspace-nav-link">
            <span>Insurance</span><span data-link-alert="vendorInsurance" class="hidden workspace-link-badge"></span>
          </a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Content</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="blog.view" href="/admin/blog/" class="workspace-nav-link">Blog</a>
          <a data-workspace-link data-capability="gallery.view" href="/admin/gallery/" class="workspace-nav-link">Gallery</a>
          <a data-workspace-link data-capability="seo.view" href="/admin/seo/" class="workspace-nav-link">Local SEO</a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Accounting</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="quickbooks.view" href="/admin/quickbooks/" class="workspace-nav-link">
            <span>QuickBooks</span><span data-link-alert="accountingMismatches" class="hidden workspace-link-badge"></span>
          </a>
        </div>
      </section>

      <section data-workspace-group class="workspace-group">
        <p class="workspace-group-title">Administration</p>
        <div class="workspace-group-links">
          <a data-workspace-link data-capability="security.view" href="/admin/security/" class="workspace-nav-link">Security</a>
          <a data-workspace-link data-capability="health.view" href="/admin/health/" class="workspace-nav-link">
            <span>System Health</span><span data-link-alert="healthWarnings" class="hidden workspace-link-badge"></span>
          </a>
          <a data-workspace-link data-capability="users.manage" href="/admin/staff/" class="workspace-nav-link">User Management</a>
        </div>
      </section>
    </div>
  </div>

  {isAdminWorkspace && (
    <div data-workspace-bottom-nav class="workspace-bottom-nav" aria-label="Mobile admin navigation">
      {[0,1,2,3].map((slot)=>(
        <a data-workspace-bottom-slot={slot} href="/admin/" class="workspace-bottom-item" aria-label="Admin module">
          <span class="workspace-bottom-icon-wrap">
            <svg data-mobile-slot-icon viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.75 12 3l9 7.75v9.5a.75.75 0 0 1-.75.75h-5.5v-6.5h-5.5V21h-5.5a.75.75 0 0 1-.75-.75z"/></svg>
            <span data-mobile-slot-badge class="workspace-bottom-badge hidden"></span>
          </span>
          <span data-mobile-slot-label>Home</span>
        </a>
      ))}
      <button data-workspace-more-toggle type="button" class="workspace-bottom-item" aria-expanded="false" aria-controls="koa-workspace-links" aria-label="More admin modules">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h.01M12 7h.01M19 7h.01M5 12h.01M12 12h.01M19 12h.01M5 17h.01M12 17h.01M19 17h.01"/></svg>
        <span>More</span>
      </button>
    </div>
  )}
</nav>

<style>
  .workspace-menu-button,
  .workspace-mobile-alert,
  .workspace-signout,
  .workspace-nav-link {
    border: 1px solid var(--koa-line);
    border-radius: 9999px;
    font-size: .6rem;
    font-weight: 900;
    letter-spacing: .08em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .workspace-menu-button {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    background: var(--koa-forest);
    border-color: var(--koa-forest);
    color: white;
    padding: .7rem .9rem;
  }

  .workspace-mobile-alert {
    align-items: center;
    justify-content: center;
    min-width: 2.35rem;
    min-height: 2.35rem;
    border-color: color-mix(in srgb, var(--koa-clay) 35%, var(--koa-line));
    background: white;
    color: var(--koa-clay);
    padding: .45rem;
  }

  .workspace-signout {
    flex: 0 0 auto;
    background: white;
    color: var(--koa-clay);
    padding: .55rem .75rem;
  }

  .workspace-links {
    display: grid;
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    padding: 0 .75rem;
    border: 0 solid var(--koa-line);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-.35rem) scale(.995);
    box-shadow: none;
    transition:
      max-height 240ms cubic-bezier(.22, 1, .36, 1),
      margin-top 220ms ease,
      padding 220ms ease,
      border-width 180ms ease,
      opacity 160ms ease,
      transform 220ms cubic-bezier(.22, 1, .36, 1),
      box-shadow 180ms ease,
      visibility 0s linear 240ms;
    will-change: max-height, opacity, transform;
  }

  .workspace-links[data-open="true"] {
    max-height: 72vh;
    margin-top: .5rem;
    overflow-y: auto;
    padding: .75rem;
    border-width: 1px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    box-shadow: var(--shadow-soft);
    transition:
      max-height 260ms cubic-bezier(.22, 1, .36, 1),
      margin-top 220ms ease,
      padding 220ms ease,
      border-width 180ms ease,
      opacity 180ms ease,
      transform 240ms cubic-bezier(.22, 1, .36, 1),
      box-shadow 200ms ease,
      visibility 0s linear 0s;
  }

  .workspace-menu-button [data-workspace-chevron] {
    display: inline-block;
    transform-origin: center;
    transition: transform 200ms cubic-bezier(.22, 1, .36, 1);
  }

  .workspace-menu-button[aria-expanded="true"] [data-workspace-chevron] {
    transform: rotate(180deg);
  }

  .workspace-group {
    min-width: 0;
    border-radius: .85rem;
    background: color-mix(in srgb, var(--koa-sand) 42%, white);
    padding: .65rem;
    opacity: 0;
    transform: translateY(-.2rem);
    transition:
      opacity 150ms ease,
      transform 190ms cubic-bezier(.22, 1, .36, 1);
  }

  .workspace-links[data-open="true"] .workspace-group {
    opacity: 1;
    transform: translateY(0);
  }

  .workspace-links[data-open="true"] .workspace-group:nth-child(1) { transition-delay: 20ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(2) { transition-delay: 35ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(3) { transition-delay: 50ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(4) { transition-delay: 65ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(5) { transition-delay: 80ms; }
  .workspace-links[data-open="true"] .workspace-group:nth-child(6) { transition-delay: 95ms; }

  .workspace-group-title {
    padding: 0 .3rem .45rem;
    color: var(--koa-clay);
    font-size: .52rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .workspace-group-links {
    display: grid;
    gap: .35rem;
  }

  .workspace-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    background: white;
    padding: .68rem .75rem;
    color: var(--koa-forest);
  }

  .workspace-nav-link:hover,
  .workspace-signout:hover {
    border-color: color-mix(in srgb, var(--koa-forest) 45%, var(--koa-line));
    background: var(--koa-sand);
  }

  .workspace-nav-home {
    background: var(--koa-forest);
    border-color: var(--koa-forest);
    color: white;
  }

  .workspace-nav-link[aria-current="page"] {
    background: var(--koa-clay);
    border-color: var(--koa-clay);
    color: white;
  }

  .workspace-total-badge,
  .workspace-link-badge,
  .workspace-desktop-alert {
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    font-weight: 900;
    letter-spacing: 0;
  }

  .workspace-total-badge {
    min-width: 1.15rem;
    height: 1.15rem;
    background: white;
    color: var(--koa-clay);
    padding: 0 .3rem;
    font-size: .58rem;
  }

  .workspace-link-badge {
    min-width: 1.15rem;
    height: 1.15rem;
    background: var(--koa-clay);
    color: white;
    padding: 0 .3rem;
    font-size: .55rem;
  }

  .workspace-link-badge[data-severity="urgent"],
  .workspace-total-badge[data-severity="urgent"] {
    background: rgb(185 28 28);
    color: white;
  }

  .workspace-link-badge[data-severity="upcoming"],
  .workspace-total-badge[data-severity="upcoming"] {
    background: rgb(180 83 9);
    color: white;
  }

  .workspace-link-badge[data-severity="info"],
  .workspace-total-badge[data-severity="info"] {
    background: rgb(29 78 216);
    color: white;
  }

  .workspace-nav-link[aria-current="page"] .workspace-link-badge {
    background: white;
    color: var(--koa-clay);
  }

  .workspace-desktop-alert {
    border: 1px solid color-mix(in srgb, var(--koa-clay) 35%, var(--koa-line));
    background: color-mix(in srgb, var(--koa-clay) 10%, white);
    color: var(--koa-clay);
    padding: .52rem .7rem;
    font-size: .58rem;
    text-transform: uppercase;
  }

  .workspace-alert-center {
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    border: 0 solid var(--koa-line);
    border-radius: 1rem;
    background: white;
    padding: 0 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-.3rem) scale(.997);
    box-shadow: none;
    transition:
      max-height 240ms cubic-bezier(.22, 1, .36, 1),
      margin-top 220ms ease,
      padding 220ms ease,
      border-width 180ms ease,
      opacity 160ms ease,
      transform 220ms cubic-bezier(.22, 1, .36, 1),
      box-shadow 180ms ease,
      visibility 0s linear 240ms;
    will-change: max-height, opacity, transform;
  }

  .workspace-alert-center[data-open="true"] {
    max-height: 72vh;
    margin-top: .7rem;
    overflow-y: auto;
    border-width: 1px;
    padding: 1rem;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    box-shadow: var(--shadow-soft);
    transition:
      max-height 260ms cubic-bezier(.22, 1, .36, 1),
      margin-top 220ms ease,
      padding 220ms ease,
      border-width 180ms ease,
      opacity 180ms ease,
      transform 240ms cubic-bezier(.22, 1, .36, 1),
      box-shadow 200ms ease,
      visibility 0s linear 0s;
  }

  .workspace-alert-close {
    border: 1px solid var(--koa-line);
    border-radius: 9999px;
    padding: .5rem .7rem;
    color: var(--koa-clay);
    font-size: .55rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .workspace-alert-tab,
  .workspace-alert-action {
    border: 1px solid var(--koa-line);
    border-radius: 9999px;
    background: white;
    padding: .45rem .65rem;
    color: var(--koa-forest);
    font-size: .52rem;
    font-weight: 900;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .workspace-alert-tab[aria-pressed="true"] {
    border-color: var(--koa-forest);
    background: var(--koa-forest);
    color: white;
  }

  .workspace-alert-new {
    display: inline-flex;
    border-radius: 9999px;
    background: rgb(220 38 38);
    padding: .25rem .45rem;
    color: white;
    font-size: .5rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .workspace-alert-actions {
    margin-top: .65rem;
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
  }

  .workspace-alert-history {
    border-left: 3px solid var(--koa-line);
    padding-left: .75rem;
  }

  .workspace-alert-row {
    display: block;
    border: 1px solid var(--koa-line);
    border-radius: .85rem;
    padding: .75rem;
    background: white;
  }

  .workspace-alert-row[data-severity="urgent"] {
    border-color: rgb(254 202 202);
    background: rgb(254 242 242);
  }

  .workspace-alert-row[data-severity="upcoming"] {
    border-color: rgb(253 230 138);
    background: rgb(255 251 235);
  }

  .workspace-alert-row[data-severity="info"] {
    border-color: rgb(191 219 254);
    background: rgb(239 246 255);
  }

  .workspace-alert-severity {
    display: inline-flex;
    border-radius: 9999px;
    padding: .25rem .45rem;
    font-size: .5rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .workspace-alert-severity[data-severity="urgent"] { background: rgb(254 226 226); color: rgb(185 28 28); }
  .workspace-alert-severity[data-severity="upcoming"] { background: rgb(254 243 199); color: rgb(180 83 9); }
  .workspace-alert-severity[data-severity="info"] { background: rgb(219 234 254); color: rgb(29 78 216); }


  .workspace-bottom-nav {
    display: none;
  }

  .workspace-mobile-nav-settings {
    display: none;
  }

  @keyframes koaHealthBadgePulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(185,28,28,0); }
    45% { transform: scale(1.06); box-shadow: 0 0 0 .28rem rgba(185,28,28,.13); }
  }

  .workspace-bottom-item.workspace-health-pulse .workspace-bottom-badge {
    animation: koaHealthBadgePulse 1.8s ease-in-out infinite;
  }

  .workspace-bottom-item {
    position: relative;
    min-width: 0;
    border: 0;
    background: transparent;
    color: color-mix(in srgb, var(--koa-forest) 72%, white);
    font: inherit;
    text-decoration: none;
  }

  .workspace-bottom-item svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .workspace-bottom-icon-wrap {
    position: relative;
    display: inline-grid;
    place-items: center;
  }

  .workspace-bottom-badge[data-severity="upcoming"] {
    background: rgb(217 119 6);
  }

  .workspace-bottom-badge[data-severity="urgent"] {
    background: rgb(185 28 28);
  }

  .workspace-bottom-badge[data-severity="info"] {
    background: rgb(29 78 216);
  }

  .workspace-bottom-badge {
    position: absolute;
    top: -.4rem;
    right: -.65rem;
    min-width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    background: rgb(185 28 28);
    color: white;
    padding: 0 .25rem;
    font-size: .5rem;
    font-weight: 900;
    line-height: 1rem;
    text-align: center;
  }

  @media (max-width: 767px) {

    .workspace-mobile-nav-settings {
      display: block;
      border: 1px solid color-mix(in srgb, var(--koa-line) 72%, transparent);
      border-radius: .8rem;
      background: color-mix(in srgb, var(--koa-sand) 42%, white);
      padding: .55rem;
    }

    .workspace-mobile-nav-settings select {
      min-height: 2.65rem;
      width: 100%;
      border: 1px solid var(--koa-line);
      border-radius: .72rem;
      background: white;
      padding: .6rem .7rem;
      color: var(--koa-forest);
      font-size: .78rem;
      font-weight: 700;
    }

    .workspace-bottom-nav {
      position: fixed;
      left: .5rem;
      right: .5rem;
      bottom: max(.5rem, env(safe-area-inset-bottom));
      z-index: 80;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: .2rem;
      min-height: 4.35rem;
      padding: .38rem .35rem .42rem;
      border: 1px solid color-mix(in srgb, var(--koa-champagne) 46%, var(--koa-line));
      border-radius: 1.15rem;
      background: color-mix(in srgb, white 94%, var(--koa-ivory));
      box-shadow: 0 18px 50px rgba(7,30,23,.24);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .workspace-bottom-item {
      display: flex;
      min-height: 3.45rem;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: .24rem;
      border-radius: .85rem;
      padding: .35rem .12rem;
      color: color-mix(in srgb, var(--koa-forest) 72%, #718078);
      font-size: .56rem;
      font-weight: 850;
      letter-spacing: .025em;
      line-height: 1;
      text-transform: none;
      touch-action: manipulation;
    }

    .workspace-bottom-item[aria-current="page"],
    .workspace-bottom-item[aria-expanded="true"] {
      background: color-mix(in srgb, var(--koa-forest) 10%, white);
      color: var(--koa-forest);
    }

    .workspace-bottom-item[aria-current="page"]::before,
    .workspace-bottom-item[aria-expanded="true"]::before {
      content: "";
      position: absolute;
      top: .18rem;
      width: 1.25rem;
      height: 2px;
      border-radius: 999px;
      background: var(--koa-clay);
    }

    .workspace-bottom-item:active {
      transform: scale(.97);
    }

    .workspace-links[data-open="true"],
    .workspace-alert-center[data-open="true"] {
      position: fixed;
      left: .5rem;
      right: .5rem;
      bottom: calc(5.15rem + env(safe-area-inset-bottom));
      z-index: 75;
      max-height: min(72dvh, 42rem);
      margin: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-width: 1px;
      border-radius: 1.15rem;
      background: white;
      box-shadow: 0 20px 60px rgba(7,30,23,.28);
    }

    .workspace-links[data-open="true"] {
      padding: .55rem;
    }

    .workspace-alert-center[data-open="true"] {
      padding: .85rem;
    }

    [data-workspace-nav] > .container-shell {
      width: calc(100% - .65rem);
      padding-top: .35rem;
      padding-bottom: .35rem;
    }

    [data-workspace-nav] > .container-shell > div:first-child {
      gap: .4rem;
    }

    [data-workspace-user] {
      display: none;
    }

    .workspace-menu-button,
    .workspace-mobile-alert,
    .workspace-signout {
      min-height: 2.75rem;
    }

    .workspace-menu-button {
      padding: .75rem .9rem;
      font-size: .64rem;
    }

    .workspace-mobile-alert {
      display: inline-flex;
      min-width: 2.75rem;
      min-height: 2.75rem;
    }

    .workspace-signout {
      padding: .7rem .8rem;
      font-size: .58rem;
    }

    .workspace-links[data-open="true"] {
      max-height: calc(100dvh - 4.65rem);
      margin-top: .35rem;
      padding: .5rem;
      border-radius: .9rem;
      overscroll-behavior: contain;
    }

    .workspace-group {
      border: 1px solid color-mix(in srgb, var(--koa-line) 72%, transparent);
      border-radius: .8rem;
      padding: .5rem;
    }

    .workspace-group-title {
      padding: .1rem .25rem .4rem;
      font-size: .55rem;
    }

    .workspace-group-links {
      gap: .3rem;
    }

    .workspace-nav-link {
      min-height: 2.75rem;
      border-radius: .7rem;
      padding: .72rem .78rem;
      font-size: .64rem;
      letter-spacing: .06em;
      line-height: 1.2;
      white-space: normal;
    }

    .workspace-alert-center[data-open="true"] {
      max-height: calc(100dvh - 4.65rem);
      margin-top: .35rem;
      padding: .8rem;
      border-radius: .9rem;
      overscroll-behavior: contain;
    }

    .workspace-alert-center h2 {
      font-size: 1.65rem;
      line-height: 1.05;
    }

    .workspace-alert-close,
    .workspace-alert-tab,
    .workspace-alert-action {
      min-height: 2.5rem;
    }

    .workspace-alert-row {
      padding: .75rem;
    }
  }

  @media (min-width: 768px) {
    .workspace-links[data-open="true"] {
      max-height: 40rem;
      margin-top: .75rem;
    }

    [data-workspace-nav] > .container-shell > div:first-child {
      min-height: 2.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .workspace-links,
    .workspace-links[data-open="true"],
    .workspace-alert-center,
    .workspace-alert-center[data-open="true"],
    .workspace-group,
    .workspace-links[data-open="true"] .workspace-group,
    .workspace-menu-button [data-workspace-chevron] {
      transition: none;
      transition-delay: 0s;
    }
  }
</style>

<script>
  import { logout } from '@netlify/identity';
  import { getAdminSession } from '../lib/admin-session';

  const nav = document.querySelector('[data-workspace-nav]');
  const links = nav?.querySelector('[data-workspace-links]');
  const toggle = nav?.querySelector('[data-workspace-toggle]');

  function normalizedPath(value) {
    const path = String(value || '/').split('?')[0].split('#')[0];
    return path.endsWith('/') ? path : path + '/';
  }

  function roleLabel(role) {
    const labels = {
      admin: 'Administrator',
      manager: 'Manager',
      sales: 'Sales Rep',
      event_coordinator: 'Event Coordinator',
      vendor_manager: 'Vendor Manager',
      content_editor: 'Content Editor',
      accounting: 'Accounting',
      read_only: 'Read Only',
      custom: 'Custom Role',
    };
    return labels[role] || String(role || 'Staff').replaceAll('_', ' ');
  }

  function badgeText(value) {
    const count = Math.max(0, Number(value || 0));
    return count > 99 ? '99+' : String(count);
  }

  function highestSeverity(alerts) {
    const rows = Array.isArray(alerts) ? alerts : [];
    if (rows.some((row) => row?.severity === 'urgent')) return 'urgent';
    if (rows.some((row) => row?.severity === 'upcoming')) return 'upcoming';
    return rows.length ? 'info' : '';
  }

  function setMenu(open, persist = true) {
    if (!(links instanceof HTMLElement) || !(toggle instanceof HTMLElement)) return;
    links.dataset.open = open ? 'true' : 'false';
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    nav?.querySelector('[data-workspace-more-toggle]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
    const chevron = toggle.querySelector('[data-workspace-chevron]');
    if (chevron) chevron.textContent = '⌄';
    if (persist) {
      try { window.localStorage.setItem('koa-workspace-nav-open', open ? '1' : '0'); } catch {}
    }
  }

  function setAlertCenter(open) {
    const center = nav?.querySelector('[data-workspace-alert-center]');
    if (!(center instanceof HTMLElement)) return;
    center.dataset.open = open ? 'true' : 'false';
    nav?.querySelector('[data-workspace-alert-toggle]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
    nav?.querySelector('[data-workspace-alert-toggle-mobile]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
    nav?.querySelector('[data-workspace-alert-toggle-bottom]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function initializeMenuState() {
    let saved = null;
    try { saved = window.localStorage.getItem('koa-workspace-nav-open'); } catch {}
    setMenu(saved == null ? false : saved === '1', false);
  }

  function updateGroupVisibility() {
    nav?.querySelectorAll('[data-workspace-group]').forEach((group) => {
      if (!(group instanceof HTMLElement)) return;
      const visibleLinks = [...group.querySelectorAll('[data-workspace-link]')]
        .some((node) => node instanceof HTMLElement && !node.classList.contains('hidden'));
      group.classList.toggle('hidden', !visibleLinks);
    });
  }

  let alertPayload = null;
  let alertTab = 'active';
  let deployWarningPoll = null;
  let currentMobileNav = ['home','crm','calendar','health'];
  let currentCapabilities = new Set();

  const mobileNavDefinitions = {
    home:{label:'Home',href:'/admin/',capability:'admin.dashboard.view',icon:'M3 10.75 12 3l9 7.75v9.5a.75.75 0 0 1-.75.75h-5.5v-6.5h-5.5V21h-5.5a.75.75 0 0 1-.75-.75z'},
    actions:{label:'Actions',href:'/admin/actions/',capability:'',icon:'M5 4h14v16H5zM8 8h8M8 12h8M8 16h5'},
    crm:{label:'CRM',href:'/admin/crm/',capability:'crm.view',icon:'M4 4.75A1.75 1.75 0 0 1 5.75 3h12.5A1.75 1.75 0 0 1 20 4.75v14.5A1.75 1.75 0 0 1 18.25 21H5.75A1.75 1.75 0 0 1 4 19.25zM7 8h10M7 12h10M7 16h6'},
    sales:{label:'Sales',href:'/admin/quotes/',capability:'sales.view',icon:'M4 19V5M4 19h16M8 15l3-4 3 2 5-7'},
    events:{label:'Events',href:'/admin/events/',capability:'events.view',icon:'M5 5h14v14H5zM8 3v4M16 3v4M5 9h14'},
    calendar:{label:'Calendar',href:'/admin/calendar/',capability:'calendar.view',icon:'M5 4.5h14A2 2 0 0 1 21 6.5v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2ZM7 2v5M17 2v5M3 9h18'},
    quickbooks:{label:'Books',href:'/admin/quickbooks/',capability:'quickbooks.view',icon:'M4 5h16v14H4zM8 9h8M8 13h3M14 13h2M8 16h8'},
    health:{label:'Health',href:'/admin/health/',capability:'health.view',icon:'M3 12h4l2-5 4 10 2-5h6'},
    staff:{label:'Staff',href:'/admin/staff/',capability:'users.manage',icon:'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3 20v-2a5 5 0 0 1 10 0v2M17 10a2.5 2.5 0 1 0 0-5M15 20v-2a4 4 0 0 1 6 0v2'},
    vendors:{label:'Vendors',href:'/admin/vendors/',capability:'vendors.view',icon:'M4 8h16v11H4zM7 8V5h10v3M8 12h8'},
    insurance:{label:'Insurance',href:'/admin/insurance/',capability:'insurance.view',icon:'M12 3 20 6v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6zM9 12l2 2 4-5'},
    profitability:{label:'Profit',href:'/admin/profitability/',capability:'sales.profit_settings',icon:'M4 18 9 12l4 3 7-9M15 6h5v5'},
    gallery:{label:'Gallery',href:'/admin/gallery/',capability:'gallery.view',icon:'M4 5h16v14H4zM7 15l3-3 3 2 3-4 3 5M9 9h.01'},
  };

  function allowedMobileNavDefinitions(){
    return Object.entries(mobileNavDefinitions).filter(([,definition])=>!definition.capability||currentCapabilities.has(definition.capability));
  }

  function normalizeMobileNav(items){
    const requested=Array.isArray(items)?items.map(String):[];
    const allowedIds=new Set(allowedMobileNavDefinitions().map(([id])=>id));
    const out=[];
    for(const id of [...requested,'home','crm','calendar','health','actions','sales','events','quickbooks','staff','vendors','insurance','profitability','gallery']){
      if(!allowedIds.has(id)||out.includes(id))continue;
      out.push(id);
      if(out.length===4)break;
    }
    return out;
  }

  function applyMobileNav(items){
    currentMobileNav=normalizeMobileNav(items);
    const currentPath=normalizedPath(window.location.pathname);
    nav?.querySelectorAll('[data-workspace-bottom-slot]').forEach((slot,index)=>{
      if(!(slot instanceof HTMLAnchorElement))return;
      const id=currentMobileNav[index];
      const definition=mobileNavDefinitions[id];
      if(!definition){slot.classList.add('hidden');return;}
      slot.classList.remove('hidden');
      slot.dataset.mobileSlotId=id;
      slot.href=definition.href;
      slot.setAttribute('aria-label',definition.label);
      const label=slot.querySelector('[data-mobile-slot-label]');
      if(label)label.textContent=definition.label;
      const path=slot.querySelector('[data-mobile-slot-icon] path');
      if(path)path.setAttribute('d',definition.icon);
      if(currentPath===normalizedPath(definition.href))slot.setAttribute('aria-current','page');
      else slot.removeAttribute('aria-current');
      slot.classList.remove('workspace-health-pulse');
      const badge=slot.querySelector('[data-mobile-slot-badge]');
      if(badge instanceof HTMLElement){badge.textContent='';badge.classList.add('hidden');badge.removeAttribute('data-severity');}
    });
    renderMobileNavEditor();
    if(alertPayload)renderMobileSlotBadges(alertPayload);
  }

  function renderMobileNavEditor(){
    const wrap=nav?.querySelector('[data-mobile-nav-selects]');
    if(!(wrap instanceof HTMLElement))return;
    wrap.innerHTML='';
    const definitions=allowedMobileNavDefinitions();
    for(let index=0;index<4;index+=1){
      const label=document.createElement('label');
      label.className='grid gap-1 text-[.58rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]';
      label.textContent='Slot '+(index+1);
      const select=document.createElement('select');
      select.dataset.mobileNavSlotSelect=String(index);
      for(const [id,definition] of definitions){
        const option=document.createElement('option');
        option.value=id;option.textContent=definition.label;select.appendChild(option);
      }
      select.value=currentMobileNav[index]||definitions[index]?.[0]||'';
      label.appendChild(select);wrap.appendChild(label);
    }
  }

  function categoryBadgeCount(payload,id){
    const map={
      actions:Number(payload?.total||0),
      crm:Number(payload?.items?.overdueTasks?.count||0),
      sales:Number(payload?.items?.unansweredLeads?.count||0),
      quickbooks:Number(payload?.items?.accountingMismatches?.count||0),
      health:Number(payload?.items?.healthWarnings?.count||0),
      insurance:Number(payload?.items?.vendorInsurance?.count||0),
      staff:Number(payload?.items?.securityWarnings?.count||0),
    };
    return Math.max(0,Number(map[id]||0));
  }

  function categorySeverity(payload,id){
    const map={
      actions:payload?.alerts||[],
      crm:payload?.items?.overdueTasks?.alerts||[],
      sales:payload?.items?.unansweredLeads?.alerts||[],
      quickbooks:payload?.items?.accountingMismatches?.alerts||[],
      health:payload?.items?.healthWarnings?.alerts||[],
      insurance:payload?.items?.vendorInsurance?.alerts||[],
      staff:payload?.items?.securityWarnings?.alerts||[],
    };
    return highestSeverity(map[id]||[]);
  }

  function renderMobileSlotBadges(payload){
    nav?.querySelectorAll('[data-workspace-bottom-slot]').forEach((slot)=>{
      if(!(slot instanceof HTMLAnchorElement))return;
      const id=String(slot.dataset.mobileSlotId||'');
      const badge=slot.querySelector('[data-mobile-slot-badge]');
      if(!(badge instanceof HTMLElement))return;
      const count=categoryBadgeCount(payload,id);
      const severity=categorySeverity(payload,id);
      badge.textContent=badgeText(count);
      if(severity)badge.dataset.severity=severity;
      else badge.removeAttribute('data-severity');
      badge.classList.toggle('hidden',count<=0);
      const newCriticalHealth=id==='health'&&(payload?.items?.healthWarnings?.alerts||[]).some((alert)=>alert?.severity==='urgent'&&alert?.isNew);
      slot.classList.toggle('workspace-health-pulse',Boolean(newCriticalHealth));
      if(newCriticalHealth)slot.title='New critical System Health problem';
    });
  }

  async function loadMobileNavPreferences(){
    try{
      const response=await fetch('/api/account/profile',{cache:'no-store'});
      if(!response.ok){applyMobileNav(currentMobileNav);return;}
      const profile=await response.json();
      applyMobileNav(profile?.mobileNav);
    }catch{applyMobileNav(currentMobileNav);}
  }

  async function saveMobileNavPreferences(){
    const message=nav?.querySelector('[data-mobile-nav-message]');
    const values=[...nav?.querySelectorAll('[data-mobile-nav-slot-select]')||[]]
      .map((node)=>node instanceof HTMLSelectElement?node.value:'')
      .filter(Boolean);
    if(new Set(values).size!==4){
      if(message)message.textContent='Choose four different modules.';
      return;
    }
    if(message)message.textContent='Saving…';
    try{
      const response=await fetch('/api/account/profile',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({action:'save-mobile-nav',mobileNav:values}),
      });
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(data.error||'Unable to save mobile navigation.');
      applyMobileNav(data.mobileNav||values);
      if(message)message.textContent='Saved for this account.';
    }catch(error){
      if(message)message.textContent=error instanceof Error?error.message:'Unable to save mobile navigation.';
    }
  }

  function updateDeployWarningPoll(payload) {
    const hasYellowDeployWarning = (payload?.alerts || []).some((alert) =>
      alert?.id === 'health:netlify-github-sync' && alert?.severity === 'upcoming'
    );
    if (hasYellowDeployWarning && !deployWarningPoll) {
      deployWarningPoll = window.setInterval(() => {
        if (document.visibilityState === 'visible') loadAlerts();
      }, 60000);
    } else if (!hasYellowDeployWarning && deployWarningPoll) {
      window.clearInterval(deployWarningPoll);
      deployWarningPoll = null;
    }
  }

  function formatAlertTime(value) {
    const ms = Date.parse(String(value || ''));
    if (!Number.isFinite(ms)) return '';
    return new Intl.DateTimeFormat('en-US',{
      timeZone:'Pacific/Honolulu',
      month:'short',day:'numeric',year:'numeric',
      hour:'numeric',minute:'2-digit'
    }).format(new Date(ms));
  }

  async function alertAction(action, extra = {}) {
    try {
      const response = await fetch('/api/admin/workspace-alerts',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({action,...extra}),
      });
      if (!response.ok) return false;
      await loadAlerts();
      return true;
    } catch {
      return false;
    }
  }

  async function markVisibleAlertsSeen() {
    const fresh = (alertPayload?.alerts || []).filter((alert)=>alert.isNew).map((alert)=>alert.occurrenceId);
    if (!fresh.length) return;
    try {
      await fetch('/api/admin/workspace-alerts',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({action:'mark-seen',occurrenceIds:fresh}),
      });
    } catch {}
  }

  function actionButton(label, onClick) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'workspace-alert-action';
    button.textContent = label;
    button.addEventListener('click',(event)=>{
      event.preventDefault();
      event.stopPropagation();
      onClick(button);
    });
    return button;
  }

  function activeAlertRow(alert) {
    const row = document.createElement('article');
    row.className = 'workspace-alert-row';
    row.dataset.severity = alert.severity || 'info';

    const top = document.createElement('div');
    top.className = 'flex flex-wrap items-center justify-between gap-2';

    const left = document.createElement('div');
    left.className = 'flex flex-wrap items-center gap-2';

    const title = document.createElement('strong');
    title.className = 'text-sm text-[var(--koa-forest)]';
    title.textContent = alert.title || 'Workspace alert';

    if (alert.isNew) {
      const fresh = document.createElement('span');
      fresh.className = 'workspace-alert-new';
      fresh.textContent = 'New';
      left.appendChild(fresh);
    }
    left.prepend(title);

    const sev = document.createElement('span');
    sev.className = 'workspace-alert-severity';
    sev.dataset.severity = alert.severity || 'info';
    sev.textContent = alert.severity === 'urgent' ? 'Urgent' : alert.severity === 'upcoming' ? 'Upcoming' : 'Info';

    const context = document.createElement('p');
    context.className = 'mt-1 text-xs font-semibold text-[var(--koa-ink)]/65';
    context.textContent = alert.context || '';

    const detail = document.createElement('p');
    detail.className = 'mt-1 text-xs leading-5 text-[var(--koa-ink)]/52';
    detail.textContent = alert.detail || '';

    const meta = document.createElement('p');
    meta.className = 'mt-1 text-[.62rem] text-[var(--koa-ink)]/40';
    meta.textContent = 'First appeared ' + formatAlertTime(alert.firstAppearedAt);

    const actions = document.createElement('div');
    actions.className = 'workspace-alert-actions';

    const open = document.createElement('a');
    open.href = alert.href || '#';
    open.className = 'workspace-alert-action';
    open.textContent = 'Open item';

    if (alert.isNew) {
      actions.appendChild(actionButton('Mark seen', async(button)=>{
        button.disabled = true;
        await alertAction('mark-seen',{occurrenceIds:[alert.occurrenceId]});
      }));
    }

    actions.appendChild(actionButton('Tomorrow', async(button)=>{
      button.disabled = true;
      await alertAction('snooze',{occurrenceId:alert.occurrenceId,preset:'tomorrow'});
    }));
    actions.appendChild(actionButton('Next week', async(button)=>{
      button.disabled = true;
      await alertAction('snooze',{occurrenceId:alert.occurrenceId,preset:'week'});
    }));
    actions.appendChild(actionButton('Custom date', async(button)=>{
      const raw = window.prompt('Snooze until what date? Use YYYY-MM-DD.');
      if (!raw) return;
      button.disabled = true;
      const ok = await alertAction('snooze',{occurrenceId:alert.occurrenceId,date:raw});
      if (!ok) button.disabled = false;
    }));
    actions.appendChild(actionButton('Dismiss', async(button)=>{
      button.disabled = true;
      await alertAction('dismiss',{occurrenceId:alert.occurrenceId});
    }));
    actions.appendChild(open);

    top.append(left,sev);
    row.append(top,context,detail,meta,actions);
    return row;
  }

  function snoozedAlertRow(alert) {
    const row = activeAlertRow(alert);
    const actions = row.querySelector('.workspace-alert-actions');
    if (actions) {
      actions.innerHTML = '';
      actions.appendChild(actionButton('Restore now', async(button)=>{
        button.disabled = true;
        await alertAction('unsnooze',{occurrenceId:alert.occurrenceId});
      }));
      const until = document.createElement('span');
      until.className = 'self-center text-xs text-[var(--koa-ink)]/50';
      until.textContent = 'Snoozed until ' + formatAlertTime(alert.snoozedUntil);
      actions.appendChild(until);
    }
    return row;
  }

  function dismissedAlertRow(alert) {
    const row = activeAlertRow(alert);
    const actions = row.querySelector('.workspace-alert-actions');
    if (actions) {
      actions.innerHTML = '';
      actions.appendChild(actionButton('Restore', async(button)=>{
        button.disabled = true;
        await alertAction('restore-dismissed',{occurrenceId:alert.occurrenceId});
      }));
      const dismissed = document.createElement('span');
      dismissed.className = 'self-center text-xs text-[var(--koa-ink)]/50';
      dismissed.textContent = 'Dismissed ' + formatAlertTime(alert.dismissedAt);
      actions.appendChild(dismissed);
    }
    return row;
  }

  function historyAlertRow(alert) {
    const row = document.createElement('article');
    row.className = 'workspace-alert-row workspace-alert-history';
    row.dataset.severity = alert.severity || 'info';

    const top = document.createElement('div');
    top.className = 'flex flex-wrap items-center justify-between gap-2';
    const title = document.createElement('strong');
    title.className = 'text-sm text-[var(--koa-forest)]';
    title.textContent = alert.title || 'Workspace alert';

    const status = document.createElement('span');
    status.className = 'workspace-alert-severity';
    status.dataset.severity = alert.status === 'resolved' ? 'info' : alert.severity || 'info';
    status.textContent = alert.status === 'resolved' ? 'Resolved' : 'Active';

    const detail = document.createElement('p');
    detail.className = 'mt-2 text-xs leading-5 text-[var(--koa-ink)]/60';
    const parts = [
      'First appeared ' + formatAlertTime(alert.firstAppearedAt),
      alert.resolvedAt ? 'Resolved ' + formatAlertTime(alert.resolvedAt) : 'Last active ' + formatAlertTime(alert.lastSeenAt),
    ];
    detail.textContent = parts.join(' · ');

    const changes = document.createElement('div');
    changes.className = 'mt-2 grid gap-1 text-xs text-[var(--koa-ink)]/50';
    const rows = Array.isArray(alert.severityChanges) ? alert.severityChanges : [];
    if (rows.length) {
      rows.slice().reverse().forEach((change)=>{
        const line = document.createElement('p');
        line.textContent = formatAlertTime(change.at) + ' · severity changed ' + change.from + ' → ' + change.to;
        changes.appendChild(line);
      });
    } else {
      const line = document.createElement('p');
      line.textContent = 'No severity changes recorded.';
      changes.appendChild(line);
    }

    top.append(title,status);
    row.append(top,detail,changes);
    return row;
  }

  function renderAlertCenter(payload) {
    alertPayload = payload;
    const list = nav?.querySelector('[data-workspace-alert-list]');
    const summary = nav?.querySelector('[data-workspace-alert-summary]');
    if (!(list instanceof HTMLElement)) return;

    const counts = payload?.severityCounts || {};
    if (summary instanceof HTMLElement) {
      summary.textContent = [
        Number(payload?.newCount || 0) ? Number(payload.newCount) + ' new' : '',
        Number(counts.urgent || 0) ? Number(counts.urgent || 0) + ' urgent' : '',
        Number(counts.upcoming || 0) ? Number(counts.upcoming || 0) + ' upcoming' : '',
        Number(counts.info || 0) ? Number(counts.info || 0) + ' informational' : '',
      ].filter(Boolean).join(' · ') || 'No active alerts.';
    }

    const tabRows = {
      active:Array.isArray(payload?.alerts)?payload.alerts:[],
      snoozed:Array.isArray(payload?.snoozed)?payload.snoozed:[],
      dismissed:Array.isArray(payload?.dismissed)?payload.dismissed:[],
      history:Array.isArray(payload?.history)?payload.history:[],
    };
    const rows = tabRows[alertTab] || [];
    list.innerHTML = '';

    nav?.querySelectorAll('[data-alert-tab]').forEach((button)=>{
      if (!(button instanceof HTMLElement)) return;
      button.setAttribute('aria-pressed',button.dataset.alertTab===alertTab?'true':'false');
    });
    const countMap = {active:payload?.total||0,snoozed:payload?.snoozedCount||0,dismissed:payload?.dismissedCount||0};
    nav?.querySelectorAll('[data-alert-tab-count]').forEach((node)=>{
      if (!(node instanceof HTMLElement)) return;
      const value = Number(countMap[node.dataset.alertTabCount]||0);
      node.textContent = value ? '('+value+')' : '';
    });

    if (!rows.length) {
      const empty = document.createElement('p');
      empty.className = 'rounded-xl bg-[var(--koa-sand)] p-4 text-sm text-[var(--koa-ink)]/55';
      empty.textContent = alertTab==='history' ? 'No alert history yet.' : 'No alerts in this view.';
      list.appendChild(empty);
      return;
    }

    rows.forEach((alert)=>{
      list.appendChild(
        alertTab==='history' ? historyAlertRow(alert)
        : alertTab==='snoozed' ? snoozedAlertRow(alert)
        : alertTab==='dismissed' ? dismissedAlertRow(alert)
        : activeAlertRow(alert)
      );
    });
  }

  function renderAlerts(payload) {
    const total = Math.max(0, Number(payload?.total || 0));
    const mobileBadge = nav?.querySelector('[data-workspace-total]');
    const desktopBadge = nav?.querySelector('[data-workspace-alert-toggle]');
    const mobileAlertButton = nav?.querySelector('[data-workspace-alert-toggle-mobile]');
    if (mobileBadge instanceof HTMLElement) {
      mobileBadge.textContent = badgeText(total);
      mobileBadge.dataset.severity = highestSeverity(payload?.alerts);
    }
    if (mobileAlertButton instanceof HTMLElement) {
      mobileAlertButton.classList.toggle('hidden', total <= 0);
      mobileAlertButton.classList.toggle('inline-flex', total > 0);
    }
    renderMobileSlotBadges(payload);
    const actionCenterBadge=nav?.querySelector('[data-link-alert="actionCenter"]');
    if(actionCenterBadge instanceof HTMLElement){
      actionCenterBadge.textContent=badgeText(total);
      actionCenterBadge.dataset.severity=highestSeverity(payload?.alerts);
      actionCenterBadge.classList.toggle('hidden',total<=0);
      actionCenterBadge.classList.toggle('inline-flex',total>0);
    }
    if (desktopBadge instanceof HTMLElement) {
      const newCount = Math.max(0, Number(payload?.newCount || 0));
      desktopBadge.textContent = total > 0 ? badgeText(total) + ' alerts' + (newCount ? ' · ' + badgeText(newCount) + ' new' : '') : '';
      desktopBadge.classList.toggle('hidden', total <= 0);
      desktopBadge.classList.toggle('md:inline-flex', total > 0);
    }

    renderAlertCenter(payload);
    updateDeployWarningPoll(payload);

    nav?.querySelectorAll('[data-link-alert]').forEach((badge) => {
      if (!(badge instanceof HTMLElement)) return;
      const key = badge.dataset.linkAlert || '';
      const count = Math.max(0, Number(payload?.items?.[key]?.count || 0));
      badge.textContent = badgeText(count);
      badge.title = payload?.items?.[key]?.label || 'Workspace alerts';
      badge.dataset.severity = highestSeverity(payload?.items?.[key]?.alerts);
      badge.classList.toggle('hidden', count <= 0);
      badge.classList.toggle('inline-flex', count > 0);
    });
  }

  async function loadAlerts() {
    try {
      const response = await fetch('/api/admin/workspace-alerts',{cache:'no-store'});
      if (!response.ok) return;
      renderAlerts(await response.json());
    } catch {}
  }

  nav?.querySelectorAll('[data-alert-tab]').forEach((button) => {
    button.addEventListener('click', () => {
      alertTab = button.dataset.alertTab || 'active';
      if (alertPayload) renderAlertCenter(alertPayload);
    });
  });

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setAlertCenter(false);
    setMenu(open);
  });

  nav?.querySelector('[data-workspace-alert-toggle-mobile]')?.addEventListener('click', () => {
    const center = nav?.querySelector('[data-workspace-alert-center]');
    if (!(center instanceof HTMLElement)) return;
    const opening = center.dataset.open !== 'true';
    setAlertCenter(opening);
    if (opening) {
      setMenu(false);
      markVisibleAlertsSeen();
    }
  });



  async function markNewCriticalHealthSeen(){
    const freshCritical=(alertPayload?.items?.healthWarnings?.alerts||[])
      .filter((alert)=>alert?.severity==='urgent'&&alert?.isNew)
      .map((alert)=>alert.occurrenceId)
      .filter(Boolean);
    if(!freshCritical.length)return;
    try{
      await fetch('/api/admin/workspace-alerts',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({action:'mark-seen',occurrenceIds:freshCritical}),
      });
      (alertPayload?.items?.healthWarnings?.alerts||[]).forEach((alert)=>{
        if(freshCritical.includes(alert.occurrenceId))alert.isNew=false;
      });
      renderMobileSlotBadges(alertPayload);
    }catch{}
  }

  nav?.querySelectorAll('[data-workspace-bottom-slot]').forEach((slot)=>{
    slot.addEventListener('click',async(event)=>{
      if(!(slot instanceof HTMLAnchorElement))return;
      const id=String(slot.dataset.mobileSlotId||'');
      if(id!=='health')return;
      const freshCritical=(alertPayload?.items?.healthWarnings?.alerts||[]).some((alert)=>alert?.severity==='urgent'&&alert?.isNew);
      if(!freshCritical)return;
      event.preventDefault();
      await markNewCriticalHealthSeen();
      slot.classList.remove('workspace-health-pulse');
      window.location.assign('/admin/health/#health-priority');
    });
  });

  nav?.querySelector('[data-mobile-nav-edit]')?.addEventListener('click',()=>{
    const editor=nav?.querySelector('[data-mobile-nav-editor]');
    if(!(editor instanceof HTMLElement))return;
    editor.classList.toggle('hidden');
    if(!editor.classList.contains('hidden'))renderMobileNavEditor();
  });

  nav?.querySelector('[data-mobile-nav-save]')?.addEventListener('click',()=>{void saveMobileNavPreferences();});

  nav?.querySelector('[data-workspace-more-toggle]')?.addEventListener('click', () => {
    const opening = toggle?.getAttribute('aria-expanded') !== 'true';
    setAlertCenter(false);
    setMenu(opening);
  });

  nav?.querySelector('[data-workspace-alert-toggle]')?.addEventListener('click', () => {
    const center = nav?.querySelector('[data-workspace-alert-center]');
    if (!(center instanceof HTMLElement)) return;
    const opening = center.dataset.open !== 'true';
    setAlertCenter(opening);
    if (opening) {
      markVisibleAlertsSeen();
    }
  });

  nav?.querySelector('[data-workspace-alert-close]')?.addEventListener('click', () => {
    setAlertCenter(false);
  });

  nav?.querySelectorAll('[data-workspace-link]').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 768) setMenu(false);
      if(link instanceof HTMLAnchorElement&&normalizedPath(link.getAttribute('href'))==='/admin/health/'){
        void markNewCriticalHealthSeen();
      }
    });
  });

  document.addEventListener('pointerdown', (event) => {
    if (!(nav instanceof HTMLElement) || !(links instanceof HTMLElement)) return;
    if (links.dataset.open !== 'true') return;
    const target = event.target;
    if (target instanceof Node && nav.contains(target)) return;
    setMenu(false);
  });

  window.addEventListener('resize', () => {
    if (!(links instanceof HTMLElement) || !(toggle instanceof HTMLElement)) return;
    const open = links.dataset.open === 'true';
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && deployWarningPoll) loadAlerts();
  });

  window.addEventListener('koa:workspace-alerts-refresh', () => {
    loadAlerts();
  });

  nav?.querySelector('[data-workspace-logout]')?.addEventListener('click', async () => {
    await logout();
    window.location.assign('/staff/');
  });

  async function showWorkspaceNav() {
    if (!(nav instanceof HTMLElement)) return;

    const session = await getAdminSession();
    if (!session || session.accessBlocked) return;

    const capabilities = new Set(session.capabilities || session.permissions || []);
    currentCapabilities=capabilities;
    const currentPath = normalizedPath(window.location.pathname);

    nav.querySelectorAll('[data-workspace-link]').forEach((node) => {
      if (!(node instanceof HTMLAnchorElement)) return;

      const required = node.dataset.capability;
      const allowed = !required || capabilities.has(required);
      node.classList.toggle('hidden', !allowed);

      if (allowed && normalizedPath(node.getAttribute('href')) === currentPath) {
        node.setAttribute('aria-current', 'page');
      } else {
        node.removeAttribute('aria-current');
      }
    });

    updateGroupVisibility();


    const moreButton = nav.querySelector('[data-workspace-more-toggle]');
    if (moreButton instanceof HTMLElement) {
      moreButton.removeAttribute('aria-current');
    }

    const role = nav.querySelector('[data-workspace-role]');
    if (role) role.textContent = roleLabel(session.role);

    const user = nav.querySelector('[data-workspace-user]');
    if (user) user.textContent = session.displayName || session.email;

    initializeMenuState();
    nav.classList.remove('hidden');
    await loadMobileNavPreferences();
    const bottomMatch=[...nav.querySelectorAll('[data-workspace-bottom-slot]')].some((slot)=>slot instanceof HTMLAnchorElement&&normalizedPath(slot.getAttribute('href'))===currentPath);
    if(moreButton instanceof HTMLElement){
      if(!bottomMatch)moreButton.setAttribute('aria-current','page');
      else moreButton.removeAttribute('aria-current');
    }
    await loadAlerts();
    if(currentPath==='/admin/health/'){
      await markNewCriticalHealthSeen();
    }
  }

  showWorkspaceNav();
</script>
