    nav?.querySelector('[data-workspace-alert-toggle]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
    nav?.querySelector('[data-workspace-alert-toggle-mobile]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
    nav?.querySelector('[data-workspace-alert-toggle-bottom]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
