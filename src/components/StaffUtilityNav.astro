  function allowedMobileNavDefinitions(){
    return Object.entries(mobileNavDefinitions).filter(([,definition])=>!definition.capability||currentCapabilities.has(definition.capability));
  }

  function normalizeMobileNav(items){
    const requested=Array.isArray(items)?items.map(String):[];
    const allowedIds=new Set(allowedMobileNavDefinitions().map(([id])=>id));
    const out=[];
    for(const id of [...requested,'home','crm','calendar','health','actions','sales','events','quickbooks','staff','vendors','insurance','profitability','gallery']){
      if(!allowedIds.has(id)||out.includes(id))continue;
      out.push(id);
      if(out.length===4)break;
    }
    return out;
  }

  function applyMobileNav(items){
    currentMobileNav=normalizeMobileNav(items);
    const currentPath=normalizedPath(window.location.pathname);
    nav?.querySelectorAll('[data-workspace-bottom-slot]').forEach((slot,index)=>{
      if(!(slot instanceof HTMLAnchorElement))return;
      const id=currentMobileNav[index];
      const definition=mobileNavDefinitions[id];
      if(!definition){slot.classList.add('hidden');return;}
      slot.classList.remove('hidden');
      slot.dataset.mobileSlotId=id;
      slot.href=definition.href;
      slot.setAttribute('aria-label',definition.label);
      const label=slot.querySelector('[data-mobile-slot-label]');
      if(label)label.textContent=definition.label;
      const path=slot.querySelector('[data-mobile-slot-icon] path');
      if(path)path.setAttribute('d',definition.icon);
      if(currentPath===normalizedPath(definition.href))slot.setAttribute('aria-current','page');
      else slot.removeAttribute('aria-current');
      slot.classList.remove('workspace-health-pulse');
      const badge=slot.querySelector('[data-mobile-slot-badge]');
      if(badge instanceof HTMLElement){badge.textContent='';badge.classList.add('hidden');badge.removeAttribute('data-severity');}
    });
    renderMobileNavEditor();
    if(alertPayload)renderMobileSlotBadges(alertPayload);
  }

  function renderMobileNavEditor(){
    const wrap=nav?.querySelector('[data-mobile-nav-selects]');
    if(!(wrap instanceof HTMLElement))return;
    wrap.innerHTML='';
    const definitions=allowedMobileNavDefinitions();
    for(let index=0;index<4;index+=1){
      const label=document.createElement('label');
      label.className='grid gap-1 text-[.58rem] font-black uppercase tracking-[.07em] text-[var(--koa-clay)]';
      label.textContent='Slot '+(index+1);
      const select=document.createElement('select');
      select.dataset.mobileNavSlotSelect=String(index);
      for(const [id,definition] of definitions){
        const option=document.createElement('option');
        option.value=id;option.textContent=definition.label;select.appendChild(option);
      }
      select.value=currentMobileNav[index]||definitions[index]?.[0]||'';
      label.appendChild(select);wrap.appendChild(label);
    }
  }

  function categoryBadgeCount(payload,id){
    const map={
      actions:Number(payload?.total||0),
      crm:Number(payload?.items?.overdueTasks?.count||0),
      sales:Number(payload?.items?.unansweredLeads?.count||0),
      quickbooks:Number(payload?.items?.accountingMismatches?.count||0),
      health:Number(payload?.items?.healthWarnings?.count||0),
      insurance:Number(payload?.items?.vendorInsurance?.count||0),
      staff:Number(payload?.items?.securityWarnings?.count||0),
    };
    return Math.max(0,Number(map[id]||0));
  }

  function categorySeverity(payload,id){
    const map={
      actions:payload?.alerts||[],
      crm:payload?.items?.overdueTasks?.alerts||[],
      sales:payload?.items?.unansweredLeads?.alerts||[],
      quickbooks:payload?.items?.accountingMismatches?.alerts||[],
      health:payload?.items?.healthWarnings?.alerts||[],
      insurance:payload?.items?.vendorInsurance?.alerts||[],
      staff:payload?.items?.securityWarnings?.alerts||[],
    };
    return highestSeverity(map[id]||[]);
  }

  function renderMobileSlotBadges(payload){
    nav?.querySelectorAll('[data-workspace-bottom-slot]').forEach((slot)=>{
      if(!(slot instanceof HTMLAnchorElement))return;
      const id=String(slot.dataset.mobileSlotId||'');
      const badge=slot.querySelector('[data-mobile-slot-badge]');
      if(!(badge instanceof HTMLElement))return;
      const count=categoryBadgeCount(payload,id);
      const severity=categorySeverity(payload,id);
      badge.textContent=badgeText(count);
      if(severity)badge.dataset.severity=severity;
      else badge.removeAttribute('data-severity');
      badge.classList.toggle('hidden',count<=0);
      const newCriticalHealth=id==='health'&&(payload?.items?.healthWarnings?.alerts||[]).some((alert)=>alert?.severity==='urgent'&&alert?.isNew);
      slot.classList.toggle('workspace-health-pulse',Boolean(newCriticalHealth));
      if(newCriticalHealth)slot.title='New critical System Health problem';
    });
  }

  async function loadMobileNavPreferences(){
    try{
      const response=await fetch('/api/account/profile',{cache:'no-store'});
      if(!response.ok){applyMobileNav(currentMobileNav);return;}
      const profile=await response.json();
      applyMobileNav(profile?.mobileNav);
    }catch{applyMobileNav(currentMobileNav);}
  }

  async function saveMobileNavPreferences(){
    const message=nav?.querySelector('[data-mobile-nav-message]');
    const values=[...nav?.querySelectorAll('[data-mobile-nav-slot-select]')||[]]
      .map((node)=>node instanceof HTMLSelectElement?node.value:'')
      .filter(Boolean);
    if(new Set(values).size!==4){
      if(message)message.textContent='Choose four different modules.';
      return;
    }
    if(message)message.textContent='Saving…';
    try{
      const response=await fetch('/api/account/profile',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({action:'save-mobile-nav',mobileNav:values}),
      });
      const data=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(data.error||'Unable to save mobile navigation.');
      applyMobileNav(data.mobileNav||values);
      if(message)message.textContent='Saved for this account.';
    }catch(error){
      if(message)message.textContent=error instanceof Error?error.message:'Unable to save mobile navigation.';
    }
  }

  function updateDeployWarningPoll(payload) {
    const hasYellowDeployWarning = (payload?.alerts || []).some((alert) =>
      alert?.id === 'health:netlify-github-sync' && alert?.severity === 'upcoming'
    );
    if (hasYellowDeployWarning && !deployWarningPoll) {
      deployWarningPoll = window.setInterval(() => {
        if (document.visibilityState === 'visible') loadAlerts();
      }, 60000);
    } else if (!hasYellowDeployWarning && deployWarningPoll) {
      window.clearInterval(deployWarningPoll);
      deployWarningPoll = null;
    }
  }

  function formatAlertTime(value) {
    const ms = Date.parse(String(value || ''));
    if (!Number.isFinite(ms)) return '';
    return new Intl.DateTimeFormat('en-US',{
      timeZone:'Pacific/Honolulu',
      month:'short',day:'numeric',year:'numeric',
      hour:'numeric',minute:'2-digit'
    }).format(new Date(ms));
  }

  async function alertAction(action, extra = {}) {
    try {
      const response = await fetch('/api/admin/workspace-alerts',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({action,...extra}),
      });
      if (!response.ok) return false;
      await loadAlerts();
      return true;
    } catch {
      return false;
    }
  }

  async function markVisibleAlertsSeen() {
    const fresh = (alertPayload?.alerts || []).filter((alert)=>alert.isNew).map((alert)=>alert.occurrenceId);
    if (!fresh.length) return;
    try {
      await fetch('/api/admin/workspace-alerts',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({action:'mark-seen',occurrenceIds:fresh}),
      });
    } catch {}
  }

  function alertCategoryMeta(alert) {
    const category = String(alert?.category || '');
    const haystack = [
      alert?.title,
      alert?.context,
      alert?.detail,
      alert?.href,
    ].filter(Boolean).join(' ').toLowerCase();

    if (category === 'accountingMismatches') return {kind:'quickbooks',label:'QuickBooks'};
    if (category === 'vendorInsurance') return {kind:'insurance',label:'Vendor insurance'};
    if (category === 'securityWarnings') return {kind:'security',label:'Staff / security'};
    if (category === 'overdueTasks') return {kind:'crm',label:'Business CRM'};
    if (category === 'unansweredLeads') return {kind:'sales',label:'Sales CRM'};

    if (category === 'healthWarnings') {
      if (/resend|email|delivery|smtp/.test(haystack)) return {kind:'email',label:'Email / Resend'};
      if (/office 365|microsoft|graph|outlook|calendar sync/.test(haystack)) return {kind:'office365',label:'Microsoft 365'};
      if (/github|repository|commit|netlify|deploy/.test(haystack)) return {kind:'github',label:'GitHub / deployment'};
      if (/quickbooks/.test(haystack)) return {kind:'quickbooks',label:'QuickBooks'};
      return {kind:'health',label:'System Health'};
    }

    return {kind:'health',label:'Workspace alert'};
  }

