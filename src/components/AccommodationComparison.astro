---
import ResponsiveImage from './ResponsiveImage.astro';
import { lodgingHomes, combinedOvernightCapacity } from '../data/lodging';

interface Props {
  requestHref?: string;
}
const { requestHref = '/stay/#stay-request' } = Astro.props;
---
<section id="accommodations" class="bg-[var(--koa-ivory)] py-20 lg:py-28" aria-labelledby="accommodations-heading">
  <div class="container-shell">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div class="min-w-0">
        <p class="eyebrow text-[var(--koa-clay)]">Stay on the property</p>
        <h2 id="accommodations-heading" class="display mt-5 max-w-3xl text-4xl leading-[1] sm:text-5xl lg:text-6xl">Two homes. Room to stay together.</h2>
        <p class="mt-5 max-w-2xl text-base leading-7 text-[var(--koa-ink)]/68">Explore two on-property homes offering five bedrooms and three bathrooms in total. The homes accommodate up to {combinedOvernightCapacity} overnight guests combined.</p>
      </div>
      <div class="w-fit max-w-full rounded-[1.3rem] bg-[var(--koa-forest)] px-6 py-5 text-white">
        <p class="text-[.65rem] font-black uppercase tracking-[.16em] text-white/70">Combined overnight capacity</p>
        <p class="display mt-2 text-4xl sm:text-5xl">Up to {combinedOvernightCapacity} <span class="text-xl sm:text-2xl">guests</span></p>
      </div>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {lodgingHomes.map((home) => (
        <article class="min-w-0 overflow-hidden rounded-[1.5rem] border border-[var(--koa-line)] bg-[var(--koa-sand)]" aria-label={home.title} data-lodging-home={home.id}>
          <figure class="relative h-52 overflow-hidden sm:h-64">
            <ResponsiveImage {...home.photo} width={1000} height={640} sizes="(min-width:768px) 48vw,100vw" class="absolute inset-0 h-full w-full object-cover" />
            <figcaption class="absolute bottom-3 left-3 right-3 rounded-lg bg-[var(--koa-ink)]/90 px-3 py-2 text-[.64rem] font-semibold leading-5 text-white">
              Real Koa’s venue/event archive · not verified as this home’s photo
            </figcaption>
          </figure>
          <div class="p-6 sm:p-8">
            <p class="eyebrow text-[var(--koa-clay)]">{home.eyebrow}</p>
            <h3 class="display mt-4 text-3xl leading-[1.05] sm:text-4xl">{home.title}</h3>
            <div class="mt-6 grid grid-cols-2 gap-3">
              <div class="min-w-0 rounded-xl bg-[var(--koa-ivory)] p-4">
                <p class="display text-4xl text-[var(--koa-forest)] sm:text-5xl">{home.bedrooms}</p>
                <p class="mt-2 text-xs font-bold uppercase tracking-[.1em] text-[var(--koa-ink)]/68">Bedrooms</p>
              </div>
              <div class="min-w-0 rounded-xl bg-[var(--koa-ivory)] p-4">
                <p class="display text-4xl text-[var(--koa-forest)] sm:text-5xl">{home.bathrooms}</p>
                <p class="mt-2 text-xs font-bold uppercase tracking-[.1em] text-[var(--koa-ink)]/68">Bathrooms</p>
              </div>
            </div>
            <div class="mt-7 border-t border-[var(--koa-line)] pt-5">
              <h4 class="text-xs font-black uppercase tracking-[.12em] text-[var(--koa-forest)]">Where your group can sleep</h4>
              <ul class="mt-4 grid gap-2">
                {Array.from({ length: home.bedrooms }, (_, index) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm leading-6">
                    <span class="font-semibold text-[var(--koa-ink)]">Bedroom {index + 1}</span>
                    <span class="text-[var(--koa-ink)]/65">Bed type to be confirmed</span>
                  </li>
                ))}
              </ul>
              <p class="mt-3 text-xs leading-5 text-[var(--koa-ink)]/65">Exact mattress sizes, extra sleeping surfaces and this home's individual guest limit will be confirmed before booking. The 10-guest maximum is for both homes together.</p>
            </div>
            <a href={'/stay/?home=' + encodeURIComponent(home.id) + '#stay-request'} class="mt-7 inline-flex min-h-11 items-center rounded-full bg-[var(--koa-forest)] px-5 py-3 text-xs font-black uppercase tracking-[.11em] text-white">Check this home’s availability →</a>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-5">
      <p class="max-w-2xl text-sm leading-6 text-[var(--koa-ink)]/65">The 10-person limit applies to overnight stays across both homes, not to event attendance. Availability, exact bedding and booking terms are confirmed directly by Koa’s.</p>
      <a href={requestHref} class="link-arrow shrink-0">Request stay availability →</a>
    </div>
  </div>
</section>
