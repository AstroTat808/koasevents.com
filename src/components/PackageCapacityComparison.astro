---
import { businessRules } from '../data/businessRules';

interface Props {
  furnitureCoverage: string;
  dark?: boolean;
  compact?: boolean;
  showVenueCapacity?: boolean;
}

const { furnitureCoverage, dark = false, compact = false, showVenueCapacity = true } = Astro.props;
const venueCapacity = businessRules.venue.maximumOccupancy.value;
---

<div
  class:list={[
    'grid overflow-hidden rounded-xl border',
    showVenueCapacity ? 'grid-cols-2' : 'grid-cols-1',
    compact ? 'mt-4' : 'mt-5',
    dark ? 'border-white/15 bg-white/[.05]' : 'border-[var(--koa-line)] bg-[var(--koa-ivory)]',
  ]}
  aria-label={showVenueCapacity ? 'Venue capacity compared with furniture included' : 'Furniture included'}
>
  {showVenueCapacity && (
    <div class:list={['p-3 sm:p-4', dark ? 'border-r border-white/15' : 'border-r border-[var(--koa-line)]']}>
      <p class:list={['text-[.55rem] font-black uppercase tracking-[.11em]', dark ? 'text-white/45' : 'text-[var(--koa-clay)]']}>Venue capacity</p>
      <p class:list={['mt-1 text-sm font-bold leading-5', dark ? 'text-white' : 'text-[var(--koa-forest)]']}>Up to {venueCapacity} persons</p>
    </div>
  )}
  <div class="p-3 sm:p-4">
    <p class:list={['text-[.55rem] font-black uppercase tracking-[.11em]', dark ? 'text-white/45' : 'text-[var(--koa-clay)]']}>Furniture included</p>
    <p class:list={['mt-1 text-sm font-bold leading-5', dark ? 'text-white' : 'text-[var(--koa-forest)]']}>{furnitureCoverage}</p>
  </div>
</div>
