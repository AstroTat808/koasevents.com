---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  sizes?: string;
  priority?: boolean;
  fit?: 'cover' | 'contain' | 'fill';
  position?: 'center' | 'top' | 'bottom' | 'left' | 'right';
  quality?: number;
  // Preserve the full source for browser-side focal positioning on every page.
  preserveSourceCrop?: boolean;
}

const {
  src,
  alt,
  width = 1600,
  height = 1067,
  class: className = '',
  sizes = '100vw',
  priority = false,
  fit = 'cover',
  position = 'center',
  quality = 84,
  preserveSourceCrop = true,
} = Astro.props;

const transform = (targetWidth: number, targetHeight?: number, format = 'webp') => {
  const params = new URLSearchParams({
    url: src,
    w: String(Math.max(1, Math.round(targetWidth))),
    fit: preserveSourceCrop ? 'contain' : fit,
    ...(!preserveSourceCrop ? { position } : {}),
    q: String(Math.max(1, Math.min(100, Math.round(quality)))),
    fm: format,
  });
  // When a gallery focal point controls CSS object-position, keep the complete
  // source image so CDN pre-cropping cannot discard the requested focal area.
  if (targetHeight && !preserveSourceCrop) params.set('h', String(Math.max(1, Math.round(targetHeight))));
  return '/.netlify/images?' + params.toString();
};

const ratio = height / width;
const candidates = [...new Set([480, 768, 1024, 1440, 1800, width])]
  .filter((candidate) => candidate > 0 && candidate <= Math.max(width, 1800))
  .sort((a, b) => a - b);

const srcset = candidates
  .map((candidate) => transform(candidate, Math.round(candidate * ratio)) + ' ' + candidate + 'w')
  .join(', ');

---
<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  data-koa-focal-src={src}
/>

<script>
  // Keep responsive Netlify Image CDN srcsets, but restore the existing local
  // asset on CDN/network failure. Capture image errors because they do not
  // bubble, and never retry the fallback source in a loop.
  function restoreKoaOriginalImage(image: HTMLImageElement) {
    if (image.dataset.koaImageFallback === 'original') return;
    const original = image.dataset.koaFocalSrc || '';
    if (!original.startsWith('/') || original.startsWith('//')) return;
    const selected = image.currentSrc || image.getAttribute('src') || '';
    if (!selected.includes('/.netlify/images?')) return;
    image.dataset.koaImageFallback = 'original';
    image.removeAttribute('srcset');
    image.src = original;
  }

  document.addEventListener('error', (event) => {
    if (event.target instanceof HTMLImageElement
        && event.target.hasAttribute('data-koa-focal-src')) {
      restoreKoaOriginalImage(event.target);
    }
  }, true);

  // Eager images can fail before the deferred Astro module initializes.
  // Lazy images remain untouched until an actual load failure occurs.
  const restoreAlreadyFailedEagerImages = () => {
    document.querySelectorAll<HTMLImageElement>('img[data-koa-focal-src][loading="eager"]')
      .forEach((image) => {
        if (image.complete && image.naturalWidth === 0) restoreKoaOriginalImage(image);
      });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', restoreAlreadyFailedEagerImages, { once: true });
  } else {
    restoreAlreadyFailedEagerImages();
  }
</script>
