---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  sizes?: string;
  priority?: boolean;
  fit?: 'cover' | 'contain' | 'fill';
  position?: 'center' | 'top' | 'bottom' | 'left' | 'right';
  focalIgnore?: boolean;
  quality?: number;
}

const {
  src,
  alt,
  width = 1600,
  height = 1067,
  class: className = '',
  sizes = '100vw',
  priority = false,
  focalIgnore = false,
} = Astro.props;
---
<img
  src={src}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  data-koa-focal-src={src}
  data-koa-focal-ignore={focalIgnore ? '' : undefined}
/>
